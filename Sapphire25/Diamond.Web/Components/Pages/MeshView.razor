			mvarMesh = DemoMeshService.SolveForDay(mvarPlan, day);
			mvarSelectedCirculation = null;
			mvarMeshStale = false;
			mvarProject = null;
			RefreshSvg();
			mvarStatus = "Malla para " + DayLabel(day) + ".";
			if (mvarMesh is not null && !mvarMesh.Success)
			{
				mvarError = "Malla con " + mvarMesh.Errors.Count.ToString(CultureInfo.InvariantCulture) + " error(es).";
				mvarInspectTab = InspectTab.Errors;
			}
			else if (mvarInspectTab == InspectTab.Errors)
			{
				mvarInspectTab = InspectTab.Warnings;
			}

			if (mvarJsReady)
			{
				try { await Js.InvokeAsync<bool>("diamondMonaco.clearMarkers"); }
				catch (JSException) { }
			}
		}
		catch (Exception ex)
		{
			mvarError = ex.Message;
			mvarMeshStale = mvarMesh is not null;
		}

		await Task.CompletedTask;
	}

	private void SelectView(MeshRouteView candidate)
	{
		if (candidate is null)
		{
			return;
		}

		mvarSelectedViewId = candidate.Id;
		mvarView = candidate;
		InitAxisBounds();
		ResetViewWindow();
		RefreshSvg();
		mvarStatus = "Vista: " + candidate.Id + " · " + candidate.Name + ".";
	}

	private string ViewButtonClass(MeshRouteView candidate)
	{
		return string.Equals(mvarSelectedViewId, candidate.Id, StringComparison.Ordinal)
			? "btn-info"
			: "btn-outline-light";
	}

	private void InitAxisBounds()
	{
		if (mvarView is null)
		{
			return;
		}

		mvarAxisPkMin = Math.Min(mvarView.PK, mvarView.PKEnd);
		mvarAxisPkMax = Math.Max(mvarView.PK, mvarView.PKEnd);
	}

	private void ResetViewWindow()
	{
		mvarViewT0 = TimeSpan.FromHours(6);
		mvarViewT1 = TimeSpan.FromHours(14);
		mvarViewPkMin = mvarAxisPkMin;
		mvarViewPkMax = mvarAxisPkMax;
	}

	/// <summary>
	/// El dibujo lo hace <see cref="MeshDiagram"/> (Diamond.Controls).
	/// Se conserva el método para no romper llamadas de planificación (no-op de UI).
	/// </summary>
	private void RefreshSvg(bool interactive = false)
	{
		// MeshDiagram se actualiza por parámetros Mesh/View en el render de Blazor.
	}

	private MeshSvgDrawOptions BuildDrawOptions(bool interactive)
	{
		if (mvarShowNowLine)
		{
			mvarClockNow = DateTime.Now.TimeOfDay;
		}

		MeshSvgDrawOptions options = MeshSvgDrawOptions.Create(
			showCantonOccupations: mvarShowOccupations,
			showTrainPaths: mvarShowTrainPaths,
			showTrainNumbers: mvarShowTrainNumbers,
			showConflicts: mvarShowConflicts,
			showSpeedStrip: mvarShowSpeedStrip,
			showTrackStrip: mvarShowTrackStrip,
			showNowLine: mvarShowNowLine,
			nowTime: mvarShowNowLine ? mvarClockNow : null,
			maxPolylineSamples: interactive ? 16 : 48);

		if (interactive)
		{
			return options.ForInteractiveLod();
		}

		return options;
	}

