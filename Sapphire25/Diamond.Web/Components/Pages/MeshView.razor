	private void CompileProject()
	{
		if (_mesh is null)
		{
			_status = "No hay malla planificada: aplica el script antes de compilar.";
			return;
		}

		try
		{
			if (_plan is not null)
			{
				_project = ProjectCompiler.Compile(_plan, _mesh);
			}
			else
			{
				_project = ProjectCompiler.Compile(
					_mesh,
					new CompileOptions
					{
						Name = Path.GetFileNameWithoutExtension(_fileName),
						SourceScript = _script,
						PlanningDay = _selectedDay
					});
			}

			_inspectTab = InspectTab.Project;
			_status = "Proyecto compilado: "
				+ _project.Circulations.Count.ToString(CultureInfo.InvariantCulture)
				+ " circulaciones, "
				+ _project.Asimilations.Count.ToString(CultureInfo.InvariantCulture)
				+ " asimilaciones ("
				+ _project.Id
				+ ").";
		}
		catch (Exception ex)
		{
			_project = null;
			_error = "Error al compilar el proyecto: " + ex.Message;
		}
	}

	private void RebuildCore()
	{
		_error = null;
		_status = null;
		_project = null;
		_compileErrors = new List<ScriptDiagnostic>();
		_markersDirty = true;

		if (string.IsNullOrWhiteSpace(_script))
		{
			_script = DemoMeshService.SfmT3DemandScript;
		}

		try
		{
			TopoLayout topo = DemoMeshService.LoadTopoWithInfrastructure();
			IReadOnlyList<MeshRouteView> views = DemoMeshService.BuildDemoViews(topo);
			_views = new List<MeshRouteView>(views);

			Plan plan = new Plan(topo);
			plan.Name = Path.GetFileNameWithoutExtension(_fileName);
			if (string.IsNullOrWhiteSpace(plan.Name) || plan.Name == "sin título")
			{
				plan.Name = "SFM demo";
			}

			plan.EnsureDefaultTrainSpecs();
			plan.DemandScript = _script;

			DemandCompileResult compiled = plan.CompileDemand();
			if (!compiled.Success)
			{
				_compileErrors = BuildDiagnosticsFromCompile(compiled);
				_error = "El script no compila (" + _compileErrors.Count.ToString(CultureInfo.InvariantCulture)
					+ " error(es)). Se mantiene la malla anterior si existía.";
				return;
			}

			_compileErrors = new List<ScriptDiagnostic>();

			Diamond.Timed.Mesh mesh = new MeshPlanner(plan).Solve(_selectedDay);
			_plan = plan;
			_mesh = mesh;
			_view = DemoMeshService.FindViewById(_views, _selectedViewId) ?? (_views.Count > 0 ? _views[0] : null);
			if (_view is not null)
			{
				_selectedViewId = _view.Id;
			}

			InitAxisBounds();
			ResetViewWindow();
			RefreshSvg();

			if (!mesh.Success)
			{
				_error = "Malla generada con "
					+ mesh.Errors.Count.ToString(CultureInfo.InvariantCulture)
					+ " error(es) de planificación.";
				_inspectTab = InspectTab.Errors;
			}
		}
		catch (Exception ex)
		{
			_error = ex.Message;
			_compileErrors = new List<ScriptDiagnostic>
			{
				new ScriptDiagnostic { Line = 0, Message = ex.Message, Severity = "error" }
			};
		}
	}

	private async Task RebuildAsync()
	{
		RebuildCore();
		if (_jsReady)
		{
			await FlushMarkersToEditorAsync();
		}
	}

