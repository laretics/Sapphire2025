@page "/mesh"
@rendermode InteractiveServer
@implements IAsyncDisposable
@inject IJSRuntime Js
@using System.Globalization
@using Diamond.Timed
@using Diamond.Topo
@using Diamond.Web.Rendering
@using Diamond.Web.Services
@using Microsoft.JSInterop

<PageTitle>Malla T3 — Diamond</PageTitle>

<h1>Malla horaria</h1>
<p class="text-muted mb-2">
	Eje <strong>T3 Palma–Manacor</strong>. Zoom/pan sobre el plot; reglas fijas.
	La rueda no desplaza la página. El zoom se puede limitar a <strong>tiempo</strong>, <strong>PK</strong> o <strong>ambos</strong>.
</p>

@if (_error is not null)
{
	<div class="alert alert-danger">@_error</div>
}
else if (_mesh is not null && _axis is not null)
{
	<div class="mb-3 d-flex flex-wrap gap-2 align-items-center">
		<span class="badge bg-info text-dark">@_axis.Id · @_axis.Name</span>
		<span class="badge bg-success">@(_mesh.Success ? "OK" : "Con errores")</span>
		<span class="badge bg-secondary">@_mesh.Circulations.Count circulaciones</span>
		<span class="badge bg-secondary">@_mesh.Asimilations.Count asimilations</span>
		<span class="badge bg-warning text-dark">@_mesh.Warnings.Count warnings</span>
		<span class="badge bg-danger">@_mesh.Errors.Count errors</span>
		<button class="btn btn-sm btn-outline-secondary" @onclick="Rebuild">Regenerar</button>
	</div>

	<div class="mb-2 d-flex flex-wrap gap-2 align-items-center mesh-zoom-toolbar">
		<button type="button" class="btn btn-sm btn-outline-light" @onclick="ZoomIn" title="Acercar">+</button>
		<button type="button" class="btn btn-sm btn-outline-light" @onclick="ZoomOut" title="Alejar">−</button>
		<button type="button" class="btn btn-sm btn-outline-light" @onclick="ResetView" title="Vista inicial">Reset</button>
		<button type="button" class="btn btn-sm btn-outline-light" @onclick="() => NudgeTime(-1)">← t</button>
		<button type="button" class="btn btn-sm btn-outline-light" @onclick="() => NudgeTime(1)">t →</button>
		<button type="button" class="btn btn-sm btn-outline-light" @onclick="() => NudgePk(1)">↑ PK</button>
		<button type="button" class="btn btn-sm btn-outline-light" @onclick="() => NudgePk(-1)">↓ PK</button>

		<span class="text-light small ms-1">Zoom:</span>
		<div class="btn-group btn-group-sm" role="group" aria-label="Ejes de zoom">
			<button type="button"
					class="btn @ZoomModeButtonClass(ZoomAxisMode.Both)"
					@onclick="() => SetZoomMode(ZoomAxisMode.Both)"
					title="Zoom en tiempo y PK">Ambos</button>
			<button type="button"
					class="btn @ZoomModeButtonClass(ZoomAxisMode.Time)"
					@onclick="() => SetZoomMode(ZoomAxisMode.Time)"
					title="Solo eje horizontal (tiempo)">Tiempo</button>
			<button type="button"
					class="btn @ZoomModeButtonClass(ZoomAxisMode.Space)"
					@onclick="() => SetZoomMode(ZoomAxisMode.Space)"
					title="Solo eje vertical (PK / estaciones)">PK</button>
		</div>

		<span class="badge bg-dark text-light border">
			@FormatClock(_viewT0)–@FormatClock(_viewT1)
			· @FormatPkShort(_viewPkMin)–@FormatPkShort(_viewPkMax)
			· @_zoomModeLabel
		</span>
	</div>

	@if (_mesh.Warnings.Count > 0)
	{
		<details class="mb-2">
			<summary>Warnings (@_mesh.Warnings.Count)</summary>
			<ul class="small">
				@foreach (string w in _mesh.Warnings)
				{
					<li>@w</li>
				}
			</ul>
		</details>
	}

	@if (_mesh.Errors.Count > 0)
	{
		<details class="mb-2">
			<summary class="text-danger">Errors (@_mesh.Errors.Count)</summary>
			<ul class="small">
				@foreach (string e in _mesh.Errors)
				{
					<li>@e</li>
				}
			</ul>
		</details>
	}

	<div @ref="_host"
		 class="mesh-svg-host border rounded bg-dark @(_dragging ? "mesh-dragging" : "")"
		 @onpointerdown="OnPointerDown"
		 @onpointermove="OnPointerMove"
		 @onpointerup="OnPointerUp"
		 @onpointerleave="OnPointerUp"
		 @onpointercancel="OnPointerUp">
		<svg xmlns="http://www.w3.org/2000/svg"
			 width="@_svgWidth"
			 height="@_svgHeight"
			 viewBox="0 0 @_svgWidth @_svgHeight"
			 class="mesh-svg-canvas">
			@((MarkupString)_svgContent)
		</svg>
	</div>

	<pre class="mt-3 small bg-light p-2 rounded">@_script</pre>
}

@code {
	private enum ZoomAxisMode
	{
		Both,
		Time,
		Space
	}

	private const double MinTimeSpanHours = 0.5;
	private const double MaxTimeSpanHours = 24.0;
	private const long MinPkSpan = 2000L;
	private const double ZoomStep = 1.25;

	private ElementReference _host;
	private DotNetObjectReference<MeshView>? _dotNetRef;
	private bool _wheelAttached;

	private Diamond.Timed.Mesh? _mesh;
	private Axis? _axis;
	private Plan? _plan;
	private string _svgContent = string.Empty;
	private string _script = string.Empty;
	private string? _error;

	private int _svgWidth = 1400;
	private int _svgHeight = 900;

	private TimeSpan _viewT0;
	private TimeSpan _viewT1;
	private long _viewPkMin;
	private long _viewPkMax;

	private long _axisPkMin;
	private long _axisPkMax;

	private bool _dragging;
	private double _lastPointerX;
	private double _lastPointerY;

	private ZoomAxisMode _zoomMode = ZoomAxisMode.Both;

	private string _zoomModeLabel =>
		_zoomMode switch
		{
			ZoomAxisMode.Time => "zoom: tiempo",
			ZoomAxisMode.Space => "zoom: PK",
			_ => "zoom: ambos"
		};

	protected override void OnInitialized()
	{
		Rebuild();
	}

	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		if (_mesh is null || _error is not null)
		{
			return;
		}

		if (!_wheelAttached)
		{
			_dotNetRef ??= DotNetObjectReference.Create(this);
			try
			{
				await Js.InvokeVoidAsync("diamondMeshViewport.attach", _host, _dotNetRef);
				_wheelAttached = true;
			}
			catch (JSException)
			{
				// Script aún no cargado en el primer frame; se reintentará.
			}
		}
	}

	public async ValueTask DisposeAsync()
	{
		if (_wheelAttached)
		{
			try
			{
				await Js.InvokeVoidAsync("diamondMeshViewport.detach", _host);
			}
			catch
			{
				// ignore dispose races
			}

			_wheelAttached = false;
		}

		_dotNetRef?.Dispose();
		_dotNetRef = null;
	}

	/// <summary>
	/// Invocado desde JS (listener wheel non-passive) para evitar el scroll de página.
	/// </summary>
	[JSInvokable]
	public Task OnWheelFromJs(double deltaY, double svgX, double svgY)
	{
		double factor = deltaY < 0 ? ZoomStep : 1.0 / ZoomStep;
		ZoomAtScreen(svgX, svgY, factor);
		return InvokeAsync(StateHasChanged);
	}

	private void Rebuild()
	{
		try
		{
			_error = null;
			(_plan, _mesh, _axis) = DemoMeshService.BuildDemo();
			_script = _plan!.DemandScript;

			_axisPkMin = Math.Min(_axis!.PK, _axis.PKEnd);
			_axisPkMax = Math.Max(_axis.PK, _axis.PKEnd);

			_viewT0 = TimeSpan.FromHours(6);
			_viewT1 = TimeSpan.FromHours(14);
			_viewPkMin = _axisPkMin;
			_viewPkMax = _axisPkMax;

			RefreshSvg();
		}
		catch (Exception ex)
		{
			_error = ex.Message;
			_mesh = null;
			_axis = null;
			_svgContent = string.Empty;
		}
	}

	private void RefreshSvg()
	{
		if (_mesh is null || _axis is null)
		{
			return;
		}

		ClampView();
		_svgContent = MeshSvgRenderer.RenderContent(
			_mesh,
			_axis,
			_viewT0,
			_viewT1,
			_viewPkMin,
			_viewPkMax,
			width: _svgWidth,
			height: _svgHeight);
	}

	private void ResetView()
	{
		_viewT0 = TimeSpan.FromHours(6);
		_viewT1 = TimeSpan.FromHours(14);
		_viewPkMin = _axisPkMin;
		_viewPkMax = _axisPkMax;
		RefreshSvg();
	}

	private void SetZoomMode(ZoomAxisMode mode)
	{
		_zoomMode = mode;
	}

	private string ZoomModeButtonClass(ZoomAxisMode mode)
	{
		return _zoomMode == mode ? "btn-light" : "btn-outline-light";
	}

	private void ZoomIn()
	{
		ZoomAtPlotCenter(ZoomStep);
	}

	private void ZoomOut()
	{
		ZoomAtPlotCenter(1.0 / ZoomStep);
	}

	private void ZoomAtPlotCenter(double factor)
	{
		double cx = MeshSvgLayout.PlotLeft + MeshSvgLayout.PlotWidth(_svgWidth) * 0.5;
		double cy = MeshSvgLayout.PlotTop + MeshSvgLayout.PlotHeight(_svgHeight) * 0.5;
		ZoomAtScreen(cx, cy, factor);
	}

	private void NudgeTime(double direction)
	{
		double span = (_viewT1 - _viewT0).TotalSeconds;
		double delta = direction * span * 0.15;
		_viewT0 += TimeSpan.FromSeconds(delta);
		_viewT1 += TimeSpan.FromSeconds(delta);
		RefreshSvg();
	}

	private void NudgePk(double direction)
	{
		double span = _viewPkMax - _viewPkMin;
		long delta = (long)(direction * span * 0.15);
		_viewPkMin += delta;
		_viewPkMax += delta;
		RefreshSvg();
	}

	private void OnPointerDown(PointerEventArgs e)
	{
		if (e.Button != 0)
		{
			return;
		}

		_dragging = true;
		_lastPointerX = e.ClientX;
		_lastPointerY = e.ClientY;
	}

	private void OnPointerMove(PointerEventArgs e)
	{
		if (!_dragging)
		{
			return;
		}

		double dx = e.ClientX - _lastPointerX;
		double dy = e.ClientY - _lastPointerY;
		_lastPointerX = e.ClientX;
		_lastPointerY = e.ClientY;

		double plotW = MeshSvgLayout.PlotWidth(_svgWidth);
		double plotH = MeshSvgLayout.PlotHeight(_svgHeight);
		double timeSpan = (_viewT1 - _viewT0).TotalSeconds;
		double pkSpan = _viewPkMax - _viewPkMin;

		// Pan siempre en ambos ejes (desplazamiento libre); el bloqueo es solo del zoom.
		double dTime = -dx / plotW * timeSpan;
		double dPk = dy / plotH * pkSpan;

		_viewT0 += TimeSpan.FromSeconds(dTime);
		_viewT1 += TimeSpan.FromSeconds(dTime);
		_viewPkMin += (long)Math.Round(dPk);
		_viewPkMax += (long)Math.Round(dPk);
		RefreshSvg();
	}

	private void OnPointerUp(PointerEventArgs e)
	{
		_dragging = false;
	}

	/// <summary>
	/// Zoom de la ventana de datos centrado en un punto de pantalla.
	/// Respeta <see cref="_zoomMode"/> (tiempo, PK o ambos).
	/// </summary>
	private void ZoomAtScreen(double screenX, double screenY, double factor)
	{
		if (!MeshSvgLayout.IsInsidePlot(screenX, screenY, _svgWidth, _svgHeight))
		{
			screenX = MeshSvgLayout.PlotLeft + MeshSvgLayout.PlotWidth(_svgWidth) * 0.5;
			screenY = MeshSvgLayout.PlotTop + MeshSvgLayout.PlotHeight(_svgHeight) * 0.5;
		}

		double anchorTime = MeshSvgLayout.TimeAtX(screenX, _viewT0, _viewT1, _svgWidth);
		double anchorPk = MeshSvgLayout.PkAtY(screenY, _viewPkMin, _viewPkMax, _svgHeight);

		double uTime = (screenX - MeshSvgLayout.PlotLeft) / MeshSvgLayout.PlotWidth(_svgWidth);
		double uPkFromTop = (screenY - MeshSvgLayout.PlotTop) / MeshSvgLayout.PlotHeight(_svgHeight);

		bool zoomTime = _zoomMode == ZoomAxisMode.Both || _zoomMode == ZoomAxisMode.Time;
		bool zoomSpace = _zoomMode == ZoomAxisMode.Both || _zoomMode == ZoomAxisMode.Space;

		if (zoomTime)
		{
			double timeSpan = (_viewT1 - _viewT0).TotalSeconds / factor;
			if (timeSpan < MinTimeSpanHours * 3600.0)
			{
				timeSpan = MinTimeSpanHours * 3600.0;
			}

			if (timeSpan > MaxTimeSpanHours * 3600.0)
			{
				timeSpan = MaxTimeSpanHours * 3600.0;
			}

			_viewT0 = TimeSpan.FromSeconds(anchorTime - uTime * timeSpan);
			_viewT1 = TimeSpan.FromSeconds(anchorTime + (1.0 - uTime) * timeSpan);
		}

		if (zoomSpace)
		{
			double pkSpan = (_viewPkMax - _viewPkMin) / factor;
			if (pkSpan < MinPkSpan)
			{
				pkSpan = MinPkSpan;
			}

			double maxPkSpan = Math.Max(MinPkSpan, _axisPkMax - _axisPkMin);
			if (pkSpan > maxPkSpan)
			{
				pkSpan = maxPkSpan;
			}

			double pkMax = anchorPk + uPkFromTop * pkSpan;
			double pkMin = pkMax - pkSpan;
			_viewPkMin = (long)Math.Round(pkMin);
			_viewPkMax = (long)Math.Round(pkMax);
		}

		RefreshSvg();
	}

	private void ClampView()
	{
		if (_viewT1 <= _viewT0)
		{
			_viewT1 = _viewT0 + TimeSpan.FromHours(1);
		}

		double span = (_viewT1 - _viewT0).TotalSeconds;
		if (span < MinTimeSpanHours * 3600.0)
		{
			double mid = (_viewT0.TotalSeconds + _viewT1.TotalSeconds) * 0.5;
			_viewT0 = TimeSpan.FromSeconds(mid - MinTimeSpanHours * 1800.0);
			_viewT1 = TimeSpan.FromSeconds(mid + MinTimeSpanHours * 1800.0);
		}

		if (_viewPkMax <= _viewPkMin)
		{
			_viewPkMax = _viewPkMin + MinPkSpan;
		}

		if (_viewPkMax - _viewPkMin < MinPkSpan)
		{
			long mid = (_viewPkMin + _viewPkMax) / 2;
			_viewPkMin = mid - MinPkSpan / 2;
			_viewPkMax = _viewPkMin + MinPkSpan;
		}
	}

	private static string FormatClock(TimeSpan ts)
	{
		int h = (int)ts.TotalHours;
		if (h < 0)
		{
			h = ((h % 24) + 24) % 24;
		}

		return h.ToString("00", CultureInfo.InvariantCulture) + ":"
			+ Math.Abs(ts.Minutes).ToString("00", CultureInfo.InvariantCulture);
	}

	private static string FormatPkShort(long pk)
	{
		long abs = Math.Abs(pk);
		return (abs / 1000L).ToString(CultureInfo.InvariantCulture) + "+"
			+ (abs % 1000L).ToString("D3", CultureInfo.InvariantCulture);
	}
}
