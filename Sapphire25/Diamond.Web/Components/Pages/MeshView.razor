@page "/mesh"
@layout MeshWorkspaceLayout
@* Sin prerender: el passthrough estático + Monaco/JS provoca JSDisconnectedException y el banner de error. *@
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@implements IAsyncDisposable
@inject IJSRuntime Js
@using System.Globalization
@using System.IO
@using Diamond.Project
@using Diamond.Timed
@using Diamond.Topo
@using Diamond.Web.Components.Layout
@using Diamond.Web.Services
@using Microsoft.JSInterop
@using MeshRouteView = Diamond.Topo.RouteView
@using ProjectModel = Diamond.Project.Project

<PageTitle>@PageTitleText</PageTitle>

<div class="mesh-workspace">
	@* —— Menú archivo —— *@
	<div class="mesh-menubar">
		<span class="brand">Diamond</span>
		<div class="btn-group btn-group-sm" role="group" aria-label="Archivo">
			<button type="button" class="btn btn-outline-light" @onclick="FileNewAsync" title="Nuevo script (Ctrl+N)">Nuevo</button>
			<button type="button" class="btn btn-outline-light" @onclick="FileOpenAsync" title="Abrir desde disco">Abrir…</button>
			<button type="button" class="btn btn-outline-light" @onclick="FileSaveAsync" title="Guardar" disabled="@(!mvarDirty)">Guardar</button>
			<button type="button" class="btn btn-outline-light" @onclick="FileSaveAsAsync" title="Guardar como…">Guardar como…</button>
		</div>
		<span class="mesh-file-label @(mvarDirty ? "dirty" : null)" title="@mvarFileName">@FileDisplayName</span>
		<span class="ms-auto"></span>
		<a class="btn btn-sm btn-outline-secondary" href="docs/diamond-plan-language.html" target="_blank" rel="noopener">Manual DSL</a>
		<a class="btn btn-sm btn-outline-secondary" href="/">Inicio</a>
	</div>

	@* —— Barra de planificación —— *@
	<div class="mesh-toolbar">
		<span class="lbl">View</span>
		@if (mcolViews.Count > 0)
		{
			<div class="btn-group btn-group-sm" role="group">
				@foreach (MeshRouteView candidate in mcolViews)
				{
					<button type="button" class="btn @ViewButtonClass(candidate)" @onclick="() => SelectView(candidate)" title="@candidate.PathSignature()">
						@candidate.Id
					</button>
				}
			</div>
		}

		<span class="sep"></span>
		<span class="lbl">Día</span>
		<div class="btn-group btn-group-sm" role="group">
			@foreach (DayOfWeek day in mcolWeekDays)
			{
				<button type="button" class="btn @DayButtonClass(day)" @onclick="() => SelectDay(day)">@DayLabel(day)</button>
			}
		</div>

		<span class="sep"></span>
		<button type="button" class="btn btn-sm btn-primary" @onclick="ApplyScript" title="Compilar script y planificar malla">Aplicar</button>
		<button type="button" class="btn btn-sm btn-outline-secondary" @onclick="RebuildAsync" title="Regenerar malla">Regenerar</button>
		<button type="button" class="btn btn-sm btn-success" @onclick="CompileProject" disabled="@(mvarMesh is null)" title="Generar Project">Compilar</button>

		<span class="sep"></span>
		<div class="btn-group btn-group-sm">
			<button type="button" class="btn btn-outline-warning" @onclick="ImportRauta" title="Inferir script desde rauta">Rauta</button>
			<button type="button" class="btn btn-outline-secondary" @onclick="UseManualScript">T3</button>
			<button type="button" class="btn btn-outline-secondary" @onclick="UsePalmaSpbScript">SPB</button>
		</div>
	</div>

	@* —— Línea de estado —— *@
	<div class="mesh-statusline">
		@if (mvarMesh is not null && mvarView is not null)
		{
			<div class="mesh-badge-row">
				<span class="badge bg-info text-dark">@mvarView.Id</span>
				<span class="badge bg-primary">@DayLabel(mvarSelectedDay)</span>
				@if (mvarMeshStale)
				{
					<span class="badge bg-secondary">Malla desactualizada</span>
				}
				else
				{
					<span class="badge @(mvarMesh.Success ? "bg-success" : "bg-danger")">@(mvarMesh.Success ? "OK" : "Errores")</span>
				}
				<span class="badge bg-secondary">@mvarMesh.Circulations.Count circ.</span>
				<span class="badge bg-secondary">@mvarMesh.Asimilations.Count asim.</span>
				@if (mvarSelectedCirculation is not null)
				{
					<span class="badge bg-warning text-dark" title="@mvarSelectedCirculation.TechnicalId">
						Sel. @(mvarSelectedCirculation.HasServiceNumber ? mvarSelectedCirculation.ServiceNumber : mvarSelectedCirculation.Id)
					</span>
				}
				@if (!mvarMeshStale && mvarMesh.Warnings.Count > 0)
				{
					<span class="badge bg-warning text-dark">@mvarMesh.Warnings.Count warn</span>
				}
				@if (!mvarMeshStale && mvarMesh.Errors.Count > 0)
				{
					<span class="badge bg-danger">@mvarMesh.Errors.Count err</span>
				}
				@if (mvarProject is not null)
				{
					<span class="badge bg-success">Project @mvarProject.Circulations.Count trenes</span>
				}
			</div>
		}
		<span class="msg @(StatusCssClass)">@StatusText</span>
	</div>

	@* —— Split: malla | editor —— *@
	<div class="mesh-split" @ref="mvarSplitRoot">
		@* Panel malla *@
		<div class="mesh-panel mesh-panel-mesh">
			<div class="mesh-panel-head">
				<span class="title">Malla</span>
				@if (mvarView is not null)
				{
					<span class="badge bg-dark text-light border small">@mvarView.PathSignature()</span>
				}
			</div>

			<div class="mesh-panel-body">
				@* Control reutilizable: StationRuler + plot (Diamond.Controls) *@
				<MeshDiagram Mesh="mvarMesh"
							 View="mvarView"
							 Width="1400"
							 Height="900"
							 ShowLayerToolbar="true"
							 ShowZoomToolbar="true"
							 PlanName="@(mvarPlan?.Name ?? mvarFileName)"
							 PlanningDay="mvarSelectedDay"
							 PrintNotes="@PrintNotesForMesh"
							 @bind-SelectedCirculation="mvarSelectedCirculation" />

				@* Inspector inferior de la malla *@
				<div class="mesh-side-tabs">
					<button type="button" class="@InspectTabClass(InspectTab.Warnings)" @onclick="() => mvarInspectTab = InspectTab.Warnings">
						Warnings @(CurrentMeshWarningCount > 0 ? $"({CurrentMeshWarningCount})" : "")
					</button>
					<button type="button" class="@InspectTabClass(InspectTab.Errors)" @onclick="() => mvarInspectTab = InspectTab.Errors">
						Errores @(CurrentMeshErrorCount > 0 ? $"({CurrentMeshErrorCount})" : "")
					</button>
					<button type="button" class="@InspectTabClass(InspectTab.Project)" @onclick="() => mvarInspectTab = InspectTab.Project">
						Project @(mvarProject is not null ? $"({mvarProject.Circulations.Count})" : "")
					</button>
					<button type="button" class="@InspectTabClass(InspectTab.Notes)" @onclick="() => mvarInspectTab = InspectTab.Notes">
						Notas @(mcolInverseNotes.Count > 0 ? $"({mcolInverseNotes.Count})" : "")
					</button>
				</div>
				<div class="mesh-inspect">
					@if (mvarInspectTab == InspectTab.Warnings)
					{
						@if (mvarMeshStale)
						{
							<div class="empty">Malla desactualizada: aplica el script de nuevo para ver warnings actuales.</div>
						}
						else if (mvarMesh is null || mvarMesh.Warnings.Count == 0)
						{
							<div class="empty">Sin warnings.</div>
						}
						else
						{
							<ul>
								@foreach (string w in mvarMesh.Warnings)
								{
									<li>@w</li>
								}
							</ul>
						}
					}
					else if (mvarInspectTab == InspectTab.Errors)
					{
						@if (mvarMeshStale)
						{
							<div class="empty">Malla desactualizada: los errores de la planificación anterior ya no aplican. Corrige el script y pulsa Aplicar.</div>
						}
						else if (mvarMesh is null || mvarMesh.Errors.Count == 0)
						{
							<div class="empty">Sin errores de malla.</div>
						}
						else
						{
							<ul>
								@foreach (string e in mvarMesh.Errors)
								{
									<li class="text-danger">@e</li>
								}
							</ul>
						}
					}
					else if (mvarInspectTab == InspectTab.Project)
					{
						@if (mvarProject is null)
						{
							<div class="empty">Pulsa <strong>Compilar</strong> para generar el Project.</div>
						}
						else
						{
							<div class="mb-1">
								<strong>@mvarProject.Name</strong>
								<span class="text-muted"> · @mvarProject.Id</span>
								@if (mvarProject.PlanningDay.HasValue)
								{
									<span> · @DayLabel(mvarProject.PlanningDay.Value)</span>
								}
							</div>
							<ul>
								@foreach (Diamond.Project.Asimilation a in mvarProject.Asimilations)
								{
									<li>
										<code>@a.Id</code> @a.Origin.DisplayCode→@a.Destination.DisplayCode
										· @a.Circulations.Count trenes · @FormatDuration(a.TotalTime)
									</li>
								}
							</ul>
							<details class="mt-1">
								<summary>Circulaciones (40 de @mvarProject.Circulations.Count)</summary>
								<ul class="font-monospace">
									@foreach (Diamond.Project.Circulation c in mvarProject.Circulations.Take(40))
									{
										<li>
											@(c.HasServiceNumber ? c.ServiceNumber : c.Id)
											@c.Origin.DisplayCode→@c.Destination.DisplayCode
											@FormatClock(c.Departure)–@FormatClock(c.Arrival)
										</li>
									}
								</ul>
							</details>
						}
					}
					else
					{
						@if (mcolInverseNotes.Count == 0)
						{
							<div class="empty">Sin notas de importación.</div>
						}
						else
						{
							<ul>
								@foreach (string n in mcolInverseNotes)
								{
									<li>@n</li>
								}
							</ul>
						}
					}
				</div>
			</div>
		</div>

		<div class="mesh-gutter" @ref="mvarSplitGutter" title="Arrastrar para redimensionar"></div>

		@* Panel script *@
		<div class="mesh-panel mesh-panel-script">
			<div class="mesh-panel-head">
				<span class="title">Script</span>
				<span class="text-muted small">diamond-demand</span>
				@if (mvarDirty)
				{
					<span class="badge bg-warning text-dark">sin guardar</span>
				}
			</div>
			<div class="mesh-panel-body">
				<div class="diamond-script-editor @(mcolCompileErrors.Count > 0 ? "has-markers" : "")">
					@if (mvarMountEditor)
					{
						<StandaloneCodeEditor @ref="mvarScriptEditor"
											  Id="diamond-demand-editor"
											  ConstructionOptions="EditorConstructionOptions"
											  OnDidInit="OnScriptEditorInit"
											  OnDidChangeModelContent="OnScriptEditorChanged" />
					}
					else
					{
						<div class="diamond-editor-placeholder">Cargando editor…</div>
					}
				</div>

				@if (mvarError is not null || mcolCompileErrors.Count > 0)
				{
					<div class="mesh-diag-list">
						@if (mvarError is not null)
						{
							<div class="text-danger mb-1">@mvarError</div>
						}
						@foreach (ScriptDiagnostic d in mcolCompileErrors)
						{
							<div>
								@if (d.Line > 0)
								{
									<a @onclick="() => GoToDiagnostic(d)" @onclick:preventDefault>línea @d.Line</a>
									<span>: </span>
								}
								@d.Message
							</div>
						}
					</div>
				}

				<div class="mesh-editor-actions">
					<button type="button" class="btn btn-sm btn-primary" @onclick="ApplyScript">Aplicar script y planificar</button>
					<button type="button" class="btn btn-sm btn-outline-light" @onclick="FileSaveAsync">Guardar</button>
					@if (mvarError is not null || mcolCompileErrors.Count > 0)
					{
						<button type="button" class="btn btn-sm btn-outline-secondary" @onclick="ClearErrorPanel">Limpiar errores</button>
					}
				</div>
			</div>
		</div>
	</div>
</div>

@code {
	private enum ZoomAxisMode
	{
		Both,
		Time,
		Space
	}

	private enum InspectTab
	{
		Warnings,
		Errors,
		Project,
		Notes
	}

	private static readonly DayOfWeek[] mcolWeekDays =
	{
		DayOfWeek.Monday,
		DayOfWeek.Tuesday,
		DayOfWeek.Wednesday,
		DayOfWeek.Thursday,
		DayOfWeek.Friday,
		DayOfWeek.Saturday,
		DayOfWeek.Sunday
	};

	private const double MinTimeSpanHours = 0.5;
	private const double MaxTimeSpanHours = 24.0;
	private const long MinPkSpan = 2000L;
	private const double ZoomStep = 1.25;

	private ElementReference mvarHost;
	private ElementReference mvarSplitRoot;
	private ElementReference mvarSplitGutter;
	private DotNetObjectReference<MeshView>? mvarDotNetRef;
	private bool mvarWheelAttached;
	private bool mvarSplitAttached;

	private Diamond.Timed.Mesh? mvarMesh;
	private Diamond.Timed.Circulation? mvarSelectedCirculation;
	private ProjectModel? mvarProject;
	private MeshRouteView? mvarView;
	private List<MeshRouteView> mcolViews = new List<MeshRouteView>();
	private Plan? mvarPlan;
	private string mvarSvgContent = string.Empty;
	private string mvarScript = string.Empty;
	private string? mvarError;
	private string? mvarStatus;
	private List<string> mcolInverseNotes = new List<string>();
	private InspectTab mvarInspectTab = InspectTab.Warnings;
	/// <summary>
	/// True si la malla en pantalla no corresponde al último intento de planificación
	/// (p. ej. el script falló y se conservó el dibujo anterior). No se muestran sus errores como actuales.
	/// </summary>
	private bool mvarMeshStale;

	private StandaloneCodeEditor? mvarScriptEditor;
	private bool mvarMonacoLanguageReady;
	private bool mvarJsReady;

	/// <summary>Monta el editor solo cuando Monaco y el circuito están listos.</summary>
	private bool mvarMountEditor;

	/// <summary>True tras dispose: no más interop (evita tumbar el circuit).</summary>
	private bool mvarDisposed;

	private CancellationTokenSource? mvarLayoutCts;

	// —— Capas visuales de la malla ——
	private bool mvarShowOccupations = true;
	private bool mvarShowTrainPaths = true;
	private bool mvarShowTrainNumbers = true;
	private bool mvarShowConflicts = true;
	private bool mvarShowSpeedStrip = true;
	private bool mvarShowTrackStrip = true;
	private bool mvarShowNowLine = true;
	private TimeSpan mvarClockNow = DateTime.Now.TimeOfDay;
	private System.Threading.Timer? mvarNowTimer;
	private bool mvarMarkersDirty;
	private List<ScriptDiagnostic> mcolCompileErrors = new List<ScriptDiagnostic>();

	// Archivo local
	private string mvarFileName = "sin título.ddm";
	private bool mvarFileHasHandle;
	private bool mvarDirty;
	private string mvarBaselineScript = string.Empty;

	private sealed class ScriptDiagnostic
	{
		private int mvarLine;
		private string mvarMessage = string.Empty;
		private string mvarSeverity = "error";

		public int Line
		{
			get { return mvarLine; }
			set { mvarLine = value; }
		}

		public string Message
		{
			get { return mvarMessage; }
			set { mvarMessage = value ?? string.Empty; }
		}

		public string Severity
		{
			get { return mvarSeverity; }
			set { mvarSeverity = value ?? "error"; }
		}
	}

	/// <summary>DTO de interop con diamond-file.js (propiedades camelCase para deserializar JSON).</summary>
	private sealed class LocalFileResult
	{
		private string? mvarName;
		private string? mvarContent;
		private bool mvarHasHandle;
		private bool mvarSaved;
		private string? mvarMethod;

		public string? name
		{
			get { return mvarName; }
			set { mvarName = value; }
		}

		public string? content
		{
			get { return mvarContent; }
			set { mvarContent = value; }
		}

		public bool hasHandle
		{
			get { return mvarHasHandle; }
			set { mvarHasHandle = value; }
		}

		public bool saved
		{
			get { return mvarSaved; }
			set { mvarSaved = value; }
		}

		public string? method
		{
			get { return mvarMethod; }
			set { mvarMethod = value; }
		}
	}

	private DayOfWeek mvarSelectedDay = DayOfWeek.Monday;
	private string mvarSelectedViewId = DemoMeshService.DefaultViewId;

	private int mvarSvgWidth = 1400;
	private int mvarSvgHeight = 900;

	private TimeSpan mvarViewT0;
	private TimeSpan mvarViewT1;
	private long mvarViewPkMin;
	private long mvarViewPkMax;
	private long mvarAxisPkMin;
	private long mvarAxisPkMax;

	private bool mvarDragging;
	private double mvarLastPointerX;
	private double mvarLastPointerY;
	private ZoomAxisMode mvarZoomMode = ZoomAxisMode.Both;

	/// <summary>Throttle de regeneración SVG durante pan (~30 fps).</summary>
	private long mvarLastInteractiveRenderTicks;

	/// <summary>True mientras el último render fue el modo ligero (sin números/ocupaciones).</summary>
	private bool mvarSvgIsInteractive;

	private CancellationTokenSource? mvarFullRenderCts;

	private string PageTitleText =>
		(mvarDirty ? "• " : string.Empty) + mvarFileName + " — Diamond";

	private string FileDisplayName =>
		mvarDirty ? mvarFileName + " *" : mvarFileName;

	/// <summary>Notas para la carátula de impresión de malla.</summary>
	private string PrintNotesForMesh
	{
		get
		{
			List<string> parts = new List<string>();
			if (!string.IsNullOrWhiteSpace(mvarFileName))
			{
				parts.Add("Archivo: " + mvarFileName);
			}

			if (mvarMeshStale)
			{
				parts.Add("Malla desactualizada respecto al script.");
			}

			if (mvarSelectedCirculation is not null)
			{
				string id = mvarSelectedCirculation.HasServiceNumber
					? mvarSelectedCirculation.ServiceNumber
					: mvarSelectedCirculation.Id;
				parts.Add("Última selección en pantalla: " + id);
			}

			return string.Join(" · ", parts);
		}
	}

	private string StatusText
	{
		get
		{
			if (mvarError is not null)
			{
				return mvarError;
			}

			if (mvarStatus is not null)
			{
				return mvarStatus;
			}

			if (mcolCompileErrors.Count > 0)
			{
				return mcolCompileErrors.Count.ToString(CultureInfo.InvariantCulture) + " error(es) de script.";
			}

			return "Listo.";
		}
	}

	private string StatusCssClass
	{
		get
		{
			if (mvarError is not null || mcolCompileErrors.Count > 0)
			{
				return "err";
			}

			if (mvarStatus is not null && mvarStatus.Contains("compilado", StringComparison.OrdinalIgnoreCase))
			{
				return "ok";
			}

			return string.Empty;
		}
	}

	private string InspectTabClass(InspectTab tab)
	{
		bool active = mvarInspectTab == tab;
		string extra = string.Empty;
		if (!mvarMeshStale && tab == InspectTab.Errors && mvarMesh is not null && mvarMesh.Errors.Count > 0)
		{
			extra = " has-error";
		}
		else if (!mvarMeshStale && tab == InspectTab.Warnings && mvarMesh is not null && mvarMesh.Warnings.Count > 0)
		{
			extra = " has-alert";
		}

		return (active ? "active" : string.Empty) + extra;
	}

	private int CurrentMeshErrorCount =>
		(!mvarMeshStale && mvarMesh is not null) ? mvarMesh.Errors.Count : 0;

	private int CurrentMeshWarningCount =>
		(!mvarMeshStale && mvarMesh is not null) ? mvarMesh.Warnings.Count : 0;

	protected override void OnInitialized()
	{
		if (string.IsNullOrWhiteSpace(mvarScript))
		{
			mvarScript = DemoMeshService.SfmT3DemandScript;
		}

		mvarBaselineScript = mvarScript;
		mvarFileName = "sfm-t3-lab.ddm";
		mvarDirty = false;
		RebuildCore();
	}

	/// <summary>
	/// Excepciones de interop/circuito que no deben mostrar el banner rojo de Blazor.
	/// Nota: JSDisconnectedException hereda de InvalidOperationException.
	/// </summary>
	private static bool IsBenignInteropException(Exception ex)
	{
		return ex is JSException
			|| ex is InvalidOperationException
			|| ex is ObjectDisposedException
			|| ex is TaskCanceledException
			|| ex is OperationCanceledException;
	}

	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		if (mvarDisposed)
		{
			return;
		}

		if (firstRender)
		{
			mvarJsReady = true;
			await WaitForMonacoReadyAsync();
			if (mvarDisposed)
			{
				return;
			}

			if (!mvarMountEditor)
			{
				mvarMountEditor = true;
				// Segundo render: crea StandaloneCodeEditor con Monaco disponible.
				await InvokeAsync(StateHasChanged);
				return;
			}
		}

		if (mvarJsReady && !mvarSplitAttached)
		{
			try
			{
				await Js.InvokeAsync<bool>("diamondSplit.attach", mvarSplitRoot, mvarSplitGutter);
				mvarSplitAttached = true;
				if (mvarScriptEditor is not null)
				{
					await RelayoutMonacoAsync();
				}
			}
			catch (Exception ex) when (IsBenignInteropException(ex))
			{
			}
		}

		if (mvarJsReady && mvarMarkersDirty && mvarScriptEditor is not null)
		{
			await FlushMarkersToEditorAsync();
		}

		// La rueda del plot la gestiona MeshDiagram (Diamond.Controls).
	}

	private async Task WaitForMonacoReadyAsync()
	{
		int attempt = 0;
		while (!mvarDisposed && attempt < 60)
		{
			await EnsureMonacoLanguageAsync();
			if (mvarMonacoLanguageReady)
			{
				return;
			}

			attempt++;
			try
			{
				await Task.Delay(50);
			}
			catch (TaskCanceledException)
			{
				return;
			}
		}
	}

	private StandaloneEditorConstructionOptions EditorConstructionOptions(StandaloneCodeEditor editor)
	{
		return new StandaloneEditorConstructionOptions
		{
			AutomaticLayout = true,
			Language = "diamond-demand",
			Theme = "diamond-dark",
			Value = string.IsNullOrEmpty(mvarScript) ? DemoMeshService.SfmT3DemandScript : mvarScript,
			Minimap = new EditorMinimapOptions { Enabled = false },
			FontSize = 13,
			LineNumbers = "on",
			WordWrap = "on",
			ScrollBeyondLastLine = false,
			RenderLineHighlight = "line",
			TabSize = 2,
			InsertSpaces = true
		};
	}

	private async Task EnsureMonacoLanguageAsync()
	{
		if (mvarMonacoLanguageReady || !mvarJsReady || mvarDisposed)
		{
			return;
		}

		try
		{
			bool ok = await Js.InvokeAsync<bool>("diamondMonaco.ensureLanguageAsync");
			if (ok)
			{
				mvarMonacoLanguageReady = true;
				return;
			}
		}
		catch (Exception ex) when (IsBenignInteropException(ex))
		{
		}

		if (mvarMonacoLanguageReady || mvarDisposed)
