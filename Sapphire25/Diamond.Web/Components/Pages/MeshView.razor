		}

		try
		{
			_error = null;
			_compileErrors = new List<ScriptDiagnostic>();
			DemandInverseCompiler.InverseCompileResult inv = DemoMeshService.ImportRautaToScript();
			_script = inv.Script;
			_fileName = "rauta-import.ddm";
			_fileHasHandle = false;
			_inverseNotes = new List<string>(inv.Notes);
			if (inv.Warnings.Count > 0)
			{
				_inverseNotes.AddRange(inv.Warnings.Select(w => "⚠ " + w));
