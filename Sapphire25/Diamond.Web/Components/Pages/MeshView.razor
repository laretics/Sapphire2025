	private static List<ScriptDiagnostic> BuildDiagnosticsFromCompile(DemandCompileResult compiled)
	{
		List<ScriptDiagnostic> list = new List<ScriptDiagnostic>();
		int i = 0;
		while (i < compiled.Errors.Count)
		{
			string raw = compiled.Errors[i];
			int line = 0;
			string message = raw;

			if (raw.StartsWith("line ", StringComparison.OrdinalIgnoreCase))
			{
				int colon = raw.IndexOf(':');
				if (colon > 5)
				{
					string numPart = raw.Substring(5, colon - 5).Trim();
					int parsed;
					if (int.TryParse(numPart, NumberStyles.Integer, CultureInfo.InvariantCulture, out parsed))
					{
						line = parsed;
						message = raw.Substring(colon + 1).Trim();
					}
				}
			}

			list.Add(new ScriptDiagnostic
			{
				Line = line,
				Message = message,
				Severity = "error"
			});
			i++;
		}

		return list;
	}

	private async Task FlushMarkersToEditorAsync()
	{
		if (!mvarJsReady || mvarDisposed)
		{
			mvarMarkersDirty = true;
			return;
		}

		try
		{
			if (mcolCompileErrors.Count == 0)
			{
				await Js.InvokeAsync<bool>("diamondMonaco.clearMarkers");
				mvarMarkersDirty = false;
				return;
			}

			List<object> markers = new List<object>();
			int i = 0;
			while (i < mcolCompileErrors.Count)
			{
				ScriptDiagnostic d = mcolCompileErrors[i];
				markers.Add(new
				{
					line = d.Line > 0 ? d.Line : 1,
					message = d.Message,
					severity = d.Severity
				});
				i++;
			}

			bool ok = await Js.InvokeAsync<bool>("diamondMonaco.setMarkers", markers);
			mvarMarkersDirty = !ok;
		}
		catch (Exception ex) when (IsBenignInteropException(ex))
		{
			mvarMarkersDirty = true;
		}
	}

	private static bool ScriptLooksLikePalmaSaPobla(string script)
	{
		if (string.IsNullOrEmpty(script))
		{
			return false;
		}

		bool hasPmi = script.IndexOf("PMI", StringComparison.OrdinalIgnoreCase) >= 0;
		bool hasSpb = script.IndexOf("SPB", StringComparison.OrdinalIgnoreCase) >= 0
			|| script.IndexOf("Sa Pobla", StringComparison.OrdinalIgnoreCase) >= 0;
		bool multiHint = script.IndexOf("multi-eje", StringComparison.OrdinalIgnoreCase) >= 0
			|| script.IndexOf("T3+T2", StringComparison.OrdinalIgnoreCase) >= 0
			|| script.IndexOf("T3:", StringComparison.OrdinalIgnoreCase) >= 0;
		return hasPmi && hasSpb && (multiHint || script.IndexOf("PMI -> SPB", StringComparison.OrdinalIgnoreCase) >= 0);
	}

