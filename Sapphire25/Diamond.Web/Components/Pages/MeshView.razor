@page "/mesh"
@rendermode InteractiveServer
@using System.Globalization
@using Diamond.Timed
@using Diamond.Topo
@using Diamond.Web.Rendering
@using Diamond.Web.Services

<PageTitle>Malla T3 — Diamond</PageTitle>

<h1>Malla horaria</h1>
<p class="text-muted mb-2">
	Eje <strong>T3 Palma–Manacor</strong> del sample SFM.
	Eje X = tiempo · Eje Y = estaciones.
	<strong>Rueda</strong> = zoom · <strong>Arrastrar</strong> = desplazar · botones = control fino.
</p>

@if (_error is not null)
{
	<div class="alert alert-danger">@_error</div>
}
else if (_mesh is not null && _axis is not null)
{
	<div class="mb-3 d-flex flex-wrap gap-2 align-items-center">
		<span class="badge bg-info text-dark">@_axis.Id · @_axis.Name</span>
		<span class="badge bg-success">@(_mesh.Success ? "OK" : "Con errores")</span>
		<span class="badge bg-secondary">@_mesh.Circulations.Count circulaciones</span>
		<span class="badge bg-secondary">@_mesh.Asimilations.Count asimilaciones</span>
		<span class="badge bg-warning text-dark">@_mesh.Warnings.Count warnings</span>
		<span class="badge bg-danger">@_mesh.Errors.Count errors</span>
		<button class="btn btn-sm btn-outline-secondary" @onclick="Rebuild">Regenerar</button>
	</div>

	<div class="mb-2 d-flex flex-wrap gap-2 align-items-center mesh-zoom-toolbar">
		<button type="button" class="btn btn-sm btn-outline-light" @onclick="ZoomIn" title="Acercar">+</button>
		<button type="button" class="btn btn-sm btn-outline-light" @onclick="ZoomOut" title="Alejar">−</button>
		<button type="button" class="btn btn-sm btn-outline-light" @onclick="ResetView" title="Vista inicial">Reset</button>
		<button type="button" class="btn btn-sm btn-outline-light" @onclick="() => Nudge(-80, 0)">←</button>
		<button type="button" class="btn btn-sm btn-outline-light" @onclick="() => Nudge(80, 0)">→</button>
		<button type="button" class="btn btn-sm btn-outline-light" @onclick="() => Nudge(0, -80)">↑</button>
		<button type="button" class="btn btn-sm btn-outline-light" @onclick="() => Nudge(0, 80)">↓</button>
		<span class="badge bg-dark text-light border">zoom @((_scale * 100).ToString("0", CultureInfo.InvariantCulture))%</span>
	</div>

	@if (_mesh.Warnings.Count > 0)
	{
		<details class="mb-2">
			<summary>Warnings (@_mesh.Warnings.Count)</summary>
			<ul class="small">
				@foreach (string w in _mesh.Warnings)
				{
					<li>@w</li>
				}
			</ul>
		</details>
	}

	@if (_mesh.Errors.Count > 0)
	{
		<details class="mb-2">
			<summary class="text-danger">Errors (@_mesh.Errors.Count)</summary>
			<ul class="small">
				@foreach (string e in _mesh.Errors)
				{
					<li>@e</li>
				}
			</ul>
		</details>
	}

	<div class="mesh-svg-host border rounded bg-dark @(_dragging ? "mesh-dragging" : "")"
		 @onwheel="OnWheel"
		 @onwheel:preventDefault
		 @onpointerdown="OnPointerDown"
		 @onpointermove="OnPointerMove"
		 @onpointerup="OnPointerUp"
		 @onpointerleave="OnPointerUp"
		 @onpointercancel="OnPointerUp">
		<svg xmlns="http://www.w3.org/2000/svg"
			 width="@_svgWidth"
			 height="@_svgHeight"
			 viewBox="0 0 @_svgWidth @_svgHeight"
			 class="mesh-svg-canvas">
			@* Fondo de recorte de la ventana *@
			<rect width="100%" height="100%" fill="#0f1419" />
			@* Contenido de malla: pan/zoom vía transform SVG *@
			<g transform="@TransformAttribute">
				@((MarkupString)_svgContent)
			</g>
		</svg>
	</div>

	<pre class="mt-3 small bg-light p-2 rounded">@_script</pre>
}

@code {
	private const double MinScale = 0.35;
	private const double MaxScale = 6.0;
	private const double ZoomStep = 1.2;

	private Diamond.Timed.Mesh? _mesh;
	private Axis? _axis;
	private Plan? _plan;
	private string _svgContent = string.Empty;
	private string _script = string.Empty;
	private string? _error;

	private int _svgWidth = 1400;
	private int _svgHeight = 900;

	private double _scale = 1.0;
	private double _tx = 0.0;
	private double _ty = 0.0;
	private bool _dragging;
	private double _lastPointerX;
	private double _lastPointerY;

	private string TransformAttribute =>
		string.Create(CultureInfo.InvariantCulture, $"translate({_tx} {_ty}) scale({_scale})");

	protected override void OnInitialized()
	{
		Rebuild();
	}

	private void Rebuild()
	{
		try
		{
			_error = null;
			(_plan, _mesh, _axis) = DemoMeshService.BuildDemo();
			_script = _plan!.DemandScript;
			_svgContent = MeshSvgRenderer.RenderContent(
				_mesh!,
				_axis!,
				TimeSpan.FromHours(6),
				TimeSpan.FromHours(14),
				width: _svgWidth,
				height: _svgHeight);
			ResetView();
		}
		catch (Exception ex)
		{
			_error = ex.Message;
			_mesh = null;
			_axis = null;
			_svgContent = string.Empty;
		}
	}

	private void ResetView()
	{
		_scale = 1.0;
		_tx = 0.0;
		_ty = 0.0;
	}

	private void ZoomIn()
	{
		ZoomAt(_svgWidth * 0.5, _svgHeight * 0.5, ZoomStep);
	}

	private void ZoomOut()
	{
		ZoomAt(_svgWidth * 0.5, _svgHeight * 0.5, 1.0 / ZoomStep);
	}

	private void Nudge(double dx, double dy)
	{
		_tx += dx;
		_ty += dy;
	}

	private void OnWheel(WheelEventArgs e)
	{
		double factor = e.DeltaY < 0 ? ZoomStep : 1.0 / ZoomStep;
		// OffsetX/Y relativos al elemento que recibe el evento (el host del SVG)
		ZoomAt(e.OffsetX, e.OffsetY, factor);
	}

	private void OnPointerDown(PointerEventArgs e)
	{
		if (e.Button != 0)
		{
			return;
		}

		_dragging = true;
		_lastPointerX = e.ClientX;
		_lastPointerY = e.ClientY;
	}

	private void OnPointerMove(PointerEventArgs e)
	{
		if (!_dragging)
		{
			return;
		}

		double dx = e.ClientX - _lastPointerX;
		double dy = e.ClientY - _lastPointerY;
		_lastPointerX = e.ClientX;
		_lastPointerY = e.ClientY;
		_tx += dx;
		_ty += dy;
	}

	private void OnPointerUp(PointerEventArgs e)
	{
		_dragging = false;
	}

	/// <summary>
	/// Zoom centrado en un punto del SVG (coordenadas del viewport del diagrama).
	/// Mantiene fijo el punto del mundo bajo el cursor.
	/// </summary>
	private void ZoomAt(double svgX, double svgY, double factor)
	{
		double newScale = _scale * factor;
		if (newScale < MinScale)
		{
			newScale = MinScale;
		}

		if (newScale > MaxScale)
		{
			newScale = MaxScale;
		}

		// world = (screen - t) / s
		// screen = world * s' + t'  =>  t' = screen - world * s'
		double worldX = (svgX - _tx) / _scale;
		double worldY = (svgY - _ty) / _scale;
		_scale = newScale;
		_tx = svgX - worldX * _scale;
		_ty = svgY - worldY * _scale;
	}
}
