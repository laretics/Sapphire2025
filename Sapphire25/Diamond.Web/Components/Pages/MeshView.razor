	private void InitAxisBounds()
	{
		if (_view is null)
		{
			return;
		}

		_axisPkMin = Math.Min(_view.PK, _view.PKEnd);
		_axisPkMax = Math.Max(_view.PK, _view.PKEnd);
	}

	private void ResetViewWindow()
	{
		_viewT0 = TimeSpan.FromHours(6);
		_viewT1 = TimeSpan.FromHours(14);
		_viewPkMin = _axisPkMin;
		_viewPkMax = _axisPkMax;
	}

	private void RefreshSvg()
	{
		if (_mesh is null || _view is null)
		{
			return;
		}

		ClampView();
		_svgContent = MeshSvgRenderer.RenderContent(
			_mesh,
			_view,
			_viewT0,
			_viewT1,
			_viewPkMin,
			_viewPkMax,
			width: _svgWidth,
			height: _svgHeight);
	}

	private void ResetView()
	{
		ResetViewWindow();
		RefreshSvg();
	}

