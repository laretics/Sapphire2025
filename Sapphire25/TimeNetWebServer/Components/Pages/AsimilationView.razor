@page "/asimilationvw/{TopoStorageId:guid}/{AsimilationId}"
@using TimeNet2026.Timed
@using TimeNet2026.Topo
@using TimeNet2026.Storage
@inject OnyxStorage mvarStorage

<div>Antes del control</div>
<TimeNetControl Width="400" Height="400" Storage="@mvarTopoStorage" Asimilation="@mvarAsimilation"/>
<TimeNetControl Width="800" Height="300" Storage="@mvarTopoStorage" Asimilation="@mvarAsimilation" PkMode="true"/>
<div>Después del control</div>

@code {
    [Parameter]
    public Guid TopoStorageId { get; set; }
    [Parameter]
    public string? AsimilationId { get; set; }

    private Asimilation? mvarAsimilation {get;set;}

    private TopoStorage? mvarTopoStorage {get;set;}

    protected async override Task OnInitializedAsync()
    {
        await mvarStorage.Init();
        if(mvarStorage.Storages.ContainsKey(TopoStorageId))
        {
            mvarTopoStorage = mvarStorage.Storages[TopoStorageId];
            mvarAsimilation = mvarTopoStorage.GetAsimilation(AsimilationId);
        }              
    }
}
