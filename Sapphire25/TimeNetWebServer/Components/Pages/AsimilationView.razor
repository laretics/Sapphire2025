@page "/asimilationview/{TopoStorageId}/{RautatieId}/{PlanId}/{AsimilationId}"
@using TimeNet2026.Timed
@using TimeNet2026.Topo
@using TimeNet2026.Storage
@using TimeNet2026.Production
@using TimeNet2026Data
@using TimeNetComponents.Controls.TimeNetControl
@inject OnyxStorage mvarStorage
@inject TimeNetContext context

@rendermode InteractiveServer
@if(null==mvarEnvironment)
{
        <p>Loading...</p>
}
else
{
    <div style="display:flex; flex-direction:column; gap:0; align-items:flex-start;">
        <div style="display:flex; flex-direction:row; gap:0;">
            <TimeNetSliderY Environment="@mvarEnvironment"
                            StateChanged="@auxStateChanged"/>

            <TimeNetControl Environment="@mvarEnvironment"
                            Style="@mvarStyle"
                            Selections="@mvarSelection"
                            Splines="false" />
        </div>

        <TimeNetSliderX Environment="@mvarEnvironment"
                        StateChanged="@auxStateChanged"
                        />
    </div>
}

@code {
    [Parameter]
    public string? TopoStorageId{ get; set; }
    [Parameter]
    public string? AsimilationId { get; set; }
    [Parameter]
    public string? RautatieId{ get; set; }
    [Parameter]
    public string? PlanId { get; set; }

    private TimeNetControlEnvironment? mvarEnvironment { get; set; }
    private TimeNetControlStyle mvarStyle { get; set; } = new TimeNetControlStyle();
    private TimeNetSelection mvarSelection{ get; set; } = new TimeNetSelection();
    private void auxStateChanged() { StateHasChanged(); }

    protected async override Task OnInitializedAsync()
    {
        await mvarStorage.DeserializeMemory(context);
        mvarEnvironment = new TimeNetControlEnvironment(1400,700);

        TimeNetEnvironment enviro = new TimeNetEnvironment(mvarStorage, TopoStorageId, AsimilationId, RautatieId, PlanId);
        mvarEnvironment.Environment = enviro;

    }
}
