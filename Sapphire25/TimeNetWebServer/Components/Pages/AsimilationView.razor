@page "/asimilationview/{TopoStorageId}/{RautatieId}/{PlanId}/{AsimilationId}"
@using TimeNet2026.Timed
@using TimeNet2026.Topo
@using TimeNet2026.Storage
@inject OnyxStorage mvarStorage

@rendermode InteractiveServer

<TimeNetControl
                Environment="@mvarEnvironment"
                Style="@mvarStyle"
                Selections="@mvarSelection"
                Splines="false" PkMode="true" />
@code {
    //https://localhost:7211/asimilationvw/fst2025/44x1L
    [Parameter]
    public string? TopoStorageId{ get; set; }
    [Parameter]
    public string? AsimilationId { get; set; }
    [Parameter]
    public string? RautatieId{ get; set; }
    [Parameter]
    public string? PlanId { get; set; }

    private TimeNetControlEnvironment mvarEnvironment { get; set; }
    private TimeNetControlStyle mvarStyle { get; set; } = new TimeNetControlStyle(1400,800);
    private TimeNetControlSelection mvarSelection{ get; set; } = new TimeNetControlSelection();

    protected async override Task OnInitializedAsync()
    {
        await mvarStorage.Init();
        mvarEnvironment = new TimeNetControlEnvironment(mvarStorage, TopoStorageId,AsimilationId,RautatieId,PlanId);

    }
}
