@page "/browser"
@rendermode InteractiveServer
@using TimeNet2026.Storage
@using TimeNet2026.Production
@using TimeNet2026.Timed
@using TimeNetComponents.TreeView
@using TimeNetComponents.Controls.TimeNetControl
@inject OnyxStorage mvarStorage
@inject IJSRuntime JS
@implements IAsyncDisposable

<div class="container-fluid p-0 h-100">
    <div class="row g-0 h-100">
        <!-- Panel izquierdo: TreeView (1/4) -->
        <div class="col-3 border-end d-flex flex-column" id="leftPanel">
            <div class="p-3 bg-light border-bottom">
                <h5 class="mb-0">Explorador</h5>
            </div>
            <div class="flex-grow-1 p-2" style="position: relative; min-height: 0;">
                @if (entornoArbol != null)
                {
                    <TreeView 
                        Environment="@entornoArbol" 
                        OnEntitySelected="@OnEntitySelected" />
                }
                else
                {
                    <div class="text-center text-muted p-4">
                        <div class="spinner-border spinner-border-sm" role="status">
                            <span class="visually-hidden">Cargando...</span>
                        </div>
                        <p class="mt-2 mb-0">Cargando árbol...</p>
                    </div>
                }
            </div>
        </div>

        <!-- Splitter vertical -->
        <div class="col-auto p-0" style="width:4px;cursor:col-resize;background:#dee2e6;" id="splitter"></div>

        <!-- Panel derecho: Encabezado + TimeNetControl (3/4) -->
        <div class="col d-flex flex-column">
            <!-- Encabezado contextual (1/4 vertical) -->
            <div class="border-bottom bg-white p-3" style="max-height: 20vh; overflow-y: auto;">
                <h6 class="text-muted mb-3">Menú Contextual</h6>
                <div class="btn-toolbar mb-2" role="toolbar">
                    <div class="btn-group me-2" role="group">
                        <button class="btn btn-sm btn-outline-primary" @onclick="ZoomIn">
                            <i class="bi bi-zoom-in"></i> Zoom +
                        </button>
                        <button class="btn btn-sm btn-outline-primary" @onclick="ZoomOut">
                            <i class="bi bi-zoom-out"></i> Zoom -
                        </button>
                    </div>
                    <div class="btn-group me-2" role="group">
                        <button class="btn btn-sm btn-outline-secondary" @onclick="ExportImage">
                            <i class="bi bi-download"></i> Exportar
                        </button>
                        <button class="btn btn-sm btn-outline-secondary" @onclick="PrintDiagram">
                            <i class="bi bi-printer"></i> Imprimir
                        </button>
                    </div>
                </div>
                <div class="form-check form-switch mb-2">
                    <input class="form-check-input" type="checkbox" id="showCurrentTime" @bind="showCurrentTime">
                    <label class="form-check-label" for="showCurrentTime">
                        Mostrar hora actual
                    </label>
                </div>
            </div>

            <!-- TimeNetControl (3/4 vertical) -->
            <div @ref="timenetContainer" 
                class="flex-grow-1 bg-light d-flex align-items-center justify-content-center" 
                style="overflow: hidden;">
                @if (null != entornoMalla)
                {
                    <TimeNetControl Environment="@entornoMalla"
                                    Style="@controlStyle"
                                    Selections="@mvarSelection"
                                    Latitude="40.4168"
                                    Longitude="-3.7038" />
                }
                else
                {
                    <div class="text-center text-muted">
                        <div class="spinner-border mb-3" role="status">
                            <span class="visually-hidden">Cargando...</span>
                        </div>
                        <p>Cargando diagrama...</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@code {
    private IJSObjectReference? jsModulo;
    private TimeNetEnvironment? entornoTN;
    private TreeViewEnvironment? entornoArbol;
    private TimeNetControlEnvironment? entornoMalla;
    private TimeNetSelection? mvarSelection;
    private TimeNetControlStyle controlStyle = new();
    private ElementReference timenetContainer;

    private bool showCurrentTime = true;
    private string? startTime;
    private string? endTime;

    protected override async Task OnInitializedAsync()
    {
        await mvarStorage.Init();
        entornoTN = new TimeNetEnvironment(mvarStorage);
        entornoArbol = new TreeViewEnvironment(entornoTN);
        controlStyle.CurrentTime = showCurrentTime;

        // Valores por defecto para selección de tiempo
        startTime = "00:00";
        endTime = "23:59";
    }
    protected async override Task OnAfterRenderAsync(bool firstRender)
    {
        if(firstRender)
        {
            jsModulo = await JS.InvokeAsync<IJSObjectReference>("import", "./routines.js");
            await jsModulo.InvokeVoidAsync("initializeSplitter", "splitter", "leftpanel");

            await InitializeTimeNetControl();
        }
    }

    protected override void OnParametersSet()
    {
        if (controlStyle != null)
        {
            controlStyle.CurrentTime = showCurrentTime;
        }
    }
    public async ValueTask DisposeAsync()
    {
        if (jsModulo != null)
        {
            await jsModulo.DisposeAsync();
        }
    }

    private void OnEntitySelected(TimeNetComponents.TreeView.TreeNode node)
    {
        TimeNet2026.Entity? entidad = node.EntityLinked;
        if (null != entornoMalla && null!=entidad)
        {
            entornoTN = node.NetEnvironment;
            entornoMalla.Environment = entornoTN;
            TimeLapseCollection lapso = entornoMalla.Environment.ViewLapse();
            TimeLapse? envolvente = lapso.Envolvent();
            if(null!=envolvente)
                entornoMalla.XX.LapseX = envolvente.Inflate(new TimeSpan(0, 15, 0));
                     
            if (entidad.GetType() == typeof(TimeNet2026.Timed.Asimilation))
                mvarSelection?.SelectAsimilation(node.NetEnvironment, entidad as TimeNet2026.Timed.Asimilation);
            else if (entidad.GetType() == typeof(TimeNet2026.Timed.CirculationBlock))
                mvarSelection?.SelectCirculationBlock(node.NetEnvironment, entidad as TimeNet2026.Timed.CirculationBlock);
            else if (entidad.GetType() == typeof(TimeNet2026.Timed.Circulation))
                mvarSelection?.SelectCirculation(node.NetEnvironment, entidad as TimeNet2026.Timed.Circulation);
        }
        StateHasChanged();
    }
    private async Task InitializeTimeNetControl()
    {
        if(null!=jsModulo && null!=entornoTN?.TopoStorage)
        {
            try
            {
                Dictionary<string,int> dimensions = await jsModulo.InvokeAsync<Dictionary<string, int>>("getElementDimensions", timenetContainer);
                if(dimensions["width"]>0 && dimensions["height"]>0)
                {
                    entornoMalla = new TimeNetControlEnvironment(
                        dimensions["width"],
                        dimensions["height"]
                    );
                    mvarSelection = new TimeNetSelection();
                    StateHasChanged();
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine("Error initializing TimeNetControl: " + ex.Message);
            }
        }
    }

    private void ZoomIn()
    {
        StateHasChanged();
    }

    private void ZoomOut()
    {
        StateHasChanged();
    }

    private void ExportImage()
    {
        // TODO: Implementar exportación
    }

    private void PrintDiagram()
    {
        // TODO: Implementar impresión
    }
    private class ElementDimensions
    {
        public int Width { get; set; }
        public int Height { get; set; }
    }
}