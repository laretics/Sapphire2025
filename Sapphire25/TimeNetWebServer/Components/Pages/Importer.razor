@page "/importer"
@rendermode InteractiveServer
@using TimeNetComponents.TreeView
@inject IJSRuntime JS
@inject TimeNet2026.Storage.OnyxStorage mvarStorage

@if(mvarBusy)
{
    <div class="modal-backdrop fade show"></div>
    <div class="modal d-block" tabindex="-1" style="background:rgba(255,255,255,0.7);z-index:1050;">
        <div class="d-flex justify-content-center align-items-center" style="height:100vh;">
            <div class="spinner-border text-primary" role="status" style="width:4rem;height:4rem;">
                <span class="visually-hidden">Cargando...</span>
            </div>
            <span class="ms-3 fs-4">Procesando, por favor espera...</span>
        </div>
    </div>
}
<div class="container-fluid">
    <!-- Barra de herramientas -->
    <div class="row mb-3">
        <div class="col">
            <div class="btn-toolbar" role="toolbar">
                <div class="btn-group me-2" role="group">
                    <button class="btn btn-primary" @onclick="TriggerFileInput">
                        <i class="bi bi-upload"></i> Importar
                    </button>
                    <button class="btn btn-danger" @onclick="DeleteData">
                        <i class="bi bi-trash"></i> Eliminar datos
                    </button>
                    <button class="btn btn-secondary" @onclick="OtherOption1">
                        <i class="bi bi-gear"></i> Opción 1
                    </button>
                    <button class="btn btn-secondary" @onclick="OtherOption2">
                        <i class="bi bi-info-circle"></i> Opción 2
                    </button>
                </div>
            </div>
            <!-- InputFile oculto para el botón Importar -->
            <InputFile OnChange="HandleFileSelected" class="d-none" @ref="fileInput" id="fileInput" />
        </div>
    </div>

    <div class="row" style="height: 80vh;">
        <!-- Panel izquierdo: TreeView con scroll -->
        <div class="col-4 border-end d-flex flex-column p-0" style="overflow-y: auto; max-height: 80vh;">
            <TreeView Node="new OnyxStorageNode(mvarStorage)" />
        </div>
        <!-- Splitter como columna estrecha -->
        <div class="col-auto p-0" style="width:6px;cursor:col-resize;background:#e0e0e0;" id="splitter"></div>
        <!-- Panel derecho: contenido actual -->
        <div class="col-4 d-flex flex-column p-4">
            <h1>Importador</h1>
            <div class="card shadow-sm mt-4 w-100" style="max-width: 100%;">
                <div class="card-body">
                    <h5 class="card-title mb-3">Selecciona un archivo para importar</h5>
                    @if (!string.IsNullOrEmpty(FileName))
                    {
                        <div class="alert alert-success mt-3 p-2">
                            Archivo seleccionado: <strong>@FileName</strong>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>


<script>
    let isResizing = false;
    let lastDownX = 0;
    const left = document.querySelector('.col-4');
    const splitter = document.getElementById('splitter');
    splitter.addEventListener('mousedown', function(e) {
        isResizing = true;
        lastDownX = e.clientX;
        document.body.style.cursor = 'col-resize';
    });
    document.addEventListener('mousemove', function(e) {
        if (!isResizing) return;
        let offsetRight = document.body.offsetWidth - (e.clientX);
        left.style.flex = 'none';
        left.style.width = (e.clientX - left.parentElement.offsetLeft) + 'px';
    });
    document.addEventListener('mouseup', function(e) {
        isResizing = false;
        document.body.style.cursor = '';
    });
    window.triggerFileInput = function (inputId) {
        document.getElementById(inputId).click();
    };
</script>

@code {
    private string? FileName;
    private InputFile? fileInput;
    private bool mvarBusy { get; set; } = false;

    protected override async Task OnInitializedAsync()
    {        
        await mvarStorage.Init();
    }

    private async Task TriggerFileInput()
    {
        await JS.InvokeVoidAsync("triggerFileInput", "fileInput");
    }

    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        FileName = file.Name;
        Console.WriteLine("Evento disparado");
        mvarBusy = true;
        StateHasChanged();
        TimeNetWebServer.Classes.XMLImporter importador = new Classes.XMLImporter();
        XmlElement? elemento = await importador.ImportXML(file.OpenReadStream());
        if (null != elemento)
            await mvarStorage.deserializeXML(elemento);
        await Task.Yield(); //Para mostrar la pantalla de carga.
        mvarBusy = false;
        StateHasChanged();
    }

    private async Task DeleteData()
    {
        mvarBusy = true;
        StateHasChanged();
        await Task.Yield(); //Para mostrar la pantalla de carga.
        // Lógica para eliminar datos del almacén
        await mvarStorage.EmptyDatabase();
        FileName = null;
        mvarBusy = false;
        StateHasChanged();
    }

    private void OtherOption1()
    {
        // Lógica para la opción 1
    }

    private void OtherOption2()
    {
        // Lógica para la opción 2
    }
}