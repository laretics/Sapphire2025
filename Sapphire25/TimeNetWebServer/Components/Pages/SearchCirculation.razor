@page "/searchcirculation/{TopoStorageId}"
@rendermode InteractiveServer
@using TimeNet2026.Timed
@using TimeNet2026.Topo
@using TimeNet2026.Storage
@using TimeNetComponents.TreeView
@using TimeNetComponents.Controls.TimeNetControl
@inject OnyxStorage mvarStorage

<div class="container-fluid vh-100 p-0 overflow-hidden">
    <div class="row g-0 h-100">
        <!-- Panel izquierdo: TreeView (25% del ancho) -->
        <div class="col-3 h-100 border-end bg-light shadow-sm">
            <TreeView Node="new OnyxStorageNode(mvarStorage)" />
        </div>

        <!-- Panel derecho: Contenido principal (75% del ancho) -->
        <div class="col-9 h-100 d-flex flex-column">
            <!-- Sección superior: Malla (50% del alto) -->
            <div class="flex-fill border-bottom bg-white p-3">
                @if(null == mvarEnvironment)
                {
                    <div class="alert alert-info d-flex align-items-center" role="alert">
                        <i class="bi bi-info-circle-fill me-2"></i>
                        <div>Este texto debería mostrarse en un cuadro bonito</div>
                    </div>
                }
                else
                {
                    <div class="d-flex flex-column h-100 gap-2">
                        <div class="d-flex flex-row gap-2 flex-fill">
                            <div class="border rounded shadow-sm">
                                <TimeNetSliderY Environment="@mvarEnvironment"
                                                StateChanged="@auxStateChanged" />
                            </div>
                            
                            <div class="flex-fill border rounded shadow-sm p-2 bg-light">
                                <TimeNetControl Environment="@mvarEnvironment"
                                                Style="@mvarStyle"
                                                Selections="@mvarSelection"
                                                Splines="false" />
                            </div>
                        </div>

                        <div class="border rounded shadow-sm">
                            <TimeNetSliderX Environment="@mvarEnvironment"
                                            StateChanged="@auxStateChanged" />
                        </div>
                    </div>
                }
            </div>

            <!-- Sección inferior: Controles y botones (50% del alto) -->
            <div class="flex-fill bg-light p-3">
                <div class="card h-100 shadow-sm">
                    <div class="card-header bg-primary text-white">
                        <h5 class="mb-0">
                            <i class="bi bi-sliders"></i> Panel de Control
                        </h5>
                    </div>
                    <div class="card-body overflow-auto">
                        <div class="row g-3">
                            <!-- Aquí puedes agregar tus controles y botones -->
                            <div class="col-12">
                                <div class="btn-toolbar gap-2" role="toolbar">
                                    <button type="button" class="btn btn-primary">
                                        <i class="bi bi-play-fill"></i> Iniciar
                                    </button>
                                    <button type="button" class="btn btn-secondary">
                                        <i class="bi bi-pause-fill"></i> Pausar
                                    </button>
                                    <button type="button" class="btn btn-danger">
                                        <i class="bi bi-stop-fill"></i> Detener
                                    </button>
                                    <button type="button" class="btn btn-success">
                                        <i class="bi bi-arrow-clockwise"></i> Reiniciar
                                    </button>
                                </div>
                            </div>
                            
                            <div class="col-md-6">
                                <label class="form-label">Parámetro 1</label>
                                <input type="range" class="form-range" min="0" max="100" />
                            </div>
                            
                            <div class="col-md-6">
                                <label class="form-label">Parámetro 2</label>
                                <input type="range" class="form-range" min="0" max="100" />
                            </div>
                            
                            <div class="col-12">
                                <label class="form-label">Configuración</label>
                                <select class="form-select">
                                    <option selected>Seleccionar opción...</option>
                                    <option value="1">Opción 1</option>
                                    <option value="2">Opción 2</option>
                                    <option value="3">Opción 3</option>
                                </select>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public string? TopoStorageId { get; set; }
    private void auxStateChanged() { StateHasChanged(); }

    private TimeNetControlEnvironment? mvarEnvironment { get; set; }
    private TimeNetControlStyle mvarStyle { get; set; } = new TimeNetControlStyle();
    private TimeNetControlSelection mvarSelection { get; set; } = new TimeNetControlSelection();
    protected override async Task OnInitializedAsync()
    {
        await mvarStorage.Init();
    }

}
