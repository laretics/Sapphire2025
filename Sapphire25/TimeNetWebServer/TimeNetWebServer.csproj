    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Configurations>Debug;Release;TimeNet</Configurations>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\TimeNet2026\TimeNet2026.csproj" />
