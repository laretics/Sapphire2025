<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ServiceWorkerAssetsManifest>service-worker-assets.js</ServiceWorkerAssetsManifest>
    <!--
      SDK-style projects glob **/* under the project directory.
      Without these excludes, Sapphire25.csproj swallows sources from nested
      projects (Tourmaline26, Sapphire2026*, Diamond*, …). That produces thousands
      of design-time errors and breaks IntelliSense on those files when the IDE
      associates them with this project instead of their real .csproj.
    -->
    <DefaultItemExcludes>$(DefaultItemExcludes)
      ;AppSettingsEditor\**
      ;BenchmarkSuite1\**
      ;BenchmarkDotNet.Artifacts\**
      ;Diamond\**
      ;Diamond.Controls\**
      ;Diamond.Tests\**
      ;Diamond.Web\**
      ;FreeTrainSimulator.Common\**
      ;FreeTrainSimulator.Graphics\**
      ;FreeTrainSimulator.Models.Imported\**
      ;MonoGameRenderer\**
      ;MonoGameSimulator\**
      ;Orts.Formats\**
      ;Sapphire2025\**
      ;Sapphire2025Server\**
      ;Sapphire2026Clients\**
      ;Sapphire2026Data\**
      ;Sapphire2026Telegram\**
      ;Sapphire26BotSoulTest\**
      ;SimulatorSerializator\**
      ;Tourmaline26\**
    </DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <ServiceWorker Include="wwwroot\service-worker.js" PublishedContent="wwwroot\service-worker.published.js" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Icons\Roles\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Authorization" Version="8.0.14" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="8.0.14" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Authentication" Version="8.0.14" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Sapphire25.Models\Sapphire25.Models.csproj" />
  </ItemGroup>

</Project>
