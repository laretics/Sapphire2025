<div style="position: absolute; top: 0; left: 0; right: 0; bottom: 0; overflow-y: auto; overflow-x: hidden;">
    @if (null != Environment)
    {
        <ul class="list-group list-unstyled">
            <SubTreeView 
                Node="@Environment.Root"
                OnNodeSelected="@OnNodeClicked"/>
        </ul>
    }
</div>

@code {
    [Parameter]
    public TreeViewEnvironment? Environment { get; set; }
    [Parameter]
    public EventCallback<TreeNode> OnEntitySelected { get; set; }

    private async Task OnNodeClicked(TreeNode node)
    {
        if (null!= node.EntityLinked)
            await OnEntitySelected.InvokeAsync(node);
    }
}