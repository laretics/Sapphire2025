@using TimeNet2026.Topo
@using System.Globalization

<TimeNetLayer LayerClass="y-column-lines-layer" Transform="@auxTransformString">
    @if (Environment?.Environment.ViewAsimilation?.origin != null)
    {
        string textoRight = Environment.XX.mvarGraphicalWidth.ToString(CultureInfo.InvariantCulture);
        
        @* Estación origen *@
        var auxRef = Environment.YY.GetReference(Environment.Environment.ViewAsimilation.origin);
        if (auxRef != null)
        {
            @RenderStationLine(Environment.Environment.ViewAsimilation.origin, auxRef, textoRight)
        }
        
        @* Estaciones siguientes *@
        foreach (var paso in Environment.Environment.ViewAsimilation.Steps)
        {
            auxRef = Environment.YY.GetReference(paso.destination);
            if (auxRef != null)
            {
                @RenderStationLine(paso.destination, auxRef, textoRight)
            }
        }
    }
</TimeNetLayer>

@code {
    [Parameter] public TimeNetControlEnvironment? Environment { get; set; }
    [Parameter] public double X0 { get; set; }
    [Parameter] public double Y0 { get; set; }
    
    private string auxTransformString => $"translate({X0},{Y0})";

    private RenderFragment RenderStationLine(Station station, StationViewRef stationRef, string textoRight)
    {
        if (Environment == null) return builder => { };
        
        double y = Environment.YY.GetY(station);
        if (y < 0) return builder => { };
        
        string yStr = y.ToString(CultureInfo.InvariantCulture);
        string cssClass = stationRef.IsStation ? "timenet-station-line" : "timenet-singular-line";
        
        return builder =>
        {
            builder.OpenElement(0, "line");
            builder.AddAttribute(1, "x1", "0");
            builder.AddAttribute(2, "y1", yStr);
            builder.AddAttribute(3, "x2", textoRight);
            builder.AddAttribute(4, "y2", yStr);
            builder.AddAttribute(5, "class", cssClass);
            builder.CloseElement();
        };
    }
}
