<!-- Capa de representación en el objeto TimeNet -->
<g class="@LayerClass" transform="@Transform">
    @ChildContent
</g>
@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string LayerClass { get; set; } = string.Empty;
    [Parameter] public string Transform { get; set; } = string.Empty;
}

