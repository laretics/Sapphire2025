@using TimeNet2026.Timed
@using System.Globalization

<h3>SelectionLayer</h3>

<TimeNetLayer LayerClass="selection-layer" Transform="@auxTransformString">
    @((MarkupString)GenerateSelectionOverlay())
</TimeNetLayer>

@code {
    [Parameter] public TimeNetControlEnvironment? Environment { get; set; }
    [Parameter] public TimeNetControlSelection? Selections { get; set; }
    [Parameter] public double X0 { get; set; }
    [Parameter] public double Y0 { get; set; }
    
    private string auxTransformString => $"translate({X0},{Y0})";

    private string GenerateSelectionOverlay()
    {
        if (Environment == null || Selections == null) return string.Empty;
        if (Selections.mcolTimeSelection.Intervals.Count() == 0) return string.Empty;

        var svgText = new System.Text.StringBuilder();
        TimeLapseCollection inverse = Selections.mcolTimeSelection.Inverse;
        double fadeWidth = 16;
        string heightStr = Environment.YY.MiddleSize.ToString(CultureInfo.InvariantCulture);

        foreach (TimeLapse lapso in inverse.Intervals)
        {
            double x0 = Environment.XX.GetX((int)lapso.Begin.TotalSeconds);
            double anchoX = Environment.XX.GetX((int)lapso.End.TotalSeconds) - x0;
            
            string x0Str = x0.ToString(CultureInfo.InvariantCulture);
            string anchoXStr = anchoX.ToString(CultureInfo.InvariantCulture);
            string fadeWidthStr = fadeWidth.ToString(CultureInfo.InvariantCulture);

            if (anchoX > 2 * fadeWidth)
            {
                // Left fade
                svgText.Append($"<rect fill='url(#left-fade-gradient)' x='{x0Str}' y='0' width='{fadeWidthStr}' height='{heightStr}'></rect>");
                
                // Middle solid
                double middleX = x0 + fadeWidth;
                double middleWidth = anchoX - 2 * fadeWidth;
                string middleXStr = middleX.ToString(CultureInfo.InvariantCulture);
                string middleWidthStr = middleWidth.ToString(CultureInfo.InvariantCulture);
                svgText.Append($"<rect fill='var(--unselected-time-fill)' x='{middleXStr}' y='0' width='{middleWidthStr}' height='{heightStr}'></rect>");
                
                // Right fade
                double rightX = x0 + anchoX - fadeWidth;
                string rightXStr = rightX.ToString(CultureInfo.InvariantCulture);
                svgText.Append($"<rect fill='url(#right-fade-gradient)' x='{rightXStr}' y='0' width='{fadeWidthStr}' height='{heightStr}'></rect>");
            }
            else
            {
                // If too narrow, just solid
                svgText.Append($"<rect fill='var(--unselected-time-fill)' x='{x0Str}' y='0' width='{anchoXStr}' height='{heightStr}'></rect>");
            }
        }

        return svgText.ToString();
    }
}
