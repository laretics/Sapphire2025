@using TimeNet2026.Timed
@using TimeNet2026.Topo
@using TimeNet2026.Production
@using TimeNetComponents.Controls.TimeNetControl.Atoms
@using System.Globalization

<TimeNetLayer LayerClass="circulations-layer" Transform="@auxTransformString">
    @if (Environment?.Environment.Plan != null && Traces != null)
    {
        int trainColorIndex = 0;
        string? trainColorIndexString = Style?.Theme.Variables["--train-color-index"];
        if (null != trainColorIndexString)
            int.TryParse(trainColorIndexString, out trainColorIndex);

        foreach (CirculationBlock block in Environment.Environment.Plan.CirculationBlocksByDay)
        {
            if(null!=block.asimilation && Traces.ContainsKey(block.asimilation.id))
            {
                string fillColor = block.asimilation.color[trainColorIndex];                
                foreach (Circulation circulation in block.Circulations)
                {
                    double xx = Environment.XX.GetX((int)circulation.departure.TotalSeconds);
                    string x = xx.ToString(CultureInfo.InvariantCulture);
                    string circName = circulation.name;
                    string asiId = GetTraceId(block.asimilation, circName);
                    var trace = Traces[block.asimilation.id];
                    <use href="#@asiId" transform="translate(@x,0)" />
                    double midX = (trace.StartX + trace.EndX) / 2;
                    double midY = (trace.StartY + trace.EndY) / 2;
                    double angle = Math.Atan2(trace.EndY - trace.StartY, trace.EndX - trace.StartX) * 180 / Math.PI;
                    double dy = angle >= 0 ? -12 : -14;
                    double textX = midX + xx;
                    double textY = midY;
                    string textXString = textX.ToString(CultureInfo.InvariantCulture);
                    string textYString = textY.ToString(CultureInfo.InvariantCulture);
                    string rotAngle = angle.ToString(CultureInfo.InvariantCulture);
                    string transY = dy.ToString(CultureInfo.InvariantCulture);                                                       
                    @if (ShouldShowLabel(circName))
                    {
                        string transStr = $"translate({textXString}, {textYString}) rotate({rotAngle}, 0, 0) translate(0, {transY})";
                        <g transform="@transStr" @onclick="() => OnCirculationClick(circulation)">
                            <rect x="-20" y="-8" width="40" height="16" fill="@fillColor" rx="2" />
                            <text x="0" y="0" text-anchor="middle" class="timenet-circulation-label">@circName</text>
                        </g>
                    }                    
                }
            }
        }
    }
</TimeNetLayer>

@code {
    [Parameter] public TimeNetControlEnvironment? Environment { get; set; }
    [Parameter] public TimeNetControlStyle? Style { get; set; }
    [Parameter] public TimeNetSelection? Selections { get; set; }
    [Parameter] public Dictionary<string, TraceInfo>? Traces { get; set; }
    [Parameter] public EventCallback<Circulation> CirculationClicked { get; set; }
    [Parameter] public double X0 { get; set; }
    [Parameter] public double Y0 { get; set; }

    private string auxTransformString => $"translate({X0},{Y0})";

    private string GetTraceId(Asimilation asimilation, string circulationId)
    {
        if (Selections?.HCirculations.Contains(circulationId) ?? false)
            return $"asi-thick-{asimilation.id}";
        else if (Selections?.Circulations.Contains(circulationId) ?? false)
            return $"asi-thin-{asimilation.id}";
        else
            return $"asi-point-{asimilation.id}";
    }

    private bool ShouldShowLabel(string circulationId)
    {
        if (Selections != null && Style != null && 
            (Style.ShowLabelsInHighlighted || Style.ShowLabelsInSelected))
        {
            if (Style.ShowLabelsInHighlighted && Selections.HCirculations.Contains(circulationId))
                return true;
            else if (Style.ShowLabelsInSelected && Selections.Circulations.Contains(circulationId))
                return true;
            else
                return false;
        }
        else
            return true;
    }

    private async Task OnCirculationClick(Circulation circulation)
    {
        await CirculationClicked.InvokeAsync(circulation);
    }
}
