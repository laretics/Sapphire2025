@using TimeNet2026.Timed
@using TimeNet2026.Topo
@using TimeNet2026.Enviromental
@using TimeNet2026.Production
@using System.Globalization
@using Microsoft.JSInterop
@using TimeNetComponents.Controls.TimeNetControl.Atoms
@namespace TimeNetComponents.Controls.TimeNetControl
@inject IJSRuntime JSRuntime

@if (null == Environment)
{
    <div>No está definido el entorno de visualización</div>
}
else if (!Environment.IsViewComplete)
{
    <div>Ocurrió un error: @Environment.ViewError</div>
}
else
{
    <svg width="@Environment.XX.Width" height="@Environment.YY.Height" class="timenet-svg" overflow="visible">
        <defs>
            @RenderClipPaths()
            @RenderGradients()
            @RenderAsimilationPaths()
        </defs>

        @RenderAxes()

        <g transform="translate(@((-1*Environment.XX.LeftMargin).ToString(CultureInfo.InvariantCulture))),0">
            <!-- 1. Etiquetas de estaciones: Solo Y -->
            <g transform="translate(0,@Environment.YY.UpperMargin.ToString(CultureInfo.InvariantCulture))" clip-path="url(#clip-y-column)">
                <g transform="translate(0,@Environment.YY.DisplayOffsetYPx.ToString(CultureInfo.InvariantCulture))">
                    <YColumnLabelsLayer Environment="@Environment" X0="0" Y0="0" />
                </g>
            </g>

            <!-- 2. Textos de la regla horaria: Solo X, SIN clip -->
            <g transform="translate(@Environment.XX.LeftMargin.ToString(CultureInfo.InvariantCulture),@Environment.YY.UpperMargin.ToString(CultureInfo.InvariantCulture))">
                <g transform="translate(@Environment.XX.DisplayOffsetXPx.ToString(CultureInfo.InvariantCulture),0)">
                    <XTimeRulerLabelsLayer Environment="@Environment" Sunrise="@sunrise" Sunset="@sunset" X0="0" Y0="0" />
                </g>
            </g>

            <!-- 3. Líneas de la regla horaria + CurrentTime: Solo X, CON clip -->
            <g transform="translate(@Environment.XX.LeftMargin.ToString(CultureInfo.InvariantCulture),@Environment.YY.UpperMargin.ToString(CultureInfo.InvariantCulture))" clip-path="url(#clip-content)">
                <g transform="translate(@Environment.XX.DisplayOffsetXPx.ToString(CultureInfo.InvariantCulture),0)">
                    <XTimeRulerLinesLayer Environment="@Environment" Sunrise="@sunrise" Sunset="@sunset" ShowCurrentTime="@Style.CurrentTime" X0="0" Y0="0" />
                </g>
            </g>

            <!-- 4. Líneas horizontales de estaciones: Solo Y, CON clip -->
            <g transform="translate(@Environment.XX.LeftMargin.ToString(CultureInfo.InvariantCulture),@Environment.YY.UpperMargin.ToString(CultureInfo.InvariantCulture))" clip-path="url(#clip-content)">
                <g transform="translate(0,@Environment.YY.DisplayOffsetYPx.ToString(CultureInfo.InvariantCulture))">
                    <YColumnLinesLayer Environment="@Environment" X0="0" Y0="0" />
                </g>
            </g>

            <!-- 5. Contenido principal: X + Y, CON clip -->
            <g transform="translate(@Environment.XX.LeftMargin.ToString(CultureInfo.InvariantCulture),@Environment.YY.UpperMargin.ToString(CultureInfo.InvariantCulture))" clip-path="url(#clip-content)">
                <g transform="translate(@Environment.XX.DisplayOffsetXPx.ToString(CultureInfo.InvariantCulture),@Environment.YY.DisplayOffsetYPx.ToString(CultureInfo.InvariantCulture))">
                    <rect x="0" y="-@Environment.YY.UpperMargin" width="@Environment.XX.mvarGraphicalWidth.ToString(CultureInfo.InvariantCulture)" height="@Environment.YY.UpperMargin" fill="url(#time-gradient)" />
                    <CirculationsLayer Environment="@Environment" Style="@Style" Selections="@Selections" Traces="@traces" CirculationClicked="@CirculationClicked" X0="0" Y0="0" />
                </g>
                <rect x="0" y="@Environment.YY.MiddleSize" width="@Environment.XX.mvarGraphicalWidth.ToString(CultureInfo.InvariantCulture)" height="@Environment.YY.DownSize.ToString(CultureInfo.InvariantCulture)" fill="url(#time-gradient)" />
            </g>

            <!-- 6. Capa de selección: Solo X, CON clip -->
            <g transform="translate(@Environment.XX.LeftMargin.ToString(CultureInfo.InvariantCulture),@Environment.YY.UpperMargin.ToString(CultureInfo.InvariantCulture))" clip-path="url(#clip-content)">
                <g transform="translate(@Environment.XX.DisplayOffsetXPx.ToString(CultureInfo.InvariantCulture),0)">
                    <SelectionLayer Environment="@Environment" Selections="@Selections" X0="0" Y0="0" />
                </g>
            </g>
        </g>
    </svg>       
    
@*     <div class="mb-2">
        <button @onclick="SwitchTheme">@Style.Theme.Name</button>
    </div> *@

}

@code {
    [Parameter] public TimeNetControlEnvironment? Environment { get; set; }
    [Parameter] public TimeNetControlStyle Style { get; set; } = new();
    [Parameter] public TimeNetSelection? Selections { get; set; }
    [Parameter] public EventCallback<Circulation> CirculationClicked { get; set; }
    [Parameter] public bool Splines { get; set; }
    [Parameter] public double Latitude { get; set; } = 40.0;
    [Parameter] public double Longitude { get; set; } = -3.7;

    private DateTime sunrise;
    private DateTime sunset;
    private Dictionary<string, TraceInfo> traces = new();

    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();
        var (sunriseTs, sunsetTs) = Astronomy.CalculateSunriseSunset(DateTime.Today, Latitude, Longitude);
        sunrise = DateTime.Today + sunriseTs;
        sunset = DateTime.Today + sunsetTs;
    }

    private RenderFragment RenderClipPaths() => __builder => __builder.AddMarkupContent(0, 
        $"<clipPath id='clip-content'><rect x='0' y='0' width='{Environment!.XX.Width - Environment.XX.LeftMargin - Environment.XX.RightMargin}' height='{Environment.YY.MiddleSize}' /></clipPath>" +
        $"<clipPath id='clip-y-column'><rect x='0' y='-8' width='{Environment.XX.LeftMargin}' height='{Environment.YY.MiddleSize + 16}' /></clipPath>");

    private RenderFragment RenderGradients() => __builder => __builder.AddMarkupContent(0,
        $"<linearGradient id='time-gradient' x1='0%' y1='0%' x2='100%' y2='0%'>{string.Join("", GenerateTimeGradientStops())}</linearGradient>" +
        "<linearGradient id='left-fade-gradient' x1='0%' y1='0%' x2='100%' y2='0%'><stop offset='0%' stop-color='transparent' /><stop offset='100%' stop-color='var(--unselected-time-fill)' /></linearGradient>" +
        "<linearGradient id='right-fade-gradient' x1='0%' y1='0%' x2='100%' y2='0%'><stop offset='0%' stop-color='var(--unselected-time-fill)' /><stop offset='100%' stop-color='transparent' /></linearGradient>" +
        "<linearGradient id='current-time-gradient' x1='0%' y1='0%' x2='100%' y2='0%'><stop offset='0%' stop-color='transparent' /><stop offset='50%' stop-color='var(--current-time-color-fill)' /><stop offset='100%' stop-color='transparent' /></linearGradient>");

    private RenderFragment RenderAsimilationPaths() => __builder =>
    {
        if (Environment?.Environment?.Plan == null) return;
        traces.Clear();
        int colorIndex = GetTrainColorIndex();
        if (null != Environment.Environment.TopoStorage)
        {
            foreach (var asi in Environment.Environment.TopoStorage.ColAsimilations.Values)
            {
                var trace = GetTrace(asi);
                traces[asi.id] = trace;
                var color = asi.color[colorIndex];
                __builder.AddMarkupContent(0, $"<g id='asi-thin-{asi.id}'><path fill='none' stroke='{color}' stroke-width='1' d='{trace.D}' /></g>");
                __builder.AddMarkupContent(0, $"<g id='asi-thick-{asi.id}'><path fill='none' stroke='{color}' stroke-width='1' d='{trace.D}' /><path fill='none' stroke='{color}' stroke-width='3' stroke-dasharray='10,10' d='{trace.D}'><animate attributeName='stroke-dashoffset' values='0;-20' dur='1s' repeatCount='indefinite' /></path></g>");
                __builder.AddMarkupContent(0, $"<g id='asi-point-{asi.id}'><path fill='none' stroke='{color}' stroke-width='1' stroke-dasharray='5,8' d='{trace.D}' /></g>");
            }
        }
    };

    private RenderFragment RenderAxes() => __builder => __builder.AddMarkupContent(0,
        $"<g><line x1='{Environment!.XX.LeftMargin}' y1='{Environment.YY.UpperMargin}' x2='{Environment.XX.Right}' y2='{Environment.YY.UpperMargin}' class='timenet-axis' />" +
        $"<line x1='{Environment.XX.LeftMargin}' y1='{Environment.YY.LowerMargin}' x2='{Environment.XX.Right}' y2='{Environment.YY.LowerMargin}' class='timenet-axis' />" +
        $"<line x1='{Environment.XX.LeftMargin}' y1='{Environment.YY.UpperMargin}' x2='{Environment.XX.LeftMargin}' y2='{Environment.YY.LowerMargin}' class='timenet-axis' /></g>");

    private List<string> GenerateTimeGradientStops()
    {
        var stops = new List<string>();
        double ancho = Environment!.XX.mvarGraphicalWidth;
        for (double t = Math.Ceiling(Environment.XX.Offset / 900.0) * 900; t <= Environment.XX.EndOffset; t += 300)
        {
            int totalMinutes = (int)(t / 60);
            if (totalMinutes % 60 != 0) continue;
            DateTime hourDT = DateTime.Today.AddSeconds(t);
            bool isDay = hourDT >= sunrise && hourDT <= sunset;
            bool isDawn = Math.Abs((sunrise - hourDT).TotalMinutes) <= 30;
            bool isDusk = Math.Abs((sunset - hourDT).TotalMinutes) <= 30;
            double startOffset = (Environment.XX.GetX((int)t) / ancho) * 100;
            double endOffset = (Environment.XX.GetX((int)t + 3600) / ancho) * 100;
            if (isDawn) { stops.Add($"<stop offset='{startOffset}%' stop-color='#333' />"); stops.Add($"<stop offset='{endOffset}%' stop-color='#f8f9fa' />"); }
            else if (isDusk) { stops.Add($"<stop offset='{startOffset}%' stop-color='#f8f9fa' />"); stops.Add($"<stop offset='{endOffset}%' stop-color='#333' />"); }
            else { string color = isDay ? "#f8f9fa" : "#333"; stops.Add($"<stop offset='{startOffset}%' stop-color='{color}' />"); stops.Add($"<stop offset='{endOffset}%' stop-color='{color}' />"); }
        }
        return stops;
    }

    private int GetTrainColorIndex() => int.TryParse(Style.Theme.Variables.GetValueOrDefault("--train-color-index"), out int idx) ? idx : 0;
    
    private string GetYString(Station? station, double offset = 0)
    {
        double y = Environment!.YY.GetY(station);
        return y < 0 ? string.Empty : (y + offset).ToString(CultureInfo.InvariantCulture);
    }

    private string GetXString(int seconds, double offset = 0)
    {
        double x = Environment!.XX.GetX(seconds);
        return x < 0 ? string.Empty : (x + offset).ToString(CultureInfo.InvariantCulture);        
    }

    private TraceInfo GetTrace(Asimilation asimila) => Environment!.YY.PkMode && Splines ? GetSplinePathSVG(asimila) ?? GetPolylineSVG(asimila) : GetPolylineSVG(asimila);

    private TraceInfo GetPolylineSVG(Asimilation asimila)
    {
        var points = new List<string>();
        int seconds = 0;
        bool lastTrace = true;
        double startX = -1, startY = -1, endX = -1, endY = -1;
        if (Environment!.YY.GetY(asimila.Origin) >= 0) points.Add($"M {GetXString(0)},{GetYString(asimila.Origin)}");
        foreach (var paso in asimila.Steps)
        {
            seconds += (int)paso.tripTime.TotalSeconds;
            double currentY = Environment.YY.GetY(paso.destination);
            if (currentY >= 0)
            {
                double currentX = Environment.XX.GetX(seconds);
                string currentXStr = GetXString(seconds), currentYStr = GetYString(paso.destination);
                if (startX < 0) { startX = currentX; startY = currentY; }
                if (startX == currentX) { if (lastTrace) { points.Add($"L {currentXStr},{currentYStr}"); endX = currentX; endY = currentY; } else points.Add($"M {currentXStr},{currentYStr}"); }
                else { points.Add($"L {currentXStr},{currentYStr}"); endX = currentX; endY = currentY; }
                lastTrace = true;
                if (paso.stopTime.Ticks > 0) { seconds += (int)paso.stopTime.TotalSeconds; points.Add($"L {GetXString(seconds)},{currentYStr}"); endX = currentX; endY = currentY; }
            }
            else lastTrace = false;
        }
        return new TraceInfo { D = string.Join(" ", points), StartX = startX, StartY = startY, EndX = endX, EndY = endY };
    }

    private TraceInfo? GetSplinePathSVG(Asimilation asimila) => null;

    private async Task SwitchTheme()
    {
        Style.SwitchTheme(Style.Theme.Name != "Day");
        foreach (var kvp in Style.Theme.Variables)
            await JSRuntime.InvokeVoidAsync("setCssVariable", kvp.Key, kvp.Value);
    }
}

