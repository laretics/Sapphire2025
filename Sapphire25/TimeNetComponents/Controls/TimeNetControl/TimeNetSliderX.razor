@using System.Globalization
@using System.Threading.Tasks
@if (null != Environment)
{
    <div class="timerange-slider d-flex align-items-center gap-2" style="width:@(Environment.XX.Width)px; height:32px;">
        <div class="position-relative flex-grow-1" style="height:24px;">
            <!--Track-->
            <div class="bg-secondary bg-opacity-25 rounded-pill position-absolute top-50 start-0 end-0 translate-middle-y" style="height:6px;"></div>

            @if (ZoomLevel < 1.0)
            {
                <!--Ventana visible-->
                <div class="bg-primary bg-opacity-50 rounded-pill position-absolute top-50 translate-middle-y"
                     style="left:@WindowLeftPercentString%; width:@WindowWidthPercentString%; height:12px; pointer-events:none;">
                </div>
            }

            <!--Slider invisible para la interacción-->
            <input type="range"
                   min="@Min"
                   max="@Max"
                   value="@Value"
                   @oninput="OnSliderChanged"
                   class="form-range position-absolute top-0 start-0 w-100"
                   style="height:24px; opacity:0; cursor:pointer;" />
        </div>

        <button @onclick="ZoomOut" class="btn btn-sm btn-outline-secondary" type="button" title="Alejar">-        
        </button>
        <button @onclick="ZoomIn" class="btn btn-sm btn-outline-secondary" type="button" title="Acercar">+        
        </button>
    </div>
}
@code {
    [Parameter] public TimeNetControlEnvironment? Environment { get; set; }
    [Parameter] public EventCallback<int> ValueChanged { get; set; }
    [Parameter] public EventCallback StateChanged { get; set; }

    private int Min => TimeNetEnvironmentX.MIN_POSITION;
    private int Max => TimeNetEnvironmentX.MAX_POSITION - (Environment?.XX.Zoom ?? TimeNetEnvironmentX.MAX_X_OFFSET);
    private int ZoomValue => Environment?.XX.Zoom ?? TimeNetEnvironmentX.MAX_X_OFFSET;
    private int Value => Environment?.XX.Offset ?? Min;

    // La ventana representa la porción visible del rango total
    private double ZoomLevel => (double)ZoomValue / TimeNetEnvironmentX.MAX_X_OFFSET;
    private double WindowWidthPercent => 100.0 * ZoomLevel;
    private double WindowLeftPercent => 100.0 * Value / TimeNetEnvironmentX.MAX_X_OFFSET;

    private string WindowWidthPercentString => WindowWidthPercent.ToString(CultureInfo.InvariantCulture);
    private string WindowLeftPercentString => WindowLeftPercent.ToString(CultureInfo.InvariantCulture);

    private async Task OnSliderChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var val))
        {
            if (null != Environment)
                Environment.XX.Offset = val;
            await StateChanged.InvokeAsync();
            await ValueChanged.InvokeAsync(val);
        }
    }
    private async Task ZoomIn()
    {
        System.Diagnostics.Debug.Assert(null != Environment);
        Environment.XX.ZoomIn();
        await StateChanged.InvokeAsync();
    }
    private async Task ZoomOut()
    {
        System.Diagnostics.Debug.Assert(null != Environment);
        Environment.XX.ZoomOut();
        await StateChanged.InvokeAsync();
    }
}