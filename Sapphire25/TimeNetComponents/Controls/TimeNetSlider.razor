@using System.Globalization
<div class="timerange-slider" style="position:relative; width:100%; height:24px;">

    <!--Track-->
    <div style="background:#ddd; height:8px;border-radius:4px; position:absolute; top:8px; left:0; right:0;"></div>
    @if(Window<(Max-Min))
    {
        <!--Ventana visible-->
        <div style="
        position:absolute;
        top:4px;
        left:@WindowLeftPercentString%;
        width:@WindowWidthPercentString%;
        height:16px;
        background:#0af8;
        border-radius:8px;
        pointer-events:none;">
        </div>
    }
    <!--Slider invisible para la interacción-->
    <input type="range"
        min="@Min"
        max="@Max"
        value="@Value"
        @oninput="OnSliderChanged"
        style="position:absolute; top:0; left:0; width:100%; height:24px; opacity:0; cursor:pointer;"/>
</div>

@code {

    [Parameter] public int Min { get; set; }
    [Parameter] public int Max { get; set; }
    [Parameter] public int Value { get; set; }
    [Parameter] public int Window { get; set; }
    [Parameter] public EventCallback<int> ValueChanged { get; set; }

    private double TrackWidthPx => 200; //Puede calcularlo según el contenedor.
    private double WindowWidthPercent => 100.0 * Math.Min(Window,Max-Min)/ Math.Max(1, (Max - Min));
    private double WindowLeftPercent => 100.0 * Math.Max((Value - Min),0) / Math.Max(1, (Max - Min));
    private string WindowWidthPercentString => WindowWidthPercent.ToString(CultureInfo.InvariantCulture);
    private string WindowLeftPercentString => WindowLeftPercent.ToString(CultureInfo.InvariantCulture);

    private async Task OnSliderChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var val))
            await ValueChanged.InvokeAsync(val);
    }
}
