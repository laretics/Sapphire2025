@using TimeNet2026
    @switch(Day)
    {
        case Weekday.Sunday:
        {
            <p style="color:red;">Dom</p>
        } break;
        case Weekday.Monday:
        {
            <p>Lun</p>
        } 
        break;
        case Weekday.Tuesday:
        {
            <p>Mar</p>
        }
        break;
        case Weekday.Wednesday:
        {
            <p>Mie</p>
        }
        break;
        case Weekday.Thursday:
        {
            <p>Jue</p>
        }
        break;
        case Weekday.Friday:
        {
            <p>Vie</p>
        }
        break;
        case Weekday.Saturday:
        {
            <p style="color:olive;">Sab</p>
        }
        break;
        case Weekday.Festive:
        {
            <p style="color:red;">Fes</p>
        }
        break;    
    }
@code {
    [Parameter] public Weekday Day { get; set; }    
}
