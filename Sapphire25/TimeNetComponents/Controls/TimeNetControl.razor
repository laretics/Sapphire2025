    private DateTime sunrise;
    private DateTime sunset;

    private async Task ApplyTheme(ViewingTheme theme)
    {
        foreach (var kvp in theme.Variables)
        {
            await JSRuntime.InvokeVoidAsync("setCssVariable", kvp.Key, kvp.Value);
        }
        currentTheme = theme;
    }

    private async Task SwitchTheme()
    {
        var newTheme = currentTheme.Name == "Día" ? darkTheme : lightTheme;
        await ApplyTheme(newTheme);
    }
}
