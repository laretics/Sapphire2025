    private AsimilationView? mvarView;

    //Coordenada de tiempos.
    private int mvarMarginXRight = 20;
    private int mvarMarginX = 150;
    private int mvarMaxX => Width - mvarMarginXRight;       

    private const int TOTAL_HOURS = 24;
    private const int MAX_X_OFFSET = 3600 * TOTAL_HOURS;
    private int mvarMaxOffset;
    private int mvarSliderStep;

    private int ZoomXSeconds { get; set; } = MAX_X_OFFSET; //Escala de tiempos.
    private int OffsetXSeconds { get; set; } = 0; //Desplazamiento en segundos.

    private double DisplayOffsetXPx => -((mvarMaxX - mvarMarginX) * OffsetXSeconds) / ZoomXSeconds;    

    //Coordenada de espacios.
    private int mvarMaxY => Height - 40;
    private int mvarMarginY = 20;

    private long mvarMinPk;
    private long mvarMaxPk;


    protected override void OnParametersSet()
    {
        if (null == Asimilation || null==Plan) return;
        mvarView = new AsimilationView(Asimilation, Plan.Parent);
    }

    private void updateSliderParams()
    {
        mvarMaxOffset = Math.Max(0, MAX_X_OFFSET - ZoomXSeconds);
        mvarSliderStep = Math.Max(1, ZoomXSeconds / 10);

        if (OffsetXSeconds > mvarMaxOffset)
            OffsetXSeconds = mvarMaxOffset;
        if (OffsetXSeconds < 0)
            OffsetXSeconds = 0;
    }

    private double GetY(Station? station, double offset = 0)
    {
        if (null != mvarView && null != station && mvarView.Elements.ContainsKey(station))
        {
            StationViewRef punto = mvarView.Elements[station];
            double auxValor=-1;
            if (PkMode && mvarView.MaxPk > 0)
                auxValor= (mvarMarginY + ((mvarMaxY - mvarMarginY) * punto.ViewPk) / mvarView.MaxPk)+offset;
            else if (mvarView.MaxIndex > 0)
                auxValor = (mvarMarginY + ((mvarMaxY - mvarMarginY) * punto.Index) / mvarView.MaxIndex)+offset;

            if (auxValor >= 0)
                return auxValor;
        }
        return -1;
    }
    private double GetX(int seconds, double offset = 0)
    {
        // seconds: Instante absoluto en segundos.
        // ZoomXSeconds: Segundos visibles en la ventana.
        // mvarMarginX: margen izquierdo en pixels.
        // mvarMaxX: ancho máximo de la ventana en pixels.
        double ancho = Math.Abs(mvarMaxX - mvarMarginX);
        double salida = (ancho * seconds) / ZoomXSeconds + offset;
        return salida;
    }

    private string GetXYString(double value) => value<0? string.Empty: value.ToString(CultureInfo.InvariantCulture);

    private void ZoomIn()
    {
        ZoomXSeconds = Math.Max(60, ZoomXSeconds / 2);
        updateSliderParams();
        StateHasChanged();
    }
    private void ZoomOut()
    {
        ZoomXSeconds = Math.Min(MAX_X_OFFSET, ZoomXSeconds * 2);
        updateSliderParams();
        StateHasChanged();
    }
    private void OnScrollChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var val))
            OffsetXSeconds = val;
        StateHasChanged();
    }

    private TraceInfo GetTrace(Asimilation asimila)
    {

        if (PkMode && Splines)
            return GetSplinePathSVG(asimila);

        return GetPolylineSVG(asimila);
    }

    private class TraceInfo
    {
        public string D { get; set; } = "";
        public double StartX { get; set; }
        public double StartY { get; set; }
        public double EndX { get; set; }
        public double EndY { get; set; }
    }

    private TraceInfo GetPolylineSVG(Asimilation asimila)
    {
        List<string> points = new List<string>();
        int seconds = 0;
        bool lastTrace = true;
        double startX = -1;
        double startY = -1;
        double endX = -1;
        double endY = -1;
        if(GetY(asimila.origin)>=0)
        {
            startX = GetX(0);
            startY = GetY(asimila.origin);
            points.Add($"M {GetXYString(startX)},{GetXYString(startY)}");
        }        
        foreach(AsimilationStep paso in asimila.Steps)
        {
            seconds += (int)paso.tripTime.TotalSeconds;
            endY = GetY(paso.destination);
            if (endY>=0)
            {                          
                endX = GetX(seconds);
                if(startX<0)
                {
                    startX = endX;
                    startY = endY;
                }

                //Console.WriteLine($"Paso: {paso.destination.name}, seconds: {seconds}, X: {auxX}, Y: {auxY}");
                if(startX==endX)
                {
                    if (lastTrace)
                        points.Add($"L {GetXYString(endX)},{GetXYString(endY)}");
                    else
                        points.Add($"M {GetXYString(endX)},{GetXYString(endY)}");
                }
                else
                {
                    points.Add($"L {GetXYString(endX)},{GetXYString(endY)}");
                }
                lastTrace = true; //Habiendo pintado, seguimos la línea.
                if (paso.stopTime.Ticks > 0)
                {
                    seconds += (int)paso.stopTime.TotalSeconds;
                    points.Add($"L {GetXYString(endX)},{GetXYString(endY)}");
                }
            }
            else
                lastTrace = false;
        }
        return new TraceInfo { D = string.Join(" ", points),StartX= startX, StartY = startY, EndX = endX, EndY = endY };
    }
