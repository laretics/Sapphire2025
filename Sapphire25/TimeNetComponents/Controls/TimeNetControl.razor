@using TimeNet2026.Timed
@using TimeNet2026.Topo
@using System.Globalization
@namespace TimeNetComponents.Controls

@if(null==TopoStorage)
{
    <div>No está definido el Storage</div>
}
else if(null==Rauta)
{
    <div>No está definido el contenedor de planes de explotación</div>
}
else if(null==Plan)
{
    <div>No está definido el plan de explotación</div>
}
else if(null==Asimilation)
{
    <div>No está definida la asimilación de la vista de la malla</div>
}
else if(null==Asimilation.origin)
{
    <div>La asimilación de la vista de la malla no tiene un origen especificado</div>
}
else
{
    <svg width="@Width" height="@Height" style="background:#f8f9fa;border:1px solid #ccc;" overflow="visible">
        
        <defs>
            <clipPath id="clip-right">
                <rect x="mvarMarginX" y="0" 
                    width="@(Width - mvarMarginX- mvarMarginXRight)"
                    height="@Height"/>
            </clipPath>
            @if (null != Plan)
            {
                foreach (Asimilation asimilation in TopoStorage.ColAsimilations.Values)
                {
                    var trace = GetTrace(asimilation);                    
                    double midX = (trace.StartX + trace.EndX) / 2;
                    double midY = (trace.StartY + trace.EndY) / 2;
                    double angle = Math.Atan2(trace.EndY - trace.StartY, trace.EndX - trace.StartX) * 180 / Math.PI;
                    <g id="asi-@asimilation.id">
                        <path fill="none"
                              stroke="@asimilation.color[0]"
                              stroke-width="3"
                              d="@trace.D" />
                        <text x="@midX.ToString(CultureInfo.InvariantCulture)" y="@(midY - 10).ToString(CultureInfo.InvariantCulture)" transform="rotate(@angle.ToString(CultureInfo.InvariantCulture), @midX.ToString(CultureInfo.InvariantCulture), @midY.ToString(CultureInfo.InvariantCulture))" class="circulation-label">@asimilation.id</text>
                    </g>
                }
            }
        </defs>

        <!--Estaciones-->
        <g>
            @if (true)
            {
                string y = GetXYString(GetY(Asimilation.origin));
                if (y.Length > 0)
                {
                    double yVal = double.Parse(y, CultureInfo.InvariantCulture);
                    @((MarkupString)$"<text x='{mvarMarginX - 16}' y='{(yVal + 5).ToString(CultureInfo.InvariantCulture)}' class='timenet-station-name-label'>{Asimilation.origin.name}</text>")
                    <line x1="@mvarMarginX" y1="@y" x2="@mvarMaxX" y2="@y" stroke="#eee" stroke-width="1" />
                }
            }
            @foreach (AsimilationStep paso in Asimilation.Steps)
            {
                string y = GetXYString(GetY(paso.destination));
                if (y.Length > 0)
                {
                    double yVal = double.Parse(y, CultureInfo.InvariantCulture);
                    @((MarkupString)$"<text x='{mvarMarginX - 16}' y='{(yVal + 5).ToString(CultureInfo.InvariantCulture)}' class='timenet-station-name-label'>{paso.destination.name}</text>")
                    <line x1="@mvarMarginX" y1="@y" x2="@mvarMaxX" y2="@y" stroke="#eee" stroke-width="1" />
                }
            }
            <!--Ejes cartesianos-->
            <line x1="@(mvarMarginX)" y1="@(mvarMarginY)" x2="@(mvarMaxX)" y2="@(mvarMarginY)" stroke="black" stroke-width="1" />
            <line x1="@(mvarMarginX)" y1="@(mvarMaxY)" x2="@(mvarMaxX)" y2="@(mvarMaxY)" stroke="black" stroke-width="1" />
            <line x1="@(mvarMarginX)" y1="@(mvarMarginY)" x2="@(mvarMarginX)" y2="@(mvarMaxY)" stroke="black" stroke-width="1" />
        </g>

        <g transform="translate(@mvarMarginX,0)" clip-path="url(#clip-right)">
            <!--Contenido desplazable-->
            <g transform="translate(@DisplayOffsetXPx,0)">
                <!--Regla horaria-->
                @{
                    double fin = OffsetXSeconds + ZoomXSeconds;
                    //Calculamos el inicio y fin en segundos, redondeados a cuartos de hora
                    double startSeconds = Math.Ceiling(OffsetXSeconds / 900.0) * 900;
                    double endSeconds = Math.Floor(fin / 900.0) * 900;
                    string yt = (mvarMaxY + 15).ToString(CultureInfo.InvariantCulture);
                    string yf0 = mvarMarginY.ToString(CultureInfo.InvariantCulture);
                    string yff = mvarMaxY.ToString(CultureInfo.InvariantCulture);

                    var svgText = new System.Text.StringBuilder();
                    for (double t = startSeconds; t <= endSeconds; t += 300)
                    {
                        int totalMinutes = (int)(t / 60);
                        int hour = totalMinutes / 60;
                        int minutes = totalMinutes % 60;
                        string x = GetXYString(GetX((int)t));
                        if (minutes == 0)
                        {
                            // Hora completa: etiqueta y líneas gruesas
                            svgText.Append($"<text x='{x}' y='{yt}' font-size='14' text-anchor='middle'>{hour}</text>");
                            svgText.Append($"<line x1='{x}' y1='{yf0}' x2='{x}' y2='{yff}' class='timenet-hour-line-thick' />");
                            svgText.Append($"<line x1='{x}' y1='{yf0}' x2='{x}' y2='{yff}' class='timenet-hour-line-thin' />");
                        }
                        else if (minutes == 30 && ZoomXSeconds <= 8 * 3600)
                        {
                            // Media hora: línea media, solo si zoom <= 8 horas
                            svgText.Append($"<line x1='{x}' y1='{yf0}' x2='{x}' y2='{yff}' class='timenet-half-hour-line' />");
                        }
                        else if ((minutes == 15 || minutes == 45) && ZoomXSeconds <= 4 * 3600)
                        {
                            // Cuarto de hora: línea fina, solo si zoom <= 4 horas
                            svgText.Append($"<line x1='{x}' y1='{yf0}' x2='{x}' y2='{yff}' class='timenet-quarter-hour-line' />");
                        }
                        else if ((minutes % 5) == 0 && ZoomXSeconds <= 2*3600)
                        {
                            // Cinco minutos: línea fina, solo si zoom <= 1 hora
                            svgText.Append($"<line x1='{x}' y1='{yf0}' x2='{x}' y2='{yff}' class='timenet-five-minute-line' />");
                        }
                    }
                }
                @((MarkupString)svgText.ToString())

                @if (null != Asimilation)
                {
                    System.Diagnostics.Debug.Assert(null != Plan);
                    foreach (Circulation circulation in Plan.Circulations)
                    {
                        string xOffset = GetXYString(GetX((int)circulation.departure.TotalSeconds, 0));
                        if (null != circulation.asimilation)
                        {
                            <use href="#asi-@circulation.asimilation.id" transform="translate(@xOffset,0)" />
                        }
                    }
                }
            </g>
        </g>
    </svg>
}
<div class="mb-2">
    <button @onclick="ZoomOut">-</button>
    <button @onclick="ZoomIn">+</button>
    <TimeNetSlider  @key="ZoomXSeconds"
                    Min="0"
                   Max="@mvarMaxOffset"
                   Value="@OffsetXSeconds"
                   Window="@ZoomXSeconds"
                   ValueChanged="@(v => OffsetXSeconds = v)" />
</div>
<div>
    OffsetX: @OffsetXSeconds<br />
</div>

