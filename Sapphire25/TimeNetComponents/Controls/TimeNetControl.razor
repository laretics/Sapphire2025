@using TimeNet2026.Timed
@using TimeNet2026.Topo
@using System.Globalization
@namespace TimeNetComponents.Controls

@if(null==TopoStorage)
{
    <div>No está definido el Storage</div>
}
else if(null==Rauta)
{
    <div>No está definido el contenedor de planes de explotación</div>
}
else if(null==Plan)
{
    <div>No está definido el plan de explotación</div>
}
else if(null==Asimilation)
{
    <div>No está definida la asimilación de la vista de la malla</div>
}
else if(null==Asimilation.origin)
{
    <div>La asimilación de la vista de la malla no tiene un origen especificado</div>
}
else
{
    <svg width="@Width" height="@Height" style="background:#f8f9fa;border:1px solid #ccc;">
        
        <defs>
            <clipPath id="clip-right">
                <rect x="@mvarMarginX" y="0" 
                    width="@((Width-mvarMarginX).ToString(CultureInfo.InvariantCulture))"
                    height="@Height"/>
            </clipPath>
            @if (null != Plan)
            {
                foreach (Asimilation asimilation in TopoStorage.ColAsimilations.Values)
                {
                    <path id="asi-@asimilation.id"
                            fill="none"
                            stroke="@asimilation.color[0]"
                            stroke-width="3"
                            d="@GetTrace(asimilation)" />
                }
            }
        </defs>

        <!--Estaciones-->
        <g>
            @if (true)
            {
                string y = GetY(Asimilation.origin);
                if (y.Length > 0)
                {
                    @((MarkupString)$"<text x='45' y='{y + 5}' font-size='12' text-anchor='end'>{Asimilation.origin.name}</text>")
                    <line x1="@mvarMarginX" y1="@y" x2="@mvarMaxX" y2="@y" stroke="#eee" stroke-width="1" />
                }
            }
            @foreach (AsimilationStep paso in Asimilation.Steps)
            {
                string y = GetY(paso.destination);
                if (y.Length > 0)
                {
                    @((MarkupString)$"<text x='45' y='{y + 5}' font-size='12' text-anchor='end'>{paso.destination.name}</text>")
                    <line x1="@mvarMarginX" y1="@y" x2="@mvarMaxX" y2="@y" stroke="#eee" stroke-width="1" />
                }
            }
        </g>

        <!--Contenido desplazable-->
        <g transform="translate(@DisplayOffsetX.ToString(CultureInfo.InvariantCulture),0)" clip-path="url(#clip-right)">        

            <!--Ejes cartesianos-->
            <line x1="@(mvarMarginX)" y1="@(mvarMarginY)" x2="@(mvarMarginX)" y2="@(mvarMaxY)" stroke="black" stroke-width="1" />
            <line x1="@(mvarMarginX)" y1="@(mvarMaxY)" x2="@(mvarMaxX)" y2="@(mvarMaxY)" stroke="black" stroke-width="1" />

            <!--Regla horaria-->
            @{
                double segundosVisibles = mvarTotalSeconds / ZoomX;
                double fin = OffsetX + segundosVisibles;
                //Calculamos la primera y la última hora completa visible
                int horaInicio = (int)Math.Ceiling(OffsetX / 3600.0);
                int horaFin = (int)Math.Floor(fin / 3600.0);
                string yt = (mvarMaxY + 15).ToString(CultureInfo.InvariantCulture);
                string yf0 = mvarMarginY.ToString(CultureInfo.InvariantCulture);
                string yff = mvarMaxY.ToString(CultureInfo.InvariantCulture);

                    var svgText = new System.Text.StringBuilder();
                    for (int h = horaInicio; h <= horaFin; h++)
                    {
                        string x = GetX(h * 3600);                        
                        svgText.Append($"<text x='{x}' y='{yt}' font-size='14' text-anchor='middle'>{h}:00</text>");
                        svgText.Append($"<line x1='{x}' y1='{yf0}' x2='{x}' y2='{yff}' stroke='#0ee' stroke-width='1' />");
                    }                
            }
            @((MarkupString)svgText.ToString())

            @if (null != Asimilation)
            {
                System.Diagnostics.Debug.Assert(null != Plan);
                foreach(Circulation circulation in Plan.Circulations)
                {
                    string xOffset = GetX((int)circulation.departure.TotalSeconds, 0);
                    if(null!=circulation.asimilation)
                    {
                        <use href="#asi-@circulation.asimilation.id" transform="translate(@xOffset,0)" />
                    }                    
                }
            }
        </g>
    </svg>
}
<div class="mb-2">
    <button @onclick="ZoomOut">-</button>
    <button @onclick="ZoomIn">+</button>
    <input type="range" min="0" max="@(mvarMaxOffset.ToString(CultureInfo.InvariantCulture))"
           step="@(mvarSliderStep.ToString(CultureInfo.InvariantCulture))"
           style="width:200px"
           @bind="OffsetX"
           />
</div>
@code {
    [Parameter]
    public TopoStorage? TopoStorage { get; set; }
    [Parameter]
    public Rauta? Rauta{ get; set; }
    [Parameter]
    public Plan? Plan { get; set; }
    [Parameter] 
    public Asimilation? Asimilation { get; set; }

    [Parameter]
    public int Width { get; set; }
    [Parameter]
    public int Height{ get; set; }
    [Parameter]
    public bool PkMode{ get; set; }
    [Parameter]
    public bool Splines { get; set; }

    private AsimilationView? mvarView;

    private double ZoomX { get; set; } = 1.0; //Escala de tiempos.
    private double OffsetX { get; set; } = 0.0; //Inicio de la representación
    private double DisplayOffsetX => -OffsetX;
    private const int TotalHours = 24;

    private long mvarMinPk;
    private long mvarMaxPk;

    private int mvarMaxY => Height - 40;
    private int mvarMaxX => Width - 20;

    private int mvarMarginX = 50;
    private int mvarMarginY = 20;

    private int mvarTotalSeconds = 0;
    private int mvarTotalMinutes = 0;

    double mvarVisibleSeconds;
    double mvarMaxOffset;
    double mvarSliderStep = 1;

    protected override void OnParametersSet()
    {
        if (null == Asimilation || null==Plan) return;
        mvarView = new AsimilationView(Asimilation, Plan.Parent);

        //Ajustamos la duración del intervalo al tiempo de esta asimilación
        //Más adelante lo cambiaremos.
        mvarTotalSeconds = TotalHours * 3600;

        updateSliderParams();

        // Corrige OffsetX si está fuera de rango tras un cambio de zoom o datos
        if (OffsetX > mvarMaxOffset)
            OffsetX = mvarMaxOffset;
    }

    private void updateSliderParams()
    {
        mvarVisibleSeconds = mvarTotalSeconds / ZoomX;
        mvarMaxOffset = Math.Max(0, mvarTotalSeconds - mvarVisibleSeconds);
        mvarSliderStep = Math.Max(1, mvarVisibleSeconds / (mvarMaxX - mvarMarginX));        
    }

    private string GetY(Station? station, double offset = 0)
    {
        if (null != mvarView && null != station && mvarView.Elements.ContainsKey(station))
        {
            StationViewRef punto = mvarView.Elements[station];
            double auxValor=-1;
            if (PkMode && mvarView.MaxPk > 0)
                auxValor= (mvarMarginY + ((mvarMaxY - mvarMarginY) * punto.ViewPk) / mvarView.MaxPk)+offset;
            else if (mvarView.MaxIndex > 0)
                auxValor = (mvarMarginY + ((mvarMaxY - mvarMarginY) * punto.Index) / mvarView.MaxIndex)+offset;

            if(auxValor>=0)
                return auxValor.ToString(CultureInfo.InvariantCulture);
        }
        return string.Empty;
    }
    private string GetX(int seconds, double offset = 0)
    {
        double relativeSeconds = seconds - OffsetX;
        double salida = mvarMarginX + ((mvarMaxX - mvarMarginX) * relativeSeconds * ZoomX) / mvarTotalSeconds+offset;
        return salida.ToString(CultureInfo.InvariantCulture);
    }

    private void ZoomIn()
    {
        ZoomX = Math.Min(ZoomX * 1.25, 10.0);
        StateHasChanged();
    }
    private void ZoomOut()
    {
        ZoomX = Math.Max(ZoomX / 1.25, 1.0);
        StateHasChanged();
    }
    private void OnScrollChanged(ChangeEventArgs e)
    {
        if (double.TryParse(e.Value?.ToString(), out var val))
            OffsetX = val;
        StateHasChanged();
    }

    private string GetTrace(Asimilation asimila)
    {
        if (PkMode && Splines)
            return GetSplinePathSVG(asimila);

        return GetPolylineSVG(asimila);
    }

    private string GetPolylineSVG(Asimilation asimila)
    {
        List<string> points = new List<string>();
        int seconds = 0;
        bool lastTrace = true;
        string auxY = string.Empty;
        string auxX = string.Empty;
        points.Add($"M {GetX(0)},{GetY(asimila.origin)}");
        foreach(AsimilationStep paso in asimila.Steps)
        {
            seconds += (int)paso.tripTime.TotalSeconds;
            auxY = GetY(paso.destination);
            if (auxY.Length>0)
            {
                auxX = GetX(seconds);
                Console.WriteLine($"Paso: {paso.destination.name}, seconds: {seconds}, X: {auxX}, Y: {auxY}");
                if(lastTrace)
                    points.Add($"L {auxX.ToString(CultureInfo.InvariantCulture)},{auxY.ToString(CultureInfo.InvariantCulture)}");
                else
                    points.Add($"M {auxX.ToString(CultureInfo.InvariantCulture)},{auxY.ToString(CultureInfo.InvariantCulture)}");

                lastTrace = true; //Habiendo pintado, seguimos la línea.
                if (paso.stopTime.Ticks > 0)
                {
                    seconds += (int)paso.stopTime.TotalSeconds;
                    points.Add($"L {auxX.ToString(CultureInfo.InvariantCulture)},{auxY.ToString(CultureInfo.InvariantCulture)}");
                }
            }
            else
                lastTrace = false;
        }
        return string.Join(" ", points);
    }
    private string GetSplinePathSVG(Asimilation asimila)
    {
        var points = new List<(string x, string y)>();
        int seconds = 0;
        bool lastTrace = true;
        string auxY = string.Empty;
        string auxX = string.Empty;
        points.Add((GetX(0), GetY(asimila.origin)));
        foreach (AsimilationStep paso in asimila.Steps)
        {
            seconds += (int)paso.tripTime.TotalSeconds;
            auxY = GetY(paso.destination); ;
            auxX = GetX(seconds);
            points.Add((auxX, auxY));
            if (paso.stopTime.Ticks > 0)
            {
                seconds += (int)paso.stopTime.TotalSeconds;
                points.Add((auxX, auxY));
            }
        }

        if (points.Count < 2)
            return "";

        const double minDxForSpline = 30.0; // Distancia mínima en X para permitir spline
        var sb = new System.Text.StringBuilder();
        sb.Append($"M {points[0].x.ToString(CultureInfo.InvariantCulture)},{points[0].y.ToString(CultureInfo.InvariantCulture)} ");

        // for (int i = 0; i < points.Count - 1; i++)
        // {
        //     var (x0, y0) = points[i];
        //     var (x1, y1) = points[i + 1];
        //     double dx = x1 - x0;
        //     double dy = y1 - y0;

        //     // Si no hay avance en X o el avance es muy pequeño, trazo recto
        //     if (dx < minDxForSpline)
        //         sb.Append($"L {x1.ToString(CultureInfo.InvariantCulture)},{y1.ToString(CultureInfo.InvariantCulture)} ");
        //     else
        //     {
        //         // Calcula los puntos de control, asegurando que no sobrepasen x1
        //         double c1x = x0 + (minDxForSpline/2);
        //         double c2x = x1 - (minDxForSpline / 2);

        //         sb.Append($"C {c1x.ToString(CultureInfo.InvariantCulture)},{y0.ToString(CultureInfo.InvariantCulture)} {c2x.ToString(CultureInfo.InvariantCulture)},{y1.ToString(CultureInfo.InvariantCulture)} {x1.ToString(CultureInfo.InvariantCulture)},{y1.ToString(CultureInfo.InvariantCulture)} ");
        //     }
        // }
        return sb.ToString();
    }
}
