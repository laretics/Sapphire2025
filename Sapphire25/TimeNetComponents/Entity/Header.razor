@inherits ComponentBase
@if (null== header)
{
    <div class="alert alert-warning">
        Sin información de cabecera
    </div>
}
else
{
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-primary text-white">
            <h4 class="mb-0">@header.Name</h4>
            <small class="text-light">Versión @header.Version</small>
        </div>
        <div class="card-body">
            <p class="mb-2"><strong>Descripción:</strong> @header.Description</p>
            <p class="mb-2"><strong>Comentario:</strong> @header.Comment</p>
            <p class="mb-2"><strong>Licencia:</strong> @header.License</p>
            <p class="mb-2"><strong>Autor:</strong> @header.Author</p>
            <p class="mb-2"><strong>Fecha de creación:</strong> @header.FirstDate:dd/MM/yyyy</p>
            <p class="mb-2"><strong>Última modificación:</strong> @header.LastDate:dd/MM/yyyy</p>
            <p class="mb-2"><strong>ID:</strong> @header.Id</p>
            @if (!string.IsNullOrWhiteSpace(header.Bitmap))
            {
                <div class="mb-2">
                    <strong>Imagen:</strong><br />
                    <img src="@header.Bitmap" alt="Imagen asociada" class="img-fluid rounded border" style="max-height:200px;" />
                </div>
            }
        </div>
    </div>
}

@code {
    [Parameter]
    public TimeNet2026.Topo.Header? header { get; set; }
}