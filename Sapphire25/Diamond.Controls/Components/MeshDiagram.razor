	private MeshYScale CreateCurrentYScale()
	{
		return MeshYScale.Create(mvarYScaleMode, View, mvarViewPkMin, mvarViewPkMax);
	}

	private static string FormatClock(TimeSpan ts)
	{
		int h = (int)ts.TotalHours;
		if (h < 0) { h = 0; }
		int m = ts.Minutes;
		if (m < 0) { m = 0; }
		return h.ToString("00", CultureInfo.InvariantCulture) + ":" + m.ToString("00", CultureInfo.InvariantCulture);
	}

	private static string FormatClockWithSeconds(TimeSpan ts)
	{
		int h = (int)ts.TotalHours;
		if (h < 0) { h = 0; }
		int m = ts.Minutes;
		if (m < 0) { m = 0; }
		int s = ts.Seconds;
		if (s < 0) { s = 0; }
		return h.ToString("00", CultureInfo.InvariantCulture)
			+ ":" + m.ToString("00", CultureInfo.InvariantCulture)
			+ ":" + s.ToString("00", CultureInfo.InvariantCulture);
	}

	private static string FormatPkShort(long pk)
	{
		long abs = Math.Abs(pk);
		long km = abs / 1000L;
		long m = abs % 1000L;
		if (pk < 0)
		{
			return "-" + km.ToString(CultureInfo.InvariantCulture) + "+" + m.ToString("D3", CultureInfo.InvariantCulture);
		}

		return km.ToString(CultureInfo.InvariantCulture) + "+" + m.ToString("D3", CultureInfo.InvariantCulture);
	}
