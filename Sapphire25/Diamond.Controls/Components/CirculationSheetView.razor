@namespace Diamond.Controls
@using Diamond.Controls.Rendering
@using Diamond.Timed
@inject IJSRuntime Js

@*
  Visor del libro itinerario / ficha de un tren.
  Hojas A4 apaisadas (2 semipáginas por hoja).
  Emisión controlada: sello SEL, QR, firma X.509 en PDF, registro y log Zafiro.
*@
@if (mvarReady)
{
	<div class="diamond-circ-sheet-overlay" @onclick="OnOverlayClick">
		<div class="diamond-circ-sheet-dialog" @onclick:stopPropagation="true">
			<div class="diamond-circ-sheet-toolbar no-print">
				<span class="diamond-circ-sheet-toolbar-title">
					@if (mvarFullBook)
					{
						<span>Libro itinerario</span>
						@if (!string.IsNullOrEmpty(mvarTitleExtra))
						{
							<span> · @mvarTitleExtra</span>
						}
						<span class="text-muted"> · @mvarHalfPageCount semipág. · @mcolPageSvg.Count hoja(s) A4</span>
					}
					else
					{
						<span>Ficha · @mvarTitleExtra</span>
						<span class="text-muted"> · @mvarHalfPageCount mitad(es) · @mcolPageSvg.Count hoja(s) A4</span>
					}
				</span>
				<span class="diamond-circ-sheet-toolbar-actions">
					<label class="diamond-circ-sheet-max-label" title="Máximo de filas por semipágina (mitad de A4)">
						Máx/mitad
						<input type="number"
							   min="8"
							   max="60"
							   class="form-control form-control-sm diamond-circ-sheet-max-input"
							   value="@mvarMaxPerPage"
							   @onchange="OnMaxPerPageChanged" />
					</label>
					<button type="button"
							class="btn btn-sm btn-outline-warning"
							@onclick="ToggleVerifyPanel"
							title="Verificar sello SEL o texto del QR">
						Verificar sello
					</button>
					<button type="button"
							class="btn btn-sm btn-outline-secondary"
							@onclick="PrintAsync"
							title="Imprimir (registra emisión oficial)">
						Imprimir
					</button>
					<button type="button"
							class="btn btn-sm btn-outline-secondary"
							disabled="@(mcolPageSvg.Count == 0 || mvarBusyPdf)"
							@onclick="ExportPdfAsync"
							title="PDF firmado X.509 (certificado local) + registro de emisión">
						@(mvarBusyPdf ? "PDF…" : "PDF firmado")
					</button>
					<button type="button" class="btn btn-sm btn-outline-light" @onclick="Close" title="Cerrar">Cerrar</button>
				</span>
			</div>
			@if (mvarShowVerify)
			{
				<div class="diamond-circ-verify no-print p-2 border-bottom">
					<div class="d-flex flex-wrap gap-2 align-items-center">
						<input type="text"
							   class="form-control form-control-sm"
							   style="min-width:16rem;max-width:28rem"
							   placeholder="SEL a1b2… o pega ZAFSEL:v1:…"
							   @bind="mvarVerifyInput"
							   @bind:event="oninput" />
						<button type="button" class="btn btn-sm btn-primary" @onclick="VerifySealAsync">Comprobar</button>
						@if (!string.IsNullOrEmpty(mvarVerifyMessage))
						{
							<span class="@(mvarVerifyOk ? "text-success" : "text-danger") small">@mvarVerifyMessage</span>
						}
					</div>
					<div class="text-muted small mt-1">
						Cert. local: <code>@mvarCertThumbShort</code>
						@if (!string.IsNullOrEmpty(mvarLastSeal))
						{
							<span> · Última emisión: <code>SEL @mvarLastSeal</code></span>
						}
					</div>
				</div>
			}
			@if (!string.IsNullOrEmpty(mvarError))
			{
				<div class="p-3 text-danger">@mvarError</div>
			}
			@if (!string.IsNullOrEmpty(mvarInfo))
			{
				<div class="p-2 text-success small no-print">@mvarInfo</div>
			}
			<div class="diamond-circ-sheet-pages" @ref="mvarPrintRoot">
				@for (int i = 0; i < mcolPageSvg.Count; i++)
				{
					<div class="diamond-circ-sheet-page">
						@((MarkupString)mcolPageSvg[i])
					</div>
				}
			</div>
		</div>
	</div>
}

@code {
	private List<string> mcolPageSvg = new List<string>();
	private int mvarMaxPerPage = CirculationSheetPager.DefaultMaxFrontiersPerPage;
	private ElementReference mvarPrintRoot;
	private bool mvarReady;
	private bool mvarFullBook;
	private string mvarTitleExtra = string.Empty;
	private int mvarHalfPageCount;
	private string? mvarError;
	private string? mvarInfo;
	private bool mvarBusyPdf;
	private bool mvarShowVerify;
	private string mvarVerifyInput = string.Empty;
	private string mvarVerifyMessage = string.Empty;
	private bool mvarVerifyOk;
	private string mvarLastSeal = string.Empty;
	private string mvarCertThumbShort = "—";
	private string mvarEditionLabel = string.Empty;
	private string mvarDayLabel = string.Empty;

	/// <summary>Si true, libro de toda la malla; si false, ficha del tren seleccionado.</summary>
	[Parameter]
	public bool FullBook { get; set; }

	[Parameter]
	public Circulation? Circulation { get; set; }

	/// <summary>Malla (obligatoria en libro; opcional en ficha para cruces).</summary>
	[Parameter]
	public Mesh? Mesh { get; set; }

	[Parameter]
	public string PlanName { get; set; } = string.Empty;

	[Parameter]
	public string? Notes { get; set; }

	[Parameter]
	public DayOfWeek? PlanningDay { get; set; }

	/// <summary>Plan de demanda (días de circulación por requisito).</summary>
	[Parameter]
	public Plan? DemandPlan { get; set; }

	/// <summary>Plan de explotación multi-día (unión de días en que aparece cada tren).</summary>
	[Parameter]
	public ExploitationPlan? ExploitationPlan { get; set; }

	[Parameter]
	public int MaxFrontiersPerPage { get; set; } = CirculationSheetPager.DefaultMaxFrontiersPerPage;

	[Parameter]
	public EventCallback OnClose { get; set; }

	/// <summary>
	/// El host (Zafiro) registra la emisión en BD y en el log de sesión.
	/// Si no hay delegate, solo se escribe el registro local JSONL.
	/// </summary>
	[Parameter]
	public EventCallback<CirculationEmissionInfo> OnOfficialEmission { get; set; }

	/// <summary>
	/// Verificación remota (API almacén). Si no hay delegate, solo registro local + cripto.
	/// </summary>
	[Parameter]
	public EventCallback<string> OnVerifySealRemote { get; set; }

	[Parameter]
	public bool CloseOnOverlayClick { get; set; } = true;

	protected override void OnParametersSet()
	{
		if (MaxFrontiersPerPage >= 8 && MaxFrontiersPerPage != mvarMaxPerPage)
		{
			mvarMaxPerPage = MaxFrontiersPerPage;
		}

		try
		{
			string thumb = CirculationSheetCertificate.GetThumbprint();
			mvarCertThumbShort = thumb.Length > 10 ? thumb.Substring(0, 10) + "…" : thumb;
		}
		catch
		{
			mvarCertThumbShort = "(sin cert)";
		}

		Rebuild();
	}

	private void Rebuild()
	{
		mcolPageSvg.Clear();
		mvarReady = false;
		mvarError = null;
		mvarInfo = null;
		mvarFullBook = FullBook;
		mvarTitleExtra = string.Empty;
		mvarHalfPageCount = 0;
		mvarEditionLabel = string.Empty;
		mvarDayLabel = string.Empty;

		try
		{
			if (FullBook)
			{
				if (Mesh is null || Mesh.Circulations.Count == 0)
				{
					mvarError = "No hay malla o no contiene circulaciones.";
					mvarReady = true;
					return;
				}

				ItineraryBookDocument book = ItineraryBookDocument.Build(
					Mesh,
					PlanName,
					Notes,
					PlanningDay,
					mvarMaxPerPage,
					editionLabel: null,
					demandPlan: DemandPlan,
					exploitation: ExploitationPlan);
				mvarTitleExtra = book.PlanName;
				mvarHalfPageCount = book.TotalHalfPages;
				mvarEditionLabel = book.EditionLabel;
				mvarDayLabel = book.DayLabel;
				IReadOnlyList<string> sheets = CirculationSheetSvgRenderer.RenderAllBookSheets(book);
				int i = 0;
				while (i < sheets.Count)
				{
					mcolPageSvg.Add(sheets[i]);
					i++;
				}
			}
			else
			{
				if (Circulation is null)
				{
					return;
				}

				ServiceDays? days = ItineraryBookDocument.ResolveServiceDays(
					Circulation, DemandPlan, ExploitationPlan, Mesh?.PlanningDay ?? PlanningDay);
				CirculationSheetDocument doc = CirculationSheetDocument.Build(
					Circulation, Mesh, mvarMaxPerPage, editionLabel: null, serviceDays: days);
				mvarTitleExtra = string.IsNullOrEmpty(doc.TrainNumber) ? "—" : doc.TrainNumber;
				mvarHalfPageCount = doc.Pages.Count;
				mvarEditionLabel = doc.EditionLabel;
				mvarDayLabel = doc.ServiceDaysLabel;
				IReadOnlyList<string> pages = CirculationSheetSvgRenderer.RenderAllPages(doc);
				int i = 0;
				while (i < pages.Count)
				{
					mcolPageSvg.Add(pages[i]);
					i++;
				}
			}

			mvarReady = true;
		}
		catch (Exception ex)
		{
			mvarError = "Error al generar: " + ex.Message;
			mvarReady = true;
			mcolPageSvg.Clear();
			mcolPageSvg.Add(
				"<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"841\" height=\"200\" viewBox=\"0 0 841 200\">"
				+ "<text x=\"20\" y=\"40\" fill=\"#b91c1c\" font-size=\"12\" font-family=\"sans-serif\">"
				+ System.Security.SecurityElement.Escape(mvarError)
				+ "</text></svg>");
		}
	}

	private void OnMaxPerPageChanged(ChangeEventArgs e)
	{
		if (e.Value is null)
		{
			return;
		}

		if (int.TryParse(e.Value.ToString(), out int n))
		{
			if (n < 8)
			{
				n = 8;
			}

			int fit = CirculationSheetPager.MaxFrontiersFittingPage;
			if (n > fit)
			{
				n = fit;
			}

			mvarMaxPerPage = n;
			Rebuild();
		}
	}

	private void ToggleVerifyPanel()
	{
		mvarShowVerify = !mvarShowVerify;
		mvarVerifyMessage = string.Empty;
	}

	private async Task VerifySealAsync()
	{
		mvarVerifyMessage = string.Empty;
		CirculationSealVerifyResult local = CirculationEmissionRegistry.Verify(mvarVerifyInput);
		mvarVerifyOk = local.Ok;
		mvarVerifyMessage = local.Message;

		if (OnVerifySealRemote.HasDelegate && !string.IsNullOrWhiteSpace(mvarVerifyInput))
		{
			try
			{
				await OnVerifySealRemote.InvokeAsync(mvarVerifyInput.Trim());
			}
			catch
			{
			}
		}

		// Log de verificación vía host de emisión (detalle en OnOfficialEmission no aplica);
		// el host puede escuchar OnVerifySealRemote y hacer LogActivity(circulationSealVerified).
	}

	private CirculationEmissionInfo BuildEmission(string channel)
	{
		string kind = mvarFullBook ? "libro" : "ficha";
		string planOrTrain = mvarFullBook ? mvarTitleExtra : mvarTitleExtra;
		return CirculationSheetAuthenticity.CreateEmission(
			kind,
			channel,
			planOrTrain,
			mvarEditionLabel,
			mvarDayLabel,
			mcolPageSvg.Count,
			Notes);
	}

	private async Task RegisterEmissionAsync(CirculationEmissionInfo emission)
	{
		mvarLastSeal = emission.SealCode;
		try
		{
			CirculationEmissionRegistry.Append(emission);
		}
		catch
		{
		}

		if (OnOfficialEmission.HasDelegate)
		{
			try
			{
				await OnOfficialEmission.InvokeAsync(emission);
			}
			catch (Exception ex)
			{
				mvarInfo = "Emisión local OK; aviso al host: " + ex.Message;
			}
		}
	}

	private async Task PrintAsync()
	{
		CirculationEmissionInfo emission = BuildEmission("print");
		await RegisterEmissionAsync(emission);
		mvarInfo = "Emisión registrada · " + CirculationSheetAuthenticity.FormatSealLabel(emission.SealCode);

		try
		{
			await Js.InvokeVoidAsync("diamondCircSheet.printFromRoot", mvarPrintRoot);
		}
		catch
		{
			try
			{
				await Js.InvokeVoidAsync("diamondCircSheet.print", mcolPageSvg.ToArray());
			}
			catch
			{
				try
				{
					await Js.InvokeVoidAsync("window.print");
				}
				catch
				{
				}
			}
		}
	}

	private async Task ExportPdfAsync()
	{
		if (mcolPageSvg.Count == 0 || mvarBusyPdf)
		{
			return;
		}

		mvarBusyPdf = true;
		mvarError = null;
		mvarInfo = null;
		try
		{
			CirculationEmissionInfo emission = BuildEmission("pdf");
			byte[] pdf = await Task.Run(() =>
				CirculationSheetPdfExporter.ExportSvgSheetsToPdf(mcolPageSvg, emission));
			await RegisterEmissionAsync(emission);

			string b64 = Convert.ToBase64String(pdf);
			string name = mvarFullBook
				? "libro-itinerario-firmado.pdf"
				: "ficha-" + SanitizeFileName(mvarTitleExtra) + "-firmado.pdf";
			await Js.InvokeVoidAsync("diamondCircSheet.downloadPdf", b64, name);
			mvarInfo = "PDF firmado · "
				+ CirculationSheetAuthenticity.FormatSealLabel(emission.SealCode)
				+ " · cert " + (emission.CertThumbprint.Length > 8
					? emission.CertThumbprint.Substring(0, 8) + "…"
					: emission.CertThumbprint);
		}
		catch (Exception ex)
		{
			mvarError = "Error al exportar PDF: " + ex.Message;
		}
		finally
		{
			mvarBusyPdf = false;
		}
	}

	private static string SanitizeFileName(string raw)
	{
		if (string.IsNullOrWhiteSpace(raw))
		{
			return "documento";
		}

		char[] bad = Path.GetInvalidFileNameChars();
		System.Text.StringBuilder sb = new System.Text.StringBuilder(raw.Length);
		int i = 0;
		while (i < raw.Length)
		{
			char c = raw[i];
			bool ok = true;
			int b = 0;
			while (b < bad.Length)
			{
				if (c == bad[b])
				{
					ok = false;
					break;
				}

				b++;
			}

			sb.Append(ok ? c : '-');
			i++;
		}

		string s = sb.ToString().Trim();
		return s.Length == 0 ? "documento" : s;
	}

	private async Task Close()
	{
		if (OnClose.HasDelegate)
		{
			await OnClose.InvokeAsync();
		}
	}

	private async Task OnOverlayClick()
	{
		if (CloseOnOverlayClick)
		{
			await Close();
		}
	}
}
