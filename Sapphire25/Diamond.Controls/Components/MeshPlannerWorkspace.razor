		}
	}

	/// <summary>Carga un XML de topología Onice/Diamond en memoria para el <c>include</c> del script.</summary>
	private async Task LoadTopoFileAsync()
	{
		try
		{
			LocalFileResult? result = await Js.InvokeAsync<LocalFileResult?>(
				"diamondFile.openText",
				".xml,application/xml,text/xml",
				"Topología Diamond / Onice");
			if (result is null || string.IsNullOrEmpty(result.content))
			{
				mvarStatus = "Carga de topología cancelada.";
				return;
			}

			string name = string.IsNullOrEmpty(result.name) ? DemoMeshService.DefaultTopoFileName : result.name;
			DemoMeshService.RegisterTopoXml(name, result.content);
			// Alias del include demo (scripts que dicen include toposfm227).
			DemoMeshService.RegisterTopoXml(DemoMeshService.DefaultTopoIncludeName, result.content);
			mvarTopoXmlText = result.content;
			mvarTopoLabel = name;
			mvarError = null;
			mvarStatus = "Topología cargada: " + name + ". Recompilando…";
			await RebuildAsync();
			if (mvarError is null)
			{
				mvarStatus = "Topología activa: " + name + ".";
			}
		}
		catch (Exception ex)
		{
			mvarError = FormatException("Cargar topología", ex);
		}
	}

	private async Task UploadTopoToServerAsync()
	{
		if (!UploadTopoAsync.HasDelegate)
		{
			return;
		}

		string? xml = mvarTopoXmlText
			?? TopoStorage.TryGetMemoryXml(DemoMeshService.DefaultTopoIncludeName)
			?? TopoStorage.TryGetMemoryXml(DemoMeshService.DefaultTopoFileName);
		if (string.IsNullOrWhiteSpace(xml))
		{
			mvarError = "No hay XML de topología en memoria para subir. Use «Topo…» primero.";
			return;
		}

		string fileName = string.IsNullOrEmpty(mvarTopoLabel) ? DemoMeshService.DefaultTopoFileName : mvarTopoLabel;
		mvarUploadingTopo = true;
		try
		{
			await UploadTopoAsync.InvokeAsync((xml, fileName));
			mvarStatus = "Solicitud de subida de topología enviada (" + fileName + ").";
		}
		catch (Exception ex)
		{
			mvarError = FormatException("Subir topología a Zafiro", ex);
		}
		finally
		{
			mvarUploadingTopo = false;
		}
	}

