	private async Task StoreNewAsync()
	{
		if (!await ConfirmDiscardIfDirtyAsync("Crear un plan nuevo"))
		{
			return;
		}

		// Diálogo: elegir topo del almacén y nombre, script plantilla con include.
		mvarForceSaveAsNew = true;
		mvarSaveAsName = "nuevo plan";
		mvarSaveAsTopoId = mvarStoreTopoId;
		await EnsureStoreToposLoadedAsync();
		if (mcolStoreTopos.Count == 0)
		{
			mvarError = "No hay topologías en el almacén. Suba una en «Topologías» antes de crear un plan.";
			return;
		}

		if (mvarSaveAsTopoId == Guid.Empty && mcolStoreTopos.Count > 0)
		{
			mvarSaveAsTopoId = mcolStoreTopos[0].Id;
		}

		// Crear en memoria; el usuario guarda en almacén cuando quiera.
		string includeName = "topologia";
		int ti = 0;
		while (ti < mcolStoreTopos.Count)
		{
			if (mcolStoreTopos[ti].Id == mvarSaveAsTopoId)
			{
				includeName = !string.IsNullOrWhiteSpace(mcolStoreTopos[ti].SourceFileName)
					? Path.GetFileNameWithoutExtension(mcolStoreTopos[ti].SourceFileName)
					: mcolStoreTopos[ti].Name;
				mvarStoreTopoName = mcolStoreTopos[ti].Name;
				break;
			}
			ti++;
		}

		await BeginNewScriptAsync(storeMode: true);
		mvarStoreTopoId = mvarSaveAsTopoId;
		mvarScript = "include " + SanitizeIncludeToken(includeName) + "\n"
			+ "plan \"" + mvarSaveAsName.Replace("\"", "'") + "\"\n"
			+ "# Requisitos de demanda\n";
		mvarFileName = mvarSaveAsName + ".ddm";
		mvarBaselineScript = string.Empty;
		mvarDirty = true;
		await PushScriptToEditorAsync();
		mvarStatus = "Nuevo plan (sin guardar en almacén). Elija «Guardar» o «Guardar como…».";
		mvarError = null;
		mcolCompileErrors.Clear();
		await RebuildAsync();
	}

	private async Task BeginNewScriptAsync(bool storeMode)
	{
		await SyncScriptFromEditorAsync();
		mvarScript = "plan \"nuevo\"\n# Escribe requisitos aquí\n";
		mvarFileName = "sin titulo.ddm";
		mvarFileHasHandle = false;
		mcolInverseNotes.Clear();
		mvarProject = null;
		if (!storeMode)
		{
			ClearStoreDocument();
		}
		else
		{
			mvarStorePlanId = null;
		}

		try
		{
			await Js.InvokeAsync<bool>("diamondFile.clear");
		}
		catch (JSException)
		{
		}

		mvarBaselineScript = string.Empty;
		mvarDirty = true;
		await PushScriptToEditorAsync();
		mvarStatus = storeMode ? "Nuevo plan." : "Nuevo script.";
		mvarError = null;
		mcolCompileErrors.Clear();
	}

	private void ClearStoreDocument()
	{
		mvarStorePlanId = null;
		mvarStoreTopoId = Guid.Empty;
		mvarStoreTopoName = string.Empty;
	}

	private static string SanitizeIncludeToken(string name)
	{
		if (string.IsNullOrWhiteSpace(name))
		{
			return "topo";
		}

		// include admite nombre simple; quitar comillas y espacios extremos.
		string t = name.Trim().Trim('"', '\'');
		if (t.EndsWith(".xml", StringComparison.OrdinalIgnoreCase))
		{
			t = t.Substring(0, t.Length - 4);
		}

		return t.Length > 0 ? t : "topo";
	}

