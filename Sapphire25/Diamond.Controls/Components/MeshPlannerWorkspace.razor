	private async Task StorePersistAsync(Guid? id, Guid topoId, string name, string fileName)
	{
		if (SaveStorePlanAsync is null)
		{
			return;
		}

		mvarSavingStore = true;
		try
		{
			MeshStorePlanSaveArgs args = new MeshStorePlanSaveArgs
			{
				Id = id,
				TopoId = topoId,
				SourceScript = mvarScript ?? string.Empty,
				Name = name,
				SourceFileName = fileName
			};
			MeshStorePlanSaveResult? result = await SaveStorePlanAsync(args);
			if (result is null)
			{
				mvarError = "Sin respuesta del almacén al guardar.";
				return;
			}

			if (!result.Success)
			{
				mvarError = result.Message;
				mvarStatus = null;
				return;
			}

			if (result.Id.HasValue)
			{
				mvarStorePlanId = result.Id;
			}

			if (result.TopoId.HasValue)
			{
				mvarStoreTopoId = result.TopoId.Value;
			}

			if (!string.IsNullOrWhiteSpace(result.TopoName))
			{
				mvarStoreTopoName = result.TopoName!;
				mvarTopoLabel = mvarStoreTopoName;
			}

			if (!string.IsNullOrWhiteSpace(result.Name))
			{
				mvarFileName = result.Name!.EndsWith(".ddm", StringComparison.OrdinalIgnoreCase)
					? result.Name!
					: result.Name + ".ddm";
			}
			else
			{
				mvarFileName = fileName;
			}

			mvarFileHasHandle = false;
			MarkClean();
			mvarError = null;
			mvarStatus = string.IsNullOrWhiteSpace(result.Message)
				? "Guardado en el almacén."
				: result.Message;
		}
		catch (Exception ex)
		{
			mvarError = FormatException("Guardar en el almacén", ex);
		}
		finally
		{
			mvarSavingStore = false;
		}
	}

