		// MeshDiagram se actualiza por parámetros Mesh/View en el render de Blazor.
	}

	private MeshSvgDrawOptions BuildDrawOptions(bool interactive)
	{
		if (mvarShowNowLine)
		{
			mvarClockNow = DateTime.Now.TimeOfDay;
		}

		MeshSvgDrawOptions options = MeshSvgDrawOptions.Create(
			showCantonOccupations: mvarShowOccupations,
			showTrainPaths: mvarShowTrainPaths,
			showTrainNumbers: mvarShowTrainNumbers,
			showConflicts: mvarShowConflicts,
			showSpeedStrip: mvarShowSpeedStrip,
			showTrackStrip: mvarShowTrackStrip,
			showNowLine: mvarShowNowLine,
			nowTime: mvarShowNowLine ? mvarClockNow : null,
			maxPolylineSamples: interactive ? 16 : 48);

		if (interactive)
		{
			return options.ForInteractiveLod();
		}

		return options;
	}

