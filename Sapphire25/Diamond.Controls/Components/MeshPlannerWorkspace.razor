	private static List<ScriptDiagnostic> BuildDiagnosticsFromCompile(DemandCompileResult compiled)
	{
		List<ScriptDiagnostic> list = new List<ScriptDiagnostic>();
		int i = 0;
		while (i < compiled.Errors.Count)
		{
			string raw = compiled.Errors[i];
			int line = 0;
			string message = raw;

			if (raw.StartsWith("line ", StringComparison.OrdinalIgnoreCase))
			{
				int colon = raw.IndexOf(':');
				if (colon > 5)
				{
					string numPart = raw.Substring(5, colon - 5).Trim();
					int parsed;
					if (int.TryParse(numPart, NumberStyles.Integer, CultureInfo.InvariantCulture, out parsed))
					{
						line = parsed;
						message = raw.Substring(colon + 1).Trim();
					}
				}
			}

			list.Add(new ScriptDiagnostic
			{
				Line = line,
				Message = message,
				Severity = "error"
			});
			i++;
		}

		return list;
	}

	private async Task FlushMarkersToEditorAsync()
	{
		if (!mvarJsReady || mvarDisposed)
		{
			mvarMarkersDirty = true;
			return;
		}

		try
		{
			if (mcolCompileErrors.Count == 0)
			{
				await Js.InvokeAsync<bool>("diamondMonaco.clearMarkers");
				mvarMarkersDirty = false;
				return;
			}

			List<object> markers = new List<object>();
			int i = 0;
			while (i < mcolCompileErrors.Count)
			{
				ScriptDiagnostic d = mcolCompileErrors[i];
				markers.Add(new
				{
					line = d.Line > 0 ? d.Line : 1,
					message = d.Message,
					severity = d.Severity
				});
				i++;
			}

			bool ok = await Js.InvokeAsync<bool>("diamondMonaco.setMarkers", markers);
			mvarMarkersDirty = !ok;
		}
		catch (Exception ex) when (IsBenignInteropException(ex))
		{
			mvarMarkersDirty = true;
		}
	}

	private static bool ScriptLooksLikePalmaSaPobla(string script)
	{
		if (string.IsNullOrEmpty(script))
		{
			return false;
		}

		bool hasPmi = script.IndexOf("PMI", StringComparison.OrdinalIgnoreCase) >= 0;
		bool hasSpb = script.IndexOf("SPB", StringComparison.OrdinalIgnoreCase) >= 0
			|| script.IndexOf("Sa Pobla", StringComparison.OrdinalIgnoreCase) >= 0;
		bool multiHint = script.IndexOf("multi-eje", StringComparison.OrdinalIgnoreCase) >= 0
			|| script.IndexOf("T3+T2", StringComparison.OrdinalIgnoreCase) >= 0
			|| script.IndexOf("T3:", StringComparison.OrdinalIgnoreCase) >= 0;
		return hasPmi && hasSpb && (multiHint || script.IndexOf("PMI -> SPB", StringComparison.OrdinalIgnoreCase) >= 0);
	}

	private async Task SelectDay(DayOfWeek day)
	{
		mvarSelectedDay = day;

		// Plan de explotación cargado: el día es solo filtro (no replanificar).
		if (mvarExploitationPlan is not null)
		{
			ApplyExploitationDayFilter(day);
			return;
		}

		if (mvarPlan is null)
		{
			await RebuildAsync();
			return;
		}

		try
		{
			mvarError = null;
			mcolCompileErrors = new List<ScriptDiagnostic>();
			mvarMesh = DemoMeshService.SolveForDay(mvarPlan, day);
			mvarSelectedCirculation = null;
			mvarMeshStale = false;
			mvarProject = null;
			RefreshSvg();
			mvarStatus = "Malla para " + DayLabel(day) + ".";
			if (mvarMesh is not null && !mvarMesh.Success)
			{
				mvarError = "Malla con " + mvarMesh.Errors.Count.ToString(CultureInfo.InvariantCulture) + " error(es).";
				mvarInspectTab = InspectTab.Errors;
			}
			else if (mvarInspectTab == InspectTab.Errors)
			{
				mvarInspectTab = InspectTab.Warnings;
			}

			if (mvarJsReady)
			{
				try { await Js.InvokeAsync<bool>("diamondMonaco.clearMarkers"); }
				catch (JSException) { }
			}
		}
		catch (Exception ex)
		{
			mvarError = ex.Message;
			mvarMeshStale = mvarMesh is not null;
		}

		await Task.CompletedTask;
	}

	private void SelectView(MeshRouteView candidate)
	{
		if (candidate is null)
		{
			return;
		}

		mvarSelectedViewId = candidate.Id;
		mvarView = candidate;
		InitAxisBounds();
		ResetViewWindow();
		RefreshSvg();
		string note = string.Empty;
		if (mvarMesh is not null && ScoreViewCoverage(mvarMesh, candidate) < 0.85)
		{
			note = " · (la malla solo cubre parte de esta vista; traza = tramo común)";
		}

		mvarStatus = "Vista: " + candidate.Id + " · " + candidate.Name + "." + note;
	}

	/// <summary>
	/// Elige la vista de catálogo que mejor proyecta las asimilaciones de la malla.
	/// Conserva la selección del usuario si su cobertura es casi óptima.
	/// </summary>
	private static MeshRouteView? PreferViewForMesh(
		Diamond.Timed.Mesh mesh,
		IReadOnlyList<MeshRouteView> views,
		string preferredId)
	{
		if (views is null || views.Count == 0)
		{
			return null;
		}

		MeshRouteView? preferred = DemoMeshService.FindViewById(views, preferredId);
		if (mesh is null || mesh.Asimilations.Count == 0)
		{
			return preferred ?? views[0];
		}

		// Añadir vistas planificadas multi-eje al catálogo si no hay equivalente.
		List<MeshRouteView> catalog = new List<MeshRouteView>(views);
		int ai = 0;
		while (ai < mesh.Asimilations.Count)
		{
			MeshRouteView planned = mesh.Asimilations[ai].View;
			bool found = false;
			int vi = 0;
			while (vi < catalog.Count)
			{
				if (catalog[vi].IsSameOrReversePath(planned))
				{
					found = true;
					break;
				}

				vi++;
			}

			if (!found)
			{
				catalog.Add(planned);
			}

			ai++;
		}

		MeshRouteView? best = null;
		double bestScore = -1.0;
		int i = 0;
		while (i < catalog.Count)
		{
			double score = ScoreViewCoverage(mesh, catalog[i]);
			if (score > bestScore)
			{
				bestScore = score;
				best = catalog[i];
			}

			i++;
		}

		if (preferred is not null)
		{
			double prefScore = ScoreViewCoverage(mesh, preferred);
			// Mantener la vista del usuario si cubre al menos el 85 % del mejor score.
			if (prefScore >= bestScore * 0.85 && prefScore > 0.05)
			{
				return preferred;
			}
		}

		return best ?? preferred ?? views[0];
	}

	/// <summary>
	/// 0..1: fracción de asimilaciones bien proyectables (mismo corredor = 1;
	/// solape físico = ~0.5; nada = 0).
	/// </summary>
	private static double ScoreViewCoverage(Diamond.Timed.Mesh mesh, MeshRouteView view)
	{
		if (mesh is null || view is null || mesh.Asimilations.Count == 0)
		{
			return 0.0;
		}

		double sum = 0.0;
		int n = 0;
		int i = 0;
		while (i < mesh.Asimilations.Count)
		{
			Diamond.Motion.Asimilation asim = mesh.Asimilations[i];
			if (view.IsSameOrReversePath(asim.View))
			{
				sum += 1.0;
			}
			else if (view.OverlapsPhysically(asim.View))
			{
				// Tramo común (T3 en T3+T2): cobertura parcial.
				sum += 0.45;
			}

			n++;
			i++;
		}

		return n > 0 ? sum / n : 0.0;
	}

