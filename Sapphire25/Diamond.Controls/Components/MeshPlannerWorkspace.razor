@implements IAsyncDisposable
@inject IJSRuntime Js
@inject NavigationManager Nav
@using System.Globalization
@using System.IO
@using System.Net.Http
@using Diamond.Project
@using Diamond.Timed
@using Diamond.Topo
@using Diamond.Controls.Services
@using Microsoft.AspNetCore.Components
@using Microsoft.JSInterop
@using MeshRouteView = Diamond.Topo.RouteView
@using ProjectModel = Diamond.Project.Project

<div class="mesh-workspace @(FillViewport ? "mesh-workspace-viewport" : null)">
	@* —— Menú archivo / almacén —— *@
	<div class="mesh-menubar">
		<span class="brand">Diamond</span>
		@if (StoreEnabled)
		{
			<div class="btn-group btn-group-sm" role="group" aria-label="Almacén">
				<button type="button" class="btn btn-outline-light" @onclick="StoreNewAsync" title="Nuevo plan en el almacén">Nuevo</button>
				<button type="button" class="btn btn-outline-light" @onclick="StoreOpenDialogAsync" title="Abrir plan del almacén Zafiro">Abrir…</button>
				<button type="button" class="btn btn-success" @onclick="StoreSaveAsync" title="Guardar en el almacén" disabled="@(!mvarDirty && mvarStorePlanId.HasValue)">
					@(mvarSavingStore ? "Guardando…" : "Guardar")
				</button>
				<button type="button" class="btn btn-outline-light" @onclick="StoreSaveAsDialogAsync" title="Guardar como nuevo plan en el almacén">Guardar como…</button>
				@if (PublishStorePlanAsync is not null)
				{
					<button type="button" class="btn btn-warning" @onclick="StorePublishDialogAsync" title="Compilar y publicar para Tourmaline" disabled="@mvarPublishingStore">
						@(mvarPublishingStore ? "Publicando…" : "Publicar")
					</button>
				}
			</div>
			<div class="dropdown ms-1">
				<button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false" title="Utilidades de fichero local">
					Archivo local
				</button>
				<ul class="dropdown-menu dropdown-menu-dark">
					<li><button type="button" class="dropdown-item" @onclick="FileOpenAsync">Abrir desde disco…</button></li>
					<li><button type="button" class="dropdown-item" @onclick="FileSaveAsync">Guardar en disco</button></li>
					<li><button type="button" class="dropdown-item" @onclick="FileSaveAsAsync">Guardar como archivo…</button></li>
				</ul>
			</div>
		}
		else
		{
			<div class="btn-group btn-group-sm" role="group" aria-label="Archivo">
				<button type="button" class="btn btn-outline-light" @onclick="FileNewAsync" title="Nuevo script">Nuevo</button>
				<button type="button" class="btn btn-outline-light" @onclick="FileOpenAsync" title="Abrir script desde disco">Abrir…</button>
				<button type="button" class="btn btn-outline-light" @onclick="FileSaveAsync" title="Guardar" disabled="@(!mvarDirty)">Guardar</button>
				<button type="button" class="btn btn-outline-light" @onclick="FileSaveAsAsync" title="Guardar como…">Guardar como…</button>
			</div>
		}
		<div class="btn-group btn-group-sm ms-1" role="group" aria-label="Topología">
			<button type="button" class="btn btn-outline-info" @onclick="LoadTopoFileAsync" title="Cargar XML de topología (include) en esta sesión">Topo…</button>
			@if (UploadTopoAsync.HasDelegate)
			{
				<button type="button"
						class="btn btn-outline-success"
						disabled="@(string.IsNullOrEmpty(mvarTopoXmlText) || mvarUploadingTopo)"
						@onclick="UploadTopoToServerAsync"
						title="Subir el XML de topología actual al almacén Diamond">
					@(mvarUploadingTopo ? "Subiendo…" : "Subir topo")
				</button>
			}
		</div>
		<span class="mesh-file-label @(mvarDirty ? "dirty" : null)" title="@DocumentTitleTooltip">@FileDisplayName</span>
		@if (mvarStorePlanId.HasValue)
		{
			<span class="badge bg-primary-subtle text-primary-emphasis border border-primary-subtle" title="Documento del almacén">Almacén</span>
		}
		@if (!string.IsNullOrEmpty(mvarTopoLabel))
		{
			<span class="mesh-file-label" title="Topología activa">Topo: @mvarTopoLabel</span>
		}
		else if (!string.IsNullOrEmpty(mvarStoreTopoName))
		{
			<span class="mesh-file-label" title="Topología del plan">Topo: @mvarStoreTopoName</span>
		}
		<span class="ms-auto"></span>
		<a class="btn btn-sm btn-outline-secondary" href="_content/Diamond.Controls/docs/diamond-plan-language.html" target="_blank" rel="noopener">Manual DSL</a>
		@if (!string.IsNullOrEmpty(HomeHref))
		{
			<a class="btn btn-sm btn-outline-secondary" href="@HomeHref">Inicio</a>
		}
	</div>

	@* —— Modal: abrir plan del almacén —— *@
	@if (mvarShowStoreOpen)
	{
		<div class="mesh-store-modal-backdrop" @onclick="CloseStoreOpen">
			<div class="mesh-store-modal" @onclick:stopPropagation="true">
				<div class="mesh-store-modal-header">
					<strong>Abrir plan del almacén</strong>
					<button type="button" class="btn btn-sm btn-outline-light" @onclick="CloseStoreOpen">✕</button>
				</div>
				<div class="mesh-store-modal-body">
					@if (mvarStoreListLoading)
					{
						<div class="text-secondary py-3 text-center"><span class="spinner-border spinner-border-sm"></span> Cargando…</div>
					}
					else if (mcolStorePlans.Count == 0)
					{
						<div class="text-secondary py-3 text-center">No hay planes en el almacén. Use «Nuevo» o «Guardar como…».</div>
					}
					else
					{
						<ul class="mesh-store-list">
							@foreach (MeshStorePlanRef p in mcolStorePlans)
							{
								<li>
									<button type="button" class="mesh-store-list-item" @onclick="() => StoreOpenPlanAsync(p.Id)">
										<span class="fw-semibold">@p.Name</span>
										<span class="small text-secondary">@p.TopoName · @p.UpdatedUtc.ToLocalTime().ToString("g")</span>
									</button>
								</li>
							}
						</ul>
					}
				</div>
			</div>
		</div>
	}

	@* —— Modal: publicar a explotación —— *@
	@if (mvarShowStorePublish)
	{
		<div class="mesh-store-modal-backdrop" @onclick="CloseStorePublish">
			<div class="mesh-store-modal" @onclick:stopPropagation="true">
				<div class="mesh-store-modal-header">
					<strong>Publicar plan (Tourmaline)</strong>
					<button type="button" class="btn btn-sm btn-outline-light" @onclick="CloseStorePublish">✕</button>
				</div>
				<div class="mesh-store-modal-body">
					<p class="small text-secondary mb-2">Compila el script actual (7 días) y crea una publicación inmutable en el almacén.</p>
					<div class="mb-2">
						<label class="form-label small text-secondary mb-1">Nombre</label>
						<input class="form-control form-control-sm" @bind="mvarPublishName" />
					</div>
					<div class="mb-2">
						<label class="form-label small text-secondary mb-1">Topología del almacén</label>
						<select class="form-select form-select-sm" @bind="mvarPublishTopoId">
							<option value="@Guid.Empty">— elegir —</option>
							@foreach (MeshStoreTopoRef t in mcolStoreTopos)
							{
								<option value="@t.Id">@t.Name</option>
							}
						</select>
					</div>
					<div class="mb-2">
						<label class="form-label small text-secondary mb-1">Vigencia desde</label>
						<input type="date" class="form-control form-control-sm" @bind="mvarPublishValidFrom" />
					</div>
					<div class="mb-3">
						<label class="form-label small text-secondary mb-1">Vigencia hasta (opcional)</label>
						<input type="date" class="form-control form-control-sm" @bind="mvarPublishValidToNullable" />
					</div>
					<div class="d-flex justify-content-end gap-2">
						<button type="button" class="btn btn-sm btn-outline-secondary" @onclick="CloseStorePublish">Cancelar</button>
						<button type="button" class="btn btn-sm btn-warning" disabled="@(mvarPublishingStore || mvarPublishTopoId == Guid.Empty)" @onclick="StorePublishConfirmAsync">
							@(mvarPublishingStore ? "Publicando…" : "Compilar y publicar")
						</button>
					</div>
				</div>
			</div>
		</div>
	}

	@* —— Modal: guardar como en almacén —— *@
	@if (mvarShowStoreSaveAs)
	{
		<div class="mesh-store-modal-backdrop" @onclick="CloseStoreSaveAs">
			<div class="mesh-store-modal" @onclick:stopPropagation="true">
				<div class="mesh-store-modal-header">
					<strong>@(mvarStorePlanId.HasValue && !mvarForceSaveAsNew ? "Guardar plan" : "Guardar como plan nuevo")</strong>
					<button type="button" class="btn btn-sm btn-outline-light" @onclick="CloseStoreSaveAs">✕</button>
				</div>
				<div class="mesh-store-modal-body">
					<div class="mb-2">
						<label class="form-label small text-secondary mb-1">Nombre</label>
						<input class="form-control form-control-sm" @bind="mvarSaveAsName" />
					</div>
					<div class="mb-3">
						<label class="form-label small text-secondary mb-1">Topología del almacén</label>
						<select class="form-select form-select-sm" @bind="mvarSaveAsTopoId">
							<option value="@Guid.Empty">— elegir —</option>
							@foreach (MeshStoreTopoRef t in mcolStoreTopos)
							{
								<option value="@t.Id">@t.Name</option>
							}
						</select>
					</div>
					<div class="d-flex justify-content-end gap-2">
						<button type="button" class="btn btn-sm btn-outline-secondary" @onclick="CloseStoreSaveAs">Cancelar</button>
						<button type="button" class="btn btn-sm btn-success" disabled="@(mvarSavingStore || mvarSaveAsTopoId == Guid.Empty || string.IsNullOrWhiteSpace(mvarSaveAsName))" @onclick="StoreSaveAsConfirmAsync">
							@(mvarSavingStore ? "Guardando…" : "Guardar")
						</button>
					</div>
				</div>
			</div>
		</div>
	}

	@* —— Barra de planificación —— *@
	<div class="mesh-toolbar">
		<span class="lbl">View</span>
		@if (mcolViews.Count > 0)
		{
			<div class="btn-group btn-group-sm" role="group">
				@foreach (MeshRouteView candidate in mcolViews)
				{
					<button type="button" class="btn @ViewButtonClass(candidate)" @onclick="() => SelectView(candidate)" title="@candidate.PathSignature()">
						@candidate.Id
					</button>
				}
			</div>
		}

		<span class="sep"></span>
		<span class="lbl">Día</span>
		<div class="btn-group btn-group-sm" role="group">
			@foreach (DayOfWeek day in mcolWeekDays)
			{
				<button type="button" class="btn @DayButtonClass(day)" @onclick="() => SelectDay(day)">@DayLabel(day)</button>
			}
		</div>

		<span class="sep"></span>
		<button type="button" class="btn btn-sm btn-primary" @onclick="ApplyScript" title="Compilar script y planificar malla">Aplicar</button>
		<button type="button" class="btn btn-sm btn-outline-secondary" @onclick="RebuildAsync" title="Regenerar malla">Regenerar</button>
		<button type="button" class="btn btn-sm btn-success" @onclick="CompileProject" disabled="@(mvarMesh is null)" title="Generar Project">Compilar</button>
		<button type="button"
				class="btn btn-sm btn-outline-light"
				disabled="@(mvarPlan is null && mvarMesh is null)"
				@onclick="SaveMeshBinaryAsync"
				title="Guardar plan de explotación (.dmesh): todos los días + vigencia">
			Exportar plan
		</button>
		<button type="button"
				class="btn btn-sm btn-outline-light"
				@onclick="OpenMeshBinaryAsync"
				title="Abrir plan de explotación (.dmesh); el día del selector es un filtro">
			Abrir plan
		</button>
		<label class="small text-secondary ms-1" title="Inicio de vigencia del plan de explotación (.dmesh)">
			Vigencia
			<input type="date"
				   class="form-control form-control-sm d-inline-block"
				   style="width: 9.5rem;"
				   value="@ValidityStartInputValue"
				   @onchange="OnValidityStartChanged" />
		</label>

		<span class="sep"></span>
		<div class="btn-group btn-group-sm">
			<button type="button" class="btn btn-outline-warning" @onclick="ImportRauta" title="Inferir script desde rauta">Rauta</button>
			<button type="button" class="btn btn-outline-secondary" @onclick="UseManualScript">T3</button>
			<button type="button" class="btn btn-outline-secondary" @onclick="UsePalmaSpbScript">SPB</button>
		</div>
	</div>

	@* —— Línea de estado —— *@
	<div class="mesh-statusline">
		@if (mvarMesh is not null && mvarView is not null)
		{
			<div class="mesh-badge-row">
				<span class="badge bg-info text-dark">@mvarView.Id</span>
				<span class="badge bg-primary">@DayLabel(mvarSelectedDay)</span>
				@if (mvarMeshStale)
				{
					<span class="badge bg-secondary">Malla desactualizada</span>
				}
				else
				{
					<span class="badge @(mvarMesh.Success ? "bg-success" : "bg-danger")">@(mvarMesh.Success ? "OK" : "Errores")</span>
				}
				<span class="badge bg-secondary">@mvarMesh.Circulations.Count circ.</span>
				<span class="badge bg-secondary">@mvarMesh.Asimilations.Count asim.</span>
				@if (mvarSelectedCirculation is not null)
				{
					<span class="badge bg-warning text-dark" title="@mvarSelectedCirculation.TechnicalId">
						Sel. @(mvarSelectedCirculation.HasServiceNumber ? mvarSelectedCirculation.ServiceNumber : mvarSelectedCirculation.Id)
					</span>
				}
				@if (!mvarMeshStale && mvarMesh.Warnings.Count > 0)
				{
					<span class="badge bg-warning text-dark">@mvarMesh.Warnings.Count warn</span>
				}
				@if (!mvarMeshStale && mvarMesh.Errors.Count > 0)
				{
					<span class="badge bg-danger">@mvarMesh.Errors.Count err</span>
				}
				@if (mvarProject is not null)
				{
					<span class="badge bg-success">Project @mvarProject.Circulations.Count trenes</span>
				}
			</div>
		}
		<span class="msg @(StatusCssClass)">@StatusText</span>
	</div>

	@* —— Split: malla | editor —— *@
	<div class="mesh-split" @ref="mvarSplitRoot">
		@* Panel malla *@
		<div class="mesh-panel mesh-panel-mesh">
			<div class="mesh-panel-head">
				<span class="title">Malla</span>
				@if (mvarView is not null)
				{
					<span class="badge bg-dark text-light border small">@mvarView.PathSignature()</span>
				}
			</div>

			<div class="mesh-panel-body">
				@* Control reutilizable: StationRuler + plot (Diamond.Controls) *@
				<MeshDiagram Mesh="mvarMesh"
							 View="mvarView"
							 Width="1400"
							 Height="900"
							 ShowLayerToolbar="true"
							 ShowZoomToolbar="true"
							 PlanName="@PrintPlanNameForMesh"
							 PlanningDay="mvarSelectedDay"
							 PrintNotes="@PrintNotesForMesh"
							 DemandPlan="mvarPlan"
							 ExploitationPlan="mvarExploitationPlan"
							 @bind-SelectedCirculation="mvarSelectedCirculation" />

				@* Inspector inferior de la malla *@
				<div class="mesh-side-tabs">
					<button type="button" class="@InspectTabClass(InspectTab.Warnings)" @onclick="() => mvarInspectTab = InspectTab.Warnings">
						Warnings @(CurrentMeshWarningCount > 0 ? $"({CurrentMeshWarningCount})" : "")
					</button>
					<button type="button" class="@InspectTabClass(InspectTab.Errors)" @onclick="() => mvarInspectTab = InspectTab.Errors">
						Errores @(CurrentMeshErrorCount > 0 ? $"({CurrentMeshErrorCount})" : "")
					</button>
					<button type="button" class="@InspectTabClass(InspectTab.Project)" @onclick="() => mvarInspectTab = InspectTab.Project">
						Project @(mvarProject is not null ? $"({mvarProject.Circulations.Count})" : "")
					</button>
					<button type="button" class="@InspectTabClass(InspectTab.Notes)" @onclick="() => mvarInspectTab = InspectTab.Notes">
						Notas @(mcolInverseNotes.Count > 0 ? $"({mcolInverseNotes.Count})" : "")
					</button>
				</div>
				<div class="mesh-inspect">
					@if (mvarInspectTab == InspectTab.Warnings)
					{
						@if (mvarMeshStale)
						{
							<div class="empty">Malla desactualizada: aplica el script de nuevo para ver warnings actuales.</div>
						}
						else if (mvarMesh is null || mvarMesh.Warnings.Count == 0)
						{
							<div class="empty">Sin warnings.</div>
						}
						else
						{
							<ul>
								@foreach (string w in mvarMesh.Warnings)
								{
									<li>@w</li>
								}
							</ul>
						}
					}
					else if (mvarInspectTab == InspectTab.Errors)
					{
						@if (mvarMeshStale)
						{
							<div class="empty">Malla desactualizada: los errores de la planificación anterior ya no aplican. Corrige el script y pulsa Aplicar.</div>
						}
						else if (mvarMesh is null || mvarMesh.Errors.Count == 0)
						{
							<div class="empty">Sin errores de malla.</div>
						}
						else
						{
							<ul>
								@foreach (string e in mvarMesh.Errors)
								{
									<li class="text-danger">@e</li>
								}
							</ul>
						}
					}
					else if (mvarInspectTab == InspectTab.Project)
					{
						@if (mvarProject is null)
						{
							<div class="empty">Pulsa <strong>Compilar</strong> para generar el Project.</div>
						}
						else
						{
							<div class="mb-1">
								<strong>@mvarProject.Name</strong>
								<span class="text-muted"> · @mvarProject.Id</span>
								@if (mvarProject.PlanningDay.HasValue)
								{
									<span> · @DayLabel(mvarProject.PlanningDay.Value)</span>
								}
							</div>
							<ul>
								@foreach (Diamond.Project.Asimilation a in mvarProject.Asimilations)
								{
									<li>
										<code>@a.Id</code> @a.Origin.DisplayCode→@a.Destination.DisplayCode
										· @a.Circulations.Count trenes · @FormatDuration(a.TotalTime)
									</li>
								}
							</ul>
							<details class="mt-1">
								<summary>Circulaciones (40 de @mvarProject.Circulations.Count)</summary>
								<ul class="font-monospace">
									@foreach (Diamond.Project.Circulation c in mvarProject.Circulations.Take(40))
									{
										<li>
											@(c.HasServiceNumber ? c.ServiceNumber : c.Id)
											@c.Origin.DisplayCode→@c.Destination.DisplayCode
											@FormatClock(c.Departure)–@FormatClock(c.Arrival)
										</li>
									}
								</ul>
							</details>
						}
					}
					else
					{
						@if (mcolInverseNotes.Count == 0)
						{
							<div class="empty">Sin notas de importación.</div>
						}
						else
						{
							<ul>
								@foreach (string n in mcolInverseNotes)
								{
									<li>@n</li>
								}
							</ul>
						}
					}
				</div>
			</div>
		</div>

		<div class="mesh-gutter" @ref="mvarSplitGutter" title="Arrastrar para redimensionar"></div>

		@* Panel script *@
		<div class="mesh-panel mesh-panel-script">
			<div class="mesh-panel-head">
				<span class="title">Script</span>
				<span class="text-muted small">diamond-demand</span>
				@if (mvarDirty)
				{
					<span class="badge bg-warning text-dark">sin guardar</span>
				}
			</div>
			<div class="mesh-panel-body">
				<div class="diamond-script-editor @(mcolCompileErrors.Count > 0 ? "has-markers" : "")">
					@if (mvarMountEditor)
					{
						<StandaloneCodeEditor @ref="mvarScriptEditor"
											  Id="@ScriptEditorId"
											  ConstructionOptions="EditorConstructionOptions"
											  OnDidInit="OnScriptEditorInit"
											  OnDidChangeModelContent="OnScriptEditorChanged" />
					}
					else
					{
						<div class="diamond-editor-placeholder">Cargando editor…</div>
					}
				</div>

				@if (mvarError is not null || mcolCompileErrors.Count > 0)
				{
					<div class="mesh-diag-list">
						@if (mvarError is not null)
						{
							<div class="text-danger mb-1">@mvarError</div>
						}
						@foreach (ScriptDiagnostic d in mcolCompileErrors)
						{
							<div>
								@if (d.Line > 0)
								{
									<a @onclick="() => GoToDiagnostic(d)" @onclick:preventDefault>línea @d.Line</a>
									<span>: </span>
								}
								@d.Message
							</div>
						}
					</div>
				}

				<div class="mesh-editor-actions">
					<button type="button" class="btn btn-sm btn-primary" @onclick="ApplyScript">Aplicar script y planificar</button>
					@if (StoreEnabled)
					{
						<button type="button" class="btn btn-sm btn-success" @onclick="StoreSaveAsync" disabled="@mvarSavingStore">
							@(mvarSavingStore ? "Guardando…" : "Guardar en almacén")
						</button>
					}
					else
					{
						<button type="button" class="btn btn-sm btn-outline-light" @onclick="FileSaveAsync">Guardar</button>
					}
					@if (mvarError is not null || mcolCompileErrors.Count > 0)
					{
						<button type="button" class="btn btn-sm btn-outline-secondary" @onclick="ClearErrorPanel">Limpiar errores</button>
					}
				</div>
			</div>
		</div>
	</div>
</div>

@code {
	/// <summary>Enlace opcional «Inicio» (p. ej. /submenu/engineer en Sapphire).</summary>
	[Parameter]
	public string? HomeHref { get; set; } = "/";

	/// <summary>
	/// Si true, el workspace usa 100vh (host a pantalla completa, p. ej. Diamond.Web).
	/// Si false (defecto), rellena el contenedor padre (Zafiro main-content).
	/// </summary>
	[Parameter]
	public bool FillViewport { get; set; }

	/// <summary>
	/// Host (p. ej. Sapphire) implementa la subida al servidor.
	/// Argumentos: (xmlText, fileName) → mensaje de resultado o null si cancelado.
	/// </summary>
	[Parameter]
	public EventCallback<(string Xml, string FileName)> UploadTopoAsync { get; set; }

	/// <summary>
	/// Resolvedor de <c>include</c> del host (almacén Zafiro). Si es null, se usa
	/// <see cref="TopoStorage.DefaultIncludeResolver"/> y/o el disco.
	/// </summary>
	[Parameter]
	public ITopoIncludeResolver? TopoIncludeResolver { get; set; }

	/// <summary>
	/// Rutas relativas al BaseUri de la app para precargar samples (WASM wwwroot).
	/// Por defecto: Samples/Onice/toposfm227.xml y rautasfm227.xml.
	/// </summary>
	[Parameter]
	public IReadOnlyList<string>? SampleTopoUrls { get; set; }

