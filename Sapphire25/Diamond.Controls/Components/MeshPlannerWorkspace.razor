			? "Descargado: " + mvarFileName + "."
			: "Guardado: " + mvarFileName + ".";
	}

	public async ValueTask DisposeAsync()
	{
		mvarDisposed = true;
		mvarEditorReady = false;

		mvarNowTimer?.Dispose();
		mvarNowTimer = null;

		mvarLayoutCts?.Cancel();
		mvarLayoutCts?.Dispose();
		mvarLayoutCts = null;

		mvarFullRenderCts?.Cancel();
		mvarFullRenderCts?.Dispose();
		mvarFullRenderCts = null;

		if (mvarWheelAttached)
		{
			try
			{
				if (!string.IsNullOrEmpty(mvarHost.Id))
				{
					await Js.InvokeVoidAsync("diamondMeshViewport.detach", mvarHost);
				}
			}
			catch (Exception ex) when (IsBenignInteropException(ex))
			{
			}
			catch
			{
			}

			mvarWheelAttached = false;
		}

		try
		{
			mvarDotNetRef?.Dispose();
		}
		catch
		{
		}

		mvarDotNetRef = null;
		await Task.CompletedTask;
	}

	[JSInvokable]
	public Task OnWheelFromJs(double deltaY, double svgX, double svgY)
	{
		if (mvarDisposed)
		{
			return Task.CompletedTask;
		}

		try
		{
			double factor = deltaY < 0 ? ZoomStep : 1.0 / ZoomStep;
			ZoomAtScreen(svgX, svgY, factor, interactive: true);
			ScheduleFullRenderAfterIdle();
			return InvokeAsync(StateHasChanged);
		}
		catch (Exception ex) when (IsBenignInteropException(ex))
		{
			return Task.CompletedTask;
		}
	}

