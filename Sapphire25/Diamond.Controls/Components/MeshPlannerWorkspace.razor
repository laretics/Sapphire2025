	protected override async Task OnInitializedAsync()
	{
		if (string.IsNullOrWhiteSpace(mvarScript))
		{
			mvarScript = DemoMeshService.SfmT3DemandScript;
		}

		mvarBaselineScript = mvarScript;
		mvarFileName = "sfm-t3-lab.ddm";
		mvarDirty = false;

		try
		{
			await EnsureTopoAvailableAsync();
		}
		catch (Exception ex)
		{
			mvarError = FormatException("Al preparar topología", ex);
		}

		if (StoreEnabled
			&& InitialStorePlanId.HasValue
			&& !Guid.Empty.Equals(InitialStorePlanId.Value)
			&& !mvarInitialPlanLoaded)
		{
			mvarInitialPlanLoaded = true;
			await StoreOpenPlanAsync(InitialStorePlanId.Value);
			return;
		}

		if (DemoMeshService.HasUsableTopo())
		{
			RebuildCore();
		}
		else
		{
			mvarStatus = StoreEnabled
				? "Sin topología en sesión. Abra un plan del almacén o cargue un XML (Topo…)."
				: "Sin topología. Use «Topo…» para cargar un XML o deje Samples/Onice en wwwroot.";
			mvarError = "No hay topología cargada. En Blazor WASM el disco no está disponible: "
				+ "cargue toposfm227.xml con «Topo…» o verifique wwwroot/Samples/Onice/.";
		}
	}

	/// <summary>
	/// Disco (server) o HTTP (wwwroot) o catálogo en memoria.
	/// </summary>
	private async Task EnsureTopoAvailableAsync()
	{
		if (DemoMeshService.HasUsableTopo())
		{
			if (string.IsNullOrEmpty(mvarTopoLabel) && DemoMeshService.TryResolveSamplePath(DemoMeshService.DefaultTopoFileName, out string? p) && p is not null)
			{
				mvarTopoLabel = Path.GetFileName(p);
			}

			return;
		}

		// WASM / host: descargar samples publicados en wwwroot.
		IReadOnlyList<string> urls = SampleTopoUrls
			?? new[]
			{
				"Samples/Onice/" + DemoMeshService.DefaultTopoFileName,
				"Samples/Onice/" + DemoMeshService.DefaultRautaFileName
			};

		using HttpClient http = new HttpClient { BaseAddress = new Uri(Nav.BaseUri) };
		foreach (string relative in urls)
		{
			if (string.IsNullOrWhiteSpace(relative))
			{
				continue;
			}

			string name = Path.GetFileName(relative.Replace('\\', '/'));
			if (!name.EndsWith(".xml", StringComparison.OrdinalIgnoreCase))
			{
				continue;
			}

			// Solo registrar topología (layout); rauta se usa aparte en ImportRauta.
			bool isTopo = name.Contains("topo", StringComparison.OrdinalIgnoreCase)
				|| string.Equals(name, DemoMeshService.DefaultTopoFileName, StringComparison.OrdinalIgnoreCase);
			if (!isTopo)
			{
				continue;
			}

			try
			{
				string xml = await http.GetStringAsync(relative.TrimStart('/'));
				if (string.IsNullOrWhiteSpace(xml))
				{
					continue;
				}

				DemoMeshService.RegisterTopoXml(name, xml);
				mvarTopoXmlText = xml;
				mvarTopoLabel = name;
				mvarStatus = "Topología demo cargada desde " + relative + ".";
				return;
			}
			catch (Exception ex)
			{
				// Probar siguiente URL; el último error se anota si no hay ninguna.
				mvarError = FormatException("HTTP " + relative, ex);
			}
		}
	}

	private static string FormatException(string context, Exception ex)
	{
		// Evita diálogos "Mensaje vacío": incluye tipo + inners.
		List<string> parts = new List<string>();
		parts.Add(context + ":");
		Exception? cur = ex;
		int depth = 0;
		while (cur is not null && depth < 5)
		{
			string msg = string.IsNullOrWhiteSpace(cur.Message) ? "(sin mensaje)" : cur.Message.Trim();
			parts.Add("[" + cur.GetType().Name + "] " + msg);
			cur = cur.InnerException;
			depth++;
		}

		return string.Join(" → ", parts);
	}

	/// <summary>
	/// Excepciones de interop/circuito que no deben tumbar la página.
	/// Nota: JSDisconnectedException hereda de InvalidOperationException.
	/// </summary>
	private static bool IsBenignInteropException(Exception ex)
	{
		if (ex is JSException
			|| ex is ObjectDisposedException
			|| ex is TaskCanceledException
			|| ex is OperationCanceledException)
		{
			return true;
		}

		// Solo las InvalidOperation típicas de interop/dispose, no cualquier IOE.
		if (ex is InvalidOperationException)
		{
			string m = ex.Message ?? string.Empty;
			return m.Contains("JavaScript interop", StringComparison.OrdinalIgnoreCase)
				|| m.Contains("JS interop", StringComparison.OrdinalIgnoreCase)
				|| m.Contains("circuit has disconnected", StringComparison.OrdinalIgnoreCase)
				|| m.Contains("ElementReference", StringComparison.OrdinalIgnoreCase)
				|| m.Contains("prerender", StringComparison.OrdinalIgnoreCase)
				|| m.Contains("Couldn't find the editor", StringComparison.OrdinalIgnoreCase)
				|| m.Contains("editors.length", StringComparison.OrdinalIgnoreCase)
				|| m.Length == 0; // VS a veces muestra IOE vacía en WASM
		}

		// Blazor WASM a veces envuelve el throw string de jsInterop en Exception genérica.
		string full = ex.Message ?? string.Empty;
		if (full.Contains("Couldn't find the editor", StringComparison.OrdinalIgnoreCase)
			|| full.Contains("editors.length", StringComparison.OrdinalIgnoreCase))
		{
			return true;
		}

		return false;
	}

	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		if (mvarDisposed)
		{
			return;
		}

		if (firstRender)
		{
			mvarJsReady = true;
			try
			{
				await ProbeDiamondScriptsAsync();
				await WaitForMonacoReadyAsync();
			}
			catch (Exception ex) when (IsBenignInteropException(ex))
			{
				mvarStatus = FormatException("Interop JS (arranque)", ex);
			}

			if (mvarDisposed)
			{
				return;
			}

			if (!mvarMountEditor)
			{
				// Montar editor aunque Monaco vaya justos: el usuario ve el panel;
				// si falla el lenguaje, el editor sigue usable en modo texto.
				if (!mvarMonacoLanguageReady)
				{
					mvarStatus = (mvarStatus ?? string.Empty)
						+ " Monaco no listo aún; recargue con Ctrl+F5 si el editor falla.";
				}

				mvarMountEditor = true;
				await InvokeAsync(StateHasChanged);
				return;
			}
		}

		if (mvarJsReady && !mvarSplitAttached)
		{
			try
			{
				await Js.InvokeAsync<bool>("diamondSplit.attach", mvarSplitRoot, mvarSplitGutter);
				mvarSplitAttached = true;
				// No layout aquí: el editor BlazorMonaco aún puede no estar en el registro
				// (editors.length === 0). OnScriptEditorInit / deferred layouts lo harán.
			}
			catch (Exception ex) when (IsBenignInteropException(ex))
			{
				mvarStatus = "Split de paneles no disponible (JS). " + FormatException("diamondSplit", ex);
			}
		}

		if (mvarJsReady && mvarEditorReady && mvarMarkersDirty && mvarScriptEditor is not null)
		{
			await FlushMarkersToEditorAsync();
		}

		// La rueda del plot la gestiona MeshDiagram (Diamond.Controls).
	}

	/// <summary>Comprueba que los scripts de Diamond estén en window (evita Invoke a undefined).</summary>
	private async Task ProbeDiamondScriptsAsync()
	{
		try
		{
			DiamondReadyProbe? probe = await Js.InvokeAsync<DiamondReadyProbe?>("diamondReady.check");
			if (probe is null)
			{
				mvarStatus = "Scripts Diamond no respondieron (diamondReady). ¿404 en _content/Diamond.Controls/js/?";
				return;
			}

			List<string> missing = new List<string>();
			if (!probe.diamondMonaco) missing.Add("diamondMonaco");
			if (!probe.diamondSplit) missing.Add("diamondSplit");
			if (!probe.diamondFile) missing.Add("diamondFile");
			if (!probe.meshViewport) missing.Add("meshViewport");
			if (!probe.monaco) missing.Add("monaco");

			if (missing.Count > 0)
			{
				mvarStatus = "JS incompleto: falta " + string.Join(", ", missing)
					+ ". Recargue Ctrl+F5; en Red compruebe _content/Diamond.Controls/js/ y BlazorMonaco.";
			}
		}
		catch (Exception ex) when (IsBenignInteropException(ex))
		{
			mvarStatus = FormatException(
				"No se pudo comprobar diamondReady (¿scripts Diamond/Monaco cargados en index.html?)",
				ex);
		}
	}

	private sealed class DiamondReadyProbe
	{
		public bool monaco { get; set; }
		public bool require { get; set; }
		public bool diamondMonaco { get; set; }
		public bool diamondSplit { get; set; }
		public bool diamondFile { get; set; }
		public bool meshViewport { get; set; }
	}

	private async Task WaitForMonacoReadyAsync()
	{
		int attempt = 0;
		while (!mvarDisposed && attempt < 60)
		{
			await EnsureMonacoLanguageAsync();
			if (mvarMonacoLanguageReady)
			{
				return;
			}

			attempt++;
			try
			{
				await Task.Delay(50);
			}
			catch (TaskCanceledException)
			{
				return;
			}
		}
	}

