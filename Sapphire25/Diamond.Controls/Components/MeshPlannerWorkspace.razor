	private static string FormatClockWithSeconds(TimeSpan ts)
	{
		int h = (int)ts.TotalHours;
		if (h < 0)
		{
			h = 0;
		}

		int m = ts.Minutes;
		if (m < 0)
		{
			m = 0;
		}

		int s = ts.Seconds;
		if (s < 0)
		{
			s = 0;
		}

		return h.ToString("00", CultureInfo.InvariantCulture)
			+ ":" + m.ToString("00", CultureInfo.InvariantCulture)
			+ ":" + s.ToString("00", CultureInfo.InvariantCulture);
	}

	/// <summary>
	/// Tras pan/zoom con rueda: render completo cuando deja de haber eventos (~120 ms).
	/// </summary>
	private void ScheduleFullRenderAfterIdle()
	{
		mvarFullRenderCts?.Cancel();
		mvarFullRenderCts?.Dispose();
		CancellationTokenSource cts = new CancellationTokenSource();
		mvarFullRenderCts = cts;
		CancellationToken token = cts.Token;
		_ = RestoreFullSvgAfterDelayAsync(token);
	}

	private async Task RestoreFullSvgAfterDelayAsync(CancellationToken token)
	{
		try
		{
			await Task.Delay(120, token);
			if (token.IsCancellationRequested || mvarDisposed || !mvarSvgIsInteractive)
			{
				return;
			}

			await InvokeAsync(() =>
			{
				if (!token.IsCancellationRequested && !mvarDisposed && mvarSvgIsInteractive)
				{
					RefreshSvg(interactive: false);
					StateHasChanged();
				}
			});
		}
		catch (Exception ex) when (IsBenignInteropException(ex))
		{
		}
	}

