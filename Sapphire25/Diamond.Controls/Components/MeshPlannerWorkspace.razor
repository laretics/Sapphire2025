			Value = string.IsNullOrEmpty(mvarScript) ? DemoMeshService.SfmT3DemandScript : mvarScript,
			Minimap = new EditorMinimapOptions { Enabled = false },
			FontSize = 13,
			LineNumbers = "on",
			WordWrap = "on",
			ScrollBeyondLastLine = false,
			RenderLineHighlight = "line",
			TabSize = 2,
			InsertSpaces = true
		};
	}

	private async Task EnsureMonacoLanguageAsync()
	{
		if (mvarMonacoLanguageReady || !mvarJsReady || mvarDisposed)
		{
			return;
		}

		try
		{
			bool ok = await Js.InvokeAsync<bool>("diamondMonaco.ensureLanguageAsync");
			if (ok)
			{
				mvarMonacoLanguageReady = true;
				return;
			}
		}
		catch (Exception ex) when (IsBenignInteropException(ex))
		{
		}

		if (mvarMonacoLanguageReady || mvarDisposed)
		{
			return;
		}

		try
		{
			bool ok = await Js.InvokeAsync<bool>("diamondMonaco.ensure");
			if (ok)
			{
				mvarMonacoLanguageReady = true;
			}
		}
		catch (Exception ex) when (IsBenignInteropException(ex))
		{
		}
	}

	/// <summary>
	/// Layout seguro: nunca llama a <c>StandaloneCodeEditor.Layout()</c> (BlazorMonaco
	/// lanza si el id no está en <c>window.blazorMonaco.editors</c>). Solo usa
	/// <c>diamondMonaco.layout</c>, que consulta el registro en modo silent.
	/// </summary>
	private async Task RelayoutMonacoAsync()
	{
		if (!mvarJsReady || mvarDisposed || !mvarEditorReady)
		{
			return;
		}

		try
		{
			// Comprobar en JS que el holder existe; si no, no forzar.
			bool ready = await Js.InvokeAsync<bool>("diamondMonaco.isEditorReady", ScriptEditorId);
			if (!ready)
			{
				return;
			}

			await Js.InvokeAsync<bool>("diamondMonaco.layout", ScriptEditorId);
			await Js.InvokeAsync<bool>("diamondMonaco.watchLayout", ScriptEditorId);
		}
		catch (Exception ex) when (IsBenignInteropException(ex))
		{
		}
	}

	private async Task OnScriptEditorInit()
	{
		if (mvarDisposed)
		{
			return;
		}

		// OnDidInit de BlazorMonaco se dispara cuando el editor YA está en el registro JS.
		mvarEditorReady = true;

		await EnsureMonacoLanguageAsync();
		if (mvarDisposed)
		{
			return;
		}

		try
		{
			await Js.InvokeAsync<bool>("diamondMonaco.applyToEditor", ScriptEditorId);
			await Global.SetTheme(Js, "diamond-dark");
		}
		catch (Exception ex) when (IsBenignInteropException(ex))
		{
		}

		if (mvarScriptEditor is null || mvarDisposed)
		{
			return;
		}

		try
		{
			await mvarScriptEditor.UpdateOptions(new EditorUpdateOptions
			{
				// AutomaticLayout cubre redimensionados del host; no hace falta Layout() ruidoso.
				AutomaticLayout = true
			});

			if (!string.IsNullOrEmpty(mvarScript))
			{
				await mvarScriptEditor.SetValue(mvarScript);
			}

			// Solo layout silencioso de Diamond (nunca blazorMonaco.editor.layout).
			await RelayoutMonacoAsync();
			ScheduleDeferredLayouts();
		}
		catch (Exception ex) when (IsBenignInteropException(ex))
		{
		}

		if (mcolCompileErrors.Count > 0 || mvarMarkersDirty)
		{
			await FlushMarkersToEditorAsync();
		}
	}

	private void ScheduleDeferredLayouts()
	{
		mvarLayoutCts?.Cancel();
		mvarLayoutCts?.Dispose();
		CancellationTokenSource cts = new CancellationTokenSource();
		mvarLayoutCts = cts;
		_ = RunDeferredLayoutsAsync(cts.Token);
	}

	private async Task RunDeferredLayoutsAsync(CancellationToken token)
	{
		try
		{
			int[] delaysMs = new[] { 50, 150, 400 };
			int i = 0;
			while (i < delaysMs.Length)
			{
				try
				{
					await Task.Delay(delaysMs[i], token);
				}
				catch (TaskCanceledException)
				{
					return;
				}

				if (token.IsCancellationRequested || mvarDisposed || !mvarEditorReady)
				{
					return;
				}

				await InvokeAsync(async () =>
				{
					if (!token.IsCancellationRequested && !mvarDisposed && mvarEditorReady)
					{
						await RelayoutMonacoAsync();
					}
				});
				i++;
			}
		}
		catch (Exception ex) when (IsBenignInteropException(ex))
		{
		}
	}

