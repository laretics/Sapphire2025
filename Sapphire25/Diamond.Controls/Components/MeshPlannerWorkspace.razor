	private void RebuildCore()
	{
		// Limpiar siempre el estado de error del intento anterior (script + banner).
		mvarError = null;
		mvarStatus = null;
		mvarProject = null;
		mcolCompileErrors = new List<ScriptDiagnostic>();
		mvarMarkersDirty = true;

		if (string.IsNullOrWhiteSpace(mvarScript))
		{
			mvarScript = DemoMeshService.SfmT3DemandScript;
		}

		try
		{
			// Topología y cabecera (plan / notes) desde el script.
			Plan plan = new Plan();
			// Disco si existe; vacío en WASM (el include usa catálogo en memoria / almacén).
			plan.ScriptBaseDirectory = DemoMeshService.GetScriptBaseDirectory();
			// Almacén Zafiro (u otro host) para include por nombre.
			plan.IncludeResolver = TopoIncludeResolver ?? TopoStorage.DefaultIncludeResolver;
			plan.EnsureDefaultTrainSpecs();
			plan.DemandScript = mvarScript;

			DemandCompileResult compiled = plan.CompileDemand();
			if (!compiled.Success)
			{
				mcolCompileErrors = BuildDiagnosticsFromCompile(compiled);
				mvarError = "El script no compila (" + mcolCompileErrors.Count.ToString(CultureInfo.InvariantCulture)
					+ " error(es)). El dibujo anterior se conserva pero ya no es la malla actual.";
				// La malla en pantalla queda desactualizada: no mostrar sus errores/warnings como vigentes.
				mvarMeshStale = mvarMesh is not null;
				mvarProject = null;
				return;
			}

			if (plan.Topo is null)
			{
				// Compat: scripts sin include siguen usando el sample demo.
				plan.Topo = DemoMeshService.LoadTopoWithInfrastructure();
				compiled = plan.CompileDemand(mvarScript);
				if (!compiled.Success)
				{
					mcolCompileErrors = BuildDiagnosticsFromCompile(compiled);
					mvarError = "El script no compila tras cargar topología por defecto ("
						+ mcolCompileErrors.Count.ToString(CultureInfo.InvariantCulture) + " error(es)).";
					mvarMeshStale = mvarMesh is not null;
					mvarProject = null;
					return;
				}
			}
			else
			{
				// Infraestructura demo (cantones SFM) sobre la topo del include.
				SfmDemoInfrastructure.Apply(plan.Topo);
			}

			// Si el script no trae plan "…", usar nombre de archivo o demo.
			if (string.IsNullOrWhiteSpace(plan.Name))
			{
				string fromFile = Path.GetFileNameWithoutExtension(mvarFileName);
				if (!string.IsNullOrWhiteSpace(fromFile)
					&& !string.Equals(fromFile, "sin título", StringComparison.OrdinalIgnoreCase)
					&& !string.Equals(fromFile, "sin titulo", StringComparison.OrdinalIgnoreCase))
				{
					plan.Name = fromFile;
				}
				else
				{
					plan.Name = "SFM demo";
				}
			}

			TopoLayout topo = plan.Topo;
			IReadOnlyList<MeshRouteView> views = DemoMeshService.BuildDemoViews(topo);
			mcolViews = new List<MeshRouteView>(views);

			mcolCompileErrors = new List<ScriptDiagnostic>();

			Diamond.Timed.Mesh mesh = new MeshPlanner(plan).Solve(mvarSelectedDay);
			mvarPlan = plan;
			mvarMesh = mesh;
			mvarSelectedCirculation = null;
			mvarMeshStale = false;

			// Preferir la vista de catálogo que mejor cubre las asimilaciones de la malla
			// (p. ej. PMI–SPB → T3+T2; solo T3 → T3). Si la vista elegida es un mal
			// encaje (trenes T3 en T3+T2: solo se ve Palma–Enllaç), se cambia.
			mvarView = PreferViewForMesh(mesh, mcolViews, mvarSelectedViewId);
			if (mvarView is not null)
			{
				mvarSelectedViewId = mvarView.Id;
			}

			InitAxisBounds();
			ResetViewWindow();
			RefreshSvg();

			if (!mesh.Success)
			{
				mvarError = "Malla generada con "
					+ mesh.Errors.Count.ToString(CultureInfo.InvariantCulture)
					+ " error(es) de planificación.";
				mvarInspectTab = InspectTab.Errors;
			}
			else
			{
				// Planificación limpia: no dejar colgado el banner ni la pestaña de errores previos.
				mvarError = null;
				if (mvarInspectTab == InspectTab.Errors)
				{
					mvarInspectTab = InspectTab.Warnings;
				}
			}
		}
		catch (Exception ex)
		{
			string detail = FormatException("Planificar malla", ex);
			mvarError = detail;
			mcolCompileErrors = new List<ScriptDiagnostic>
			{
				new ScriptDiagnostic { Line = 0, Message = detail, Severity = "error" }
			};
			// Fallo de infraestructura: la malla anterior deja de considerarse actual.
			mvarMeshStale = mvarMesh is not null;
		}
	}

