	private async Task SaveMeshBinaryAsync()
	{
		try
		{
			ExploitationPlan plan;
			TopoLayout? topo = mvarPlan?.Topo;

			if (mvarPlan is not null)
			{
				// Plan de explotación: resolver los 7 días (el día del UI no limita el archivo).
				mvarStatus = "Planificando los 7 días…";
				StateHasChanged();
				plan = await Task.Run(() => ExploitationPlan.BuildFromPlan(
					mvarPlan,
					mvarValidityStart,
					mvarPlan.Name.Length > 0 ? mvarPlan.Name : Path.GetFileNameWithoutExtension(mvarFileName),
					mvarScript));
			}
			else if (mvarExploitationPlan is not null)
			{
				plan = mvarExploitationPlan;
				plan.ValidityStart = mvarValidityStart ?? plan.ValidityStart;
			}
			else if (mvarMesh is not null)
			{
				plan = new ExploitationPlan();
				plan.PlanName = Path.GetFileNameWithoutExtension(mvarFileName);
				plan.SourceScript = mvarScript;
				plan.ValidityStart = mvarValidityStart;
				plan.SetMesh(mvarSelectedDay, mvarMesh);
			}
			else
			{
				mvarStatus = "No hay plan ni malla para exportar.";
				return;
			}

			await using MemoryStream ms = new MemoryStream();
			MeshBinarySerializer.Save(plan, ms, topo);
			byte[] bytes = ms.ToArray();

			string suggested = Path.GetFileNameWithoutExtension(mvarFileName);
			if (string.IsNullOrEmpty(suggested))
			{
				suggested = "plan-explotacion";
			}

			suggested += MeshBinarySerializer.FileExtension;
			await Js.InvokeAsync<object?>("diamondFile.saveBinary", bytes, suggested);

			mvarExploitationPlan = plan;
			mvarValidityStart = plan.ValidityStart;
			mvarStatus = "Plan de explotación exportado: " + suggested
				+ " · " + plan.Days.Count.ToString(CultureInfo.InvariantCulture) + " día(s)"
				+ " · " + plan.TotalCirculationCount.ToString(CultureInfo.InvariantCulture) + " circ. total"
				+ (plan.ValidityStart.HasValue
					? " · vigencia " + plan.ValidityStart.Value.ToString("dd/MM/yyyy", CultureInfo.InvariantCulture)
					: string.Empty)
				+ ".";
			mvarError = null;
		}
		catch (Exception ex)
		{
			mvarError = "Error al exportar plan: " + ex.Message;
		}
	}

	private async Task OpenMeshBinaryAsync()
	{
		try
		{
			BinaryFileResult? file = await Js.InvokeAsync<BinaryFileResult?>("diamondFile.openBinary", ".dmesh");
			if (file is null || string.IsNullOrEmpty(file.base64))
			{
				mvarStatus = "Apertura de plan cancelada.";
				return;
			}

			TopoLayout? topo = mvarPlan?.Topo;
			if (topo is null)
			{
				try
				{
					topo = DemoMeshService.LoadTopoWithInfrastructure();
				}
				catch (Exception ex)
				{
					mvarError = "Se necesita topología para abrir el plan: " + ex.Message;
					return;
				}
			}

			byte[] bytes = Convert.FromBase64String(file.base64);
			await using MemoryStream ms = new MemoryStream(bytes);
			MeshBinarySerializer.LoadResult loaded = MeshBinarySerializer.Load(ms, topo);

			mvarExploitationPlan = loaded.Plan;
			mvarValidityStart = loaded.Plan.ValidityStart;
			mvarMeshStale = false;
			mvarProject = null;
			mvarSelectedCirculation = null;

			// Filtro de día: el seleccionado si existe en el plan; si no, el primero disponible.
			DayOfWeek day = mvarSelectedDay;
			if (!loaded.Plan.HasDay(day))
			{
				foreach (DayOfWeek d in loaded.Plan.Days)
				{
					day = d;
					break;
				}
			}

			mvarSelectedDay = day;
			ApplyExploitationDayFilter(day);

			string vig = loaded.ValidityStart.HasValue
				? " · vigencia " + loaded.ValidityStart.Value.ToString("dd/MM/yyyy", CultureInfo.InvariantCulture)
				: string.Empty;
			mvarStatus = "Plan de explotación: " + (file.name ?? "plan.dmesh")
				+ " · " + loaded.Plan.Days.Count.ToString(CultureInfo.InvariantCulture) + " día(s)"
				+ " · filtro " + DayLabel(day)
				+ " · " + (mvarMesh?.Circulations.Count ?? 0).ToString(CultureInfo.InvariantCulture) + " circ. hoy"
				+ vig
				+ (loaded.Notes.Count > 0 ? " · " + loaded.Notes[0] : string.Empty);
			mvarError = null;
			StateHasChanged();
		}
		catch (Exception ex)
		{
			mvarError = "Error al abrir plan: " + ex.Message;
		}
	}

	/// <summary>Aplica el filtro de día sobre el plan de explotación cargado.</summary>
	private void ApplyExploitationDayFilter(DayOfWeek day)
	{
		if (mvarExploitationPlan is null)
		{
			return;
		}

		Mesh? dayMesh = mvarExploitationPlan.GetMesh(day);
		mvarMesh = dayMesh;
		mvarSelectedCirculation = null;
		mvarMeshStale = false;

		if (mvarMesh is not null && mvarMesh.Asimilations.Count > 0)
		{
			mvarView = mvarMesh.Asimilations[0].View;
		}
		else if (mvarPlan?.Topo is not null)
		{
			IReadOnlyList<MeshRouteView> views = DemoMeshService.BuildDemoViews(mvarPlan.Topo);
			mvarView = views.Count > 0 ? views[0] : mvarView;
		}

		mvarStatus = "Filtro " + DayLabel(day)
			+ (mvarMesh is null
				? " · sin malla ese día en el plan."
				: " · " + mvarMesh.Circulations.Count.ToString(CultureInfo.InvariantCulture) + " circ."
					+ (mvarExploitationPlan.ValidityStart.HasValue
						? " · vigencia " + mvarExploitationPlan.ValidityStart.Value.ToString("dd/MM/yyyy", CultureInfo.InvariantCulture)
						: string.Empty));
		StateHasChanged();
	}

