<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Diamond.Controls</RootNamespace>
    <AddRazorSupportForMvc>false</AddRazorSupportForMvc>
    <Configurations>Debug;Release;Zafiro</Configurations>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="9.0.0" />
    <PackageReference Include="BlazorMonaco" Version="3.4.0" />
    <!-- Exportación PDF libre del libro itinerario (SVG → página). -->
    <PackageReference Include="PdfSharpCore" Version="1.3.67" />
    <PackageReference Include="QRCoder" Version="1.6.0" />
    <PackageReference Include="Svg.Skia" Version="2.0.0.4" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Diamond\Diamond.csproj" />
  </ItemGroup>

  <!-- Topos/muestras para el planificador (host debe copiarlos al output si WASM). -->
  <ItemGroup>
    <Content Include="Samples\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
