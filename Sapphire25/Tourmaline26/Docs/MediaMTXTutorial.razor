    <title>Manual de Configuración - MediaMTX en Equipo de Producción</title>
    <style>
        body { font-family: Arial, sans-serif; line-height: 1.6; margin: 40px; background: #f9f9f9; color: #333; }
        h1, h2, h3 { color: #1a73e8; }
        pre { background: #f4f4f4; padding: 12px; border-radius: 6px; overflow-x: auto; }
        code { font-family: Consolas, monospace; }
        .step { margin-bottom: 30px; }
        .warning { background: #fff3cd; padding: 10px; border-left: 6px solid #ffc107; }
        table { border-collapse: collapse; width: 100%; margin: 15px 0; }
        th, td { border: 1px solid #ddd; padding: 10px; text-align: left; }
