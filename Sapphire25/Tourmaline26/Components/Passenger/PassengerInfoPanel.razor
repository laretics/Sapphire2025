@* PassengerInfoPanel.razor *@
@using Tourmaline26.Components.Passenger.Modules
@using Tourmaline26.Components.Services
@using TimeNet2026.Timed
@using TimeNet2026.Topo
@inject TourmalineService mvarTourmaline
<div @onclick="OnScreenClick">
    <CascadingValue Value="CurrentCirculation">
        <CascadingValue Value="CurrentDelay">
            @if (mvarTourmaline.SessionConfig.PASEnabled && mvarTourmaline.SessionConfig.TFTEnabled)
            {
                @if (mvarTourmaline.SessionConfig.ServiceMode && mvarTourmaline.SessionConfig.PassengerCaretOnServiceMode)
                {
                    <SettingCaret></SettingCaret>
                }
                else
                {
                    <OnRouteInfo></OnRouteInfo>
                }
            }
        </CascadingValue>
    </CascadingValue>
</div>

@code {
    [CascadingParameter]
    public DeviceMapped? Device{ get; set; }
    [CascadingParameter]
    public Action? UpdateView{ get; set; }

    private Circulation? CurrentCirculation 
    {
        get
        {
            if (null != mvarTourmaline.SessionConfig.TNEnvironment &&
            null != mvarTourmaline.SessionConfig.TNEnvironment.Circulation)
                return mvarTourmaline.SessionConfig.TNEnvironment.Circulation;

            return null;
        }
    }
    private TimeSpan CurrentDelay
    {
        get => null == mvarTourmaline.SessionConfig.TNEnvironment ? new TimeSpan(0) : mvarTourmaline.SessionConfig.TNEnvironment.CurrentDelay;
    }

    protected override void OnInitialized()
    {
        base.OnInitialized();
        mvarTourmaline.PassengerUpdateRequested += OnChangeRequest;
    }
    private void OnChangeRequest(object? sender, EventArgs e)
    {
        InvokeAsync(StateHasChanged);
    }
    public void Dispose()
    {
        mvarTourmaline.PassengerUpdateRequested -= OnChangeRequest;
    }
    private void OnScreenClick()
    {
        mvarTourmaline.SessionConfig.PassengerScreenOnHMI = false;
        UpdateView?.Invoke();
    }
}