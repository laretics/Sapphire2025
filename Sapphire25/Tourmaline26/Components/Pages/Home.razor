
@page "/"
@using Tourmaline26.Components.Controls
@using Tourmaline26.Components.Passenger
@inject Tourmaline26.Components.Services.TourmalineService TourmalineService
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
<PageTitle>Tourmaline</PageTitle>
<CascadingValue Value="@UpdateView">
@if (device is null)
{
    <h3>Dispositivo no reconocido</h3>
    <p>IP detectada: @clientIp</p>
}
else
{
    <CascadingValue Value="@device">
        @if (device.Type == Enums.DeviceType.TFT || TourmalineService.SessionConfig.PassengerScreenOnHMI)
        {        
            <PassengerInfoPanel />
        }
        else if (device.Type == Enums.DeviceType.HMI)
        {
            <CascadingValue Value=@NightMode>            
                <CascadingValue Value=@ToggleNightMode>
                    <DriverInfotaiment></DriverInfotaiment>
                </CascadingValue>
            </CascadingValue>                
        } 
    </CascadingValue>
}
</CascadingValue>

@code {
    private DeviceMapped? device;
    private string? clientIp;

    private bool NightMode { get; set; }
    private void ToggleNightMode(bool newValue)
    {
        NightMode = newValue;
        StateHasChanged();
    }
    private void UpdateView()
    {
        StateHasChanged();
    }

    protected override void OnInitialized()
    {
        // Obtener la IP del cliente
        clientIp = HttpContextAccessor.HttpContext?.Connection.RemoteIpAddress?.ToString();
        // if (!string.IsNullOrEmpty(clientIp))
        //     device = DeviceMapService.Devices[0];
        // else
            device = TourmalineService.Devices.FirstOrDefault(d => d.Address.ToString() == clientIp);
    }
}