@using Tourmaline26.Components.Images
@using Tourmaline26.Components.Layout.Passenger.Modules
@using Tourmaline26.Components.Controls
@using Tourmaline26.Components.Controls.Passenger
@using TimeNet2026.Topo
@using TimeNet2026.Timed
@using Tourmaline26.Services.OpenMeteo
@inject TourmalineService mvarTourmaline
<div class="panel-root">
    @if(null!=mvarTourmaline.SessionConfig)
    {        
        @if(InformationMode==Enums.PassengerInformationMode.Default)
        {
            <div class="panel-body centered-image-panel">
                <img class="centered-image" src="/img/81pic1.png"/>
                @* Anuncio solo sobre panel-body (no cubre cabecera; aquí no hay header). *@
                @if (ActiveAnnouncement is not null)
                {
                    <PopupInformation Info="ActiveAnnouncement" />
                }
            </div>
        }
        else
        {
            <div class="panel-header" style="height:@(HeaderSize)vh;">
                @if (mvarTourmaline.SessionConfig.InformationLevel == Enums.InformationLevel.Route &&
                null != Circulation && null != Circulation.Parent && null != Circulation.Parent.asimilation)
                {
                    <span class="train-number">
                        <ColorIcon Name="Train"
                                   Color="@Circulation.Parent.asimilation.color[0]"
                                   Size="72"
                                   Glow="false"
                                   GlowColor="@Circulation.Parent.asimilation.color[1]" />
                        @Circulation.name destinació
                    </span>
                    <span class="panel-time">@CurrentTime</span>
                    <div class="destination">
                        @Circulation.Parent.asimilation.Destination?.Name
                    </div>
                }
                else if (mvarTourmaline.SessionConfig.InformationLevel == Enums.InformationLevel.Disabled)
                {
                    <span class="train-number"></span>
                    <span class="panel-time">@CurrentTime</span>
                    <div class="destination"></div>
                }
                else
                {
                    <span class="train-number"></span>
                    <span class="panel-time">@CurrentTime</span>
                    <div class="destination">Sense servei</div>
                }
                @if (null != mvarTourmaline.SessionConfig.CurrentWeather)
                {
                    <div class="external-temperature">
                        @($"{mvarTourmaline.SessionConfig.CurrentWeather.Temperature2m}ºC")
                        <img src="@OpenMeteoClient.GetWeatherIconUrl(mvarTourmaline.SessionConfig.CurrentWeather.WeatherCode)" />
                    </div>
                }
                @if (mvarTourmaline.SessionConfig.CurrentSpeed > 40)
                {
                    <div class="current-speed">
                        @($"{mvarTourmaline.SessionConfig.CurrentSpeed}Km/h")
                    </div>
                }

            </div>

            <div class="panel-body @(IsStreamFillBody ? "panel-body-fill" : null)">
                @if (mvarTourmaline.SessionConfig.InformationLevel == Enums.InformationLevel.Route && Circulation != null)
                {
                    @if (InformationMode == Enums.PassengerInformationMode.BeginOfTrip)
                    {
                        <div class="journey-splash journey-splash--welcome">
                            <div class="journey-splash-kicker">Serveis Ferroviaris de Mallorca</div>
                            <div class="journey-splash-title">Benvinguts a bord</div>
                            <div class="journey-splash-rule" aria-hidden="true"></div>
                            <div class="journey-splash-lead">
                                Aquest tren us porta fins a
                            </div>
                            <div class="journey-splash-highlight">@DestinationName</div>
                            @if (!string.IsNullOrWhiteSpace(OriginStationName))
                            {
                                <div class="journey-splash-meta">
                                    <span class="journey-splash-meta-label">Sortida des de</span>
                                    <span class="journey-splash-meta-value">@OriginStationName</span>
                                </div>
                            }
                            @if (!string.IsNullOrWhiteSpace(TrainServiceName))
                            {
                                <div class="journey-splash-chip">@TrainServiceName</div>
                            }
                            <div class="journey-splash-footer">Bona ruta i bon viatge!</div>
                        </div>
                    }
                    else if (InformationMode == Enums.PassengerInformationMode.NextStopInfo)
                    {
                        <div class="arrival-panel">
                            <div class="arrival-label">Propera estació</div>
                            <div class="arrival-station">@(NextStationName)</div>
                            <div class="correspondences-box">
                                <div class="correspondences-title">Correspondències</div>
                                <table class="correspondences-table">
                                    <thead>
                                        <tr>
                                            <th>Línia</th>
                                            <th>Destinació</th>
                                            <th>Andana</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @* Contenido estático de prueba; se sustituirá por datos reales de transbordo. *@
                                        <tr>
                                            <td><span class="line-badge line-t1">T1</span></td>
                                            <td>Palma</td>
                                            <td>2</td>
                                        </tr>
                                        <tr>
                                            <td><span class="line-badge line-t2">T2</span></td>
                                            <td>Marratxí</td>
                                            <td>1</td>
                                        </tr>
                                        <tr>
                                            <td><span class="line-badge line-t3">T3</span></td>
                                            <td>Manacor</td>
                                            <td>3</td>
                                        </tr>
                                        <tr>
                                            <td><span class="line-badge line-bus">L30</span></td>
                                            <td>Aeroport</td>
                                            <td>—</td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    }
                    else if (InformationMode == Enums.PassengerInformationMode.Cruise)
                    {
                        <div class="cruise-stream">
                            <SimulatorStream StreamHost="@mvarTourmaline.SystemConfig.TExperienceStr" />
                        </div>
                    }
                    else if (InformationMode == Enums.PassengerInformationMode.EndOfTrip)
                    {
                        <div class="journey-splash journey-splash--farewell">
                            <div class="journey-splash-kicker">Heu arribat al destí</div>
                            <div class="journey-splash-title">Gràcies per viatjar amb noltros</div>
                            <div class="journey-splash-rule" aria-hidden="true"></div>
                            <div class="journey-splash-lead">Estació final</div>
                            <div class="journey-splash-highlight">@FinalStationName</div>
                            @if (!string.IsNullOrWhiteSpace(TrainServiceName))
                            {
                                <div class="journey-splash-chip">@TrainServiceName</div>
                            }
                            <div class="journey-splash-footer">Fins aviat · Serveis Ferroviaris de Mallorca</div>
                        </div>
                    }
                    else // Lista de paradas: paisaje TE de fondo + tabla encima.
                    {
                        <div class="route-stops-stage">
                            <div class="route-stops-bg" aria-hidden="true">
                                <SimulatorStream StreamHost="@mvarTourmaline.SystemConfig.TExperienceStr"
                                                 Blur="true" />
                                <div class="route-stops-bg-veil"></div>
                            </div>
                            <div class="route-stops-fg">
                                <StationsTable Session="@mvarTourmaline.SessionConfig"
                                               Rows="@Lines"
                                               ShowEstimatedTimes="true"
                                               OverlayOnVideo="true" />
                            </div>
                        </div>
                    }
                }

                @* Anuncio solo sobre panel-body; la cabecera (hora, destino…) sigue visible. *@
                @if (ActiveAnnouncement is not null)
                {
                    <PopupInformation Info="ActiveAnnouncement" />
                }
            </div>
        }
    }
</div>

@code {
    [CascadingParameter] public DeviceMapped? Device { get; set; }

    /// <summary>
    /// Anuncio activo desde sesión: toggle + mensaje seleccionado en FloatPassengerInformation.
    /// </summary>
    private PassengerInformation? ActiveAnnouncement
    {
        get
        {
            SessionConfiguration session = mvarTourmaline.SessionConfig;
            if (!session.PassengerAnnouncementEnabled)
                return null;
            if(null!= session.PassengerAnnouncement)
                session.PassengerAnnouncement.LanguageIndex = session.PassengerAnnouncementLanguage;

            return session.PassengerAnnouncement;
        }
    }

    private TimeSpan CurrentDelay
    {
        get
        {
            if(null!=mvarTourmaline.SessionConfig.TNEnvironment)
                return mvarTourmaline.SessionConfig.TNEnvironment.CurrentDelay;

            return new TimeSpan(0);
        }
    }

    private Circulation? Circulation
    {
        get
        {
            if(null!=mvarTourmaline.SessionConfig.TNEnvironment)
                return mvarTourmaline.SessionConfig.TNEnvironment.Circulation;

            return null;
        }
    }
    private Enums.PassengerInformationMode InformationMode  {get => mvarTourmaline.SessionConfig.InformationMode;}

    /// <summary>Cuerpo a pantalla completa (sin padding gris) para stream o lista sobre vídeo.</summary>
    private bool IsStreamFillBody =>
        InformationMode is Enums.PassengerInformationMode.Cruise
            or Enums.PassengerInformationMode.NextStopsList;

    private string CurrentTime => mvarTourmaline.SessionConfig.TNEnvironment?.Now.ToString("HH:mm") ?? "";
    private int Lines => (null==Device)?7:Device.Lines;
    private int HeaderSize => (null == Device) ? 100 : Device.HeaderSize;

    /// <summary>Estación de llegada / parada actual (modo Arriv).</summary>
    private string NextStationName =>
        mvarTourmaline.SessionConfig.TNEnvironment?.CurrentStation?.Name
        ?? Circulation?.Parent?.asimilation?.Destination?.Name
        ?? "—";

    /// <summary>Destino final del trayecto (modo End / bienvenida).</summary>
    private string FinalStationName =>
        mvarTourmaline.SessionConfig.TNEnvironment?.CurrentStation?.Name
        ?? DestinationName
        ?? string.Empty;

    private string DestinationName =>
        mvarTourmaline.SessionConfig.TNEnvironment?.Asimilation?.Destination?.Name
        ?? Circulation?.Parent?.asimilation?.Destination?.Name
        ?? "—";

    private string OriginStationName =>
        mvarTourmaline.SessionConfig.TNEnvironment?.CurrentStation?.Name
        ?? mvarTourmaline.SessionConfig.TNEnvironment?.Asimilation?.Origin?.Name
        ?? Circulation?.Parent?.asimilation?.Origin?.Name
        ?? string.Empty;

    private string TrainServiceName
    {
        get
        {
            if (null == Circulation)
                return string.Empty;
            string name = Circulation.name?.Trim() ?? string.Empty;
            return string.IsNullOrEmpty(name) ? string.Empty : $"Tren {name}";
        }
    }
    private void OnChangeRequest(object? sender, EventArgs e)
    {
        InvokeAsync(StateHasChanged);
    }
    protected override void OnInitialized()
    {
        base.OnInitialized();
        mvarTourmaline.PassengerUpdateRequested += OnChangeRequest;
    }
    public void Dispose()
    {
        mvarTourmaline.PassengerUpdateRequested -= OnChangeRequest;
    }
}