@* PassengerInfoPanel.razor *@
@using Tourmaline26.Components.Layout.Passenger.Modules
@inject TourmalineService mvarTourmaline
<div @onclick="OnScreenClick">
    @if (mvarTourmaline.SessionConfig.MainSwitches.TFTEnabled)
    {
        @if (mvarTourmaline.SessionConfig.ServiceMode.PassengerCaretOnServiceMode)
        {
            <SettingCaret></SettingCaret>
        }
        else if (mvarTourmaline.SessionConfig.MainSwitches.PASEnabled)
        {
            <OnRouteInfo></OnRouteInfo>
        }
        else
        {
            <div class="tft-blackout"></div>
        }
    }
    else
    {
        <div class="tft-blackout"></div>
    }
</div>

@code {
    [CascadingParameter]
    public DeviceMapped? Device{ get; set; }
    [CascadingParameter]
    public Action? UpdateView{ get; set; }

    private Diamond.Project.Circulation? CurrentCirculation
    {
        get
        {
            if (null != mvarTourmaline.SessionConfig.Cabin &&
            null != mvarTourmaline.SessionConfig.Cabin.Circulation)
                return mvarTourmaline.SessionConfig.Cabin.Circulation;

            return null;
        }
    }
    private TimeSpan CurrentDelay
    {
        get => null == mvarTourmaline.SessionConfig.Cabin ? new TimeSpan(0) : mvarTourmaline.SessionConfig.Cabin.CurrentDelay;
    }

    protected override void OnInitialized()
    {
        base.OnInitialized();
        mvarTourmaline.PassengerUpdateRequested += OnChangeRequest;
    }
    private void OnChangeRequest(object? sender, EventArgs e)
    {
        InvokeAsync(StateHasChanged);
    }
    public void Dispose()
    {
        mvarTourmaline.PassengerUpdateRequested -= OnChangeRequest;
    }
    private void OnScreenClick()
    {
        mvarTourmaline.SessionConfig.ServiceMode.PassengerScreenOnHMI = false;
        UpdateView?.Invoke();
    }
}