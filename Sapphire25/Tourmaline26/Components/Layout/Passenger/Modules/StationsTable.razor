@using Diamond.Cabin
@using Tourmaline26.Services.Catalog
@using ProjectCirculation = Diamond.Project.Circulation
@using ProjectStationInfo = Diamond.Project.StationInfo
@using ProjectTimedCall = Diamond.Project.TimedCall
@inject PlacesCatalog Places
<div class="route-box @(OverlayOnVideo ? "route-box--overlay" : null)">
    <div class="route-title">Pròximes aturades</div>
    <table class="route-table">
        @if (null != Circulation)
        {
            <tbody>
                @for (int index = 0; index < mcolItinerary.Length; index++)
                {
                    RowContent row = mcolItinerary[index];
                    <tr class="@RowClass(index, row)" style="@RailColorStyle">
                        @if (row.Station is not null)
                        {
                            Place? place = Places.Find(row.Station);
                            <td class="stop-rail">
                                <span class="stop-rail-line" aria-hidden="true"></span>
                                <span class="stop-dot"></span>
                            </td>
                            <td class="stop-name">@TftaName(row.Station)</td>
                            <td class="stop-corr">
                                @if (place is not null && place.HasEmtCorrespondence)
                                {
                                    <img src="/img/correspondence/EmtPalma.png"
                                         class="stop-corr-logo stop-corr-logo--emt"
                                         alt="EMT Palma"
                                         title="EMT Palma" />
                                }
                                @if (place is not null && place.HasTibCorrespondence)
                                {
                                    <img src="/img/correspondence/Tib_logo.png"
                                         class="stop-corr-logo stop-corr-logo--tib"
                                         alt="TIB"
                                         title="TIB" />
                                }
                            </td>
                            @if (ShowEstimatedTimes)
                            {
                                <td class="stop-time">
                                    @if (row.ScheduledArrival.Ticks > 0)
                                    {
                                        @FormatClock(row.ScheduledArrival)
                                    }
                                </td>
                                <td class="stop-extra">
                                    @if (Delayed && row.EstimatedArrival.Ticks > 0)
                                    {
                                        <span class="stop-eta">@FormatClock(row.EstimatedArrival)</span>
                                    }
                                    else if (DwellMinutes(row) >= 1)
                                    {
                                        <span class="stop-dwell">@DwellMinutes(row)<span class="stop-dwell-unit">min</span></span>
                                    }
                                </td>
                            }
                        }
                        else
                        {
                            <td class="stop-rail">
                                <span class="stop-rail-line stop-rail-line--gap" aria-hidden="true"></span>
                                <span class="stop-dot stop-dot--gap"></span>
                            </td>
                            <td class="stop-name stop-name--gap">···</td>
                            <td class="stop-corr"></td>
                            @if (ShowEstimatedTimes)
                            {
                                <td class="stop-time"></td>
                                <td class="stop-extra"></td>
                            }
                        }
                    </tr>
                }
            </tbody>
        }
    </table>
</div>
@code {
    [Parameter]
    public SessionConfiguration? Session { get; set; }
    [Parameter]
    public int Rows { get; set; } = 4;
    [Parameter]
    public bool ShowEstimatedTimes { get; set; }

    [Parameter]
    public bool OverlayOnVideo { get; set; }

    private RowContent[] mcolItinerary = Array.Empty<RowContent>();

    private ProjectCirculation? Circulation
    {
        get
        {
            if (null != Session && null != Session.Cabin)
                return Session.Cabin.Circulation;
            return null;
        }
    }

    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        auxRecalculateDestinations();
    }

    private void auxRecalculateDestinations()
    {
        mcolItinerary = Array.Empty<RowContent>();
        if (null == Session || null == Session.Cabin || null == Circulation)
            return;

        CabinEnvironment cabin = Session.Cabin;
        TimeSpan delay = cabin.CurrentDelay.Ticks > 0 ? cabin.CurrentDelay : TimeSpan.Zero;

        IReadOnlyList<ProjectTimedCall> remaining =
            CabinItinerary.RemainingCommercialCalls(Circulation, cabin.PK, includeCurrentStation: false);

        List<RowContent> auxItinerary = new List<RowContent>();
        int i = 0;
        while (i < remaining.Count)
        {
            ProjectTimedCall call = remaining[i];
            auxItinerary.Add(new RowContent
            {
                Station = call.Station,
                ScheduledArrival = call.Arrival,
                EstimatedArrival = WrapDay(call.Arrival + delay),
                Dwell = call.Dwell,
                IsDestination = call.IsDestination
            });
            i++;
        }

        if (auxItinerary.Count == 0)
            return;

        if (auxItinerary.Count <= Rows)
        {
            mcolItinerary = auxItinerary.ToArray();
            return;
        }

        List<RowContent> result = new List<RowContent>(Rows);
        result.Add(auxItinerary[0]);

        if (Rows >= 3)
        {
            int middleCount = Rows - 2;
            for (int j = 1; j <= middleCount && j < auxItinerary.Count - 1; j++)
                result.Add(auxItinerary[j]);

            result.Add(new RowContent { Separator = true });
            result.Add(auxItinerary[^1]);
        }
        else if (Rows == 2)
        {
            result.Add(auxItinerary[^1]);
        }

        mcolItinerary = result.ToArray();
    }

    private string TftaName(ProjectStationInfo? station) =>
        Places.NameFor(PlaceNameChannel.Tfta, station);

    private bool Delayed =>
        (Session?.Cabin?.CurrentDelay ?? TimeSpan.Zero).TotalMinutes >= 1;

    private string TrainAccent =>
        Circulation is not null && Circulation.HasColor
            ? Circulation.Color
            : "#1d4ed8";

    private string RailColorStyle => $"--stop-rail:{TrainAccent};--stop-dot:{TrainAccent};";

    private string RowClass(int index, RowContent row)
    {
        if (row.Separator || row.Station is null)
            return "stop-row stop-row--gap";
        bool first = index == 0;
        bool last = index == mcolItinerary.Length - 1;
        string css = "stop-row";
        if (first)
            css += " stop-row--first";
        if (last)
            css += " stop-row--last";
        if (row.IsDestination)
            css += " stop-row--dest";
        return css;
    }

    private static string FormatClock(TimeSpan time) =>
        Enums.autoInterval(time, true, false);

    private static TimeSpan WrapDay(TimeSpan value)
    {
        if (value < TimeSpan.Zero)
            value += TimeSpan.FromDays(1);
        if (value >= TimeSpan.FromDays(1))
            value -= TimeSpan.FromDays(1);
        return value;
    }

    private static int DwellMinutes(RowContent row) =>
        (int)Math.Floor(row.Dwell.TotalMinutes);

    private struct RowContent
    {
        public ProjectStationInfo? Station { get; set; }
        public TimeSpan ScheduledArrival { get; set; }
        public TimeSpan EstimatedArrival { get; set; }
        public TimeSpan Dwell { get; set; }
        public bool IsDestination { get; set; }
        public bool Separator { get; set; }
    }
}
