@using TimeNet2026.Topo
@using TimeNet2026.Timed
@using TimeNet2026.Production
<div class="route-box @(OverlayOnVideo ? "route-box--overlay" : null)">
    <div class="route-title">Pròximes aturades</div>
    <table class="route-table">
        @if (null != Circulation)
        {
            <tbody>
                @for (int index = 0; index < mcolItinerary.Length; index++)
                {
                    <tr>
                        @if (null != mcolItinerary[index].Station)
                        {
                            <td>
                                <span class="stop-dot"></span>
                            </td>
                            @if (mcolItinerary[index].Station?.ShortName == mcolItinerary[index].Station?.ShortName.ToUpper())
                            {
                                <td class="stop-name-high">@mcolItinerary[index].Station?.Name</td>
                            }
                            else
                            {
                                <td class="stop-name">@mcolItinerary[index].Station?.Name</td>
                            }
                            @if (ShowEstimatedTimes && mcolItinerary[index].Arrival.Ticks > 0)
                            {
                                <td class="stop-time">@Enums.autoInterval(mcolItinerary[index].Arrival, true, false)</td>
                            }
                        }
                        else
                        {
                            <td></td>
                            <td><p>...</p></td>
                        }
                    </tr>
                }
            </tbody>
        }
    </table>
</div>
@code {
    [Parameter]
    public SessionConfiguration? Session { get; set; }
    [Parameter]
    public int Rows { get; set; } = 4;
    [Parameter]
    public bool ShowEstimatedTimes { get; set; }

    /// <summary>
    /// Tipografía clara con sombra para legibilidad sobre vídeo de fondo.
    /// </summary>
    [Parameter]
    public bool OverlayOnVideo { get; set; }

    private RowContent[] mcolItinerary = Array.Empty<RowContent>();

    private Circulation? Circulation
    {
        get
        {
            if (null != Session && null != Session.TNEnvironment && null != Session.TNEnvironment.Circulation)
                return Session.TNEnvironment.Circulation;
            return null;
        }
    }

    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        auxRecalculateDestinations();
    }

    private void auxRecalculateDestinations()
    {
        mcolItinerary = Array.Empty<RowContent>();
        if (null == Session || null == Session.TNEnvironment || null == Circulation)
            return;

        TimeNetEnvironment enviro = Session.TNEnvironment;

        // Asimilación completa del servicio (horarios teóricos desde el origen del tren).
        Asimilation? fullRoute = enviro.Asimilation ?? Circulation.Parent?.asimilation;
        // Tramo residual desde el PK actual (solo estaciones aún por hacer).
        Asimilation? remaining = enviro.RouteAsimilation;

        if (null == fullRoute?.Origin || null == remaining?.Origin)
            return;

        TimeSpan delay = enviro.CurrentDelay.Ticks > 0 ? enviro.CurrentDelay : TimeSpan.Zero;

        // Horas de paso/llegada teóricas por estación, calculadas sobre la ruta COMPLETA.
        Dictionary<string, TimeSpan> scheduledByStationId = BuildScheduledArrivals(fullRoute, Circulation.departure, delay);

        var auxItinerary = new List<RowContent>();

        // Primera del residual = próxima (o la de origen si aún no se ha salido).
        AddIfScheduled(auxItinerary, remaining.Origin, scheduledByStationId);

        foreach (AsimilationStep paso in remaining.Steps)
        {
            if (paso.stopTime.Ticks > 0 || paso.destination == remaining.Destination)
                AddIfScheduled(auxItinerary, paso.destination, scheduledByStationId);
        }

        if (auxItinerary.Count == 0)
            return;

        // Truncado para el número de filas del panel.
        if (auxItinerary.Count <= Rows)
        {
            mcolItinerary = auxItinerary.ToArray();
            return;
        }

        var result = new List<RowContent>(Rows);
        result.Add(auxItinerary[0]);

        if (Rows >= 3)
        {
            int middleCount = Rows - 2;
            for (int i = 1; i <= middleCount && i < auxItinerary.Count - 1; i++)
                result.Add(auxItinerary[i]);

            result.Add(new RowContent { Separator = true });
            result.Add(auxItinerary[^1]);
        }
        else if (Rows == 2)
        {
            result.Add(auxItinerary[^1]);
        }

        mcolItinerary = result.ToArray();
    }

    /// <summary>
    /// Construye la hora de llegada/paso a cada parada a partir del horario de origen
    /// del tren + tiempos de trayecto/parada de la asimilación completa + retraso.
    /// </summary>
    private static Dictionary<string, TimeSpan> BuildScheduledArrivals(
        Asimilation fullRoute,
        TimeSpan tripDeparture,
        TimeSpan delay)
    {
        var map = new Dictionary<string, TimeSpan>(StringComparer.Ordinal);

        void Put(Station? station, TimeSpan when)
        {
            if (null == station || string.IsNullOrEmpty(station.Id))
                return;
            map[station.Id] = when;
        }

        // Origen del servicio: hora de salida del tren (no se reutiliza a ciegas en el residual).
        Put(fullRoute.Origin, tripDeparture + delay);

        TimeSpan cumul = tripDeparture + delay;
        foreach (AsimilationStep paso in fullRoute.Steps)
        {
            cumul += paso.tripTime;

            // Misma regla de “parada comercial” que la tabla residual.
            if (paso.stopTime.Ticks > 0 || paso.destination == fullRoute.Destination)
            {
                Put(paso.destination, cumul);
                cumul += paso.stopTime;
            }
        }

        return map;
    }

    private static void AddIfScheduled(
        List<RowContent> list,
        Station? station,
        Dictionary<string, TimeSpan> scheduledByStationId)
    {
        if (null == station)
            return;

        TimeSpan arrival = TimeSpan.Zero;
        if (!string.IsNullOrEmpty(station.Id)
            && scheduledByStationId.TryGetValue(station.Id, out TimeSpan scheduled))
        {
            arrival = scheduled;
        }

        list.Add(new RowContent
        {
            Station = station,
            Arrival = arrival
        });
    }

    private struct RowContent
    {
        public Station? Station { get; set; }
        public TimeSpan Arrival { get; set; }
        public bool Separator { get; set; }
        public bool Pointer { get; set; }
    }
}
