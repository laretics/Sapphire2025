@using TimeNet2026.Topo
@using TimeNet2026.Timed
<div class="route-box">
    <div class="route-title">Pròximes aturades</div>
    <table class="route-table">
        @if(null!=Circulation)
        {
            <tbody>
                @for (int index = 0; index<mcolItinerary.Length;index++)
                {
                    <tr>
                        @if(null!=mcolItinerary[index].Station)
                        {
                            <td>
                                <span class="stop-dot"></span>
                            </td>
                            @if(mcolItinerary[index].Station?.ShortName==mcolItinerary[index].Station?.ShortName.ToUpper())
                            {
                                <td class="stop-name-high">@mcolItinerary[index].Station?.Name</td>
                            }
                            else
                            {
                                <td class="stop-name">@mcolItinerary[index].Station?.Name</td>
                            }                            
                            @if(ShowEstimatedTimes && mcolItinerary[index].Arrival.Ticks>0)
                            {
                                <td class="stop-time">@Enums.autoInterval(mcolItinerary[index].Arrival,true,false)</td>
                            }
                        }
                        else
                        {
                            <td></td>
                            <td><p>...</p></td>
                        }
                    </tr>
                }
            </tbody>
        }
    </table>
</div>
@code {
    [CascadingParameter]
    public Circulation? Circulation{ get; set; }
    [CascadingParameter]
    public TimeSpan CurrentDelay{ get; set; }
    [CascadingParameter]
    public Station? NextStation{ get; set; }
    [Parameter]
    public int Rows { get; set; } = 4; //Número de filas que puede representar esta tabla.
    [Parameter]
    public bool ShowEstimatedTimes { get; set; } //Muestra (u oculta las horas estimadas de llegada)
    private RowContent[] mcolItinerary = new RowContent[0];

    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        auxRecalculateDestinations();
    }

    private void auxRecalculateDestinations()
    {
        mcolItinerary = Array.Empty<RowContent>();

        if (Circulation?.Parent?.asimilation?.Origin == null)
            return;

        var auxItinerary = new List<RowContent>();

        TimeSpan cumul = Circulation.departure;
        if (CurrentDelay.Ticks > 0)
            cumul += CurrentDelay;

        bool auxActive = (Circulation.Parent.asimilation.Origin == NextStation || NextStation == null);

        // Estación de origen
        if (auxActive)
        {
            auxItinerary.Add(new RowContent
            {
                Station = Circulation.Parent.asimilation.Origin,
                Arrival = cumul
            });
        }

        foreach (AsimilationStep paso in Circulation.Parent.asimilation.Steps)
        {
            cumul += paso.tripTime;

            if (paso.stopTime.Ticks > 0 || paso.destination == Circulation.Parent.asimilation.Destination)
            {
                if (paso.destination == NextStation)
                    auxActive = true;

                if (auxActive)
                {
                    auxItinerary.Add(new RowContent
                    {
                        Station = paso.destination,
                        Arrival = cumul
                    });
                }

                cumul += paso.stopTime;
            }
        }

        if (auxItinerary.Count == 0)
            return;

        // Buscar desde dónde empezar (NextStation)
        int startIndex = auxItinerary.FindIndex(r => r.Station?.Equals(NextStation) == true);
        if (startIndex == -1)
            startIndex = 0;

        var relevantStations = auxItinerary.Skip(startIndex).ToList();

        // === LÓGICA DE TRUNCADO CORREGIDA ===
        if (relevantStations.Count <= Rows)
        {
            mcolItinerary = relevantStations.ToArray();
        }
        else
        {
            var result = new List<RowContent>(Rows);

            // 1. Primera estación = NextStation
            result.Add(relevantStations[0]);

            if (Rows >= 3)
            {
                // Añadimos estaciones intermedias (las que quepan entre la primera y el separador)
                int middleCount = Rows - 2;

                // Cogemos desde la segunda estación hasta donde quepa
                for (int i = 1; i <= middleCount && i < relevantStations.Count - 1; i++)
                {
                    result.Add(relevantStations[i]);
                }

                // Penúltimo: separador
                result.Add(new RowContent { Separator = true });

                // Último: SIEMPRE el destino final
                result.Add(relevantStations[^1]);
            }
            else if (Rows == 2)
            {
                // Solo NextStation + Destino final
                result.Add(relevantStations[^1]);
            }
            // Rows == 1 → solo la primera (NextStation)

            mcolItinerary = result.ToArray();
        }
    }

    private struct RowContent
    {
        public Station? Station { get; set; } //Estación.
        public TimeSpan Arrival{ get; set; } //Hora estimada de llegada.
        public bool Separator{ get; set; } //Representa una separación en la tabla.
        public bool Pointer{ get; set; } //Marca la estación con un puntero.
    }



}
