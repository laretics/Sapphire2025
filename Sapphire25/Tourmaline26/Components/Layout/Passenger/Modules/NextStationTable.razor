@using System.Globalization
@using System.Text
@using Tourmaline26.Services.SfmInfo
@implements IDisposable
@inject SfmDeparturesService mvarSfm

<div class="nst-root">
    @* ── Cabecera: próxima estación ─────────────────────────────────────── *@
    <section class="nst-hero" aria-label="Propera estació">
        <div class="nst-hero-glow" aria-hidden="true"></div>
        <div class="nst-kicker">
            <span class="nst-kicker-dot" aria-hidden="true"></span>
            Propera estació
        </div>
        <h1 class="nst-station">@(DisplayStationName)</h1>
        <div class="nst-rule" aria-hidden="true"></div>
    </section>

    @* ── Pie: salidas / correspondencias ────────────────────────────────── *@
    <section class="nst-board" aria-label="Propers sortides">
        <header class="nst-board-head">
            <span class="nst-board-title">Propers sortides</span>
            <div class="nst-live @(mvarSfm.IsConnected ? "nst-live--on" : "nst-live--off")"
                 title="@(mvarSfm.IsConnected ? "En viu" : "Sense connexió")">
                <span class="nst-live-pip" aria-hidden="true"></span>
                @(mvarSfm.IsConnected ? "EN VIU" : "OFF")
            </div>
        </header>

        @if (FilteredDepartures.Count > 0)
        {
            <div class="nst-table-wrap">
                <table class="nst-table">
                    <thead>
                        <tr>
                            <th class="nst-col-time">Hora</th>
                            <th class="nst-col-line">Línia</th>
                            <th class="nst-col-dest">Destinació</th>
                            <th class="nst-col-plat">Andana</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (SfmDeparture dep in FilteredDepartures)
                        {
                            <tr class="@(dep.PlatformChanged ? "nst-row--alert" : null)">
                                <td class="nst-col-time">
                                    <span class="nst-time">@FormatTime(dep)</span>
                                    @if (HasDelayHint(dep))
                                    {
                                        <span class="nst-eta">@FormatEta(dep)</span>
                                    }
                                </td>
                                <td class="nst-col-line">
                                    @{
                                        string lineBg = LineColor(dep);
                                    }
                                    <span class="nst-line"
                                          style="--line-color: @lineBg; color: @ContrastInk(lineBg)">
                                        @(string.IsNullOrWhiteSpace(dep.LineSymbol) ? "—" : dep.LineSymbol)
                                    </span>
                                </td>
                                <td class="nst-col-dest">
                                    <span class="nst-dest">@dep.DestinationName</span>
                                    @{
                                        string? notice = PrimaryNotice(dep);
                                    }
                                    @if (!string.IsNullOrEmpty(notice))
                                    {
                                        <span class="nst-notice">@notice</span>
                                    }
                                </td>
                                <td class="nst-col-plat">
                                    @if (dep.Platform.HasValue)
                                    {
                                        <span class="nst-plat @(dep.PlatformChanged ? "nst-plat--changed" : null)">
                                            @dep.Platform
                                        </span>
                                        @if (dep.PlatformChanged && dep.OriginalPlatform.HasValue)
                                        {
                                            <span class="nst-plat-old" title="Andana original">@dep.OriginalPlatform</span>
                                        }
                                    }
                                    else
                                    {
                                        <span class="nst-plat nst-plat--empty">—</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="nst-empty">
                @if (!string.IsNullOrWhiteSpace(mvarSfm.LastError))
                {
                    <span class="nst-empty-title">Informació temporalment no disponible</span>
                    <span class="nst-empty-sub">Tornarem a intentar-ho automàticament</span>
                }
                else if (!mvarSfm.IsConnected || mvarResolvedStation is null)
                {
                    <span class="nst-empty-title">Carregant sortides…</span>
                    <span class="nst-empty-sub">Connectant amb el panell d'estació</span>
                }
                else
                {
                    <span class="nst-empty-title">Sense altres sortides anunciades</span>
                    <span class="nst-empty-sub">No hi ha correspondències en aquest moment</span>
                }
            </div>
        }
    </section>
</div>

@code {
    [Parameter]
    public string? NextStationName { get; set; }

    /// <summary>Destino final de este tren: se excluyen salidas hacia el mismo destino.</summary>
    [Parameter]
    public string? TrainDestinationName { get; set; }

    /// <summary>Máximo de filas de salidas a mostrar.</summary>
    [Parameter]
    public int MaxDepartures { get; set; } = 10;

    private SfmStation? mvarResolvedStation;
    private string? mvarLastSubscribedKey;
    private List<SfmDeparture> mvarFiltered = new();

    private string DisplayStationName =>
        !string.IsNullOrWhiteSpace(NextStationName)
            ? NextStationName.Trim()
            : (mvarResolvedStation?.Name ?? "—");

    private IReadOnlyList<SfmDeparture> FilteredDepartures => mvarFiltered;

    protected override void OnInitialized()
    {
        mvarSfm.Updated += OnSfmUpdated;
        Rebuild();
    }

    protected override void OnParametersSet()
    {
        EnsureStationSubscription();
        Rebuild();
    }

    public void Dispose()
    {
        mvarSfm.Updated -= OnSfmUpdated;
    }

    private void OnSfmUpdated(object? sender, EventArgs e)
    {
        _ = InvokeAsync(() =>
        {
            EnsureStationSubscription();
            Rebuild();
            StateHasChanged();
        });
    }

    private void EnsureStationSubscription()
    {
        mvarResolvedStation = ResolveStation(NextStationName);
        if (mvarResolvedStation is null)
            return;

        string key = mvarResolvedStation.Code.ToString(CultureInfo.InvariantCulture);
        if (string.Equals(mvarLastSubscribedKey, key, StringComparison.Ordinal))
            return;

        mvarSfm.SetStation(mvarResolvedStation.Code);
        mvarLastSubscribedKey = key;
    }

    private void Rebuild()
    {
        IEnumerable<SfmDeparture> query = mvarSfm.Departures ?? Array.Empty<SfmDeparture>();

        // Solo salidas de la estación que estamos anunciando (si ya hay snapshot).
        if (mvarResolvedStation is not null &&
            mvarSfm.Snapshot.StationCode == mvarResolvedStation.Code)
        {
            // ok
        }

        query = query.Where(d => !IsSameStation(d.DestinationName, TrainDestinationName));

        // Orden por hora estimada / programada.
        query = query
            .OrderBy(d => d.EstimatedTimeLocal == DateTime.MinValue ? d.DepartureTimeLocal : d.EstimatedTimeLocal)
            .ThenBy(d => d.ServiceName);

        int take = MaxDepartures > 0 ? MaxDepartures : 10;
        mvarFiltered = query.Take(take).ToList();
    }

    private SfmStation? ResolveStation(string? name)
    {
        if (string.IsNullOrWhiteSpace(name))
            return null;

        SfmStation? direct = mvarSfm.FindStationByName(name);
        if (direct is not null)
            return direct;

        string needle = NormalizeStation(name);
        if (needle.Length < 2)
            return null;

        SfmStation? best = null;
        int bestScore = 0;
        foreach (SfmStation s in mvarSfm.Stations)
        {
            string cand = NormalizeStation(s.Name);
            string abbr = NormalizeStation(s.Abbreviation);
            int score = 0;
            if (cand == needle || abbr == needle)
                score = 100;
            else if (cand.StartsWith(needle, StringComparison.Ordinal) || needle.StartsWith(cand, StringComparison.Ordinal))
                score = 80;
            else if (needle.Length >= 4 && cand.Contains(needle, StringComparison.Ordinal))
                score = 60;
            else if (cand.Length >= 4 && needle.Contains(cand, StringComparison.Ordinal))
                score = 50;

            if (score > bestScore)
            {
                bestScore = score;
                best = s;
            }
        }

        return bestScore >= 50 ? best : null;
    }

    private static bool IsSameStation(string? a, string? b)
    {
        if (string.IsNullOrWhiteSpace(a) || string.IsNullOrWhiteSpace(b))
            return false;

        string na = NormalizeStation(a);
        string nb = NormalizeStation(b);
        if (na.Length == 0 || nb.Length == 0)
            return false;
        if (na == nb)
            return true;

        string shorter = na.Length <= nb.Length ? na : nb;
        string longer = na.Length <= nb.Length ? nb : na;
        // Evitar falsos positivos con prefijos cortos ("son", "sa"…).
        return shorter.Length >= 4 && longer.Contains(shorter, StringComparison.Ordinal);
    }

    private static string NormalizeStation(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
            return string.Empty;

        string s = value.Trim().ToLowerInvariant();
        s = RemoveDiacritics(s);
        s = s.Replace("estacio", " ", StringComparison.Ordinal)
             .Replace("estacion", " ", StringComparison.Ordinal)
             .Replace("station", " ", StringComparison.Ordinal);

        // "palma int" / "palma intermodal" → núcleo
        if (s.EndsWith(" int", StringComparison.Ordinal))
            s = s[..^4];
        s = s.Replace(" intermodal", " ", StringComparison.Ordinal);

        var sb = new StringBuilder(s.Length);
        bool space = false;
        foreach (char c in s)
        {
            if (char.IsLetterOrDigit(c))
            {
                sb.Append(c);
                space = false;
            }
            else if (!space)
            {
                sb.Append(' ');
                space = true;
            }
        }
        return sb.ToString().Trim();
    }

    private static string RemoveDiacritics(string text)
    {
        string normalized = text.Normalize(NormalizationForm.FormD);
        var sb = new StringBuilder(normalized.Length);
        foreach (char c in normalized)
        {
            if (CharUnicodeInfo.GetUnicodeCategory(c) != UnicodeCategory.NonSpacingMark)
                sb.Append(c);
        }
        return sb.ToString().Normalize(NormalizationForm.FormC);
    }

    private static string FormatTime(SfmDeparture dep)
    {
        DateTime t = dep.DepartureTimeLocal != DateTime.MinValue
            ? dep.DepartureTimeLocal
            : dep.EstimatedTimeLocal;
        return t == DateTime.MinValue ? "—" : t.ToString("HH:mm");
    }

    private static bool HasDelayHint(SfmDeparture dep)
    {
        if (dep.DepartureTimeLocal == DateTime.MinValue || dep.EstimatedTimeLocal == DateTime.MinValue)
            return false;
        return Math.Abs((dep.EstimatedTimeLocal - dep.DepartureTimeLocal).TotalMinutes) >= 1;
    }

    private static string FormatEta(SfmDeparture dep) =>
        dep.EstimatedTimeLocal == DateTime.MinValue
            ? string.Empty
            : dep.EstimatedTimeLocal.ToString("HH:mm");

    private static string LineColor(SfmDeparture dep)
    {
        if (!string.IsNullOrWhiteSpace(dep.LineColorHex) && dep.LineColorHex.StartsWith('#'))
            return dep.LineColorHex;

        // Fallback si el catálogo de líneas aún no ha llegado por socket.
        return dep.LineSymbol switch
        {
            "T1" => "#BC2A6A",
            "T2" => "#AFB071",
            "T3" => "#FBCE07",
            "M1" => "#FF9900",
            "M2" => "#FF9933",
            _ => "#004F8D"
        };
    }

    /// <summary>Texto blanco o casi negro según luminancia del color de línea.</summary>
    private static string ContrastInk(string hex)
    {
        if (!TryParseHexColor(hex, out int r, out int g, out int b))
            return "#ffffff";

        // Luminancia relativa aproximada (sRGB).
        double luminance = (0.2126 * r + 0.7152 * g + 0.0722 * b) / 255.0;
        return luminance > 0.62 ? "#1a1a1a" : "#ffffff";
    }

    private static bool TryParseHexColor(string hex, out int r, out int g, out int b)
    {
        r = g = b = 0;
        if (string.IsNullOrWhiteSpace(hex))
            return false;
        hex = hex.Trim();
        if (hex.StartsWith('#'))
            hex = hex[1..];
        if (hex.Length != 6)
            return false;
        return int.TryParse(hex.AsSpan(0, 2), NumberStyles.HexNumber, CultureInfo.InvariantCulture, out r)
            && int.TryParse(hex.AsSpan(2, 2), NumberStyles.HexNumber, CultureInfo.InvariantCulture, out g)
            && int.TryParse(hex.AsSpan(4, 2), NumberStyles.HexNumber, CultureInfo.InvariantCulture, out b);
    }

    private static string? PrimaryNotice(SfmDeparture dep)
    {
        // Preferimos castellano (600); si no, catalán (601); si no, inglés (602).
        SfmLocalizedText? pick =
            dep.InfoMessages.FirstOrDefault(m => m.LanguageCode == 600) ??
            dep.InfoMessages.FirstOrDefault(m => m.LanguageCode == 601) ??
            dep.InfoMessages.FirstOrDefault();

        return string.IsNullOrWhiteSpace(pick?.Text) ? null : pick!.Text.Trim();
    }
}
