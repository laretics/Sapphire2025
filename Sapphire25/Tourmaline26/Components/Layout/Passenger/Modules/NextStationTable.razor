@using System.Globalization
@using Tourmaline26.Services.Correspondence
@implements IAsyncDisposable
@inject CorrespondenceBoardService mvarBoard
@inject IJSRuntime JS

<div class="nst-root @(HideStationHero ? "nst-root--final" : null)" @ref="mvarWrap">
    @if (!HideStationHero)
    {
        <section class="nst-hero" aria-label="Estació">
            <div class="nst-hero-glow" aria-hidden="true"></div>
            <h1 class="nst-station">@(DisplayStationName)</h1>
            <div class="nst-rule" aria-hidden="true"></div>
        </section>
    }

    @* ── Pie: salidas / correspondencias ────────────────────────────────── *@
    <section class="nst-board" aria-label="Correspondències">
        @if (FilteredDepartures.Count > 0)
        {
            <div class="nst-table-wrap">
                <table class="nst-table">
                    <tbody>
                        @foreach (ConnectionDeparture dep in FilteredDepartures)
                        {
                            <tr class="@(dep.PlatformChanged ? "nst-row--alert" : null)">
                                @{
                                    string lineBg = LineColor(dep);
                                }
                                <td class="nst-col-time">
                                    @{
                                        bool soon = IsImminent(dep);
                                    }
                                    <span class="nst-time @(soon ? "nst-time--soon" : null)">@FormatTime(dep)</span>
                                    @if (HasDelayHint(dep))
                                    {
                                        <span class="nst-eta @(soon ? "nst-eta--soon" : null)">@FormatEta(dep)</span>
                                    }
                                </td>
                                <td class="nst-col-op">
                                    <img src="@OperatorLogo(dep)"
                                         alt="@OperatorTitle(dep)"
                                         class="nst-op-logo @OperatorLogoClass(dep)" />
                                </td>
                                <td class="nst-col-line">
                                    <span class="nst-line"
                                          style="--line-color: @lineBg; color: @ContrastInk(lineBg)">
                                        @(string.IsNullOrWhiteSpace(dep.LineSymbol) ? "—" : dep.LineSymbol)
                                    </span>
                                </td>
                                <td class="nst-col-dest">
                                    <span class="nst-dest" title="@dep.DestinationName">
                                        @if (!string.IsNullOrEmpty(dep.DestinationIcon))
                                        {
                                            <span class="nst-dest-icon" aria-hidden="true">
                                                <ColorIcon Name="@dep.DestinationIcon" Size="28" Color="currentColor" />
                                            </span>
                                        }
                                        @if (string.IsNullOrEmpty(dep.DestinationIcon) || !dep.DestinationIconReplacesText)
                                        {
                                            <span class="nst-dest-text">@dep.DestinationName</span>
                                        }
                                    </span>
                                    @if (!string.IsNullOrEmpty(dep.Notice))
                                    {
                                        <span class="nst-notice">@dep.Notice</span>
                                    }
                                </td>
                                <td class="nst-col-plat">
                                    @if (dep.Mode == ConnectionMode.Bus && dep.Platform.HasValue)
                                    {
                                        <span class="nst-plat nst-plat--bus" title="Dàrsena">@dep.Platform</span>
                                    }
                                    else if (dep.Mode == ConnectionMode.Train && dep.Platform.HasValue)
                                    {
                                        <span class="nst-plat @(dep.PlatformChanged ? "nst-plat--changed" : null)">
                                            @dep.Platform
                                        </span>
                                        @if (dep.PlatformChanged && dep.OriginalPlatform.HasValue)
                                        {
                                            <span class="nst-plat-old" title="Andana original">@dep.OriginalPlatform</span>
                                        }
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="nst-empty">
                @if (!string.IsNullOrWhiteSpace(mvarBoard.CombinedError) && FilteredDepartures.Count == 0 && !mvarBoard.IsSfmConnected)
                {
                    <span class="nst-empty-title">Informació temporalment no disponible</span>
                    <span class="nst-empty-sub">Tornarem a intentar-ho automàticament</span>
                }
                else if (!mvarBoard.IsSfmConnected && mvarBoard.CurrentPlace is null)
                {
                    <span class="nst-empty-title">Carregant sortides…</span>
                    <span class="nst-empty-sub">Connectant amb el panell d'estació</span>
                }
                else
                {
                    <span class="nst-empty-title">Sense altres sortides anunciades</span>
                    <span class="nst-empty-sub">No hi ha correspondències en aquest moment</span>
                }
            </div>
        }
    </section>
</div>

@code {
    [Parameter]
    public string? NextStationName { get; set; }

    /// <summary>
    /// Destino final de este tren. Se excluyen trenes y buses que terminen
    /// ahí o en la estación anunciada (no son un enlace).
    /// </summary>
    [Parameter]
    public string? TrainDestinationName { get; set; }

    /// <summary>
    /// Sin cartel de nombre de estación (próxima = destino): el tablero ocupa todo el alto.
    /// </summary>
    [Parameter]
    public bool HideStationHero { get; set; }

    /// <summary>Tope de filas; el panel usa las que quepan enteras en el hueco.</summary>
    [Parameter]
    public int MaxDepartures { get; set; } = 20;

    /// <summary>Filas extra al quitar el cartel de estación (próxima = destino).</summary>
    private const int ExtraDeparturesWithoutHero = 4;

    private ElementReference mvarWrap;
    private DotNetObjectReference<NextStationTable>? mvarJs;
    private int mvarFitCount;
    private bool mvarLastHideHero;

    private string DisplayStationName
    {
        get
        {
            string fromBoard = mvarBoard.DisplayStationName;
            if (!string.IsNullOrWhiteSpace(fromBoard))
                return fromBoard;
            return string.IsNullOrWhiteSpace(NextStationName) ? "—" : NextStationName.Trim();
        }
    }

    private IReadOnlyList<ConnectionDeparture> FilteredDepartures => mvarBoard.Upcoming;

    protected override void OnInitialized()
    {
        mvarBoard.Updated += OnBoardUpdated;
        mvarLastHideHero = HideStationHero;
        PushContext();
    }

    protected override void OnParametersSet()
    {
        if (HideStationHero != mvarLastHideHero)
        {
            mvarLastHideHero = HideStationHero;
            mvarFitCount = 0;
        }

        PushContext();
    }

    public async ValueTask DisposeAsync()
    {
        mvarBoard.Updated -= OnBoardUpdated;
        try
        {
            await JS.InvokeVoidAsync("NstTable.dispose", mvarWrap);
        }
        catch (JSDisconnectedException)
        {
        }

        mvarJs?.Dispose();
        mvarJs = null;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        try
        {
            if (firstRender)
            {
                mvarJs = DotNetObjectReference.Create(this);
                await JS.InvokeVoidAsync("NstTable.observe", mvarWrap, mvarJs);
            }
            else
            {
                await JS.InvokeVoidAsync("NstTable.layout", mvarWrap);
            }
        }
        catch (JSDisconnectedException)
        {
        }
        catch (JSException)
        {
        }
    }

    [JSInvokable]
    public void OnTableFit(int rows)
    {
        int next = Math.Clamp(rows, 1, DepartureCap);
        // El wrap se encoge al contenido: no recortar el tope si el tablero pide más filas.
        if (next == mvarFitCount)
            return;
        if (HideStationHero && mvarFitCount > 0 && next < mvarFitCount)
            return;
        mvarFitCount = next;
        PushContext();
        _ = InvokeAsync(StateHasChanged);
    }

    private void OnBoardUpdated(object? sender, EventArgs e)
    {
        _ = InvokeAsync(StateHasChanged);
    }

    private int DepartureCap =>
        (MaxDepartures > 0 ? MaxDepartures : 20)
        + (HideStationHero ? ExtraDeparturesWithoutHero : 0);

    private void PushContext()
    {
        int take = mvarFitCount > 0 ? mvarFitCount : DepartureCap;
        take = Math.Clamp(take, 1, DepartureCap);
        mvarBoard.SetContext(NextStationName, TrainDestinationName, take);
    }

    private static string FormatTime(ConnectionDeparture dep)
    {
        DateTime t = dep.DepartureTimeLocal != DateTime.MinValue
            ? dep.DepartureTimeLocal
            : dep.EstimatedTimeLocal;
        return t == DateTime.MinValue ? "—" : t.ToString("HH:mm");
    }

    /// <summary>True si faltan 6 minutos o menos para la salida efectiva.</summary>
    private static bool IsImminent(ConnectionDeparture dep)
    {
        DateTime t = dep.SortTime;
        if (t == default || t == DateTime.MinValue)
            return false;

        DateTime local = t.Kind switch
        {
            DateTimeKind.Utc => t.ToLocalTime(),
            DateTimeKind.Local => t,
            _ => DateTime.SpecifyKind(t, DateTimeKind.Local)
        };
        return local - DateTime.Now <= TimeSpan.FromMinutes(6);
    }

    private static bool HasDelayHint(ConnectionDeparture dep)
    {
        if (dep.DepartureTimeLocal == DateTime.MinValue || dep.EstimatedTimeLocal == DateTime.MinValue)
            return false;
        return Math.Abs((dep.EstimatedTimeLocal - dep.DepartureTimeLocal).TotalMinutes) >= 1;
    }

    private static string FormatEta(ConnectionDeparture dep) =>
        dep.EstimatedTimeLocal == DateTime.MinValue
            ? string.Empty
            : dep.EstimatedTimeLocal.ToString("HH:mm");

    private static string OperatorLogo(ConnectionDeparture dep) =>
        dep.Mode switch
        {
            ConnectionMode.Emt => "/img/correspondence/EmtPalma.png",
            ConnectionMode.Bus => "/img/correspondence/Tib_logo.png",
            _ => "/img/sfm-logo.svg"
        };

    private static string OperatorLogoClass(ConnectionDeparture dep) =>
        dep.Mode switch
        {
            ConnectionMode.Emt => "nst-op-logo--emt",
            ConnectionMode.Bus => "nst-op-logo--tib",
            _ => "nst-op-logo--sfm"
        };

    private static string OperatorTitle(ConnectionDeparture dep) =>
        dep.Mode switch
        {
            ConnectionMode.Emt => "EMT Palma",
            ConnectionMode.Bus => "TIB",
            _ => "SFM"
        };

    private static string LineColor(ConnectionDeparture dep)
    {
        if (!string.IsNullOrWhiteSpace(dep.LineColorHex) && dep.LineColorHex.StartsWith('#'))
            return dep.LineColorHex;

        return dep.LineSymbol switch
        {
            "T1" => "#BC2A6A",
            "T2" => "#AFB071",
            "T3" => "#FBCE07",
            "M1" => "#FF9900",
            "M2" => "#FF9933",
            _ => dep.Mode == ConnectionMode.Emt ? "#00AEEF"
                : dep.Mode == ConnectionMode.Bus ? "#CE0000"
                : "#004F8D"
        };
    }

    private static string ContrastInk(string hex)
    {
        if (!TryParseHexColor(hex, out int r, out int g, out int b))
            return "#ffffff";

        double luminance = (0.2126 * r + 0.7152 * g + 0.0722 * b) / 255.0;
        return luminance > 0.62 ? "#1a1a1a" : "#ffffff";
    }

    private static bool TryParseHexColor(string hex, out int r, out int g, out int b)
    {
        r = g = b = 0;
        if (string.IsNullOrWhiteSpace(hex))
            return false;
        hex = hex.Trim();
        if (hex.StartsWith('#'))
            hex = hex[1..];
        if (hex.Length != 6)
            return false;
        return int.TryParse(hex.AsSpan(0, 2), NumberStyles.HexNumber, CultureInfo.InvariantCulture, out r)
            && int.TryParse(hex.AsSpan(2, 2), NumberStyles.HexNumber, CultureInfo.InvariantCulture, out g)
            && int.TryParse(hex.AsSpan(4, 2), NumberStyles.HexNumber, CultureInfo.InvariantCulture, out b);
    }
}
