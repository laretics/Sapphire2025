@using TimeNetComponents.Controls.TimeNetControl
@using Tourmaline26.Components.Controls
@using TimeNetComponents.Controls
@inject TourmalineService Tourmaline
<TeslaLeftSectionIndicators/>
@if(null!=mvarControlEnvironment && 
null!=mvarControlEnvironment.Environment && 
mvarControlEnvironment.Environment.IsViewComplete)
{
    <TimeNetControl Environment="mvarControlEnvironment"
                    Style="mvarTimenetStyle" />
}
<div class="d-flex flex-column justify-content-end h-100">
    @if(SpeedometerVisible)
    {
        <Speedometer/>
    }    
</div>
@code {
    private TimeNetControlEnvironment mvarControlEnvironment = new TimeNetControlEnvironment(100, 100);
    private TimeNetControlStyle mvarTimenetStyle = new TimeNetControlStyle();

    private SessionConfiguration mvarConfig = new();   
    protected override void OnInitialized()
    {
        base.OnInitialized();
        mvarConfig = Tourmaline.SessionConfig;
        Tourmaline.HMIUpdateRequested += auxHMIRefresh;
        mvarControlEnvironment.Environment = Tourmaline.SessionConfig.TNEnvironment;       
    }
    public void Dispose()
    {
        Tourmaline.HMIUpdateRequested -= auxHMIRefresh;
    }
    private void auxHMIRefresh(object? sender, EventArgs e)
    {
        InvokeAsync(StateHasChanged);
    }


    /// <summary>
    /// Velocímetro de cabina: velocidad del tren (MVB / demo), nunca GPS.
    /// Visible en Demo siempre; con MVB solo con marcha adelante o atrás (no neutro).
    /// </summary>
    private bool SpeedometerVisible
    {
        get
        {
            // Modo demostración: siempre visible (usa SimulatedSpeed / MVB dummy).
            if (mvarConfig.ServiceMode.DemoMode)
                return true;

            // Sin fuente MVB (real o dummy) no hay velocidad de tren para la aguja.
            if (null == mvarConfig.CurrentMVBData)
                return false;
            if (!mvarConfig.ServiceMode.MVBEnabled && !mvarConfig.ServiceMode.MVBDummy)
                return false;

            // Solo marcha adelante o atrás; en neutro (y resto) se oculta.
            return mvarConfig.SpeedometerDriveSelected;
        }
    }
}

