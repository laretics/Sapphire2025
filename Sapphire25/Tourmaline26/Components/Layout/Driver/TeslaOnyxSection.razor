@using Diamond.Controls
@using Diamond.Cabin
@using Diamond.Topo
@using ProjectCirculation = Diamond.Project.Circulation
@using MeshRouteView = Diamond.Topo.RouteView
@inject TourmalineService Tourmaline

@* Contenedor oficial de la malla de cabina (CabinMeshView). *@
<div class="tesla-onyx-section">
    <div class="tesla-onyx-stack">
        @* Capa malla: rellena todo el panel izquierdo; z-index bajo. *@
        <div class="tesla-onyx-mesh-layer">
            <CabinMeshView Topo="@(cabin?.Topo)"
                           DayProject="@(cabin?.DayProject)"
                           ActiveCirculation="@(cabin?.Circulation)"
                           RoutePk="@(cabin?.PK ?? 0)"
                           LocationAxis="@(cabin?.LinearLocation.Axis)"
                           ClockNow="@(cabin?.ClockNow ?? DateTime.Now)"
                           NightMode="@NightMode"
                           ActiveTrainVmaxKmh="@ActiveTrainVmax"
                           CurrentSpeedKmh="@(Tourmaline.SessionConfig.CurrentSpeed)"
                           CirculationPicked="OnCirculationPicked" />
        </div>

        @* Indicadores MVB por encima de la malla. *@
        <div class="tesla-onyx-indicators-layer">
            <TeslaLeftSectionIndicators />
        </div>

        @* Velocímetro por encima de la malla. *@
        <div class="tesla-onyx-speedo-layer">
            @if (SpeedometerVisible)
            {
                <Speedometer />
            }
        </div>
    </div>
</div>

@code {
    [CascadingParameter]
    public bool NightMode { get; set; }

    private SessionConfiguration mvarConfig = new();

    private CabinEnvironment? cabin => Tourmaline.SessionConfig.Cabin;

    /// <summary>
    /// Vmax del material en misión (km/h). 100 = diésel SFM por defecto; 0 sin tren.
    /// </summary>
    private int ActiveTrainVmax
    {
        get
        {
            if (cabin?.Circulation is null)
                return 0;
            // Cuando haya catálogo de flota en cabina, mapear FleetId → Vmax.
            return 100;
        }
    }

    protected override void OnInitialized()
    {
        base.OnInitialized();
        mvarConfig = Tourmaline.SessionConfig;
        Tourmaline.HMIUpdateRequested += auxHMIRefresh;
    }

    public void Dispose()
    {
        Tourmaline.HMIUpdateRequested -= auxHMIRefresh;
    }

    private void auxHMIRefresh(object? sender, EventArgs e)
    {
        UpdateLimitFromCurrentTrack();
        InvokeAsync(StateHasChanged);
    }

    /// <summary>
    /// Canal de Vmax del velocímetro: limitación efectiva del tramo actual.
    /// </summary>
    private void UpdateLimitFromCurrentTrack()
    {
        if (cabin is null || cabin.Topo is null)
            return;

        if (mvarConfig.ServiceMode.ServiceKeyboard)
            return;

        MeshRouteView? view = RouteViewResolver.TryForCabinCirculation(
            cabin.Topo,
            cabin.Circulation?.Asimilation.ViewId,
            cabin.Circulation?.Asimilation.PathSignature,
            cabin.Circulation?.Origin.Id,
            cabin.Circulation?.Destination.Id,
            cabin.Circulation?.Origin.Avr,
            cabin.Circulation?.Destination.Avr);
        if (view is null)
            view = RouteViewResolver.TryFromAxis(cabin.LinearLocation.Axis);
        if (view is null)
            return;

        long routePk = cabin.PK;
        if (cabin.LinearLocation.Axis is not null
            && view.TryMapAxisToRoute(cabin.LinearLocation.Axis, cabin.PK, out long mapped))
        {
            routePk = mapped;
        }

        int? track = view.GetEffectiveSpeedLimit(routePk);
        int limit = track ?? ActiveTrainVmax;
        if (limit <= 0)
            limit = 100;
        if (ActiveTrainVmax > 0 && limit > ActiveTrainVmax)
            limit = ActiveTrainVmax;

        Tourmaline.SessionConfig.CurrentLimitSpeed = limit;
    }

    private async Task OnCirculationPicked(ProjectCirculation cir)
    {
        await Tourmaline.DoCirculationSelect(cir);
        Tourmaline.RaiseHMIUpdate();
        Tourmaline.RaisePassengerUpdate();
    }

    private bool SpeedometerVisible
    {
        get
        {
            if (mvarConfig.ServiceMode.DemoMode || mvarConfig.ServiceMode.RouteSimulation)
                return true;

            if (null == mvarConfig.CurrentMVBData)
                return false;
            if (!mvarConfig.ServiceMode.MVBEnabled && !mvarConfig.ServiceMode.MVBDummy)
                return false;

            return mvarConfig.SpeedometerDriveSelected;
        }
    }
}
