@using Tourmaline26.Components.Images
<div class="tesla-toolbar">
    @foreach (TeslaButton? auxButton in Buttons.Values)
    {
        <TeslaToolButton TeslaButton="auxButton"/>
    }
</div>

@code {
    [CascadingParameter]
    public bool NightMode { get; set; }
    // Define los datos de los botones aquí
    [Parameter]
    public Dictionary<string, TeslaButton> Buttons { get; set; } = new Dictionary<string, TeslaButton>();
    public async Task ManagePhysicalKeyboard(string key)
    {
        int btnIndex = key switch
        {
            "1" => 0,
            "2" => 1,
            "3" => 2,
            "4" => 3,
            "5" => 4,
            "6" => 5,
            "7" => 6,
            "8" => 7,
            "9" => 8,
            "0" => 9,
            _ => -1
        };
        int index = 0;
        foreach(TeslaButton auxButton in Buttons.Values)
        {
            if(index==btnIndex)
            {
                if (null!=auxButton && auxButton.Enabled)
                {
                    PressButton(auxButton);
                    await OnButtonClick(auxButton);
                    ReleaseButton(auxButton);
                }
                break;
            }
            index++;
        }
    }

    private void PressButton(TeslaButton btn)
    {
        btn.Press();
        StateHasChanged();
    }

    private async void ReleaseButton(TeslaButton btn)
    {
        await Task.Delay(180);
        btn.Release();
        StateHasChanged();
    }

    private async Task OnButtonClick(TeslaButton btn)
    {
        btn.DoToggle();
        await btn.Callback.InvokeAsync();
    }
}