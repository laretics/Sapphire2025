@using Tourmaline26.Components.Controls
@using Tourmaline26.Components.Images
@inject TourmalineService Tourmaline
<div class="icon-grid">
    <!--Fila 0 -->
    <div class="icon-cell">        
        <!--0  Luz de viajeros apagada-->
        @if(!mvarMVB.PassengerLight)
        {
            <ColorIcon Name="BulbOff" Color="#606040" Glow="true" GlowColor="#808060" />
        }
        else
        {
            <ColorIcon Name="BulbOff" Color="#60604020" />
        }
    </div>
    <div class="icon-cell">
        <!--1  -->
    </div>
    <div class="icon-cell">
        <!--2 Emergencia-->         
        @if(mvarMVB.WarningSign)
        {
            <ColorIcon Name="Warning" Color="#a02020" Glow="true" GlowColor="#C04040" />
        }
        else
        {
            <ColorIcon Name="Warning" Color="#a0202020"/>
        }

    </div>
    <div class="icon-cell">
        <!--3  -->
    </div>
    <div class="icon-cell">
        <!--4 Megafonía anunciando -->
        @if(mvarConfig.SpeakersAnnouncing)
        {
            <ColorIcon Name="Speaker" Color="#808050" Glow="true" GlowColor="#A0A070" />
        }
        else
        {
            <ColorIcon Name="Speaker" Color="#20202020" />
        }

    </div>
    <!--Fila 1 -->
    <div class="icon-cell">
        <!--0 Puerta izquierda -->
        @if (mvarMVB.LeftDoors)
        {
            <ColorIcon Name="LeftDoor" Color="#208020" Glow="true" GlowColor="#40A040" />        
        }
        else
        {
            <ColorIcon Name="LeftDoor" Color="#20202020" />
        }
    </div>
    <div class="icon-cell">
        <!--1 Lazo de tracción -->
        @if(!mvarMVB.TractionLoop)
        {
            <ColorIcon Name="TrLoop" Color="#808020" Glow="true" GlowColor="#A0A040" />
        }
        else
        {
            <ColorIcon Name="TrLoop" Color="#80802020" />
        }

    </div>
    <div class="icon-cell">        
        <!--2 Lazo de puertas -->
        @if(!mvarMVB.DoorsLoop)
        {
            <ColorIcon Name="DrLoop" Color="#808020" Glow="true" GlowColor="#A0A040" />
        }
        else
        {
            <ColorIcon Name="DrLoop" Color="#80802020" />
        }
        
    </div>
    <div class="icon-cell">
        <!--3 Lazo de freno -->
        @if(!mvarMVB.BrakeLoop)
        {
            <ColorIcon Name="BrLoop" Color="#802020" Glow="true" GlowColor="#A04040" />
        }
        else
        {
            <ColorIcon Name="BrLoop" Color="#80202020"/>
        }

    </div>
    <div class="icon-cell">
        <!--4 Puerta derecha -->
        @if(mvarMVB.RightDoors)
        {
            <ColorIcon Name="RightDoor" Color="#208020" Glow="true" GlowColor="#40A040" />
        }
        else
        {
            <ColorIcon Name="RightDoor" Color="#20202020" />
        }
    </div>
</div>

@code 
{
    private MVBData mvarMVB = new();
    private SessionConfiguration mvarConfig = new();
    protected override void OnInitialized()
    {
        base.OnInitialized();
        mvarConfig = Tourmaline.SessionConfig;
        Tourmaline.HMIUpdateRequested += auxHMIRefresh;
    }
    public void Dispose()
    {
        Tourmaline.HMIUpdateRequested -= auxHMIRefresh;
    }
    private void auxHMIRefresh(object? sender, EventArgs e)
    {
        if (null != mvarConfig.CurrentMVBData)
            mvarMVB = mvarConfig.CurrentMVBData;
        InvokeAsync(StateHasChanged);
    }
}
