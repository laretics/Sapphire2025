@using Tourmaline26.Components.Images
@using System.Net.Http;
@using TimeNetComponents.Controls
@using Tourmaline26.Services.OpenMeteo
<div class="tesla-top-right-bar">
    @if(null!=mvarConfig)
    {
        @if(null!=mvarConfig.CurrentWeather)
        {
            <span><b>@(mvarConfig.CurrentWeather.Temperature2m)ºC</b></span>
            <span>
                <img src="@OpenMeteoClient.GetWeatherIconUrl(mvarConfig.CurrentWeather.WeatherCode)" style="width:36px;height:auto;" />
            </span>
        }
        @if(null!=mvarConfig.Session && null!=mvarConfig.Session.User)
        {
            <span><RoleIcon 
                Size="24" 
                Credentials="mvarConfig.Session.Roles"/>
            </span>
            <span>
                <b>@mvarConfig.Session.User.Name</b>
            </span>
        }
        @if(mvarConfig.ServiceKeyboard)
        {
            <ColorIcon Size="24" Color="#902020" Name="DebugKeyboard"/>    
        }        
        @if(mvarConfig.MVBEnabled || mvarConfig.MVBDummy)
        {
            if(null==mvarConfig.CurrentMVBData)
            {
                <ColorIcon Name="MVB" Size="24" Color="red"></ColorIcon>
            }
            else
            {
                <ColorIcon Name="MVB" Size="24" ></ColorIcon>
            }
        }
        @if(mvarConfig.GPSEnabled ||mvarConfig.GPSDummy)
        {
            if (mvarConfig.GPSOK)
            {
                <ColorIcon Name="Satellite" Size="24" ></ColorIcon>
            }
            else if (mvarConfig.GPSDummy)
            {
                <ColorIcon Name="Satellite" Color="#902020" Size="24"></ColorIcon>
            }
            else
            {
                <ColorIcon Name="NoLocation" Size="24" ></ColorIcon>
            }
        }        
        @if(mvarConfig.InternetEnabled)
        {
            @if (mvarConfig.InternetOK)
            {
                <ColorIcon Name="Internet" Size="24" ></ColorIcon>
            }
            else
            {
                <ColorIcon Name="NoInternet" Size="24" ></ColorIcon>
            }
        }        
        @if(null!=mvarConfig.TNEnvironment)
        {
            <WeekDayShow Day="mvarConfig.TNEnvironment.Weekday"/>    
            <span class="clock">@mvarConfig.TNEnvironment.Now.ToString("HH:mm:ss")</span>
        }                
    }
    
</div>

@code {
    [CascadingParameter]
    public SessionConfiguration? mvarConfig{get;set;}
}
