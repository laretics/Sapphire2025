@* <VirtualKeyboard></VirtualKeyboard> *@
@using System.Threading.Tasks
@using Sapphire2025Models.Authentication
@using Tourmaline26.Components.Controls
@using Tourmaline26.Components.Controls.Cameras
@using Tourmaline26.Components.Controls.Generical
@using Tourmaline26.Components.Controls.Aeneas
@using Tourmaline26.Components.Controls.Generical.SideMenu
@using Tourmaline26.Components.Controls.Passenger
@inject ILogger<DriverInfotaiment> Logger
@inject Sapphire2025.Storage.IntStorageService InternalStorage
@inject Sapphire2025.Storage.DiamondClient DiamondClient
@inject Sapphire2025.Storage.ExpertClient ExpertClient
<div class="tesla-root @(NightMode?" night":"")">
    @if(mvarTourmaline.SessionConfig.Initialized)
    {
        <ServiceModeFrame MaintenanceMessage="Mantenimiento" Maintenance="@mvarTourmaline.SessionConfig.ServiceMode.Main">
            <div class="tesla-main">
                @if(mvarTourmaline.SystemConfig.ToniCruz=="right")
                {
                    <div class="tesla-left @panelClass">
                        <TeslaOnyxSection />
                    </div>
                }
                <div class="tesla-right @panelClass">
                    @if (View3DEnabled)
                    {
                        <div class="driver-stream-layer">
                            <SimulatorStream StreamHost="@mvarTourmaline.SystemConfig.TExperienceStr" />
                        </div>
                    }
                    <TeslaNavigationSection />
                    @if (AeneasPanelVisible)
                    {
                        <AeneasLog />
                    }
                    else if (ItineraryPanelVisible)
                    {
                        <ItinerarySheet />
                    }
                    else if (RightPanelVisible)
                    {
                        <SideMenu @ref="mvarSideMenu" />
                    }
                </div>
                @if (mvarTourmaline.SystemConfig.ToniCruz != "right")
                {
                    <div class="tesla-left @panelClass">
                        <TeslaOnyxSection />
                    </div>
                }
                @if (CameraViewMode)
                {
                    <CamerasView></CamerasView>
                }
                else if (PassengerAnnouncementViewMode)
                {
                    <FloatPassengerInformation />
                }
            </div>
            @if (LoginMode)
            {
                <LoginCtl Login="OnUserLogin" />
            }
        </ServiceModeFrame>
        <div class="tesla-bottom-bar">
            <TeslaToolBar Buttons="buttonData" @ref="mvarTeclado" />
        </div>
    }
    else
    {
        <SystemLoadingDialog/>        
    }
</div>
@code {
    [Inject]
    private IJSRuntime JS { get; set; } = default!;
    [Inject]
    private TourmalineService mvarTourmaline{ get; set; }=default!;
    [Inject]
    private UserPreferencesService Prefs { get; set; } = default!;
    [CascadingParameter]
    public bool NightMode{ get; set; }
    [CascadingParameter]
    public Action<bool>? ToggleNightMode { get; set; }
    private TeslaToolBar? mvarTeclado{ get; set; }
    private SideMenu? mvarSideMenu{ get; set; }
    string mvarStreamUrl = "http://localhost:5005/stream";
    private bool LoginMode { get; set; } = false;
    public enum MainToolBarItem:byte
    {
        Train=0,
        NightMode=1,
        CCTV = 2,
        Microphone = 3,
        View3d = 4,
        Mesh = 7,
        Clipboard = 8,
        UserSession = 9
    }
    private bool ZeroSpeed { get => mvarTourmaline.SessionConfig.CurrentSpeed < 10; }
    private static readonly string[] OverlayPanelKeys =
    {
        "Cameras",
        "Microphone",
        "Itinerary",
        "DamageClipboard"
    };
    private static readonly string[] SessionRequiredKeys =
    {
        "Cameras",
        "Microphone",
        "View3D",
        "Itinerary",
        "DamageClipboard"
    };
    private bool HasSession => mvarTourmaline.SessionConfig.Session is not null;
    private Dictionary<string, TeslaButton?> buttonData = new Dictionary<string, TeslaButton?>();
    protected async override Task OnInitializedAsync()
    {
        buttonData.Add("Main Menu", new TeslaButton("Train", null, true, EventCallback.Factory.Create(this, () => OnPanelButtonChanged("Main Menu"))));
        buttonData.Add("Night Mode",new TeslaButton( "BlackSun", "WhiteSun", true, EventCallback.Factory.Create(this, () => NightModeChanged())));
        buttonData.Add("Cameras", new TeslaButton("CCTV", null, true, EventCallback.Factory.Create(this, () => OnPanelButtonChanged("Cameras"))));
        buttonData.Add("Microphone", new TeslaButton("Microphone", null, true, EventCallback.Factory.Create(this, () => OnPanelButtonChanged("Microphone"))));
        // Icon[0]=no seleccionado (3D apagado), Icon[1]=seleccionado (3D encendido). Debe coincidir con View3DEnabled.
        // Arranca activado: stream 3D visible e icono 3DOn.
        var view3D = new TeslaButton("3DOff", "3DOn", true, EventCallback.Factory.Create(this, () => OnButtonInternalChanged()));
        view3D.Selected = true;
        buttonData.Add("View3D", view3D);
        buttonData.Add("Spc0", null);
        buttonData.Add("Spc1", null);
        buttonData.Add("Itinerary", new TeslaButton("Itinerary", null, true, EventCallback.Factory.Create(this, () => OnPanelButtonChanged("Itinerary")), false, false));
        buttonData.Add("DamageClipboard", new TeslaButton("Clipboard", null, true, EventCallback.Factory.Create(this, () => OnPanelButtonChanged("DamageClipboard")),false,true));
        buttonData.Add("Login", new TeslaButton("KeyOff", "Key", false, EventCallback.Factory.Create(this, () => OnLoginRequest()), false, true));
        if (mvarTourmaline.SystemConfig.ToniCruz == "left")
            buttonData = buttonData.Reverse().ToDictionary(kvp => kvp.Key, kvp => kvp.Value);

        SyncPanelAvailability();
        mvarTourmaline.HMIUpdateRequested += auxHMIRefresh;
        await Prefs.LoadLocalAsync();
    }
    private bool auxButtonSelected(string index)
    {
        return null != buttonData && (buttonData[index]?.Selected ?? false);
    }
    private void auxButtonSelect(string index, bool rhs)
    {
        if (true == buttonData?.TryGetValue(index, out var button) && null!= button)
            button.Selected = rhs;
    }
    private void OnButtonInternalChanged()
    {
        auxButtonSelect("Login", null != mvarTourmaline.SessionConfig.Session);
        SyncPanelAvailability();
        SyncMicrophoneAnnouncementIndicator();
        StateHasChanged();
    }

    /// <summary>
    /// Pila de paneles del área cliente: Main Menu es la base.
    /// Las demás capas son excluyentes entre sí; al pulsar Main Menu se vacían.
    /// </summary>
    private void OnPanelButtonChanged(string key)
    {
        auxButtonSelect("Login", null != mvarTourmaline.SessionConfig.Session);

        TeslaButton? pressed = GetPanelButton(key);
        if (pressed is null)
        {
            OnButtonInternalChanged();
            return;
        }

        if (!pressed.Enabled)
        {
            pressed.Selected = false;
            SyncPanelAvailability();
            SyncMicrophoneAnnouncementIndicator();
            StateHasChanged();
            return;
        }

        if (string.Equals(key, "Main Menu", StringComparison.Ordinal))
        {
            if (pressed.Selected)
                DeselectOverlayPanels();
        }
        else if (pressed.Selected)
        {
            int i = 0;
            while (i < OverlayPanelKeys.Length)
            {
                string other = OverlayPanelKeys[i];
                if (!string.Equals(other, key, StringComparison.Ordinal))
                    auxButtonSelect(other, false);
                i++;
            }
        }

        SyncPanelAvailability();
        SyncMicrophoneAnnouncementIndicator();
        StateHasChanged();
    }

    private TeslaButton? GetPanelButton(string index)
    {
        if (buttonData is null || !buttonData.TryGetValue(index, out var button))
            return null;
        return button;
    }

    private void DeselectOverlayPanels()
    {
        int i = 0;
        while (i < OverlayPanelKeys.Length)
        {
            auxButtonSelect(OverlayPanelKeys[i], false);
            i++;
        }
    }

    private bool CanShowPanel(string key)
    {
        TeslaButton? button = GetPanelButton(key);
        if (button is null || !button.Enabled || !button.Selected)
            return false;

        if (string.Equals(key, "Itinerary", StringComparison.Ordinal))
            return HasActiveTrain;
        if (string.Equals(key, "DamageClipboard", StringComparison.Ordinal))
            return ZeroSpeed;
        return true;
    }

    private string? VisibleOverlayKey
    {
        get
        {
            int i = 0;
            while (i < OverlayPanelKeys.Length)
            {
                string key = OverlayPanelKeys[i];
                if (CanShowPanel(key))
                    return key;
                i++;
            }

            return null;
        }
    }

    /// <summary>
    /// Micrófono en amarillo mientras hay un anuncio visible en los monitores de viajero.
    /// </summary>
    private void SyncMicrophoneAnnouncementIndicator()
    {
        if (buttonData is null
            || !buttonData.TryGetValue("Microphone", out var mic)
            || mic is null)
            return;

        var session = mvarTourmaline.SessionConfig;
        bool announcing =
            session.PassengerAnnouncementEnabled
            && session.PassengerAnnouncement is not null
            && session.PassengerAnnouncement.IsVisible;

        // Amarillo Bootstrap warning (#ffc107) — visible en día y noche.
        mic.ForceColor = announcing ? "#ffc107" : null;
        mic.Highlight = announcing;
    }
    private bool AeneasPanelVisible
    {        
        get => string.Equals(VisibleOverlayKey, "DamageClipboard", StringComparison.Ordinal);
    }
    private bool ItineraryPanelVisible
    {
        get => string.Equals(VisibleOverlayKey, "Itinerary", StringComparison.Ordinal);
    }
    private bool HasActiveTrain
    {
        get => mvarTourmaline.SessionConfig.Cabin?.Circulation is not null;
    }

    private void SyncPanelAvailability()
    {
        if (buttonData is null)
            return;

        bool loggedIn = HasSession;
        bool zeroSpeed = ZeroSpeed;
        foreach (TeslaButton? auxBoton in buttonData.Values)
        {
            if (null != auxBoton && auxBoton.DisableOnMotion)
                auxBoton.Enabled = zeroSpeed;
        }

        if (buttonData.TryGetValue("Itinerary", out var itinerary) && itinerary is not null)
            itinerary.Enabled = HasActiveTrain;

        int s = 0;
        while (s < SessionRequiredKeys.Length)
        {
            string key = SessionRequiredKeys[s];
            TeslaButton? required = GetPanelButton(key);
            if (required is not null)
            {
                if (!loggedIn)
                {
                    required.Enabled = false;
                }
                else if (!required.DisableOnMotion
                    && !string.Equals(key, "Itinerary", StringComparison.Ordinal))
                {
                    required.Enabled = true;
                }
            }

            s++;
        }

        int i = 0;
        while (i < OverlayPanelKeys.Length)
        {
            TeslaButton? overlay = GetPanelButton(OverlayPanelKeys[i]);
            if (overlay is not null && !overlay.Enabled)
                overlay.Selected = false;
            i++;
        }

        TeslaButton? view3d = GetPanelButton("View3D");
        if (view3d is not null && !view3d.Enabled)
            view3d.Selected = false;
    }
    private bool RightPanelVisible
    {
        get => VisibleOverlayKey is null && auxButtonSelected("Main Menu");
    }
    private bool CameraViewMode
    {
        get => string.Equals(VisibleOverlayKey, "Cameras", StringComparison.Ordinal);
    }
    private bool PassengerAnnouncementViewMode
    {
        get => string.Equals(VisibleOverlayKey, "Microphone", StringComparison.Ordinal);
    }
    private bool View3DEnabled
    {
        get => auxButtonSelected("View3D");
    }
    private void NightModeChanged()
    {
        ToggleNightMode?.Invoke(auxButtonSelected("Night Mode"));
    }

    [JSInvokable]
    public async Task HandleKey(string key)
    {
        // DemoMode reutiliza el teclado de servicio para consignar límite y velocidad objetivo.
        if (mvarTourmaline.SessionConfig.ServiceMode.ServiceKeyboard
            || mvarTourmaline.SessionConfig.ServiceMode.DemoMode)
            HandleServiceKey(key);
        else
        {
            if (byte.TryParse(key, out _) && null != mvarTeclado)
                await mvarTeclado.ManagePhysicalKeyboard(key);
            if(RightPanelVisible && null!=mvarSideMenu)
                await mvarSideMenu.ManagePhysicalKeyboard(key);
        }
    }


    /// <summary>
    /// Esta función utiliza el teclado físico para probar de forma dinámica los
    /// elementos activos del sistema.
    /// </summary>
    /// <param name="key"></param>
    private void HandleServiceKey(string key)
    {
        SessionConfiguration auxConfig = mvarTourmaline.SessionConfig;
        switch(key)
        {
            case "2": //Aumentar límite.
                auxConfig.CurrentLimitSpeed += 10; break;
            case "1": //Reducir límite.
                auxConfig.CurrentLimitSpeed -= 10; break;
            case "4": //Aumentar objetivo (en DemoMode: consigna de la rampa de velocidad).
                auxConfig.CurrentNeutralSpeed += 10; break;
            case "3": //Reducir objetivo.
                auxConfig.CurrentNeutralSpeed -= 10; break;
        }
    }

    private void auxHMIRefresh(object? sender, EventArgs e) 
    {
        SyncPanelAvailability();
        SyncMicrophoneAnnouncementIndicator();
        InvokeAsync(StateHasChanged); 
    }

    protected async override Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {            
            _ = JS.InvokeVoidAsync("TeslaToolBar_registerKeyHandler", DotNetObjectReference.Create(this));
        }        
    }
    public void Dispose()
    {
        _ = JS.InvokeVoidAsync("TeslaToolBar_unregisterKeyHandler");
        mvarTourmaline.HMIUpdateRequested -= auxHMIRefresh;
    }
    private string panelClass
    {
        get => string.Format("teslapanel {0}", NightMode ? "night" : "day");        
    }


    [Parameter]
    public string MaintenanceMessage { get; set; } = "Modo de Mantenimiento";





    protected async Task OnLoginRequest()
    {
        if(null==mvarTourmaline.SessionConfig.Session)
            LoginMode = true;
        else
            await mvarTourmaline.UserLogout();
        OnButtonInternalChanged();
    }
    protected async Task OnUserLogin((string username, string password) credentials)
    {
        SessionModel? session = await mvarTourmaline.UserLogin(credentials.username, credentials.password);
        if (session is not null)
        {
            await InternalStorage.SetSessionInfo(session);
            TeslaButton? view3d = GetPanelButton("View3D");
            if (view3d is not null)
                view3d.Selected = true;
        }

        LoginMode = false;
        OnButtonInternalChanged();

        if (session is not null)
        {
            try
            {
                await mvarTourmaline.TrySyncAfterLoginAsync(DiamondClient);
            }
            catch (Exception ex)
            {
                Logger.LogWarning(ex, "Resincronización Sapphire tras login omitida");
            }

            try
            {
                await Prefs.LoadFromServerAsync();
            }
            catch (Exception ex)
            {
                Logger.LogWarning(ex, "Preferencias de usuario no cargadas tras login");
            }

            try
            {
                await mvarTourmaline.TryLoadDriverShiftAsync(ExpertClient);
            }
            catch (Exception ex)
            {
                Logger.LogWarning(ex, "Turno grafiado no cargado tras login");
            }

            OnButtonInternalChanged();
        }
    }

}
