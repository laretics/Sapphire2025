@using Tourmaline26.Components.Controls.Floatings
@using Tourmaline26.Components.Controls.Generical
@using Tourmaline26.Components.Controls.Generical.SideMenu
@using Tourmaline26.Components.Controls
@using Diamond.Cabin
@using ProjectCirculation = Diamond.Project.Circulation
@inject TourmalineService Tourmaline
@inject Sapphire2025.Storage.ExpertClient ExpertClient
    <CascadingValue Value="Tourmaline.SessionConfig">
        <TeslaTopRightBar />
        <CascadingValue Value="mvarSearchString">
        <FloatDestinationInput
            IsSearching="mvarSearchingCirculation"
            OnlyUpcoming="mvarOnlyUpcoming"
            OnBeginSearchCirculation="BeginSearchCirculation"
            OnToggleUpcoming="ToggleUpcoming"/>
        @if (mvarSearchingCirculation)
        {
            <FloatDestinationMenu
                OnlyUpcoming="mvarOnlyUpcoming"
                OnCirculationSelected="CirculationSelected"
                OnUnscheduledTrainSelected="UnscheduledTrainSelected"/>

            <VirtualKeyboard
                KeyPressed="KeyPressed"
                EnterPressed="ConfirmSearch"
                IsNumericByDefault="true"
                />
        }
        @if(null!=Tourmaline.SessionConfig)
        {
            @if (Tourmaline.SessionConfig.HasActiveTrain)
            {
                <FloatTrajectScheme OnTerminateCirculationRequest="TerminateCirculation" />
            }
            @if (null != Tourmaline.SessionConfig.LinearLocation.Axis)
            {
                <FloatVehicleLocation />
            }
        }
        </CascadingValue>
    </CascadingValue>
@code {
    private bool mvarSearchingCirculation { get; set; } = false;
    private bool mvarOnlyUpcoming { get; set; } = true;
    private string? mvarSearchString = null;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        Tourmaline.HMIUpdateRequested += auxHMIRefresh;
    }
    public void Dispose()
    {
        Tourmaline.HMIUpdateRequested -= auxHMIRefresh;
    }
    private void auxHMIRefresh(object? sender, EventArgs e)
    {
        InvokeAsync(StateHasChanged);
    }
    private async Task BeginSearchCirculation()
    {
        mvarSearchingCirculation = true;
        if (Tourmaline.SessionConfig.Session is not null
            && !Tourmaline.SessionConfig.DriverShiftLoaded)
        {
            try
            {
                await Tourmaline.TryLoadDriverShiftAsync(ExpertClient);
            }
            catch
            {
                // Sin turno: la lista de maquinista no aparece.
            }
        }

        await InvokeAsync(StateHasChanged);
    }

    private void ToggleUpcoming()
    {
        mvarOnlyUpcoming = !mvarOnlyUpcoming;
        InvokeAsync(StateHasChanged);
    }

    private async Task TerminateCirculation()
    {
        mvarSearchString = null;
        mvarSearchingCirculation = false;
        await Tourmaline.TerminateActiveCirculationAsync();
        Tourmaline.RaiseHMIUpdate();
        Tourmaline.RaisePassengerUpdate();
    }
    private void KeyPressed(char e)
    {
        if (e == '⌫')
        {
            if (null!=mvarSearchString && mvarSearchString.Length > 1)
                mvarSearchString = mvarSearchString.Substring(0, mvarSearchString.Length - 1);
            else
            {
                mvarSearchString = null;
                mvarSearchingCirculation = false;
            }
        }
        else
        {
            if (null == mvarSearchString || mvarSearchString.Length < 1)
                mvarSearchString = e.ToString();
            else
                mvarSearchString += e;
        }
        InvokeAsync(StateHasChanged);
    }
    private async Task CirculationSelected(ProjectCirculation cir)
    {
        mvarSearchingCirculation = false;
        mvarSearchString = null;
        await Tourmaline.DoCirculationSelect(cir);
        Tourmaline.RaiseHMIUpdate();
        Tourmaline.RaisePassengerUpdate();
    }

    private async Task UnscheduledTrainSelected(string token)
    {
        if (!await Tourmaline.SelectUnscheduledTrainAsync(token))
            return;

        mvarSearchingCirculation = false;
        mvarSearchString = null;
    }

    private async Task ConfirmSearch()
    {
        if (!UnscheduledCirculation.LooksLikeTrainToken(mvarSearchString))
            return;

        CabinEnvironment? cabin = Tourmaline.SessionConfig.Cabin;
        if (cabin?.DayProject is not null
            && cabin.SearchCirculations(mvarSearchString).Count > 0)
            return;

        await UnscheduledTrainSelected(mvarSearchString);
    }
}
