@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["Tourmaline26.styles.css"]" />
    <link href="@Assets["css/bootstrap.min.css"]" rel="stylesheet" />
    <link rel="stylesheet" href="_content/Diamond.Controls/css/cabin-mesh.css" />
    <link rel="stylesheet" href="_content/Diamond.Controls/css/diamond-mesh.css" />
    <link rel="stylesheet" href="maps/sfm/css/maplibre-gl.css" />
    <ImportMap />
    @* HMI: sin prerender estático (evita JS interop / localStorage en render SSR). *@
    <HeadOutlet @rendermode="@(new InteractiveServerRenderMode(prerender: false))" />
</head>
<body>
    <Routes ClientIp="@DetectedClientIp"
            @rendermode="@(new InteractiveServerRenderMode(prerender: false))" />
    <script src="_framework/blazor.web.js"></script>
    <script src="_content/Diamond.Controls/js/cabin-itinerary.js"></script>
    <script src="js/hmiKeyboard.js"></script>
    <script src="js/ORTSReceiver.js"></script>
    <script src="js/popupInformation.js"></script>
    <script src="js/nextStationTable.js"></script>
    <script src="maps/sfm/js/maplibre-gl.js"></script>
    <script src="maps/sfm/js/sfm-map.js"></script>
</body>
</html>
@code {
    private string? DetectedClientIp =>
        Tourmaline26.Logic.ClientAddress.ToDisplay(
            HttpContextAccessor.HttpContext?.Connection.RemoteIpAddress);
}