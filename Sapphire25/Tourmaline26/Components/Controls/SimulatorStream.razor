@inject IJSRuntime JS
@implements IAsyncDisposable

<div class="simulator-stream-container @(Blur ? "simulator-stream-blur" : null)">
    @* Canvas siempre en el DOM (y con tamaño real) para que JS pueda dibujar y reconectar. *@
    <canvas id="videoCanvas" class="simulator-stream-canvas"></canvas>
    @* Fallback visible hasta el primer frame válido; se superpone al canvas. *@
    @if (!StreamDisponible)
    {
        <img src="img/TourmalineBack.png" class="simulator-stream-img" alt="" />
    }
</div>

@code {
    [Parameter]
    public string? StreamHost { get; set; }

    /// <summary>Aplica desenfoque CSS al stream y a la imagen de fallback.</summary>
    [Parameter]
    public bool Blur { get; set; }

    /// <summary>
    /// true solo cuando ya se ha recibido al menos un frame de la conexión actual.
    /// Mientras sea false se muestra TourmalineBack.png.
    /// </summary>
    private bool StreamDisponible = false;

    private bool mvarJsInteropEnabled = false;
    private bool mvarDisposed = false;
    private bool mvarStarting = false;
    private bool mvarWantsStream = false;
    private bool mvarReconnecting = false;
    private int reintentos = 0;
    private DotNetObjectReference<SimulatorStream>? mvarDotNetRef;

    /// <summary>
    /// Backoff entre reintentos (ms). Corto a propósito: el fallback de
    /// TourmalineBack no debe quedarse segundos en pantalla.
    /// </summary>
    private static readonly int[] BackoffMs = { 80, 150, 250, 400 };

    /// <summary>
    /// Fallos seguidos antes de tapar el último frame con el fallback.
    /// Un glitch de 1–2 reconexiones no debe mostrar TourmalineBack.
    /// </summary>
    private const int FallbackAfterFailures = 3;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (mvarDisposed || string.IsNullOrEmpty(StreamHost))
            return;

        if (firstRender || mvarWantsStream)
        {
            mvarWantsStream = false;
            await StartStreamAsync();
        }
    }

    private async Task StartStreamAsync()
    {
        if (mvarDisposed || string.IsNullOrEmpty(StreamHost) || mvarStarting)
            return;

        mvarStarting = true;
        try
        {
            mvarJsInteropEnabled = true;
            // No marcar StreamDisponible aquí: el fallback debe seguir visible
            // hasta OnStreamRecovered (primer frame).

            mvarDotNetRef?.Dispose();
            mvarDotNetRef = DotNetObjectReference.Create(this);

            await JS.InvokeVoidAsync("startWebSocketStreamWithFallback", StreamHost, mvarDotNetRef);
        }
        catch (JSDisconnectedException)
        {
            // Circuito Blazor desconectado: no reintentar
        }
        catch (Exception ex)
        {
            Console.WriteLine($"SimulatorStream: error al iniciar stream: {ex.Message}");
            await ScheduleReconnectAsync();
        }
        finally
        {
            mvarStarting = false;
        }
    }

    [JSInvokable]
    public async Task OnStreamError()
    {
        if (mvarDisposed)
            return;

        await ScheduleReconnectAsync();
    }

    /// <summary>
    /// Primer frame válido: ocultar fallback y resetear backoff.
    /// </summary>
    [JSInvokable]
    public void OnStreamRecovered()
    {
        if (mvarDisposed)
            return;

        reintentos = 0;
        if (!StreamDisponible)
        {
            StreamDisponible = true;
            _ = InvokeAsync(StateHasChanged);
        }
    }

    private async Task ScheduleReconnectAsync()
    {
        // Evitar múltiples reintentos en paralelo (stall + onclose, etc.)
        if (mvarDisposed || mvarReconnecting)
            return;

        mvarReconnecting = true;
        try
        {
            reintentos++;
            // Si ya había vídeo, dejar el último frame en el canvas unos
            // reintentos; el fallback solo sale si el origen no vuelve.
            if (StreamDisponible && reintentos >= FallbackAfterFailures)
            {
                StreamDisponible = false;
                await InvokeAsync(StateHasChanged);
            }

            int delay = BackoffMs[Math.Min(reintentos - 1, BackoffMs.Length - 1)];
            Console.WriteLine($"SimulatorStream: reconexión #{reintentos} en {delay} ms…");

            await Task.Delay(delay);

            if (mvarDisposed)
                return;

            mvarWantsStream = true;
            await InvokeAsync(StateHasChanged);
        }
        finally
        {
            mvarReconnecting = false;
        }
    }

    public async ValueTask DisposeAsync()
    {
        mvarDisposed = true;
        if (mvarJsInteropEnabled)
        {
            try
            {
                await JS.InvokeVoidAsync("stopWebSocketStream");
            }
            catch (JSDisconnectedException) { }
            catch (ObjectDisposedException) { }
        }

        mvarDotNetRef?.Dispose();
        mvarDotNetRef = null;
    }
}
