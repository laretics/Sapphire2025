@using Tourmaline26.Components.Images
<div class="tesla-toolbar">
    @for (int i = 0; i < Buttons.Length; i++)
    {
        var btnIndex = i;
        <button class="toolbar-btn @Buttons[btnIndex].Class"
                @onpointerdown="() => PressButton(btnIndex)"
                @onpointerup="() => ReleaseButton(btnIndex)"
                @onclick="() => OnButtonClick(btnIndex)"
                disabled="@(!Buttons[btnIndex].Enabled)">
                <ColorIcon Name="@Buttons[btnIndex].Icon"></ColorIcon>
        </button>
    }
</div>

@code {
    [Inject]
    private IJSRuntime JS { get; set; } = default!;
    // Define los datos de los botones aquí
    [Parameter]
    public TeslaButton[] Buttons{ get; set; }  = new TeslaButton[]
    {
        new("Train", "MainMenu")
    };

    [JSInvokable]
    public async Task HandleKey(string key)
    {
        int btnIndex = key switch
        {
            "1" => 0,
            "2" => 1,
            "3" => 2,
            "4" => 3,
            "5" => 4,
            "6" => 5,
            "7" => 6,
            "8" => 7,
            "9" => 8,
            "0" => 9,
            _ => -1
        };
        if (btnIndex >= 0 && btnIndex < Buttons.Length && Buttons[btnIndex].Enabled)
        {
            PressButton(btnIndex);
            await OnButtonClick(btnIndex);
            ReleaseButton(btnIndex);
        }
    }

    private void PressButton(int btn)
    {
        Buttons[btn].Press();
        StateHasChanged();
    }

    private async void ReleaseButton(int btn)
    {
        await Task.Delay(180);
        Buttons[btn].Release();
        StateHasChanged();
    }

    private async Task OnButtonClick(int btn)
    {
        if(Buttons.Length>btn)
            await Buttons[btn].Callback.InvokeAsync();
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            // Registrar el evento de teclado
            _ = JS.InvokeVoidAsync("TeslaToolBar_registerKeyHandler", DotNetObjectReference.Create(this));
        }
    }

    public void Dispose()
    {
        _ = JS.InvokeVoidAsync("TeslaToolBar_unregisterKeyHandler");
    }
}