@using Tourmaline26.Components.Images
@using System.Net.Http;
@inject Tourmaline26.Components.Services.TourmalineService Tourmaline
<div class="tesla-top-right-bar">
    @if(null!=Tourmaline.SessionConfig.Session && null!=Tourmaline.SessionConfig.Session.User)
    {
        <span><RoleIcon 
            Size="24" 
            Credentials="Tourmaline.SessionConfig.Session.Roles"/>
        </span>
        <span>
            <b>@Tourmaline.SessionConfig.Session.User.Name</b>
        </span>
    }
    @if(Tourmaline.SessionConfig.MVBEnabled)
    {
        if(null==Tourmaline.SessionConfig.CurrentMVBData)
        {
            <ColorIcon Name="MVB" Size="24" Color="red"></ColorIcon>
        }
        else
        {
            <ColorIcon Name="MVB" Size="24"></ColorIcon>
        }
    }
    @if(Tourmaline.SessionConfig.GPSEnabled)
    {
        if (Tourmaline.SessionConfig.GPSOK)
        {
            <ColorIcon Name="Satellite" Size="24"></ColorIcon>
        }
        else
        {
            <ColorIcon Name="NoLocation" Size="24"></ColorIcon>
        }
    }        
    @if(Tourmaline.SessionConfig.InternetEnabled)
    {
        @if (Tourmaline.SessionConfig.InternetOK)
        {
            <ColorIcon Name="Internet" Size="24"></ColorIcon>
        }
        else
        {
            <ColorIcon Name="NoInternet" Size="24"></ColorIcon>
        }
    }
    <span class="clock">@Tourmaline.Now.ToString("HH:mm:ss")</span>
</div>

@code {
    protected override void OnInitialized()
    {
        base.OnInitialized();
        Tourmaline.HMIUpdateRequested += auxHMIRefresh;
    }
    public void Dispose()
    {
        Tourmaline.HMIUpdateRequested -= auxHMIRefresh;
    }
    private void auxHMIRefresh(object? sender, EventArgs e) { InvokeAsync(StateHasChanged); }
}
