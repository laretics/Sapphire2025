@using System.Globalization
@code {
    // Velocidad actual y máxima permitida
    double Speed = 80; // km/h
    double MaxAllowedSpeed = 120; // km/h

    // Escala
    double MinSpeed = 0;
    double MaxSpeed = 200;
    double StartAngle = -120; // izquierda
    double EndAngle = 120;    // derecha

    // Valores de la escala principal
    int[] ScaleValues = new int[] { 0, 40, 80, 120, 160, 200 };

    // Calcula el ángulo para una velocidad dada
    double GetAngle(double value) =>
        StartAngle + (EndAngle - StartAngle) * ((value - MinSpeed) / (MaxSpeed - MinSpeed));

    // Para la franja de velocidad máxima permitida
    string GetMaxArcPath()
    {
        var r = 80;
        var startAngle = GetAngle(MinSpeed);
        var endAngle = GetAngle(Math.Min(MaxAllowedSpeed, MaxSpeed));
        var startRad = Math.PI * startAngle / 180.0;
        var endRad = Math.PI * endAngle / 180.0;
        var x1 = 100 + r * Math.Cos(startRad);
        var y1 = 100 + r * Math.Sin(startRad);
        var x2 = 100 + r * Math.Cos(endRad);
        var y2 = 100 + r * Math.Sin(endRad);
        var largeArc = (endAngle - startAngle) > 180 ? 1 : 0;
        return $"M{x1.ToString(CultureInfo.InvariantCulture)},{y1.ToString(CultureInfo.InvariantCulture)} A{r.ToString(CultureInfo.InvariantCulture)},{r.ToString(CultureInfo.InvariantCulture)} 0 {largeArc} 1 {x2.ToString(CultureInfo.InvariantCulture)},{y2.ToString(CultureInfo.InvariantCulture)}";
    }

    // Aguja
    double NeedleAngle => GetAngle(Speed);
    double NeedleX => 100 + (80 * Math.Cos(Math.PI * NeedleAngle / 180.0));
    double NeedleY => 100 + (80 * Math.Sin(Math.PI * NeedleAngle / 180.0));
}

<div class="speedometer-container">
    <svg viewBox="0 0 200 200" class="speedometer-svg">
        <defs>
            <radialGradient id="dialGradient" cx="50%" cy="50%" r="50%">
                <stop offset="0%" stop-color="#fff" />
                <stop offset="100%" stop-color="#e0e3e8" />
            </radialGradient>
            <linearGradient id="needleGradient" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%" stop-color="#e53935" />
                <stop offset="100%" stop-color="#b71c1c" />
            </linearGradient>
            <linearGradient id="maxArcGradient" x1="0%" y1="0%" x2="100%" y2="0%">
                <stop offset="0%" stop-color="#4fc3f7" stop-opacity="0.7" />
                <stop offset="100%" stop-color="#0288d1" stop-opacity="0.7" />
            </linearGradient>
        </defs>
        <!-- Fondo -->
        <ellipse cx="100" cy="100" rx="90" ry="90" fill="url(#dialGradient)" stroke="#bbb" stroke-width="4" />
        <!-- Franja de velocidad máxima -->
        <path d="@GetMaxArcPath()" fill="none" stroke="url(#maxArcGradient)" stroke-width="12" stroke-linecap="round" />
        <!-- Ticks y números -->
        @foreach (var value in ScaleValues)
        {
            var angle = GetAngle(value);
            var rad = Math.PI * angle / 180.0;
            var x1 = 100 + 78 * Math.Cos(rad);
            var y1 = 100 + 78 * Math.Sin(rad);
            var x2 = 100 + 88 * Math.Cos(rad);
            var y2 = 100 + 88 * Math.Sin(rad);
            var tx = 100 + 62 * Math.Cos(rad);
            var ty = 100 + 62 * Math.Sin(rad) + 6;
            <line x1="@x1.ToString(CultureInfo.InvariantCulture)" y1="@y1.ToString(CultureInfo.InvariantCulture)" x2="@x2.ToString(CultureInfo.InvariantCulture)" y2="@y2.ToString(CultureInfo.InvariantCulture)" stroke="#888" stroke-width="3" />
            <svg:text x="@tx.ToString(CultureInfo.InvariantCulture)" y="@ty.ToString(CultureInfo.InvariantCulture)" text-anchor="middle" font-size="18" fill="#222" font-family="Segoe UI">@value</svg:text>
        }
        <!-- Ticks menores -->
        @for (int i = 0; i < ScaleValues.Length - 1; i++)
        {
            for (int j = 1; j < 4; j++)
            {
                var value = ScaleValues[i] + (ScaleValues[i + 1] - ScaleValues[i]) * j / 4.0;
                var angle = GetAngle(value);
                var rad = Math.PI * angle / 180.0;
                var x1 = 100 + 82 * Math.Cos(rad);
                var y1 = 100 + 82 * Math.Sin(rad);
                var x2 = 100 + 88 * Math.Cos(rad);
                var y2 = 100 + 88 * Math.Sin(rad);
                <line x1="@x1.ToString(CultureInfo.InvariantCulture)" y1="@y1.ToString(CultureInfo.InvariantCulture)" x2="@x2.ToString(CultureInfo.InvariantCulture)" y2="@y2.ToString(CultureInfo.InvariantCulture)" stroke="#bbb" stroke-width="1.5" />
            }
        }
        <!-- Aguja -->
        <g>
            <line x1="100" y1="100" x2="@NeedleX.ToString(CultureInfo.InvariantCulture)" y2="@NeedleY.ToString(CultureInfo.InvariantCulture)" stroke="url(#needleGradient)" stroke-width="6" stroke-linecap="round" />
            <circle cx="100" cy="100" r="10" fill="#fff" stroke="#e53935" stroke-width="4" />
        </g>
        <!-- Indicador digital -->
        <svg:text x="100" y="135" text-anchor="middle" font-size="38" fill="#222" font-family="Segoe UI" font-weight="bold">@((int)Speed)</svg:text>
        <svg:text x="100" y="155" text-anchor="middle" font-size="18" fill="#888" font-family="Segoe UI">km/h</svg:text>
        <!-- Efecto cristal superior -->
        <ellipse cx="100" cy="80" rx="60" ry="20" fill="#fff" opacity="0.18" />
    </svg>
</div>

<style>
    .speedometer-container {
        width: 100%;
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        background: transparent;
        overflow: hidden;
    }

    .speedometer-svg {
        width: 100%;
        height: 100%;
        max-width: 100%;
        max-height: 100%;
        display: block;
    }
</style>