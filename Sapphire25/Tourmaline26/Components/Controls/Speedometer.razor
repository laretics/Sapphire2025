@using System.Globalization
<div class="ratio ratio-1x1">
    <svg viewBox="0 0 200 200" width="100%" height="100%" style="background: transparent;">
        <defs>
            <filter id="halo" x="-50%" y="-50%" width="200%" height="200%">
                <feDropShadow dx="0" dy="0" stdDeviation="4" flood-color="#7d8ae6" flood-opacity="0.7" />
            </filter>
        </defs>
        <g transform="rotate(180,100,100) scale(-1,1) translate(-200,0)">
            <!-- Arco exterior: velocidad máxima -->
            <path d="@MaxSpeedPath"
                  fill="none"
                  stroke="var(--onyx-speed-limit)"
                  stroke-width="5"
                  filter="url(#halo)" />

            @{
                // Ángulo final del arco de velocidad máxima
                double angle = SpeedToAngle(MaxSpeed);
                // Punto de inicio (borde exterior)
                var (x1, y1) = PolarToCartesian(100, 100, 88, angle);
                // Punto de fin (10 unidades hacia el centro)
                var (x2, y2) = PolarToCartesian(100, 100, 74, angle);
            }
            <line x1="@x1.ToString(CultureInfo.InvariantCulture)"
                  y1="@y1.ToString(CultureInfo.InvariantCulture)"
                  x2="@x2.ToString(CultureInfo.InvariantCulture)"
                  y2="@y2.ToString(CultureInfo.InvariantCulture)"
                  stroke="#cccccc" stroke-width="3" filter="url(#halo)" />

            <!-- Rayas radiales: velocidad actual con degradado -->
            @{
                var ticks = GetCurrentSpeedTicks().ToList();
                int total = ticks.Count;
                for (int i = 0; i < total; i++)
                {
                    var tick = ticks[i];
                    // Degradado de azul claro a azul oscuro
                    <line x1="@tick.X1.ToString(CultureInfo.InvariantCulture)"
                      y1="@tick.Y1.ToString(CultureInfo.InvariantCulture)"
                      x2="@tick.X2.ToString(CultureInfo.InvariantCulture)"
                      y2="@tick.Y2.ToString(CultureInfo.InvariantCulture)"
                          stroke="var(--onyx-speed-current)" stroke-width="5" />
                }
            }
            <!-- Arco interior: velocidad neutral -->
            <path d="@NeutralSpeedPath"
                  fill="none"
                  stroke="var(--onyx-speed-neutral)"
                  stroke-width="5"
                  filter="url(#halo)" />
        </g>
        <!-- Velocidad actual (negro, centrado) -->
        <text x="100" y="100"
              text-anchor="middle"
              dominant-baseline="middle"
              font-size="53"
              font-family="Segoe UI, Arial, sans-serif"
              fill="#222">
            @CurrentSpeed
        </text>
        <text x="100" y="135"
              text-anchor="middle"
              font-size="16"
              font-family="Segoe UI, Arial, sans-serif"
              fill="#444">
            Km h
        </text>

        <!-- Tiempo de demora (rojo, abajo izquierda) -->
        <text x="95" y="188"
              text-anchor="end"
              font-size="32"
              font-family="Segoe UI, Arial, sans-serif"
              fill="#e53935"
              font-weight="bold">
            @DelayMinutes
            <tspan dy="-12" font-size="16">@DelaySeconds</tspan>
            <tspan dy="12" x="88" font-size="16" fill="#e53935">m</tspan>
        </text>
    </svg>
</div>
@code {
    [Parameter]
    public int CurrentSpeed { get; set; } = 85;
    [Parameter]
    public int MaxSpeed { get; set; } = 100;
    [Parameter]
    public int NeutralSpeed { get; set; } = 20;
    [Parameter]
    public int MaxRepresentableSpeed { get; set; } = 120;
    [Parameter]
    public TimeSpan CurrentDelay { get; set; } = new TimeSpan(0,1,3);

    private string MaxSpeedPath => DescribeArc(100, 100, 86, 0, SpeedToAngle(MaxSpeed));
    private string NeutralSpeedPath => DescribeArc(100, 100, 66, 0, SpeedToAngle(NeutralSpeed));

    private string DelayMinutes { get => string.Format("{0}", CurrentDelay.Minutes); }
    private string DelaySeconds { get => string.Format("{0}", CurrentDelay.Seconds); }

    private IEnumerable<(double X1, double Y1, double X2, double Y2)> GetCurrentSpeedTicks()
    {
        int tickCount = 36;
        double minAngle = 2;
        double maxAngle = SpeedToAngle(CurrentSpeed)+2;
        double r1 = 70;
        double r2 = 82;

        if (maxAngle < minAngle) yield break;

        for (int i = 0; i <= tickCount; i++)
        {
            double angle = minAngle + (maxAngle - minAngle) * i / tickCount;
            var (x1, y1) = PolarToCartesian(100, 100, r1, angle);
            var (x2, y2) = PolarToCartesian(100, 100, r2, angle);
            yield return (x1, y1, x2, y2);
        }
    }

    private string DescribeArc(double cx, double cy, double r, double startAngle, double endAngle)
    {
        var start = PolarToCartesian(cx, cy, r, endAngle);
        var end = PolarToCartesian(cx, cy, r, startAngle);
        var largeArcFlag = endAngle - startAngle <= 180 ? "0" : "1";
        return string.Format(CultureInfo.InvariantCulture,
            "M {0} {1} A {2} {2} 0 {3} 0 {4} {5}",
            start.X, start.Y, r, largeArcFlag, end.X, end.Y);
    }

    private (double X, double Y) PolarToCartesian(double cx, double cy, double r, double angleDeg)
    {
        double angleRad = (angleDeg - 90) * Math.PI / 180.0;
        return (cx + r * Math.Cos(angleRad), cy + r * Math.Sin(angleRad));
    }

    private double SpeedToAngle(int speed)
    {
        double minAngle = 0;
        double maxAngle = 270;
        double angle = minAngle + (maxAngle - minAngle) * (speed / (double)MaxRepresentableSpeed);
        return angle;
    }

    private (int, int, int) HexToRgb(string hex)
    {
        hex = hex.Replace("#", "");
        int r = int.Parse(hex.Substring(0, 2), NumberStyles.HexNumber);
        int g = int.Parse(hex.Substring(2, 2), NumberStyles.HexNumber);
        int b = int.Parse(hex.Substring(4, 2), NumberStyles.HexNumber);
        return (r, g, b);
    }
}