@using BlazorBootstrap
@using TimeNetComponents.TreeView
@using Tourmaline26.Components.Controls.Floatings
@using Tourmaline26.Components.Images
@inject Services.TourmalineService TourmalineService
<Tourmaline26.Components.Controls.Generical.Switch 
    Label="MVB Main" 
    Value="@TourmalineService.SessionConfig.MVBEnabled"
    ValueChanged="@((bool v) => SetMVBEnabled(v))"/>
@if(TourmalineService.SessionConfig.MVBLastUpdate>DateTime.MinValue)
{
    <p>Last update: @TourmalineService.SessionConfig.MVBLastUpdate</p>
}
else
{
    <p>No updates yet</p>
}
@if(TourmalineService.SessionConfig.MVBError.Length>0)
{
    <div class="alert alert-danger" role="alert">
        @TourmalineService.SessionConfig.MVBError
    </div>
}
@if(TourmalineService.SessionConfig.MVBEnabled && null!=TourmalineService.SessionConfig.CurrentMVBData)
{
    <table class="table table-striped table-bordered mt-4">
        <thead>
            <tr>
                <th>Field</th>
                <th>Value</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td>Speed</td>
                <td>@TourmalineService.SessionConfig.CurrentMVBData.current_speed</td>
            </tr>
            <tr>
                <td>Odometer</td>
                <td>@TourmalineService.SessionConfig.CurrentMVBData.odometer</td>
            </tr>
            <tr>
                <td>Time</td>
                <td>@TourmalineService.SessionConfig.CurrentMVBData.system_time</td>
            </tr>
            <tr>
                <td>Speed validator?</td>
                <td>@TourmalineService.SessionConfig.CurrentMVBData.speed_validator</td>
            </tr>
        </tbody>
    </table>

        <table class="table table-striped table-bordered mt-4">
        <thead>
            <tr>
                <th>Order</th>
                <th>Zero</th>
                <th>T M1</th>
                <th>T M2</th>
                <th>T Loop</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td>
                    <BooleanFlag value="@TourmalineService.SessionConfig.CurrentMVBData.drive_command" />
                </td>
                <td>
                    <BooleanFlag value="@TourmalineService.SessionConfig.CurrentMVBData.speed_zero" />
                </td>
                <td>
                    <BooleanFlag value="@TourmalineService.SessionConfig.CurrentMVBData.traction_dir_m1" />
                </td>
                <td>
                    <BooleanFlag value="@TourmalineService.SessionConfig.CurrentMVBData.traction_dir_m2" />
                </td>
                <td>
                    <BooleanFlag value="@TourmalineService.SessionConfig.CurrentMVBData.traction_loop" />
                </td>
            </tr>
        </tbody>
    </table>

    <p>Inverter</p>    
        <table class="table table-striped table-bordered mt-4">
            <tr>
                <th>Rev</th>
                <th>Iddle</th>
                <th>Tunnel</th>
                <th>Shunt</th>
                <th>Fw</th>
            </tr>
        <thead>
        </thead>
        <tbody>
            <tr>
                <td>
                    <BooleanFlag value="@TourmalineService.SessionConfig.CurrentMVBData.inverter_reverse" />
                </td>
                <td>
                    <BooleanFlag value="@TourmalineService.SessionConfig.CurrentMVBData.inverter_disconnected" />
                </td>
                <td>
                    <BooleanFlag value="@TourmalineService.SessionConfig.CurrentMVBData.inverter_tunnel" />
                </td>
                <td>
                    <BooleanFlag value="@TourmalineService.SessionConfig.CurrentMVBData.inverter_manoeuvre" />
                </td>
                <td>
                    <BooleanFlag value="@TourmalineService.SessionConfig.CurrentMVBData.inverter_forward" />
                </td>
            </tr>
        </tbody>
    </table>
    <p>Handler</p>
    <table class="table table-striped table-bordered mt-4">
        <thead>
            <tr>
                <th>Emerg.</th>
                <th>Brake</th>
                <th>Neutral</th>
                <th>Traction</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td>
                    <BooleanFlag value="@TourmalineService.SessionConfig.CurrentMVBData.handler_emergency_brake" />
                </td>
                <td>
                    <BooleanFlag value="@TourmalineService.SessionConfig.CurrentMVBData.handler_brake" />
                </td>
                <td>
                    <BooleanFlag value="@TourmalineService.SessionConfig.CurrentMVBData.handler_neutral" />
                </td>
                <td>
                    <BooleanFlag value="@TourmalineService.SessionConfig.CurrentMVBData.handler_traction" />
                    @TourmalineService.SessionConfig.CurrentMVBData.traction
                </td>
            </tr>
        </tbody>
    </table>

    <p>Braking</p>
    <table class="table table-striped table-bordered mt-4">
        <thead>
            <tr>
                <th>Value</th>
                <th>M1</th>
                <th>N1</th>
                <th>N2</th>
                <th>M2</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td>@TourmalineService.SessionConfig.CurrentMVBData.brake</td>
                <td>
                    <BooleanFlag Value="@TourmalineService.SessionConfig.CurrentMVBData.brake_loop_m1" />
                </td>
                <td>
                    <BooleanFlag Value="@TourmalineService.SessionConfig.CurrentMVBData.brake_loop_n1" />
                </td>
                <td>
                    <BooleanFlag Value="@TourmalineService.SessionConfig.CurrentMVBData.brake_loop_n2" />
                </td>
                <td>
                    <BooleanFlag Value="@TourmalineService.SessionConfig.CurrentMVBData.brake_loop_m2" />
                </td>
            </tr>
        </tbody>
    </table>
    <p>Cabin Enabled</p>
        <table class="table table-striped table-bordered mt-4">
        <thead>
            <tr>
                <th>M1</th>
                <th>M2</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td>
                    <BooleanFlag Value="@TourmalineService.SessionConfig.CurrentMVBData.cab_enabled_m1" />
                </td>
                <td>
                    <BooleanFlag Value="@TourmalineService.SessionConfig.CurrentMVBData.cab_enabled_m2" />
                </td>
            </tr>
        </tbody>
    </table>
    <p>Doors</p>
    <table class="table table-striped table-bordered mt-4">
        <thead>
            <tr>
                <th>Left</th>
                <th>Loop</th>
                <th>Right</th>
            </tr>            
        </thead>
        <tbody>
             <tr>
                <td>
                    <BooleanFlag Value="@TourmalineService.SessionConfig.CurrentMVBData.doors_enabled_left" />
                </td>
                <td>
                    <BooleanFlag Value="@TourmalineService.SessionConfig.CurrentMVBData.doors_loop" />
                </td>
                <td>
                    <BooleanFlag Value="@TourmalineService.SessionConfig.CurrentMVBData.doors_enabled_right" />
                </td>
            </tr>
        </tbody>
    </table>
    <p>Controls</p>
        <table class="table table-striped table-bordered mt-4">
        <thead>
            <tr>
                <th></th>
                <th>M1</th>
                <th>N1</th>
                <th>N2</th>
                <th>M2</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td>Light</td>
                <td>
                    <BooleanFlag value="@TourmalineService.SessionConfig.CurrentMVBData.passenger_light_m1" />
                </td>
                <td>
                    <BooleanFlag value="@TourmalineService.SessionConfig.CurrentMVBData.passenger_light_n1" />
                </td>
                <td>
                    <BooleanFlag value="@TourmalineService.SessionConfig.CurrentMVBData.passenger_light_n2" />
                </td>
                <td>
                    <BooleanFlag value="@TourmalineService.SessionConfig.CurrentMVBData.passenger_light_m2" />
                </td>
            </tr>
            <tr>
                <td>Temp In</td>
                <td>@TourmalineService.SessionConfig.CurrentMVBData.inside_temp_m1</td>
                <td>@TourmalineService.SessionConfig.CurrentMVBData.inside_temp_n1</td>
                <td>@TourmalineService.SessionConfig.CurrentMVBData.inside_temp_n2</td>
                <td>@TourmalineService.SessionConfig.CurrentMVBData.inside_temp_m2</td>
            </tr>
            <tr>
                <td>Temp Out</td>
                <td>@TourmalineService.SessionConfig.CurrentMVBData.outside_temp_m1</td>
                <td>@TourmalineService.SessionConfig.CurrentMVBData.outside_temp_n1</td>
                <td>@TourmalineService.SessionConfig.CurrentMVBData.outside_temp_n2</td>
                <td>@TourmalineService.SessionConfig.CurrentMVBData.outside_temp_m2</td>
            </tr>
        </tbody>
    </table>
}
else
{
    <Tourmaline26.Components.Controls.Generical.Switch Label="MVB Dummy"
                                                       Value="@TourmalineService.SessionConfig.MVBEnabled"
                                                       ValueChanged="@((bool v) => SetMVBEnabled(v))" />

    @if(TourmalineService.SessionConfig.MVBDummy)
    {
        
    }
}



@code {
    private void SetMVBEnabled(bool value)
    {
        TourmalineService.SessionConfig.MVBEnabled = value;
    }

    private void SetMVBDummy(bool value)
    {
        TourmalineService.SessionConfig.MVBDummy = value;
    }
        
    protected override void OnInitialized()
    {
        base.OnInitialized();
        TourmalineService.HMIUpdateRequested += auxHMIRefresh;
    }
        
    public void Dispose()
    {
        TourmalineService.HMIUpdateRequested -= auxHMIRefresh;
    }
    
    private void auxHMIRefresh(object? sender, EventArgs e)
    {
        InvokeAsync(StateHasChanged);
    }  
}
