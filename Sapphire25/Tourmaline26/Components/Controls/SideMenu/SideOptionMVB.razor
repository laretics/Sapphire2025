@using BlazorBootstrap
@using TimeNetComponents.TreeView
@using Tourmaline26.Components.Controls.Floatings
@using Tourmaline26.Components.Images
@inject Services.TourmalineService Tourmaline
@inject Services.TourmalineExperience.TourmalineExperienceService Experience
<Tourmaline26.Components.Controls.Generical.Switch 
    Label="MVB Main" 
    Value="@Tourmaline.SessionConfig.MVBEnabled"
    ValueChanged="@((bool v) => SetMVBEnabled(v))"/>
@if(Tourmaline.SessionConfig.MVBLastUpdate>DateTime.MinValue)
{
    <p>Last update: @Tourmaline.SessionConfig.MVBLastUpdate</p>
}
else
{
    <p>No updates yet</p>
}
@if(Tourmaline.SessionConfig.MVBError.Length>0)
{
    <div class="alert alert-danger" role="alert">
        @Tourmaline.SessionConfig.MVBError
    </div>
}
@if(Tourmaline.SessionConfig.MVBEnabled && null!=Tourmaline.SessionConfig.CurrentMVBData)
{
    <table class="table table-striped table-bordered mt-4">
        <thead>
            <tr>
                <th>Field</th>
                <th>Value</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td>Speed</td>
                <td>@mvarData.Speed</td>
            </tr>
            <tr>
                <td>Odometer</td>
                <td>@mvarData.Odometer</td>
            </tr>
            <tr>
                <td>Time</td>
                <td>@mvarData.Time</td>
            </tr>
            <tr>
                <td>Speed validator?</td>
                <td>@mvarData.SpeedValidation</td>
            </tr>
        </tbody>
    </table>

        <table class="table table-striped table-bordered mt-4">
        <thead>
            <tr>
                <th>Order</th>
                <th>Zero</th>
                <th>T</th>
                <th>T Loop</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td>
                    <BooleanFlag value="@mvarData.DriveCommand" />
                </td>
                <td>
                    <BooleanFlag value="@mvarData.ZeroSpeed" />
                </td>
                <td>@mvarData.Advance.ToString()</td>
                <td>
                    <BooleanFlag value="@mvarData.TractionLoop" />
                </td>
            </tr>
        </tbody>
    </table>

    <p>Inverter: @mvarData.Inverter.ToString()</p>    
    <p>Handler: @mvarData.Handler.ToString()</p>
    <p>Braking</p>
    <table class="table table-striped table-bordered mt-4">
        <thead>
            <tr>
                <th>Value</th>
                <th>M1</th>
                <th>N1</th>
                <th>N2</th>
                <th>M2</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td>@mvarData.BrakePower</td>
                @for(int i =0;i<4;i++)
                {
                    <td>
                        <BooleanFlag Value="@mvarData.Wagons[i].BrakeLoop" />
                    </td>
                }
            </tr>
        </tbody>
    </table>
    <p>Cabin Enabled: @mvarData.Cabin.ToString()</p>
    <p>Doors</p>
    <table class="table table-striped table-bordered mt-4">
        <thead>
            <tr>
                <th>Left</th>
                <th>Loop</th>
                <th>Right</th>
            </tr>            
        </thead>
        <tbody>
             <tr>
                <td>
                    <BooleanFlag Value="@mvarData.LeftDoors" />
                </td>
                <td>
                    <BooleanFlag Value="@mvarData.DoorsLoop" />
                </td>
                <td>
                    <BooleanFlag Value="@mvarData.RightDoors" />
                </td>
            </tr>
        </tbody>
    </table>
    <p>Controls</p>
        <table class="table table-striped table-bordered mt-4">
        <thead>
            <tr>
                <th></th>
                <th>M1</th>
                <th>N1</th>
                <th>N2</th>
                <th>M2</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td>Light</td>
                @for(int i=0; i<4;i++)
                {
                    <td>
                        <BooleanFlag value="@mvarData.Wagons[i].PassengerLight" />
                    </td>
                }
            </tr>
            <tr>
                <td>Temp In</td>
                @for (int i = 0; i < 4; i++)
                {
                    <td>
                        @mvarData.Wagons[i].InsideTemp
                    </td>
                }
            </tr>
            <tr>
                <td>Temp Out</td>
                @for (int i = 0; i < 4; i++)
                {
                    <td>
                        @mvarData.Wagons[i].OutsideTemp
                    </td>
                }
            </tr>
        </tbody>
    </table>
}
else
{
    <Tourmaline26.Components.Controls.Generical.Switch Label="MVB Dummy"
                                                       Value="@Tourmaline.SessionConfig.MVBEnabled"
                                                       ValueChanged="@((bool v) => SwitchDummyMode(v))" />

    @if(Tourmaline.SessionConfig.MVBDummy && null!=Tourmaline.SessionConfig.CurrentMVBData)
    {
        <div class="mb-3">
            <label>Current Speed (@mvarData.Speed)</label>
            <input type="range"
                    min="0"
                    max="140"
                    value="@mvarData.Speed"
                    @oninput="e => SetCurrentSpeedValue(e.Value?.ToString())" />
        </div>
        <div class="mb-3">
            <label>Inverter</label>
            <div class="btn-group" role="group" aria-label="Inverter">
                <button type="button"
                        class="btn @(mvarData?.Inverter== MVBData.InverterPosition.Reverse? "btn-primary" : "btn-outline-primary")"
                        @onclick="() => SetInverterState(MVBData.InverterPosition.Reverse)">
                    R
                </button>
                <button type="button"
                        class="btn @(mvarData?.Inverter == MVBData.InverterPosition.Iddle ? "btn-dark" : "btn-outline-dark")"
                        @onclick="() => SetInverterState(MVBData.InverterPosition.Iddle)">
                    O
                </button>
                <button type="button"
                        class="btn @(mvarData?.Inverter == MVBData.InverterPosition.Tunnel ? "btn-primary" : "btn-outline-primary")"
                        @onclick="() => SetInverterState(MVBData.InverterPosition.Tunnel)">
                    T
                </button>
                <button type="button"
                        class="btn @(mvarData?.Inverter == MVBData.InverterPosition.Shunting ? "btn-primary" : "btn-outline-primary")"
                        @onclick="() => SetInverterState(MVBData.InverterPosition.Shunting)">
                    M
                </button>
                <button type="button"
                        class="btn @(mvarData?.Inverter == MVBData.InverterPosition.Forward ? "btn-primary" : "btn-outline-primary")"
                        @onclick="() => SetInverterState(MVBData.InverterPosition.Forward)">
                    F
                </button>
            </div>
        </div>
        <div class="mb-3">
            <label>Handler</label>
            <div class="btn-group" role="group" aria-label="Handler">
                <button type="button"
                        class="btn @(mvarData.Handler==MVBData.HandlerPosition.EmergencyBrake ? "btn-danger" : "btn-outline-danger")"
                        @onclick="() => SetHandlerState(MVBData.HandlerPosition.EmergencyBrake)">
                    E
                </button>
                <button type="button"
                        class="btn @(mvarData.Handler == MVBData.HandlerPosition.Braking ? "btn-warning" : "btn-outline-warning")"
                        @onclick="() => SetHandlerState(MVBData.HandlerPosition.Braking)">
                    F
                </button>
                <button type="button"
                        class="btn @(mvarData.Handler == MVBData.HandlerPosition.Iddle ? "btn-dark" : "btn-outline-dark")"
                        @onclick="() => SetHandlerState(MVBData.HandlerPosition.Iddle)">
                    N
                </button>
                <button type="button"
                        class="btn @(mvarData.Handler == MVBData.HandlerPosition.Traction ? "btn-primary" : "btn-outline-primary")"
                        @onclick="() => SetHandlerState(MVBData.HandlerPosition.Traction)">
                    T
                </button>
            </div>
        </div>
        <div class="mb-3">
            <label>Brake (@mvarData.BrakePower)</label>
            <input type="range"
                   min="0"
                   max="100"
                   value="@mvarData.BrakePower"
                   @oninput="e => SetBrakeValue(e.Value?.ToString())" />
        </div>
        <div class="mb-3">
            <label>Traction (@mvarData.TractionPower)</label>
            <input type="range"
                   min="0"
                   max="100"
                   value="@mvarData.TractionPower"
                   @oninput="e => SetTractionValue(e.Value?.ToString())" />
        </div>

        <div class="mb-3">
            <label>Doors Enabled Left</label>
            <input type="checkbox"
                    checked="@mvarData.LeftDoors"
                    @onchange="e => SetDoorsEnabledLeft((bool)e.Value)" />
        </div>
        <div class="mb-3">
            <label>Doors Enabled Right</label>
            <input type="checkbox"
                    checked="@mvarData.RightDoors"
                    @onchange="e => SetDoorsEnabledRight((bool)e.Value)" />
        </div>
        <div class="mb-3">
            <label>Cabin</label>
            <select class="form-select"
                    @bind="mvarData.Cabin"
                    >
                <option value="@MVBData.Habilitation.None">Ninguna</option>
                <option value="@MVBData.Habilitation.M1">M1</option>
                <option value="@MVBData.Habilitation.M2">M2</option>
            </select>
        </div>
        <div class="mb-3">
            <label>Passenger Light</label>
            <input type="checkbox"
                   checked="@mvarData.PassengerLight"
                   @onchange="e => SetPassengerLight((bool)e.Value)" />
        </div>
    }
}

@code {
    private MVBData mvarData = new();
    protected override void OnInitialized()
    {
        base.OnInitialized();
        if(null!=Tourmaline.SessionConfig.CurrentMVBData)
            mvarData = Tourmaline.SessionConfig.CurrentMVBData;
        Tourmaline.HMIUpdateRequested += auxHMIRefresh;
    }
    void SwitchDummyMode(bool rhs)
    {
        mvarData = new MVBData();
        Tourmaline.SessionConfig.MVBDummy = rhs;
        Tourmaline.SessionConfig.CurrentMVBData = mvarData;
    }
    void SetHandlerState(MVBData.HandlerPosition state)
    {
        mvarData.Handler = state;
        mvarData.SimulateLoops();
    }
    void SetInverterState(MVBData.InverterPosition state)
    {
        mvarData.Inverter = state;
        mvarData.SimulateLoops();
    }
    private void SetMVBEnabled(bool value)
    {
        Tourmaline.SessionConfig.MVBEnabled = value;
    }
    public void Dispose()
    {
        Tourmaline.HMIUpdateRequested -= auxHMIRefresh;
    }

    private void auxHMIRefresh(object? sender, EventArgs e)
    {
        InvokeAsync(StateHasChanged);
    }
    void SetBrakeValue(string? value)
    {
        if (int.TryParse(value, out var v))
            mvarData.BrakePower = v;
    }
    void SetTractionValue(string? value)
    {
        if (int.TryParse(value, out var v))
            mvarData.TractionPower = v;
    }
    async Task SetCurrentSpeedValue(string? value)
    {
        if (int.TryParse(value, out var v))
        {
            mvarData.Speed = v;
            await Experience.SetSpeed(v * 4);
            mvarData.SimulateLoops();
        }        
    }
    void SetDoorsEnabledLeft(bool value)
    {
        mvarData.LeftDoors = value;
        mvarData.SimulateLoops();
    }
    void SetDoorsEnabledRight(bool value)
    {
        mvarData.RightDoors = value;
        mvarData.SimulateLoops();
    }
    void SetPassengerLight(bool value)
    {
        mvarData.PassengerLight = value;
        mvarData.SimulateLoops();
    }
}
