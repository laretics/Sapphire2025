@using BlazorBootstrap
@using TimeNetComponents.TreeView
@using Tourmaline26.Components.Controls.Floatings
@using Tourmaline26.Components.Images
@inject Services.TourmalineService TourmalineService
<Tourmaline26.Components.Controls.Generical.Switch 
    Label="MVB Main" 
    Value="@TourmalineService.SessionConfig.MVBEnabled"
    ValueChanged="@((bool v) => SetMVBEnabled(v))"/>
@if(TourmalineService.SessionConfig.MVBLastUpdate>DateTime.MinValue)
{
    <p>Last update: @TourmalineService.SessionConfig.MVBLastUpdate</p>
}
else
{
    <p>No updates yet</p>
}
@if(TourmalineService.SessionConfig.MVBError.Length>0)
{
    <div class="alert alert-danger" role="alert">
        @TourmalineService.SessionConfig.MVBError
    </div>
}
@if(TourmalineService.SessionConfig.MVBEnabled && null!=TourmalineService.SessionConfig.CurrentMVBData)
{
    <table class="table table-striped table-bordered mt-4">
        <thead>
            <tr>
                <th>Field</th>
                <th>Value</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td>Speed</td>
                <td>@TourmalineService.SessionConfig.CurrentMVBData.Speed</td>
            </tr>
            <tr>
                <td>Odometer</td>
                <td>@TourmalineService.SessionConfig.CurrentMVBData.Odometer</td>
            </tr>
            <tr>
                <td>Time</td>
                <td>@TourmalineService.SessionConfig.CurrentMVBData.Time</td>
            </tr>
            <tr>
                <td>Speed validator?</td>
                <td>@TourmalineService.SessionConfig.CurrentMVBData.SpeedValidation</td>
            </tr>
        </tbody>
    </table>

        <table class="table table-striped table-bordered mt-4">
        <thead>
            <tr>
                <th>Order</th>
                <th>Zero</th>
                <th>T</th>
                <th>T Loop</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td>
                    <BooleanFlag value="@TourmalineService.SessionConfig.CurrentMVBData.DriveCommand" />
                </td>
                <td>
                    <BooleanFlag value="@TourmalineService.SessionConfig.CurrentMVBData.ZeroSpeed" />
                </td>
                <td>@TourmalineService.SessionConfig.CurrentMVBData.Advance.ToString()</td>
                <td>
                    <BooleanFlag value="@TourmalineService.SessionConfig.CurrentMVBData.TractionLoop" />
                </td>
            </tr>
        </tbody>
    </table>

    <p>Inverter: @TourmalineService.SessionConfig.CurrentMVBData.Inverter.ToString()</p>    
    <p>Handler: @TourmalineService.SessionConfig.CurrentMVBData.Handler.ToString()</p>
    <p>Braking</p>
    <table class="table table-striped table-bordered mt-4">
        <thead>
            <tr>
                <th>Value</th>
                <th>M1</th>
                <th>N1</th>
                <th>N2</th>
                <th>M2</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td>@TourmalineService.SessionConfig.CurrentMVBData.BrakePower</td>
                @for(int i =0;i<4;i++)
                {
                    <td>
                        <BooleanFlag Value="@TourmalineService.SessionConfig.CurrentMVBData.Wagons[i].BrakeLoop" />
                    </td>
                }
            </tr>
        </tbody>
    </table>
    <p>Cabin Enabled: @TourmalineService.SessionConfig.CurrentMVBData.Cabin.ToString()</p>
    <p>Doors</p>
    <table class="table table-striped table-bordered mt-4">
        <thead>
            <tr>
                <th>Left</th>
                <th>Loop</th>
                <th>Right</th>
            </tr>            
        </thead>
        <tbody>
             <tr>
                <td>
                    <BooleanFlag Value="@TourmalineService.SessionConfig.CurrentMVBData.LeftDoors" />
                </td>
                <td>
                    <BooleanFlag Value="@TourmalineService.SessionConfig.CurrentMVBData.DoorsLoop" />
                </td>
                <td>
                    <BooleanFlag Value="@TourmalineService.SessionConfig.CurrentMVBData.RightDoors" />
                </td>
            </tr>
        </tbody>
    </table>
    <p>Controls</p>
        <table class="table table-striped table-bordered mt-4">
        <thead>
            <tr>
                <th></th>
                <th>M1</th>
                <th>N1</th>
                <th>N2</th>
                <th>M2</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td>Light</td>
                @for(int i=0; i<4;i++)
                {
                    <td>
                        <BooleanFlag value="@TourmalineService.SessionConfig.CurrentMVBData.Wagons[i].PassengerLight" />
                    </td>
                }
            </tr>
            <tr>
                <td>Temp In</td>
                @for (int i = 0; i < 4; i++)
                {
                    <td>
                        @TourmalineService.SessionConfig.CurrentMVBData.Wagons[i].InsideTemp
                    </td>
                }
            </tr>
            <tr>
                <td>Temp Out</td>
                @for (int i = 0; i < 4; i++)
                {
                    <td>
                        @TourmalineService.SessionConfig.CurrentMVBData.Wagons[i].OutsideTemp
                    </td>
                }
            </tr>
        </tbody>
    </table>
}
else
{
    <Tourmaline26.Components.Controls.Generical.Switch Label="MVB Dummy"
                                                       Value="@TourmalineService.SessionConfig.MVBEnabled"
                                                       ValueChanged="@((bool v) => SetMVBDummy(v))" />

    @if(TourmalineService.SessionConfig.MVBDummy && null!=TourmalineService.SessionConfig.CurrentMVBData)
    {
        <div class="mb-3">
            <label>Current Speed (@TourmalineService.SessionConfig.CurrentMVBData.Speed)</label>
            <input type="range"
                    min="0"
                    max="140"
                    value="@TourmalineService.SessionConfig.CurrentMVBData.Speed"
                    @oninput="e => SetCurrentSpeedValue(e.Value?.ToString())" />
        </div>
        <div class="mb-3">
            <label>Inverter</label>
            <div class="btn-group" role="group" aria-label="Inverter">
                <button type="button"
                        class="btn @(TourmalineService.SessionConfig.CurrentMVBData?.Inverter== MVBData.InverterPosition.Reverse? "btn-primary" : "btn-outline-primary")"
                        @onclick="() => SetInverterState(MVBData.InverterPosition.Reverse)">
                    R
                </button>
                <button type="button"
                        class="btn @(TourmalineService.SessionConfig.CurrentMVBData?.Inverter == MVBData.InverterPosition.Iddle ? "btn-dark" : "btn-outline-dark")"
                        @onclick="() => SetInverterState(MVBData.InverterPosition.Iddle)">
                    O
                </button>
                <button type="button"
                        class="btn @(TourmalineService.SessionConfig.CurrentMVBData?.Inverter == MVBData.InverterPosition.Tunnel ? "btn-primary" : "btn-outline-primary")"
                        @onclick="() => SetInverterState(MVBData.InverterPosition.Tunnel)">
                    T
                </button>
                <button type="button"
                        class="btn @(TourmalineService.SessionConfig.CurrentMVBData?.Inverter == MVBData.InverterPosition.Shunting ? "btn-primary" : "btn-outline-primary")"
                        @onclick="() => SetInverterState(MVBData.InverterPosition.Shunting)">
                    M
                </button>
                <button type="button"
                        class="btn @(TourmalineService.SessionConfig.CurrentMVBData?.Inverter == MVBData.InverterPosition.Forward ? "btn-primary" : "btn-outline-primary")"
                        @onclick="() => SetInverterState(MVBData.InverterPosition.Forward)">
                    F
                </button>
            </div>
        </div>
        <div class="mb-3">
            <label>Handler</label>
            <div class="btn-group" role="group" aria-label="Handler">
                <button type="button"
                        class="btn @(TourmalineService.SessionConfig.CurrentMVBData.Handler==MVBData.HandlerPosition.EmergencyBrake ? "btn-danger" : "btn-outline-danger")"
                        @onclick="() => SetHandlerState(MVBData.HandlerPosition.EmergencyBrake)">
                    E
                </button>
                <button type="button"
                        class="btn @(TourmalineService.SessionConfig.CurrentMVBData.Handler == MVBData.HandlerPosition.Braking ? "btn-warning" : "btn-outline-warning")"
                        @onclick="() => SetHandlerState(MVBData.HandlerPosition.Braking)">
                    F
                </button>
                <button type="button"
                        class="btn @(TourmalineService.SessionConfig.CurrentMVBData.Handler == MVBData.HandlerPosition.Iddle ? "btn-dark" : "btn-outline-dark")"
                        @onclick="() => SetHandlerState(MVBData.HandlerPosition.Iddle)">
                    N
                </button>
                <button type="button"
                        class="btn @(TourmalineService.SessionConfig.CurrentMVBData.Handler == MVBData.HandlerPosition.Traction ? "btn-primary" : "btn-outline-primary")"
                        @onclick="() => SetHandlerState(MVBData.HandlerPosition.Traction)">
                    T
                </button>
            </div>
        </div>
        <div class="mb-3">
            <label>Brake (@TourmalineService.SessionConfig.CurrentMVBData.BrakePower)</label>
            <input type="range"
                   min="0"
                   max="100"
                   value="@TourmalineService.SessionConfig.CurrentMVBData.BrakePower"
                   @oninput="e => SetBrakeValue(e.Value?.ToString())" />
        </div>
        <div class="mb-3">
            <label>Traction (@TourmalineService.SessionConfig.CurrentMVBData.TractionPower)</label>
            <input type="range"
                   min="0"
                   max="100"
                   value="@TourmalineService.SessionConfig.CurrentMVBData.TractionPower"
                   @oninput="e => SetTractionValue(e.Value?.ToString())" />
        </div>

        <div class="mb-3">
            <label>Doors Enabled Left</label>
            <input type="checkbox"
                    checked="@TourmalineService.SessionConfig.CurrentMVBData.LeftDoors"
                    @onchange="e => SetDoorsEnabledLeft((bool)e.Value)" />
        </div>
        <div class="mb-3">
            <label>Doors Enabled Right</label>
            <input type="checkbox"
                    checked="@TourmalineService.SessionConfig.CurrentMVBData.RightDoors"
                    @onchange="e => SetDoorsEnabledRight((bool)e.Value)" />
        </div>
        <div class="mb-3">
            <label>Doors Loop</label>
            <input type="checkbox"
                    checked="@TourmalineService.SessionConfig.CurrentMVBData.DoorsLoop"
                    @onchange="e => SetDoorsLoop((bool)e.Value)" />
        </div>
        <div class="mb-3">
            <label>Drive Command</label>
            <input type="checkbox"
                    checked="@TourmalineService.SessionConfig.CurrentMVBData.DriveCommand"
                    @onchange="e => SetDriveCommand((bool)e.Value)" />
        </div>     
    }
}



@code {


    void SetHandlerState(MVBData.HandlerPosition state)
    {
        var data = TourmalineService.SessionConfig.CurrentMVBData;
        if (data is null) return;
        data.Handler = state;
    }
    void SetInverterState(MVBData.InverterPosition state)
    {
        var data = TourmalineService.SessionConfig.CurrentMVBData;
        if (data is null) return;
        data.Inverter = state;
    }

    private void SetMVBEnabled(bool value)
    {
        TourmalineService.SessionConfig.MVBEnabled = value;
    }

    private void SetMVBDummy(bool value)
    {
        TourmalineService.SessionConfig.MVBDummy = value;
    }
        
    protected override void OnInitialized()
    {
        base.OnInitialized();
        TourmalineService.HMIUpdateRequested += auxHMIRefresh;
    }
        
    public void Dispose()
    {
        TourmalineService.HMIUpdateRequested -= auxHMIRefresh;
    }
    
    private void auxHMIRefresh(object? sender, EventArgs e)
    {
        InvokeAsync(StateHasChanged);
    }
    void SetBrakeValue(string? value)
    {
        if (int.TryParse(value, out var v) && null!=TourmalineService.SessionConfig.CurrentMVBData)
            TourmalineService.SessionConfig.CurrentMVBData.BrakePower = v;
    }
    void SetTractionValue(string? value)
    {
        if (int.TryParse(value, out var v) && null != TourmalineService.SessionConfig.CurrentMVBData)
            TourmalineService.SessionConfig.CurrentMVBData.TractionPower = v;
    }
    void SetCurrentSpeedValue(string? value)
    {
        if (int.TryParse(value, out var v) && null != TourmalineService.SessionConfig.CurrentMVBData)
            TourmalineService.SessionConfig.CurrentMVBData.Speed = v;
    }
    void SetDoorsEnabledLeft(bool value)
        => TourmalineService.SessionConfig.CurrentMVBData.LeftDoors = value;
    void SetDoorsEnabledRight(bool value)
        => TourmalineService.SessionConfig.CurrentMVBData.RightDoors = value;
    void SetDoorsLoop(bool value)
        => TourmalineService.SessionConfig.CurrentMVBData.DoorsLoop = value;
    void SetDriveCommand(bool value)
        => TourmalineService.SessionConfig.CurrentMVBData.DriveCommand = value;
}
