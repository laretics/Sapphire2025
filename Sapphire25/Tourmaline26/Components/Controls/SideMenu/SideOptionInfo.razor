@using Tourmaline26.Components.Controls.Generical
@inject TourmalineService TourmalineService
@inject RouteSimulationService RouteSim
<img src="img/81pic1.png"
     alt="Imagen informativa"
     class="img-fluid rounded shadow mx-auto d-block my-4"
     style="max-width: 420px;" />
<p>Software @ReleaseInfo</p>
@if(TourmalineService.SessionConfig.ServiceMode.Main)
{
    <ul>
        <li>Zafiro: @auxConfig?.SapphireUrl</li>
        <li>MVB: @auxConfig?.MVBUrl</li>
        <li>T.Experience: @auxConfig?.TExperienceUrl</li>
        <li>T.E. Stream: @auxConfig?.TExperienceStr</li>
        <li>CTC Info: @auxConfig?.SfmInfoUrl (Token: @auxConfig?.SfmInfoToken)</li>
    </ul>
    <Switch Label="Demo" Value="@TourmalineService.SessionConfig.ServiceMode.DemoMode"
            ValueChanged="@((bool v) => SetDemoMode(v))" />
    <p class="form-text mb-2">
        Demo: teclas 3/4 rampa a Tourmaline Experience.
        Con Demo activo, F3–F5 simulador de ruta; F2 o desactivar Demo: modo real.
    </p>
}
<Switch Label="Modo de Servicio" Value="@TourmalineService.SessionConfig.ServiceMode.Main"
        ValueChanged="@((bool v) => SetServiceMode(v))" />
@code {
    private SystemConfiguration? auxConfig { get; set; }
    protected override void OnInitialized()
    {
        base.OnInitialized();
        auxConfig = TourmalineService.SystemConfig;
    }
    private void SetServiceMode(bool value)
    {
        if (!value)
            RouteSim.Abandon();
        TourmalineService.SessionConfig.ServiceMode.Main = value;
        TourmalineService.RaiseHMIUpdate();
    }
    private void SetDemoMode(bool value)
    {
        if (value)
        {
            RouteSim.Stop();
            TourmalineService.SessionConfig.ServiceMode.DemoMode = true;
            if (TourmalineService.SessionConfig.CurrentMVBData is null)
            {
                TourmalineService.SessionConfig.CurrentMVBData = new MVBData();
                TourmalineService.SessionConfig.CurrentMVBData.SimulateLoops();
            }
        }
        else
        {
            RouteSim.Abandon();
        }
        TourmalineService.RaiseHMIUpdate();
    }
    private string ReleaseInfo
    {
        get => $"{auxConfig?.Version} - {auxConfig?.Release:dd-MM-y}";
    }
}
