@using Diamond.Timed
@using Microsoft.EntityFrameworkCore
@using Sapphire2025.Storage
@using Sapphire2025Models.Diamond
@using Tourmaline26.Services.CabinCache
@using Tourmaline26.Services.LocalDataModel
@implements IDisposable
@inject TourmalineService TourmalineService
@inject DiamondLocalCache DiamondCache
@inject DiamondClient DiamondClient
@inject RouteSimulationService RouteSim

<h2>Diamond</h2>

@if (!string.IsNullOrEmpty(mvarStatus))
{
    <p class="@(mvarStatusError ? "text-danger" : "text-success")">@mvarStatus</p>
}

<ul>
    <li>TopoId (appsettings): <code>@TourmalineService.ConfiguredTopoId</code></li>
    @if (mvarTopoMeta is not null)
    {
        <li>Topo en caché: @mvarTopoMeta.Name</li>
        <li>ContentHash: <code>@mvarTopoMeta.ContentHash</code></li>
        <li>Descargada: @mvarTopoMeta.DownloadedUtc.ToLocalTime()</li>
    }
    else
    {
        <li>Sin topología en caché local</li>
    }
    @if (cabin is not null)
    {
        <li>Plan del día: @(string.IsNullOrEmpty(cabin.PublishedPlanName) ? "—" : cabin.PublishedPlanName)</li>
        <li>Circulaciones (@ServiceDays.FormatDayOfWeek(SelectedPlanningDay)): @(cabin.DayProject?.Circulations.Count ?? 0)</li>
        <li>Misión: @(cabin.Circulation is null ? "ninguna" : (cabin.Circulation.HasServiceNumber ? cabin.Circulation.ServiceNumber : cabin.Circulation.Id))</li>
    }
</ul>

<div class="diamond-day-block mb-3">
    <label class="form-label small text-muted mb-1" for="diamond-day-group">Día de la malla</label>
    <div id="diamond-day-group" class="btn-group diamond-day-group w-100" role="group" aria-label="Día de la semana">
        @foreach (DayOfWeek day in WeekDays)
        {
            bool selected = SelectedPlanningDay == day;
            bool calendarToday = DateTime.Today.DayOfWeek == day;
            <button type="button"
                    class="btn btn-sm @(selected ? "btn-primary" : "btn-outline-primary")"
                    aria-pressed="@(selected ? "true" : "false")"
                    title="@(calendarToday ? ServiceDays.FormatDayOfWeek(day) + " (hoy)" : ServiceDays.FormatDayOfWeek(day))"
                    @onclick="() => SelectDay(day)">
                @ServiceDays.FormatDayOfWeek(day)
                @if (calendarToday)
                {
                    <span class="visually-hidden"> (hoy)</span>
                }
            </button>
        }
    </div>
    @if (cabin is not null && cabin.HasPlanningDayOverride)
    {
        <div class="form-text">
            Malla de @ServiceDays.FormatDayOfWeek(SelectedPlanningDay)
            (hoy es @ServiceDays.FormatDayOfWeek(DateTime.Today.DayOfWeek)).
        </div>
    }
</div>

@if (mvarBusy)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);" aria-modal="true" role="dialog">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content text-center">
                <div class="modal-body">
                    <div class="spinner-border text-primary mb-3" style="width: 4rem; height: 4rem;" role="status">
                        <span class="visually-hidden">Sincronizando...</span>
                    </div>
                    <h4 class="mb-2">Sincronizando Diamond</h4>
                    <p>Topo (si hay hash nuevo) y planes publicados desde hoy.</p>
                </div>
            </div>
        </div>
    </div>
}
else if (TourmalineService.SessionConfig.ServiceMode.Main)
{
    <button class="btn btn-primary" @onclick="SyncAsync">Sincronizar con servidor</button>
    <button class="btn btn-outline-secondary ms-2" @onclick="ReloadLocalAsync">Recargar caché local</button>
}

@if (mcolPlans.Count > 0)
{
    <h3 class="mt-3">Planes publicados en caché</h3>
    <table class="table table-striped table-bordered mt-2">
        <thead>
            <tr>
                <th>Nombre</th>
                <th>Vigencia</th>
                <th>Trenes*</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (DBDiamondPublishedPlanCache plan in mcolPlans)
            {
                <tr>
                    <td>@plan.Name</td>
                    <td>
                        @plan.ValidFrom.ToString("yyyy-MM-dd")
                        @if (plan.ValidTo.HasValue)
                        {
                            <text> → @plan.ValidTo.Value.ToString("yyyy-MM-dd")</text>
                        }
                    </td>
                    <td>@plan.CirculationCount</td>
                    <td>
                        @if (cabin is not null && cabin.PublishedPlanId == plan.PlanId)
                        {
                            <span>Activo</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
    <p class="text-muted small">* Recuento del paquete (7 días). La botonera elige el Project del día.</p>
}

@if (TourmalineService.SessionConfig.ServiceMode.Main
    && !TourmalineService.SessionConfig.ServiceMode.DemoMode)
{
    <div class="route-sim mt-4">
        <h3>Simulador de ruta</h3>
        <p class="form-text mb-0">
            Activa Demo (modo servicio) para F2–F5: iniciar, pausar, saltar y volver a modo real.
        </p>
    </div>
}
else if (TourmalineService.SessionConfig.ServiceMode.RouteSimKeysEnabled)
{
    <div class="route-sim mt-4">
        <h3>Simulador de ruta</h3>
        <p class="small mb-2">
            Recorre la misión cargada con los tiempos de la malla (paradas + velocidad media de cada tramo).
            F3 inicia / reanuda, F4 pausa, F5 últimos 2 km, F2 vuelve a MVB/GPS reales.
        </p>
        <p class="mb-2">
            <span class="badge @RouteSimBadgeClass">@RouteSim.State</span>
            <span class="ms-1">@RouteSim.Status</span>
        </p>
        <div class="d-flex flex-wrap gap-2">
            <button type="button"
                    class="btn btn-primary"
                    disabled="@(!HasCirculation)"
                    @onclick="StartRouteSim">
                Iniciar / reanudar (F3)
            </button>
            <button type="button"
                    class="btn btn-outline-secondary"
                    disabled="@(RouteSim.State != RouteSimulationService.SimState.Running)"
                    @onclick="PauseRouteSim">
                Pausar (F4)
            </button>
            <button type="button"
                    class="btn btn-outline-primary"
                    disabled="@(!HasCirculation)"
                    @onclick="JumpRouteSimTail">
                Últimos 2 km (F5)
            </button>
            <button type="button"
                    class="btn btn-outline-danger"
                    disabled="@(!SimulationActive)"
                    @onclick="AbandonSimulation">
                Modo real (F2)
            </button>
        </div>
        @if (!HasCirculation)
        {
            <div class="form-text">Elige una circulación en el buscador de destino.</div>
        }
    </div>
}

@code {
    private static readonly DayOfWeek[] WeekDays =
    {
        DayOfWeek.Monday,
        DayOfWeek.Tuesday,
        DayOfWeek.Wednesday,
        DayOfWeek.Thursday,
        DayOfWeek.Friday,
        DayOfWeek.Saturday,
        DayOfWeek.Sunday
    };

    private bool mvarBusy;
    private string mvarStatus = string.Empty;
    private bool mvarStatusError;
    private DBDiamondTopoCache? mvarTopoMeta;
    private List<DBDiamondPublishedPlanCache> mcolPlans = new List<DBDiamondPublishedPlanCache>();

    private Diamond.Cabin.CabinEnvironment? cabin => TourmalineService.SessionConfig.Cabin;

    private bool HasCirculation => cabin?.Circulation is not null;

    private bool SimulationActive =>
        RouteSim.IsActive
        || TourmalineService.SessionConfig.ServiceMode.AnySimulation;

    private string RouteSimBadgeClass => RouteSim.State switch
    {
        RouteSimulationService.SimState.Running => "text-bg-success",
        RouteSimulationService.SimState.Paused => "text-bg-warning",
        _ => "text-bg-secondary"
    };

    private DayOfWeek SelectedPlanningDay =>
        cabin is not null ? cabin.EffectivePlanningDay : DateTime.Today.DayOfWeek;

    private void SelectDay(DayOfWeek day)
    {
        if (cabin is null || SelectedPlanningDay == day)
        {
            return;
        }

        cabin.SelectPlanningDay(day);
        int count = cabin.DayProject?.Circulations.Count ?? 0;
        mvarStatus = string.Format(
            "Malla de {0}: {1} circulación(es).",
            ServiceDays.FormatDayOfWeek(day),
            count);
        mvarStatusError = false;
        TourmalineService.RaiseHMIUpdate();
        TourmalineService.RaisePassengerUpdate();
    }

    protected override async Task OnInitializedAsync()
    {
        await TourmalineService.EnsureInitialized();
        await RefreshMetaAsync();
        TourmalineService.HMIUpdateRequested += OnHmiRefresh;
        await base.OnInitializedAsync();
    }

    public void Dispose()
    {
        TourmalineService.HMIUpdateRequested -= OnHmiRefresh;
    }

    private void OnHmiRefresh(object? sender, EventArgs e)
    {
        _ = InvokeAsync(StateHasChanged);
    }

    private void StartRouteSim()
    {
        RouteSim.StartOrResume();
        TourmalineService.RaiseHMIUpdate();
        TourmalineService.RaisePassengerUpdate();
    }

    private void PauseRouteSim()
    {
        RouteSim.Pause();
        TourmalineService.RaiseHMIUpdate();
    }

    private void JumpRouteSimTail()
    {
        RouteSim.JumpToLastMeters();
        TourmalineService.RaiseHMIUpdate();
        TourmalineService.RaisePassengerUpdate();
    }

    private void AbandonSimulation()
    {
        RouteSim.Abandon();
        TourmalineService.RaiseHMIUpdate();
        TourmalineService.RaisePassengerUpdate();
    }

    private async Task RefreshMetaAsync()
    {
        Guid topoId = TourmalineService.ConfiguredTopoId;
        if (!Guid.Empty.Equals(topoId))
        {
            mvarTopoMeta = await DiamondCache.GetTopoMetaAsync(topoId);
            mcolPlans = (await DiamondCache.ListCachedPlansAsync(topoId)).ToList();
        }
        else
        {
            mvarTopoMeta = null;
            mcolPlans = new List<DBDiamondPublishedPlanCache>();
        }
    }

    private async Task SyncAsync()
    {
        mvarBusy = true;
        mvarStatus = string.Empty;
        StateHasChanged();
        try
        {
            // DiamondClient del circuito (scoped), no un scope raíz: IntStorage usa JS interop.
            DiamondSyncResult result = await TourmalineService.SyncDiamondAsync(DiamondClient);
            mvarStatus = result.Message;
            mvarStatusError = !result.Success;
            await RefreshMetaAsync();
            TourmalineService.RaiseHMIUpdate();
        }
        catch (Exception ex)
        {
            mvarStatus = ex.Message;
            mvarStatusError = true;
        }
        finally
        {
            mvarBusy = false;
            StateHasChanged();
        }
    }

    private async Task ReloadLocalAsync()
    {
        mvarBusy = true;
        StateHasChanged();
        try
        {
            await TourmalineService.InitializeDiamond();
            mvarStatus = "Caché local recargada.";
            mvarStatusError = false;
            await RefreshMetaAsync();
            TourmalineService.RaiseHMIUpdate();
        }
        catch (Exception ex)
        {
            mvarStatus = ex.Message;
            mvarStatusError = true;
        }
        finally
        {
            mvarBusy = false;
            StateHasChanged();
        }
    }
}
