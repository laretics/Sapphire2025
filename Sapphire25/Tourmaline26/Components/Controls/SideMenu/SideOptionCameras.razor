@using Tourmaline26.Components.Controls.Generical
@inject TourmalineService TourmalineService
<Switch Label="Cámaras automáticas" Value="@TourmalineService.SessionConfig.AutoCameras"
        ValueChanged="@((bool v) => SetAutoCameras(v))" />
<div class="alert alert-light fs-5 text-secondary mt-3 mb-3" role="alert">
    Con una ruta seleccionada, el sistema conectará automáticamente la visualización de las cámaras en los últimos metros antes de la parada en la próxima estación y la desconectará en los primeros metros tras la salida de la misma.
</div>
<Switch Label="Visualización manual" Value="@TourmalineService.SessionConfig.ManualCameras"
        ValueChanged="@((bool v) => SetManualCameras(v))" />

@code {
    private async Task SetAutoCameras(bool value)
    {
        TourmalineService.SessionConfig.AutoCameras = value;
        TourmalineService.RaiseHMIUpdate();
    }
    private async Task SetManualCameras(bool value)
    {
        TourmalineService.SessionConfig.ManualCameras = value;
        TourmalineService.RaiseHMIUpdate();
    }

}
