@using Tourmaline26.Components.Controls.Generical
@inject TourmalineService TourmalineService

<h4>Información al viajero</h4>
<Switch Label="Conexión" Value="@TourmalineService.SessionConfig.MainSwitches.PASEnabled" 
    ValueChanged="@((bool v) => SetPASEnabled(v))" />
@if(TourmalineService.SessionConfig.ServiceMode.Main)
{
    <h3 class="bg-danger">Modo de servicio</h3>
    <Switch Label="Carta de Ajuste" Value="@TourmalineService.SessionConfig.ServiceMode.PassengerCaretOnServiceMode"
            ValueChanged="@((bool v) => SetCaret(v))" />
    <btn class="btn btn-outline-danger" @onclick="@TogglePassengerScreenOnHMI">Ver Viajeros</btn>
    <h4 class="bg-danger">Anuncio</h4>
    <RadioButton Options="@(new List<string> { "Def", "Init", "Route", "Arriv", "Cruise", "End" })"
                 SelectedIndex="@( (int)(byte)TourmalineService.SessionConfig.InformationMode )"
                 SelectedIndexChanged="@((int v) => SetPassengerMode(v))" />
}
<h4>Anunciador</h4>
<RadioButton Options="@(new List<string> { "Desactivado", "Ruta", "Tren Sin Servicio" })"
             SelectedIndex="@( (int)(byte)TourmalineService.SessionConfig.InformationLevel )"
             SelectedIndexChanged="@((int v) => SetRouteMode(v))" />
             
<Switch Label="Monitores Vídeo" Value="@TourmalineService.SessionConfig.MainSwitches.TFTEnabled" 
    ValueChanged="@((bool v) => SetTFTEnabled(v))" />
<Switch Label="Sonido" Value="@TourmalineService.SessionConfig.MainSwitches.SoundEnabled"
        ValueChanged="@((bool v) => SetSoundEnabled(v))" />
<Switch Label="Teleindicadores" Value="@TourmalineService.SessionConfig.MainSwitches.TeleindicatorsEnabled"
        ValueChanged="@((bool v) => SetTeleindicatorsEnabled(v))" />
<Switch Label="Frontales" Value="@TourmalineService.SessionConfig.MainSwitches.ExternalTeleindicatorsEnabled"
        ValueChanged="@((bool v) => SetExternalTeleindicatorsEnabled(v))" />
@code {
    [CascadingParameter]
    public Action? UpdateView { get; set; }
    private void SetCaret(bool value)
    {
        TourmalineService.SessionConfig.ServiceMode.PassengerCaretOnServiceMode = value;
        TourmalineService.RaisePassengerUpdate();
    }
    private void TogglePassengerScreenOnHMI()
    {
        TourmalineService.SessionConfig.ServiceMode.PassengerScreenOnHMI = true;
        UpdateView?.Invoke();
    }
    private void SetRouteMode(int index)
    {
        TourmalineService.SessionConfig.InformationLevel = (Enums.InformationLevel)(byte)index;
        TourmalineService.RaiseHMIUpdate();
    }
    private void SetPassengerMode(int index)
    {
        TourmalineService.SessionConfig.InformationMode = (Enums.PassengerInformationMode)(byte)index;
        TourmalineService.RaiseHMIUpdate();
    }
    private void SetPASEnabled(bool value)
    {
        TourmalineService.SessionConfig.MainSwitches.PASEnabled = value;
        TourmalineService.RaiseHMIUpdate();
    }
    private void SetTFTEnabled(bool value)
    {
        TourmalineService.SessionConfig.MainSwitches.TFTEnabled = value;
        TourmalineService.RaiseHMIUpdate();
    }
    private void SetSoundEnabled(bool value)
    {
        TourmalineService.SessionConfig.MainSwitches.SoundEnabled = value;
        TourmalineService.RaiseHMIUpdate();
    }
    private void SetTeleindicatorsEnabled(bool value)
    {
        TourmalineService.SessionConfig.MainSwitches.TeleindicatorsEnabled = value;
        TourmalineService.RaiseHMIUpdate();
    }
     private void SetExternalTeleindicatorsEnabled(bool value)
    {
        TourmalineService.SessionConfig.MainSwitches.ExternalTeleindicatorsEnabled = value;
        TourmalineService.RaiseHMIUpdate();
    }
}
