@using Tourmaline26.Components.Controls.Generical
@using Tourmaline26.Components.Images
@using Tourmaline26.Logic
@implements IDisposable
@inject TourmalineService TourmalineService
@inject GPSService GPSService

<h3>Ubicación del tren</h3>

@* --- Controles de fuente --- *@
<Switch Label="GPS"
        Value="@TourmalineService.SessionConfig.GPSEnabled"
        ValueChanged="@((bool v) => SetGPS(v))" />

<Switch Label="Dummy (Tourmaline Experience)"
        Value="@TourmalineService.SessionConfig.ServiceMode.GPSDummy"
        ValueChanged="@((bool v) => SetDummyGPS(v))" />

@* --- Estado operativo --- *@
<div class="mt-2 mb-3">
    <span class="badge @StatusBadgeClass me-2">@StatusLabel</span>
    @if (IsDummyActive)
    {
        <span class="badge text-bg-warning">Dummy</span>
    }
    else if (TourmalineService.SessionConfig.GPSEnabled)
    {
        <span class="badge text-bg-secondary">@GPSService.ModeDisplayName</span>
    }
    else
    {
        <span class="badge text-bg-dark">GPS desactivado</span>
    }
</div>

<table class="table table-sm table-striped table-bordered">
    <tbody>
        <tr>
            <td>Señal</td>
            <td>
                @if (TourmalineService.SessionConfig.GPSOK)
                {
                    <ColorIcon Name="Satellite" Size="22" />
                    <span class="ms-1">OK</span>
                }
                else
                {
                    <ColorIcon Name="NoLocation" Size="22" />
                    <span class="ms-1">Sin fix / sin datos</span>
                }
            </td>
        </tr>
        <tr>
            <td>Última actualización</td>
            <td>@FormatLastUpdate()</td>
        </tr>
        @if (!IsDummyActive && GPSService.IsUdpReceiver && !string.IsNullOrEmpty(GPSService.LastRemoteEndPoint))
        {
            <tr>
                <td>Origen UDP</td>
                <td><code>@GPSService.LastRemoteEndPoint</code></td>
            </tr>
        }
        <tr>
            <td>Servicio configurado</td>
            <td>@(GPSService.IsConfigured ? "Sí" : "No")</td>
        </tr>
    </tbody>
</table>

@if (!GPSService.IsConfigured && !IsDummyActive && TourmalineService.SessionConfig.GPSEnabled)
{
    <div class="alert alert-warning py-2" role="alert">
        GPS no configurado o no se pudo abrir el socket/puerto. Revisa <code>SystemConfiguration:gps</code> en appsettings.
    </div>
}

@* --- Datos en tiempo real --- *@
@if (mvarCurrentData is not null)
{
    <h4 class="mt-3">Tiempo real</h4>
    <table class="table table-striped table-bordered">
        <thead>
            <tr>
                <th>Parámetro</th>
                <th>Valor</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td>Latitud</td>
                <td>@mvarCurrentData.Latitude.ToString("F6")</td>
            </tr>
            <tr>
                <td>Longitud</td>
                <td>@mvarCurrentData.Longitude.ToString("F6")</td>
            </tr>
            <tr>
                <td>Hora GPS (UTC)</td>
                <td>@FormatGpsTime(mvarCurrentData.Time)</td>
            </tr>
            <tr>
                <td>Velocidad</td>
                <td>
                    @mvarCurrentData.SpeedKmh.ToString("F1") km/h
                    <span class="text-muted">
                        (@mvarCurrentData.SpeedKnots.ToString("F1") kn · @mvarCurrentData.SpeedMs.ToString("F1") m/s)
                    </span>
                </td>
            </tr>
            <tr>
                <td>Rumbo</td>
                <td>@mvarCurrentData.Course.ToString("F1")°</td>
            </tr>
            <tr>
                <td>Altitud</td>
                <td>@mvarCurrentData.Altitude.ToString("F1") m</td>
            </tr>
            <tr>
                <td>Calidad fix</td>
                <td>@mvarCurrentData.FixQuality — @FixQualityLabel(mvarCurrentData.FixQuality)</td>
            </tr>
            <tr>
                <td>Satélites</td>
                <td>@mvarCurrentData.SatellitesUsed</td>
            </tr>
            <tr>
                <td>Precisión (HDOP)</td>
                <td>@mvarCurrentData.HDOP.ToString("F2")</td>
            </tr>
            <tr>
                <td>Válido</td>
                <td>@(mvarCurrentData.IsValid ? "Sí" : "No")</td>
            </tr>
        </tbody>
    </table>
}
else if (TourmalineService.SessionConfig.GPSEnabled || IsDummyActive)
{
    <div class="alert alert-secondary py-2 mt-3" role="alert">
        @if (IsDummyActive)
        {
            <span>Esperando telemetría de Tourmaline Experience (Dummy)…</span>
        }
        else if (GPSService.IsUdpReceiver)
        {
            <span>Esperando paquetes UDP del emisor GPS (puerto @GPSService.ListenPort)…</span>
        }
        else
        {
            <span>Esperando datos NMEA del puerto serie…</span>
        }
    </div>
}

@* --- Configuración según modo --- *@
<h4 class="mt-3">Configuración</h4>
<table class="table table-striped table-bordered">
    <thead>
        <tr>
            <th>Parámetro</th>
            <th>Valor</th>
        </tr>
    </thead>
    <tbody>
        <tr>
            <td>Modo</td>
            <td>@GPSService.ModeDisplayName</td>
        </tr>
        @if (GPSService.IsUdpReceiver)
        {
            <tr>
                <td>Puerto de escucha UDP</td>
                <td>@GPSService.ListenPort</td>
            </tr>
            <tr>
                <td>Socket</td>
                <td>@(GPSService.IsConnected && GPSService.IsConfigured ? "Abierto" : "Cerrado / error")</td>
            </tr>
        }
        else
        {
            <tr>
                <td>Puerto serie</td>
                <td>@(GPSService.Port ?? "—")</td>
            </tr>
            <tr>
                <td>Baud rate</td>
                <td>@GPSService.Bauds</td>
            </tr>
            <tr>
                <td>Data bits</td>
                <td>@GPSService.DataBits</td>
            </tr>
            <tr>
                <td>Parity</td>
                <td>@GPSService.Parity</td>
            </tr>
            <tr>
                <td>Stop bits</td>
                <td>@GPSService.StopBits</td>
            </tr>
            <tr>
                <td>Handshake</td>
                <td>@GPSService.Handshake</td>
            </tr>
            @if (GPSService.BroadcastPort > 0)
            {
                <tr>
                    <td>Broadcast UDP</td>
                    <td>@GPSService.BroadcastAddress:@GPSService.BroadcastPort</td>
                </tr>
            }
            <tr>
                <td>Serie conectada</td>
                <td>@(GPSService.IsConnected ? "Sí" : "No")</td>
            </tr>
        }
    </tbody>
</table>

@if (IsDummyActive)
{
    <p class="text-muted small mt-2">
        En modo Dummy la posición se obtiene de Tourmaline Experience, no del emisor UDP ni del puerto serie.
    </p>
}
else if (GPSService.IsUdpReceiver)
{
    <p class="text-muted small mt-2">
        Este equipo solo recibe GPS por red. El hardware debe estar en el PC del emisor (<code>GpsEmitter</code>).
    </p>
}

@code {
    private GPSData? mvarCurrentData;
    private SessionConfiguration Session => TourmalineService.SessionConfig;

    private bool IsDummyActive => Session.ServiceMode.GPSDummy;

    private string StatusLabel
    {
        get
        {
            if (!Session.GPSEnabled && !IsDummyActive)
                return "Desactivado";
            if (IsDummyActive)
                return Session.GPSOK ? "Dummy activo" : "Dummy sin datos";
            if (!GPSService.IsConfigured)
                return "Sin configurar";
            if (Session.GPSOK)
                return "Recibiendo";
            return "Sin señal";
        }
    }

    private string StatusBadgeClass => StatusLabel switch
    {
        "Recibiendo" or "Dummy activo" => "text-bg-success",
        "Sin señal" or "Dummy sin datos" or "Sin configurar" => "text-bg-danger",
        "Desactivado" => "text-bg-secondary",
        _ => "text-bg-secondary"
    };

    protected override void OnInitialized()
    {
        base.OnInitialized();
        mvarCurrentData = Session.CurrentGPSData;
        TourmalineService.HMIUpdateRequested += OnHmiRefresh;
    }

    public void Dispose()
    {
        TourmalineService.HMIUpdateRequested -= OnHmiRefresh;
    }

    private void OnHmiRefresh(object? sender, EventArgs e)
    {
        mvarCurrentData = Session.CurrentGPSData;
        _ = InvokeAsync(StateHasChanged);
    }

    private void SetGPS(bool enabled)
    {
        Session.GPSEnabled = enabled;
        if (!enabled && !IsDummyActive)
            Session.CurrentGPSData = null;
    }

    private void SetDummyGPS(bool dummy)
    {
        Session.CurrentGPSData = null;
        Session.ServiceMode.GPSDummy = dummy;
    }

    private string FormatLastUpdate()
    {
        if (Session.GPSLastUpdate <= DateTime.MinValue)
            return "Nunca";

        TimeSpan age = DateTime.Now - Session.GPSLastUpdate;
        string when = Session.GPSLastUpdate.ToString("HH:mm:ss");
        if (age.TotalSeconds < 2)
            return $"{when} (ahora)";
        if (age.TotalMinutes < 1)
            return $"{when} (hace {age.TotalSeconds:F0} s)";
        if (age.TotalHours < 1)
            return $"{when} (hace {age.TotalMinutes:F0} min)";
        return when;
    }

    private static string FormatGpsTime(DateTime time)
    {
        if (time <= DateTime.MinValue)
            return "—";
        return time.Kind == DateTimeKind.Utc
            ? time.ToString("yyyy-MM-dd HH:mm:ss") + " UTC"
            : time.ToString("yyyy-MM-dd HH:mm:ss");
    }

    private static string FixQualityLabel(int quality) => quality switch
    {
        0 => "inválido",
        1 => "GPS",
        2 => "DGPS",
        4 => "RTK Fix",
        5 => "RTK Float",
        _ => "otro"
    };
}
