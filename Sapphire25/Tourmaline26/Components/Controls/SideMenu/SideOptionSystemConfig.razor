@using Tourmaline26.Components.Controls.Floatings
@using Tourmaline26.Services.LocalDataModel
@using Sapphire2025Models
@using Microsoft.EntityFrameworkCore
@inject TourmalineService TourmalineService
@inject TourmalineContext database
@if (!string.IsNullOrEmpty(TourmalineService.SessionConfig.InitError))
{
    <div class="alert alert-warning" role="alert">
        <strong>Arranque en modo degradado.</strong>
        <p class="mb-1">@TourmalineService.SessionConfig.InitError</p>
        <p class="mb-0">Si la base local se regeneró vacía, descarga de nuevo Zafiro y sincroniza Diamond.</p>
    </div>
}
<Switch Label="Dummy Keyboard" Value="@TourmalineService.SessionConfig.ServiceMode.ServiceKeyboard"
        ValueChanged="@((bool v) => SetDebugKeyboard(v))" />
@if(null==mvarLocalSystem)
{
    <p>No se ha abierto el registro interno</p>
}
else
{
    <p>Registro</p>
    <table class="table table-striped table-bordered mt-4">
        <thead>
            <tr>                
                <th>Campo</th>
                <th>Valor</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td>TrainId</td>
                <td>@mvarLocalSystem.TrainId.ToString()</td>
            </tr>
            <tr>
                <td>Name</td>
                <td>@mvarLocalSystem.TrainName</td>
            </tr>
            <tr>
                <td>Ult. Sinc. Datos</td>
                <td>@(Utils.autoDate(mvarLocalSystem.LastSapphireDownload))</td>
            </tr>
            @if(mvarLocalSystem.LastAeneasSync>DateTime.MinValue)
            {
                <tr>
                    <td>Ult. Sinc. Taller</td>
                    <td>@(Utils.autoDate(mvarLocalSystem.LastAeneasSync))</td>
                </tr>
            }
            @if (mvarLocalSystem.LastDiamondSync > DateTime.MinValue)
            {
                <tr>
                    <td>Sinc. Diamond</td>
                    <td>@(Utils.autoDate(mvarLocalSystem.LastDiamondSync))</td>
                </tr>
            }
            @if (mvarLocalSystem.LastTopoSync > DateTime.MinValue)
            {
                <tr>
                    <td>Ult. Sinc. Topología</td>
                    <td>@(Utils.autoDate(mvarLocalSystem.LastTopoSync))</td>
                </tr>
            }
            @if (mvarLocalSystem.LastPlanSync > DateTime.MinValue)
            {
                <tr>
                    <td>Ult. Sinc. Plan publicado</td>
                    <td>@(Utils.autoDate(mvarLocalSystem.LastPlanSync))</td>
                </tr>
            }
            @if (!Guid.Empty.Equals(mvarLocalSystem.CurrentTopoId))
            {
                <tr>
                    <td>TopoId</td>
                    <td>@mvarLocalSystem.CurrentTopoId</td>
                </tr>
            }
        </tbody>
    </table>
}
<p>Archivo de Configuración</p>
<table class="table table-striped table-bordered mt-4">
    <thead>
        <tr>
            <th>Sección</th>
            <th>Campo</th>
            <th>Valor</th>
        </tr>
    </thead>
    <tbody>
        <tr>
            <td></td>
            <td>UT</td>
            <td>@TourmalineService.SystemConfig.Name</td>
        </tr>
        <tr>
            <td>@TourmalineService.SystemConfig.Cameras.Count cámaras</td>
            <td></td>
            <td></td>
        </tr>
        @foreach(CameraInfo cameraInfo in TourmalineService.SystemConfig.Cameras)
        {
            <tr>
                <td>@cameraInfo.Id</td>
                <td>@cameraInfo.Name @cameraInfo.CameraType.ToString()</td>
                <td>@cameraInfo.IpAddress.ToString()</td>                                                                                
            </tr>            
        }
    </tbody>
</table>

@code {
    private DBLocalSystem? mvarLocalSystem;
    protected async override Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        mvarLocalSystem = await database.LocalSystem.FirstOrDefaultAsync();
    }
    private void SetDebugKeyboard(bool rhs)
    {
        TourmalineService.SessionConfig.ServiceMode.ServiceKeyboard = rhs;
    }


}
