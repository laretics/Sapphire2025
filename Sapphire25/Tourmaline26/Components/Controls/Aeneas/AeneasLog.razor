@using Tourmaline26.Components.Controls.Floatings
@using Sapphire2026.Data.Models
@using Sapphire2025Models.Aeneas
@using Sapphire2025Models.Authentication
@using Microsoft.EntityFrameworkCore;
@using Tourmaline26.Services.LocalDataModel
@inject Tourmaline26.Logic.TourmalineContext database
@inject TourmalineService TourmalineService
@inject Sapphire2025.Storage.AeneasClient AeneasService
@inject ILogger<AeneasLog> logger
<FloatRightContainer>
    @if (mvarIsLoading)
    {
        <div class="d-flex justify-content-center align-items-center" style="height: 200px;">
            <div class="spinner-border text-primary" role="status" style="width: 4rem; height: 4rem;">
                <span class="visually-hidden">@mvarProcessMessage</span>
            </div>
        </div>
    }
    else
    {
        @if (Guid.Empty == TourmalineService.SystemConfig.TrainId)
        {
            <h2>No se han iniciado los datos</h2>
            <p>El sistema de información al viajero necesita una primera sincronización con la base de datos para obtener la información de este tren y, por tanto, sus datos de taller.</p>
            <p>Si considera que debe tener acceso a esta información póngase en contacto con el personal de mantenimiento.</p>
        }
        @if (mvarErrorMessage.Length > 0)
        {
            <h2>Error</h2>
            <p>@mvarErrorMessage</p>
        }
        @if (mcolNotes.Count > 0)
        {
            <h3>Historial de taller</h3>
            <div style="max-height: 580px; overflow-y: auto;">
                <CascadingValue Value="TourmalineService.SessionConfig.ColUsers">
                    @foreach(FeedEntry entry in FeedItems)
                    {
                        if(entry.Kind== FeedKind.Note && null!=entry.Note)
                        {
                            <NoteChatEntry Note="entry.Note" />
                        }
                        if(entry.Kind== FeedKind.StatusChange && null!=entry.StatusChange)
                        {
                            <StatusChangeChatEntry ChangeModel="entry.StatusChange" />
                        }
                    }
                </CascadingValue>
            </div>
        }
        else
        {
            <p>El historial de mantenimiento está vacío</p>
        }
    }
</FloatRightContainer>
    @code {
    private string mvarErrorMessage = string.Empty;
    private List<NoteModel> mcolNotes = new List<NoteModel>();
    private List<StatusChangeModel> mcolStatusChanges = new List<StatusChangeModel>();
    private List<FeedEntry> FeedItems { get; set; } = new();
    private bool mvarIsLoading = true;
    private string mvarProcessMessage = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        mvarIsLoading = true;
        mvarProcessMessage = "Recuperando información de la base de datos...";
        await InvokeAsync(StateHasChanged);
        await TourmalineService.EnsureInitialized();
        if(null== TourmalineService.SessionConfig.ColUsers)
        {
            mvarProcessMessage = "Obteniendo colección de usuarios...";
            await InvokeAsync(StateHasChanged);

            await TourmalineService.RetrieveUsers();
        }        

        mvarProcessMessage = "Conectando con Zafiro...";
        await InvokeAsync(StateHasChanged);

        await SyncAeneas();

        mvarProcessMessage = "Obteniendo notas...";
        await InvokeAsync(StateHasChanged);
        try
        {
            mcolNotes = await GetNotes();
            mcolStatusChanges = await GetChanges();
            BuildFeed();
        }
        catch (Exception ex)
        {
            logger.LogError(ex.Message);
        }

        mvarIsLoading = false;
        await InvokeAsync(StateHasChanged);
    }

    private UserModelBase? userFromStatus(StatusChangeModel rhs)
    {
        System.Diagnostics.Debug.Assert(null != TourmalineService.SessionConfig.ColUsers);
        Dictionary<Guid, UserModelBase> Users = TourmalineService.SessionConfig.ColUsers;
        if (Guid.Empty != rhs.userId && Users.ContainsKey(rhs.userId))
            return Users[rhs.userId];
        return null;
    }

    /// <summary>
    /// Intenta sincronizar la base de datos con Zafiro. Si no lo consigue, mostrará la base de datos local.
    /// </summary>
    /// <returns></returns>
    private async Task SyncAeneas()
    {
        Note? oldest = null;
        try
        {
            List<NoteModel> auxLista
            = await AeneasService.retrieveNotes(TourmalineService.SystemConfig.TrainId, "", 100);
            if(auxLista.Count>0)
            {
                //Sustituyo el contenido íntegro de la tabla local por el que acabo de descargar.
                database.Notes.RemoveRange(database.Notes);
                foreach(NoteModel note in auxLista)
                {
                    database.Notes.Add(new Note
                    {
                        Id = Guid.NewGuid(),
                        Parent = note.parent,
                        UserId = note.UserId,
                        TimeStamp = note.TimeStamp,
                        Text = note.Text,
                        Type= note.Type
                    });
                }
                await database.SaveChangesAsync();                
                oldest = await database.Notes.OrderBy(x => x.TimeStamp).FirstOrDefaultAsync();
                await TourmalineService.DoAeneasSync();
            }
            DateTime auxFecha = null == oldest ? DateTime.MinValue : oldest.TimeStamp;
            IEnumerable<StatusChangeModel> auxChanges
            = await AeneasService.trainChangesList(TourmalineService.SystemConfig.TrainId, auxFecha);
            if(auxChanges.Any())
            {
                database.StatusChanges.RemoveRange(database.StatusChanges);
                foreach(StatusChangeModel change in auxChanges)
                {
                    database.StatusChanges.Add(
                        new StatusChange
                            {
                                Guid = change.guid,
                                TrainId = change.trainId,
                                TimeStamp = change.timeStamp,
                                Operation = change.operation,
                                UserId = change.userId
                            });
                }
                await database.SaveChangesAsync();
                await TourmalineService.DoAeneasSync();
            }
        }
        catch(Exception ex)
        {
            mvarErrorMessage = string.Format("No se han podido sincronizar los datos con Zafiro. Se mostrarán los datos almacenados en la base de datos local. Detalle del error: {0}", ex.Message);
        }
    }
    private async Task<List<NoteModel>> GetNotes()
    {
        List<NoteModel> result = new List<NoteModel>();
        List<Note> auxLista = database.Notes.OrderByDescending(n => n.TimeStamp).ToList();
        foreach(Note note in auxLista)
        {
            result.Add(new NoteModel
            {
                parent = note.Parent,
                UserId = note.UserId,
                TimeStamp = note.TimeStamp,
                Text = note.Text,
                Type = note.Type
            });
        }
        return result;
    }
    private async Task<List<StatusChangeModel>> GetChanges()
    {
        List<StatusChangeModel> result = new List<StatusChangeModel>();
        List<StatusChange> auxLista = database.StatusChanges.OrderByDescending(n => n.TimeStamp).ToList();
        foreach(StatusChange change in auxLista)
        {
            result.Add(new StatusChangeModel
                {
                    guid = change.Guid,
                    trainId = change.TrainId,
                    timeStamp = change.TimeStamp,
                    operation = change.Operation,
                    userId = change.UserId
                });
        }
        return result;
    }



    private enum FeedKind : byte
    {
        Note,
        StatusChange
    }
    private sealed record FeedEntry
    (
        FeedKind Kind,
        DateTime TimeStamp,
        int sequence,
        NoteModel? Note,
        StatusChangeModel? StatusChange
    );

    private string BuildStatusSummary(StatusChangeModel rhs)
    {
        string userName = userFromStatus(rhs)?.Name ?? "[Desconocido]";
        if (string.IsNullOrWhiteSpace(rhs.comment))
            return $"{userName} · {rhs.description}";

        return $"{userName} · {rhs.description} · {rhs.comment}";
    }
    private void BuildFeed()
    {
        List<FeedEntry> items = new();
        int sequence = 0;
        if (null != mcolNotes)
        {
            foreach (NoteModel note in mcolNotes)
                items.Add(new FeedEntry(FeedKind.Note, note.TimeStamp, sequence++, note, null));
        }
        if (null != mcolStatusChanges)
        {
            foreach (StatusChangeModel change in mcolStatusChanges)
                items.Add(new FeedEntry(FeedKind.StatusChange, change.timeStamp, sequence++, null, change));
        }

        FeedItems = items.OrderByDescending(x => x.TimeStamp)
                    .ThenBy(x => x.sequence)
                    .ToList();
    }


}
