@using Tourmaline26.Components.Controls.Floatings
@using Sapphire2026.Data.Models
@using Sapphire2025Models.Aeneas
@using Sapphire2025Models.Authentication
@using Microsoft.EntityFrameworkCore
@using Tourmaline26.Services.LocalDataModel
@using Sapphire2025.Storage
@inject Tourmaline26.Logic.TourmalineContext database
@inject TourmalineService TourmalineService
@inject AeneasClient AeneasService
@inject ILogger<AeneasLog> logger

<FloatRightContainer>
    @if (mvarIsLoading)
    {
        <div class="d-flex justify-content-center align-items-center" style="height: 200px;">
            <div class="spinner-border text-primary" role="status" style="width: 4rem; height: 4rem;">
                <span class="visually-hidden">@mvarProcessMessage</span>
            </div>
        </div>
    }
    else
    {
        @if (Guid.Empty == TourmalineService.SystemConfig.TrainId)
        {
            <h2>No se han iniciado los datos</h2>
            <p>El sistema de información al viajero necesita una primera sincronización con la base de datos para obtener la información de este tren y, por tanto, sus datos de taller.</p>
            <p>Si considera que debe tener acceso a esta información póngase en contacto con el personal de mantenimiento.</p>
        }
        @if (mvarErrorMessage.Length > 0)
        {
            <h2>Error</h2>
            <p>@mvarErrorMessage</p>
        }
        @if (FeedItems.Count > 0)
        {
            <h3>Historial de taller</h3>
            <div style="max-height: 580px; overflow-y: auto;">
                <CascadingValue Value="TourmalineService.SessionConfig.ColUsers">
                    @foreach (FeedEntry entry in FeedItems)
                    {
                        if (entry.Kind == FeedKind.Note && null != entry.Note)
                        {
                            <NoteChatEntry Note="entry.Note" />
                        }
                        if (entry.Kind == FeedKind.StatusChange && null != entry.StatusChange)
                        {
                            <StatusChangeChatEntry ChangeModel="entry.StatusChange" />
                        }
                    }
                </CascadingValue>
            </div>
        }
        else if (Guid.Empty != TourmalineService.SystemConfig.TrainId && mvarErrorMessage.Length == 0)
        {
            <p>El historial de mantenimiento está vacío</p>
        }
    }
</FloatRightContainer>

@code {
    private string mvarErrorMessage = string.Empty;
    private List<NoteModel> mcolNotes = new();
    private List<StatusChangeModel> mcolStatusChanges = new();
    private List<FeedEntry> FeedItems { get; set; } = new();
    private bool mvarIsLoading = true;
    private string mvarProcessMessage = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        mvarIsLoading = true;
        mvarProcessMessage = "Recuperando información de la base de datos...";
        await InvokeAsync(StateHasChanged);
        await TourmalineService.EnsureInitialized();

        if (null == TourmalineService.SessionConfig.ColUsers)
        {
            mvarProcessMessage = "Obteniendo colección de usuarios...";
            await InvokeAsync(StateHasChanged);
            await TourmalineService.RetrieveUsers();
        }

        mvarProcessMessage = "Conectando con Zafiro...";
        await InvokeAsync(StateHasChanged);
        await SyncAeneas();

        mvarProcessMessage = "Obteniendo notas...";
        await InvokeAsync(StateHasChanged);
        try
        {
            mcolNotes = GetNotesFromLocal();
            mcolStatusChanges = GetChangesFromLocal();
            BuildFeed();
        }
        catch (Exception ex)
        {
            logger.LogError(ex, "Error al montar el historial de taller local");
            mvarErrorMessage = ex.Message;
        }

        mvarIsLoading = false;
        await InvokeAsync(StateHasChanged);
    }

    /// <summary>Tope de entradas del historial (notas + cambios) que se piden y se guardan.</summary>
    private const int MaxFeedItems = 60;

    /// <summary>No se pide ni se guarda nada anterior a esta ventana.</summary>
    private static readonly TimeSpan HistoryWindow = TimeSpan.FromDays(62);

    /// <summary>
    /// Sincroniza con Zafiro vía <see cref="AeneasClient"/> (Sapphire2026Clients)
    /// y actualiza la BD SQLite local. Si falla, se muestra el almacén local.
    /// </summary>
    private async Task SyncAeneas()
    {
        Guid trainId = TourmalineService.SystemConfig.TrainId;
        if (Guid.Empty == trainId)
            return;

        DateTime cutoff = DateTime.Now.Subtract(HistoryWindow);

        try
        {
            List<NoteModel> auxLista = await AeneasService.retrieveNotes(
                trainId,
                type: "",
                max: MaxFeedItems);
            auxLista = TruncateNotes(auxLista, cutoff, MaxFeedItems);

            database.Notes.RemoveRange(database.Notes);
            foreach (NoteModel note in auxLista)
            {
                database.Notes.Add(new Note
                {
                    Id = Guid.Empty.Equals(note.Id) ? Guid.NewGuid() : note.Id,
                    Parent = note.parent,
                    UserId = note.UserId,
                    TimeStamp = note.TimeStamp,
                    Text = note.Text,
                    Type = note.Type,
                    ClosureTime = note.ClosureTime,
                    ClosureUser = note.ClosureUser,
                    IsValid = note.IsValid,
                    IsSymptom = note.IsSymptom,
                    SystemAffected = note.SystemAffected,
                    MediaExtension = note.MediaExtension,
                    MediaContentType = note.MediaContentType
                });
            }
            await database.SaveChangesAsync();

            IEnumerable<StatusChangeModel> auxChanges =
                await AeneasService.trainChangesList(trainId, cutoff);
            List<StatusChangeModel> changeList = TruncateChanges(auxChanges, cutoff, MaxFeedItems);

            database.StatusChanges.RemoveRange(database.StatusChanges);
            foreach (StatusChangeModel change in changeList)
            {
                database.StatusChanges.Add(new StatusChange
                {
                    Guid = change.guid,
                    TrainId = change.trainId,
                    TimeStamp = change.timeStamp,
                    Operation = change.operation,
                    UserId = change.userId
                });
            }
            await database.SaveChangesAsync();
            await TourmalineService.DoAeneasSync();
        }
        catch (Exception ex)
        {
            logger.LogWarning(ex, "Fallo al sincronizar Aeneas con Zafiro");
            mvarErrorMessage =
                "No se han podido sincronizar los datos con Zafiro. " +
                "Se mostrarán los datos almacenados en la base de datos local. " +
                $"Detalle: {ex.Message}";
        }
    }

    private static List<NoteModel> TruncateNotes(
        IEnumerable<NoteModel> notes,
        DateTime cutoff,
        int max)
    {
        return notes
            .Where(n => n.TimeStamp >= cutoff)
            .OrderByDescending(n => n.TimeStamp)
            .Take(max)
            .ToList();
    }

    private static List<StatusChangeModel> TruncateChanges(
        IEnumerable<StatusChangeModel> changes,
        DateTime cutoff,
        int max)
    {
        return changes
            .Where(c => c.timeStamp >= cutoff)
            .OrderByDescending(c => c.timeStamp)
            .Take(max)
            .ToList();
    }

    private List<NoteModel> GetNotesFromLocal()
    {
        List<NoteModel> result = new();
        DateTime cutoff = DateTime.Now.Subtract(HistoryWindow);
        foreach (Note note in database.Notes
            .Where(n => n.TimeStamp >= cutoff)
            .OrderByDescending(n => n.TimeStamp)
            .Take(MaxFeedItems))
        {
            result.Add(new NoteModel
            {
                Id = note.Id,
                parent = note.Parent,
                UserId = note.UserId,
                TimeStamp = note.TimeStamp,
                Text = note.Text,
                Type = note.Type,
                ClosureTime = note.ClosureTime,
                ClosureUser = note.ClosureUser,
                IsValid = note.IsValid,
                IsSymptom = note.IsSymptom,
                SystemAffected = note.SystemAffected,
                MediaExtension = note.MediaExtension,
                MediaContentType = note.MediaContentType
            });
        }
        return result;
    }

    private List<StatusChangeModel> GetChangesFromLocal()
    {
        List<StatusChangeModel> result = new();
        DateTime cutoff = DateTime.Now.Subtract(HistoryWindow);
        foreach (StatusChange change in database.StatusChanges
            .Where(n => n.TimeStamp >= cutoff)
            .OrderByDescending(n => n.TimeStamp)
            .Take(MaxFeedItems))
        {
            result.Add(new StatusChangeModel
            {
                guid = change.Guid,
                trainId = change.TrainId,
                timeStamp = change.TimeStamp,
                operation = change.Operation,
                userId = change.UserId
            });
        }
        return result;
    }

    private enum FeedKind : byte
    {
        Note,
        StatusChange
    }

    private sealed record FeedEntry(
        FeedKind Kind,
        DateTime TimeStamp,
        int sequence,
        NoteModel? Note,
        StatusChangeModel? StatusChange);

    private void BuildFeed()
    {
        List<FeedEntry> items = new();
        int sequence = 0;

        foreach (NoteModel note in mcolNotes)
            items.Add(new FeedEntry(FeedKind.Note, note.TimeStamp, sequence++, note, null));

        foreach (StatusChangeModel change in mcolStatusChanges)
            items.Add(new FeedEntry(FeedKind.StatusChange, change.timeStamp, sequence++, null, change));

        FeedItems = items
            .OrderByDescending(x => x.TimeStamp)
            .ThenBy(x => x.sequence)
            .Take(MaxFeedItems)
            .ToList();
    }
}
