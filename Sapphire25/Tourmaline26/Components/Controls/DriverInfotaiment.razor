@* <VirtualKeyboard></VirtualKeyboard> *@
@using Tourmaline26.Components.Controls.Cameras
@using Tourmaline26.Components.Controls.Generical
@using Tourmaline26.Components.Controls.Floatings
@using Tourmaline26.Components.Controls.Generical.SideMenu
@using Tourmaline26.Components.Services
@using Tourmaline26.Components.Services.Logic.Generical
@using Sapphire2025Models.Authentication
@inject Sapphire2025.Storage.AuthenticationClient AuthenticationService
<div class="tesla-root">
    <ServiceModeFrame MaintenanceMessage="Mantenimiento" Maintenance="@mvarTourmaline.SessionConfig.ServiceMode">
        <div class="tesla-main">
            <div class="tesla-left @panelClass">
                @*  *@
                @* <Speedometer /> *@
            </div>
            <div class="tesla-right @panelClass">                
                @if(View3DEnabled)
                {
                    <SimulatorStream></SimulatorStream>
                }                
                <TeslaTopRightBar></TeslaTopRightBar>
                @if(RightPanelVisible)
                {
                    <SideMenu @ref="mvarSideMenu"></SideMenu>
                }
                else
                {
                    <FloatDestinationInput>Hola Mundo</FloatDestinationInput>
                }
            </div>        
            @if (CameraViewMode)
            {
                <CamerasView></CamerasView>
            }
        </div>
        @if(LoginMode)
        {
            <LoginCtl Login="OnUserLogin"  />
        }
    </ServiceModeFrame>
    <div class="tesla-bottom-bar">
        <TeslaToolBar Buttons="buttonData" @ref="mvarTeclado"/>
    </div>
</div>
@code {
    [Inject]
    private IJSRuntime JS { get; set; } = default!;
    [Inject]
    private TourmalineService mvarTourmaline{ get; set; }=default!;
    [CascadingParameter]
    public bool NightMode{ get; set; }
    [CascadingParameter]
    public Action<bool>? ToggleNightMode { get; set; }
    private TeslaToolBar? mvarTeclado{ get; set; }
    private SideMenu? mvarSideMenu{ get; set; }
    private bool LoginMode { get; set; } = false;
    public enum MainToolBarItem:byte
    {
        Train=0,
        NightMode=1,
        CCTV = 2,
        Microphone = 3,
        View3d = 4,
        Clipboard = 9
    }

    private bool RightPanelVisible
    {
        get => (null != buttonData && buttonData.Length > (Byte)MainToolBarItem.Train) 
            ? buttonData[(Byte)MainToolBarItem.Train].Selected : false;
    }
    private bool CameraViewMode
    {
        get =>(null!=buttonData && buttonData.Length > (Byte)MainToolBarItem.CCTV) 
            ? buttonData[(Byte)MainToolBarItem.CCTV].Selected : false;
    }

    [JSInvokable]
    public async Task HandleKey(string key)
    {
        if (byte.TryParse(key, out _) && null != mvarTeclado)
            await mvarTeclado.ManagePhysicalKeyboard(key);
        if(buttonData[(byte)MainToolBarItem.Train].Selected && null!=mvarSideMenu)
            await mvarSideMenu.ManagePhysicalKeyboard(key);
    }

    private TeslaButton[] buttonData = Array.Empty<TeslaButton>();
    protected override void OnInitialized()
    {
        base.OnInitialized();
        buttonData = new TeslaButton[]
        {
            new("Train",null,true,EventCallback.Factory.Create(this, () => OnButtonInternalChanged()), "Main Menu"),
            new("BlackSun","WhiteSun",true,EventCallback.Factory.Create(this, () => NightModeChanged()),"Night Mode"),
            new("CCTV",null,true,EventCallback.Factory.Create(this, () => OnButtonInternalChanged()),"Cameras"),
            new("Microphone",null,true,null,"Microphone"),
            new("3DOn","3DOff",true,EventCallback.Factory.Create(this, () => OnButtonInternalChanged()), "View3D"),
            new(""),
            new(""),            
            new(""),                                    
            new("Clipboard",null,true,EventCallback.Factory.Create(this, () => OnButtonInternalChanged()), "Damage Clipboard"),
            new("Key",null,false,EventCallback.Factory.Create(this, () => OnLoginRequest()),"Login"),
        };
        mvarTourmaline.HMIUpdateRequested += OnExternalEventChanged;
    }

    private string panelClass
    {
        get => string.Format("teslapanel {0}", NightMode ? "night" : "day");        
    }
    private bool View3DEnabled
    {
        get
        {
            byte index = (byte)MainToolBarItem.View3d;
            if(null!=buttonData && buttonData.Length>index)
                return !buttonData[index].Selected;
            return true;            
        }
    }
    private void NightModeChanged()
    {
        ToggleNightMode?.Invoke(buttonData[(byte)MainToolBarItem.NightMode].Selected);
    }

    [Parameter]
    public string MaintenanceMessage { get; set; } = "Modo de Mantenimiento";

    private void OnExternalEventChanged(object? sender, EventArgs e)
    {
        InvokeAsync(StateHasChanged);
    }
    private void OnButtonInternalChanged()
    {
        //Aprovechamos para validar la lógica de los botones de la barra de tareas.
        //No se puede abrir ninguno de los botones si está seleccionado el modo de cámaras.
        if(buttonData[(byte)MainToolBarItem.CCTV].Selected)
        {
            buttonData[(byte)MainToolBarItem.Train].Selected = false;
            buttonData[(byte)MainToolBarItem.Clipboard].Selected = false;
        }
        //No se puede abrir la sección de partes de avería si está seleccionado el menú principal.
        if (buttonData[(byte)MainToolBarItem.Train].Selected)
            buttonData[(byte)MainToolBarItem.Clipboard].Selected = false;
        StateHasChanged();
    }    
    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            // Registrar el evento de teclado
            _ = JS.InvokeVoidAsync("TeslaToolBar_registerKeyHandler", DotNetObjectReference.Create(this));
        }
    }
    protected void OnLoginRequest()
    {
        LoginMode = true;
        StateHasChanged();
    }
    protected async Task OnUserLogin((string username, string password) credentials)
    {
        // Aquí iría la lógica de autenticación real
        // Por ahora, simplemente salimos del modo de login
        UserLoginModel modelo = new UserLoginModel();
        SessionModel? sesion;
        modelo.userName = credentials.username;
        modelo.password = credentials.password;        
        sesion = await AuthenticationService.Login(modelo);
        LoginMode = false;
        StateHasChanged();
    }
    public void Dispose()
    {
        _ = JS.InvokeVoidAsync("TeslaToolBar_unregisterKeyHandler");
        mvarTourmaline.HMIUpdateRequested -= OnExternalEventChanged;
    }
}
