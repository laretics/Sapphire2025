@* <VirtualKeyboard></VirtualKeyboard> *@
<div class="tesla-root">
    <ServiceModeFrame MaintenanceMessage="Mantenimiento" Maintenance="IsMaintenanceMode">
        <div class="tesla-main">
            <div class="tesla-left @panelClass">
                <img src="img/Wireframe1.png" />
                <Speedometer />
            </div>
            <div class="tesla-right @panelClass">
                <SimulatorStream></SimulatorStream>
                <Tourmaline26.Components.Controls.Floatings.FloatDestinationInput>Hola Mundo</Tourmaline26.Components.Controls.Floatings.FloatDestinationInput>
            </div>
        </div>
    </ServiceModeFrame>

    <div class="tesla-bottom-bar">
        <TeslaToolBar ButtonClickCallback="buttonCallbacks" />
    </div>
</div>
@code {
    [CascadingParameter]
    public bool NightMode{ get; set; }
    [CascadingParameter]
    public Action? ToggleNightMode { get; set; }



    private bool mvarMaintenance;
    private EventCallback[] buttonCallbacks;
    protected override void OnInitialized()
    {
        base.OnInitialized();
        buttonCallbacks = new EventCallback[]
        {
            EventCallback.Factory.Create(this, ()=>ToggleMaintenanceMode()),
            EventCallback.Factory.Create(this, ()=>ToggleNightMode?.Invoke()),
            EventCallback.Factory.Create(this, ()=>ToggleMaintenanceMode())
        };
    }

    private string panelClass
    {
        get => string.Format("teslapanel {0}", NightMode ? "night" : "day");
    }

    [Parameter]
    public bool IsMaintenanceMode     
    { 
        get => mvarMaintenance;
        set
        {
            mvarMaintenance = value;
            StateHasChanged();
        }
    }
    [Parameter]
    public string MaintenanceMessage { get; set; } = "Modo de Mantenimiento";

    private void ToggleMaintenanceMode()
    {
        IsMaintenanceMode = !IsMaintenanceMode;
    }
}
