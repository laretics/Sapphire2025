@* <VirtualKeyboard></VirtualKeyboard> *@
@using System.Threading.Tasks
@using Tourmaline26.Components.Controls.Cameras
@using Tourmaline26.Components.Controls.Generical
@using Tourmaline26.Components.Services
@using Tourmaline26.Components.Controls.Aeneas
@using Tourmaline26.Components.Services.Logic.Generical
@using Tourmaline26.Components.Controls.Generical.SideMenu
@inject ILogger<DriverInfotaiment> Logger
@inject Sapphire2025.Storage.IntStorageService InternalStorage
<div class="tesla-root @(NightMode?" night":"")">
    @if(mvarTourmaline.SystemInitialized)
    {
        <ServiceModeFrame MaintenanceMessage="Mantenimiento" Maintenance="@mvarTourmaline.SessionConfig.ServiceMode">
            <div class="tesla-main">
                <div class="tesla-left @panelClass">
                    <TeslaLeftSection/>
                    
                </div>
                <div class="tesla-right @panelClass">
                    @if (View3DEnabled)
                    {
                        <SimulatorStream StreamHost="http://LocalHost:5005/stream" />
                    }
                    <TeslaRightSection />
                    @if (RightPanelVisible)
                    {
                        <SideMenu @ref="mvarSideMenu"/>
                    }
                    else if (AeneasPanelVisible)
                    {
                        <AeneasLog/>
                    }
                </div>
                @if (CameraViewMode)
                {
                    <CamerasView></CamerasView>
                }
            </div>
            @if (LoginMode)
            {
                <LoginCtl Login="OnUserLogin" />
            }
        </ServiceModeFrame>
        <div class="tesla-bottom-bar">
            <TeslaToolBar Buttons="buttonData" @ref="mvarTeclado" />
        </div>
    }
    else
            {
            <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.95); z-index: 2000;" aria-modal="true" role="dialog">
                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content bg-dark text-light border-0 shadow-lg" style="background: transparent;">
                        <div class="modal-body text-center">
                            <div class="mb-4">
                                <div class="spinner-border text-primary" style="width: 5rem; height: 5rem;" role="status">
                                    <span class="visually-hidden">Cargando...</span>
                                </div>
                            </div>
                            <h2 class="fw-bold mb-3" style="letter-spacing: 2px;">Iniciando sistema</h2>
                            <p class="lead mb-4">Por favor, espera unos segundos.<br />Estamos preparando tu experiencia de viaje...</p>
                            <div class="d-flex justify-content-center gap-3">
                                <i class="bi bi-train-front fs-1 text-info"></i>
                                <i class="bi bi-lightning-charge fs-1 text-warning"></i>
                                <i class="bi bi-stars fs-1 text-primary"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
    }
</div>
@code {
    [Inject]
    private IJSRuntime JS { get; set; } = default!;
    [Inject]
    private TourmalineService mvarTourmaline{ get; set; }=default!;
    [CascadingParameter]
    public bool NightMode{ get; set; }
    [CascadingParameter]
    public Action<bool>? ToggleNightMode { get; set; }
    private TeslaToolBar? mvarTeclado{ get; set; }
    private SideMenu? mvarSideMenu{ get; set; }
    private bool LoginMode { get; set; } = false;
    public enum MainToolBarItem:byte
    {
        Train=0,
        NightMode=1,
        CCTV = 2,
        Microphone = 3,
        View3d = 4,
        TimeNet = 7,
        Clipboard = 8,
        UserSession = 9
    }
    private bool AeneasPanelVisible
    {
        get => (null != buttonData && ZeroSpeed && buttonData.Length > (byte)MainToolBarItem.Clipboard)
        ? buttonData[(byte)MainToolBarItem.Clipboard].Selected : false;
    }
    private bool RightPanelVisible
    {
        get => (null != buttonData && buttonData.Length > (Byte)MainToolBarItem.Train) 
            ? buttonData[(Byte)MainToolBarItem.Train].Selected : false;
    }
    private bool CameraViewMode
    {
        get =>(null!=buttonData && buttonData.Length > (Byte)MainToolBarItem.CCTV) 
            ? buttonData[(Byte)MainToolBarItem.CCTV].Selected : false;
    }

    [JSInvokable]
    public async Task HandleKey(string key)
    {
        if (mvarTourmaline.SessionConfig.ServiceKeyboard)
            HandleServiceKey(key);
        else
        {
            if (byte.TryParse(key, out _) && null != mvarTeclado)
                await mvarTeclado.ManagePhysicalKeyboard(key);
            if (buttonData[(byte)MainToolBarItem.Train].Selected && null != mvarSideMenu)
                await mvarSideMenu.ManagePhysicalKeyboard(key);
        }
    }

    /// <summary>
    /// Esta función utiliza el teclado físico para probar de forma dinámica los
    /// elementos activos del sistema.
    /// </summary>
    /// <param name="key"></param>
    private void HandleServiceKey(string key)
    {
        SessionConfiguration auxConfig = mvarTourmaline.SessionConfig;
        switch(key)
        {
            case "ArrowUp": //Aumentar velocidad.                
                auxConfig.CurrentSpeed += 10; break;
            case "ArrowDown": //Reducir velocidad.
                auxConfig.CurrentSpeed -= 10; break;
            case "2": //Aumentar límite.
                auxConfig.CurrentLimitSpeed += 10; break;
            case "1": //Reducir límite.
                auxConfig.CurrentLimitSpeed -= 10; break;
            case "4": //Aumentar objetivo.
                auxConfig.CurrentNeutralSpeed += 10; break;
            case "3": //Reducir objetivo.
                auxConfig.CurrentNeutralSpeed -= 10; break;
        }
    }
    private bool ZeroSpeed { get => mvarTourmaline.SessionConfig.CurrentSpeed < 10; }
    private TeslaButton[] buttonData = Array.Empty<TeslaButton>();
    protected async override Task OnInitializedAsync()
    {
        buttonData = new TeslaButton[]
        {
            new("Train",null,true,EventCallback.Factory.Create(this, () => OnButtonInternalChanged()), "Main Menu"),
            new("BlackSun","WhiteSun",true,EventCallback.Factory.Create(this, () => NightModeChanged()),"Night Mode"),
            new("CCTV",null,true,EventCallback.Factory.Create(this, () => OnButtonInternalChanged()),"Cameras"),
            new("Microphone",null,true,null,"Microphone"),
            new("3DOn","3DOff",true,EventCallback.Factory.Create(this, () => OnButtonInternalChanged()), "View3D"),
            new(""),
            new(""),
            new("Bezier",null,true,null,"Time Net",true),
            new("Clipboard",null,true,EventCallback.Factory.Create(this, () => OnButtonInternalChanged()), "Damage Clipboard",true),
            new("KeyOff","Key",false,EventCallback.Factory.Create(this, () => OnLoginRequest()),"Login",true),
        };     
        mvarTourmaline.HMIUpdateRequested += auxHMIRefresh;

    }
    private void auxHMIRefresh(object? sender, EventArgs e) 
    {
        bool zeroSpeed = ZeroSpeed;
        buttonData[(byte)MainToolBarItem.TimeNet].Enabled = zeroSpeed;
        buttonData[(byte)MainToolBarItem.UserSession].Enabled = zeroSpeed;
        buttonData[(byte)MainToolBarItem.Clipboard].Enabled = zeroSpeed;

        InvokeAsync(StateHasChanged); 
    }

    protected async override Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {            
            _ = JS.InvokeVoidAsync("TeslaToolBar_registerKeyHandler", DotNetObjectReference.Create(this));
        }        
    }
    public void Dispose()
    {
        _ = JS.InvokeVoidAsync("TeslaToolBar_unregisterKeyHandler");
        mvarTourmaline.HMIUpdateRequested -= auxHMIRefresh;
    }
    private string panelClass
    {
        get => string.Format("teslapanel {0}", NightMode ? "night" : "day");        
    }
    private bool View3DEnabled
    {
        get
        {
            byte index = (byte)MainToolBarItem.View3d;
            if(null!=buttonData && buttonData.Length>index)
                return !buttonData[index].Selected;
            return true;            
        }
    }
    private void NightModeChanged()
    {
        ToggleNightMode?.Invoke(buttonData[(byte)MainToolBarItem.NightMode].Selected);
    }

    [Parameter]
    public string MaintenanceMessage { get; set; } = "Modo de Mantenimiento";



    private void OnButtonInternalChanged()
    {
        //Aprovechamos para validar la lógica de los botones de la barra de tareas.
        buttonData[(byte)MainToolBarItem.UserSession].Selected = (null != mvarTourmaline.SessionConfig.Session);
        //No se puede abrir ninguno de los botones si está seleccionado el modo de cámaras.
        if(buttonData[(byte)MainToolBarItem.CCTV].Selected)
        {
            buttonData[(byte)MainToolBarItem.Train].Selected = false;
            buttonData[(byte)MainToolBarItem.Clipboard].Selected = false;
        }
        //No se puede abrir la sección de partes de avería si está seleccionado el menú principal.
        if (buttonData[(byte)MainToolBarItem.Train].Selected)
            buttonData[(byte)MainToolBarItem.Clipboard].Selected = false;        
        StateHasChanged();
    }    

    protected async Task OnLoginRequest()
    {
        if(null==mvarTourmaline.SessionConfig.Session)
            LoginMode = true;
        else
            await mvarTourmaline.UserLogout();
        OnButtonInternalChanged();
    }
    protected async Task OnUserLogin((string username, string password) credentials)
    {
        // Aquí iría la lógica de autenticación real
        // Por ahora, simplemente salimos del modo de login
        await mvarTourmaline.UserLogin(credentials.username, credentials.password);
        await InternalStorage.SetSessionInfo(mvarTourmaline.SessionConfig.Session);
        LoginMode = false;
        OnButtonInternalChanged();
    }

}
