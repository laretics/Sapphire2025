@using Tourmaline26.Components.Images
@using Tourmaline26.Logic
@inject IJSRuntime JS
@implements IAsyncDisposable

@* Ventana emergente centrada (Bootstrap modal) alimentada por un único PassengerInformation. *@
@if (Info is not null && Info.IsVisible)
{
    @* @key: remonta el nodo al cambiar el mensaje → se repite la animación de atención. *@
    <div @key="AnimationKey"
         class="modal fade show d-block popup-information"
         tabindex="-1"
         role="dialog"
         aria-modal="true"
         aria-labelledby="@_titleId"
         style="@RootStyle">
        <div class="modal-dialog modal-dialog-centered popup-information-dialog" style="@DialogStyle">
            <div class="modal-content popup-information-content bg-dark bg-opacity-75 text-white border border-light border-opacity-25 shadow-lg">
                <div class="modal-header border-0 border-bottom border-light border-opacity-25 py-2 px-3">
                    <div class="d-flex align-items-center gap-2 w-100 min-w-0">
                        @if (ShowIcon)
                        {
                            <span class="popup-information-icon flex-shrink-0 d-inline-flex">
                                <ColorIcon Name="@IconName"
                                           Size="@IconSize"
                                           Color="currentColor"
                                           Glow="false" />
                            </span>
                        }
                        <h5 id="@_titleId"
                            class="modal-title popup-information-title fw-semibold mb-0 text-truncate flex-grow-1"
                            style="@TitleStyle">
                            @Header
                        </h5>
                    </div>
                </div>
                <div class="modal-body popup-information-body d-flex align-items-center justify-content-center p-3 p-md-4">
                    <div @ref="_textHost" class="popup-information-text-host w-100 h-100">
                        <p @ref="_textElement"
                           class="popup-information-text mb-0 text-center fw-medium">
                            @BodyText
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@code {
    /// <summary>Mensaje a mostrar. Null o <see cref="PassengerInformation.IsVisible"/> = false → no se pinta.</summary>
    [Parameter] public PassengerInformation? Info { get; set; }

    private ElementReference _textHost;
    private ElementReference _textElement;
    private readonly string _titleId = $"popup-info-title-{Guid.NewGuid():N}";
    private bool _jsReady;
    private string _lastFitKey = string.Empty;

    private byte Importance => Info?.Importance ?? 0;
    private string Header => Info?.CurrentTitle ?? string.Empty;
    private string BodyText => Info?.CurrentText ?? string.Empty;
    private string IconName => Info?.IconKey ?? string.Empty;
    private bool ShowIcon => !string.IsNullOrWhiteSpace(Info?.IconKey);

    /// <summary>Clave de remount para reiniciar CSS animations al cambiar el anuncio.</summary>
    private string AnimationKey =>
        $"{Importance}|{Info?.LanguageIndex}|{Header}|{BodyText}|{IconName}|{Info?.Comment}";

    /// <summary>
    /// Escala visual del diálogo. Antes era Importance/255 (los de baja prioridad
    /// quedaban minúsculos). Ahora hay un suelo alto (~58%) y se sube hasta el 100%,
    /// de modo que un mensaje de prioridad baja se ve ~3–4× más grande que con la
    /// escala lineal antigua en esa zona.
    /// </summary>
    private double Scale
    {
        get
        {
            if (Importance == 0)
                return 0;
            double t = Importance / 255.0;
            // t=0.20 → 0.58+0.084=0.66 (antes 0.20 → ~3.3×)
            // t=0.47 (120/255) → 0.58+0.20=0.78 (antes 0.47 → ~1.7×, sigue muy legible)
            // t=1.00 → 1.00
            return 0.58 + 0.42 * t;
        }
    }

    private string DialogStyle =>
        $"width: {Scale * 100:0.###}%; height: {Scale * 100:0.###}%; max-width: none; margin: 0 auto;";

    private string RootStyle =>
        // z-index alto dentro de panel-body (no fixed al viewport).
        "z-index: 20; --bs-modal-bg: transparent; background-color: rgba(0, 0, 0, 0.35);";

    private string TitleStyle
    {
        get
        {
            // Título también más generoso en baja prioridad (antes ~1rem fijo de Bootstrap).
            int px = Math.Clamp((int)Math.Round(28 + Scale * 36), 28, 72);
            return $"font-size: {px}px; line-height: 1.15;";
        }
    }

    private int IconSize =>
        Math.Clamp((int)Math.Round(36 + Scale * 48), 36, 96);

    /// <summary>Techo del auto-fit del cuerpo: más alto y con suelo generoso.</summary>
    private int MaxFontPx =>
        Math.Clamp((int)Math.Round(96 + Scale * 200), 120, 320);

    /// <summary>
    /// Suelo del auto-fit: antes 12 px (ilegible en TFT). ~3–4× → 40–56 px.
    /// </summary>
    private int MinFontPx =>
        Math.Clamp((int)Math.Round(40 + Scale * 16), 40, 64);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Info is null || !Info.IsVisible)
            return;

        // Clave de contenido/tamaño: reajustar solo cuando cambia lo relevante.
        var fitKey =
            $"{Importance}|{Info.LanguageIndex}|{Header}|{BodyText}|{IconName}";
        if (fitKey == _lastFitKey && _jsReady)
            return;

        _lastFitKey = fitKey;

        try
        {
            await JS.InvokeVoidAsync(
                "tourmalinePopup.observe",
                _textElement,
                MinFontPx,
                MaxFontPx);
            _jsReady = true;
        }
        catch (JSDisconnectedException)
        {
            // Circuito desconectado: no reintentar.
        }
        catch (InvalidOperationException)
        {
            // Interop aún no disponible (prerender).
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (!_jsReady)
            return;

        try
        {
            await JS.InvokeVoidAsync("tourmalinePopup.unobserve", _textElement);
        }
        catch (JSDisconnectedException)
        {
        }
        catch (InvalidOperationException)
        {
        }
    }
}
