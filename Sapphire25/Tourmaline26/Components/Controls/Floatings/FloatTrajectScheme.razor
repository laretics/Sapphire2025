@using System.Globalization
@using Diamond.Cabin
@using Tourmaline26.Components.Images
@using Tourmaline26.Logic
@inject TourmalineService Tourmaline
@implements IDisposable

<div class="floating-traject-card shadow @panelClass">
    @if (IsUnscheduled)
    {
        <div class="fts-route">
            <span class="fts-origin" title="Sin datos de malla">Sin malla</span>
        </div>
    }
    else
    {
        <div class="fts-top">
            <span class="fts-eta" title="Arribada estimada">@EtaLabel</span>
            <span class="fts-remain" title="Distància pendent">@RemainingLabel</span>
            <span class="fts-pct" style="--pct: @ProgressPercent;" title="Recorregut">
                <span class="fts-pct-inner">@ProgressPercent.ToString(CultureInfo.InvariantCulture)%</span>
            </span>
        </div>

        <div class="fts-route">
            <span class="fts-origin" title="@OriginName">@OriginName</span>
            <div class="fts-bars" role="img" aria-label="Progrés del trajecte">
                <div class="fts-bar fts-bar--sched" style="width: @ScheduledWidth;"></div>
                <div class="fts-bar fts-bar--real" style="width: @ActualWidth;"></div>
            </div>
        </div>
    }

    <button class="btn btn-outline-secondary fts-end" onclick="@onTerminateCirculation">@Prefs.T("tm.end")</button>
</div>

@code {
    [Inject] public UserPreferencesService Prefs { get; set; } = default!;
    [CascadingParameter]
    public bool NightMode { get; set; }
    [Parameter]
    public EventCallback OnTerminateCirculationRequest { get; set; }

    private static readonly CultureInfo Catalan = CultureInfo.GetCultureInfo("ca-ES");

    private string panelClass =>
        string.Format("floating-panel {0}", NightMode ? "night" : "day");

    private CabinEnvironment? Cabin => Tourmaline.SessionConfig.Cabin;

    private Diamond.Project.Circulation? Circulation => Cabin?.Circulation;

    private bool IsUnscheduled =>
        Circulation is null && (Tourmaline.SessionConfig.HasUnscheduledTrain);

    protected override void OnInitialized()
    {
        Tourmaline.HMIUpdateRequested += OnHmi;
    }

    public void Dispose()
    {
        Tourmaline.HMIUpdateRequested -= OnHmi;
    }

    private void OnHmi(object? sender, EventArgs e)
    {
        InvokeAsync(StateHasChanged);
    }

    private string OriginName
    {
        get
        {
            string name = Circulation?.Asimilation?.Origin.Name ?? string.Empty;
            return string.IsNullOrWhiteSpace(name) ? "—" : name;
        }
    }

    private TimeSpan Delay => Cabin?.CurrentDelay ?? TimeSpan.Zero;

    private string EtaLabel
    {
        get
        {
            Diamond.Project.Circulation? cir = Circulation;
            if (cir is null)
                return "—";

            TimeSpan destArrival = DestinationArrival(cir);
            TimeSpan eta = destArrival;
            if (Delay.Ticks > 0)
                eta = destArrival + Delay;

            if (eta < TimeSpan.Zero)
                eta += TimeSpan.FromDays(1);
            if (eta >= TimeSpan.FromDays(1))
                eta -= TimeSpan.FromDays(1);

            return string.Format(
                CultureInfo.InvariantCulture,
                "{0:00}:{1:00}",
                (int)eta.TotalHours % 24,
                eta.Minutes);
        }
    }

    private string RemainingLabel
    {
        get
        {
            Diamond.Project.Circulation? cir = Circulation;
            CabinEnvironment? cabin = Cabin;
            if (cir is null || cabin is null)
                return "—";

            long? destPk = CabinItinerary.DestinationRoutePk(cir);
            if (!destPk.HasValue)
                return "—";

            long meters = Math.Abs(destPk.Value - cabin.PK);
            double km = meters / 1000.0;
            return string.Format(Catalan, "{0:0.0} km", km);
        }
    }

    private int ProgressPercent
    {
        get
        {
            CabinEnvironment? cabin = Cabin;
            if (cabin is null)
                return 0;
            double t = CabinItinerary.SpatialProgress(Circulation, cabin.PK);
            return (int)Math.Round(t * 100.0);
        }
    }

    private string ActualWidth => ProgressPercent.ToString(CultureInfo.InvariantCulture) + "%";

    private string ScheduledWidth
    {
        get
        {
            CabinEnvironment? cabin = Cabin;
            Diamond.Project.Circulation? cir = Circulation;
            if (cabin is null || cir is null)
                return "0%";

            long? schedPk = CabinItinerary.ScheduledPkAtTime(cir, cabin.ClockNow.TimeOfDay);
            if (!schedPk.HasValue)
                return "0%";

            double t = CabinItinerary.SpatialProgress(cir, schedPk.Value);
            int pct = (int)Math.Round(t * 100.0);
            return pct.ToString(CultureInfo.InvariantCulture) + "%";
        }
    }

    private static TimeSpan DestinationArrival(Diamond.Project.Circulation cir)
    {
        IReadOnlyList<Diamond.Project.TimedCall> calls = cir.Calls;
        int i = calls.Count - 1;
        while (i >= 0)
        {
            if (calls[i].IsDestination)
                return calls[i].Arrival;
            i--;
        }

        return calls.Count > 0 ? calls[calls.Count - 1].Arrival : TimeSpan.Zero;
    }

    private async Task onTerminateCirculation()
    {
        await OnTerminateCirculationRequest.InvokeAsync();
    }
}
