@using Tourmaline26.Components.Images
@using Tourmaline26.Logic
<div class="floating-destination-panel @panelClass @(IsSearching || HasCirculation ? "is-open" : "is-idle")"
     role="button"
     tabindex="0"
     @onclick="OnPanelClick"
     @onkeydown="OnPanelKey">
    @if(null!=Environment && null!=Environment.Cabin)
    {
        @if(IsSearching)
        {
            <ColorIcon Name="Search" Size="32"/>
            <span class="fs-4 dest-query">
                @if (!string.IsNullOrEmpty(mvarSearchString))
                {
                    @mvarSearchString
                }
                else
                {
                    <span class="dest-placeholder">@Prefs.T("tm.search.ph")</span>
                }
            </span>
            <button type="button"
                    class="dest-pin-btn @(OnlyUpcoming ? "is-on" : "is-off")"
                    title="@(OnlyUpcoming ? Prefs.T("tm.search.upcoming") : Prefs.T("tm.search.all"))"
                    @onclick="OnPinClick"
                    @onclick:stopPropagation="true">
                <ColorIcon Name="@(OnlyUpcoming ? "PinOn" : "PinOff")" Size="28" />
            </button>
        }
        else if(HasCirculation)
        {
            <span class="fs-2">@ServiceLabel</span>
            <span class="fs-5 dest-route">@RouteLabel</span>
        }
        else
        {
            <ColorIcon Name="Search" Size="32"/>
            <span class="fs-4 dest-placeholder">@Prefs.T("tm.dest")</span>
        }
    }
</div>

@code {
    [Inject] public UserPreferencesService Prefs { get; set; } = default!;
    [CascadingParameter]
    public bool NightMode { get; set; }
    [CascadingParameter]
    public string? mvarSearchString{ get; set; }
    [CascadingParameter]
    SessionConfiguration? Environment{ get; set; }
    [Parameter]
    public EventCallback OnBeginSearchCirculation{ get; set; }
    [Parameter]
    public EventCallback OnToggleUpcoming { get; set; }
    [Parameter]
    public bool IsSearching { get; set; }
    [Parameter]
    public bool OnlyUpcoming { get; set; } = true;

    private bool HasCirculation =>
        Environment?.Cabin?.Circulation is not null
        || (Environment?.HasUnscheduledTrain ?? false);

    private string panelClass
    {
        get => string.Format("floating-panel {0}", NightMode ? "night" : "day");
    }
    private async Task OnPanelClick()
    {
        await OnBeginSearchCirculation.InvokeAsync();
    }

    private async Task OnPinClick()
    {
        await OnToggleUpcoming.InvokeAsync();
    }

    private async Task OnPanelKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" || e.Key == " ")
            await OnBeginSearchCirculation.InvokeAsync();
    }

    private string ServiceLabel
    {
        get
        {
            Diamond.Project.Circulation? cir = Environment?.Cabin?.Circulation;
            if (cir is not null)
                return cir.HasServiceNumber ? cir.ServiceNumber : cir.Id;
            return Environment?.UnscheduledTrainToken ?? string.Empty;
        }
    }

    private string RouteLabel
    {
        get
        {
            Diamond.Project.Circulation? cir = Environment?.Cabin?.Circulation;
            if (cir is null)
                return Environment?.HasUnscheduledTrain == true ? "Sin malla" : string.Empty;
            return cir.Origin.DisplayCode + " → " + cir.Destination.DisplayCode;
        }
    }
}
