@using Tourmaline26.Components.Images
@using Tourmaline26.Logic
<div class="floating-destination-panel @panelClass">
    @if(null!=Environment && null!=Environment.Cabin)
    {
        @if(null==Environment.Cabin.Circulation)
        {
            <ColorIcon Name="Search" Size="32"/>
            <span class="fs-4">
            @if(null!=mvarSearchString && mvarSearchString.Length>0)
            {
                @mvarSearchString
            }
            else
            {
                <button class="btn btn-outline-dark border-0" onclick="@onSearchCirculation">Destino</button>
            }
            </span>
        }
        else
        {
            <span class="fs-2">@ServiceLabel</span>
            <span class="fs-5">  @RouteLabel</span>
        }
    }
</div>

@code {
    [CascadingParameter]
    public bool NightMode { get; set; }
    [CascadingParameter]
    public string? mvarSearchString{ get; set; }
    [CascadingParameter]
    SessionConfiguration? Environment{ get; set; }
    [Parameter]
    public EventCallback OnBeginSearchCirculation{ get; set; }

    private string panelClass
    {
        get => string.Format("floating-panel {0}", NightMode ? "night" : "day");
    }
    private async Task onSearchCirculation()
    {
        await OnBeginSearchCirculation.InvokeAsync();
    }

    private string ServiceLabel
    {
        get
        {
            Diamond.Project.Circulation? cir = Environment?.Cabin?.Circulation;
            if (cir is null)
                return string.Empty;
            return cir.HasServiceNumber ? cir.ServiceNumber : cir.Id;
        }
    }

    private string RouteLabel
    {
        get
        {
            Diamond.Project.Circulation? cir = Environment?.Cabin?.Circulation;
            if (cir is null)
                return string.Empty;
            return cir.Origin.DisplayCode + " → " + cir.Destination.DisplayCode;
        }
    }
}
