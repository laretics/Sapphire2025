@using Tourmaline26.Components.Controls.Generical
@using TimeNet2026.Timed
@using Tourmaline26.Logic
@using TimeNetComponents.Controls.TimeNetControl.Atoms
<div class="floating-destination-menu @panelClass">
    @if(byAll.Count()>0)
    {
        <ul>
            @foreach(Circulation cir in byAll)
            {
                <li>
                    <FloatDestinationMenuCirculation Circulation="@cir" OnCirculationSelected="HandleCirculationSelected" />
                </li>
            }
        </ul>
    }
    else
    {
        <ul>
            @if (byName.Count > 0)
            {
                <li>
                    Por número
                    <ul>
                        <li>
                            @string.Format("{0} trenes", byName.Count)
                            @if (byName.Count < 11)
                            {
                                <ul>
                                    @foreach (Circulation cir in byName)
                                    {
                                        <li>
                                            <FloatDestinationMenuCirculation Circulation="@cir" OnCirculationSelected="HandleCirculationSelected" />
                                        </li>
                                    }
                                </ul>
                            }
                        </li>
                    </ul>
                </li>
            }
            @if (byTime.Count > 0)
            {
                <li>
                    Por hora de salida
                    <ul>
                        <li>
                            @string.Format("{0} trenes", byTime.Count)
                            @if (byTime.Count < 11)
                            {
                                <ul>
                                    @foreach (Circulation cir in byTime)
                                    {
                                        <li>
                                            <FloatDestinationMenuCirculation Circulation="@cir" OnCirculationSelected="HandleCirculationSelected" />
                                        </li>
                                    }
                                </ul>
                            }
                        </li>
                    </ul>
                </li>
            }
            @if (byDestination.Count > 0)
            {
                <li>
                    Por destino
                    <ul>
                        <li>
                            @string.Format("{0} trenes", byDestination.Count)
                            @if (byDestination.Count < 11)
                            {
                                <ul>
                                    @foreach (Circulation cir in byDestination)
                                    {
                                        <li>
                                            <FloatDestinationMenuCirculation Circulation="@cir" OnCirculationSelected="HandleCirculationSelected"/>
                                        </li>
                                    }
                                </ul>
                            }
                        </li>
                    </ul>
                </li>
            }
        </ul>
        }

    
</div>

@code {
    [CascadingParameter]
    public bool NightMode { get; set; }
    [CascadingParameter]
    public string? mvarSearchString{ get; set; }
    [CascadingParameter]
    public SessionConfiguration? Environment{ get; set; }
    [Parameter]
    public EventCallback<Circulation> OnCirculationSelected{ get; set; }

    private Task HandleCirculationSelected(Circulation cir)
        => OnCirculationSelected.InvokeAsync(cir);

    private Plan? mvarPlan;
    private string panelClass
    {
        get => string.Format("floating-panel {0}", NightMode ? "night" : "day");
    }
    private HashSet<Circulation> byName = new HashSet<Circulation>();
    private HashSet<Circulation> byTime = new HashSet<Circulation>();
    private HashSet<Circulation> byDestination = new HashSet<Circulation>();
    private IEnumerable<Circulation> byAll = new List<Circulation>();
    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        if(null!=Environment && null!=Environment.TNEnvironment)
        {
            mvarPlan = Environment.TNEnvironment.Plan;
            if (null != mvarPlan)
                mvarPlan.CurrentDay = Environment.TNEnvironment.Weekday; //Para buscar sólo los trenes de hoy.
        }        
        DoSearch();
        StateHasChanged();
    }

    private void DoSearch()
    {
        byName.Clear();
        byTime.Clear();
        byDestination.Clear();
        if(null!=mvarSearchString)
        {
            mvarSearchString = mvarSearchString.Replace(' ',',');
            mvarSearchString = mvarSearchString.Replace('-', ',');
            mvarSearchString = mvarSearchString.Replace('.', ',');
            string[] tokens = mvarSearchString.Trim().ToUpper().Split(',');
            foreach (string token in tokens)
                DoSearchAtom(token);
        }        
        var allItems = byName.Concat(byTime).Concat(byDestination);
        byAll = allItems
            .GroupBy(x => x)
            .Where(g => g.Count() >= 2)
            .Select(g => g.Key)
            .ToList();
    }

    private void DoSearchAtom(string rhs)
    {
        bool porHora = false;
        bool porDestino = false;

        if(null!=mvarPlan)
        {
            TimeSpan auxHora = new TimeSpan(0);
            porHora = TimeSpan.TryParse(rhs, out auxHora);
            foreach (CirculationBlock bloque in mvarPlan.CirculationBlocksByDay)
            {
                porDestino = false;
                if(null!=bloque.asimilation && null!=bloque.asimilation.Destination)
                    porDestino = bloque.asimilation.Destination.Name.ToUpper().Contains(rhs);

                foreach(Circulation cir in bloque.Circulations)
                {
                    if (cir.name.Contains(rhs))
                        byName.Add(cir);
                    if (porHora && Math.Abs((cir.departure - auxHora).TotalMinutes)<=20)
                        byTime.Add(cir);
                    if (porDestino)
                        byDestination.Add(cir);
                }
            }
        }
    }
}