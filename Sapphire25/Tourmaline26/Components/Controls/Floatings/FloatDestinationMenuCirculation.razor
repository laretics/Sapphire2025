@using ProjectCirculation = Diamond.Project.Circulation
@using Sapphire2025Models
@if (null != Circulation)
{
    @if (NightMode)
    {
        <button class="btn btn-gradient"
                style="--btn-bg:@BackColor; color:@ForeColor;"
                @onclick="@OnClick">
            @DisplayName
        </button>
    }
    else
    {
        <button class="btn btn-gradient"
                style="--btn-bg:@ForeColor; color:@BackColor;"
                @onclick="@OnClick">
            @DisplayName
        </button>
    }
    @Utils.autoInterval(Circulation.Departure, true, false)
}
@code {
    [Parameter]
    public ProjectCirculation? Circulation { get; set; }
    [CascadingParameter]
    public bool NightMode { get; set; }
    [Parameter]
    public EventCallback<ProjectCirculation> OnCirculationSelected { get; set; }

    private async Task OnClick()
    {
        if (null != Circulation)
            await OnCirculationSelected.InvokeAsync(Circulation);
    }

    private string DisplayName
    {
        get
        {
            if (null == Circulation)
                return string.Empty;
            return Circulation.HasServiceNumber ? Circulation.ServiceNumber : Circulation.Id;
        }
    }

    private string BackColor
    {
        get
        {
            if (null != Circulation && Circulation.HasColor)
                return Circulation.Color;
            return "white";
        }
    }

    private string ForeColor
    {
        get
        {
            if (null != Circulation && Circulation.HasColor)
                return "white";
            return "black";
        }
    }
}
