<div class="tesla-right-panel @panelClass">
    @ChildContent
</div>

@code {
    [Parameter]
    public RenderFragment? ChildContent { get; set; }
    [CascadingParameter]
    public bool NightMode { get; set; }

    private string panelClass
    {
        get => NightMode ? "night" : "day";
    }
}
