@using Tourmaline26.Components.Images
@inject TourmalineService Tourmaline

<div class="floating-location-panel @panelClass" style="@GetAxisStyle()">
    @if (Tourmaline?.SessionConfig?.LinearLocation?.Axis != null)
    {
        var loc = Tourmaline.SessionConfig.LinearLocation;
        var pk = loc.PKRef;
        var km = pk / 1000;
        var hm = pk % 1000;

        <div class="content-wrapper">
            <div class="main-content">
                <span class="location-icon">
                    <ColorIcon Size="16" Name="GoodLocation"/>
                </span>
                <div class="pk-and-name">
                    <div class="pk-row">
                        <span class="pk-km">@km</span>
                        <span class="pk-plus">+</span>
                        <span class="pk-hm">@hm.ToString("D3")</span>
                    </div>
                    <div class="axis-name" title="@loc.Axis.Name">@loc.Axis.Name</div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    [CascadingParameter]
    public bool NightMode { get; set; }
    protected override void OnInitialized()
    {
        base.OnInitialized();
        Tourmaline.HMIUpdateRequested += auxHMIRefresh;
    }
    private string panelClass
    {
        get => $"floating-panel {(NightMode ? "night" : "day")}";
    }
    private void auxHMIRefresh(object? sender, EventArgs e)
    {
        InvokeAsync(StateHasChanged);
    }
    private string GetAxisStyle()
    {
        var axis = Tourmaline?.SessionConfig?.LinearLocation?.Axis;
        string? auxColor = "#454510";
        if (auxColor == null) return "";

        // Usamos el color del Axis como acento
        return $"--accent-color: {auxColor};";
    }
    public void Dispose()
    {
        Tourmaline.HMIUpdateRequested -= auxHMIRefresh;
    }
}