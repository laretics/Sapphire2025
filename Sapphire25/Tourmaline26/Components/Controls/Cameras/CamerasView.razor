@using Tourmaline26.Components.Controls.Floatings
@using Tourmaline26.Logic
@using Tourmaline26.Services
@using Tourmaline26.Services.Cameras
@inject TourmalineService Tourmaline
@inject CameraStreamService CameraStreams

<FloatRightContainer>
    <div class="camera-grid">
        @for (int slot = 0; slot < 3; slot++)
        {
            CameraInfo? cam = slot < mvarSlotCameras.Count ? mvarSlotCameras[slot] : null;
            <div class="grid-item">
                @if (cam is not null)
                {
                    <CameraViewer CameraId="@cam.Id" CameraName="@cam.Name" />
                }
                else
                {
                    <CameraViewer CameraId="-1" CameraName="@($"Hueco {slot + 1}")" />
                }
            </div>
        }
        <div class="grid-item menu-area">
            @ChildContent
        </div>
    </div>
</FloatRightContainer>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private List<CameraInfo> mvarSlotCameras = new();

    protected override void OnInitialized()
    {
        // Preferimos la lista del servicio de streams (ya resuelta desde appsettings).
        IReadOnlyCollection<CameraInfo> fromService = CameraStreams.Cameras;
        if (fromService.Count > 0)
        {
            mvarSlotCameras = fromService
                .OrderBy(c => c.Id)
                .Take(3)
                .ToList();
        }
        else
        {
            mvarSlotCameras = (Tourmaline.SystemConfig.Cameras ?? new List<CameraInfo>())
                .OrderBy(c => c.Id)
                .Take(3)
                .ToList();
        }
    }
}
