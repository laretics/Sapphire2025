@*
  Visor de cámara: consume el proxy MJPEG nativo de Tourmaline
  (/api/cameras/{id}/mjpeg) — sin MediaMTX ni HLS.
*@
@using Tourmaline26.Services.Cameras
@implements IDisposable
@inject CameraStreamService CameraStreams

<div class="camera-viewer">
    <div class="camera-overlay">
        <span class="camera-name" title="@CameraName">@CameraName</span>
        <span class="status-indicator @StatusClass" title="@StatusMessage" aria-label="@StatusMessage">
            <ColorIcon Name="@StatusIcon" Size="18" Color="currentColor" />
        </span>
    </div>

    <div class="video-container">
        @if (CameraId >= 0)
        {
            <img src="@MjpegUrl"
                 class="camera-video"
                 alt="@CameraName"
                 @onload="OnImageLoaded"
                 @onerror="OnImageError" />
        }
        else
        {
            <div class="fallback-overlay" title="Sin cámara asignada">
                <ColorIcon Name="CCTV" Size="40" Color="#666666" />
            </div>
        }
    </div>
</div>

@code {
    /// <summary>Id de la cámara en appsettings (Cameras[].Id).</summary>
    [Parameter] public int CameraId { get; set; } = -1;

    [Parameter] public string CameraName { get; set; } = "Cámara";

    /// <summary>Compat: se ignora (antes era el path de MediaMTX).</summary>
    [Parameter] public string PathName { get; set; } = "";

    /// <summary>Compat: se ignora (antes era el host de MediaMTX).</summary>
    [Parameter] public string ServerIp { get; set; } = "";

    private string StatusMessage { get; set; } = "Conectando…";
    private string StatusClass { get; set; } = "status-connecting";
    private string StatusIcon { get; set; } = "Refresh";
    private int mvarCacheBust;
    private DateTime mvarLastReloadUtc = DateTime.MinValue;
    private System.Threading.Timer? mvarWatchdog;

    private string MjpegUrl =>
        CameraId < 0
            ? string.Empty
            : $"/api/cameras/{CameraId}/mjpeg?v={mvarCacheBust}";

    protected override void OnInitialized()
    {
        mvarWatchdog = new System.Threading.Timer(
            _ => _ = InvokeAsync(WatchdogTick),
            null,
            TimeSpan.FromSeconds(5),
            TimeSpan.FromSeconds(5));
    }

    private void OnImageLoaded()
    {
        StatusMessage = "En vivo";
        StatusClass = "status-live";
        StatusIcon = "Eye";
    }

    private void OnImageError()
    {
        StatusMessage = "Sin señal";
        StatusClass = "status-error";
        StatusIcon = "MediaOff";
        KickStream();
    }

    private void WatchdogTick()
    {
        if (CameraId < 0)
            return;

        DateTime? last = CameraStreams.GetLastFrameUtc(CameraId);
        bool stale = last.HasValue
            && (DateTime.UtcNow - last.Value).TotalSeconds >= 12;
        if (!stale)
            return;

        KickStream();
    }

    private void KickStream()
    {
        if ((DateTime.UtcNow - mvarLastReloadUtc).TotalSeconds < 8)
            return;

        mvarLastReloadUtc = DateTime.UtcNow;
        CameraStreams.ForceRestart(CameraId);
        mvarCacheBust++;
        StatusMessage = "Reconectando…";
        StatusClass = "status-connecting";
        StatusIcon = "Refresh";
        StateHasChanged();
    }

    public void Dispose()
    {
        mvarWatchdog?.Dispose();
        mvarWatchdog = null;
    }
}
