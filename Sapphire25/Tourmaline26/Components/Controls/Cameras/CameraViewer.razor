@*
  Visor de cámara: consume el proxy MJPEG nativo de Tourmaline
  (/api/cameras/{id}/mjpeg) — sin MediaMTX ni HLS.
*@
@implements IDisposable

<div class="camera-viewer">
    <div class="camera-overlay">
        <span>@CameraName</span>
        <span class="status-indicator @StatusClass">@StatusMessage</span>
    </div>

    <div class="video-container">
        @if (CameraId >= 0)
        {
            <img src="@MjpegUrl"
                 class="camera-video"
                 alt="@CameraName"
                 @onload="OnImageLoaded"
                 @onerror="OnImageError" />
        }
        else
        {
            <div class="fallback-overlay">
                <div>Sin cámara asignada</div>
            </div>
        }
    </div>
</div>

@code {
    /// <summary>Id de la cámara en appsettings (Cameras[].Id).</summary>
    [Parameter] public int CameraId { get; set; } = -1;

    [Parameter] public string CameraName { get; set; } = "Cámara";

    /// <summary>Compat: se ignora (antes era el path de MediaMTX).</summary>
    [Parameter] public string PathName { get; set; } = "";

    /// <summary>Compat: se ignora (antes era el host de MediaMTX).</summary>
    [Parameter] public string ServerIp { get; set; } = "";

    private string StatusMessage { get; set; } = "Conectando…";
    private string StatusClass { get; set; } = "status-connecting";
    private int mvarCacheBust;
    private System.Threading.Timer? mvarRetryTimer;

    private string MjpegUrl =>
        CameraId < 0
            ? string.Empty
            : $"/api/cameras/{CameraId}/mjpeg?v={mvarCacheBust}";

    private void OnImageLoaded()
    {
        StatusMessage = "En vivo";
        StatusClass = "status-live";
        mvarRetryTimer?.Dispose();
        mvarRetryTimer = null;
    }

    private void OnImageError()
    {
        StatusMessage = "Sin señal";
        StatusClass = "status-error";
        // Reintento suave: cambia query para forzar recarga del <img>.
        mvarRetryTimer?.Dispose();
        mvarRetryTimer = new System.Threading.Timer(_ =>
        {
            _ = InvokeAsync(() =>
            {
                mvarCacheBust++;
                StatusMessage = "Reconectando…";
                StatusClass = "status-connecting";
                StateHasChanged();
            });
        }, null, TimeSpan.FromSeconds(3), Timeout.InfiniteTimeSpan);
    }

    public void Dispose()
    {
        mvarRetryTimer?.Dispose();
        mvarRetryTimer = null;
    }
}
