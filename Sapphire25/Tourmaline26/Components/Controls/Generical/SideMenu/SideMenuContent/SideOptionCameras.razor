@using Tourmaline26.Components.Controls.Generical
@inject Tourmaline26.Components.Services.TourmalineService TourmalineService
<Switch Label="Cámaras automáticas" Value="@TourmalineService.AutoCameras"
        ValueChanged="@((bool v) => TourmalineService.AutoCameras = v)" />
<div class="alert alert-light fs-5 text-secondary mt-3 mb-3" role="alert">
    Con una ruta seleccionada, el sistema conectará automáticamente la visualización de las cámaras en los últimos metros antes de la parada en la próxima estación y la desconectará en los primeros metros tras la salida de la misma.
</div>
<Switch Label="Visualización manual" Value="@TourmalineService.ManualCameras"
        ValueChanged="@((bool v) => TourmalineService.ManualCameras = v)" />

