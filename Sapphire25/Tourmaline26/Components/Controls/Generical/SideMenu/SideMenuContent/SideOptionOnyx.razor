@using System.Threading.Tasks
@using BlazorBootstrap
@using TimeNet2026.Models
@inject IServiceProvider ScopeFactory
@inject Sapphire2025.Storage.TimeNetClient TimeNetService
@inject Tourmaline26.Components.Services.TourmalineService TourmalineService
@using TimeNet2026.Topo
@using TimeNet2026.Timed
@using TimeNet2026.Production
@using TimeNetComponents.TreeView
@using Tourmaline26.Components.Controls.Floatings
@using Tourmaline26.Components.Pages
@using TimeNetComponents.Controls
@using TimeNetComponents.Controls.TimeNetControl
@using System.Text.Json;
@if (null == mvarRauta)
{
    <h2>No existen horarios cargados</h2>
}
else
{
    <h2>Horarios @mvarRauta.Header.Name</h2>
    <ul>
        <li>Versión: @mvarRauta.Header.Version</li>
        <li>Autor: @mvarRauta.Header.Author</li>
        <li>Fecha: @mvarRauta.Header.FirstDate</li>
        <li>Descripción: @mvarRauta.Header.Description</li>
        <li>@mvarRauta.Header.Comment</li>

    </ul>
        
    <RadioButton Options="mcolPlanIds"
                 SelectedIndex="0"
                 SelectedIndexChanged="@((int v) => SelectPlan(v))" />
}
@if (null!=mvarEnvironment)
{
<WeekdaySelector @bind-Value="mvarEnvironment.Weekday"
                 IsFilter="false" />
}
@if (null != mvarTopo)
{
    <h2>Topología @mvarTopo.Header.Name</h2>
    <ul>
        <li>Versión: @mvarTopo.Header.Version</li>
        <li>Autor: @mvarTopo.Header.Author</li>
        <li>Fecha: @mvarTopo.Header.FirstDate</li>
        <li>Descripción: @mvarTopo.Header.Description</li>
        <li>@mvarTopo.Header.Comment</li>
    </ul>
}
@if(null!=mvarEnvironment)
{

    @if (TourmalineService.SessionConfig.ServiceMode)
    {
        <h3>TimeNetEnvironment</h3>
        <table class="table table-stripped table-bordered mt4">
            <thead>
                <tr>
                    <th>Field</th>
                    <th>Value</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>OnyxStorage</td>
                    <td>
                        @((null == mvarEnvironment.OnyxStorage) ? "" : mvarEnvironment.OnyxStorage.ToString())
                    </td>
                </tr>
                <tr>
                    <td>TopoStorage</td>
                    <td>
                        @((null == mvarTopo) ? "" : mvarTopo.ToString())
                    </td>
                </tr>
                <tr>
                    <td>Rautatie</td>
                    <td>
                        @((null == mvarRauta) ? "" : mvarRauta.ToString())
                    </td>
                </tr>
                <tr>
                    <td>Plan</td>
                    <td>
                        @((null == mvarPlan) ? "" : mvarPlan.ToString())
                    </td>
                </tr>
                <tr>
                    <td>WeekDay</td>
                    <td>
                        @mvarEnvironment.Weekday.ToString()
                    </td>
                </tr>
                <tr>
                    <td>Axis</td>
                    <td>
                        @((null == mvarEnvironment.Axis) ? "" : mvarEnvironment.Axis.ToString())
                    </td>
                </tr>
                <tr>
                    <td>ViewAsimilation</td>
                    <td>
                        @((null == mvarEnvironment.ViewAsimilation) ? "" : mvarEnvironment.ViewAsimilation.ToString())
                    </td>
                </tr>
                <tr>
                    <td>Asimilation</td>
                    <td>
                        @((null == mvarEnvironment.Asimilation) ? "" : mvarEnvironment.Asimilation.ToString())
                    </td>
                </tr>

                <tr>
                    <td>Cir.Block</td>
                    <td>
                        @((null == mvarEnvironment.CirculationBlock) ? "" : mvarEnvironment.CirculationBlock.ToString())
                    </td>
                </tr>
                <tr>
                    <td>Circulation</td>
                    <td>
                        @((null == mvarEnvironment.Circulation) ? "" : mvarEnvironment.Circulation.ToString())
                    </td>
                </tr>

            </tbody>
        </table>
        @if (1 == mvarDownloading)
        {
            <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);" aria-modal="true" role="dialog">
                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content text-center">
                        <div class="modal-body">
                            <div class="spinner-border text-primary mb-3" style="width: 4rem; height: 4rem;" role="status">
                                <span class="visually-hidden">Cargando...</span>
                            </div>
                            <h4 class="mb-2">Descargando datos</h4>
                            <p>Por favor, espere.</p>
                        </div>
                    </div>
                </div>
            </div>
        }
        else if (2 == mvarDownloading)
        {
            <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);" aria-modal="true" role="dialog">
                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content text-center">
                        <div class="modal-body">
                            <div class="spinner-border text-success mb-3" style="width: 4rem; height: 4rem;" role="status">
                                <span class="visually-hidden">Procesando...</span>
                            </div>
                            <h4 class="mb-2">Componiendo base de datos</h4>
                            <p>Por favor, espere mientras se procesa la información.</p>
                        </div>
                    </div>
                </div>
            </div>
        }
        else
        {
            <button @onclick="() => DownloadDatabase()">Download Database</button>
            @if (TourmalineService.TimeNetStorage.Storages.Count > 0)
            {
                <h3>Topologías disponibles</h3>
                <table class="table table-striped table-bordered mt-4">
                    <thead>
                        <tr>
                            <th>Id</th>
                            <th>Nombre</th>
                            <th>Info</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (TopoStorage element in TourmalineService.TimeNetStorage.Storages.Values)
                        {
                            <tr>
                                <td>
                                    @element.Header.Id
                                    @if (element == mvarTopo)
                                    {
                                        <p>Seleccionado</p>
                                    }
                                    else
                                    {
                                        <button @onclick="() => SelectTopoStorage(element.Header.Id)">Load</button>
                                    }
                                </td>
                                <td>@element.Header.Name</td>
                                <td>@element.Header.Comment</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            @if (null != mvarEnvironment.TopoStorage)
            {
                <h3>Libros de Horarios</h3>
                <table class="table table-striped table-bordered mt-4">
                    <thead>
                        <tr>
                            <th>Id</th>
                            <th>Nombre</th>
                            <th>Info</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (Rauta rauta in mvarTopo.ColRauta.Values)
                        {
                            <tr>
                                <td>
                                    @rauta.Header.Id
                                    @if (rauta == mvarRauta)
                                    {
                                        <p>Seleccionado</p>
                                    }
                                    else
                                    {
                                        <button @onclick="() => SelectRauta(rauta.Header.Id)">Load</button>
                                    }
                                </td>
                                <td>@rauta.Header.Name</td>
                                <td>@rauta.Header.Comment</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        }
    }
}

@code {
    private byte mvarDownloading = 0;
    private TimeNetEnvironment? mvarEnvironment = null;
    private TopoStorage? mvarTopo = null;
    private Rauta? mvarRauta = null;
    private Plan? mvarPlan = null;
    protected override async Task OnInitializedAsync()
    {
        await TourmalineService.EnsureInitialized();

        if (null != TourmalineService.SessionConfig && null != TourmalineService.SessionConfig.TNEnvironment)
        {
            mvarEnvironment = TourmalineService.SessionConfig.TNEnvironment;
            mvarTopo = mvarEnvironment.TopoStorage;
            mvarRauta = mvarEnvironment.Rauta;
            mvarPlan = mvarEnvironment.Plan;
        }

        await base.OnInitializedAsync();
    }
    private List<string> mcolPlanIds
    {
        get
        {
            List<string> salida = new List<string>();
            if(null!=TourmalineService.SessionConfig.TNEnvironment && 
                null!=TourmalineService.SessionConfig.TNEnvironment.Rauta)
            {
                foreach (Plan plan in TourmalineService.SessionConfig.TNEnvironment.Rauta.Plans.Values)
                    salida.Add(plan.Name);
            }
            return salida;
        }
    }



    /// <summary>
    /// Cargamos una réplica de la base de datos en local para trabajar con estas entidades
    /// </summary>
    /// <returns></returns>
    private async Task DownloadDatabase()
    {
        mvarDownloading = 1;
        StateHasChanged();
        TimeNetDataExportDto? paquete = await TimeNetService.DownloadJsonPackageAsync(Guid.NewGuid());
        // if (paquete != null)
        // {
        //     ///Serialización de prueba para comprobar que el paquete se descarga correctamente. Se puede eliminar.
        //     var json = JsonSerializer.Serialize(paquete, new JsonSerializerOptions { WriteIndented = true });
        //     var path = Path.Combine(Environment.GetFolderPath(Environment.SpecialFolder.Desktop), "paquete.json");
        //     File.WriteAllText(path, json);
        // }
        mvarDownloading = 2;
        StateHasChanged();
        if (null != paquete)
        {
            using (IServiceScope scope = ScopeFactory.CreateScope())
            {
                TourmalineContext auxContext = scope.ServiceProvider.GetRequiredService<TourmalineContext>();
                TimeNet2026Data.Serialization.DBSerializer auxSerializer =
                    new TimeNet2026Data.Serialization.DBSerializer(auxContext);
                await auxSerializer.ImportFromDtoAsync(paquete, true);                
            }
            await TourmalineService.DoTimeNetSync();
            await TourmalineService.InitializeTimeNet(); //Cargo en memoria lo que he descargado.
        }        
        mvarDownloading = 0;
        StateHasChanged();
    }
    private async Task SelectTopoStorage(Guid guid)
    {
        //Seleccionamos el TopoStorage que queremos usar para cargar la base de datos
        await TourmalineService.DoTopologySelect(guid);
        if(null!=TourmalineService.SessionConfig && null!=TourmalineService.SessionConfig.TNEnvironment)
            TourmalineService.SessionConfig.TNEnvironment.TopoStorageGuid = guid;
        StateHasChanged();
    }
    private async Task SelectRauta(Guid guid)
    {
        //Seleccionamos el Rauta que queremos usar para cargar la base de datos
        await TourmalineService.DoRautatieSelect(guid);
        if (null != TourmalineService.SessionConfig && null != TourmalineService.SessionConfig.TNEnvironment)
            TourmalineService.SessionConfig.TNEnvironment.RautaGuid = guid;
        StateHasChanged();
    }
    private async Task SelectPlan(int index)
    {
        await TourmalineService.DoPlanSelect(mcolPlanIds[index]);
        if (null != TourmalineService.SessionConfig && null != TourmalineService.SessionConfig.TNEnvironment)
            TourmalineService.SessionConfig.TNEnvironment.PlanName = mcolPlanIds[index];
        StateHasChanged();
    }
}
