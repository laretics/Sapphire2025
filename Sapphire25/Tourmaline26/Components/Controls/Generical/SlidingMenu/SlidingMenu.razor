@using Tourmaline26.Logic.Generical
@inject TourmalineService mvarTourmaline

<div class="sliding-menu">
    @for (int i = 0; i < Options.Count; i++)
    {
        int x = i;
        @if (IsOptionVisible(i))
        {
            <MenuOption Title="@Options[i].Title"
                        Icon="@Options[i].Icon"
                        Selected="@(SelectedIndex == x)"
                        OnClick="() => SelectOption(x)" />
        }
    }
</div>

@code {
    [Parameter] public List<MenuOptionModel> Options { get; set; } = new();
    [Parameter] public EventCallback<int> OnSelectedIndexChanged { get; set; }

    /// <summary>Índice en la lista completa de Options (no en la lista filtrada visible).</summary>
    public int SelectedIndex { get; private set; }

    private bool mvarServiceMainLast;

    protected override void OnInitialized()
    {
        mvarServiceMainLast = mvarTourmaline.SessionConfig.ServiceMode.Main;
        SelectedIndex = ResolveInitialIndex();
        PersistSelection();
        // Avisa al padre para que el contenido coincida en el primer render útil.
        _ = OnSelectedIndexChanged.InvokeAsync(SelectedIndex);
    }

    protected override void OnParametersSet()
    {
        // Si salimos del modo servicio (o la opción deja de ser visible), reubicar.
        bool serviceMain = mvarTourmaline.SessionConfig.ServiceMode.Main;
        bool modeChanged = serviceMain != mvarServiceMainLast;
        mvarServiceMainLast = serviceMain;

        if (modeChanged || !IsOptionVisible(SelectedIndex))
        {
            int resolved = ResolveInitialIndex();
            if (resolved != SelectedIndex)
            {
                SelectedIndex = resolved;
                PersistSelection();
                _ = OnSelectedIndexChanged.InvokeAsync(SelectedIndex);
            }
        }
    }

    private void SelectOption(int index)
    {
        if (index < 0 || index >= Options.Count)
            return;
        if (!IsOptionVisible(index))
            return;

        if (SelectedIndex == index)
        {
            // Re-selección: igual persistimos por si el padre se re-monta.
            PersistSelection();
            return;
        }

        SelectedIndex = index;
        PersistSelection();
        _ = OnSelectedIndexChanged.InvokeAsync(SelectedIndex);
    }

    public async Task ManagePhysicalKeyboard(string key)
    {
        if (key == "ArrowUp")
        {
            int next = FindPreviousVisible(SelectedIndex);
            if (next >= 0)
                SelectOption(next);
        }
        else if (key == "ArrowDown")
        {
            int next = FindNextVisible(SelectedIndex);
            if (next >= 0)
                SelectOption(next);
        }

        await Task.CompletedTask;
    }

    /// <summary>
    /// Restaura la opción guardada en sesión si sigue visible;
    /// si no, la primera opción disponible (no de solo-servicio si no hay Main).
    /// </summary>
    private int ResolveInitialIndex()
    {
        string savedId = mvarTourmaline.SessionConfig.LastSideMenuOptionId;
        if (!string.IsNullOrWhiteSpace(savedId))
        {
            int byId = Options.FindIndex(o =>
                string.Equals(o.Id, savedId, StringComparison.OrdinalIgnoreCase));
            if (byId >= 0 && IsOptionVisible(byId))
                return byId;
        }

        return FirstVisibleIndex();
    }

    private int FirstVisibleIndex()
    {
        for (int i = 0; i < Options.Count; i++)
        {
            if (IsOptionVisible(i))
                return i;
        }
        return 0;
    }

    private int FindPreviousVisible(int from)
    {
        for (int i = from - 1; i >= 0; i--)
        {
            if (IsOptionVisible(i))
                return i;
        }
        return from; // ya en el primero visible
    }

    private int FindNextVisible(int from)
    {
        for (int i = from + 1; i < Options.Count; i++)
        {
            if (IsOptionVisible(i))
                return i;
        }
        return from;
    }

    private bool IsOptionVisible(int index)
    {
        if (index < 0 || index >= Options.Count)
            return false;
        MenuOptionModel opt = Options[index];
        if (!opt.ServiceMode)
            return true;
        return mvarTourmaline.SessionConfig.ServiceMode.Main;
    }

    private void PersistSelection()
    {
        if (SelectedIndex < 0 || SelectedIndex >= Options.Count)
            return;
        mvarTourmaline.SessionConfig.LastSideMenuOptionId = Options[SelectedIndex].Id;
    }
}
