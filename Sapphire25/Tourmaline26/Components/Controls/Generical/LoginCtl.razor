<div class="login-dialog-overlay">
    <div class="login-dialog @DialogThemeClass">
        
        <!-- Columna izquierda: Logo -->
        <div class="login-image-column">
            <img src="/img/Transpa.png"
                 alt="Logo"
                 class="login-image" />
            <div class="login-image-text">
                Información al Viajero
            </div>
        </div>

        <!-- Columna derecha: Formulario -->
        <div class="login-form-column">
            <div class="form-group">
                <label for="username">Usuario</label>
                <input id="username" class="form-control"
                       @bind="Username"
                       placeholder="Ingrese su usuario"
                       @onfocus="() => SetActiveField(LoginField.Username)" />
            </div>

            <div class="form-group">
                <label for="password">Contraseña</label>
                <input id="password" type="password" class="form-control"
                       @bind="Password"
                       placeholder="Ingrese su contraseña"
                       @onfocus="() => SetActiveField(LoginField.Password)" />
            </div>
        </div>
    </div>
</div>

<!-- Teclado con modo numérico por defecto -->
<VirtualKeyboard KeyPressed="OnVirtualKey"
                 EnterPressed="OnLogin"
                 TabPressed="HandleTab"
                 IsNumericByDefault="true" />
@code {
    [CascadingParameter] public bool NightMode { get; set; }

    [Parameter] public EventCallback<(string Username, string Password)> Login { get; set; }
    [Parameter] public bool IsLoggingIn { get; set; } = false;   // Nuevo parámetro útil

    private string Username { get; set; } = "";
    private string Password { get; set; } = "";
    private LoginField ActiveField { get; set; } = LoginField.Username;

    private enum LoginField { Username, Password }

    private void SetActiveField(LoginField field) => ActiveField = field;

    private void OnVirtualKey(char key)
    {
        if (key == '⌫' || key == '\b')
        {
            if (ActiveField == LoginField.Username && Username.Length > 0)
                Username = Username[..^1];
            else if (ActiveField == LoginField.Password && Password.Length > 0)
                Password = Password[..^1];
        }
        else if (key == ' ')
        {
            // Evitar espacios en usuario/contraseña
            return;
        }
        else
        {
            if (ActiveField == LoginField.Username)
                Username += key;
            else if (ActiveField == LoginField.Password)
                Password += key;
        }
    }

    private async Task HandleTab()
    {
        // Cambia el foco entre Usuario y Contraseña
        if (ActiveField == LoginField.Username)
        {
            ActiveField = LoginField.Password;
            // Opcional: enfocar el input de contraseña vía JS si quieres
        }
        else
        {
            ActiveField = LoginField.Username;
        }
    }

    private async Task OnLogin()
    {
        if (string.IsNullOrWhiteSpace(Username) || string.IsNullOrWhiteSpace(Password))
            return;

        await Login.InvokeAsync((Username.Trim(), Password));
    }
    
    private string DialogThemeClass => NightMode ? "login-night" : "login-day";
}