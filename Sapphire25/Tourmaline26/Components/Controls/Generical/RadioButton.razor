<div class="btn-group @SizeClass" role="group">
    @for (int i = 0; i < Options.Count; i++)
    {
        var optionId = $"{Name}_{i}";
        <input type="radio" class="btn-check" name="@Name" id="@optionId"
               value="@i"
               checked="@(i == SelectedIndex)"
               @onchange="OnRadioChanged"
               @onclick="OnRadioClick"/>
        <label class="btn btn-outline-dark mb-3" for="@optionId">@Options[i]</label>
    }
</div>

@code {
    [Parameter] public string Name { get; set; } = Guid.NewGuid().ToString();
    [Parameter] public List<string> Options { get; set; } = new();
    [Parameter] public int SelectedIndex { get; set; }
    [Parameter] public EventCallback<int> SelectedIndexChanged { get; set; }
    [Parameter] public string SizeClass { get; set; } = "btn-group-lg";

    private async Task OnRadioChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int index))
        {
            SelectedIndex = index;
            await SelectedIndexChanged.InvokeAsync(index);
        }
    }
    private async Task OnRadioClick()
    {
        //Cuando sólo hay una opción no cambia el índice. Necesitamos
        //poder asignar también.
        if (Options.Count == 1)
            await SelectedIndexChanged.InvokeAsync(0);
    }
}
