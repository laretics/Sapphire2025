<Router AppAssembly="@typeof(App).Assembly">
    <Found Context="routeData">
        <RouteView RouteData="@routeData" DefaultLayout="@typeof(NexusFlow)" />  
        <FocusOnNavigate RouteData="@routeData" Selector="h1" />
    </Found>
    <NotFound>
        <PageTitle>@Prefs.T("page.notfound")</PageTitle>
        <LayoutView Layout="@typeof(NexusFlow)">
            <p role="alert">@Prefs.T("common.notfound")</p>
        </LayoutView>
    </NotFound>
</Router>
