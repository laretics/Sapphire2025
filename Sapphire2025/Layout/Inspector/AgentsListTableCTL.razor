@inject IntStorageService mvarIntStorage
@if (null == Users)
{
	<LoadingTab ElementText="Cargando lista de usuarios" />
}
else if (null == TimeSlice)
{
	<LoadingTab ElementText="Cargando información de fecha" />
}
else if (null == ColAssignations)
{
	<LoadingTab ElementText="Cargando asignaciones de turnos" />
}
else
{
	<div class="table-responsive my-3">
		<table class="table table-bordered table-sm align-middle">
			<thead class="table-light">
				<tr>
					<th>Turno</th>
					<th>Horario</th>
					<th>CF</th>
					<th>Asignación inicial</th>
					<th>CF</th>
					<th>Asignación definitiva</th>
					<th>Teléfono</th>
					<th>Extensión</th>
				</tr>
			</thead>
			<tbody>
				@if(null!=mcolAgents)
				{
					foreach (Sapphire2025Models.Inspector.AgentsListRecordModel register in mcolAgents)
					{
						<AgentsListRecordCTL Model="register"/>
					}
				}
			</tbody>
		</table>
	</div>
}
@code {
	[CascadingParameter]
	public Dictionary<Guid,UserModelBase>? Users { get; set; }
	[CascadingParameter] //Rodaja de días.
	public Sapphire2025Models.Expert.WorkshiftTemplates.PlansYearSlice? TimeSlice { get; set; }
	[CascadingParameter]
	public List<WorkShiftTemplateModel>? SortedTemplates { get; set; }
	[CascadingParameter]
	public List<AssignationContentModel>? ColAssignations { get; set; }

	private List<Sapphire2025Models.Inspector.AgentsListRecordModel>? mcolAgents;

	/// <summary>
	/// Genera mcolAgents para pasársela a la lista de Agentes.
	/// </summary>
	/// <returns></returns>
	private List<Sapphire2025Models.Inspector.AgentsListRecordModel> auxComposeList()
	{
		List<Sapphire2025Models.Inspector.AgentsListRecordModel>  salida = new List<Sapphire2025Models.Inspector.AgentsListRecordModel>();
		bool even = false;
		UserModelBase? swapUser;
		UserModelBase? mainUser;
		if(null!=Users && null!=SortedTemplates)
		{
			for(int i=0; i< SortedTemplates.Count; i++)
			{
				WorkShiftTemplateModel template = SortedTemplates[i];
				if(template is AttTemplateModel attTemplateModel)
				{
					List<AssignationContentModel> assignations = auxAssignationsByWorkshift(template);
					if(assignations.Count>0)
					{
						even = !even; //Cambiamos estilo de paridad.
						bool primera = true;
						foreach (AssignationContentModel auxAsigna in assignations)
						{
							Sapphire2025Models.Inspector.AgentsListRecordModel registro = new Sapphire2025Models.Inspector.AgentsListRecordModel();
							registro.Even = even;
							registro.Covered = true;
							if(primera)
							{
								registro.Att = !(template is WorkTemplateModel);
								registro.ScheduleId = template.Name;
								registro.ScheduleTime = auxGetTemplateTime(template);
							}
							registro.Color = template.Color;
							registro.BgColor = template.BgColor;
							swapUser = null;
							mainUser = null;
							if (Guid.Empty != auxAsigna.SwappingAgent && Users.ContainsKey(auxAsigna.SwappingAgent))
								swapUser = Users[auxAsigna.SwappingAgent];
							if (Users.ContainsKey(auxAsigna.AgentId))
								mainUser = Users[auxAsigna.AgentId];
							if(null!=swapUser)
							{
								registro.ChangedCF = swapUser.CF;
								registro.ChangedAgentName = swapUser.Name;
							}
							if(null!=mainUser)
							{
								registro.CF = mainUser.CF;
								registro.AgentName = mainUser.Name;
								registro.Phone = Sapphire2025Models.Common.phoneString(mainUser.PhoneNumber);
								registro.Extension = mainUser.ShortPhoneNumber;
							}
							primera = false;
							salida.Add(registro);
						}
					}
					else //Turno sin cubrir
					{
						if(template is WorkTemplateModel) //El turno sin cubrir es de conducción!
						{
							Sapphire2025Models.Inspector.AgentsListRecordModel registro = new Sapphire2025Models.Inspector.AgentsListRecordModel();
							registro.Even = even;
							registro.Att = false;
							registro.ScheduleId = template.Name;
							registro.ScheduleTime = auxGetTemplateTime(template);
							registro.Color = template.Color;
							registro.BgColor = template.BgColor;
							registro.Covered = false;
							salida.Add(registro);
						}
					}
				}
			}			
		}
		return salida;
	}
	private string auxGetTemplateTime(WorkShiftTemplateModel template)
	{
		if(template is AttTemplateModel auxTrabajo)
		{
			return string.Format("{0}-{1} ({2})",
			Sapphire2025Models.Utils.autoInterval(auxTrabajo.StartTime, true),
			Sapphire2025Models.Utils.autoInterval(auxTrabajo.EndTime, true),
			Sapphire2025Models.Utils.autoInterval(auxTrabajo.Duration, false));
		}
		return string.Empty;
	}

	protected override async Task OnParametersSetAsync()
	{
		mcolAgents = auxComposeList();
		//Guardamos en el almacenamiento local esta lista por si hay que imprimir.
		await mvarIntStorage.SetInspectorAgentsTable(mcolAgents);
	}

	/// <summary>
	/// Asignaciones de un turno concreto
	/// </summary>
	/// <param name="rhs">El turno</param>
	/// <returns>La colección de todos los agentes asignados a este turno</returns>
	private List<AssignationContentModel> auxAssignationsByWorkshift(WorkShiftTemplateModel rhs)
	{
		List<AssignationContentModel> salida = new List<AssignationContentModel>();
		if (null != ColAssignations)
		{
			foreach (AssignationContentModel candidato in ColAssignations)
			{
				if (rhs.Match(candidato.Definitive ?? "wrong"))
					salida.Add(candidato);
			}
		}
		return salida;
	}
}
