@inject IntStorageService mvarLocalStorage;
<label class="form-label fw-bold text-@Color">@string.Format("Id {0}",AgentRole)</label>
<div class="input-group">
    <input type="text" class="form-control" maxlength="@maxIdLenght"
           @bind="mvarSearchField"
           @oninput="OnSearchFieldChanged"
           placeholder="@string.Format("Id del {0}",AgentRole)"/>
    <span class="input-group-text bg-light">
        <i class="bi bi-search"></i>
    </span>
	@if (mcolUserCandidates?.Count > 1)
	{
		<ul class="dropdown-menu show w-100" style="position: absolute; top: 100%; left: 0; z-index: 1000;">
			@foreach (UserModelBase user in mcolUserCandidates)
			{
				<li>
					<a class="dropdown-item d-flex flex-column" @onclick="() => OnUserSelectFromList(user.guid)">
						<span class="fw-semibold">@user.Name</span>
						<small class="text-muted">@user.CF - @user.PhoneNumber</small>
					</a>
				</li>
			}
		</ul>
	}
</div>

@if (SelectedUser != null)
{
	<div class="mt-2 p-2 rounded bg-light border">
		<div class="fw-semibold text-dark">@SelectedUser.Name</div>
		<div class="text-muted small">
			<i class="bi bi-telephone"></i> @SelectedUser.PhoneNumber
			@if (!string.IsNullOrWhiteSpace(SelectedUser.ShortPhoneNumber))
			{
				<span class="ms-2">Ext: @SelectedUser.ShortPhoneNumber</span>
			}
		</div>
	</div>
}
else if (!string.IsNullOrWhiteSpace(mvarSearchField))
{
	<div class="mt-2 text-danger small">No se ha encontrado ningún usuario con ese CF.</div>
}

@code {
	///Buscador de un Agente en la base de datos para poner sus datos.
	[CascadingParameter]
	public Dictionary<Guid,UserModelBase>? Users { get; set; }
	private List<UserModelBase> mcolUserCandidates { get; set; } = new List<UserModelBase>();
	[Parameter]
	public UserModelBase? SelectedUser { get; set; }
	[Parameter]
	public string LocalKey { get; set; } = "undefined";
	[Parameter]
	public string AgentRole { get; set; } = "agente"; //Nombre de la categoría (sólo para que aparezca en el formulario)
	[Parameter]
	public int maxIdLenght { get; set; } = 8;
	[Parameter]
	public string Color { get; set; } = "primary";

	private string? mvarSearchField { get; set; }
	protected override async Task OnParametersSetAsync()
	{
		SelectedUser = await auxRetrieveUserFromLocal(LocalKey);
	}

	private async Task<UserModelBase?> auxRetrieveUserFromLocal(string key)
	{
		if (null != Users)
		{
			Guid auxCF = await mvarLocalStorage.GetGuidValue(key, false);
			if (Users.ContainsKey(auxCF))
			{
				return Users[auxCF];
			}
		}
		return null;
	}

	private async Task OnSearchFieldChanged(ChangeEventArgs e)
	{
		await OnSearchFieldChangedEx(e.Value?.ToString());
	}

	private async Task OnSearchFieldChangedEx(string? rhs)
	{
		mvarSearchField = rhs;
		mcolUserCandidates = SearchUsers(mvarSearchField);
		if (1 == mcolUserCandidates.Count())
			await updateStorage(mcolUserCandidates.First());
		else
			await updateStorage(null);
	}
	private async Task updateStorage(UserModelBase? rhs)
	{
		SelectedUser = rhs;
		if (null == SelectedUser)
			await mvarLocalStorage.ResetValue(LocalKey, false);
		else
			await mvarLocalStorage.SetGuidValue(LocalKey, SelectedUser.guid, false);
	}

	private async Task OnUserSelectFromList(Guid id)
	{
		if(null!=Users)
		{
			UserModelBase? candidato = Users.Values.FirstOrDefault(x => x.guid == id);
			await OnSearchFieldChangedEx(candidato?.CF);
		}
	}

	private List<UserModelBase> SearchUsers(string? cf,int maxAgents = 5)
	{
		List<UserModelBase> salida = new List<UserModelBase>();
		if(!string.IsNullOrWhiteSpace(cf) && null!=Users)
		{
			salida = Users.Values.Where(x => x.CF.Equals(cf.Trim(), StringComparison.OrdinalIgnoreCase)).Take(maxAgents).ToList();
			if(salida.Count<1)
				salida = Users.Values.Where(x => null!=x.Name && x.Name.Contains(cf.Trim(), StringComparison.OrdinalIgnoreCase)).Take(maxAgents).ToList();
		}
		return salida;
	}
}
