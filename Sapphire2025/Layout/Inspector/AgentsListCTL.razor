@using Sapphire2025Models.Expert.WorkshiftTemplates;
@inject IJSRuntime JS
@inject NavigationManager Navigation
@inject IntStorageService mvarLocalStorage;
<AgentsListHeaderCtl></AgentsListHeaderCtl>
@if(null==Users)
{
    <LoadingTab ElementText="Cargando lista de usuarios"/>
}
else if(null==TimeSlice)
{
    <LoadingTab ElementText="Cargando información de fecha" />
}
else if (null == ColAssignations)
{
    <LoadingTab ElementText="Cargando asignaciones de turnos" />
}
else if (null== SortedTemplates)
{
    <LoadingTab ElementText="Cargando turnos" />
}
else
{
    foreach(WorkShiftTemplateModel turno in SortedTemplates)
    {
        auxAsigna = GetAssignation(turno);
        if(null!=auxAsigna || turno is WorkTemplateModel)
        {
            <AgentsListRecordCTL workShiftTemplate="turno" assignation="auxAsigna"/> 
        }
    }
}
<!--Ahora viene la lista de Agentes-->
<button class="btn btn-outline-primary mb-3" @onclick="PrintPage">
	<i class="bi bi-printer"></i> Imprimir lista
</button>

@code {
    [CascadingParameter]
    public Dictionary<Guid, UserModelBase>? Users { get; set; }
    [CascadingParameter] //Asignaciones del gráfico
    public List<AssignationContentModel>? ColAssignations { get; set; }
    [CascadingParameter]
    public List<WorkShiftTemplateModel>? SortedTemplates { get; set; }
    [CascadingParameter] //Rodaja de días.
    public Sapphire2025Models.Expert.WorkshiftTemplates.PlansYearSlice? TimeSlice { get; set; }

    private AssignationContentModel? auxAsigna;

    private AssignationContentModel? GetAssignation(WorkShiftTemplateModel turno)
    {
        if (null == ColAssignations) return null; //No hay nada que buscar
        foreach (AssignationContentModel candidato in ColAssignations)
        {
            if (turno.Match(candidato.Definitive ?? ""))
                return candidato;
        }
        return null; //No ha encontrado asignación para este turno
    }

    private string GetCellStyle(WorkShiftTemplateModel? rhs)
    {
        return Sapphire2025Models.Utils.WorkShiftTemplateStyle(
            rhs,
            missingTemplateStyle: "background: transparent; color: black;");
    }

    private string GetCellText(WorkShiftTemplateModel? rhs)
    {
        if (null == rhs) return string.Empty;
        return rhs.Name ?? string.Empty;
    }
    private string GetCellTime(WorkShiftTemplateModel? rhs)
    {
        if (null == rhs) return string.Empty;

        if (rhs is AttTemplateModel auxTrabajo)
        {
            System.Text.StringBuilder auxElapsed = new System.Text.StringBuilder();
            auxElapsed.AppendFormat("{0} h", auxTrabajo.Duration.Hours);
            if (auxTrabajo.Duration.Minutes > 0)
                auxElapsed.AppendFormat(" y {0} min", auxTrabajo.Duration.Minutes);

            return string.Format("{0}-{1} ({2})",
            Sapphire2025Models.Utils.autoInterval(auxTrabajo.StartTime, true),
            Sapphire2025Models.Utils.autoInterval(auxTrabajo.EndTime, true),
            Sapphire2025Models.Utils.autoInterval(auxTrabajo.Duration, false));
        }
        return string.Empty;
    }
    private async Task PrintPage()
    {
        //Para imprimir vamos a tener que trabajar ahora un poco más...
        //Lo primero es transferir al almacenamiento local la información que estamos
        //intentando imprimir.

        await mvarLocalStorage.SetInspectorReportAssignations(ColAssignations);
        await mvarLocalStorage.SetInspectorReportSortedTemplates(SortedTemplates);

        await JS.InvokeVoidAsync("open", Navigation.ToAbsoluteUri("agentsprintview").AbsoluteUri, "_blank");

	}
}
