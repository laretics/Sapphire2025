@using Sapphire2025.Icons
@if(null!=Model)
{
	<tr class="@(Model.Even ? "table-light" : "table.white")">

		@if(Model.Covered)
		{
			<td class="smallest-text">@Model.ScheduleTime</td>
			<td>@Model.ChangedCF</td>
			<td>@Model.ChangedAgentName</td>
			<td>@Model.CF</td>
			<td>@Model.AgentName</td>
			@if (null == Model.ScheduleId)
			{
				<td class="text-center align-middle turno-cell" style="@GetCellStyle()" />
			}
			else
			{
				<td class="text-center align-middle turno-cell" style="@GetCellStyle()">
					@if (Model.Att)
					{
						<GenIcon Name="Att" color="#314D1C" size="16" />
					}
					else
					{

						<GenIcon Name="UT" Color="#321D71" Size="16" />
					}
					<span class="ms-2">@GetCellText()</span>
				</td>
			}
			<td class="phone-cell">@Model.Phone</td>
			<td>@Model.Extension</td>
		}
		else
		{
			<td class="smallest-text noncovered-cell">@Model.ScheduleTime</td>
			for (int i = 0; i < 4; i++)
			{
				<td class="noncovered-cell"></td>
			}
			@if (null == Model.ScheduleId)
			{
				<td class="text-center align-middle turno-cell" style="@GetCellStyle()" />
			}
			else
			{
				<td class="text-center align-middle turno-cell" style="@GetCellStyle()">
					@if (Model.Att)
					{
						<GenIcon Name="Att" color="#314D1C" size="16" />
					}
					else
					{						
						<GenIcon Name="UT" Color="#321D71" Size="16" />
					}
					<span class="ms-2">@GetCellText()</span>
				</td>
			}
			for (int i = 0; i < 2; i++)
			{
				<td class="noncovered-cell"></td>
			}
		}
	</tr>

}

@code {
	[Parameter]
	public Sapphire2025Models.Inspector.AgentsListRecordModel? Model{ get; set; }
	private string GetCellStyle()
	{
		// Misma lógica de contraste que AssignationCell (Color=texto, BgColor=fondo).
		string? color = Model?.Color;
		string? bg = Model?.BgColor;
		if (string.IsNullOrWhiteSpace(color) || !Sapphire2025Models.Utils.HasReadableContrast(color, bg ?? "transparent"))
			color = Sapphire2025Models.Utils.ContrastingTextColor(bg);
		bg = string.IsNullOrWhiteSpace(bg) ? "transparent" : bg.Trim();
		return $"background: {bg}; color: {color ?? "black"};";
	}
	private string GetCellText()
	{
		if (null == Model) return string.Empty;
		return Model.ScheduleId ?? string.Empty;
	}
}
