@using Sapphire2025.Icons
@using Sapphire2025Models
<div class="d-flex @alineacion mb-3">
	<div class="card shadow-sm" style="max-width: 75%;">
		<div class="card-header @bgType text-white">
			<span><RoleIcon Credentials="@(mvarUser?.CredentialKey ?? 0)" Color="@(null==mvarUser?"gray":"white")"/></span>
			<strong class="me-2">@userName</strong>
			<small class="text-white float-end">@textoFecha</small>
		</div>
		<div class="card-body">
			<p class="card-text mb-2">@Note.Text</p>
			@if (ShowLabelAction)
			{
				<button type="button"
						class="btn btn-sm btn-outline-primary"
						@onclick="RequestLabelAsync">
					<i class="bi bi-tag me-1"></i>Etiquetar
				</button>
			}
			else if (ShowLabelBadge)
			{
				<div class="d-flex flex-wrap gap-1">
					<span class="badge bg-success">@Common.TrainSystemName((Common.TrainSystem)Note.SystemAffected)</span>
					<span class="badge @(Note.IsSymptom ? "bg-danger" : "bg-secondary")">
						@(Note.IsSymptom ? "Síntoma" : "Resolución")
					</span>
				</div>
			}
		</div>
	</div>
</div>
@code {
	[Parameter]
	public NoteModel Note { get; set; } = new NoteModel();
	[Parameter]
	public DateTime LastValidNoteTime { get; set; } = DateTime.MinValue;
	[Parameter]
	public EventCallback<NoteModel> OnLabelRequested { get; set; }
	[CascadingParameter]
	public Dictionary<Guid, UserModelBase>? Users { get; set; }
	[CascadingParameter]
	public SessionModel? Session { get; set; }
	private UserModelBase? mvarUser { get; set; } = null;
	private Sapphire2025Models.Common.UserRole Role 
	{ 
		get => 
		(null == mvarUser ? Sapphire2025Models.Common.UserRole.Anonymous : 
			(Sapphire2025Models.Common.UserRole)mvarUser.CredentialKey); 
	}
	private string bgType
	{
		get 
		{
			switch(Note.Type)
			{
				case 1: return "bg-primary";
				case 2: return "bg-secondary";
				case 3: return "bg-warning";
				default: return "bg-light";
			}
		}
	}
	private string userName
	{
		get => ((null == mvarUser) ? "[Desconocido]" : mvarUser.Name!);
	}
	private string alineacion
	{
		get => (1 == Note.Type ? "justify-content-start" : "justify-content-end");
	}
	private string textoFecha
	{
		//get => Sapphire2025Models.Common.timeString(Note.TimeStamp.ToLocalTime());
		get => Sapphire2025Models.Utils.autoDate(Note.TimeStamp);
	}
	private bool CanLabel => Utils.isOfficial(Session);
	private bool ShowLabelAction =>
		CanLabel &&
		OnLabelRequested.HasDelegate &&
		!Note.IsValid &&
		Note.TimeStamp > LastValidNoteTime;
	private bool ShowLabelBadge => CanLabel && Note.IsValid;
	private async Task RequestLabelAsync()
	{
		if (ShowLabelAction)
			await OnLabelRequested.InvokeAsync(Note);
	}
	protected override void OnParametersSet()
	{
		if (null != Users && Users.ContainsKey(Note.UserId)) 
			mvarUser = Users[Note.UserId];
		else
			mvarUser = null;
		base.OnParametersSet();
	}
}
