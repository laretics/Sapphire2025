@inherits TrainModelTable
@using Sapphire2025.Icons
@if(null!=base.Trains)
{
	<table class="table table-bordered table-stripped table-fixed mb-0">
		<thead>
			<tr>
				<th class="bg-secondary text-white" style="width:90px;" @onclick="() => sortFields(2)">
					<GenIcon Name="TrainStatus" Color="white"/>
				</th>
				<th class="bg-secondary text-white" style="width:90px;" @onclick="() => sortFields(1)">
					<GenIcon Name="UT" Color="white" />
				</th>
				<th class="bg-secondary text-white" style="width:90px;" @onclick="() => sortFields(5)">
					<GenIcon Name="Location" Color="white" />
				</th>
				<th class="bg-secondary text-white" style="width:90px;" @onclick="() => sortFields(5)">
					<GenIcon Name="TrainTrack" Color="white" />
				</th>
				<th class="bg-secondary text-white" style="width:90px;" @onclick="() => sortFields(0)">
					<GenIcon Name="EventDateTime" Color="white" />
				</th>
				<th class="bg-secondary text-white" style="width:90px;" @onclick="() => sortFields(6)">
					<GenIcon Name="Wash" Color="white" />
				</th>
				<th class="bg-secondary text-white" style="width:200px;" @onclick="() => sortFields(3)">
					<GenIcon Name="User" Color="white" />
				</th>
				<th class="bg-secondary text-white" style="width:250px;" @onclick="() => sortFields(4)">
					<GenIcon Name="AddReport" Color="white" />
				</th>
			</tr>
		</thead>
		<tbody>
			@foreach (TrainModel train in mcolTrains)
			{
				<tr @key="rowKey(train)" class="@rowClass(train)" @onclick="@(e => OnTrainClick(train))">
					<td class="truncate">
						<IcoStatus status="@train.lastStatus" color='@(train.Locked ? "red" : "black")' />
						<span class="truncate">@Sapphire2025Models.Common.TrainStatusToString(train.lastStatus)</span>
					</td>
					<td class="truncate" style="background-color: @trainColor(train); color: @(train.Locked ? "red" : "default")">
						@train.name
					</td>
					<td class="truncate">
						@locationString(train)
					</td>
					<td class="truncate">
						@platformString(train)
					</td>
					<td class="truncate">
						@Sapphire2025Models.Utils.autoDate(train.lastUpdateTime)
					</td>
					<td class="truncate">
						@Sapphire2025Models.Utils.autoDate(train.LastWash)
					</td>
					<td class="truncate">
						@{
							UserModelBase? auxUser = userFromTrain(train);
							if (null != auxUser)
							{
								<span class="d-inline-block align-middle"><RoleIcon Credentials="auxUser.CredentialKey" Color="gray"></RoleIcon></span>
								<span class="truncate d-inline-block align-middle">@auxUser.Name</span>
							}
						}
					</td>
					<td class="truncate">
						@(train.lastNote ?? string.Empty)
					</td>
				</tr>
			}
		</tbody>
	</table>
}

@code {
	[Parameter]
	public bool Filtered { get; set; } = true;

	protected override void OnParametersSet()
	{
		base.OnParametersSet();
		if (Filtered)
		{
			mcolTrains.Clear();
			if (null != Trains)
			{
				foreach (TrainModel auxTren in Trains)
				{
					if (
						auxTren.lastStatus.Equals(Sapphire2025Models.Common.TrainStatus.DepotRequested) ||
						auxTren.lastStatus.Equals(Sapphire2025Models.Common.TrainStatus.Available) ||
						auxTren.lastStatus.Equals(Sapphire2025Models.Common.TrainStatus.RequestToDiagnose) ||
						auxTren.lastStatus.Equals(Sapphire2025Models.Common.TrainStatus.RequestToRepair))
					{
						mcolTrains.Add(auxTren);
					}
				}
				// Orden estable al refrescar/resaltar; no alternar con cada poll.
				sortFieldsStable(mvarLastOrderField >= 0 ? mvarLastOrderField : 1);
			}
		}
		else
			mcolTrains = Trains?.ToList() ?? new List<TrainModel>();
	}

}
