@inherits TrainModelTable
@if(null!=base.Trains)
{
	<table class="table table-bordered table-stripped table-fixed mb-0">
		<thead>
			<tr>
				<th class="bg-secondary text-white" style="width:100px;" @onclick="() => sortFields(2)">
					<Sapphire2025.Icons.Headers.TrainStatus color="white" />
				</th>
				<th class="bg-secondary text-white" style="width:100px;" @onclick="() => sortFields(1)">
					<Sapphire2025.Icons.Headers.UT color="white" />
				</th>
				<th class="bg-secondary text-white" style="width:100px;" @onclick="() => sortFields(5)">
					<Sapphire2025.Icons.Headers.Location color="white" />
				</th>
				<th class="bg-secondary text-white" style="width:100px;" @onclick="() => sortFields(5)">
					<Sapphire2025.Icons.Headers.TrainTrack color="white" />
				</th>
				<th class="bg-secondary text-white" style="width:100px;" @onclick="() => sortFields(0)">
					<Sapphire2025.Icons.Headers.EventDateTime color="white" />
				</th>
				<th class="bg-secondary text-white" style="width:200px;" @onclick="() => sortFields(3)">
					<Sapphire2025.Icons.Headers.User color="white" />
				</th>
				<th class="bg-secondary text-white" style="width:250px;" @onclick="() => sortFields(4)">
					<Sapphire2025.Icons.Actions.AddReport Color="white" />
				</th>
			</tr>
		</thead>
		<tbody>
			@foreach (TrainModel train in mcolTrains)
			{
				<tr @onclick="@(e => OnTrainClick(train))">
					<td class="truncate">
						<Sapphire2025.Icons.Status.IcoStatus status="@train.lastStatus" color="black" />
						<span class="truncate">@Sapphire2025Models.Common.TrainStatusToString(train.lastStatus)</span>
					</td>
					<td class="truncate" style="background-color: @trainColor(train)">
						@train.name
					</td>
					<td class="truncate">
						@locationString(train)
					</td>
					<td class="truncate">
						@platformString(train)
					</td>
					<td class="truncate">
						@Sapphire2025Models.Utils.autoDate(train.lastUpdateTime)
					</td>
					<td class="truncate">
						@{
							UserModelBase? auxUser = userFromTrain(train);
							if (null != auxUser)
							{
								<span class="d-inline-block align-middle">@AuthenticationClient.userIcon(auxUser.CredentialKey, "gray")</span>
								<span class="truncate d-inline-block align-middle">@auxUser.Name</span>
							}
						}
					</td>
					<td class="truncate">
						@(train.lastNote ?? string.Empty)
					</td>
				</tr>
			}
		</tbody>
	</table>
}

@code {

	protected override void OnParametersSet()
	{
		base.OnParametersSet();
		mcolTrains.Clear();
		if (null != Trains)
		{
			foreach (TrainModel auxTren in Trains)
			{
				if (
					auxTren.lastStatus.Equals(Sapphire2025Models.Common.TrainStatus.DepotRequested) ||
					auxTren.lastStatus.Equals(Sapphire2025Models.Common.TrainStatus.Available) ||
					auxTren.lastStatus.Equals(Sapphire2025Models.Common.TrainStatus.RequestToDiagnose) ||
					auxTren.lastStatus.Equals(Sapphire2025Models.Common.TrainStatus.RequestToRepair))
				{
					mcolTrains.Add(auxTren);
				}
			}
			sortFields(1);
		}
	}

}
