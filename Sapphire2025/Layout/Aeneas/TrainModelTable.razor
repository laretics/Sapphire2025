@inject NavigationManager mvarNavigator
@code {
	[CascadingParameter]
	public IEnumerable<TrainModel>? Trains{ get; set; }
	[CascadingParameter]
	public Dictionary<Guid,UserModelBase>? Users{ get; set; }

	protected List<TrainModel> mcolTrains = new List<TrainModel>();

	[Parameter]
	public int Width{ get; set; }
	[Parameter]
	public int Height{ get; set; }
	[CascadingParameter]
	public PlatformModel[] Platforms { get; set; } = new PlatformModel[0];
	[CascadingParameter(Name = "HighlightedTrainIds")]
	public IReadOnlySet<Guid>? HighlightedTrainIds { get; set; }
	[CascadingParameter(Name = "TrainDataVersion")]
	public int TrainDataVersion { get; set; }

	protected int mvarLastOrderField { get; set; } = -1;
	protected bool mvarLastOrderDescending { get; set; }

	/// <summary>
	/// Ordenación al pulsar cabecera: alterna ascendente/descendente.
	/// </summary>
	internal void sortFields(int fieldId)
	{
		if (null == Trains)
			return;

		bool descending = mvarLastOrderField.Equals(fieldId) && !mvarLastOrderDescending;
		ApplySort(fieldId, descending);
		mvarLastOrderField = fieldId;
		mvarLastOrderDescending = descending;
		StateHasChanged();
	}

	/// <summary>
	/// Ordenación estable al refrescar datos (no alterna dirección).
	/// </summary>
	protected void sortFieldsStable(int fieldId)
	{
		if (null == Trains)
			return;

		bool descending = mvarLastOrderField.Equals(fieldId) && mvarLastOrderDescending;
		ApplySort(fieldId, descending);
		if (mvarLastOrderField < 0)
		{
			mvarLastOrderField = fieldId;
			mvarLastOrderDescending = false;
		}
	}

	private void ApplySort(int fieldId, bool descending)
	{
		mcolTrains = fieldId switch
		{
			1 => descending ? mcolTrains.OrderByDescending(xx => xx.name).ToList() : mcolTrains.OrderBy(xx => xx.name).ToList(),
			2 => descending ? mcolTrains.OrderByDescending(xx => xx.lastStatus).ToList() : mcolTrains.OrderBy(xx => xx.lastStatus).ToList(),
			3 => descending ? mcolTrains.OrderByDescending(xx => xx.lastUserInfo).ToList() : mcolTrains.OrderBy(xx => xx.lastUserInfo).ToList(),
			4 => descending ? mcolTrains.OrderByDescending(xx => xx.lastNote).ToList() : mcolTrains.OrderBy(xx => xx.lastNote).ToList(),
			5 => descending ? mcolTrains.OrderByDescending(xx => xx.PlatformId).ToList() : mcolTrains.OrderBy(xx => xx.PlatformId).ToList(),
			6 => descending ? mcolTrains.OrderByDescending(xx => xx.LastWash).ToList() : mcolTrains.OrderBy(xx => xx.LastWash).ToList(),
			_ => descending ? mcolTrains.OrderByDescending(xx => xx.lastUpdateTime).ToList() : mcolTrains.OrderBy(xx => xx.lastUpdateTime).ToList(),
		};
	}

	internal UserModelBase? userFromTrain(TrainModel? train)
	{
		if(null!=Users && null!=train && Guid.Empty!=train.lastUserInfo)
		{
			if (Users.ContainsKey(train.lastUserInfo))
				return Users[train.lastUserInfo];
		}
		return null;
	}
	public void OnTrainClick(TrainModel train)
	{
		if (null != train)
		{
			mvarNavigator.NavigateTo(string.Format("/train/{0}", train.id));
		}
	}
	protected string platformString(TrainModel train)
	{
		if (train.PlatformId > 0)
		{
			if ((train.PlatformId - 1) < Platforms.Length)
				return Platforms[train.PlatformId - 1].PlatformName;
		}
		return "-";
	}
	protected string locationString(TrainModel train)
	{
		if(train.PlatformId>0)
		{
			if ((train.PlatformId - 1) < Platforms.Length)
				return Platforms[train.PlatformId - 1].StationName;
		}
		return "-";
	}
	protected string trainColor(TrainModel train) { return train == null ? "transparent" : Sapphire2025Models.Utils.TrainStyleFill(train.name); }

	protected bool IsHighlighted(TrainModel? train)
	{
		return null != train
			&& null != HighlightedTrainIds
			&& HighlightedTrainIds.Contains(train.id);
	}

	/// <summary>
	/// Clase de fila resaltada (misma familia visual que scheme-cell-highlight de AeneasScheme).
	/// </summary>
	protected string rowClass(TrainModel train)
	{
		return IsHighlighted(train) ? "train-row-highlight" : string.Empty;
	}

	/// <summary>
	/// Clave de render: al cambiar el resalte se recrea el &lt;tr&gt; y la animación CSS se reinicia.
	/// </summary>
	protected string rowKey(TrainModel train)
	{
		if (null == train)
			return Guid.Empty.ToString();

		return IsHighlighted(train)
			? $"{train.id:N}-hl-{TrainDataVersion}"
			: train.id.ToString("N");
	}
}
