@using Sapphire2025Models
@implements IAsyncDisposable
@inject AeneasClient mvarAeneasClient
@inject IJSRuntime mvarJs

<div class="modal fade" id="@mvarId" tabindex="-1">
	<div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
		<div class="modal-content shadow">
			<div class="modal-header">
				<h5 class="modal-title">
					<i class="bi bi-tag me-2"></i>Etiquetar nota
				</h5>
				<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar" disabled="@mvarSaving"></button>
			</div>
			<div class="modal-body">
				@if (mvarNote is not null)
				{
					<div class="mb-3">
						<div class="d-flex justify-content-between small text-muted mb-1">
							<span>@Common.NoteTypeName(mvarNote.Type)</span>
							<span>@Utils.autoDate(mvarNote.TimeStamp)</span>
						</div>
						<div class="border rounded p-3 bg-light" style="white-space: pre-wrap;">@mvarNote.Text</div>
					</div>

					<div class="mb-3 form-check form-switch">
						<input class="form-check-input"
							   type="checkbox"
							   role="switch"
							   id="@mvarSymptomId"
							   @bind="mvarIsSymptom" />
						<label class="form-check-label" for="@mvarSymptomId">
							@(mvarIsSymptom ? "Síntoma de avería" : "Resolución / no es síntoma")
						</label>
						<div class="form-text">
							Activo si esta nota describe un síntoma o una incidencia. Inactivo si describe una resolución o una actuación.
						</div>
					</div>

					<div class="mb-2">
						<label class="form-label fw-bold" for="@mvarSystemId">Sistema afectado</label>
						<select id="@mvarSystemId" class="form-select" @bind="mvarSystemAffected" disabled="@mvarSaving">
							@foreach (Common.TrainSystem system in Enum.GetValues<Common.TrainSystem>())
							{
								<option value="@system">@Common.TrainSystemName(system)</option>
							}
						</select>
					</div>

					@if (mvarHasOlderUnlabeled)
					{
						<div class="alert alert-warning py-2 small mb-0">
							Hay notas anteriores todavía sin etiquetar. Si guarda esta, esas dejarán de poder etiquetarse.
						</div>
					}

					@if (!string.IsNullOrWhiteSpace(mvarError))
					{
						<div class="alert alert-danger py-2 small mt-3 mb-0">@mvarError</div>
					}
				}
			</div>
			<div class="modal-footer">
				<button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal" disabled="@mvarSaving">
					Cancelar
				</button>
				<button type="button" class="btn btn-primary" @onclick="SaveAsync" disabled="@mvarSaving">
					@if (mvarSaving)
					{
						<span class="spinner-border spinner-border-sm me-1" role="status"></span>
					}
					Guardar etiqueta
				</button>
			</div>
		</div>
	</div>
</div>

@code {
	[Parameter]
	public EventCallback<NoteModel> OnSaved { get; set; }

	private readonly string mvarId = Guid.NewGuid().ToString("N");
	private string mvarSymptomId => $"symptom_{mvarId}";
	private string mvarSystemId => $"system_{mvarId}";

	private NoteModel? mvarNote;
	private bool mvarIsSymptom;
	private Common.TrainSystem mvarSystemAffected;
	private bool mvarSaving;
	private bool mvarHasOlderUnlabeled;
	private bool mvarPendingShow;
	private string? mvarError;

	public Task ShowAsync(NoteModel note, bool hasOlderUnlabeled = false)
	{
		mvarNote = note;
		mvarIsSymptom = note.IsSymptom;
		mvarSystemAffected = (Common.TrainSystem)note.SystemAffected;
		mvarHasOlderUnlabeled = hasOlderUnlabeled;
		mvarError = null;
		mvarSaving = false;
		mvarPendingShow = true;
		StateHasChanged();
		return Task.CompletedTask;
	}

	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		if (!mvarPendingShow)
			return;
		mvarPendingShow = false;
		await mvarJs.InvokeVoidAsync("showModal", mvarId);
	}

	private async Task SaveAsync()
	{
		if (mvarNote is null || mvarSaving)
			return;

		if (mvarSystemAffected == Common.TrainSystem.undefined)
		{
			mvarError = "Seleccione el sistema del tren al que se refiere esta nota.";
			return;
		}

		mvarSaving = true;
		mvarError = null;
		try
		{
			byte systemValue = (byte)mvarSystemAffected;
			bool ok = await mvarAeneasClient.labelNote(mvarNote.Id, mvarIsSymptom, systemValue);
			if (!ok)
			{
				mvarError = "No se pudo guardar la etiqueta. Compruebe permisos o si otra nota más reciente ya está etiquetada.";
				return;
			}

			mvarNote.IsValid = true;
			mvarNote.IsSymptom = mvarIsSymptom;
			mvarNote.SystemAffected = systemValue;

			await mvarJs.InvokeVoidAsync("hideModal", mvarId);
			if (OnSaved.HasDelegate)
				await OnSaved.InvokeAsync(mvarNote);
		}
		finally
		{
			mvarSaving = false;
		}
	}

	public async ValueTask DisposeAsync()
	{
		try
		{
			await mvarJs.InvokeVoidAsync("hideModal", mvarId);
		}
		catch
		{
			// El runtime JS puede no estar disponible al desmontar la pestaña.
		}
	}
}
