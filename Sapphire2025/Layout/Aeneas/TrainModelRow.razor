@implements IDisposable
@inject NavigationManager mvarNavigator
@if (null != Train)
{
    <div class="row border-bottom train-row">
        @if (ShowStatus)
        {
            <div @onclick="OnTrainClick" class="col-2 border-end text-center d-flex justify-content-center align-items-center train-cell" style="min-width: 64px;">
                <Sapphire2025.Icons.Status.IcoStatus status="@Train.lastStatus" color="black" />
                <span class="truncate">@Sapphire2025Models.Common.TrainStatusToString(Train.lastStatus)</span>
            </div>
            <div @onclick="OnTrainClick" class="col-2 border-end text-center d-flex justify-content-center align-items-center train-cell" style="min-width: 100px; background-color: @trainColor;">
                <span class="truncate">@Train.name</span>
            </div>
        }
        else
        {
            <div @onclick="OnTrainClick" class="col-2 border-end text-center d-flex justify-content-center align-items-center train-cell" style="min-width: 100px; background-color: @trainColor;">
                <span class="truncate">@Train.name</span>
            </div>
        }

        <div @onclick="OnTrainClick" class="col-3 border-end train-cell" style="min-width: 200px;">
            <span class="truncate">@Sapphire2025Models.Utils.autoDate(Train.lastUpdateTime)</span>
        </div>
        <div @onclick="OnUserClick" class="col-2 border-end train-cell @(IsRecentUpdate ? "recent-update" : "")" style="min-width: 200px;">
            @if (null != User)
            {
                <span class="d-inline-block align-middle">@userIcon(User.CredentialKey)</span>
                <span class="truncate d-inline-block align-middle">@User.Name</span>
            }
        </div>
        <div @onclick="OnTrainClick" class="col-4 border-end train-cell truncate" style="min-width:100px;" title="@(Train.lastNote ?? string.Empty)">
            @(Train.lastNote ?? string.Empty)
        </div>
    </div>
}
@code {
    [Parameter]
    public TrainModel? Train { get; set; }
    [Parameter]
    public bool ShowStatus{ get; set; }
    [Parameter]
    public UserModelBase? User{ get; set; }
   
    private Timer? mvarTimer;

    protected override void OnInitialized()
    {
        // Actualizar cada minuto para reevaluar IsRecentUpdate
        mvarTimer = new Timer(_ => InvokeAsync(StateHasChanged), null, TimeSpan.FromMinutes(1), TimeSpan.FromMinutes(1));
    }

    public void Dispose()
    {
        mvarTimer?.Dispose();
    }

    private string trainColor{ get => Train==null?"transparent":Sapphire2025Models.Utils.TrainStyleFill(Train.name); }

    public void OnTrainClick()
    {
        if(null!=Train)
        {
            mvarNavigator.NavigateTo(string.Format("/train/{0}", Train.id));
        }        
    }  
    public void OnUserClick()
    {
        if(null!=User)
        {
            mvarNavigator.NavigateTo(string.Format("/user/{0}", User.guid));
        }
    }
    private RenderFragment userIcon(byte credentials)
    {
        return AuthenticationClient.userIcon(credentials, "gray");
    }
    private bool IsRecentUpdate
    {
        get
        {
            if (Train == null) return false;

            // Convertir a hora local si es necesario
            DateTime lastUpdate = Train.lastUpdateTime.Kind == DateTimeKind.Utc
                ? Train.lastUpdateTime.ToLocalTime()
                : Train.lastUpdateTime;

            TimeSpan timeSinceUpdate = DateTime.Now - lastUpdate;
            return timeSinceUpdate.TotalMinutes < 30 && timeSinceUpdate.TotalMinutes > 0;
        }
    }

}
