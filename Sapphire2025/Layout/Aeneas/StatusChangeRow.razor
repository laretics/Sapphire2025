@inject NavigationManager mvarNavigator
@if(null!=changeModel)
{
	<tr>
		<td style="border-right:1px solid #dee2e6;">
			<Sapphire2025.Icons.Status.IcoStatus status="@changeModel.status" color="black" />
		</td>
		<td style="border-right:1px solid #dee2e6;">
			@changeModel.timeStamp
		</td>
		<td style="border-right:1px solid #dee2e6;">
		</td>
		<td style="border-right:1px solid #dee2e6;">
			@if (null != userModel)
			{
				@userIcon(userModel.CredentialKey)
				@userModel.Name
			}
		</td>
	</tr>
}
@code {
	[Parameter]
	public StatusChangeModel? changeModel{ get; set; }
	[Parameter]
	public UserModelBase? userModel{ get; set; }
	private RenderFragment userIcon(byte credentials)
	{
		return AuthenticationClient.userIcon(credentials, "gray");
	}
}
