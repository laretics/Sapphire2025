@page "/addnote/{trainId}/{noteType}"
@inject NavigationManager mvarNavigationManager
@inject AuthenticationClient mvarAuthClient
@inject AeneasClient mvarAeneasClient
<h3 class="mb-4">
    <i class="bi bi-journal-text me-2"></i>    
    @formTitle
</h3>

@if (null == noteModel)
{
    <div class="text-center my-5">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Cargando...</span>
        </div>
        <div>Cargando formulario...</div>
    </div>
}
else
{
    <EditForm Model="noteModel" OnValidSubmit="HandleValidSubmit">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="card shadow-sm p-4">
            <div class="mb-3">
                <label for="noteText" class="form-label fw-bold">
                    <i class="bi bi-pencil-square me-1"></i>
                    @contentLabel
                </label>
                <InputTextArea id="noteText" class="form-control" @bind-Value="noteModel.Text" rows="4" placeholder="Aquí va el texto..." />
                <ValidationMessage For="@(() => noteModel.Text)" />
            </div>

            <div class="mb-3">
                <label class="form-label fw-bold">
                    <i class="bi bi-calendar-event me-1"></i>
                    Fecha y hora
                </label>
                <InputDate class="form-control" @bind-Value="noteModel.TimeStamp" />
            </div>

            <div class="d-flex justify-content-end gap-2">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-save me-1"></i> Guardar
                </button>
                <button type="button" class="btn btn-secondary" @onclick="Cancelar">
                    <i class="bi bi-x-circle me-1"></i> Cancelar
                </button>
            </div>
        </div>
    </EditForm>
}

@code {
    public NoteModel? noteModel { get; set; }

    private UserModelBase? userModelBase { get; set; }
    public TrainModel? mvarTrain { get; set; } = null;

    [Parameter]
    public string? trainId { get; set; }
    [Parameter]
    public string noteType { get; set; } = "0";
    private DateTime mvarFirstDate { get; set; } = DateTime.Now;

    private string formTitle
    {
        get
        {
            if (null != mvarTrain)
            {
                switch (noteType)
                {
                    case "1":
                        return string.Format("Parte de Avería del tren {0}",mvarTrain.name);
                    case "2":
                        return string.Format("Nota del tren {0}",mvarTrain.name);
                    default:
                        return string.Format("Documento del tren {0}",mvarTrain.name);
                }
            }
            return "Documento";
        }
    }
    private string contentLabel
    {
        get
        {
            switch (noteType)
            {
                case "1":
                    return "Descripción de la avería";
                case "2":
                    return "Texto de la información";
                default:
                    return "Contenido";
            }
        }
    }

    protected async override Task OnInitializedAsync()
    {
        Guid auxId = Guid.Empty;
        mvarFirstDate = DateTime.Now;
        UserModelBase? auxUser = await mvarAuthClient.GetCurrentUser();        
        System.Diagnostics.Debug.Assert(null != auxUser, "El usuario no puede ser nulo");
        Guid.TryParse(trainId, out auxId);
        if(null!=trainId)
            mvarTrain = await mvarAeneasClient.train(trainId);

        if(Guid.Empty!=auxId)
        {
            noteModel = new NoteModel
                {
                    TimeStamp = mvarFirstDate,
                    parent = auxId,
					UserId = auxUser.guid,
                    Type = byte.Parse(noteType)
                };
        }
    }

    private async void HandleValidSubmit()
    {
        // Aquí iría la lógica para guardar la nota
        // Por ejemplo, llamar a un servicio o API
        if(null!=noteModel && null!=noteModel.Text && noteModel.Text.Length>0)
        {
            await mvarAeneasClient.addNote(noteModel);
            if(null!=mvarTrain)
            {
                //Parte específica de los partes y las notas de los trenes.
				if (noteModel.Type == 1)
				{
                    //La apertura de un parte de avería va a cambiar el tren al estado pendiente
                    //de diagnóstico, pero esto no lo deberíamos hacer aquí, sino en el cliente
                    //de Aeneas.



				}
            }
            mvarNavigationManager.NavigateTo($"/train/{trainId}");
        }                
    }

    private void Cancelar()
    {
        mvarNavigationManager.NavigateTo($"/train/{trainId}");
    }

}
