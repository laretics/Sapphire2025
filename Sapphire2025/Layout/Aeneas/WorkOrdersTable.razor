@using Sapphire2025.Icons
@using Sapphire2025Models.GMao
@inject IntStorageService mvarIntStorage
@inject AeneasClient mvarAeneasClient
<ModalDialog @ref="mvarConfirmationDialogOrderTable" OnClose="OnConfirmClose" />
<div class="table-responsive" style="height:100%; max-height:70vh;">
	<table class="table table-bordered table-sm align-middle mb-0 w-100">
		<thead class="table-secondary text-light">
			<tr>
				<th class="col-3" style="min-width: 100px; cursor:pointer;" @onclick="@(() => sortFields(1))">
					<GenIcon Name="Exec" Color="white"/>
				</th>
				<th class="col-2" style="min-width: 100px; cursor:pointer;" @onclick="@(() => sortFields(2))">
					<GenIcon Name="EventDateTime" Color="white" /> <span>Solicitud</span>					
				</th>
				<th class="col-2" style="min-width: 100px; cursor:pointer;" @onclick="@(() => sortFields(3))">
					<GenIcon Name="EventDateTime" Color="white" /> <span>Inicio</span>
				</th>
				<th class="col-2" style="min-width: 100px; cursor:pointer;" @onclick="@(() => sortFields(4))">
					<GenIcon Name="EventDateTime" Color="white" /> <span>Cierre</span>
				</th>
				<th class="col-2" style="min-width: 100px; cursor:pointer;" @onclick="@(() => sortFields(5))">
					<GenIcon Name="EventDateTime" Color="white" /> <span>Verificación</span>
				</th>
			</tr>
		</thead>
		<tbody>
			@foreach (WorkOrderModel order in mcolWorkOrdersLocal)
			{
				UserModelBase? requestUser = userFromRequestOrder(order);
				UserModelBase? openUser = userFromOpenOrder(order);
				UserModelBase? closeUser = userFromCloseOrder(order);
				UserModelBase? verifyUser = userFromVerifyOrder(order);
				<tr>

					<td style="border-right:1px solid #dee2e6;">
						@orderCatalogName(order)
					</td>
					<td style="border-right:1px solid #dee2e6;">
						<GenIcon Name="CheckBoxChecked" Color="gray"/>
						<span>@Sapphire2025Models.Utils.autoDate(order.RequestTime)</span>
						@if(null!=requestUser)
						{
							<span>
								<RoleIcon Credentials="requestUser.CredentialKey" Color="gray"></RoleIcon>
							</span>
							<span>
								@requestUser.Name
							</span>								
						}
					</td>
					<td style="border-right:1px solid #dee2e6;">
						@if(order.Rejected)						
						{
							<GenIcon Name="Trash" Color="gray"/>
							@if(null!=verifyUser)
							{
								<span>
									<RoleIcon Credentials="verifyUser.CredentialKey" Color="gray"></RoleIcon>
								</span>
								<span>
									@verifyUser.Name
								</span>
							}
						}
						else
						{
							@if(null!=openUser)
							{
								<GenIcon Name="CheckBoxChecked" Color="gray" />
								<span>@Sapphire2025Models.Utils.autoDate(order.OpenTime)</span>
								<span>
									<RoleIcon Credentials="openUser.CredentialKey" Color="gray"></RoleIcon>
								</span>
								<span>
									@openUser.Name
								</span>
							}
							else
							{
								<button type="button" class="btn btn-link p-0" @onclick="() => HandleOpenClicked(order)">
									<GenIcon Name="CheckBox" Color="black" />
								</button>
								<button type="button" class="btn btn-link p-0" @onclick="() => HandleRejectOpenClicked(order)" >
									<GenIcon Name="Trash" Color="black" />
								</button>																	
							}
						}
					</td>
					@if(!order.Rejected)
					{
						<td style="border-right:1px solid #dee2e6;">
							@if(null==openUser)
							{
								<GenIcon Name="CheckBox" Color="gray" />
							}
							else if(null!=closeUser)
							{
								<GenIcon Name="CheckBoxChecked" Color="gray" />
								<span>@Sapphire2025Models.Utils.autoDate(order.CloseTime)</span>
								<span>
									<RoleIcon Credentials="closeUser.CredentialKey" Color="gray"></RoleIcon>
								</span>
								<span>
									@closeUser.Name
								</span>
							}
							else
							{
								<button type="button" class="btn btn-link p-0" @onclick="() => HandleCompleteClicked(order)">
									<GenIcon Name="CheckBox" Color="black" />
								</button>									
							}
						</td>
						<td style="border-right:1px solid #dee2e6;">
							@if(null==openUser||null==closeUser)
							{
								<GenIcon Name="CheckBox" Color="gray" />
							}
							else if(null!=verifyUser)
							{
								<GenIcon Name="CheckBoxChecked" Color="gray" />
								<span>@Sapphire2025Models.Utils.autoDate(order.VerifyTime)</span>
								<span>
									<RoleIcon Credentials="verifyUser.CredentialKey" Color="gray"></RoleIcon>
								</span>
								<span>
									@verifyUser.Name
								</span>
							}
							else
							{
								<button type="button" class="btn btn-link p-0" @onclick="() => HandleVerifyClicked(order)">
									<GenIcon Name="CheckBox" Color="black" />
								</button>									
							}
						</td>
					}
				</tr>
			}
			</tbody>
		</table>
	</div>
@code {
	[CascadingParameter]
	public Dictionary<Guid, UserModelBase>? Users { get; set; }
	[CascadingParameter]
	public TrainModel? Train{ get; set; }
	[CascadingParameter]
	public IEnumerable<WorkOrderModel>? mcolWorkOrders{ get; set; }

	private List<WorkOrderModel> mcolWorkOrdersLocal { get; set; } = new List<WorkOrderModel>();

	private Dictionary<Guid, WorkCatalogModel> mcolOrderCatalog { get; set; } = new Dictionary<Guid, WorkCatalogModel>();

	private SessionModel? mvarSession{ get; set; }
	private bool UserCanOpenTask{ get; set; }
	private bool UserCanCloseTask{ get; set; }
	private bool UserCanVerifyTask{ get; set; }

	private ModalDialog? mvarConfirmationDialogOrderTable;
	private TaskCompletionSource<bool>? mvarConfirmTcs;

	private int mvarLastOrderField { get; set; } = -1;
	private bool mvarSortDescending { get; set; } = false;

	protected override async Task OnParametersSetAsync()
	{
		await base.OnParametersSetAsync();
		mcolOrderCatalog = await mvarAeneasClient.OrdersDictionary();
		mvarSession = await mvarIntStorage.GetSessionInfo();
		UserCanOpenTask = Sapphire2025Models.Utils.CanOpenTask(mvarSession);
		UserCanCloseTask = Sapphire2025Models.Utils.CanCloseTask(mvarSession);
		UserCanVerifyTask = Sapphire2025Models.Utils.CanVerifyTask(mvarSession);
		if (null != mcolWorkOrders)
			mcolWorkOrdersLocal = mcolWorkOrders.ToList();
	}

	private async Task RefreshOrdersAsync()
	{
		if (Train is null) return;
		IEnumerable<WorkOrderModel>? auxOrders = await mvarAeneasClient.workOrdersByTrain(Train.id);		
		mcolWorkOrdersLocal = auxOrders?.ToList() ?? new List<WorkOrderModel>();
		await InvokeAsync(StateHasChanged);
	}

	private bool EnableCheckOpen(WorkOrderModel order)
	{
		return null == order.OpenTime && UserCanOpenTask;
	}
	private bool EnableCheckClose(WorkOrderModel order)
	{
		return null == order.CloseTime && UserCanCloseTask;
	}
	private bool EnableCleckVerify(WorkOrderModel order)
	{
		return null == order.VerifyTime && UserCanVerifyTask && null != order.CloseTime;
	}

	private async Task HandleOpenClicked(WorkOrderModel order)
	{
		if (!EnableCheckOpen(order)) return; //No podemos hacer nada si no puede iniciar
		if(await ConfirmOpenWorkAsync(order))
		{
			await mvarAeneasClient.openWorkOrder(order.Id);
			await RefreshOrdersAsync();
		}
	}
	private async Task HandleRejectOpenClicked(WorkOrderModel order)
	{
		//if (!EnableCheckOpen(order)) return; //Si el usuario no puede confirmar, tampoco puede rechazar.
		if(await ConfirmRejectWorkAsync(order))
		{
			await mvarAeneasClient.rejectWorkOrder(order.Id);
			await RefreshOrdersAsync();
		}
	}

	private async Task HandleCompleteClicked(WorkOrderModel order)
	{
		if (!EnableCheckClose(order)) return; //Ignoramos si no puede completar
		if (await ConfirmCloseWorkAsync(order))
		{
			await mvarAeneasClient.closeWorkOrder(order.Id);

			//Si la orden era de lavado, lo anota en la tabla de trenes.
			if (Sapphire2025Models.Utils.OrderTypeIsWash(order.WorkType) && null!=order.TrainId)
			{
				TrainModel modelo = new TrainModel();
				modelo.id = (Guid)order.TrainId;
				await mvarAeneasClient.UpdateWash(modelo);
			}			

			await RefreshOrdersAsync();
		}
	}
	private async Task HandleVerifyClicked(WorkOrderModel order)
	{
		if (!EnableCleckVerify(order)) return; //Ignoramos si no puede verificar
		if (await ConfirmVerifyWorkAsync(order))
		{
			await mvarAeneasClient.verifyWorkOrder(order.Id);
			await RefreshOrdersAsync();
		}		
	}

	private async Task<bool> ConfirmRejectWorkAsync(WorkOrderModel order)
	{
		mvarConfirmTcs = new TaskCompletionSource<bool>();
		if (null != mvarConfirmationDialogOrderTable && mcolOrderCatalog.ContainsKey(order.WorkType))
			await mvarConfirmationDialogOrderTable.show(
				"Negación de tarea",
				$"¿Quiere cancelar la tarea solicitada de {mcolOrderCatalog[order.WorkType].Name}?",
				"Confirmar rechazo",
				"Cancelar");
		return await mvarConfirmTcs.Task;
	}

	private async Task<bool> ConfirmOpenWorkAsync(WorkOrderModel order)
	{
		mvarConfirmTcs = new TaskCompletionSource<bool>();
		if (null != mvarConfirmationDialogOrderTable && mcolOrderCatalog.ContainsKey(order.WorkType))
			await mvarConfirmationDialogOrderTable.show(
				"Inicio de tarea",
				$"¿Confirma que quiere iniciar la tarea de {mcolOrderCatalog[order.WorkType].Name}?",
				"Confirmar inicio",
				"Cancelar");
		return await mvarConfirmTcs.Task;
	}

	private async Task<bool> ConfirmCloseWorkAsync(WorkOrderModel order)
	{
		mvarConfirmTcs = new TaskCompletionSource<bool>();
		if (null != mvarConfirmationDialogOrderTable && mcolOrderCatalog.ContainsKey(order.WorkType))
			await mvarConfirmationDialogOrderTable.show(
				"Cierre de tarea",
				$"¿Confirma que quiere cerrar la tarea de {mcolOrderCatalog[order.WorkType].Name}?",
				"Confirmar cierre",
				"Cancelar");
		return await mvarConfirmTcs.Task;
	}
	private async Task<bool> ConfirmVerifyWorkAsync(WorkOrderModel order)
	{
		mvarConfirmTcs = new TaskCompletionSource<bool>();
		if (null != mvarConfirmationDialogOrderTable && mcolOrderCatalog.ContainsKey(order.WorkType))
			await mvarConfirmationDialogOrderTable.show(
				"Cierre de tarea",
				$"¿Confirma que quiere verificar que tarea de {mcolOrderCatalog[order.WorkType].Name} ha finalizado correctamente?",
				"Confirmar verificación",
				"Cancelar");
		return await mvarConfirmTcs.Task;
	}

	private Task OnConfirmClose(bool result)
	{
		mvarConfirmTcs?.TrySetResult(result);
		return Task.CompletedTask;
	}





	private string orderCatalogName(WorkOrderModel rhs)
	{
		if (mcolOrderCatalog.ContainsKey(rhs.WorkType))
			return mcolOrderCatalog[rhs.WorkType].Name;
		return string.Empty;
	}

	private UserModelBase? userFromRequestOrder(WorkOrderModel rhs)
	{
		if(null!=Users && Guid.Empty != rhs.RequestUserId)
		{
			if (Users.ContainsKey(rhs.RequestUserId))
				return Users[rhs.RequestUserId];
		}
		return null;
	}

	private UserModelBase? userFromOpenOrder(WorkOrderModel rhs)
	{
		if (null != Users && Guid.Empty != rhs.OpenUserId && null!=rhs.OpenUserId)
		{
			if (Users.ContainsKey(rhs.OpenUserId.Value))
				return Users[rhs.OpenUserId.Value];
		}
		return null;
	}
	private UserModelBase? userFromCloseOrder(WorkOrderModel rhs)
	{
		if (null!= rhs.CloseUserId && null != Users && Guid.Empty != rhs.CloseUserId)
		{
			if (Users.ContainsKey(rhs.CloseUserId.Value))
				return Users[rhs.CloseUserId.Value];
		}
		return null;
	}
	private UserModelBase? userFromVerifyOrder(WorkOrderModel rhs)
	{
		if (null != rhs.VerifyUserId && null != Users && Guid.Empty != rhs.VerifyUserId)
		{
			if (Users.ContainsKey(rhs.VerifyUserId.Value))
				return Users[rhs.VerifyUserId.Value];
		}
		return null;
	}

	private void sortFields(int fieldId)
	{
		if (mvarLastOrderField == fieldId)
			mvarSortDescending = !mvarSortDescending;
		else
		{
			mvarLastOrderField = fieldId;
			mvarSortDescending = false;
		}

		IOrderedEnumerable<WorkOrderModel> ordered = fieldId switch
		{
			1 => mvarSortDescending
				? mcolWorkOrdersLocal.OrderByDescending(x => orderCatalogName(x))
				: mcolWorkOrdersLocal.OrderBy(x => orderCatalogName(x)),

			2 => mvarSortDescending
				? mcolWorkOrdersLocal.OrderByDescending(x => x.RequestTime)
				: mcolWorkOrdersLocal.OrderBy(x => x.RequestTime),

			3 => mvarSortDescending
				? mcolWorkOrdersLocal.OrderByDescending(x => x.OpenTime ?? DateTime.MinValue)
				: mcolWorkOrdersLocal.OrderBy(x => x.OpenTime ?? DateTime.MaxValue),

			4 => mvarSortDescending
				? mcolWorkOrdersLocal.OrderByDescending(x => x.CloseTime ?? DateTime.MinValue)
				: mcolWorkOrdersLocal.OrderBy(x => x.CloseTime ?? DateTime.MaxValue),

			5 => mvarSortDescending
				? mcolWorkOrdersLocal.OrderByDescending(x => x.VerifyTime ?? DateTime.MinValue)
				: mcolWorkOrdersLocal.OrderBy(x => x.VerifyTime ?? DateTime.MaxValue),

			_ => mvarSortDescending
				? mcolWorkOrdersLocal.OrderByDescending(x => x.RequestTime)
				: mcolWorkOrdersLocal.OrderBy(x => x.RequestTime)
		};

		mcolWorkOrdersLocal = ordered.ToList();
		StateHasChanged();
	}
}

