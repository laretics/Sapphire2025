@using Sapphire2025Models.Aeneas

<div class="platform-select-ctl">
    <div class="input-group flex-nowrap">
        <input type="text"
               class="form-control"
               placeholder="Buscar estación o andén"
               @bind="searchText"
               @bind:event="oninput"
               @onfocus="ShowDropdown"
               @onblur="HideDropdownWithDelay"
               autocomplete="off" />
        @if (!string.IsNullOrWhiteSpace(searchText))
        {
            <button type="button"
                    class="btn btn-outline-secondary platform-select-clear"
                    title="Borrar"
                    @onmousedown:preventDefault="true"
                    @onclick="ClearSelection">
                <span aria-hidden="true">&times;</span>
            </button>
        }
    </div>

    @if (showDropdown && FilteredPlatforms.Any())
    {
        <ul class="dropdown-menu show w-100" style="max-height: 250px; overflow-y: auto; position: absolute; z-index: 10;">
            @foreach (var platform in FilteredPlatforms)
            {
                <li>
                    <button type="button" class="dropdown-item"
                            @onmousedown:preventDefault="true"
                            @onclick="() => SelectPlatform(platform)">
                        @platform.StationName - @platform.PlatformName
                    </button>
                </li>
            }
        </ul>
    }
</div>

@code {
    [Parameter]
    public IEnumerable<PlatformModel> Platforms { get; set; } = new List<PlatformModel>();

    [Parameter]
    public TrainModel? Train { get; set; }

    [Parameter]
    public EventCallback<PlatformModel?> OnPlatformSelected { get; set; }

    private string searchText = string.Empty;
    private bool showDropdown = false;
    private PlatformModel? selectedPlatform;

    /// <summary>
    /// Id de la vía ya confirmada (en el tren / servidor). -1 = sin vía.
    /// </summary>
    private int lastCommittedPlatformId = -1;

    /// <summary>
    /// True cuando ya se ha podido sincronizar la UI con Train + Platforms.
    /// </summary>
    private bool syncedFromTrain;

    protected override void OnParametersSet()
    {
        // Platforms llega de forma asíncrona desde el padre; OnInitializedAsync
        // se ejecuta demasiado pronto (lista vacía) y no vuelve a correr.
        TrySyncFromTrain();
    }

    private void TrySyncFromTrain()
    {
        if (syncedFromTrain || Train is null)
            return;

        if (Train.PlatformId < 1)
        {
            selectedPlatform = null;
            searchText = string.Empty;
            lastCommittedPlatformId = -1;
            syncedFromTrain = true;
            return;
        }

        // Si la lista de vías aún no ha llegado, esperamos al siguiente OnParametersSet.
        if (!Platforms.Any())
            return;

        var platform = PlatformFromId(Train.PlatformId);
        if (platform is null)
        {
            // Lista cargada pero no hay coincidencia: mostrar vacío y no reintentar.
            selectedPlatform = null;
            searchText = string.Empty;
            lastCommittedPlatformId = -1;
            syncedFromTrain = true;
            return;
        }

        selectedPlatform = platform;
        searchText = FormatPlatform(platform);
        lastCommittedPlatformId = platform.Id;
        syncedFromTrain = true;
    }

    private IEnumerable<PlatformModel> FilteredPlatforms =>
        Platforms.Where(p =>
            string.IsNullOrWhiteSpace(searchText) ||
            p.StationName.Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
            p.PlatformName.Contains(searchText, StringComparison.OrdinalIgnoreCase));

    private void ShowDropdown()
    {
        showDropdown = true;
    }

    private async Task HideDropdownWithDelay()
    {
        await Task.Delay(150);
        showDropdown = false;
        StateHasChanged();
    }

    private async Task SelectPlatform(PlatformModel platform)
    {
        selectedPlatform = platform;
        searchText = FormatPlatform(platform);
        showDropdown = false;

        if (lastCommittedPlatformId == platform.Id)
            return;

        lastCommittedPlatformId = platform.Id;
        if (OnPlatformSelected.HasDelegate)
            await OnPlatformSelected.InvokeAsync(platform);
    }

    private PlatformModel? PlatformFromId(int id) =>
        Platforms.FirstOrDefault(p => p.Id == id);

    private static string FormatPlatform(PlatformModel platform) =>
        $"{platform.StationName} - {platform.PlatformName}";

    private async Task ClearSelection()
    {
        searchText = string.Empty;
        selectedPlatform = null;
        showDropdown = false;

        if (lastCommittedPlatformId < 1)
            return;

        lastCommittedPlatformId = -1;
        if (OnPlatformSelected.HasDelegate)
            await OnPlatformSelected.InvokeAsync(null);
    }
}
