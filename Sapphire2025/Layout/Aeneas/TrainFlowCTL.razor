						<GenIcon Name="Scheduler" Color="navy" x="61" y="53" Size="32" />
						<GenIcon Name="Right" Color="navy" x="61" y="59" Size="32" />

						<GenIcon Name="Up" Color="navy" x="46" y="68" Size="32" />
						<GenIcon Name="UpDown" Color="navy" x="76" y="68" Size="32" />

