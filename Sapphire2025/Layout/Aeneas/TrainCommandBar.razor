@inject InteractiveService mvarInteractive
@inject AeneasClient mvarAeneasClient
@inject NavigationManager mvarNavigationManager
@if(trainInCirculation)
{
	<Button Class="btn btn-outline-secondary" @onclick="@openFailureReport">
		<span><Sapphire2025.Icons.Actions.AddReport color="#b02020"/></span>
		Parte de Avería</Button>
}		
@if(isExpert&&currentStatus== Sapphire2025Models.Common.TrainStatus.RequestToDiagnose)
{
	<Button Class="btn btn-outline-secondary" @onclick="@diagnoseToAvailable">No Se Retira</Button>
	<Button Class="btn btn-outline-secondary" @onclick="@diagnoseToFault">Retirar de Circulación</Button>
}
@if(isInspector&&currentStatus== Sapphire2025Models.Common.TrainStatus.RequestToRepair)
{
	<Button Class="btn btn-outline-secondary" @onclick="@sendToCorrective">Entrar a Reparar</Button>
}
@if(isMechanic&&currentStatus== Sapphire2025Models.Common.TrainStatus.Repairing)
{
	<Button Class="btn btn-outline-secondary" @onclick="@sendToAvailable">Terminar Reparación</Button>
}
@if(isOfficial&&currentStatus== Sapphire2025Models.Common.TrainStatus.Available)
{
	<Button Class="btn btn-outline-secondary" @onclick="@requestMaintenance">Solicitar Mantenimiento</Button>
}
@if(isOfficial&&currentStatus== Sapphire2025Models.Common.TrainStatus.DepotRequested)
{
	<Button Class="btn btn-outline-warning" @onclick="@undoSendToMaintenance">Anular Solicitud Mant.</Button>
}
@if(isInspector&&currentStatus== Sapphire2025Models.Common.TrainStatus.DepotRequested)
{
	<Button Class="btn btn-outline-secondary" @onclick="@acceptSendToMaintenance">Enviar a Mantenimiento</Button>
}
@if(isOfficial&&currentStatus== Sapphire2025Models.Common.TrainStatus.DepotAvailable)
{
	<Button Class="btn btn-outline-warning" @onclick="@rescueFromMaintenance">Rescatar de depósito</Button>
	<Button Class="btn btn-outline-secondary" @onclick="@sendToMaintenance">Entrar a Mantenimiento</Button>
}
@if(isMechanic&&currentStatus== Sapphire2025Models.Common.TrainStatus.Maintenance)
{
	<Button Class="btn btn-outline-secondary" @onclick="@endMaintenance">Terminar Mantenimiento</Button>
}
@if (isOfficial && currentStatus == Sapphire2025Models.Common.TrainStatus.Unknown)
{
	<Button Class="btn btn-outline-secondary" @onclick="@sendToCorrective">Enviar a correctivo</Button>
}
@if (isEngineer && readyForStandStill)
{
	<Button Class="btn btn-outline-danger" @onclick="@sendToStandStill">Stand Still</Button>
}
@if (isEngineer && currentStatus == Sapphire2025Models.Common.TrainStatus.StandStill)
{
	<Button Class="btn btn-outline-primary" @onclick="@sendToCorrective">Reactivar</Button>
	<Button Class="btn btn-outline-secondary" @onclick="@sendToDisabled">Baja definitiva</Button>
}
@if (isEngineer && currentStatus == Sapphire2025Models.Common.TrainStatus.Disabled)
{
	<Button Class="btn btn-outline-primary" @onclick="@sendToStandStill">Reconstruir</Button>
}
<Button Class="btn btn-outline-secondary" @onclick="@onAddNote">
	<span><Sapphire2025.Icons.Actions.WriteNote color="gray" />Nota</span>
</Button>
@code {
	//Esto es una barra de comandos para cambiar a los trenes de estado.
	//Dependiendo de los permisos del usuario actual y del estado del tren,
	//aparecerán unos botones u otros.
	private SessionModel? mvarSession{ get; set; }	
	[Parameter]
	public TrainModel? Train{ get; set; } //A partir de este modelo obtenemos el último estado del tren

	protected override void OnParametersSet()
	{
		base.OnParametersSet();
		mvarSession = mvarInteractive.SessionInfo;
	}
	private bool isRoot { get => null == mvarSession ? false : mvarSession.Roles.Contains(Sapphire2025Models.Common.UserRole.Root); }
	private bool isOfficial { get => isRoot || (null == mvarSession ? false : mvarSession.Roles.Contains(Sapphire2025Models.Common.UserRole.Mechanic)); }
	private bool isMechanic{ get => isOfficial ||( null == mvarSession ? false : mvarSession.Roles.Contains(Sapphire2025Models.Common.UserRole.Mechanic)); }	
	private bool isExpert { get => isRoot || (null == mvarSession ? false : mvarSession.Roles.Contains(Sapphire2025Models.Common.UserRole.Expert)); }
	private bool isInspector { get => isRoot || (null == mvarSession ? false : mvarSession.Roles.Contains(Sapphire2025Models.Common.UserRole.Inspector)); }	
	private bool isEngineer { get => isRoot || (null == mvarSession ? false : mvarSession.Roles.Contains(Sapphire2025Models.Common.UserRole.Engineer)); }
	private bool trainInCirculation
	{
		get => currentStatus == Sapphire2025Models.Common.TrainStatus.Available ||
			currentStatus == Sapphire2025Models.Common.TrainStatus.DepotAvailable ||
			currentStatus == Sapphire2025Models.Common.TrainStatus.DepotRequested ||
			currentStatus == Sapphire2025Models.Common.TrainStatus.RequestToDiagnose;
	}
	private bool trainActive
	{
		get => trainInCirculation ||
			currentStatus == Sapphire2025Models.Common.TrainStatus.Repairing ||
			currentStatus == Sapphire2025Models.Common.TrainStatus.Maintenance ||
		currentStatus == Sapphire2025Models.Common.TrainStatus.RequestToRepair;
	}
	private bool readyForStandStill
	{
		get => currentStatus == Sapphire2025Models.Common.TrainStatus.Repairing ||
				currentStatus == Sapphire2025Models.Common.TrainStatus.Maintenance;
	}
	private Sapphire2025Models.Common.TrainStatus currentStatus
	{
		get => null == Train ? Sapphire2025Models.Common.TrainStatus.Unknown : Train.lastStatus;
	}
	private async Task onAddNote()
	{
		if(null!=Train)
			mvarNavigationManager.NavigateTo($"/addnote/{Train.id}/2");
	}
	/// <summary>
	/// El tren ha sido diagnosticado y el inspector decide enviarlo a reparar.
	/// o bien... el tren se ha dado de alta y necesita una revisión antes de estar disponible.
	/// </summary>
	private async Task sendToCorrective()
	{
		if(null!=Train)
		{
			if (await mvarAeneasClient.commitTrainStatus(Train.id, Sapphire2025Models.Common.OperationType.BeginCorrective))
				endCommand();
		}
	}
	/// <summary>
	/// El tren ha terminado su reparación y reingresa al servicio activo.
	/// </summary>
	private async Task sendToAvailable()
	{
		if (null != Train)
		{
			if (await mvarAeneasClient.commitTrainStatus(Train.id, Sapphire2025Models.Common.OperationType.EndCorrective))
				endCommand();
		}
	}
	/// <summary>
	/// Un tren que está disponible es solicitado por talleres para realizar un mantenimiento.
	/// </summary>
	private async Task requestMaintenance()
	{
		if (null != Train)
		{
			if (await mvarAeneasClient.commitTrainStatus(Train.id, Sapphire2025Models.Common.OperationType.DepotRequest))
				endCommand();
		}
	}
	private async Task acceptSendToMaintenance()
	{
		if (null != Train)
		{
			if (await mvarAeneasClient.commitTrainStatus(Train.id, Sapphire2025Models.Common.OperationType.DepotRequestAccept))
				endCommand();
		}
	}
	private async Task rescueFromMaintenance()
	{
		if (null != Train)
		{
			if (await mvarAeneasClient.commitTrainStatus(Train.id, Sapphire2025Models.Common.OperationType.MaintenanceRescue))
				endCommand();
		}
	}
	private async Task undoSendToMaintenance()
	{
		if (null != Train)
		{
			if (await mvarAeneasClient.commitTrainStatus(Train.id, Sapphire2025Models.Common.OperationType.DepotRequestDeny))
				endCommand();
		}
	}
	private async Task sendToMaintenance()
	{
		if (null != Train)
		{
			if (await mvarAeneasClient.commitTrainStatus(Train.id, Sapphire2025Models.Common.OperationType.BeginMaintenance))
				endCommand();
		}
	}
	private async Task endMaintenance()
	{
		if (null != Train)
		{
			if (await mvarAeneasClient.commitTrainStatus(Train.id, Sapphire2025Models.Common.OperationType.EndMaintenance))
				endCommand();
		}
	}
	private async Task openFailureReport()
	{
		if (null != Train)
		{
			if(await mvarAeneasClient.openFailReport(Train))
			{
				mvarNavigationManager.NavigateTo($"/addnote/{Train.id}/1");
			}
		}
	}
	private async Task diagnoseToFault()
	{
		if(null!= Train)
		{
			if (await mvarAeneasClient.commitTrainStatus(Train.id, Sapphire2025Models.Common.OperationType.DiagnoseToFault))
				endCommand();
		}
	}
	private async Task diagnoseToAvailable()
	{
		if (null != Train)
		{
			if (await mvarAeneasClient.commitTrainStatus(Train.id, Sapphire2025Models.Common.OperationType.DiagnoseToAvailable))
				endCommand();
		}
	}
	private async Task sendToStandStill()
	{
		if (null != Train)
		{
			if (await mvarAeneasClient.commitTrainStatus(Train.id, Sapphire2025Models.Common.OperationType.SendToStandStill))
				endCommand();
		}
	}
	private async Task sendToDisabled()
	{
		if(null!=Train)
		{
			if (await mvarAeneasClient.commitTrainStatus(Train.id, Sapphire2025Models.Common.OperationType.SendToDisabled))
				endCommand();
		}
	}
	private void endCommand()
	{
		StateHasChanged();
		mvarNavigationManager.NavigateTo($"/trainFlow");
	}
}
