@using Sapphire2025Models.GMao
@using Sapphire2025Models
@inject AeneasClient mvarAeneasClient
@inject NavigationManager mvarNavigationManager
@inject IntStorageService mvarIntStorage
<ModalDialog @ref="mvarConfirmationDialog" OnClose="OnConfirmClose" />
<div class="btn-toolbar mb-3" role="toolbar" aria-label="Opciones del tren">
	<div class="btn-group me-2" role="group" aria-label="Operaciones primarias">
		@foreach(TrainCommand cmd in Commands)
		{
			<TrainCommandButton Command="@cmd"/>
		}
	</div>
</div>
@code {
	//Esto es una barra de comandos para cambiar a los trenes de estado.
	//Dependiendo de los permisos del usuario actual y del estado del tren,
	//aparecerán unos botones u otros.
	private SessionModel? mvarSession{ get; set; }	
	[CascadingParameter]
	public TrainModel? Train{ get; set; } //A partir de este modelo obtenemos el último estado del tren
	private ModalDialog? mvarConfirmationDialog;
	private TaskCompletionSource<bool>? mvarConfirmTcs;
	private IEnumerable<WorkOrderModel> mcolPendants = new List<WorkOrderModel>();

	private async Task<bool> ConfirmAsync(string title, string text, string okLabel="Aceptar", string cancelLabel ="Cancelar")
	{
		mvarConfirmTcs = new TaskCompletionSource<bool>();
		if (null != mvarConfirmationDialog && null!=Train)
			await mvarConfirmationDialog.show(title, text, okLabel, cancelLabel);

		return await mvarConfirmTcs.Task;
	}
	private Task OnConfirmClose(bool result)
	{
		mvarConfirmTcs?.TrySetResult(result);
		return Task.CompletedTask;
	}

	protected async override Task OnParametersSetAsync()
	{
		await base.OnParametersSetAsync();
		mvarSession = await mvarIntStorage.GetSessionInfo();
		if (null != Train)
			mcolPendants = await mvarAeneasClient.PendantWorks(Train.id, true);
	}

	private bool HasPendantWork => mcolPendants.Any();

	private bool HasPendantWash => mcolPendants.Where(x => x.WorkType == Common.WorkOrderTypeManualWash ||
									x.WorkType == Common.WorkOrderTypePlatformWash ||
									x.WorkType == Common.WorkOrderTypeTunnelWash).Any();

	private bool HasRequestedWash => mcolPendants.Where(x => (x.WorkType == Common.WorkOrderTypeManualWash ||
									x.WorkType == Common.WorkOrderTypePlatformWash ||
									x.WorkType == Common.WorkOrderTypeTunnelWash) && null== x.OpenTime).Any();

	private bool HasOpenWash => mcolPendants.Where(x => (x.WorkType == Common.WorkOrderTypeManualWash ||
									x.WorkType == Common.WorkOrderTypePlatformWash ||
									x.WorkType == Common.WorkOrderTypeTunnelWash) && null== x.CloseTime).Any();


	private List<TrainCommand> Commands
	{
		get
		{
			List<TrainCommand> salida = new List<TrainCommand>();
			if (isOfficial && currentStatus == Common.TrainStatus.Unknown)
			{
				salida.Add(new TrainCommand
				{
					Label = "Iniciar Nuevo Tren",
					Action = sendToCorrective,
					IconId = "StatusRepairing",
					IconColor = "gray",
					Enabled = true
				});
			}
			else
			{
				if (trainInCirculation || isAnonymous)
				{
					salida.Add(new TrainCommand
					{
						Label = "Parte de Incidencia",
						Action = openFailureReport,
						IconId = "AddReport",
						IconColor = "gray"
					});
				}
				if (isOfficial || isExpert)
				{
					if (currentStatus == Common.TrainStatus.RequestToDiagnose)
					{
						salida.Add(new TrainCommand
						{
							Label = "Material Disponible",
							Action = diagnoseToAvailable,
							IconId = "StatusAvailable",
							IconColor = "gray",
							Enabled = !HasPendantWork
						});
						salida.Add(new TrainCommand
						{
							Label = "Retirar",
							Action = diagnoseToFault,
							Style = "outline-warning",
							IconId = "StatusAvailable",
							IconColor = "yellow",
							Enabled = !HasPendantWork
						});
					}
				}
				if (isStation)
				{
					if (currentStatus == Common.TrainStatus.RequestToRepair)
					{
						salida.Add(new TrainCommand
						{
							Label = "Retirar a Reparar",
							Action = sendToCorrective,
							Style = "outline-warning",
							IconId = "StatusRepairing",
							IconColor = "yellow",
							Enabled = !HasPendantWork
						});
					}
				}
				if (isMechanic)
				{
					if (currentStatus == Common.TrainStatus.Repairing)
					{
						salida.Add(new TrainCommand
						{
							Label = "Reparación Terminada",
							Action = sendToAvailable,
							Style = "outline-success",
							IconId = "StatusAvailable",
							IconColor = "green",
							Enabled = !HasPendantWork
						});
					}
					if (currentStatus == Common.TrainStatus.Available)
					{
						salida.Add(new TrainCommand
						{
							Label = "Solicitar Preventivo",
							Action = requestMaintenance,
							IconId = "StatusDepotRequested",
							IconColor = "gray",
							Enabled = !HasPendantWork
						});
					}
					if (!HasPendantWork)
					{
						salida.Add(new TrainCommand
						{
							Label = "Manual",
							Action = requestManualWash,
							IconId = "Wash",
							IconColor = "#a02020",
							Enabled = true
						});
						salida.Add(new TrainCommand
						{
							Label = "Andén",
							Action = requestPlatformWash,
							IconId = "Wash",
							IconColor = "#a0a020",
							Enabled = true
						});
					}
				}
				if ((isMechanic || isStation) && !HasPendantWork)
				{
					salida.Add(new TrainCommand
					{
						Label = "Túnel",
						Action = requestTunnelWash,
						IconId = "Wash",
						IconColor = "#2020a0",
						Enabled = true
					});
				}
				if(isStation && HasPendantWash)
				{
					salida.Add(new TrainCommand
					{
						Label = "Iniciar Lavado",
						Action = AcceptWashRequest,
						Style = "outline-success",
						IconId = "Wash",
						IconColor = "green",
						Enabled = true
					});
					salida.Add(new TrainCommand
					{
						Label = "Rechazar Lavado",
						Action = DenyWashRequest,
						Style = "outline-danger",
						IconId = "Wash",
						IconColor = "red",
						Enabled = true
					});
				}
				if ((isMechanic || isStation) && HasPendantWash)
				{
					salida.Add(new TrainCommand
					{
						Label = "Fin",
						Action = requestWashingEnd,
						IconId = "Wash",
						Style = "outline-success",
						IconColor = "green",
						Enabled = true
					});
				}
				if (isOfficial && currentStatus == Common.TrainStatus.DepotRequested)
				{
					salida.Add(new TrainCommand
					{
						Label = "Anular Solicitud Preventivo",
						Action = undoSendToMaintenance,
						IconId = "StatusAvailable",
						Style = "warning",
						IconColor = "yellow",
						Enabled = !HasPendantWork
					});
				}
				if (isStation)
				{
					salida.Add(new TrainCommand
					{
						Label = "Retirar (Mantenimiento)",
						Action = acceptSendToMaintenance,
						IconId = "StatusDepotAvailable",
						IconColor = "gray",
						Enabled = !HasPendantWork && currentStatus == Common.TrainStatus.DepotRequested
					});
				}
				if (isMechanic)
				{
					salida.Add(new TrainCommand
					{
						Label = "Ceder a Circulación",
						Action = rescueFromMaintenance,
						IconId = "StatusAvailable",
						Style = "outline-warning",
						IconColor = "gray",
						Enabled = !HasPendantWork && currentStatus == Common.TrainStatus.DepotAvailable
					});
					salida.Add(new TrainCommand
					{
						Label = "Preventivo",
						Action = sendToMaintenance,
						IconId = "StatusMaintenance",
						IconColor = "gray",
						Enabled = !HasPendantWork && currentStatus == Common.TrainStatus.DepotAvailable
					});
					salida.Add(new TrainCommand
					{
						Label = "Finalizar Preventivo",
						Action = endMaintenance,
						IconId = "StatusAvailable",
						IconColor = "green",
						Enabled = !HasPendantWork && currentStatus == Common.TrainStatus.Maintenance
					});
				}
				if(isEngineer)
				{
					if(readyForStandStill)
					{
						salida.Add(new TrainCommand
						{
							Label = "Stand-Still",
							Action = sendToStandStill,
							IconId = "StatusStandStill",
							Style = "outline-danger",
							IconColor = "red",
							Enabled = !HasPendantWork
						});
					}
					if(currentStatus== Common.TrainStatus.StandStill)
					{
						salida.Add(new TrainCommand
						{
							Label = "Reactivar",
							Action = sendToCorrective,
							IconId = "StatusRepairing",
							Style = "outline-primary",
							IconColor = "blue",
							Enabled = !HasPendantWork
						});
						salida.Add(new TrainCommand
						{
							Label = "Baja Definitiva",
							Action = sendToDisabled,
							IconId = "StatusDisabled",
							IconColor = "gray",
							Enabled = true
						});
					}
					if(currentStatus==Common.TrainStatus.Disabled)
					{
						salida.Add(new TrainCommand
						{
							Label = "Rehabilitar",
							Action = sendToStandStill,
							IconId = "StatusStandStill",
							IconColor = "gray",
							Enabled = true
						});
					}

				}
				if (trainInCirculation || isAnonymous)
				{
					salida.Add(new TrainCommand
					{
						Label = "Nota",
						Action = onAddNote,
						IconId = "WriteNote",
						IconColor = "gray"
					});
				}
			}
			return salida;
		}
	}	

	private bool isAnonymous { get => Sapphire2025Models.Utils.isAnonymous(mvarSession); }
	private bool isStation { get => Sapphire2025Models.Utils.isStation(mvarSession); }
	private bool isMechanic { get => Sapphire2025Models.Utils.isMechanic(mvarSession); }
	private bool isOfficial { get => Sapphire2025Models.Utils.isOfficial(mvarSession); }
	private bool isInspector { get => Sapphire2025Models.Utils.isInspector(mvarSession); }
	private bool isExpert { get => Sapphire2025Models.Utils.isExpert(mvarSession); }
	private bool isEngineer { get => Sapphire2025Models.Utils.isEngineer(mvarSession); }

	private bool trainInCirculation
	{
		get => currentStatus == Sapphire2025Models.Common.TrainStatus.Available ||
			currentStatus == Sapphire2025Models.Common.TrainStatus.DepotAvailable ||
			currentStatus == Sapphire2025Models.Common.TrainStatus.DepotRequested ||
			currentStatus == Sapphire2025Models.Common.TrainStatus.RequestToDiagnose;
	}
	private bool trainActive
	{
		get => trainInCirculation ||
			currentStatus == Sapphire2025Models.Common.TrainStatus.Repairing ||
			currentStatus == Sapphire2025Models.Common.TrainStatus.Maintenance ||
		currentStatus == Sapphire2025Models.Common.TrainStatus.RequestToRepair;
	}
	private bool readyForStandStill
	{
		get => currentStatus == Sapphire2025Models.Common.TrainStatus.Repairing ||
				currentStatus == Sapphire2025Models.Common.TrainStatus.Maintenance;
	}
	private Sapphire2025Models.Common.TrainStatus currentStatus
	{
		get => null == Train ? Sapphire2025Models.Common.TrainStatus.Unknown : Train.lastStatus;
	}
	private async Task onAddNote()
	{
		if(null!=Train)
			if(isMechanic)
				mvarNavigationManager.NavigateTo($"/addnote/{Train.id}/3");
			else
				mvarNavigationManager.NavigateTo($"/addnote/{Train.id}/2");
	}
	/// <summary>
	/// El tren ha sido diagnosticado y el inspector decide enviarlo a reparar.
	/// o bien... el tren se ha dado de alta y necesita una revisión antes de estar disponible.
	/// </summary>
	private async Task sendToCorrective()
	{
		System.Diagnostics.Debug.Assert(null != Train);
		bool confirmado = await ConfirmAsync(
			"Confirmar acción",
			$"¿Quiere retirar la UT {Train.name} de la circulación para que el personal de taller la repare?");
		if (!confirmado) return;
		if (await mvarAeneasClient.commitTrainStatus(Train.id, Sapphire2025Models.Common.OperationType.BeginCorrective))
			endCommand();
	}
	/// <summary>
	/// El tren ha terminado su reparación y reingresa al servicio activo.
	/// </summary>
	private async Task sendToAvailable()
	{
		System.Diagnostics.Debug.Assert(null != Train);
		bool confirmado = await ConfirmAsync(
			"Confirmar acción",
			$"¿Quiere devolver la UT {Train.name} a la circulación por haber terminado los trabajos del correctivo?");
		if (!confirmado) return;
		if (await mvarAeneasClient.commitTrainStatus(Train.id, Sapphire2025Models.Common.OperationType.EndCorrective))
			endCommand();
	}
	/// <summary>
	/// Un tren que está disponible es solicitado por talleres para realizar un mantenimiento.
	/// </summary>
	private async Task requestMaintenance()
	{
		System.Diagnostics.Debug.Assert(null != Train);
		bool confirmado = await ConfirmAsync(
			"Confirmar acción",
			$"Quiere solicitar la UT {Train.name} al Inspector de Operaciones para pasarla a preventivo?");
		if (!confirmado) return;
		if (await mvarAeneasClient.commitTrainStatus(Train.id, Sapphire2025Models.Common.OperationType.DepotRequest))
			endCommand();
	}
	private async Task requestManualWash()
	{
		System.Diagnostics.Debug.Assert(null != Train);
		bool confirmado = await ConfirmAsync(
			$"Lavado de {Train.name}",
			$"¿Quiere solicitar un lavado manual del tren {Train.name}?");
		if (!confirmado) return;

		await mvarAeneasClient.createWorkOrder(Sapphire2025Models.Common.WorkOrderTypeManualWash,
		null,
		Train.id);
		endCommand();
	}
	private async Task requestPlatformWash()
	{
		System.Diagnostics.Debug.Assert(null != Train);
		bool confirmado = await ConfirmAsync(
			$"Lavado de {Train.name}",
			$"¿Quiere solicitar un lavado en el andén del tren {Train.name}?");
		if (!confirmado) return;

		await mvarAeneasClient.createWorkOrder(Sapphire2025Models.Common.WorkOrderTypePlatformWash,
		null,
		Train.id);
		endCommand();
	}
	private async Task requestTunnelWash()
	{
		System.Diagnostics.Debug.Assert(null != Train);
		bool confirmado = await ConfirmAsync(
			$"Lavado de {Train.name}",
			$"¿Quiere solicitar el paso del tren {Train.name} por el túnel de lavado?");
		if (!confirmado) return;

		await mvarAeneasClient.createWorkOrder(Sapphire2025Models.Common.WorkOrderTypeTunnelWash,
null,
Train.id);
		endCommand();
	}
	private async Task requestWashingEnd()
	{
		System.Diagnostics.Debug.Assert(null != Train);
		bool confirmado = await ConfirmAsync(
			$"Lavado de {Train.name}",
			$"¿Confirma que quiere finalizar el lavado de este tren?");
		if (!confirmado) return;

		await mvarAeneasClient.TerminateWashing(Train.id);
		endCommand();
	}
	private async Task AcceptWashRequest()
	{
		System.Diagnostics.Debug.Assert(null != Train);
		bool confirmado = await ConfirmAsync(
			$"Lavado de {Train.name}",
			$"¿Autoriza el inicio del lavado?");
		if (!confirmado) return;

		//TODO: Inicio del proceso de lavado en AeneasClient.
		endCommand();
	}
	private async Task DenyWashRequest()
	{
		System.Diagnostics.Debug.Assert(null != Train);
		bool confirmado = await ConfirmAsync(
			$"Lavado de {Train.name}",
			$"¿Quiere denegar la petición de lavado?");
		if (!confirmado) return;

		//TODO: Transacción de denegación de lavado.
		endCommand();
	}
	private async Task acceptSendToMaintenance()
	{
		System.Diagnostics.Debug.Assert(null != Train);
		bool confirmado = await ConfirmAsync(
			"Confirmar acción",
			$"Va a retirar la UT {Train.name} de la circulación para que el personal de taller realice operaciones de mantenimiento. ¿Está de acuerdo?");
		if (!confirmado) return;
		if (await mvarAeneasClient.commitTrainStatus(Train.id, Sapphire2025Models.Common.OperationType.DepotRequestAccept))
			endCommand();
	}
	private async Task rescueFromMaintenance()
	{
		System.Diagnostics.Debug.Assert(null != Train);
		bool confirmado = await ConfirmAsync(
			"Confirmar acción",
			$"¿Quiere ceder temporalmente la UT {Train.name} a Inspección de Operaciones? (La UT {Train.name} seguirá asignada para preventivo hasta que taller termine los trabajos)");
		if (!confirmado) return;
		if (await mvarAeneasClient.commitTrainStatus(Train.id, Sapphire2025Models.Common.OperationType.MaintenanceRescue))
			endCommand();
	}
	private async Task undoSendToMaintenance()
	{
		System.Diagnostics.Debug.Assert(null != Train);
		bool confirmado = await ConfirmAsync(
			"Confirmar acción",
			$"¿Quiere anular la solicitud de mantenimiento para la UT {Train.name}? (Se reincorporará al servicio y figurará como \"Disponible\")");
		if (!confirmado) return;
		if (await mvarAeneasClient.commitTrainStatus(Train.id, Sapphire2025Models.Common.OperationType.DepotRequestDeny))
			endCommand();
	}
	private async Task sendToMaintenance()
	{
		System.Diagnostics.Debug.Assert(null != Train);
		bool confirmado = await ConfirmAsync(
			"Confirmar acción",
			$"¿Quiere empezar o reanudar los trabajos de mantenimiento en la UT {Train.name}?");
		if (!confirmado) return;
		if (await mvarAeneasClient.commitTrainStatus(Train.id, Sapphire2025Models.Common.OperationType.BeginMaintenance))
			endCommand();
	}
	private async Task endMaintenance()
	{
		System.Diagnostics.Debug.Assert(null != Train);
		bool confirmado = await ConfirmAsync(
			"Confirmar acción",
			$"¿Quiere dar por finalizados los trabajos de mantenimiento y declarar la UT {Train.name} como \"apta\" para la circulación?");
		if (!confirmado) return;
		if (await mvarAeneasClient.commitTrainStatus(Train.id, Sapphire2025Models.Common.OperationType.EndMaintenance))
			endCommand();
	}
	private async Task openFailureReport()
	{
		if (null != Train)
		{
			mvarNavigationManager.NavigateTo($"/addnote/{Train.id}/1");
		}
	}
	private async Task diagnoseToFault()
	{
		System.Diagnostics.Debug.Assert(null != Train);
		bool confirmado = await ConfirmAsync(
			"Confirmar acción",
			$"Usted va a solicitar a Inspección de Operaciones que aparten la UT {Train.name} cuando sea posible. ¿Quiere proceder?");
		if (!confirmado) return;
		if (await mvarAeneasClient.commitTrainStatus(Train.id, Sapphire2025Models.Common.OperationType.DiagnoseToFault))
			endCommand();
	}
	private async Task diagnoseToAvailable()
	{
		System.Diagnostics.Debug.Assert(null != Train);
		bool confirmado = await ConfirmAsync(
			"Confirmar acción",
			$"Usted considera que la UT {Train.name} puede seguir disponible. ¿De acuerdo?");
		if (!confirmado) return;
		if (await mvarAeneasClient.commitTrainStatus(Train.id, Sapphire2025Models.Common.OperationType.DiagnoseToAvailable))
			endCommand();
	}
	private async Task sendToStandStill()
	{
		System.Diagnostics.Debug.Assert(null != Train);
		bool confirmado = await ConfirmAsync(
			"Confirmar acción",
			$"Va a cambiar la UT {Train.name} a Stand Still. ¿Seguro que quiere proceder?",
			"Sí, continuar");
		if (!confirmado) return;
		if (await mvarAeneasClient.commitTrainStatus(Train.id, Sapphire2025Models.Common.OperationType.SendToStandStill))
			endCommand();
	}
	private async Task sendToDisabled()
	{
		System.Diagnostics.Debug.Assert(null != Train);
		bool confirmado = await ConfirmAsync(
			"Confirmar acción",
			$"Va a dar de baja definitivamente la UT {Train.name}. ¿Seguro que quiere proceder?",
			"Sí, dar de baja");
		if (!confirmado) return;
		if (await mvarAeneasClient.commitTrainStatus(Train.id, Sapphire2025Models.Common.OperationType.SendToDisabled))
			endCommand();
	}
	private void endCommand()
	{
		StateHasChanged();
		mvarNavigationManager.NavigateTo($"/trainFlow");
	}
}
