@if(null!=StatusChanges)
{
	<div class="overflow-auto" style="max-height:@(Height-10)vh;">
		<table class="table table-bordered table-sm align-middle mb-0">
			<thead class="table-secondary text-light">
				<tr>
					<th class ="col-1" style="min-width: 64px; cursor:pointer;" @onclick="@(() => sortFields(0))">
						<Sapphire2025.Icons.Headers.TrainStatus color="white" />
					</th>
					<th class="col-2" style="min-width: 160px; cursor:pointer;" @onclick="@(() => sortFields(1))">
						<Sapphire2025.Icons.Headers.EventDateTime color="white" />
					</th>
					<th class="col-2" style="min-width: 160px; cursor:pointer;" @onclick="@(() => sortFields(2))">
						<Sapphire2025.Icons.Headers.User color="white" />
					</th>
					<th class="col-2" style="cursor:pointer;" @onclick="@(() => sortFields(3))">						
					</th>
				</tr>
			</thead>
			<tbody>
				@foreach (StatusChangeModel changeModel in StatusChanges)
				{
					<StatusChangeRow changeModel="changeModel" userModel="@userFromStatus(changeModel)" />
				}
			</tbody>
		</table>
	</div>
}
@code {
	[CascadingParameter]
	public Dictionary<Guid,UserModelBase>? Users { get; set; }
	[Parameter]
	public IEnumerable<StatusChangeModel>? StatusChanges { get; set; }
	[Parameter]
	public int Height{ get; set; }
	[Parameter]
	public int Width{ get; set; }

	private UserModelBase? userFromStatus(StatusChangeModel rhs)
	{
		if(null!=Users && Guid.Empty!=rhs.userId)
		{
			if (Users.ContainsKey(rhs.userId))
				return Users[rhs.userId];
		}
		return null;
	}

	private void sortFields(int rhs)
	{
		//TODO: Rellenar con código para ordenar.
	}
}
