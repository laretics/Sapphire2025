@using Sapphire2025.Icons.Headers
@using Sapphire2025.Icons
@if(null!=StatusChanges)
{
	<div class="table-responsive" style="height:100%; max-height:70vh;">
		<table class="table table-bordered table-sm align-middle mb-0 w-100">
			<thead class="table-secondary text-light">
				<tr>
					<th class ="col-2" style="min-width: 100px; cursor:pointer;" @onclick="@(() => sortFields(0))">
						<TrainStatus color="white" />
					</th>
					<th class="col-2" style="min-width: 100px; cursor:pointer;" @onclick="@(() => sortFields(1))">
						<EventDateTime color="white" />
					</th>
					<th class="col-2" style="min-width: 100px; cursor:pointer;">
		
					</th>
					<th class="col-2" style="min-width: 100px; cursor:pointer;" @onclick="@(() => sortFields(2))">
						<User color="white" />
					</th>
				</tr>
			</thead>
			<tbody>
				@if(null!=StatusChanges)
				{
					foreach(StatusChangeModel change in StatusChanges)
					{
						TimeSpan? delta = null;
						UserModelBase? auxUser = userFromStatus(change);
						if(null!=prevChange)
						{
							delta = prevChange.timeStamp.Subtract(change.timeStamp);
						}
						<tr>
							<td style="border-right:1px solid #dee2e6;">
								<span>
									<Sapphire2025.Icons.Status.IcoStatus status="@change.status" color="black" />									
								</span>
								@change.description
							</td>
							<td>
								@Sapphire2025Models.Utils.autoDate(change.timeStamp)
							</td>
							<td>
								@if(null!=delta)
								{
									@Sapphire2025Models.Utils.autoInterval((TimeSpan)delta,false);	
								}								
							</td>
							<td>
								@if(null!=auxUser)
								{
									<span>
                                        <RoleIcon Credentials="auxUser.CredentialKey" Color="gray"></RoleIcon>
									</span>
									@auxUser.Name
								}
							</td>
						</tr>
						prevChange = change;
					}
				}
			</tbody>
		</table>
	</div>
}
@code {
	[CascadingParameter]
	public Dictionary<Guid,UserModelBase>? Users { get; set; }
	[Parameter]
	public IEnumerable<StatusChangeModel>? StatusChanges { get; set; }
	private StatusChangeModel? prevChange { get; set; } = null;


	private UserModelBase? userFromStatus(StatusChangeModel rhs)
	{
		if(null!=Users && Guid.Empty!=rhs.userId)
		{
			if (Users.ContainsKey(rhs.userId))
				return Users[rhs.userId];
		}
		return null;
	}

	private void sortFields(int rhs)
	{
		//TODO: Rellenar con código para ordenar.
	}
}
