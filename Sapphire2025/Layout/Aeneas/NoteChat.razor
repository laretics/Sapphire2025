@using Sapphire2025Models
@inject AeneasClient mvarAeneasClient
@inject IntStorageService mvarIntStorage
<div style="height: 80vh; overflow-y: auto;" class="bg-light rounded p-3">
	@if(null==mcolNotes)
	{
		<h3>...</h3>
	}
	else
	{
		<CascadingValue Value="Users">
			@foreach (NoteModel note in mcolNotes)
			{
				<NoteChatEntry Note="@note"
							   LastValidNoteTime="@mvarLastValidNoteTime"
							   OnLabelRequested="OpenLabelAsync" />
			}
		</CascadingValue>
	}
</div>
<NoteLabelDialog @ref="mvarLabelDialog" OnSaved="OnNoteLabeled" />

@code {
	///El noteChat es un documento que muestra las entradas de texto (y en un futuro gráficos)
	///correspondientes a un determinado tren, junto con sus horas de suceso.
	///Es una especie de bitácora mostrada en un tono desenfadado que permite
	///asimilar la información de una manera más amena. <summary>
	/// El noteChat es un documento que muestra las entradas de texto (y en un futuro gráficos)
	[Parameter]
	public Guid Parent { get; set; } = Guid.Empty; //Guid del padre de las notas	
	[Parameter]
	public string NoteType { get; set; } = "0"; //Tipo de nota que se va a mostrar en este chat
	[Parameter]
	public int MaxLines { get; set; } = 30; //Máximo de líneas a mostrar en el chat
	[CascadingParameter]
	public Dictionary<Guid, UserModelBase>? Users { get; set; }
	private List<NoteModel>? mcolNotes = new List<NoteModel>();
	private bool mvarCanLabel;
	private DateTime mvarLastValidNoteTime = DateTime.MinValue;
	private NoteLabelDialog? mvarLabelDialog;

	protected async override Task OnInitializedAsync()
	{
		SessionModel? session = await mvarIntStorage.GetSessionInfo();
		mvarCanLabel = Utils.isOfficial(session);
		int take = mvarCanLabel ? 0 : MaxLines;
		mcolNotes = await mvarAeneasClient.retrieveNotes(Parent, NoteType, take);
		RefreshLastValid();
	}

	private void RefreshLastValid()
	{
		mvarLastValidNoteTime = mcolNotes is { Count: > 0 }
			? mcolNotes.Where(n => n.IsValid).Select(n => n.TimeStamp).DefaultIfEmpty(DateTime.MinValue).Max()
			: DateTime.MinValue;
	}

	private async Task OpenLabelAsync(NoteModel note)
	{
		if (mvarLabelDialog is null)
			return;
		bool hasOlderUnlabeled = mcolNotes is not null &&
			mcolNotes.Any(n => !n.IsValid && n.Id != note.Id && n.TimeStamp > mvarLastValidNoteTime && n.TimeStamp < note.TimeStamp);
		await mvarLabelDialog.ShowAsync(note, hasOlderUnlabeled);
	}

	private void OnNoteLabeled(NoteModel labeled)
	{
		NoteModel? existing = mcolNotes?.FirstOrDefault(n => n.Id == labeled.Id);
		if (existing is not null)
		{
			existing.IsValid = true;
			existing.IsSymptom = labeled.IsSymptom;
			existing.SystemAffected = labeled.SystemAffected;
		}
		RefreshLastValid();
	}
}
