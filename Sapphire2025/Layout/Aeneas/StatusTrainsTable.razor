@inherits TrainModelTable
@if (null != base.Trains)
{
	<div class="row border-bottom border-top bg-secondary text-light flex-nowrap" style="margin: 0;">
		<div class="col-@anchos[1].ToString() border-end justify-content-center align-items-center"
		onclick="@(()=>sortFields(1))"
		style="min-width: 100px;">
			<Sapphire2025.Icons.Headers.UT color="white" />
		</div>
		<div class="col-@anchos[2].ToString() border-end justify-content-center align-items-center"
		onclick="@(()=>sortFields(0))"
		style="min-width: 200px;">
			<Sapphire2025.Icons.Headers.EventDateTime color="white" />
		</div>
		<div class="col-@anchos[3].ToString() border-end justify-content-center align-items-center"
			 onclick="@(()=>sortFields(0))"
			 style="min-width: 200px;">
			<Sapphire2025.Icons.Headers.User color="white" />
		</div>
		<div class="col-@anchos[4].ToString() border-end justify-content-center align-items-center"
			 style="min-width: 100px;">
			<Sapphire2025.Icons.Actions.AddReport Color="white" />
		</div>
	</div>
	<div class="overflow-auto flex-nowrap" style="height:@(Height - 10)vh; overflow-y: auto; width: @Width%">
		@foreach (TrainModel train in mcolTrains)
		{			
			<TrainModelRow Train="@train" 
				User="@userFromTrain(train)" 
				ShowStatus="false"
				ColWidth="@anchos"/>
		}
	</div>
}

@code {
	[CascadingParameter]
	public Sapphire2025Models.Common.TrainStatus Status { get; set; }

	private int[] anchos = { 0, 2, 2, 3, 5 };

	protected override void OnParametersSet()
	{
		base.OnParametersSet();
		//Carga la lista con los trenes en un determinado estado.
		mcolTrains.Clear();
		if (null != Trains)
		{
			foreach (TrainModel auxTren in Trains)
			{
				if (auxTren.lastStatus.Equals(Status))
					mcolTrains.Add(auxTren);
			}
			sortFields(1);
		}
	}

}
