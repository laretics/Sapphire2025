@using Sapphire2025.Icons
@using Sapphire2025.Pages.Authentication
@inject IntStorageService mvarClientStorage
@inject InteractiveService mvarInteractive
@inject UserPreferencesService mvarPrefs
@implements IDisposable
@inherits LayoutComponentBase

<SessionWatchdog/>
<CascadingValue Value="Session">
    <div class="page">
        <div class="sidebar-backdrop" id="sidebarBackdrop" onclick="closeMobileSidebar()"></div>

        <nav class="sidebar d-flex flex-column flex-shrink-0 position-fixed" id="appSidebar">
            <div class="sidebar-brand">
                <div class="sidebar-brand-text">
                    <h3 class="logo-text fw-bold mb-0">Zafiro</h3>
                    <small class="logo-subtext fw-bold">
                        @Sapphire2025Models.Common.SapphireSoftwareVersion
                    </small>
                </div>
                <button class="sidebar-pin-btn" type="button" onclick="toggleSidebar()" title="@mvarPrefs.T("nav.pin")" aria-label="@mvarPrefs.T("nav.pin")">
                    <span class="pin-on" aria-hidden="true">
                        <GenIcon Name="PinOn" Size="20" Color="#c8f0fa" />
                    </span>
                    <span class="pin-off" aria-hidden="true">
                        <GenIcon Name="PinOff" Size="20" Color="#c8f0fa" />
                    </span>
                </button>
            </div>

            <div class="nav flex-column flex-grow-1" style="overflow-y: auto;">
                <NexusNav/>
            </div>

            <div class="mt-auto">
                <CurrentUserInfo/>
            </div>
        </nav>

        <main class="main-content">
            <div class="mobile-topbar">
                <button type="button" class="mobile-menu-btn" onclick="openMobileSidebar()" aria-label="@mvarPrefs.T("nav.open")">
                    ☰
                </button>
                <NavHistoryButtons CssClass="compact" IconSize="22" />
                <span class="mobile-topbar-title">Zafiro</span>
            </div>
            <div class="app-nav-chrome">
                <NavHistoryButtons />
            </div>
            <ContextualHelpButton />
            <button type="button" class="zen-exit" onclick="zafiroExitZen()" title="@mvarPrefs.T("nav.exitzen")" aria-label="@mvarPrefs.T("nav.exitzen")">
                <GenIcon Name="Collapse" Size="18" Color="currentColor" />
            </button>
            <div class="container-fluid px-0 px-sm-2">
                @Body
            </div>
        </main>
        <script>
            function isMobileNav() {
                return window.matchMedia('(max-width: 991.98px)').matches;
            }

            function zafiroSetZen(on) {
                document.body.classList.toggle('app-zen', !!on);
            }

            function zafiroExitZen() {
                zafiroSetZen(false);
                try {
                    const cur = document.fullscreenElement || document.webkitFullscreenElement;
                    const ext = document.exitFullscreen || document.webkitExitFullscreen;
                    if (cur && ext) ext.call(document);
                } catch (e) { }
            }

            function zafiroEnterZen() {
                zafiroSetZen(true);
                try {
                    const el = document.documentElement;
                    const req = el.requestFullscreen || el.webkitRequestFullscreen;
                    if (req && !document.fullscreenElement && !document.webkitFullscreenElement)
                        req.call(el).catch(function () { });
                } catch (e) { }
            }

            if (!window.zafiroZenBound) {
                window.zafiroZenBound = true;
                window.zafiroExitZen = zafiroExitZen;
                document.addEventListener('keydown', function (e) {
                    if (e.key !== 'F11' && e.code !== 'F11') return;
                    e.preventDefault();
                    if (document.body.classList.contains('app-zen')) zafiroExitZen();
                    else zafiroEnterZen();
                }, true);
                document.addEventListener('fullscreenchange', function () {
                    if (!document.fullscreenElement) zafiroSetZen(false);
                });
                document.addEventListener('webkitfullscreenchange', function () {
                    if (!document.webkitFullscreenElement) zafiroSetZen(false);
                });
            }

            function toggleSidebar() {
                const sidebar = document.getElementById('appSidebar') || document.querySelector('.sidebar');
                if (!sidebar) return;
                if (isMobileNav()) {
                    if (sidebar.classList.contains('mobile-open')) closeMobileSidebar();
                    else openMobileSidebar();
                    return;
                }
                sidebar.classList.toggle('collapsed');
                try {
                    localStorage.setItem('zafiro.sidebarCollapsed', sidebar.classList.contains('collapsed') ? '1' : '0');
                } catch (e) { }
            }

            function applySidebarPin() {
                const sidebar = document.getElementById('appSidebar') || document.querySelector('.sidebar');
                if (!sidebar || isMobileNav()) return;
                try {
                    if (localStorage.getItem('zafiro.sidebarCollapsed') === '1')
                        sidebar.classList.add('collapsed');
                } catch (e) { }
            }
            applySidebarPin();

            function openMobileSidebar() {
                const sidebar = document.getElementById('appSidebar') || document.querySelector('.sidebar');
                const backdrop = document.getElementById('sidebarBackdrop');
                if (!sidebar) return;
                sidebar.classList.add('mobile-open');
                if (backdrop) backdrop.classList.add('visible');
                document.body.style.overflow = 'hidden';
            }

            function closeMobileSidebar() {
                const sidebar = document.getElementById('appSidebar') || document.querySelector('.sidebar');
                const backdrop = document.getElementById('sidebarBackdrop');
                if (sidebar) sidebar.classList.remove('mobile-open');
                if (backdrop) backdrop.classList.remove('visible');
                document.body.style.overflow = '';
            }

            // Cerrar menú móvil al navegar (clic en enlaces del sidebar)
            document.addEventListener('click', function (e) {
                if (!isMobileNav()) return;
                const link = e.target.closest && e.target.closest('.sidebar a, .sidebar .sidebar-link');
                if (link) closeMobileSidebar();
            });

            window.addEventListener('resize', function () {
                if (!isMobileNav()) closeMobileSidebar();
            });
        </script>
    </div>
</CascadingValue>
@code {
    public SessionModel? Session{ get; set; }
    protected async override Task OnInitializedAsync()
    {
        mvarInteractive.OnChange += HandleHasChangedSync;
        mvarPrefs.Changed += OnPrefsChanged;
        await base.OnInitializedAsync();
        await mvarPrefs.LoadLocalAsync();
        SessionModel? sessionInfo = await mvarClientStorage.GetSessionInfo();
        if(null!=sessionInfo)
        {
            Session = sessionInfo;
            await mvarPrefs.LoadFromServerAsync();
        }
    }

    public void Dispose()
    {
        mvarInteractive.OnChange -= HandleHasChangedSync;
        mvarPrefs.Changed -= OnPrefsChanged;
    }

    private void OnPrefsChanged(object? sender, EventArgs e) => InvokeAsync(StateHasChanged);
    private void UpdateSession(SessionModel? newSession)
    {
        if (null == newSession) Session = null;
        else
        {
            Session = new SessionModel
                {
                    Token = newSession.Token,
                    User = newSession.User,
                    Roles = newSession.Roles
                };
        }
    }
    private void HandleHasChangedSync()
    {
        _ = HandleHasChanged();
    }
    private async Task HandleHasChanged()
    {
		SessionModel? auxModelo = await mvarClientStorage.GetSessionInfo();
		UpdateSession(auxModelo);
        if (auxModelo is not null)
            await mvarPrefs.LoadFromServerAsync();
        StateHasChanged();
    }

}
