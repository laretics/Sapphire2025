<div class="card flex-fill shadow-sm border-0 custom-card" style="min-width: 260px; max-width: 340px;">
    <img src="img/diaInspector.png" class="card-img-top" alt="@Prefs.T("card.agents")" style="object-fit: cover; height: 180px;">
    <div class="card-body">
        <h5 class="card-title fw-bold text-dark mb-2 custom-title">@Prefs.T("card.agents")</h5>
        <p class="card-text text-muted custom-comment">
            @Prefs.T("card.agents.desc")
        </p>
        <a href="/agentsctc" class="btn btn-outline-primary w-100">@Prefs.T("menu.open")</a>
    </div>
</div>
