<div class="d-flex justify-content-center align-items-center" style="height: 60vh;">
    <div class="text-center">
        <div class="spinner-border text-primary mb-3" style="width: 4rem; height: 4rem;" role="status">
            <span class="visually-hidden">@Prefs.T("common.loading")</span>
        </div>
        <div>
            <h5 class="mt-2">@ElementText...</h5>
            <p class="text-muted">@Prefs.T("common.pleasewait")</p>
        </div>
    </div>
</div>
@code {
    [Parameter] //Elemento que está cargando
    public string? ElementText{ get; set; }

}
