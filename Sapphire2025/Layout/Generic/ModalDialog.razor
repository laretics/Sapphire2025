@inject IJSRuntime mvarJs
<div class="modal fade" id="@mvarId">
	<div class="modal-dialog">
		<div class="modal-content">

			<div class="modal-header">
				<h4 class="modal-title">@mvarTitle</h4>
				<button type="button" class="btn-close" data-bs-dismiss="modal"></button>
			</div>

			<div class="modal-body">
				@mvarText
			</div>

			<div class="modal-footer">
				<button type="button" class="btn btn-danger" data-bs-dismiss="modal" @onclick="() => Close(true)">@mvarButtonLabel</button>
				<button type="button" class="btn btn-primary" data-bs-dismiss="modal" @onclick="() => Close(false)">@mvarCancelLabel</button>
			</div>
		</div>
	</div>
</div>

@code {
	private string? mvarText{ get; set; }
	private string? mvarTitle{ get; set; }
	private string? mvarButtonLabel{ get; set; }
	private string? mvarCancelLabel{ get; set; }
	[Parameter]
	public EventCallback<bool> OnClose { get; set; }
	[Parameter]
	public bool Result { get; set; }

	private string mvarId = "myModal";
	protected override void OnInitialized()
	{
		base.OnInitialized();
		mvarId = Guid.NewGuid().ToString();
    }

	public async Task show(string title, string text, string buttonContent , string cancelLabel = "Cancelar")
	{
		this.mvarText = text;
		this.mvarButtonLabel = buttonContent;
		this.mvarCancelLabel = cancelLabel;
		this.mvarTitle = title;
		StateHasChanged();
		await mvarJs.InvokeVoidAsync("showModal", mvarId);
	}
	private async Task Close(bool rhs)
	{
		Result = rhs;
		if (OnClose.HasDelegate)
			await OnClose.InvokeAsync(rhs);
	}
}
