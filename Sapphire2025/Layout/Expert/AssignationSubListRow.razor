@if(null!=AgentsView)
{
    @if(AgentsView.ShowHeader)
    {
        <tr>
            <td>
                <span style="display: flex; align-items: center;">
                    <CheckboxInput @bind-value="AgentsView.Show">+</CheckboxInput>
                    <span style="margin-left: 0.5em;">@AgentsView.Name</span>
                </span>
            </td>
        </tr>
    }
    @if(AgentsView.Show)
    {
        foreach (AgentsViewRegisterModel element in AgentsView.RegisterCollection??(new List<AgentsViewRegisterModel>()))
        {
            if (null != element)
            {
                if (element.GetType() == typeof(AgentsViewSpace))
                {
                    <AssignationSpaceRow />
                }
                else if (element is AgentsViewAgent agentRow)
                {
                    <AgentRow AgentModel="@agentRow" />
                }
                else if (element is AgentsViewContainer subList)
                {
                    <AssignationSubListRow AgentsView="@subList" />
                }
            }
        }
    }
}
@code {
    //Lista de elementos como Agentes que se muestran en una vista de gráfico de turnos.
    [Parameter]
    public AgentsViewContainer? AgentsView { get; set; }

}
