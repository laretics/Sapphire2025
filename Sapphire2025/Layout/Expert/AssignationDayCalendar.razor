@inject ExpertClient mvarExpertClient

@if(null==Users)
{
	<LoadingTab ElementText="Cargando lista de usuarios"/>
}
else if(null==TimeSlice)
{
	<LoadingTab ElementText="Cargando información de fecha" />
}
else if (null == ColAssignations)
{
	<LoadingTab ElementText="Cargando asignaciones de turnos" />
}
else if(mcolTemplates.Length<1)
{
	<ErrorTab Description="No hay turnos disponibles: La colección está vacía"
			  Instructions="Asegúrese de tener definido al menos un plan de explotación en una fecha anterior a la mostrada" />
}
else
{
	<div class="row">
		<div class="col-12">
			<div class="d-flex flex-row flex-wrap gap-3 gap-md-4 justify-content-start assignation-day-scroll">
				@for (int col = 0; col <= mcolTemplates.GetUpperBound(0); col++)
				{
					<div class="table-responsive flex-fill assignation-day-col">
						<table class="table table-bordered text-center custom-width-table mb-0">
							<thead class="table-light">
								<tr>
									<th>Turno</th>
									<th>Asignación</th>
								</tr>
							</thead>
							<tbody>
								@for (int row = 0; row <= mcolTemplates.GetUpperBound(1); row++)
								{
									@if (null != mcolTemplates[col, row])
									{
										var template = mcolTemplates[col, row];
										var assignations = AssignationsByTemplate(template.Name);
										bool unassignedDriving = IsUnassignedDrivingShift(template, assignations);
										<tr class="@(unassignedDriving ? "assignation-row-unassigned" : null)">
											<td class="cell-content custom-cell text-center align-middle @(unassignedDriving ? "assignation-unassigned" : null)"
												style="@GetCellStyle(template, unassignedDriving)">
												<div class="cell-content-inner">
													<span>@GetCellText(template)</span>
													<span class="smallest-text @(unassignedDriving ? "assignation-unassigned-time" : null)">@GetCellTime(template)</span>
													@if (!unassignedDriving)
													{
														<div class="cell-bar"
																style="@GetBarStyle(template)" />
													}
												</div>
											</td>
											<td class="@(unassignedDriving ? "assignation-unassigned" : null)"
												style="@GetAssignationStyle(template, unassignedDriving)">
												@if (unassignedDriving)
												{
													<div class="assignation-unassigned-label" title="Turno de conducción sin asignar">
														¡DESCUBIERTO!
													</div>
												}
												else
												{
													<table>
														@foreach (AssignationContentModel assignation in assignations)
														{
															<tr>
																<td style="@GetAgentStyle(assignation.AgentId)">
																	<AgentScheduleLink AgentId="assignation.AgentId" />
																</td>
															</tr>
														}
													</table>
												}
											</td>
										</tr>
									}
								}
							</tbody>
						</table>
					</div>
				}
			</div>
		</div>
	</div>
}

@code {
	private DateTime? mvarLastDisplayedDate;
	private readonly Dictionary<Guid, WorkShiftTemplateModel?> mcolTodayAgentTemplates = new();

	[CascadingParameter] //Diccionario de usuarios a representar
	public Dictionary<Guid, UserModelBase>? Users { get; set; }
	[CascadingParameter] //Rodaja de días.
	public Sapphire2025Models.Expert.WorkshiftTemplates.PlansYearSlice? TimeSlice { get; set; }
	[CascadingParameter] //Asignaciones del gráfico
	public List<AssignationContentModel>? ColAssignations { get; set; }
	[CascadingParameter]
	public List<WorkShiftTemplateModel>? SortedTemplates{ get; set; }
	[CascadingParameter]
	public TimeSpan mvarNow { get; set; }
	[CascadingParameter(Name = "WipeOff")]
	public bool WipeOff { get; set; }
	[CascadingParameter(Name = "FollowingMode")]
	public bool FollowingMode { get; set; }
	[Parameter]
	public int MinutesBeforeWorksheet { get; set; }
	[Parameter]
	public int MinutesAfterWorksheet { get; set; }

	private WorkShiftTemplateModel[,] mcolTemplates { get; set; } = new WorkShiftTemplateModel[0, 0];

	private WorkShiftTemplateCollectionModel? mvarPlan;

	protected async override Task OnParametersSetAsync()
	{
		ComposeArray();
		DateTime? displayedDate = TimeSlice?.InitialDate.Date;
		if (mvarLastDisplayedDate == displayedDate) return;

		mvarLastDisplayedDate = displayedDate;
		mcolTodayAgentTemplates.Clear();

		//Sólo cargaremos las asignaciones de hoy, si las asignaciones que se muestran son futuras
		if(displayedDate.HasValue && displayedDate.Value>DateTime.Today)
		{
			PlansYearSlice? todaySlice = await mvarExpertClient.PlansTimeSlice(DateTime.Today);
			List<AssignationContentModel>? todayAssignations = await mvarExpertClient.Assignations(DateTime.Today);

			if(null!=todaySlice && null!=todayAssignations)
			{
				WorkShiftTemplateCollectionModel? todayPlan = todaySlice.GetPlan(0);
				if(null!=todayPlan)
				{
					foreach(AssignationContentModel todayAssignation in todayAssignations)
					{
						if (string.IsNullOrWhiteSpace(todayAssignation.Definitive))
							continue;

						WorkShiftTemplateModel? template =
							todayPlan.Template(
								todayAssignation.Definitive,
								todaySlice.GetDay(0),
								todaySlice.GetFestive(0));

						// Solo turnos de trabajo reales (no DD, D, licencias, vacaciones, etc.)
						if (template is AttTemplateModel)
							mcolTodayAgentTemplates[todayAssignation.AgentId] = template;
					}
				}

			}
		}

	}

	public string GetAgentStyle(Guid agentId)
	{
		//Si no es una fecha futura, no se pinta nada
		if (null == TimeSlice || TimeSlice.InitialDate.Date <= DateTime.Today)
			return string.Empty;

		// Solo negrita si hoy tiene un turno de trabajo (AttTemplateModel).
		if (!mcolTodayAgentTemplates.TryGetValue(agentId, out WorkShiftTemplateModel? template)
			|| template is not AttTemplateModel)
			return string.Empty;

		//Ponemos en negrita a todos los que trabajan hoy.
		string style = "font-weight: 700;";

		//Ponemos el mismo estado que tengan ahora mismo.
		string? statusStyle = GetTodayStatusStyle(template);
		if (string.IsNullOrWhiteSpace(statusStyle))
			return style;

		return $"{style} {statusStyle}";
	}
	private string GetTodayStatusStyle(WorkShiftTemplateModel? rhs)
	{
		if(!FollowingMode)
			return string.Empty;

		if (rhs is not AttTemplateModel AttTurno)
			return string.Empty;

		TimeSpan horaComienzo = AttTurno.StartTime.Add(TimeSpan.FromMinutes(MinutesBeforeWorksheet));
		TimeSpan horaDeje = AttTurno.EndTime.Add(TimeSpan.FromMinutes(-MinutesAfterWorksheet));

		string? color = null;

		if (mvarNow >= AttTurno.StartTime && mvarNow < horaComienzo)
			color = "#A8F0AD"; // Verde
		else if (mvarNow >= horaComienzo && mvarNow < horaDeje)
			color = "#8B9DFF"; // Azul
		else if (mvarNow >= horaDeje && mvarNow < AttTurno.EndTime)
			color = "#FC92AC"; // Rojo

		return string.IsNullOrWhiteSpace(color)
			? string.Empty
			: $"background: linear-gradient(to right, {color}, transparent);";
	}


	public List<AssignationContentModel> AssignationsByTemplate(string? assignationText)
	{
		List<AssignationContentModel> salida = new List<AssignationContentModel>();
		if (null != ColAssignations && null != assignationText)
			salida = ColAssignations
			.Where(xx => xx.Definitive == assignationText)
			.ToList();

		return salida;
	}

	/// <summary>
	/// Turno de conducción (Work o Att con trenes) sin ningún maquinista asignado.
	/// </summary>
	private bool IsUnassignedDrivingShift(WorkShiftTemplateModel? template, List<AssignationContentModel> assignations)
	{
		if (null == template) return false;
		if (assignations.Count > 0) return false;
		return IsDrivingShift(template);
	}

	private static bool IsDrivingShift(WorkShiftTemplateModel template)
	{
		if (template is WorkTemplateModel)
			return true;
		if (template is AttTemplateModel att && null != att.Content)
			return att.Content.Any(c => c is TrainWorkShiftContentModel tw
				&& !string.IsNullOrWhiteSpace(tw.TrainId));
		return false;
	}

	private bool IsToday()
	{
		return (null != TimeSlice && TimeSlice.InitialDate.Date == DateTime.Today);
	}

	private string GetCellStyle(WorkShiftTemplateModel? rhs, bool unassignedDriving = false)
	{
		if (unassignedDriving)
			return "background: #dc2626; color: #ffffff;";

		string auxColor = "black";
		string auxFondo = "transparent";
		if (null != rhs)
		{
			auxColor = rhs.Color ?? "black";
			auxFondo = rhs.BgColor ?? "transparent";
		}
		return string.Format("background: {1}; color: {0};", auxColor, auxFondo);
	}
	private string GetAssignationStyle(WorkShiftTemplateModel? rhs, bool unassignedDriving = false)
	{
		if (unassignedDriving)
			return "background: #dc2626; color: #ffffff;";

		string salida = "transparent";
		if (IsToday() && FollowingMode)
		{
			if(rhs is AttTemplateModel AttTurno)
			{
				TimeSpan horaComienzo = AttTurno.StartTime.Add(new TimeSpan(0, MinutesBeforeWorksheet, 0));
				TimeSpan horaDeje = AttTurno.EndTime.Add(new TimeSpan(0, -1 * MinutesAfterWorksheet, 0));

				if(mvarNow >= AttTurno.StartTime && 
					mvarNow < horaComienzo)
				{
					salida = salida = "#A8F0AD"; // Verde
				}
				else if(mvarNow>=horaComienzo && mvarNow< horaDeje)
				{
					salida = "#8B9DFF"; //Tren en marcha (Azul)
				}
				else if(mvarNow>=horaDeje && mvarNow < AttTurno.EndTime)
				{
					salida = "#FC92AC"; // Rojo
				}
			}
		}
		return string.Format("background: linear-gradient(to right, {0}, transparent);", salida);
	}
	private string GetCellText(WorkShiftTemplateModel? rhs)
	{
		if (null == rhs) return string.Empty;
		return rhs.Name??string.Empty;
	}
	private string GetCellTime(WorkShiftTemplateModel? rhs)
	{
		if (null == rhs) return string.Empty;

		if(rhs is AttTemplateModel auxTrabajo)
		{
			System.Text.StringBuilder auxElapsed = new System.Text.StringBuilder();
			auxElapsed.AppendFormat("{0} h", auxTrabajo.Duration.Hours);
			if(auxTrabajo.Duration.Minutes>0)
				auxElapsed.AppendFormat(" y {0} min", auxTrabajo.Duration.Minutes);

			return string.Format("{0}-{1} ({2})",
			Sapphire2025Models.Utils.autoInterval(auxTrabajo.StartTime,true),
			Sapphire2025Models.Utils.autoInterval(auxTrabajo.EndTime, true),
			Sapphire2025Models.Utils.autoInterval(auxTrabajo.Duration, false));
		}
		return string.Empty;
	}
	private string GetBarStyle(WorkShiftTemplateModel? rhs)
	{
		return string.Format("background: {0};", rhs?.StripeColor ?? "transparent");
	}
	private void ComposeArray()
	{
		if(null!=SortedTemplates)
		{
			if (SortedTemplates.Count() > 0)
			{
				//Calculamos los límites del array
				int maxX = -1;
				int maxY = -1;
				foreach (WorkShiftTemplateModel auxTemplate in SortedTemplates)
				{
					if (auxTemplate.CoorX > maxX) maxX = auxTemplate.CoorX;
					if (auxTemplate.CoorY > maxY) maxY = auxTemplate.CoorY;
				}
				mcolTemplates = new WorkShiftTemplateModel[maxX + 1, maxY + 1];
				//Rellenamos el array
				foreach (WorkShiftTemplateModel auxTemplate in SortedTemplates)
				{
					if (auxTemplate.CoorX >= 0 && auxTemplate.CoorY >= 0)
						mcolTemplates[auxTemplate.CoorX, auxTemplate.CoorY] = auxTemplate;
				}
			}
		}
	}
}
