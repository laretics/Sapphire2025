@using Sapphire2025Models.Expert.WorkshiftTemplates
@if (null==Assignation)
{
    <td class="cell-content custom-cell text-center align-middle"></td>
}
else
{
    <td class="cell-content custom-cell text-center align-middle" 
        title="@mvarCellComment"
        style="@GetCellStyle()">
        <div class="cell-content-inner">
            <span class="cell-inline-content">
                @if (mvarAssignationChanged)
                {
                    <span class="icon-svg-cycle"></span>
                }
                <span>@GetCellText()</span>
                @if(null!=mvarCellComment)
                {
                    <span class="icon-svg-document"></span>
                }                
            </span>
            @if(mvarAssignationChanged)
            {                
                <span class="smallest-text">@GetAgentChangedName()</span>
            }            
            <div class="cell-bar"
                    style="@GetBarStyle()">
            </div>
        </div>
    </td>
}

@code {
    [CascadingParameter]//Con este modo activado se representa toda la cadena de asignaciones
    public bool WholeAssignations { get; set; }
    [CascadingParameter] //Diccionario de usuarios a representar
    public Dictionary<Guid, UserModelBase>? Users { get; set; }
    [CascadingParameter]//Rodaja de tiempo
    public Sapphire2025Models.Expert.WorkshiftTemplates.PlansYearSlice? TimeSlice{ get; set; }
    [Parameter] //Asignación concreta para esta celda.
    public AssignationContentModel? Assignation { get; set; }
    [Parameter]
    public int DayId{ get; set; }

    private WorkShiftTemplateModel? mvarTemplate = null;
    private bool mvarAssignationChanged{ get; set; }
    private string? mvarCellComment{ get; set; }

    protected override void OnInitialized()
    {
        base.OnInitialized();
        if(null!=TimeSlice)
        {
            WorkShiftTemplateCollectionModel? auxPlan = TimeSlice.GetPlan(DayId);
            if (null != auxPlan && null != Assignation && null!=Assignation.Definitive)
            {
                mvarTemplate = auxPlan.Template(Assignation.Definitive, TimeSlice.GetDay(DayId), TimeSlice.GetFestive(DayId));
                mvarAssignationChanged = HasChange();
                mvarCellComment = GetCellComment();
            }
        }
    }
    private string? GetCellComment()
    {
        if(null!=Assignation)
        {
            if (null!=Assignation.Comment && Assignation.Comment.Length>0)
                return Assignation.Comment;
        }
        return null;
    }
    private string GetCellStyle()
    {
        string auxColor = "black";
        string auxBackgroundColor = "transparent";
        if(null==mvarTemplate)
        {
            //Tenemos una asignación, pero no hemos encontrado un turno en este plan.
            //Mostraremos la asignación en colores que sean fáciles de distinguir.
            auxColor = "white";
            auxBackgroundColor = "red";
        }
        else
        {
            auxColor = mvarTemplate.Color ?? "black";
            auxBackgroundColor = mvarTemplate.BgColor ?? "transparent";
            if (null != Assignation)
            {
                if (Assignation.TD) auxColor = "#00CC00"; //Color del TD
            }
        }
        return string.Format("background: {1}; color: {0};", auxColor, auxBackgroundColor);
    }
    private string GetCellText()
    {
        if (null != Assignation)
        {
            if (WholeAssignations)
                return Assignation.AssignationsChain ?? "";
            else
                return Assignation.Definitive ?? "";
        }        
        return "";
    }
    private string GetBarStyle()
    {
        return string.Format("background: {0};", mvarTemplate?.StripeColor ?? "transparent");
    }
    private bool HasChange()
    {
        if (null != Assignation)
            return Assignation.SwappingAgent != Guid.Empty;
        return false;
    }
    private string GetAgentChangedName()
    {
        string salida = "T.Cambiado";
        if(null!=Users && null!=Assignation)
        {
            if (Users.ContainsKey(Assignation.SwappingAgent))
                salida= Users[Assignation.SwappingAgent].Name ?? "T.Cambiado";
        }
        if (salida.Length > 16)
            salida = salida.Substring(0, 16) + "...";
        return salida;
    }
}
