@using Sapphire2025Models.Expert.WorkshiftTemplates
@if (null==Assignation)
{
    <td class="cell-content custom-cell text-center align-middle"></td>
}
else
{
    <td class="cell-content custom-cell text-center align-middle"
        style="@GetCellStyle()">
        <div class="cell-content-inner">
            <span>@GetCellText()</span>
            <div class="cell-bar"
                 style="@GetBarStyle()">
            </div>
        </div>
    </td>
}

@code {
    [CascadingParameter]//Con este modo activado se representa toda la cadena de asignaciones
    public bool WholeAssignations { get; set; }
    [Parameter] //Asignación concreta para esta celda.
    public AssignationContentModel? Assignation { get; set; }
    [Parameter]
    public WorkShiftTemplateCollectionModel? Plan{ get; set; }
    [Parameter]
    public DateTime Day{ get; set; }
    [Parameter]
    public bool Festive { get; set; }

    private WorkShiftTemplateModel? mvarCurrentTemplate;

    protected override void OnInitialized()
    {
        mvarCurrentTemplate = GetTemplate();
        base.OnInitialized();
    }

    /// <summary>
    /// Obtiene un turno concreto en función del offset y de la fecha de comienzo.
    /// </summary>
    /// <param name="offset"></param>
    /// <returns>El template del turno elegido</returns>
    private WorkShiftTemplateModel? GetTemplate()
    {
        if(null!=Plan && null!=Plan.Templates && null!=Assignation &&null!=Assignation.Definitive)
        {
            return Plan.Template(Assignation.Definitive, Day, Festive);
        }
        return null;
    }
    private string GetCellStyle()
    {
        string auxColor = "black";
        if (null != mvarCurrentTemplate)
        {
            auxColor = mvarCurrentTemplate.Color ?? "black";
            if (null != Assignation)
            {
                if (Assignation.TD) auxColor = "#00CC00"; //Color del TD
            }
        }
        return string.Format("background: {1}; color: {0};", auxColor, mvarCurrentTemplate?.BgColor ?? "transparent");
    }
    private string GetCellText()
    {
        if (null != Assignation)
        {
            if (WholeAssignations)
                return Assignation.AssignationsChain ?? "";
            else
                return Assignation.Definitive ?? "";
        }        
        return "";
    }
    private string GetBarStyle()
    {
        return string.Format("background: {0};", mvarCurrentTemplate?.StripeColor ?? "transparent");
    }
}
