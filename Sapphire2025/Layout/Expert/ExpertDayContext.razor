@using Sapphire2025Models.Expert.WorkshiftTemplates
@inject ExpertClient mvarExpertClient
@inject AuthenticationClient mvarAuthClient
@inject IntStorageService mvarIntStorage
@inject IJSRuntime mvarJSRuntime
<ModalDialog></ModalDialog>
<InputFile style="display:none" @ref="mvarCBExcelInputRef" OnChange="onExcelImport" MaxAllowedSize="5242880" accept=".xlsx" />
@if(mvarExcelImporting)
{
    <LoadingTab ElementText="Importando Gráfico Excel" />
}
else if(mvarDataProcessing)
{
    <LoadingTab ElementText="Procesando Información" />
}
else
{
    <CascadingValue Value="Users">
        <CascadingValue Value="Assignations">            
                <CascadingValue Value="TimeSlice">
                    <CascadingValue Value="mvarCurrentDate">
                        <div class="row">
                            <div class="col-md-6">
                                <Sapphire2025.Layout.Expert.DateTimePicker @bind-SelectedDate="selectedDate">
                                </Sapphire2025.Layout.Expert.DateTimePicker>
                                <div class="mb-3 mt-3 d-flex gap-2 align-items-center flex-wrap">
                                <div class="btn-group" role="group" aria-label="Opciones">
                                    @if(ExcelImportFeature)
                                    {
                                        <button class="btn btn-outline-secondary" title="Importar gráfico"
                                            @onclick="() => TriggerFileInputBlazor(mvarCBExcelInputRef)"
                                        >
                                            <!-- upload icon -->
                                            <svg width="1.2em" height="1.2em" viewBox="0 0 32 32" xmlns="http://www.w3.org/2000/svg">
                                                <path d="M28.781,4.405H18.651V2.018L2,4.588V27.115l16.651,2.868V26.445H28.781A1.162,1.162,0,0,0,30,25.349V5.5A1.162,1.162,0,0,0,28.781,4.405Zm.16,21.126H18.617L18.6,23.642h2.487v-2.2H18.581l-.012-1.3h2.518v-2.2H18.55l-.012-1.3h2.549v-2.2H18.53v-1.3h2.557v-2.2H18.53v-1.3h2.557v-2.2H18.53v-2H28.941Z" style="fill:#20744a;fill-rule:evenodd" /><rect x="22.487" y="7.439" width="4.323" height="2.2" style="fill:#20744a" /><rect x="22.487" y="10.94" width="4.323" height="2.2" style="fill:#20744a" /><rect x="22.487" y="14.441" width="4.323" height="2.2" style="fill:#20744a" /><rect x="22.487" y="17.942" width="4.323" height="2.2" style="fill:#20744a" /><rect x="22.487" y="21.443" width="4.323" height="2.2" style="fill:#20744a" /><polygon points="6.347 10.673 8.493 10.55 9.842 14.259 11.436 10.397 13.582 10.274 10.976 15.54 13.582 20.819 11.313 20.666 9.781 16.642 8.248 20.513 6.163 20.329 8.585 15.666 6.347 10.673" style="fill:#ffffff;fill-rule:evenodd" />
                                            </svg>
                                        </button>
                                    }
                                    <button type="button"
                                            class="btn @(WipeOff ? "btn-secondary active" : "btn-outline-secondary")"
                                            @onclick="() => auxToggleOption(nameof(WipeOff))"
                                            title="Desaparecer contenido">
                                        <!-- eye-off icon -->
                                        <svg xmlns="http://www.w3.org/2000/svg" height="1.2em" viewBox="0 0 24 24" width="1.2em" fill="currentColor">
                                            <path d="M12 6a9.77 9.77 0 0 1 8.94 6A9.77 9.77 0 0 1 12 18a9.77 9.77 0 0 1-8.94-6A9.77 9.77 0 0 1 12 6m0-2C6.48 4 2 8.48 2 12s4.48 8 10 8 10-4.48 10-8-4.48-8-10-8zm0 4a4 4 0 0 1 4 4c0 .88-.36 1.68-.93 2.25l1.42 1.42A5.98 5.98 0 0 0 18 12c0-3.31-2.69-6-6-6zm-4.93 2.25A3.98 3.98 0 0 1 6 12c0 3.31 2.69 6 6 6 1.31 0 2.52-.42 3.5-1.13l-1.42-1.42A3.98 3.98 0 0 1 12 16a4 4 0 0 1-4-4c0-.88.36-1.68.93-2.25z" />
                                        </svg>
                                    </button>
                                    <button type="button"
                                            class="btn @(FollowingMode ? "btn-secondary active" : "btn-outline-secondary")"
                                            @onclick="() => auxToggleOption(nameof(FollowingMode))"
                                            title="Modo seguimiento">
                                        <!-- bolt icon -->
                                        <svg xmlns="http://www.w3.org/2000/svg" height="1.2em" viewBox="0 0 24 24" width="1.2em" fill="currentColor">
                                            <path d="M7 2v11h3v9l7-12h-4l4-8z" />
                                        </svg>
                                    </button>
                                    <button type="button"
                                            class="btn @(HasProgressBar ? "btn-secondary active" : "btn-outline-secondary")"
                                            @onclick="() => auxToggleOption(nameof(HasProgressBar))"
                                            title="Barras de progreso">
                                        <!-- bar chart icon -->
                                        <svg xmlns="http://www.w3.org/2000/svg" height="1.2em" viewBox="0 0 24 24" width="1.2em" fill="currentColor">
                                            <path d="M5 9.2V19h2V9.2H5zm6 3.6V19h2v-6.2h-2zm6-7.2V19h2V5.6h-2z" />
                                        </svg>
                                    </button>
                                </div>
@*                                     <div class="form-check form-switch">
                                        <input class="form-check-input" type="checkbox" id="festiveSwitch" checked="@isFestive" @onchange="OnFestiveChanged" />
                                        <label class="form-check-label" for="festiveSwitch">
                                            Festivo
                                        </label>
                                    </div> *@
                                </div>
                            </div>
                            @if(null!=Plan)
                            {
                                <div class="col-md-6">
                                    <div class="card mb-3 border-primary">
                                        <div class="card-body py-2 px-3 d-flex align-items-center gap-4">
                                            <div class="fw-bold text-primary">
                                                @(Plan?.Name ?? "Sin título")
                                            </div>
                                            <div class="text-muted">
                                                <i class="bi bi-calendar-event"></i>
                                                desde @(Plan?.Begin.ToString("dd/MM/yyyy"))
                                            </div>
                                            <div class="small text-secondary flex-fill">
                                                @(Plan?.Comment ?? "[Sin descripción]")
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    <CascadingValue Value="Plan">
                        <CascadingValue Value="SortedTemplates">
                            <CascadingValue Value="mvarNow">
                                <CascadingValue Value="FollowingMode" Name="FollowingMode">
                                    <CascadingValue Value="WipeOff" Name="WipeOff">
                                        <CascadingValue Value="HasProgressBar" Name="HasProgressBar">
                                            @ChildContent
                                        </CascadingValue>                                        
                                    </CascadingValue>
                                </CascadingValue>
                            </CascadingValue>                            
                        </CascadingValue>                        
                    </CascadingValue>
                </CascadingValue>
            </CascadingValue>
        </CascadingValue>
    </CascadingValue>
}
@code {
    [Parameter]
    public RenderFragment? ChildContent { get; set; } //Contenido de este control.
    [Parameter]
    public bool ExcelImportFeature{ get; set; } //Este control tiene la posibilidad de importar Excel
    [Parameter]
    public int ExcelImportDayCount { get; set; } = 4; //Número de días que va a importar del excel.
    public bool WipeOff{get;set;} //Activa la desaparición del contenido a medida que se consume.
    public bool FollowingMode { get; set; } //Activa el modo de seguimiento (coloreado de casillas a medida que se van activando.)
    public bool HasProgressBar { get; set; } //Barras de progreso en seguimiento
    private bool[] mcolSwitches = new bool[3];
    public Dictionary<Guid, UserModelBase>? Users;
    public List<AssignationContentModel>? Assignations;
    private WorkShiftTemplateCollectionModel? Plan;
    private List<WorkShiftTemplateModel> SortedTemplates = new List<WorkShiftTemplateModel>();
    public TimeSpan mvarNow;
    private bool isFestive = false;
    private bool mvarDataProcessing = false;
    private bool mvarExcelImporting = false; //Flag para el importador del gráfico de Agentes.
    private InputFile? mvarCBExcelInputRef;
    private ModalDialog mvarModal { get; set; } = new ModalDialog();
    private Sapphire2025Models.Expert.WorkshiftTemplates.PlansYearSlice? TimeSlice;
    private DateTime mvarCurrentDate = DateTime.Today;
    private DateTime selectedDate
    {
        get => mvarCurrentDate;
        set
        {
            mvarCurrentDate = value;
            _ = mvarIntStorage.SetInspectorReportDate(value);
            _ = UpdateData(); //Fire and forget.
        }
    }

    private System.Threading.Timer? mvarRefreshTimer;


    protected async override Task OnInitializedAsync()
    {
        mvarNow = DateTime.Now.TimeOfDay;
        WipeOff = true;
        FollowingMode = true;

        Users = await mvarAuthClient.cachedUserList();
        await auxRefresh();
        mvarRefreshTimer = new System.Threading.Timer(
            async _ =>
            {
                await InvokeAsync(() =>
                {
                    mvarNow = DateTime.Now.TimeOfDay;
                    StateHasChanged();
                });
            },
            null,
            TimeSpan.Zero,
            TimeSpan.FromSeconds(20)
        );

        await UpdateData();
    }
    private async Task auxRefresh()
    {
        Assignations = await mvarExpertClient.Assignations(selectedDate);
    }
    public void Dispose()
    {
        mvarRefreshTimer?.Dispose();
    }

    private async Task OnFestiveChanged(ChangeEventArgs e)
    {
        if (null != e.Value)
        {
            isFestive = (bool)e.Value;
            await mvarExpertClient.SetFestive(selectedDate, isFestive);
            await UpdateData();
        }
    }
    protected async Task UpdateData()
    {
        mvarDataProcessing = true;
        StateHasChanged();
        TimeSlice = await mvarExpertClient.PlansTimeSlice(selectedDate); //Rodaja de tiempos
        if (null != TimeSlice)
            isFestive = TimeSlice.GetFestive(0);
        LoadPlan();
        await auxRefresh();
        mvarDataProcessing = false;
        StateHasChanged();
    }
    private void LoadPlan()
    {
        if (null != TimeSlice)
        {
            Plan = TimeSlice.GetPlan(0);
            List<WorkShiftTemplateModel> auxSortedTemplates = new List<WorkShiftTemplateModel>();
            if (null != Plan)
                auxSortedTemplates = Plan.TemplatesByDay(TimeSlice.InitialDate, TimeSlice.GetFestive(0));

            SortedTemplates = auxSortedTemplates
            .OrderBy(xx =>
            {
                var name = xx.Name ?? "";
                // Si termina en 'F', intenta parsear el número anterior
                if (name.EndsWith("F", StringComparison.OrdinalIgnoreCase) && int.TryParse(name[..^1], out int festNum))
                    return festNum;
                // Si es solo número
                if (int.TryParse(name, out int num))
                    return num;
                // Si no es número, lo pone al final
                return int.MaxValue;
            })
            .ThenBy(xx => xx.Name)
            .ToList();

        }
    }
    private async Task auxToggleOption(string option)
    {
        switch (option)
        {
            case nameof(WipeOff): WipeOff = !WipeOff; break;
            case nameof(FollowingMode): FollowingMode = !FollowingMode; break;
            case nameof(HasProgressBar): HasProgressBar = !HasProgressBar; break;
        }
        bool[] auxEstados = new bool[3];



    }

    private async Task OnWipeOffChanged(ChangeEventArgs e)
    {
        if (e.Value is bool value)
        {
            WipeOff = value;
            StateHasChanged();
            // Si necesitas lógica adicional, añádela aquí
        }
    }

    private async Task OnFollowingModeChanged(ChangeEventArgs e)
    {
        if (e.Value is bool value)
        {
            FollowingMode = value;
            StateHasChanged();
            // Si necesitas lógica adicional, añádela aquí
        }
    }
    private async Task OnProgressBarChanged(ChangeEventArgs e)
    {
        if(e.Value is bool value)
        {
            HasProgressBar = value;
            StateHasChanged();
        }
    }
    private async Task onExcelImport(InputFileChangeEventArgs e)
    {
        mvarExcelImporting = true;
        StateHasChanged();

        Microsoft.AspNetCore.Components.Forms.IBrowserFile archivo = e.File;

        if (null != archivo)
        {
            using Stream corriente = archivo.OpenReadStream(maxAllowedSize: 5242880); // 5 MB
            using MemoryStream ms = new MemoryStream();
            await corriente.CopyToAsync(ms);
            byte[] buffer = ms.ToArray();
            //Ahora pasamos esto a JavaScript
            DateTime fecha = DateTime.Today;
            int localZoneOffset = await GetTimezoneOffsetMinutes();
            string salida = await mvarJSRuntime.InvokeAsync<string>("excelInterop.extractWorksheetData", buffer, fecha.Month, fecha.Day, ExcelImportDayCount);
            string? salidaCompilacion = await mvarExpertClient.UploadDailyWorkShift(salida, fecha, ExcelImportDayCount, localZoneOffset);
            if (null != salidaCompilacion && salidaCompilacion.Length > 0)
                await mvarModal.show("Error de importación", salidaCompilacion, "Salir");
        }
        await auxRefresh();
        mvarExcelImporting = false;
        StateHasChanged();
    }
    private async Task<int> GetTimezoneOffsetMinutes()
    {
        return await mvarJSRuntime.InvokeAsync<int>("eval", "new Date().getTimezoneOffset()");
    }
    private async Task TriggerFileInputBlazor(InputFile? rhs)
    {
        if (null != rhs)
            await mvarJSRuntime.InvokeVoidAsync("triggerFileInputClick", rhs.Element);
    }
}