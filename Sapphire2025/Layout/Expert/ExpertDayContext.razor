@using Sapphire2025Models.Expert.WorkshiftTemplates
@inject ExpertClient mvarExpertClient
@inject AuthenticationClient mvarAuthClient
@inject IntStorageService mvarIntStorage
@inject NavigationManager mvarNavigationManager
@inject IJSRuntime mvarJSRuntime
<ModalDialog></ModalDialog>
<InputFile style="display:none" @ref="mvarCBExcelInputRef" OnChange="onExcelImport" MaxAllowedSize="5242880" accept=".xlsx" />
@if(mvarDataProcessing)
{
    <LoadingTab ElementText="@mvarProcessBarText" />
}
else
{
    <CascadingValue Value="Users">
        <CascadingValue Value="Assignations">            
                <CascadingValue Value="TimeSlice">
                    <CascadingValue Value="mvarCurrentDate">
                        <div class="row">
                            <div class="col-md-6">
                                <Sapphire2025.Layout.Expert.DateTimePicker @bind-SelectedDate="selectedDate">
                                </Sapphire2025.Layout.Expert.DateTimePicker>
                                <div class="mb-3 mt-3 d-flex gap-2 align-items-center flex-wrap">
                                <div class="btn-group" role="group" aria-label="Opciones">
                                    @if(ExcelImportFeature)
                                    {
                                        <button class="btn btn-outline-secondary" title="Importar gráfico"
                                            @onclick="() => TriggerFileInputBlazor(mvarCBExcelInputRef)"
                                        >
                                            <Sapphire2025.Icons.Actions.Upload/>
                                        </button>
                                        
                                        @if(ShowAdvancedButtons)
                                        {
                                            <input type="number" 
                                                   class="form-control form-control-sm" 
                                                   style="width: 80px;" 
                                                   @bind="StartCol" 
                                                   min="0" 
                                                   max="1024"
                                                   placeholder="Col" 
                                                   title="Columna Inicial de la hoja Excel" />
                                            
                                            <input type="number" 
                                                   class="form-control form-control-sm" 
                                                   style="width: 80px;" 
                                                   @bind="DayCount" 
                                                   min="1" 
                                                   max="16"
                                                   placeholder="Días a importar" 
                                                   title="Número de días" />
                                            
                                            <button class="btn btn-sm btn-outline-primary" 
                                                    @onclick="OnAdvancedImport"
                                                    title="Vista previa">
                                                <Sapphire2025.Icons.Actions.Upload Color="#a0a0ff"/>
                                            </button>
                                        }
                                    }
                                    @if(RealTimeFollowFeature)
                                    {
                                        <button type="button"
                                                class="btn @(WipeOff ? "btn-secondary active" : "btn-outline-secondary")"
                                                @onclick="() => auxToggleOption(nameof(WipeOff))"
                                                title="Desaparecer contenido">
                                            <Sapphire2025.Icons.Actions.Eye color="currentColor" />
                                        </button>
                                        <button type="button"
                                                class="btn @(FollowingMode ? "btn-secondary active" : "btn-outline-secondary")"
                                                @onclick="() => auxToggleOption(nameof(FollowingMode))"
                                                title="Modo seguimiento">
                                            <Sapphire2025.Icons.Actions.Exec color="currentColor" />
                                        </button>
                                        <button type="button"
                                                class="btn @(HasProgressBar ? "btn-secondary active" : "btn-outline-secondary")"
                                                @onclick="() => auxToggleOption(nameof(HasProgressBar))"
                                                title="Barras de progreso">
                                            <Sapphire2025.Icons.Actions.TimeValue Color="currentColor" />
                                        </button>
                                    }
                                    @if(PrintFeature)
                                    {
                                        <button class="btn btn-outline-secondary" title="Imprimir"
                                                @onclick="OnReportPrint">
                                            <Sapphire2025.Icons.Actions.Printer Color="currentColor" />
                                        </button>
                                    }
                                    
                                    @if(ExcelImportFeature)
                                    {
                                        <button type="button"
                                                class="btn @(ShowAdvancedButtons ? "btn-secondary active" : "btn-outline-secondary")"
                                                @onclick="() => auxToggleOption(nameof(ShowAdvancedButtons))"
                                                title="Opciones avanzadas de importación">
                                            <Sapphire2025.Icons.Commands.ThreeDots Color="currentColor" />
                                        </button>
                                    }
                                </div>
                                </div>
                            </div>
                            @if(null!=Plan)
                            {
                                <div class="col-md-6">
                                    <div class="card mb-3 border-primary">
                                        <div class="card-body py-2 px-3 d-flex align-items-center gap-4">
                                            <div class="fw-bold text-primary">
                                                @(Plan?.Name ?? "Sin título")
                                            </div>
                                            <div class="text-muted">
                                                <i class="bi bi-calendar-event"></i>
                                                desde @(Plan?.Begin.ToString("dd/MM/yyyy"))
                                            </div>
                                            <div class="small text-secondary flex-fill">
                                                @(Plan?.Comment ?? "[Sin descripción]")
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    <CascadingValue Value="Plan">
                        <CascadingValue Value="SortedTemplates">
                            <CascadingValue Value="mvarNow">
                                <CascadingValue Value="FollowingMode" Name="FollowingMode">
                                    <CascadingValue Value="WipeOff" Name="WipeOff">
                                        <CascadingValue Value="HasProgressBar" Name="HasProgressBar">
                                            @ChildContent
                                        </CascadingValue>                                        
                                    </CascadingValue>
                                </CascadingValue>
                            </CascadingValue>                            
                        </CascadingValue>                        
                    </CascadingValue>
                </CascadingValue>
            </CascadingValue>
        </CascadingValue>
    </CascadingValue>
}

@* NUEVO: Modal de ImportExcelPreview *@
@if(ShowExcelImportPreview)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Vista Previa de Importación Excel</h5>
                    <button type="button" class="btn-close" @onclick="CloseImportPreview"></button>
                </div>
                <div class="modal-body">
                    <ImportExcelPreview StartDay="@StartCol" 
                                       DayCount="@DayCount"
                                       PreviewData="@previewData"
                                       OnConfirm="@OnImportConfirmed" 
                                       OnCancel="@CloseImportPreview" />
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public RenderFragment? ChildContent { get; set; }
    [Parameter]
    public bool ExcelImportFeature{ get; set; }
    [Parameter]
    public bool RealTimeFollowFeature{ get; set; }
    [Parameter]
    public bool PrintFeature{ get; set; }
    [Parameter]
    public int ExcelImportDayCount { get; set; } = 4;

    public bool WipeOff{get;set;}
    public bool FollowingMode { get; set; }
    public bool HasProgressBar { get; set; }
    public bool ShowAdvancedButtons { get; set; } = false;
    private bool ShowExcelImportPreview { get; set; } = false;
    public int StartCol { get; set; } = 1;
    public int DayCount { get; set; } = 4;
    private List<List<ImportExcelPreview.CellData>>? previewData;

    public Dictionary<Guid, UserModelBase>? Users;
    public List<AssignationContentModel>? Assignations;
    private WorkShiftTemplateCollectionModel? Plan;
    private List<WorkShiftTemplateModel> SortedTemplates = new List<WorkShiftTemplateModel>();
    public TimeSpan mvarNow;
    private bool isFestive = false;
    private bool mvarDataProcessing = false;
    private string mvarProcessBarText = string.Empty;
    private InputFile? mvarCBExcelInputRef;
    private ModalDialog mvarModal { get; set; } = new ModalDialog();
    private Sapphire2025Models.Expert.WorkshiftTemplates.PlansYearSlice? TimeSlice;
    private DateTime mvarCurrentDate = DateTime.Today;

    private string mvarExcelImportData = string.Empty;
    private DateTime mvarExcelImportDate = DateTime.Today;

    protected async override Task OnInitializedAsync()
    {
        mvarNow = DateTime.Now.TimeOfDay;
        WipeOff = true;
        FollowingMode = true;
        StartCol = await mvarAuthClient.GetRegisterInt("ImplCol", 0);     

        Users = await mvarAuthClient.cachedUserList();
        await auxRefresh();
        mvarRefreshTimer = new System.Threading.Timer(
            async _ =>
            {
                await InvokeAsync(() =>
                {
                    mvarNow = DateTime.Now.TimeOfDay;
                    StateHasChanged();
                });
            },
            null,
            TimeSpan.Zero,
            TimeSpan.FromSeconds(20)
        );

        await UpdateData();
    }

    private DateTime selectedDate
    {
        get => mvarCurrentDate;
        set
        {
            mvarCurrentDate = value;
            _ = mvarIntStorage.SetInspectorReportDate(value);
            _ = UpdateData();
        }
    }

    private System.Threading.Timer? mvarRefreshTimer;

    private async Task auxRefresh()
    {
        Assignations = await mvarExpertClient.Assignations(selectedDate);
    }

    public void Dispose()
    {
        mvarRefreshTimer?.Dispose();
    }

    private async Task OnFestiveChanged(ChangeEventArgs e)
    {
        if (null != e.Value)
        {
            isFestive = (bool)e.Value;
            await mvarExpertClient.SetFestive(selectedDate, isFestive);
            await UpdateData();
        }
    }

    protected async Task UpdateData()
    {
        mvarDataProcessing = true;
        mvarProcessBarText = "Cargando Asignaciones de Turnos";
        StateHasChanged();        
        TimeSlice = await mvarExpertClient.PlansTimeSlice(selectedDate);
        if (null != TimeSlice)
            isFestive = TimeSlice.GetFestive(0);
        LoadPlan();
        await auxRefresh();
        mvarProcessBarText = "Cargando hoja de inspección";
        await mvarIntStorage.SetInspectorReportDate(selectedDate);
        mvarDataProcessing = false;
        StateHasChanged();
    }

    private void LoadPlan()
    {
        if (null != TimeSlice)
        {
            Plan = TimeSlice.GetPlan(0);
            List<WorkShiftTemplateModel> auxSortedTemplates = new List<WorkShiftTemplateModel>();
            if (null != Plan)
                auxSortedTemplates = Plan.TemplatesByDay(TimeSlice.InitialDate, TimeSlice.GetFestive(0));

            SortedTemplates = auxSortedTemplates
            .OrderBy(xx =>
            {
                var name = xx.Name ?? "";
                if (name.EndsWith("F", StringComparison.OrdinalIgnoreCase) && int.TryParse(name[..^1], out int festNum))
                    return festNum;
                if (int.TryParse(name, out int num))
                    return num;
                return int.MaxValue;
            })
            .ThenBy(xx => xx.Name)
            .ToList();
        }
    }

    private async Task auxToggleOption(string option)
    {
        switch (option)
        {
            case nameof(WipeOff): WipeOff = !WipeOff; break;
            case nameof(FollowingMode): FollowingMode = !FollowingMode; break;
            case nameof(HasProgressBar): HasProgressBar = !HasProgressBar; break;
            case nameof(ShowAdvancedButtons): ShowAdvancedButtons = !ShowAdvancedButtons; break; // NUEVO
        }
    }



    private async Task OnAdvancedImport()
    {
        // Mostrar el modal
        ShowExcelImportPreview = true;
        await TriggerFileInputBlazor(mvarCBExcelInputRef);
    }

    private void CloseImportPreview()
    {
        ShowExcelImportPreview = false;
        StateHasChanged();
    }



    private async Task onExcelImport(InputFileChangeEventArgs e)
    {
        mvarDataProcessing = true;
        mvarProcessBarText = "Importando de Excel";
        StateHasChanged();

        Microsoft.AspNetCore.Components.Forms.IBrowserFile archivo = e.File;

        if (null != archivo)
        {
            mvarProcessBarText = "Abriendo el archivo";
            StateHasChanged();
            using Stream corriente = archivo.OpenReadStream(maxAllowedSize: 5242880);
            using MemoryStream ms = new MemoryStream();
            DateTime fecha = DateTime.Today;
            await corriente.CopyToAsync(ms);
            byte[] buffer = ms.ToArray();                        
            mvarProcessBarText = "Extrayendo información de Excel";            
            StateHasChanged();
            mvarExcelImportData = await mvarJSRuntime.InvokeAsync<string>("excelInterop.extractWorksheetData", buffer, fecha.Month, fecha.Day, ExcelImportDayCount, StartCol);
            previewData = System.Text.Json.JsonSerializer.Deserialize<List<List<ImportExcelPreview.CellData>>>(mvarExcelImportData);            
            if(!ShowExcelImportPreview)
            {
                await OnUploadExcelToServer();
                ShowExcelImportPreview = false;
                mvarProcessBarText = "Finalizando";
                StateHasChanged();
                await auxRefresh();
                mvarDataProcessing = false;
                StateHasChanged();
            }            
        }
    }
    private async Task OnImportConfirmed()
    {
        DateTime fecha = DateTime.Today;
        ShowExcelImportPreview = false;
        StateHasChanged();
        await OnUploadExcelToServer();
        mvarProcessBarText = "Finalizando";
        StateHasChanged();
        await auxRefresh();
        mvarDataProcessing = false;
        StateHasChanged();
    }

    private async Task OnUploadExcelToServer()
    {        
        int localZoneOffset = await GetTimezoneOffsetMinutes();
        mvarProcessBarText = "Subiendo gráfico al servidor";
        StateHasChanged();
        string? salidaCompilacion = await mvarExpertClient.UploadDailyWorkShift(mvarExcelImportData, mvarExcelImportDate, ExcelImportDayCount, localZoneOffset);
        if (null != salidaCompilacion && salidaCompilacion.Length > 0)
            await mvarModal.show("Error de importación", salidaCompilacion, "Salir");
    }
    
    private async Task OnReportPrint()
    {
        await CopyAgentsReportToLocale();
        await mvarJSRuntime.InvokeVoidAsync("window.open", "/agentsprintview", "_blank");
    }

    private async Task CopyAgentsReportToLocale()
    {
    }

    private async Task<int> GetTimezoneOffsetMinutes()
    {
        return await mvarJSRuntime.InvokeAsync<int>("eval", "new Date().getTimezoneOffset()");
    }
    
    private async Task TriggerFileInputBlazor(InputFile? rhs)
    {
        if (null != rhs)
            await mvarJSRuntime.InvokeVoidAsync("triggerFileInputClick", rhs.Element);
    }
}