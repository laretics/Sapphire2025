<tr>
    <th class="header-left bg-gradient-secondary-agent">
        <div class="d-flex justify-content-between align-items-center w-100">
            <span class="cf-text">@AgentCFText()</span>
            <span class="user-name">@AgentNameText()</span>
        </div>
    </th>
    @if (null != TimeSlice)
    {
        <CascadingValue Value="WholeAssignations">
            <CascadingValue Value="TimeSlice">
                @for (int index = 0; index < TimeSlice.DayCount; index++)
                {
                    <AssignationCell Assignation="@GetAssignation(index)"
                                        DayId="@index" />                
                }
            </CascadingValue>
        </CascadingValue>
    }
</tr>
@code {
    //Esto es una fila en el calendario de asignaciones.
    [CascadingParameter] //Rodaja de días a representar.
    Sapphire2025Models.Expert.WorkshiftTemplates.PlansYearSlice? TimeSlice{ get; set; }
    [CascadingParameter] //Colección de asignaciones (de todos los Agentes)
    public List<AssignationContentModel>? ColAssignations { get; set; }
    [CascadingParameter] //Mostrar todas las asignaciones o sólo las definitivas
    public bool WholeAssignations { get; set; }
    [Parameter] //Objeto que contiene la información de este Agente.
    public Sapphire2025Models.Expert.AgentsViewAgent? AgentModel { get; set; }


    private AssignationContentModel?[] mcolAssignationsArray = new AssignationContentModel[0];

    private AssignationContentModel? GetAssignation(int index)
    {
        if(null!=mcolAssignationsArray && index>=0 && index<mcolAssignationsArray.Length)
        {
            return mcolAssignationsArray[index];            
        }
        return null;
    }

    protected override void OnInitialized()
    {
        base.OnInitialized();
        if(null!= TimeSlice)
        {
            mcolAssignationsArray = new AssignationContentModel[TimeSlice.DayCount];
            if (null != ColAssignations && null != AgentModel)
            {
                AssignationContentModel[] colAssignationsByAgent =
                ColAssignations
                .Where(xx => xx.AgentId == AgentModel.Id &&
                    xx.Date >= TimeSlice.InitialDate && xx.Date < TimeSlice.FinalDate
                    ).OrderBy(xx => xx.Date).ToArray();
                foreach (AssignationContentModel assignation in colAssignationsByAgent)
                {
                    int auxIndex = assignation.Date.Subtract(TimeSlice.InitialDate).Days;
                    System.Diagnostics.Debug.Assert(auxIndex >= 0 && auxIndex < TimeSlice.DayCount);
                    AssignationContentModel nueva = new AssignationContentModel();
                    nueva.AssignationsChain = assignation.AssignationsChain;
                    nueva.Definitive = assignation.Definitive;
                    nueva.Comment = assignation.Comment;
                    nueva.SwappingAgent = assignation.SwappingAgent;
                    nueva.TD = assignation.TD;
                    mcolAssignationsArray[auxIndex] = nueva;
                }
            }
        }
    }

    private string AgentCFText()
    {
        return AgentModel?.CF ?? "";
    }
    private string AgentNameText()
    {
        return AgentModel?.Name ?? "??";
    }
}
