<th class="header-left bg-gradient-secondary">
    <div class="d-flex justify-content-between align-items-center w-100">
        <span class="cf-text">@AgentCFText()</span>
        <span class="user-name">@AgentNameText()</span>
    </div>
</th>
<CascadingValue Value="WholeAssignations">
    @for (int index = 0; index < DayCount; index++)
    {
        <AssignationCell 
            Assignation="@mcolAssignationsArray[index]" 
            Plan="@ColPlans[index]"
            Day="@InitialDate.AddDays(index)"
            Festive = "@ColFestive[index]"
        />
    }
</CascadingValue>

@code {
    //Esto es una fila en el calendario de asignaciones.
    [Parameter] //Agente al que corresponden las asignaciones
    public UserModelBase? User { get; set; }
    [CascadingParameter] //Fecha correspondiente a la primera posición
    public DateTime InitialDate{ get; set; }
    [CascadingParameter] //Número de días consecutivos
    public int DayCount{ get; set; }
    [CascadingParameter] //Colección de asignaciones (de todos los Agentes)
    public List<WorkShiftAssignationModel>? ColAssignations { get; set; }
    [CascadingParameter] //Colección de planes vigentes cada día
    public WorkShiftTemplateCollectionModel[]? ColPlans{ get; set; }
    [CascadingParameter] //Colección de festividades laborales de cada día.
    public bool[]? ColFestive{ get; set; }
    [CascadingParameter] //Mostrar todas las asignaciones o sólo las definitivas
    public bool WholeAssignations{ get; set; }

    private AssignationContentModel?[] mcolAssignationsArray = new AssignationContentModel[0];

    protected override void OnInitialized()
    {
        base.OnInitialized();
        if (null != ColAssignations && null != User)
        {
            DateTime finalDate = InitialDate.AddDays(DayCount);
            WorkShiftAssignationModel[] colAssignationsByAgent =
            ColAssignations
            .Where(xx => xx.Agent == User.guid && 
                xx.Date>=InitialDate && xx.Date<finalDate
                ).OrderBy(xx => xx.Date).ToArray();
            mcolAssignationsArray = new AssignationContentModel[DayCount];
            foreach(WorkShiftAssignationModel assignation in ColAssignations)
            {
                int auxIndex = assignation.Date.Subtract(InitialDate).Days;
                System.Diagnostics.Debug.Assert(auxIndex >= 0 && auxIndex < DayCount);
                AssignationContentModel nueva = new AssignationContentModel();
                nueva.AssignationsChain = assignation.Assignation;
                nueva.Definitive = assignation.Definitive;
                nueva.Comment = assignation.Comment;
                nueva.SwappingAgent = assignation.SwappingAgent;
                nueva.TD = assignation.IsTD;
                mcolAssignationsArray[auxIndex] = nueva;
            }
        }        
    }

    private string AgentCFText()
    {
        return (null != User) && (null != User.CF)
            ? User.CF : string.Empty;
    }
    private string AgentNameText()
    {
        return ( null != User) && (null!= User.Name) 
        ? User.Name : string.Empty;
    }

}
