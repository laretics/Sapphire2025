@if (null == Users)
{
	<LoadingTab ElementText="Cargando lista de usuarios" />
}
else if (null == TimeSlice)
{
	<LoadingTab ElementText="Cargando información de fecha" />
}
else if (null == ColAssignations)
{
	<LoadingTab ElementText="Cargando asignaciones de turnos" />
}
else if (mcolAllDepots.Count < 1)
{
	<ErrorTab Description="No se han cargado depósitos: La colección está vacía"
			  Instructions="Asegúrese de tener definido al menos un plan de explotación en una fecha anterior a la mostrada" />
}
else
{
	<div class="depots-grid">
		@foreach (DepotSection block in Sections)
		{
			<div class="depot-section @block.CssClass">
				<header class="depot-section-header">
					<div class="depot-section-title">
						<span class="depot-section-dot" aria-hidden="true"></span>
						@block.Title
						<span class="depot-section-count">@block.Items.Count</span>
					</div>
					@if (!string.IsNullOrWhiteSpace(block.Subtitle))
					{
						<div class="depot-section-subtitle">@block.Subtitle</div>
					}
				</header>

				@if (block.Items.Count == 0)
				{
					<div class="depot-empty text-muted">@block.EmptyText</div>
				}
				else
				{
					<div class="depot-list">
						@foreach (AttWorkShiftContentModel depot in block.Items)
						{
							<div class="depot-card @DepotStatusClass(depot)" style="@DepotCardStyle(depot)">
								<div class="depot-card-main">
									<div class="depot-time-block">
										<div class="depot-time-primary">@DepotPrimaryTime(depot)</div>
										<div class="depot-time-secondary">@DepotSecondaryTime(depot)</div>
									</div>
									<div class="depot-agent-block">
										<div class="depot-agents">@RenderAssignationLinks(depot)</div>
										@if (depot.Foreign)
										{
											<span class="depot-badge depot-badge-foreign" title="Depósito fuera de residencia">Fuera</span>
										}
									</div>
								</div>
								@if (ShowProgress(depot))
								{
									<div class="depot-progress" title="Avance del depósito">
										<div class="depot-progress-bar" style="@($"width: {GetDepotProgress(depot)}%;")"></div>
									</div>
								}
							</div>
						}
					</div>
				}
			</div>
		}
	</div>
}

@code {
	[CascadingParameter]
	public Dictionary<Guid, UserModelBase>? Users { get; set; }
	[CascadingParameter]
	public Sapphire2025Models.Expert.WorkshiftTemplates.PlansYearSlice? TimeSlice { get; set; }
	[CascadingParameter]
	public List<AssignationContentModel>? ColAssignations { get; set; }
	[CascadingParameter]
	public List<WorkShiftTemplateModel>? SortedTemplates { get; set; }
	[CascadingParameter(Name = "WipeOff")]
	public bool WipeOff { get; set; }
	[CascadingParameter(Name = "FollowingMode")]
	public bool FollowingMode { get; set; }
	[CascadingParameter(Name = "HasProgressBar")]
	public bool HasProgressBar { get; set; }
	[CascadingParameter]
	public TimeSpan mvarNow { get; set; }

	/// <summary>Ventana previa al inicio en la que un depósito se considera "a punto de empezar".</summary>
	[Parameter]
	public int MinutesShortAtt { get; set; } = 25;

	/// <summary>Reservado por compatibilidad con DailyGraph (ya no clasifica por duración).</summary>
	[Parameter]
	public int MinutesLongAtt { get; set; } = 60;

	private List<AttWorkShiftContentModel> mcolAllDepots = new();
	private List<DepotSection> Sections { get; set; } = new();

	protected override void OnParametersSet()
	{
		base.OnParametersSet();
		ComposeAtts();
		BuildSections();
	}

	private void ComposeAtts()
	{
		mcolAllDepots = new List<AttWorkShiftContentModel>();
		if (null == SortedTemplates) return;

		foreach (WorkShiftTemplateModel turno in SortedTemplates)
		{
			if (AssignationsByTemplate(turno.Name).Count == 0)
				continue;

			if (turno is not AttTemplateModel attTemplate || null == attTemplate.Content)
				continue;

			foreach (WorkShiftContentModel contenido in attTemplate.Content)
			{
				if (contenido is AttWorkShiftContentModel deposito)
					mcolAllDepots.Add(deposito);
			}
		}
	}

	private void BuildSections()
	{
		IEnumerable<AttWorkShiftContentModel> visible = mcolAllDepots.Where(MustShowCell);

		if (!IsToday() || !FollowingMode)
		{
			// Día futuro/pasado o sin seguimiento: lista cronológica única.
			Sections = new List<DepotSection>
			{
				new DepotSection(
					Title: "Depósitos del día",
					Subtitle: "Ordenados por hora de inicio",
					CssClass: "depot-section-all",
					EmptyText: "No hay depósitos programados",
					Items: visible.OrderBy(d => d.StartTime).ThenBy(d => d.EndTime).ToList())
			};
			return;
		}

		List<AttWorkShiftContentModel> enCurso = visible
			.Where(IsActiveNow)
			.OrderByDescending(RemainingTime)
			.ThenBy(d => d.EndTime)
			.ToList();

		List<AttWorkShiftContentModel> proximos = visible
			.Where(IsUpcoming)
			.OrderBy(d => d.StartTime)
			.ThenByDescending(d => d.Duration)
			.ToList();

		List<DepotSection> sections = new()
		{
			new DepotSection(
				Title: "En curso",
				Subtitle: "Más tiempo restante primero — con quién puedes contar ahora",
				CssClass: "depot-section-active",
				EmptyText: "Nadie en depósito ahora mismo",
				Items: enCurso),
			new DepotSection(
				Title: "Próximos",
				Subtitle: "Disponibilidades futuras por hora de inicio",
				CssClass: "depot-section-upcoming",
				EmptyText: "No quedan depósitos por empezar",
				Items: proximos)
		};

		// Si no se ocultan los pasados, mostrarlos al final sin mezclarlos con lo operativo.
		if (!WipeOff)
		{
			List<AttWorkShiftContentModel> finalizados = visible
				.Where(IsFinished)
				.OrderByDescending(d => d.EndTime)
				.ToList();

			if (finalizados.Count > 0)
			{
				sections.Add(new DepotSection(
					Title: "Finalizados",
					Subtitle: "Depósitos ya terminados (modo no ocultar)",
					CssClass: "depot-section-done",
					EmptyText: string.Empty,
					Items: finalizados));
			}
		}

		Sections = sections;
	}

	private List<AssignationContentModel> AssignationsByTemplate(string? assignationText)
	{
		if (null == ColAssignations || null == assignationText)
			return new List<AssignationContentModel>();

		return ColAssignations
			.Where(xx => xx.Definitive == assignationText)
			.ToList();
	}

	private bool MustShowCell(AttWorkShiftContentModel? depot)
	{
		if (null == depot) return false;
		if (!IsToday()) return true;
		if (FollowingMode && WipeOff && IsFinished(depot)) return false;
		return true;
	}

	private bool IsToday()
		=> null != TimeSlice && TimeSlice.InitialDate.Date == DateTime.Today;

	private bool IsFinished(AttWorkShiftContentModel depot)
		=> IsToday() && depot.EndTime <= mvarNow;

	private bool IsActiveNow(AttWorkShiftContentModel depot)
		=> IsToday() && mvarNow >= depot.StartTime && mvarNow < depot.EndTime;

	private bool IsUpcoming(AttWorkShiftContentModel depot)
		=> !IsToday() || mvarNow < depot.StartTime;

	private bool IsAboutToStart(AttWorkShiftContentModel depot)
	{
		if (!IsToday()) return false;
		TimeSpan ventana = TimeSpan.FromMinutes(MinutesShortAtt);
		return mvarNow >= depot.StartTime.Subtract(ventana) && mvarNow < depot.StartTime;
	}

	private bool IsEndingSoon(AttWorkShiftContentModel depot)
	{
		if (!IsActiveNow(depot)) return false;
		return RemainingTime(depot).TotalMinutes <= MinutesShortAtt
			&& RemainingTime(depot).TotalMinutes > 0;
	}

	private TimeSpan RemainingTime(AttWorkShiftContentModel depot)
	{
		if (!IsToday()) return TimeSpan.Zero;

		TimeSpan salida = depot.EndTime.Subtract(mvarNow);
		if (salida < TimeSpan.Zero) return TimeSpan.Zero;
		return new TimeSpan(salida.Hours, salida.Minutes, 0);
	}

	private string DepotPrimaryTime(AttWorkShiftContentModel depot)
	{
		if (IsActiveNow(depot))
		{
			return string.Format("Queda {0}",
				Sapphire2025Models.Utils.autoInterval(RemainingTime(depot), false));
		}

		if (IsAboutToStart(depot))
		{
			TimeSpan untilStart = depot.StartTime.Subtract(mvarNow);
			if (untilStart < TimeSpan.Zero) untilStart = TimeSpan.Zero;
			untilStart = new TimeSpan(untilStart.Hours, untilStart.Minutes, 0);
			return string.Format("Empieza en {0}",
				Sapphire2025Models.Utils.autoInterval(untilStart, false));
		}

		return string.Format("{0} – {1}",
			Sapphire2025Models.Utils.autoInterval(depot.StartTime, true),
			Sapphire2025Models.Utils.autoInterval(depot.EndTime, true));
	}

	private string DepotSecondaryTime(AttWorkShiftContentModel depot)
	{
		if (IsActiveNow(depot))
		{
			return string.Format("Hasta {0} · {1} en total",
				Sapphire2025Models.Utils.autoInterval(depot.EndTime, true),
				Sapphire2025Models.Utils.autoInterval(depot.Duration, false));
		}

		return string.Format("Duración {0}",
			Sapphire2025Models.Utils.autoInterval(depot.Duration, false));
	}

	private RenderFragment RenderAssignationLinks(AttWorkShiftContentModel depot) => builder =>
	{
		if (null == depot.Parent || null == Users)
			return;

		List<AssignationContentModel> auxAssignations = AssignationsByTemplate(depot.Parent.Name);
		string turno = depot.Parent.Name ?? "?";
		int seq = 0;

		builder.OpenElement(seq++, "span");
		builder.AddContent(seq++, $"{turno} · ");

		if (auxAssignations.Count == 0)
		{
			builder.AddContent(seq++, "descubierto");
			builder.CloseElement();
			return;
		}

		for (int i = 0; i < auxAssignations.Count; i++)
		{
			if (i > 0)
				builder.AddContent(seq++, ", ");

			builder.OpenComponent<AgentScheduleLink>(seq++);
			builder.AddAttribute(seq++, "AgentId", auxAssignations[i].AgentId);
			builder.AddAttribute(seq++, "ShowCf", true);
			builder.CloseComponent();
		}
		builder.CloseElement();
	};

	private bool ShowProgress(AttWorkShiftContentModel depot)
		=> HasProgressBar && IsToday() && FollowingMode && IsActiveNow(depot);

	private int GetDepotProgress(AttWorkShiftContentModel depot)
	{
		double total = depot.Duration.TotalSeconds;
		if (total <= 0) return 0;

		double elapsed = mvarNow.Subtract(depot.StartTime).TotalSeconds;
		if (elapsed <= 0) return 0;
		if (elapsed >= total) return 100;
		return (int)Math.Round(100.0 * elapsed / total);
	}

	private string DepotStatusClass(AttWorkShiftContentModel depot)
	{
		if (!IsToday() || !FollowingMode)
			return "depot-status-neutral";

		if (IsAboutToStart(depot))
			return "depot-status-soon";
		if (IsEndingSoon(depot))
			return "depot-status-ending";
		if (IsActiveNow(depot))
			return "depot-status-active";
		if (IsFinished(depot))
			return "depot-status-done";

		return "depot-status-later";
	}

	private string DepotCardStyle(AttWorkShiftContentModel depot)
	{
		if (!IsToday() || !FollowingMode)
			return string.Empty;

		string? color = null;

		if (IsAboutToStart(depot))
			color = "#A8F0AD"; // Verde — a punto de empezar
		else if (IsActiveNow(depot))
		{
			if (IsEndingSoon(depot))
				color = "#FC92AC"; // Rojo — poco tiempo
			else
				color = "#8B9DFF"; // Azul — en curso con margen
		}

		if (string.IsNullOrWhiteSpace(color))
			return string.Empty;

		return $"background: linear-gradient(to right, {color}, transparent);";
	}

	private sealed class DepotSection
	{
		public DepotSection(string Title, string Subtitle, string CssClass, string EmptyText, List<AttWorkShiftContentModel> Items)
		{
			this.Title = Title;
			this.Subtitle = Subtitle;
			this.CssClass = CssClass;
			this.EmptyText = EmptyText;
			this.Items = Items;
		}

		public string Title { get; }
		public string Subtitle { get; }
		public string CssClass { get; }
		public string EmptyText { get; }
		public List<AttWorkShiftContentModel> Items { get; }
	}
}
