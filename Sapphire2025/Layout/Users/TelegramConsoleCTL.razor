@inject AuthenticationClient mvarAuthClient
<ModalDialog @ref="mvarModal" OnClose="OnTelegramConfirmationResponse" />
@if(null==UserModel)
{
    <LoadingTab ElementText="Cargando elementos de Telegram"/>
}
else
{
    @if (UserModel.TelegramPaired)
    {
        <EditForm Model="UserModel" OnValidSubmit="OnSendPersonalDataChanges">
            <div class="mb-3 form-check form-switch">
                <InputCheckbox @bind-Value="UserModel.TelegramEnabled" class="form-check-input" id="telegramEnabledSwitch" />
                <label class="form-check-label" for="telegramEnabledSwitch">
                    Telegram habilitado
                </label>
            </div>
            <div class="mb-3">
                <label for="telegramRules" class="form-label">Reglas del bot</label>
                <InputTextArea @bind-Value="UserModel.TelegramRules"
                               id="telegramRules"
                               class="form-control"
                               style="font-family: 'Fira Mono', 'Consolas', 'Courier New', monospace; background-color: #222; color: #0f0; min-height: 120px;" />
                <div class="form-text">Puedes editar las reglas en formato texto, como si fuera una terminal.</div>
            </div>
            <Button class="btn btn-primary" @onclick="OnSendPersonalDataChanges">Enviar</Button>
            <Button Class="btb btn-primary" @onclick="OnSendUnpairTelegram">Desconectar</Button>
        </EditForm>
    }
    else
    {
        <div class="alert alert-warning d-flex align-items-center" role="alert">
            <svg class="bi flex-shrink-0 me-2" width="24" height="24" role="img" aria-label="Warning:" fill="currentColor" viewBox="0 0 16 16">
                <use xlink:href="#exclamation-triangle-fill" />
                <symbol id="exclamation-triangle-fill" fill="currentColor" viewBox="0 0 16 16">
                    <path d="M8.982 1.566a1.13 1.13 0 0 0-1.964 0L.165 13.233c-.457.778.091 1.767.982 1.767h13.707c.89 0 1.438-.99.982-1.767L8.982 1.566zm-.982 4.905a.905.905 0 1 1 1.81 0l-.35 3.507a.552.552 0 0 1-1.11 0L8 6.47zm.002 6a1 1 0 1 1-2 0 1 1 0 0 1 2 0z" />
                </symbol>
            </svg>
            <div>
                <strong>Telegram no emparejado</strong><br />
                No se pueden configurar las opciones del bot para este usuario hasta que el programa tenga acceso a la sesión privada del bot.
            </div>
        </div>
    }
}
@code {
    [CascadingParameter]
    public Guid SessionToken{ get; set; }
    [Parameter]
    public ExtendedUserModel? UserModel { get; set; }

    private ModalDialog? mvarModal { get; set; }

    private async void OnSendPersonalDataChanges()
    {
        // Lógica para manejar la sumisión del formulario
        if (null != UserModel)
        {
            UpdateUserPersonalDataMessage paquete =
            new UpdateUserPersonalDataMessage(SessionToken, UserModel.guid);
            paquete.CF = UserModel.CF;
            paquete.UpdateTelegramStatus = true;
            paquete.TelegramEnabled = UserModel.TelegramEnabled;
            paquete.TelegramRules = UserModel.TelegramRules;
            await mvarAuthClient.sendModifyUser(paquete);
        }
    }

    private void OnSendUnpairTelegram()
    {
        mvarModal?.show("Desconexión de Telegram","Está seguro de querer anular la conexión actual de este usuario","Si","No");
    }
    private async void OnTelegramConfirmationResponse(bool result)
    {
        if(result && null!=UserModel)
        {
            await mvarAuthClient.UnpairTelegram(SessionToken, UserModel.guid);
            StateHasChanged();
        }
    }

}
