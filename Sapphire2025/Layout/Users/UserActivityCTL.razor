@inject AuthenticationClient mvarUserClient
@if (null==mvarUserActivityModel)
{
	<LoadingTab ElementText="Cargando datos de actividad del usuario"/>
}
else
{
    <div class="row border-bottom border-top bg-secondary text-light">
        <div class="col border-end">
            <Sapphire2025.Icons.Actions.TimeValue Color="white" />
        </div>
        <div class="col">
            <Sapphire2025.Icons.Actions.WriteNote Color="white" />
        </div>
    </div>
    <div class="overflow-auto" style="height: 80vh; overflow-y: auto; width: 100%">
        @foreach (UserActivityModel.UserActivityAtom atom in mvarUserActivityModel.activity)
        {
            <div class="row border-top">
                <div class="col border-right">
                    <p>@Sapphire2025Models.Utils.autoDate(atom.timeStamp)</p>
                </div>
                <div class="col">
                    <p>@operationName(atom)</p>
                </div>
            </div>
        }
    </div>
}

@code {
    [CascadingParameter]
    public Guid UserToken { get; set; }
    [Parameter]
    public Guid UserId{ get; set; }

    private UserActivityModel? mvarUserActivityModel { get; set; } = null;

    protected async override Task OnParametersSetAsync()
    {
        mvarUserActivityModel = await mvarUserClient.getUserActivity(UserToken, UserId, 40);
    }
    private string operationName(UserActivityModel.UserActivityAtom atom)
    {
        Sapphire2025Models.Common.sessionEventType evento = (Sapphire2025Models.Common.sessionEventType)atom.type;
        return Sapphire2025Models.Common.SessionEventTypeName(evento);
    }

}
