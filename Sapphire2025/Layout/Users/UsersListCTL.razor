@if(null!=users)
{
    <div class="row border-bottom border-top bg-secondary text-light">
        <div class="col">
            <Sapphire2025.Icons.Fields.CF />
        </div>
        <div class="col">
            <Sapphire2025.Icons.Headers.User />
        </div>
        <div class="col">
            <Sapphire2025.Icons.Fields.Mail />
        </div>
        <div class="col">
            <Sapphire2025.Icons.Fields.Phone />
        </div>
    </div>
    <div class="overflow-auto" style="height: 50vh; overflow-y: auto; width: 100%">
        @foreach (UserModel user in users)
        {
            <UsersListCTLRecord User="@user"></UsersListCTLRecord>
        }
    </div>
}
@code {
    [Parameter]
    public IEnumerable<UserModel>? users { get; set; }        
    
}

