@using TimeNet2026.ScriptCompiling
@using System.Linq
@inject IJSRuntime mvarJs

<div class="modal fade" id="compilationResultModal">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            @if(null!=Result && Result.Message.Length>0)
            {
                <div class="modal-header bg-@(Result.Success ? "success" : "danger") text-white flex-column">
                    <h4 class="modal-title w-100">
                        @(Result?.Success == true ? "¡Todo OK!" : "Compilación con errores")
                    </h4>
                    @if (!string.IsNullOrWhiteSpace(Result?.Message))
                    {
                        <div class="w-100 mt-2 mb-1">
                            <span class="fw-normal">@Result?.Message</span>
                        </div>
                    }
                    <button type="button" class="btn-close position-absolute top-0 end-0 m-2" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body" style="max-height:400px;overflow-y:auto;">
                    @if (Result != null && Result.Warnings != null && Result.Warnings.Any())
                    {
                        <table class="table table-sm table-hover">
                            <thead class="table-light sticky-top">
                                <tr>
                                    <th style="width:40px"></th>
                                    <th>Severidad</th>
                                    <th>Mensaje</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var warn in Result.Warnings)
                                {
                                    <tr class="@GetRowClass(warn.Severity)">
                                        <td>@GetSeverityIcon(warn.Severity)</td>
                                        <td>@warn.Severity</td>
                                        <td>@warn.Message</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
                </div>
            }
        </div>
    </div>
</div>

@code {
    [Parameter]
    public CompileResult? Result { get; set; }
    public async Task show()
    {
        StateHasChanged();
        await mvarJs.InvokeVoidAsync("showModal", "compilationResultModal");
    }

    private string GetRowClass(CompileWarning.SeverityEnum severity)
    {
        return severity switch
        {
            CompileWarning.SeverityEnum.Error => "table-danger",
            CompileWarning.SeverityEnum.Severe => "table-danger",
            CompileWarning.SeverityEnum.Fatal => "table-danger",
            CompileWarning.SeverityEnum.Warning => "table-warning",
            _ => ""
        };
    }

    private MarkupString GetSeverityIcon(CompileWarning.SeverityEnum severity)
    {
        return severity switch
        {
            CompileWarning.SeverityEnum.Error => (MarkupString)"<span style='color:#dc3545'>&#x26A0;</span>",
            CompileWarning.SeverityEnum.Severe => (MarkupString)"<span style='color:#dc3545'>&#x26A0;</span>",
            CompileWarning.SeverityEnum.Fatal => (MarkupString)"<span style='color:#dc3545'>&#x2622;</span>",
            CompileWarning.SeverityEnum.Warning => (MarkupString)"<span style='color:#ffc107'>&#x26A0;</span>",
            CompileWarning.SeverityEnum.Note => (MarkupString)"<span style='color:#0d6efd'>&#x2139;</span>",
            _ => (MarkupString)"<span style='color:#198754'>&#x2714;</span>"
        };
    }
}