<svg xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="@Color">
    @if(Checked)
    {
        <path d=""/>
    }
    else
    {
        <path d="" />
    }    
</svg>
@code {
    [Parameter]
    public string Color { get; set; } = "currentColor";
    [Parameter]
    public bool Checked { get; set; } = false;
}
