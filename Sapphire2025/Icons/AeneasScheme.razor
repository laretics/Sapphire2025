<svg viewBox="0 0 660 440" xmlns="http://www.w3.org/2000/svg">
    <defs>
        <!-- Sombra para las cajas -->
        <filter id="boxShadow" x="-20%" y="-20%" width="140%" height="140%">
            <feDropShadow dx="0" dy="2" stdDeviation="3" flood-color="#000" flood-opacity="0.15" />
        </filter>
        <!-- Caja gris -->
        <g id="grayBox">
            <rect width="150" height="55" rx="16" fill="#a9a9b3" filter="url(#boxShadow)" />
            <text x="75" y="32" text-anchor="middle" alignment-baseline="middle" font-family="Segoe UI" font-size="18" fill="#fff" id="grayLabel">Etiqueta</text>
        </g>
        <!-- Caja morada -->
        <g id="purpleBox">
            <rect width="150" height="55" rx="16" fill="url(#purpleGrad)" filter="url(#boxShadow)" />
            <text x="75" y="32" text-anchor="middle" alignment-baseline="middle" font-family="Segoe UI" font-size="18" fill="#fff" id="purpleLabel">Etiqueta</text>
        </g>
        <!-- Gradiente morado -->
        <linearGradient id="purpleGrad" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%" stop-color="#7c19d6" />
            <stop offset="100%" stop-color="#4b0ca3" />
        </linearGradient>
        <!-- Flecha simple -->
        <g id="arrow">
            <line x1="0" y1="0" x2="40" y2="0" stroke="#1a1976" stroke-width="4" marker-end="url(#arrowhead)" />
        </g>
        <!-- Flecha doble -->
        <g id="doubleArrow">
            <line x1="0" y1="0" x2="40" y2="0" stroke="#1a1976" stroke-width="4" marker-end="url(#arrowhead)" marker-start="url(#arrowheadStart)" />
        </g>
        <!-- Cabeza de flecha -->
        <marker id="arrowhead" markerWidth="10" markerHeight="7" refX="10" refY="3.5" orient="auto">
            <polygon points="0 0, 10 3.5, 0 7" fill="#1a1976" />
        </marker>
        <marker id="arrowheadStart" markerWidth="10" markerHeight="7" refX="0" refY="3.5" orient="auto">
            <polygon points="10 0, 0 3.5, 10 7" fill="#1a1976" />
        </marker>
        <!-- Flecha vertical -->
        <g id="arrowDown">
            <line x1="0" y1="0" x2="0" y2="40" stroke="#1a1976" stroke-width="4" marker-end="url(#arrowheadV)" />
        </g>
        <marker id="arrowheadV" markerWidth="7" markerHeight="10" refX="3.5" refY="10" orient="auto">
            <polygon points="0 0, 3.5 10, 7 0" fill="#1a1976" />
        </marker>
        <!-- Flecha vertical doble -->
        <g id="doubleArrowDown">
            <line x1="0" y1="0" x2="0" y2="40" stroke="#1a1976" stroke-width="4" marker-end="url(#arrowheadV)" marker-start="url(#arrowheadVStart)" />
        </g>
        <marker id="arrowheadVStart" markerWidth="7" markerHeight="10" refX="3.5" refY="0" orient="auto">
            <polygon points="0 10, 3.5 0, 7 10" fill="#1a1976" />
        </marker>
        <!-- Reloj -->
        <g id="clock">
            <circle cx="20" cy="20" r="16" fill="#fff" stroke="#1a1976" stroke-width="3" />
            <line x1="20" y1="20" x2="20" y2="10" stroke="#1a1976" stroke-width="2" />
            <line x1="20" y1="20" x2="30" y2="20" stroke="#1a1976" stroke-width="2" />
        </g>
        <!-- Badge -->
        <g id="badge">
            <circle cx="0" cy="0" r="13" fill="#2196f3" />
            <text x="0" y="5" text-anchor="middle" font-family="Segoe UI" font-size="15" fill="#fff" font-weight="bold" id="badgeLabel">1</text>
        </g>
    </defs>
    <!-- Fondo -->
    <rect x="10" y="10" width="640" height="420" rx="30" fill="#d6f7e2" />
    <!-- Cajas grises -->
    <g>
        <g transform="translate(40,40)">
            <use href="#grayBox" />
            <text x="75" y="32" text-anchor="middle" alignment-baseline="middle" font-family="Segoe UI" font-size="18" fill="#fff">¡Retirar!</text>
        </g>
        <g transform="translate(40,110)">
            <use href="#grayBox" />
            <text x="75" y="32" text-anchor="middle" alignment-baseline="middle" font-family="Segoe UI" font-size="18" fill="#fff">Pend. Diagnóstico</text>
        </g>
        <g transform="translate(240,40)">
            <use href="#grayBox" />
            <text x="75" y="32" text-anchor="middle" alignment-baseline="middle" font-family="Segoe UI" font-size="18" fill="#fff">Correctivo</text>
        </g>
    </g>
    <!-- Cajas moradas fila superior -->
    <g>
        <g transform="translate(240,110)">
            <use href="#purpleBox" />
            <text x="75" y="32" text-anchor="middle" alignment-baseline="middle" font-family="Segoe UI" font-size="18" fill="#fff">Disponible</text>
            <g transform="translate(120,38)">
                <use href="#badge" />
                <text x="0" y="5" text-anchor="middle" font-family="Segoe UI" font-size="15" fill="#fff" font-weight="bold">20</text>
            </g>
        </g>
        <g transform="translate(420,110)">
            <use href="#purpleBox" />
            <text x="75" y="32" text-anchor="middle" alignment-baseline="middle" font-family="Segoe UI" font-size="18" fill="#fff">Solicitado Preventivo</text>
            <g transform="translate(120,38)">
                <use href="#badge" />
                <text x="0" y="5" text-anchor="middle" font-family="Segoe UI" font-size="15" fill="#fff" font-weight="bold">2</text>
            </g>
        </g>
    </g>
    <!-- Cajas moradas fila inferior -->
    <g>
        <g transform="translate(240,220)">
            <use href="#purpleBox" />
            <text x="75" y="32" text-anchor="middle" alignment-baseline="middle" font-family="Segoe UI" font-size="18" fill="#fff">Preventivo</text>
            <g transform="translate(120,38)">
                <use href="#badge" />
                <text x="0" y="5" text-anchor="middle" font-family="Segoe UI" font-size="15" fill="#fff" font-weight="bold">3</text>
            </g>
        </g>
        <g transform="translate(420,220)">
            <use href="#purpleBox" />
            <text x="75" y="32" text-anchor="middle" alignment-baseline="middle" font-family="Segoe UI" font-size="18" fill="#fff">Esperando Preventivo</text>
            <g transform="translate(120,38)">
                <use href="#badge" />
                <text x="0" y="5" text-anchor="middle" font-family="Segoe UI" font-size="15" fill="#fff" font-weight="bold">1</text>
            </g>
        </g>
    </g>
    <!-- Flechas horizontales -->
    <g>
        <g transform="translate(190,65)">
            <use href="#arrow" />
        </g>
        <g transform="translate(190,135)">
            <use href="#arrow" />
        </g>
        <g transform="translate(390,137)">
            <use href="#arrow" />
        </g>
        <g transform="translate(390,247)">
            <use href="#arrow" />
        </g>
        <g transform="translate(340,137)">
            <use href="#doubleArrow" />
        </g>
        <g transform="translate(340,247)">
            <use href="#doubleArrow" />
        </g>
    </g>
    <!-- Flechas verticales -->
    <g>
        <g transform="translate(315,95)">
            <use href="#arrowDown" />
        </g>
        <g transform="translate(315,195)">
            <use href="#arrowDown" />
        </g>
        <g transform="translate(495,195)">
            <use href="#doubleArrowDown" />
        </g>
        <g transform="translate(115,95)">
            <use href="#arrowDown" />
        </g>
        <g transform="translate(115,195)">
            <use href="#arrowDown" />
        </g>
    </g>
    <!-- Reloj -->
    <g transform="translate(370,145)">
        <use href="#clock" />
    </g>
</svg>