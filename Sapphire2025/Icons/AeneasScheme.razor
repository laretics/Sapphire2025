<svg width="100%" height="100%" viewBox="10 0 370 400" xmlns="http://www.w3.org/2000/svg" style="background:#f8f8f8">

    <!-- Parámetros (fáciles de cambiar) -->
    <defs>
        <linearGradient id="gradPurple" x1="0%" y1="0%" x2="0%" y2="100%">
            <stop offset="0%" stop-color="#7C3AED" />
            <stop offset="100%" stop-color="#4C1D95" />
        </linearGradient>
        <linearGradient id="gradGray" x1="0%" y1="0%" x2="0%" y2="100%">
            <stop offset="0%" stop-color="#6B7280" />
            <stop offset="100%" stop-color="#374151" />
        </linearGradient>
        <linearGradient id="gradGreen" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="#10B981" stop-opacity="0.55" />
            <stop offset="100%" stop-color="#284138" stop-opacity="0.38" />
        </linearGradient>
        <filter id="shadow" x="-20%" y="-20%" width="140%" height="140%">
            <feGaussianBlur in="SourceAlpha" stdDeviation="4" />
            <feOffset dx="3" dy="5" result="offsetblur" />
            <feComponentTransfer>
                <feFuncA type="linear" slope="0.6" />
            </feComponentTransfer>
            <feMerge>
                <feMergeNode />
                <feMergeNode in="SourceGraphic" />
            </feMerge>
        </filter>
        <filter id="badgeShadow" x="-30%" y="-30%" width="160%" height="160%">
            <feGaussianBlur in="SourceAlpha" stdDeviation="2" />
            <feOffset dx="1" dy="2" />
        </filter>
        <marker id="arrow" markerWidth="10" markerHeight="10" refX="8" refY="3" orient="auto" markerUnits="strokeWidth">
            <path d="M0,0 L0,6 L9,3 z" fill="#1F2937" />
        </marker>
        <style>
                    .box1 {
                        fill: url(#gradPurple);
                        rx: 16; /* esquinas redondeadas suaves */
                        stroke: "#1F2937";
                        stroke-width: 8;
                        filter: url(#shadow);
                    }

                    .box-text3 {
                        font-family: Arial, Helvetica, sans-serif;
                        font-weight: bold;
                        fill: #ffffff;
                        text-anchor: middle; /* centrado horizontal */
                        dominant-baseline: middle; /* centrado vertical */
                        font-size: 10px;
                        textLength: 10; /* ancho máximo aproximado */
                        lengthAdjust: spacingAndGlyphs;
                    }

                    .box-text2 {
                        font-family: Arial, Helvetica, sans-serif;
                        font-weight: bold;
                        fill: #ffffff;
                        text-anchor: middle; /* centrado horizontal */
                        dominant-baseline: middle; /* centrado vertical */
                        font-size: 15px;
                        textLength: 60; /* ancho máximo aproximado */
                        lengthAdjust: spacingAndGlyphs;
                    }

                    .box-text1 {
                        font-family: Arial, Helvetica, sans-serif;
                        font-weight: bold;
                        fill: #ffffff;
                        text-anchor: middle; /* centrado horizontal */
                        dominant-baseline: middle; /* centrado vertical */
                        font-size: 17px;
                        textLength: 60; /* ancho máximo aproximado */
                        lengthAdjust: spacingAndGlyphs;
                    }
        </style>
        <symbol id="rightarrow" viewBox="0 -960 960 960" width="32" height="32">
            <path d="m560-240-56-58 142-142H160v-80h486L504-662l56-58 240 240-240 240Z" fill="#10125f" />
        </symbol>
        <symbol id="leftrightarrow" viewBox="0 -960 960 960" width="32" height="32" fill="#10125f">
            <path d="M280-280 80-480l200-200 56 56-103 104h494L624-624l56-56 200 200-200 200-56-56 103-104H233l103 104-56 56Z" />
        </symbol>
        <symbol id="uparrow" height="32" viewBox="0 -960 960 960" width="32" fill="#10125f"><path d="M440-160v-487L216-423l-56-57 320-320 320 320-56 57-224-224v487h-80Z" /></symbol>
        <symbol id="downarrow" height="32" viewBox="0 -960 960 960" width="32" fill="#10125f"><path d="M440-800v487L216-537l-56 57 320 320 320-320-56-57-224 224v-487h-80Z" /></symbol>
        <symbol id="updownarrow" height="32" viewBox="0 -960 960 960" width="32" fill="#10125f"><path d="M480-120 320-280l56-56 64 63v-414l-64 63-56-56 160-160 160 160-56 57-64-64v414l64-63 56 56-160 160Z" /></symbol>
        <symbol id="timericon" height="32" viewBox="0 -960 960 960" width="32" fill="#10125f"><path d="m612-292 56-56-148-148v-184h-80v216l172 172ZM480-80q-83 0-156-31.5T197-197q-54-54-85.5-127T80-480q0-83 31.5-156T197-763q54-54 127-85.5T480-880q83 0 156 31.5T763-763q54 54 85.5 127T880-480q0 83-31.5 156T763-197q-54 54-127 85.5T480-80Zm0-400Zm0 320q133 0 226.5-93.5T800-480q0-133-93.5-226.5T480-800q-133 0-226.5 93.5T160-480q0 133 93.5 226.5T480-160Z" /></symbol>
    </defs>

    <!-- Las 12 cajas -->
    <!-- Fila 1 -->
    <rect x="30" y="20" width="90" height="70" class="box1" />
    <rect x="150" y="20" width="90" height="70" class="box1" />
    <rect x="270" y="20" width="90" height="70" class="box1" />

    <path d="M 20,110 L 115,110 Q 126,110 130,125 L 130,205 L 355,205 Q 365,205 370,215 L 370,297 L 20,295 Z" style="fill:url(#gradGreen)" />

    <!--<path d="M 20,110 L 130,110 L 130,205 L 370,205 L 370,295 L 20,295 Z"/>-->
    <!-- Fila 2 -->
    <rect x="30" y="120" width="90" height="70" class="box1" />
    <text x="75" y="155" class="box-text1">
        Retirar
    </text>
    <rect x="150" y="120" width="90" height="70" class="box1" />
    <text x="195" y="155" class="box-text2">
        Correctivo
    </text>
    <!--<rect x="270" y="115" width="90" height="80" class="box1"/>-->
    <!-- Fila 3 -->
    <rect x="30" y="215" width="90" height="70" class="box1" />
    <text x="75" y="250" class="box-text3">
        Pend Diagnóstico
    </text>
    <rect x="150" y="215" width="90" height="70" class="box1" />
    <text x="195" y="250" class="box-text1">
        Disponible
    </text>
    <rect x="270" y="215" width="90" height="70" class="box1" />
    <text x="315" y="250" class="box-text1">
        Solicitado
    </text>

    <!-- Fila 4 -->
    <!--<rect x="30"  y="305" width="90" height="80" class="box1"/>-->
    <rect x="150" y="310" width="90" height="70" class="box1" />
    <text x="195" y="345" class="box-text2">
        Preventivo
    </text>
    <rect x="270" y="310" width="90" height="70" class="box1" />
    <text x="315" y="344" class="box-text2">
        Apartado
    </text>


    <use href="#rightarrow" x="120" y="140" />

    <use href="#uparrow" x="60" y="185" />
    <use href="#downarrow" x="180" y="185" />

    <use href="#leftrightarrow" x="120" y="235" />

    <use href="#timericon" x="240" y="223" />
    <use href="#rightarrow" x="240" y="248" />

    <use href="#uparrow" x="180" y="280" />
    <use href="#updownarrow" x="300" y="280" />

    <use href="#leftrightarrow" x="240" y="330" />

</svg>