@using Sapphire2025Models
<GenIcon Color="@color" Name="@IndexNameAtomic"/>
@code {
	[Parameter]
	public string color { get; set; } = "black";
	[Parameter]
	public Common.UserRole Role { get; set; }
	[Parameter]
	public byte Credentials { get; set; } = 0;

	private string IndexName
	{
		get
		{
			if (0 != Credentials)
				Role = roleFromCredentials();

			return IndexNameAtomic;
		}		
	}

	private Common.UserRole roleFromCredentials()
	{
		if (Utils.hasRole(Credentials, Common.UserRole.Root))
			return Common.UserRole.Root;
		if (Utils.hasRole(Credentials, Common.UserRole.Engineer))
			return Common.UserRole.Engineer;
		if (Utils.hasRole(Credentials, Common.UserRole.Inspector))
			return Common.UserRole.Inspector;
		if (Utils.hasRole(Credentials, Common.UserRole.Expert))
			return Common.UserRole.Expert;
		if (Utils.hasRole(Credentials, Common.UserRole.Oficial))
			return Common.UserRole.Oficial;
		if (Utils.hasRole(Credentials, Common.UserRole.Mechanic))
			return Common.UserRole.Mechanic;
		return Common.UserRole.Anonymous;
	}

	private string IndexNameAtomic
	{
		get
		{
			switch(Role)
			{
				case Common.UserRole.Root:
					return "RoleAdmin";
				case Common.UserRole.Engineer:
					return "RoleDetective";
				case Common.UserRole.Inspector:
					return "RoleInspector";
				case Common.UserRole.Expert:
					return "RoleDiagnoser";
				case Common.UserRole.Oficial:
					return "RoleAdvancedUser";
				case Common.UserRole.Mechanic:
					return "RoleMechanic";
				case Common.UserRole.Station:
					return "RoleStation";
				default:
					return "RoleUser";
			}
		}
	}
}
