@if (CurrentIcon is not null)
{
    @if (Glow)
    {
        <svg xmlns="http://www.w3.org/2000/svg"
             width="@Size"
             height="@Size"
             fill="@Color"
             viewBox="@CurrentIcon.ViewBox"
             filter="url(#@FilterId)">

            <defs>
                <filter id="@FilterId"
                        x="-50%" y="-50%"
                        width="200%" height="200%">
                    <feDropShadow dx="0"
                                  dy="0"
                                  stdDeviation="@GlowBlur"
                                  flood-color="@GlowColor"
                                  flood-opacity="@GlowOpacity" />
                </filter>
            </defs>

            @if (CurrentIcon.UseFillRule)
            {
                <path fill-rule="evenodd" d="@CurrentIcon.Path" />
            }
            else
            {
                <path d="@CurrentIcon.Path" />
            }
        </svg>
    }
    else if (null!=x && null!=y)
    {
        <svg xmlns="http://www.w3.org/2000/svg"
             width="@Size"
             height="@Size"
             fill="@Color"
             x="@(x)%"
             y="@(y)%"                 
             viewBox="@CurrentIcon.ViewBox">
            @if (CurrentIcon.UseFillRule)
            {
                <path fill-rule="evenodd" d="@CurrentIcon.Path" />
            }
            else
            {
                <path d="@CurrentIcon.Path" />
            }
        </svg>        
    }
    else
    {
        <svg xmlns="http://www.w3.org/2000/svg"
             width="@Size"
             height="@Size"
             fill="@Color"
             viewBox="@CurrentIcon.ViewBox">
            @if (CurrentIcon.UseFillRule)
            {
                <path fill-rule="evenodd" d="@CurrentIcon.Path" />
            }
            else
            {
                <path d="@CurrentIcon.Path" />
            }
        </svg>
    }
}
