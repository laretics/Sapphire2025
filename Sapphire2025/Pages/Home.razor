@page "/"
@inject NavigationManager mvarNavigator
<PageTitle>Zafiro</PageTitle>

<div class="container d-flex justify-content-center align-items-center" style="height: 100vh;">
    <div class="card shadow-lg p-4" style="max-width: 600px; width: 100%;">
        <div class="row g-0 align-items-center">
            <div class="col-md-5 text-center">
                <!-- Cambia a col-md-5 para más espacio -->
                <img src="img/ZafiroTheme.jpeg"
                     class="img-fluid rounded mb-3 me-4"
                     style="cursor:pointer;max-height:200px;"
                alt="Logotipo Zafiro"
                @onclick='() => mvarNavigator.NavigateTo("auth/login")' />
            </div>
            <div class="col-md-7">
                <h2 class="fw-bold mb-1 text-primary">Zafiro</h2>
                <span class="badge bg-info mb-3">Versión @Sapphire2025Models.Common.SapphireSoftwareVersion</span>
                @if (auxTexto != null)
                {
                    <h5 class="mt-3 mb-2 text-secondary">Notas de la versión</h5>
                    <ul class="list-group list-group-flush">
                        @foreach (string linea in auxTexto)
                        {
                            <li class="list-group-item px-0 py-1">@linea</li>
                        }
                    </ul>
                }
            </div>
        </div>
    </div>
</div>

@code {
    string[]? auxTexto;
    protected override void OnInitialized()
    {
        string cadena = Sapphire2025Models.Common.LastChangesText;
        if (!string.IsNullOrEmpty(cadena) && cadena.Length > 0)
            auxTexto = cadena.Split('|');
    }
}