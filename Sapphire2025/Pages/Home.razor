@page "/"
@using System.Threading.Tasks
@inject NavigationManager mvarNavigator
@inject AuthenticationClient AuthClient
<PageTitle>Zafiro</PageTitle>

<div class="container min-vh-100">
    @if (!string.IsNullOrEmpty(mvarNewVersion))
    {
        <div class="row justify-content-center mt-4">
            <div class="col-12 col-md-8 col-lg-6">
                <div class="alert alert-warning border-2 rounded-4 shadow-sm text-center fs-6" role="alert" style="background:rgba(255,255,224,0.97);">
                    <Sapphire2025.Icons.Actions.Scheduler height="6"/>
                    Importante:
                    <p>La versión que está utilizando usted es la @mvarCurrentVersion.</p>
                    <p>El programa deberá ser actualizado a la versión @mvarNewVersion.</p>
                    <p>Para ello puede pulsar las teclas Ctrl + F5, borrar los datos de navegación, vaciar el historial de esta página o eliminar las cookies de navegación.</p>
                    <p>Seguirá viendo este aviso mientras su versión no coincida con la actual. Mientras tanto se podrían producir errores. Sus datos en el sistema permanecen almacenados de forma segura.</p>                    
                </div>
            </div>
        </div>
    }
    @if(!string.IsNullOrEmpty(mvarNotify))
    {
        <div class="row justify-content-center mt-4">
            <div class="col-12 col-md-8 col-lg-6">
                <div class="alert alert-primary border-2 rounded-4 shadow-sm text-center fs-5" role="alert" style="background:rgba(255,255,255,0.95);">                    
                    <Sapphire2025.Icons.Actions.Exec/>
                    @mvarNotify
                </div>
            </div>
        </div>
    }
    @if(showPanels)
    {
        <!-- Semipantalla superior: Paneles -->
        <section class="d-flex align-items-center justify-content-center" style="min-height:50vh;">
            <div class="row g-4 w-100">
                <div class="col-12 col-md-6 col-lg-4">
                    <div class="card h-100 shadow-sm border-0">
                        <div class="card-header bg-white d-flex align-items-center justify-content-between">
                            <span class="fw-semibold">Panel A</span>
                            <span class="badge bg-secondary">Tiempo real</span>
                        </div>
                        <div class="card-body">
                            <div class="d-flex flex-column gap-2">
                                <div class="placeholder-glow"><span class="placeholder col-8"></span></div>
                                <div class="placeholder-glow"><span class="placeholder col-6"></span></div>
                                <div class="placeholder-glow"><span class="placeholder col-10"></span></div>
                            </div>
                        </div>
                        <div class="card-footer bg-white d-flex justify-content-end">
                            <button class="btn btn-outline-primary btn-sm">Acción</button>
                        </div>
                    </div>
                </div>

                <div class="col-12 col-md-6 col-lg-4">
                    <div class="card h-100 shadow-sm border-0">
                        <div class="card-header bg-white d-flex align-items-center justify-content-between">
                            <span class="fw-semibold">Panel B</span>
                            <span class="badge bg-secondary">Tiempo real</span>
                        </div>
                        <div class="card-body">
                            <div class="d-flex align-items-center justify-content-between mb-2">
                                <div class="text-muted small">Estado</div>
                                <div class="badge bg-success">OK</div>
                            </div>
                            <div class="progress" role="progressbar" aria-label="Carga" aria-valuenow="45" aria-valuemin="0" aria-valuemax="100">
                                <div class="progress-bar" style="width: 45%"></div>
                            </div>
                            <div class="placeholder-glow mt-3">
                                <span class="placeholder col-12"></span>
                            </div>
                        </div>
                        <div class="card-footer bg-white d-flex justify-content-end">
                            <button class="btn btn-outline-secondary btn-sm">Ver detalles</button>
                        </div>
                    </div>
                </div>

                <div class="col-12 col-md-12 col-lg-4">
                    <div class="card h-100 shadow-sm border-0">
                        <div class="card-header bg-white d-flex align-items-center justify-content-between">
                            <span class="fw-semibold">Panel C</span>
                            <span class="badge bg-secondary">Tiempo real</span>
                        </div>
                        <div class="card-body">
                            <div class="row gy-2">
                                <div class="col-6">
                                    <div class="text-muted small">Métrica 1</div>
                                    <div class="h5 mb-0">—</div>
                                </div>
                                <div class="col-6">
                                    <div class="text-muted small">Métrica 2</div>
                                    <div class="h5 mb-0">—</div>
                                </div>
                                <div class="col-12 mt-2">
                                    <div class="placeholder-glow"><span class="placeholder col-12"></span></div>
                                </div>
                            </div>
                        </div>
                        <div class="card-footer bg-white d-flex justify-content-end">
                            <button class="btn btn-outline-success btn-sm">Actualizar</button>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    }

    <!-- Semipantalla inferior: Splash -->
    <section class="d-flex align-items-center justify-content-center" style="min-height:50vh;">
        <div class="row justify-content-center w-100">
            <div class="col-12 col-lg-10">
                <div class="card shadow-lg border-0 overflow-hidden">
                    <div class="row g-0 align-items-center">
                        <div class="col-md-5 text-center p-4">
                            <img src="img/ZafiroTheme.jpeg"
                                 class="img-fluid rounded-3 mb-3"
                                 style="cursor:pointer;max-height:220px;object-fit:cover;"
                                 alt="Logotipo Zafiro"
                                 @onclick='() => mvarNavigator.NavigateTo("auth/login")' />
                        </div>
                        <div class="col-md-7 p-4">
                            <div class="d-flex align-items-center justify-content-between">
                                <h2 class="fw-bold mb-0" style="color: @Sapphire2025Models.Common.VersionColor">Zafiro</h2>
                                <span class="badge bg-info">Versión @Sapphire2025Models.Common.SapphireSoftwareVersion</span>
                            </div>

                            @if (auxTexto != null)
                            {
                                <h6 class="mt-3 mb-2 text-secondary">Notas de la versión</h6>
                                <ul class="list-group list-group-flush small">
                                    @foreach (var linea in auxTexto)
                                    {
                                        <li class="list-group-item px-0 py-1">@linea</li>
                                    }
                                </ul>
                            }
                            else
                            {
                                <div class="text-muted small mt-3">Sin notas disponibles.</div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>

@code {
    [CascadingParameter]
    public SessionModel? mvarSession{ get; set; }
    string[]? auxTexto;
    bool showPanels { get; set; } = false;
    string? mvarNotify { get; set; }
    string mvarCurrentVersion => Sapphire2025Models.Common.SapphireSoftwareVersion;
    string mvarNewVersion { get; set; } = "";

    protected override async Task OnInitializedAsync()
    {
        string auxVersion = await AuthClient.GetCurrentServerVersion();
        //auxVersion += "p"; //Prueba de cambio de versión forzado.
        mvarNotify = null;
        if (auxVersion != Sapphire2025Models.Common.SapphireSoftwareVersion)
            mvarNewVersion = auxVersion;

        if (null == mvarSession)
            mvarNotify = await AuthClient.GetRegisterValue("prelogms", "");
        else
            mvarNotify = await AuthClient.GetRegisterValue("postlogms", "");

        var cadena = Sapphire2025Models.Common.LastChangesText;
        if (!string.IsNullOrWhiteSpace(cadena))
            auxTexto = cadena.Split('|', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
    }
}