@page "/"
@using System.Threading.Tasks
@using Sapphire2025.Icons
@inject NavigationManager mvarNavigator
@inject AuthenticationClient AuthClient
<PageTitle>Zafiro</PageTitle>

<div class="home-page container-fluid container-lg min-vh-100 px-2 px-sm-3 px-md-4">
    @if (!string.IsNullOrEmpty(mvarNewVersion))
    {
        <div class="row justify-content-center mt-3 mt-md-4">
            <div class="col-12 col-md-10 col-lg-8">
                <div class="alert alert-warning border-2 rounded-4 shadow-sm text-center home-alert" role="alert">
                    <GenIcon Name="Scheduler"/>
                    <strong class="d-block d-sm-inline">Importante:</strong>
                    <p class="mb-1 mt-2">La versión que está utilizando usted es la @mvarCurrentVersion.</p>
                    <p class="mb-1">El programa deberá ser actualizado a la versión @mvarNewVersion.</p>
                    <p class="mb-1 small">Para ello puede pulsar las teclas Ctrl + F5, borrar los datos de navegación, vaciar el historial de esta página o eliminar las cookies de navegación.</p>
                    <p class="mb-0 small">Seguirá viendo este aviso mientras su versión no coincida con la actual. Mientras tanto se podrían producir errores. Sus datos en el sistema permanecen almacenados de forma segura.</p>
                </div>
            </div>
        </div>
    }
    @if(!string.IsNullOrEmpty(mvarNotify))
    {
        <div class="row justify-content-center mt-3 mt-md-4">
            <div class="col-12 col-md-10 col-lg-8">
                <div class="alert alert-primary border-2 rounded-4 shadow-sm text-center home-alert" role="alert">
                    <GenIcon Name="Exec"/>
                    @mvarNotify
                </div>
            </div>
        </div>
    }
    @if(showPanels)
    {
        <!-- Semipantalla superior: Paneles -->
        <section class="home-panels d-flex align-items-center justify-content-center py-3 py-md-4">
            <div class="row g-3 g-md-4 w-100">
                <div class="col-12 col-sm-6 col-lg-4">
                    <div class="card h-100 shadow-sm border-0">
                        <div class="card-header bg-white d-flex align-items-center justify-content-between">
                            <span class="fw-semibold">Panel A</span>
                            <span class="badge bg-secondary">Tiempo real</span>
                        </div>
                        <div class="card-body">
                            <div class="d-flex flex-column gap-2">
                                <div class="placeholder-glow"><span class="placeholder col-8"></span></div>
                                <div class="placeholder-glow"><span class="placeholder col-6"></span></div>
                                <div class="placeholder-glow"><span class="placeholder col-10"></span></div>
                            </div>
                        </div>
                        <div class="card-footer bg-white d-flex justify-content-end">
                            <button class="btn btn-outline-primary btn-sm">Acción</button>
                        </div>
                    </div>
                </div>

                <div class="col-12 col-sm-6 col-lg-4">
                    <div class="card h-100 shadow-sm border-0">
                        <div class="card-header bg-white d-flex align-items-center justify-content-between">
                            <span class="fw-semibold">Panel B</span>
                            <span class="badge bg-secondary">Tiempo real</span>
                        </div>
                        <div class="card-body">
                            <div class="d-flex align-items-center justify-content-between mb-2">
                                <div class="text-muted small">Estado</div>
                                <div class="badge bg-success">OK</div>
                            </div>
                            <div class="progress" role="progressbar" aria-label="Carga" aria-valuenow="45" aria-valuemin="0" aria-valuemax="100">
                                <div class="progress-bar" style="width: 45%"></div>
                            </div>
                            <div class="placeholder-glow mt-3">
                                <span class="placeholder col-12"></span>
                            </div>
                        </div>
                        <div class="card-footer bg-white d-flex justify-content-end">
                            <button class="btn btn-outline-secondary btn-sm">Ver detalles</button>
                        </div>
                    </div>
                </div>

                <div class="col-12 col-sm-12 col-lg-4">
                    <div class="card h-100 shadow-sm border-0">
                        <div class="card-header bg-white d-flex align-items-center justify-content-between">
                            <span class="fw-semibold">Panel C</span>
                            <span class="badge bg-secondary">Tiempo real</span>
                        </div>
                        <div class="card-body">
                            <div class="row gy-2">
                                <div class="col-6">
                                    <div class="text-muted small">Métrica 1</div>
                                    <div class="h5 mb-0">—</div>
                                </div>
                                <div class="col-6">
                                    <div class="text-muted small">Métrica 2</div>
                                    <div class="h5 mb-0">—</div>
                                </div>
                                <div class="col-12 mt-2">
                                    <div class="placeholder-glow"><span class="placeholder col-12"></span></div>
                                </div>
                            </div>
                        </div>
                        <div class="card-footer bg-white d-flex justify-content-end">
                            <button class="btn btn-outline-success btn-sm">Actualizar</button>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    }

    <!-- Splash principal -->
    <section class="home-splash d-flex align-items-center justify-content-center py-3 py-md-4">
        <div class="row justify-content-center w-100 g-0">
            <div class="col-12 col-xl-10">
                <div class="card home-splash-card shadow-lg border-0 overflow-hidden">
                    <div class="row g-0 align-items-center">
                        <div class="col-12 col-md-5 text-center p-3 p-md-4 home-splash-media">
                            <img src="img/ZafiroTheme.jpg"
                                 class="img-fluid rounded-3 home-hero-img"
                                 alt="Logotipo Zafiro"
                                 @onclick="OnAuthAction" />
                            <div class="d-md-none mt-3">
                                <button type="button"
                                        class="btn @(IsLoggedIn ? "btn-outline-secondary" : "btn-primary") w-100"
                                        @onclick="OnAuthAction">
                                    @(IsLoggedIn ? "Cerrar sesión" : "Iniciar sesión")
                                </button>
                            </div>
                        </div>
                        <div class="col-12 col-md-7 p-3 p-md-4 home-splash-body">
                            <div class="position-relative d-inline-block overflow-hidden rounded-4 home-title-wrap">
                                <Image Src="img/title.png"
                                       class="img-fluid d-block rounded-4 home-title-img"
                                       alt="Título" />

                                <span class="badge rounded-pill bg-dark text-white position-absolute bottom-0 end-0 m-2 shadow home-version-badge">
                                    Versión @Sapphire2025Models.Common.SapphireSoftwareVersion
                                </span>
                            </div>

                            @if (auxTexto != null)
                            {
                                <h6 class="mt-3 mb-2 text-secondary">Notas de la versión</h6>
                                <ul class="list-group list-group-flush small home-notes">
                                    @foreach (var linea in auxTexto)
                                    {
                                        <li class="list-group-item px-0 py-1">@linea</li>
                                    }
                                </ul>
                            }
                            else
                            {
                                <div class="text-muted small mt-3">Sin notas disponibles.</div>
                            }

                            <div class="d-none d-md-block mt-3">
                                <button type="button"
                                        class="btn @(IsLoggedIn ? "btn-outline-secondary" : "btn-outline-primary")"
                                        @onclick="OnAuthAction">
                                    @(IsLoggedIn ? "Cerrar sesión" : "Ir al inicio de sesión")
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>

@code {
    [CascadingParameter]
    public SessionModel? mvarSession{ get; set; }
    string[]? auxTexto;
    bool showPanels { get; set; } = false;
    string? mvarNotify { get; set; }
    string mvarCurrentVersion => Sapphire2025Models.Common.SapphireSoftwareVersion;
    string mvarNewVersion { get; set; } = "";

    private bool IsLoggedIn => mvarSession is not null;

    private void OnAuthAction()
    {
        mvarNavigator.NavigateTo(IsLoggedIn ? "auth/logout" : "auth/login");
    }

    protected override async Task OnInitializedAsync()
    {
        string auxVersion = await AuthClient.GetCurrentServerVersion();
        //auxVersion += "p"; //Prueba de cambio de versión forzado.
        mvarNotify = null;
        if (auxVersion != Sapphire2025Models.Common.SapphireSoftwareVersion && Sapphire2025Models.Common.MajorVersion)
            mvarNewVersion = auxVersion;

        if (null == mvarSession)
            mvarNotify = await AuthClient.GetRegisterValue("prelogms", "");
        else
            mvarNotify = await AuthClient.GetRegisterValue("postlogms", "");

        var cadena = Sapphire2025Models.Common.LastChangesText;
        if (!string.IsNullOrWhiteSpace(cadena))
            auxTexto = cadena.Split('|', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
    }
}
