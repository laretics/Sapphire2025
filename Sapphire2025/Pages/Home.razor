@page "/"
@using System.Threading.Tasks
@using Sapphire2025.Icons
@using Sapphire2025Models.Authentication
@inject NavigationManager mvarNavigator
@inject AuthenticationClient AuthClient
<PageTitle>Zafiro</PageTitle>

<div class="home-page container-fluid container-lg min-vh-100 px-2 px-sm-3 px-md-4">
    @if (mvarNeedsUpdate && !string.IsNullOrEmpty(mvarNewVersion))
    {
        <div class="row justify-content-center mt-3 mt-md-4">
            <div class="col-12 col-md-10 col-lg-8">
                <div class="alert alert-warning border-2 rounded-4 shadow-sm text-center home-alert" role="alert">
                    <GenIcon Name="Scheduler"/>
                    <strong class="d-block d-sm-inline">Importante:</strong>
                    <p class="mb-1 mt-2">La versión que está utilizando usted es la @mvarCurrentVersion.</p>
                    <p class="mb-1">El programa deberá ser actualizado a la versión @mvarNewVersion.</p>
                    @if (mcolChanges is { Count: > 0 })
                    {
                        <div class="text-start small mt-2 mb-2">
                            <div class="fw-semibold mb-1">Cambios que le afectan:</div>
                            <ul class="mb-0 list-unstyled">
                                @foreach (VersionChangeNote change in mcolChanges)
                                {
                                    <li class="d-flex align-items-start justify-content-between gap-2 py-1 border-bottom border-warning-subtle">
                                        <span>@change.Text</span>
                                        @if (change.HasObservations)
                                        {
                                            <button type="button" class="btn btn-sm btn-outline-dark flex-shrink-0"
                                                    @onclick="() => ShowChangeDetails(change)"
                                                    title="Más información sobre este cambio">
                                                <i class="bi bi-info-circle"></i>
                                                <span class="d-none d-sm-inline"> Más info</span>
                                            </button>
                                        }
                                    </li>
                                }
                            </ul>
                        </div>
                    }
                    <p class="mb-1 small">Para ello puede pulsar las teclas Ctrl + F5, borrar los datos de navegación, vaciar el historial de esta página o eliminar las cookies de navegación.</p>
                    <p class="mb-0 small">Seguirá viendo este aviso mientras su versión no coincida con la actual. Mientras tanto se podrían producir errores. Sus datos en el sistema permanecen almacenados de forma segura.</p>
                </div>
            </div>
        </div>
    }
    @if(!string.IsNullOrEmpty(mvarNotify))
    {
        <div class="row justify-content-center mt-3 mt-md-4">
            <div class="col-12 col-md-10 col-lg-8">
                <div class="alert alert-primary border-2 rounded-4 shadow-sm text-center home-alert" role="alert">
                    <GenIcon Name="Exec"/>
                    @mvarNotify
                </div>
            </div>
        </div>
    }
    @if(showPanels)
    {
        <!-- Semipantalla superior: Paneles -->
        <section class="home-panels d-flex align-items-center justify-content-center py-3 py-md-4">
            <div class="row g-3 g-md-4 w-100">
                <div class="col-12 col-sm-6 col-lg-4">
                    <div class="card h-100 shadow-sm border-0">
                        <div class="card-header bg-white d-flex align-items-center justify-content-between">
                            <span class="fw-semibold">Panel A</span>
                            <span class="badge bg-secondary">Tiempo real</span>
                        </div>
                        <div class="card-body">
                            <div class="d-flex flex-column gap-2">
                                <div class="placeholder-glow"><span class="placeholder col-8"></span></div>
                                <div class="placeholder-glow"><span class="placeholder col-6"></span></div>
                                <div class="placeholder-glow"><span class="placeholder col-10"></span></div>
                            </div>
                        </div>
                        <div class="card-footer bg-white d-flex justify-content-end">
                            <button class="btn btn-outline-primary btn-sm">Acción</button>
                        </div>
                    </div>
                </div>

                <div class="col-12 col-sm-6 col-lg-4">
                    <div class="card h-100 shadow-sm border-0">
                        <div class="card-header bg-white d-flex align-items-center justify-content-between">
                            <span class="fw-semibold">Panel B</span>
                            <span class="badge bg-secondary">Tiempo real</span>
                        </div>
                        <div class="card-body">
                            <div class="d-flex align-items-center justify-content-between mb-2">
                                <div class="text-muted small">Estado</div>
                                <div class="badge bg-success">OK</div>
                            </div>
                            <div class="progress" role="progressbar" aria-label="Carga" aria-valuenow="45" aria-valuemin="0" aria-valuemax="100">
                                <div class="progress-bar" style="width: 45%"></div>
                            </div>
                            <div class="placeholder-glow mt-3">
                                <span class="placeholder col-12"></span>
                            </div>
                        </div>
                        <div class="card-footer bg-white d-flex justify-content-end">
                            <button class="btn btn-outline-secondary btn-sm">Ver detalles</button>
                        </div>
                    </div>
                </div>

                <div class="col-12 col-sm-12 col-lg-4">
                    <div class="card h-100 shadow-sm border-0">
                        <div class="card-header bg-white d-flex align-items-center justify-content-between">
                            <span class="fw-semibold">Panel C</span>
                            <span class="badge bg-secondary">Tiempo real</span>
                        </div>
                        <div class="card-body">
                            <div class="row gy-2">
                                <div class="col-6">
                                    <div class="text-muted small">Métrica 1</div>
                                    <div class="h5 mb-0">—</div>
                                </div>
                                <div class="col-6">
                                    <div class="text-muted small">Métrica 2</div>
                                    <div class="h5 mb-0">—</div>
                                </div>
                                <div class="col-12 mt-2">
                                    <div class="placeholder-glow"><span class="placeholder col-12"></span></div>
                                </div>
                            </div>
                        </div>
                        <div class="card-footer bg-white d-flex justify-content-end">
                            <button class="btn btn-outline-success btn-sm">Actualizar</button>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    }

    <!-- Splash principal -->
    <section class="home-splash d-flex align-items-center justify-content-center py-3 py-md-4">
        <div class="row justify-content-center w-100 g-0">
            <div class="col-12 col-xl-10">
                <div class="card home-splash-card shadow-lg border-0 overflow-hidden">
                    <div class="row g-0 align-items-center">
                        <div class="col-12 col-md-5 text-center p-3 p-md-4 home-splash-media">
                            <img src="img/ZafiroTheme.jpg"
                                 class="img-fluid rounded-3 home-hero-img"
                                 alt="Logotipo Zafiro"
                                 @onclick="OnAuthAction" />
                            <div class="d-md-none mt-3 d-grid gap-2">
                                <button type="button"
                                        class="btn @(IsLoggedIn ? "btn-outline-secondary" : "btn-primary") w-100"
                                        @onclick="OnAuthAction">
                                    @(IsLoggedIn ? "Cerrar sesión" : "Iniciar sesión")
                                </button>
                            </div>
                        </div>
                        <div class="col-12 col-md-7 p-3 p-md-4 home-splash-body">
                            <div class="position-relative d-inline-block overflow-hidden rounded-4 home-title-wrap">
                                <Image Src="img/title.png"
                                       class="img-fluid d-block rounded-4 home-title-img"
                                       alt="Título" />
                            </div>

                            @if (mcolChanges is { Count: > 0 })
                            {
                                <h6 class="mt-3 mb-2 text-secondary">Notas de la versión @Sapphire2025Models.Common.SapphireSoftwareVersion</h6>
                                <ul class="list-group list-group-flush small home-notes">
                                    @foreach (VersionChangeNote change in mcolChanges)
                                    {
                                        <li class="list-group-item px-0 py-2 d-flex align-items-start justify-content-between gap-2">
                                            <span class="flex-grow-1">@change.Text</span>
                                            @if (change.HasObservations)
                                            {
                                                <button type="button" class="btn btn-sm btn-outline-primary flex-shrink-0"
                                                        @onclick="() => ShowChangeDetails(change)"
                                                        title="Más información sobre este cambio">
                                                    <i class="bi bi-info-circle"></i>
                                                    <GenIcon Name="Info" />
                                                </button>
                                            }
                                        </li>
                                    }
                                </ul>
                            }
                            <div class="d-none d-md-flex flex-wrap gap-2 mt-3">
                                <button type="button"
                                        class="btn @(IsLoggedIn ? "btn-outline-secondary" : "btn-outline-primary")"
                                        @onclick="OnAuthAction">
                                    @(IsLoggedIn ? "Cerrar sesión" : "Ir al inicio de sesión")
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>

@* Modal de detalle de un cambio de versión *@
@if (mvarDetailOpen && mvarDetailChange is not null)
{
    <div class="modal fade show d-block release-detail-modal" tabindex="-1" role="dialog" aria-modal="true"
         style="background: rgba(0,0,0,0.45);">
        <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content shadow">
                <div class="modal-header">
                    <h5 class="modal-title">
                        <i class="bi bi-info-circle me-2 text-primary"></i>@mvarDetailChange.Text
                    </h5>
                    <button type="button" class="btn-close" aria-label="Cerrar" @onclick="CloseChangeDetails"></button>
                </div>
                <div class="modal-body">
                    @foreach (string paragraph in SplitObservations(mvarDetailChange.Observations))
                    {
                        @if (paragraph.StartsWith("• "))
                        {
                            <ul class="mb-3">
                                @foreach (string bullet in paragraph.Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
                                {
                                    <li>@bullet.TrimStart('•', ' ')</li>
                                }
                            </ul>
                        }
                        else
                        {
                            <p class="mb-3" style="white-space: pre-wrap;">@paragraph</p>
                        }
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-primary" @onclick="CloseChangeDetails">Entendido</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [CascadingParameter]
    public SessionModel? mvarSession{ get; set; }
    List<VersionChangeNote> mcolChanges = new();
    bool showPanels { get; set; } = false;
    string? mvarNotify { get; set; }
    string mvarCurrentVersion => Sapphire2025Models.Common.SapphireSoftwareVersion;
    string mvarNewVersion { get; set; } = "";
    bool mvarNeedsUpdate { get; set; }

    private VersionChangeNote? mvarDetailChange;
    private bool mvarDetailOpen;

    private bool IsLoggedIn => mvarSession is not null;

    private void OnAuthAction()
    {
        mvarNavigator.NavigateTo(IsLoggedIn ? "auth/logout" : "auth/login");
    }

    private void ShowChangeDetails(VersionChangeNote change)
    {
        if (change is null || !change.HasObservations)
            return;
        mvarDetailChange = change;
        mvarDetailOpen = true;
    }

    private void CloseChangeDetails()
    {
        mvarDetailOpen = false;
        mvarDetailChange = null;
    }

    private static IEnumerable<string> SplitObservations(string? text)
    {
        if (string.IsNullOrWhiteSpace(text))
            yield break;

        string[] blocks = text.Replace("\r\n", "\n").Split("\n\n", StringSplitOptions.RemoveEmptyEntries);
        foreach (string block in blocks)
        {
            string trimmed = block.Trim();
            if (trimmed.Length == 0)
                continue;

            string[] lines = trimmed.Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
            if (lines.Length > 0 && lines.All(l => l.StartsWith("•")))
                yield return string.Join('\n', lines);
            else
                yield return trimmed;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        mvarNotify = null;
        mvarNeedsUpdate = false;
        mvarNewVersion = "";
        mcolChanges = new List<VersionChangeNote>();

        // Política por roles: el servidor filtra cambios y decide si este usuario debe recargar.
        VersionCheckResponse? check = await AuthClient.CheckClientVersion();
        if (null != check)
        {
            if (check.NeedsUpdate)
            {
                mvarNeedsUpdate = true;
                mvarNewVersion = string.IsNullOrWhiteSpace(check.ServerVersion)
                    ? "nueva"
                    : check.ServerVersion.Trim().Trim('"');
            }

            if (check.Changes is { Count: > 0 })
                mcolChanges = check.Changes.Where(c => !string.IsNullOrWhiteSpace(c.Text)).ToList();
            else if (check.Notes is { Count: > 0 })
            {
                // Compatibilidad si el servidor solo enviara textos
                mcolChanges = check.Notes
                    .Where(n => !string.IsNullOrWhiteSpace(n))
                    .Select(n => new VersionChangeNote { Text = n })
                    .ToList();
            }
        }
        else
        {
            mcolChanges = Sapphire2025Models.Common.GetReleaseChangesFor(mvarSession?.Roles)
                .Where(c => !string.IsNullOrWhiteSpace(c.Text))
                .Select(c => new VersionChangeNote
                {
                    Text = c.Text,
                    Observations = c.Observations ?? string.Empty
                })
                .ToList();
        }

        if (null == mvarSession)
            mvarNotify = await AuthClient.GetRegisterValue("prelogms", "");
        else
            mvarNotify = await AuthClient.GetRegisterValue("postlogms", "");
    }
}
