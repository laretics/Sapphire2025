@page "/auth/login"
@using Sapphire2026Clients
@inject IntStorageService mvarClientStorage
@inject AuthenticationClient mvarAuthenticationClient
@inject InteractiveService mvarInteractive
@inject NavigationManager mvarNavigator
@inject SessionService mvarSessionService
<PageTitle>@Prefs.T("auth.login.title")</PageTitle>

<div class="login-page">
	<div class="login-card card shadow border-0">
		<div class="login-card-header text-center">
			<img src="img/ZafiroTheme.jpg" alt="Zafiro" class="login-logo img-fluid rounded-3" />
			<h1 class="login-title h3 mt-3 mb-1">@Prefs.T("auth.login.title")</h1>
			<p class="text-muted small mb-0">@Prefs.T("auth.login.subtitle")</p>
			<div class="d-flex justify-content-center gap-2 mt-2">
				@foreach (UiLocale locale in UiLocales.All)
				{
					<button type="button"
							class="btn btn-sm @(Prefs.Locale == locale ? "btn-primary" : "btn-outline-secondary")"
							@onclick="() => Prefs.SetLocaleAsync(locale)">
						@UiLocales.NativeName(locale)
					</button>
				}
			</div>
		</div>

		<div class="card-body login-card-body">
			<EditForm Model="@mvarLoginModel" OnValidSubmit="LoginCall">
				<div class="mb-3">
					<label for="name" class="form-label">@Prefs.T("auth.login.id")</label>
					<InputText id="name"
							   @bind-Value="mvarLoginModel.userName"
							   class="form-control form-control-lg"
							   autocomplete="username"
							   inputmode="text"
							   aria-describedby="cfId"
							   placeholder="@Prefs.T("auth.login.id.ph")" />
					<div id="cfId" class="form-text">
						@Prefs.T("auth.login.id.hint")
					</div>
				</div>
				<div class="mb-4">
					<label for="pwd" class="form-label">@Prefs.T("auth.login.password")</label>
					<PasswordInput id="pwd"
								   @bind-Value="mvarLoginModel.password"
								   class="form-control form-control-lg"
								   autocomplete="current-password" />
				</div>
				<div class="d-grid gap-2">
					<Button Class="btn btn-primary btn-lg" @onclick="LoginCall">@Prefs.T("auth.login.submit")</Button>
					<button type="button" class="btn btn-outline-secondary" @onclick='() => mvarNavigator.NavigateTo("/")'>
						@Prefs.T("auth.login.back")
					</button>
				</div>
			</EditForm>
		</div>
	</div>
</div>

<ModalDialog @ref="mvarModal"/>

@code {
	SessionModel? mvarSession{ get; set; }
	private UserLoginModel mvarLoginModel = new UserLoginModel();

	private ModalDialog mvarModal { get; set; } = new ModalDialog();
	//Tras la autenticación, el servidor dará un token único a cada sesión.
	//Este es el token que vamos a usar encabezando cada petición para que el
	//servidor nos responda con datos correctos.

	protected override async Task OnInitializedAsync()
	{
		await Prefs.LoadLocalAsync();
	}

	private async Task LoginCall()
	{
		//Primero comprobamos si el password está vacío.
		if (null == mvarLoginModel.password)
			mvarLoginModel.password = string.Empty;

		bool auxPasswordVacio = await mvarAuthenticationClient.isEmptyPassword(mvarLoginModel);
		if(auxPasswordVacio)
		{
			//El password está vacío... voy a la página para asignar el password.
			mvarNavigator.NavigateTo(string.Format("/auth/setpassword/{0}", mvarLoginModel.userName));
		}
		else
		{
			mvarSession = await mvarAuthenticationClient.Login(mvarLoginModel);
			await mvarClientStorage.SetSessionInfo(mvarSession);
			if(null == mvarSession)
			{
				await mvarModal.show(Prefs.T("auth.login.error.title"), Prefs.T("auth.login.error"), Prefs.T("auth.ok"));
			}
			else
			{
				await Prefs.LoadFromServerAsync();
			}
			mvarSessionService.ResetAfterLogin();
			mvarInteractive.NotifyStateChanged();
			mvarNavigator.NavigateTo("/");
		}
		
	}
}
