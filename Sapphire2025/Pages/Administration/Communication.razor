@page "/communication"
@inject AuthenticationClient AuthClient
@inject AeneasClient AeneasClient
<PageTitle>@Prefs.T("page.comm")</PageTitle>

<div class="container py-4">
    <h2 class="mb-4">@Prefs.T("comm.messages")</h2>
    <EditForm Model="@this" OnValidSubmit="SaveMessages">
        <div class="mb-4">
            <label class="form-label fw-semibold" for="msgPreLogin">@Prefs.T("comm.pre")</label>
            <textarea id="msgPreLogin" class="form-control" rows="3" @bind="mvarMessagePreLogin"></textarea>
            <div class="form-text">@Prefs.T("comm.pre.hint")</div>
        </div>
        <div class="mb-4">
            <label class="form-label fw-semibold" for="msgPostLogin">@Prefs.T("comm.post")</label>
            <textarea id="msgPostLogin" class="form-control" rows="3" @bind="mvarMessagePostLogin"></textarea>
            <div class="form-text">@Prefs.T("comm.post.hint")</div>
        </div>
        <button type="submit" class="btn btn-primary mb-4">@Prefs.T("comm.save")</button>
        @if (!string.IsNullOrEmpty(EstadoGuardado))
        {
            <div class="alert alert-success mt-2">@EstadoGuardado</div>
        }
    </EditForm>

    <hr class="my-5" />

    <div class="mb-4">
        <label class="form-label fw-semibold" for="msgTelegram">@Prefs.T("comm.telegram")</label>
        <textarea id="msgTelegram" class="form-control" rows="2" @bind="MensajeTelegram"></textarea>
        <div class="form-text text-warning">
            <i class="bi bi-exclamation-triangle-fill"></i>
            @Prefs.T("comm.telegram.hint")
        </div>
        <button class="btn btn-success mt-2" @onclick="EnviarTelegram">@Prefs.T("comm.telegram.send")</button>
        @if (!string.IsNullOrEmpty(EstadoTelegram))
        {
            <div class="alert alert-info mt-2">@EstadoTelegram</div>
        }
    </div>
</div>

@code {
    // Mensajes persistentes
    public string? mvarMessagePreLogin { get; set; }
    public string? mvarMessagePostLogin{ get; set; }

    public string? EstadoGuardado { get; set; }

    // Mensaje Telegram
    public string? MensajeTelegram { get; set; }
    public string? EstadoTelegram { get; set; }

    protected override async Task OnInitializedAsync()
    {
        // Cargar mensajes desde la base de datos

        mvarMessagePreLogin = await AuthClient.GetRegisterValue("prelogms", "");
        mvarMessagePostLogin = await AuthClient.GetRegisterValue("postlogms", "");
    }

    private async Task SaveMessages()
    {
        if(null!=mvarMessagePreLogin)
            await AuthClient.SetRegisterValue("prelogms", mvarMessagePreLogin);
        if (null != mvarMessagePostLogin)
            await AuthClient.SetRegisterValue("postlogms", mvarMessagePostLogin);
        EstadoGuardado = Prefs.T("comm.saved");
    }

    private async Task EnviarTelegram()
    {
        if (!string.IsNullOrWhiteSpace(MensajeTelegram))
        {
            Sapphire2025Models.Common.UserRole[] roles =
            [
                Sapphire2025Models.Common.UserRole.Anonymous,
                Sapphire2025Models.Common.UserRole.Inspector,
                Sapphire2025Models.Common.UserRole.Mechanic,
                Sapphire2025Models.Common.UserRole.Engineer,
                Sapphire2025Models.Common.UserRole.Expert,
                Sapphire2025Models.Common.UserRole.Oficial,
                Sapphire2025Models.Common.UserRole.Root
            ];

            if (await AeneasClient.TelegramBroadcast(MensajeTelegram, false, roles))
                EstadoTelegram = "Mensaje enviado por Telegram.";
            else
                EstadoTelegram = "Error en el envío del mensaje";                

            MensajeTelegram = string.Empty;

        }
    }
}
