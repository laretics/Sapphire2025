@page "/admin/managetimenet"
@using TimeNetComponents.TreeView
@using Microsoft.AspNetCore.Components.Forms
@inject IJSRuntime mvarJS

<h3 class="mb-4">Time Net 2026</h3>
<style>
    #xml-editor {
        height: 55VH !important;
        min-height: 55VH !important;
        width: 100% !important;
    }
</style>
<TabControl>
    <TabPage Text="Calendario">
        <!-- Aquí puedes añadir calendario o resumen -->
    </TabPage>
    <TabPage Text="Planes">
        <!-- Aquí puedes añadir planes o tablas -->
    </TabPage>
    <TabPage Text="Topología">
        <TreeView>
            <!-- Aquí puedes mostrar la topología -->
        </TreeView>
    </TabPage>
    <TabPage Text="Upload">
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-info text-white">
                <strong>Subir y editar archivo XML</strong>
            </div>
            <div class="card-body">
                <InputFile OnChange="HandleFileSelected" accept=".xml" />
                <div class="btn-toolbar mb-3" role="toolbar">
                    <div class="btn-group me-2" role="group">                        
                        <button class="btn btn-outline-primary" @onclick="SaveXmlToLocal" title="Guardar archivo XML en el equipo">
                            <i class="bi bi-download"></i> Guardar local
                        </button>
                        <button class="btn btn-outline-secondary" @onclick="ClearEditor" title="Vaciar el editor">
                            <i class="bi bi-trash"></i> Vaciar editor
                        </button>
                    </div>
                </div>
                <StandaloneCodeEditor Id="xml-editor" ConstructionOptions="EditorConstructionOptions" />

                <button class="btn btn-success mt-3" @onclick="UploadXml" disabled="@string.IsNullOrWhiteSpace(xmlContent)">
                    <i class="bi bi-cloud-upload"></i> Guardar en base de datos
                </button>
                @if (uploadResult != null)
                {
                    <div class="alert alert-info mt-3">@uploadResult</div>
                }
            </div>
        </div>
    </TabPage>
</TabControl>
<script>
    window.downloadXmlFilePrompt = function (content, defaultName) {
        var filename = prompt("Nombre del archivo:", defaultName || "archivo.xml");
        if (!filename) return;
        const blob = new Blob([content], { type: "text/xml" });
        const link = document.createElement("a");
        link.href = URL.createObjectURL(blob);
        link.download = filename;
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);
        URL.revokeObjectURL(link.href);
    }
</script>

@code {
    private string? xmlContent;
    private string? uploadResult;
    private StandaloneCodeEditor? mvarEditor;
    private StandaloneEditorConstructionOptions EditorConstructionOptions(StandaloneCodeEditor editor)
    {
        mvarEditor = editor;
        return new StandaloneEditorConstructionOptions
        {
            AutomaticLayout = true,
            Language = "xml",
            Value = xmlContent ?? "",
            Theme="vs-dark"
        };
    }

    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file != null)
        {
            using var stream = file.OpenReadStream();
            using var reader = new StreamReader(stream);
            xmlContent = await reader.ReadToEndAsync();
            if (null != mvarEditor)
                await mvarEditor.SetValue(xmlContent);
        }
    }

    private void HandleEditorChanged(string value)
    {
        xmlContent = value;
    }

    private async Task SaveXmlToLocal()
    {
        if (!string.IsNullOrWhiteSpace(xmlContent))
            await mvarJS.InvokeVoidAsync("downloadXmlFilePrompt", xmlContent, "archivo.xml");
    }

    private async Task ClearEditor()
    {
        xmlContent = string.Empty;
        if (mvarEditor != null)
            await mvarEditor.SetValue("");
    }

    private async Task UploadXml()
    {
        // Aquí va la lógica para guardar el XML en la base de datos
        uploadResult = "Archivo XML guardado correctamente.";
        await Task.Delay(500); // Simula operación
    }
}
