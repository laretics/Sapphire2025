@page "/admin/manageworkshifts"
@using Microsoft.AspNetCore.Components.Forms;
@inject ExpertClient mvarExpertClient
@inject AuthenticationClient mvarAuthClient
@inject IntStorageService mvarStorage
@inject IJSRuntime mvarJSRuntime
<PageTitle>Gestión de Turnos</PageTitle>

<ModalDialog @ref="mvarModal" OnClose="OnModalClose" />

<div class="container-fluid py-4">
    <h2 class="mb-4">Gestión de Turnos del Personal</h2>
    <div class="row mb-3">
        <div class="col-auto">
            <button class="btn btn-primary" @onclick="onAssignationsClear">Limpiar Asignaciones</button>
        </div>
        <div class="col-auto">
            <button class="btn btn-secondary" @onclick="onAgentsListClear">Limpiar Lista de Agentes</button>
        </div>
        <div class="col-auto">
            <button class="btn btn-success" @onclick="onImportExcel">Importar Excel</button>
        </div>
        <div class="col-auto">
            <div class="form-check form-switch">
                <InputCheckbox @bind-Value="TelegramServerEnabled" class="form-check-input" id="telegramServerSwitch" />
                <label class="form-check-label ms-2" for="telegramServerSwitch">Telegram</label>
            </div>
        </div>
    </div>

    @if (mvarLoading)
    {
        <LoadingTab ElementText="@mvarLoadingString" />
    }
    else if (mcolPlanes is null)
    {
        <LoadingTab ElementText="Cargando planes de explotación" />
    }
    else if (!mcolPlanes.Any())
    {
        <ErrorTab Description="No hay turnos registrados."
                  Instructions="Importe turnos desde Excel o cree nuevos manualmente."
                  AlertColor="warning" />
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-bordered align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Autor</th>
                        <th>Inicio</th>
                        <th>Nombre</th>
                        <th>Notas</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in mcolPlanes)
                    {
                        <tr>
                            <td>@ownerName(item.Owner)</td>
                            <td>@Sapphire2025Models.Utils.autoDate(item.Begin)</td>
                            <td>@item.Name</td>
                            <td>@item.Comment</td>
                            <td>
                                <button class="btn btn-danger btn-sm"
                                        @onclick="() => ConfirmDelete(item.Id, item.Name)">
                                    Eliminar
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<InputFile style="display:none" @ref="mvarCBExcelInputRef" OnChange="onExcelImport" MaxAllowedSize="5242880" accept=".xlsx" />

@code {
    private ModalDialog mvarModal { get; set; } = new ModalDialog();
    private List<Sapphire2025Models.Expert.WorkShiftTemplateCollectionModel>? mcolPlanes;
    private Dictionary<Guid, Sapphire2025Models.Authentication.UserModelBase>? mcolUsers;
    private InputFile? mvarCBExcelInputRef;
    private bool mvarLoading;
    private string mvarLoadingString = "Procesando solicitud";
    private int mvarNumDay { get; set; } = 4;
    private bool mvarTelegramServerEnabled;
    private Guid? mvarDeleteId;
    private string? mvarDeleteName;

    private bool TelegramServerEnabled
    {
        get => mvarTelegramServerEnabled;
        set
        {
            if (value != mvarTelegramServerEnabled)
            {
                mvarTelegramServerEnabled = value;
                _ = mvarAuthClient.SetRegister("Telegram", mvarTelegramServerEnabled ? "true" : "false");
            }
        }
    }

    private string ownerName(Guid userId)
    {
        if (mcolUsers != null && mcolUsers.ContainsKey(userId))
        {
            var usuario = mcolUsers[userId];
            return $"{usuario.Name} ({usuario.CF})";
        }
        return "";
    }

    private async Task onAssignationsClear()
    {
        await mvarExpertClient.AssignationsClear();
        StateHasChanged();
    }
    private async Task onAgentsListClear()
    {
        await mvarExpertClient.AgentsListsClear();
        StateHasChanged();
    }
    private async Task onImportExcel()
    {
        if (mvarCBExcelInputRef != null)
            await mvarJSRuntime.InvokeVoidAsync("triggerFileInputClick", mvarCBExcelInputRef.Element);
    }
    private async Task onExcelImport(InputFileChangeEventArgs e)
    {
        mvarLoadingString = "Importando turnos desde Excel";
        mvarLoading = true;
        StateHasChanged();

        var archivo = e.File;
        if (archivo != null)
        {
            using var corriente = archivo.OpenReadStream(5242880);
            using var ms = new MemoryStream();
            await corriente.CopyToAsync(ms);
            var buffer = ms.ToArray();
            var fecha = DateTime.Today;
            var localZoneOffset = await GetTimezoneOffsetMinutes();
            var salida = await mvarJSRuntime.InvokeAsync<string>("excelInterop.extractWorksheetData", buffer, fecha.Month, fecha.Day, mvarNumDay);
            var salidaCompilacion = await mvarExpertClient.UploadDailyWorkShift(salida, fecha, mvarNumDay, localZoneOffset);
            if (!string.IsNullOrEmpty(salidaCompilacion))
                await mvarModal.show("Error de importación", salidaCompilacion, "Salir");
        }
        mvarLoading = false;
        StateHasChanged();
    }

    private async Task ConfirmDelete(Guid id, string name)
    {
        mvarDeleteId = id;
        mvarDeleteName = name;
        await mvarModal.show("Confirmar eliminación", $"¿Seguro que quieres eliminar el turno '{name}'?", "Eliminar", "Cancelar");
    }

    private async Task OnModalClose(bool result)
    {
        if (result && mvarDeleteId.HasValue)
        {
            await onDeleteWorkShiftTemplateCollection(mvarDeleteId.Value);
            mvarDeleteId = null;
            mvarDeleteName = null;
        }
    }

    private async Task onDeleteWorkShiftTemplateCollection(Guid id)
    {
        if (!await mvarExpertClient.DeletePlan(id))
        {
            await mvarModal.show("Error de borrado", "Ocurrió algún problema al procesar la orden de borrado", "Aceptar");
        }
        mcolPlanes = await mvarExpertClient.Plans();
        StateHasChanged();
    }

    protected override async Task OnInitializedAsync()
    {
        mcolPlanes = await mvarExpertClient.Plans();
        mcolUsers = await mvarStorage.GetUsersCache();
        var cadena = await mvarAuthClient.GetRegister("Telegram", "false");
        mvarTelegramServerEnabled = cadena?.Equals("true") ?? false;
    }
    private async Task<int> GetTimezoneOffsetMinutes()
    {
        return await mvarJSRuntime.InvokeAsync<int>("eval", "new Date().getTimezoneOffset()");
    }
}


