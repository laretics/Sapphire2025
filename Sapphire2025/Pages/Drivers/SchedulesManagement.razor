	/// <summary>
	/// Mapea un color hex al colorId más cercano de la paleta fija de Google Calendar (1–11).
	/// Útil como referencia; el importador web de Google no aplica colorId desde .ics.
	/// </summary>
	private static int MapHexToGoogleColorId(string hex)
	{
		// Paleta Google event colors (aprox. hex oficiales de la UI)
		(int id, int r, int g, int b)[] palette =
		{
			(1, 0xa4, 0xbd, 0xfc), // lavender
			(2, 0x7a, 0xe7, 0xbf), // sage
			(3, 0xdb, 0xad, 0xff), // grape
			(4, 0xff, 0x88, 0x7c), // flamingo
			(5, 0xfb, 0xd7, 0x5b), // banana
			(6, 0xff, 0xb8, 0x78), // tangerine
			(7, 0x46, 0xd6, 0xdb), // peacock
			(8, 0xe1, 0xe1, 0xe1), // graphite
			(9, 0x54, 0x84, 0xed), // blueberry
			(10, 0x51, 0xb7, 0x49), // basil
			(11, 0xdc, 0x21, 0x27), // tomato
		};

		if (!Sapphire2025Models.Utils.TryParseCssColor(hex, out int r, out int g, out int b))
			return 9;

		int bestId = 9;
		long bestDist = long.MaxValue;
		foreach (var p in palette)
		{
			long dr = r - p.r;
			long dg = g - p.g;
			long db = b - p.b;
			long dist = dr * dr + dg * dg + db * db;
			if (dist < bestDist)
			{
				bestDist = dist;
				bestId = p.id;
			}
		}
		return bestId;
	}

	private SlotStatus GetSlotStatus(TimeSpan start, TimeSpan end)
	{
		DateTime day = SelectedDate.Date;
		DateTime today = DateTime.Today;

		if (day < today)
			return SlotStatus.Past;
		if (day > today)
			return SlotStatus.Future;

		TimeSpan now = DateTime.Now.TimeOfDay;

		// Tramo que cruza medianoche (p. ej. 22:00→01:30): en el día del turno
		// solo resaltamos desde la hora de inicio; el tramo de madrugada
		// se interpreta al ver el día siguiente o como continuación del turno.
		if (end <= start)
		{
			if (now >= start)
				return SlotStatus.Current;
			return SlotStatus.Future;
		}

		if (now >= end)
			return SlotStatus.Past;
		if (now >= start)
			return SlotStatus.Current;
		return SlotStatus.Future;
	}

	private static string SlotCss(SlotStatus status)
		=> status switch
		{
			SlotStatus.Current => "is-current",
			SlotStatus.Past => "is-past",
			_ => "is-upcoming"
		};

	private static string SlotTitle(SlotStatus status, TimeSpan start, TimeSpan end)
		=> status switch
		{
			SlotStatus.Current => $"En curso ({Sapphire2025Models.Utils.autoInterval(start, true)}–{Sapphire2025Models.Utils.autoInterval(end, true)})",
			SlotStatus.Past => $"Realizado ({Sapphire2025Models.Utils.autoInterval(start, true)}–{Sapphire2025Models.Utils.autoInterval(end, true)})",
			_ => $"Pendiente ({Sapphire2025Models.Utils.autoInterval(start, true)}–{Sapphire2025Models.Utils.autoInterval(end, true)})"
		};

	private void EnsureClockTimer()
	{
		bool needTimer = SelectedDate.Date == DateTime.Today
			&& (SelectedTrains.Count > 0 || SelectedDepots.Count > 0);

		if (needTimer)
		{
			mvarClockTimer ??= new System.Threading.Timer(
				_ =>
				{
					_ = InvokeAsync(StateHasChanged);
				},
				null,
				TimeSpan.FromSeconds(20),
				TimeSpan.FromSeconds(20));
		}
		else
		{
			mvarClockTimer?.Dispose();
			mvarClockTimer = null;
		}
	}

	public void Dispose()
	{
		mvarClockTimer?.Dispose();
		mvarClockTimer = null;
	}

	private void SelectDayInternal(DateTime day, bool reloadIfOutside)
	{
		SelectedRow = AgentRows.FirstOrDefault(r => r.Date.Date == day.Date);
		SelectedTrains = new List<TrainWorkShiftContentModel>();
		SelectedDepots = new List<AttWorkShiftContentModel>();

		if (SelectedRow?.Template is AttTemplateModel att && null != att.Content)
		{
			SelectedTrains = att.Content
				.OfType<TrainWorkShiftContentModel>()
				.OrderBy(t => t.StartTime)
				.ToList();
			SelectedDepots = att.Content
				.OfType<AttWorkShiftContentModel>()
				.OrderBy(d => d.StartTime)
				.ToList();
		}

		EnsureClockTimer();

		if (reloadIfOutside
			&& null == SelectedRow
			&& null != ViewedUser
			&& (null == mvarTimeSlice
				|| day.Date < mvarTimeSlice.InitialDate.Date
				|| day.Date >= mvarTimeSlice.InitialDate.Date.AddDays(DayHorizon)))
		{
			_ = LoadRangeAsync(day);
		}
	}

	private bool IsSelectedRow(AgentDayRow row)
		=> null != SelectedRow && SelectedRow.Date.Date == row.Date.Date;

	private async Task QueryShiftAsync()
	{
		mvarQueryError = null;
		mvarQueryRan = false;
		QueryResults = new List<AssignationContentModel>();

		if (string.IsNullOrWhiteSpace(mvarQueryShift))
		{
			mvarQueryError = "Indica el código de turno.";
			return;
		}

		DateTime day = mvarQueryDate.Date;
		// Cargar día si no está en el rango
		List<AssignationContentModel>? dayAssignations;
		if (null != mvarTimeSlice
			&& day >= mvarTimeSlice.InitialDate.Date
			&& day < mvarTimeSlice.InitialDate.Date.AddDays(DayHorizon))
		{
			dayAssignations = mcolRangeAssignations
				.Where(a => a.Date.Date == day)
				.ToList();
		}
		else
		{
			dayAssignations = await mvarExpertClient.Assignations(day, 1);
		}

		string key = mvarQueryShift.Trim();
		QueryResults = (dayAssignations ?? new List<AssignationContentModel>())
			.Where(a => string.Equals(a.Definitive?.Trim(), key, StringComparison.OrdinalIgnoreCase))
			.OrderBy(a => GetUserDisplay(a.AgentId))
			.ToList();

		mvarQueryRan = true;

		await LogScheduleAsync(
			Common.sessionEventType.scheduleShiftQueried,
			$"día={day:yyyy-MM-dd}|turno={key}|resultados={QueryResults.Count}|cf={ViewedUser?.CF ?? "?"}");
	}

	private void OpenSwapDialog()
	{
		if (null == SelectedRow?.Assignation || null == ViewedUser) return;

		mvarSwapDate = SelectedRow.Date;
		mvarSwapOwnShift = SelectedRow.Assignation.Definitive;
		mvarSwapOwnTd = SelectedRow.Assignation.TD;
		mvarSwapOwnTemplate = SelectedRow.Template;
		mvarSwapTargetDisplay = string.Empty;
		mvarSwapTargetId = Guid.Empty;
		mvarSwapTargetShift = string.Empty;
		mvarSwapMessage = string.Empty;
		mvarShowSwapDialog = true;
	}

	private void OpenSwapDialogFor(AssignationContentModel hit)
	{
		mvarSwapDate = mvarQueryDate.Date;
		mvarSwapOwnShift = SelectedRow?.Assignation?.Definitive;
		mvarSwapOwnTd = SelectedRow?.Assignation?.TD ?? false;
		mvarSwapOwnTemplate = SelectedRow?.Template;
		mvarSwapTargetId = hit.AgentId;
		mvarSwapTargetDisplay = GetUserDisplay(hit.AgentId);
		mvarSwapTargetShift = hit.Definitive ?? mvarQueryShift;
		mvarSwapMessage = string.Empty;
		mvarShowSwapDialog = true;
	}

	private void CloseSwapDialog() => mvarShowSwapDialog = false;

	private async Task SubmitSwapSketchAsync()
	{
		mvarShowSwapDialog = false;

		await LogScheduleAsync(
			Common.sessionEventType.scheduleSwapRequested,
			$"día={mvarSwapDate:yyyy-MM-dd}|propio={mvarSwapOwnShift ?? "—"}|destino={mvarSwapTargetDisplay}|turno={mvarSwapTargetShift}|cf={ViewedUser?.CF ?? "?"}");

		await mvarModal.show(
			"Solicitud de cambio (esbozo)",
			"La petición de cambio de turno aún no está conectada al servidor. " +
			$"Cuando lo esté, se enviará a {mvarSwapTargetDisplay} y al Jefe de Maquinistas.\n\n" +
			$"Fecha: {mvarSwapDate:dd/MM/yyyy}\n" +
			$"Tu turno: {mvarSwapOwnShift}\n" +
			$"Turno solicitado: {mvarSwapTargetShift}\n" +
			$"Mensaje: {mvarSwapMessage}",
			"Entendido",
			"Cerrar");
	}

