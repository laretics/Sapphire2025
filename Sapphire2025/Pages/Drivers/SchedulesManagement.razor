@page "/drivers/schedules"
@using System.Text
@using Sapphire2025.Layout.Expert
@using Sapphire2025Models
@using Sapphire2025Models.Expert.WorkshiftTemplates
@implements IDisposable
@inject ExpertClient mvarExpertClient
@inject AuthenticationClient mvarAuthClient
@inject IntStorageService mvarIntStorage
@inject IJSRuntime mvarJS

<PageTitle>Mi cuadrante</PageTitle>
<ModalDialog @ref="mvarModal" />

<div class="sched-page @(mvarMobilePanel.ToString().ToLowerInvariant())">
	@* —— Barra de desarrollo / identidad (solo administradores Root) —— *@
	@if (IsAdmin)
	{
		<div class="sched-dev-bar card border-0 shadow-sm mb-2 mb-md-3">
			<div class="card-body py-2 px-3">
				<div class="sched-dev-row">
					<div class="sched-dev-label text-muted small text-uppercase fw-semibold">Vista como</div>
					<div class="input-group input-group-sm sched-cf-group">
						<span class="input-group-text">CF</span>
						<input type="text"
							   class="form-control"
							   @bind="mvarCfInput"
							   @bind:event="oninput"
							   placeholder="ej. 196"
							   maxlength="8"
							   inputmode="numeric"
							   autocomplete="off"
							   title="CF del maquinista a simular (solo desarrollo)" />
						<button type="button" class="btn btn-outline-primary" @onclick="ApplyCfAsync">Ver</button>
					</div>
					@if (null != ViewedUser)
					{
						<div class="sched-user-chip">
							<span class="fw-semibold text-truncate">(@ViewedUser.CF) @ViewedUser.Name</span>
							@if (IsImpersonating)
							{
								<span class="badge bg-warning text-dark">Simulación</span>
							}
						</div>
					}
					else if (!string.IsNullOrWhiteSpace(mvarCfError))
					{
						<span class="text-danger small">@mvarCfError</span>
					}
					<button type="button"
							class="btn btn-sm btn-outline-secondary sched-my-user-btn"
							@onclick="UseMyUserAsync"
							title="Usar el usuario de la sesión actual">
						Mi usuario
					</button>
				</div>
			</div>
		</div>
	}

	@if (mvarLoading)
	{
		<LoadingTab ElementText="@mvarLoadingText" />
	}
	else if (null == ViewedUser)
	{
		<div class="alert alert-info">
			Indica un <strong>CF</strong> de maquinista (p. ej. 196) para cargar su gráfico, o pulsa <em>Mi usuario</em>.
		</div>
	}
	else
	{
		@* Navegación inferior / superior solo en pantallas reducidas *@
		<nav class="sched-mobile-nav" aria-label="Secciones del cuadrante">
			<button type="button"
					class="sched-mobile-tab @(mvarMobilePanel == MobilePanel.Assignations ? "active" : null)"
					@onclick="() => SetMobilePanel(MobilePanel.Assignations)">
				<span class="sched-mobile-tab-icon" aria-hidden="true">☰</span>
				<span class="sched-mobile-tab-label">Gráfico</span>
			</button>
			<button type="button"
					class="sched-mobile-tab @(mvarMobilePanel == MobilePanel.Day ? "active" : null)"
					@onclick="() => SetMobilePanel(MobilePanel.Day)">
				<span class="sched-mobile-tab-icon" aria-hidden="true">◎</span>
				<span class="sched-mobile-tab-label">Turnos</span>
				@if (null != SelectedRow?.Assignation)
				{
					<span class="sched-mobile-tab-chip"
						  style="@GetTemplateStyle(SelectedRow.Template, SelectedRow.Assignation.TD)">
						@SelectedRow.Assignation.Definitive
					</span>
				}
			</button>
			<button type="button"
					class="sched-mobile-tab @(mvarMobilePanel == MobilePanel.Query ? "active" : null)"
					@onclick="() => SetMobilePanel(MobilePanel.Query)">
				<span class="sched-mobile-tab-icon" aria-hidden="true">⌕</span>
				<span class="sched-mobile-tab-label">Consulta</span>
			</button>
		</nav>

		<div class="sched-grid" data-active-panel="@mvarMobilePanel">
			@* ========== IZQUIERDA: asignaciones ========== *@
			<section class="sched-panel sched-panel-left card shadow-sm border-0 @(mvarMobilePanel == MobilePanel.Assignations ? "sched-panel-active" : null)">
				<div class="card-header bg-white border-bottom sched-panel-header">
					<div class="d-flex flex-wrap align-items-start justify-content-between gap-2">
						<div>
							<div class="fw-semibold">Mi gráfico</div>
							<div class="small text-muted">@RangeLabel</div>
						</div>
						<button type="button"
								class="btn btn-outline-success btn-sm sched-touch-btn sched-export-btn"
								disabled="@(AgentRows.Count == 0)"
								title="Descargar el periodo visible como calendario (.ics) para Google Calendar, Outlook, etc."
								@onclick="ExportIcsAsync">
							<span class="sched-export-icon" aria-hidden="true">⬇</span>
							Exportar .ics
						</button>
					</div>
				</div>
				<div class="card-body p-0 sched-panel-scroll">
					@if (AgentRows.Count == 0)
					{
						<div class="p-3 text-muted small">No hay turnos.</div>
					}
					else
					{
						@* Lista táctil (móvil / tablet estrecha) *@
						<div class="sched-day-cards">
							@foreach (AgentDayRow row in AgentRows)
							{
								<button type="button"
										class="sched-day-card @(IsSelectedRow(row) ? "selected" : null) @(row.IsToday ? "today" : null)"
										@onclick="() => SelectDayFromList(row.Date)">
									<div class="sched-day-card-date">
										<span class="sched-day-card-dow">@DayName(row.Date)</span>
										<span class="sched-day-card-num">@row.Date.ToString("dd")</span>
										<span class="sched-day-card-mon">@row.Date.ToString("MMM")</span>
									</div>
									<div class="sched-day-card-body">
										@if (null != row.Assignation)
										{
											<div class="d-flex align-items-center flex-wrap gap-1">
												<span class="sched-shift-badge"
													  style="@GetTemplateStyle(row.Template, row.Assignation.TD)">
													@(row.Assignation.Definitive ?? "—")
												</span>
												@if (row.Assignation.TD)
												{
													<span class="badge text-bg-success">TD</span>
												}
												@if (row.Assignation.SwappingAgent != Guid.Empty)
												{
													<span class="badge text-bg-info">Cambio</span>
												}
											</div>
											@if (row.Template is AttTemplateModel attCard)
											{
												<div class="sched-day-card-time">
													@Sapphire2025Models.Utils.autoInterval(attCard.StartTime, true)–@Sapphire2025Models.Utils.autoInterval(attCard.EndTime, true)
													<span class="text-muted"> · @Sapphire2025Models.Utils.autoInterval(attCard.Duration, false)</span>
												</div>
											}
											@if (!string.IsNullOrWhiteSpace(FormatAssignationNote(row.Assignation.Comment)))
											{
												<div class="sched-day-card-note text-truncate">@FormatAssignationNote(row.Assignation.Comment)</div>
											}
										}
										else
										{
											<span class="text-muted">Sin asignación</span>
										}
									</div>
									<span class="sched-day-card-chevron" aria-hidden="true">›</span>
								</button>
							}
						</div>

						@* Tabla densa (escritorio) *@
						<table class="table table-sm table-hover mb-0 sched-assign-table">
							<thead class="table-light sticky-top">
								<tr>
									<th>Día</th>
									<th>Turno</th>
									<th class="d-none d-xl-table-cell">Horario</th>
									<th class="d-none d-xxl-table-cell">Notas</th>
								</tr>
							</thead>
							<tbody>
								@foreach (AgentDayRow row in AgentRows)
								{
									<tr class="@(IsSelectedRow(row) ? "sched-row-selected" : null) @(row.IsToday ? "sched-row-today" : null)"
										@onclick="() => SelectDay(row.Date)"
										style="cursor: pointer;">
										<td class="sched-day-cell">
											<div class="fw-semibold">@row.Date.ToString("dd/MM")</div>
											<div class="small text-muted text-uppercase">@DayName(row.Date)</div>
										</td>
										<td>
											@if (null != row.Assignation)
											{
												<span class="sched-shift-badge"
													  style="@GetTemplateStyle(row.Template, row.Assignation.TD)"
													  title="@(row.Assignation.AssignationsChain ?? row.Assignation.Definitive)">
													@(row.Assignation.Definitive ?? "—")
												</span>
												@if (row.Assignation.TD)
												{
													<span class="badge bg-success-subtle text-success border ms-1" title="Turno en descanso">TD</span>
												}
												@if (row.Assignation.SwappingAgent != Guid.Empty)
												{
													<span class="badge bg-info-subtle text-info border ms-1" title="@GetUserName(row.Assignation.SwappingAgent)">Cambio</span>
												}
												@if (!string.IsNullOrWhiteSpace(row.Template?.comment))
												{
													<div class="smallest text-muted mt-1">@row.Template.comment</div>
												}
											}
											else
											{
												<span class="text-muted">—</span>
											}
										</td>
										<td class="d-none d-xl-table-cell small">
											@if (row.Template is AttTemplateModel att)
											{
												@($"{Sapphire2025Models.Utils.autoInterval(att.StartTime, true)}–{Sapphire2025Models.Utils.autoInterval(att.EndTime, true)}")
												<div class="text-muted">@Sapphire2025Models.Utils.autoInterval(att.Duration, false)</div>
											}
										</td>
										<td class="d-none d-xxl-table-cell small text-muted">
											@(FormatAssignationNote(row.Assignation?.Comment))
										</td>
									</tr>
								}
							</tbody>
						</table>
					}
				</div>
			</section>

			@* ========== CENTRO: fecha + trenes del turno ========== *@
			<section class="sched-panel sched-panel-center card shadow-sm border-0 @(mvarMobilePanel == MobilePanel.Day ? "sched-panel-active" : null)">
				<div class="card-header bg-white border-bottom sched-panel-header">
					<div class="fw-semibold mb-2">Día</div>
					<div class="sched-datepicker-wrap">
						<DateTimePicker @bind-SelectedDate="SelectedDate" />
					</div>
				</div>
				<div class="card-body sched-panel-scroll">
					@if (null == SelectedRow)
					{
						<div class="sched-empty-state">
							<div class="sched-empty-icon" aria-hidden="true">◎</div>
							<p class="text-muted small mb-0">Selecciona un día en la lista o con el selector de fecha.</p>
						</div>
					}
					else
					{
						<div class="sched-day-hero mb-3">
							<div class="sched-day-hero-top">
								<div class="sched-day-hero-text">
									<span class="sched-day-kicker">Jornada</span>
									<span class="sched-day-title">@SelectedDate.ToString("dddd d MMMM yyyy")</span>
								</div>
								@if (null != SelectedRow.Assignation)
								{
									<span class="sched-shift-badge sched-shift-badge-lg sched-shift-badge-glow"
										  style="@GetTemplateStyle(SelectedRow.Template, SelectedRow.Assignation.TD)">
										@(SelectedRow.Assignation.Definitive ?? "—")
									</span>
								}
							</div>
							@if (SelectedRow.Template is AttTemplateModel selAtt)
							{
								<div class="sched-day-hero-meta">
									<span class="sched-meta-chip">
										<span class="sched-meta-chip-label">Horario</span>
										<span class="sched-meta-chip-value">
											@Sapphire2025Models.Utils.autoInterval(selAtt.StartTime, true)–@Sapphire2025Models.Utils.autoInterval(selAtt.EndTime, true)
										</span>
									</span>
									<span class="sched-meta-chip">
										<span class="sched-meta-chip-label">Duración</span>
										<span class="sched-meta-chip-value">@Sapphire2025Models.Utils.autoInterval(selAtt.Duration, false)</span>
									</span>
									@if (SelectedTrains.Count > 0)
									{
										<span class="sched-meta-chip">
											<span class="sched-meta-chip-label">Trenes</span>
											<span class="sched-meta-chip-value">@SelectedTrains.Count</span>
										</span>
									}
								</div>
							}
							else if (null != SelectedRow.Assignation)
							{
								<div class="sched-day-hero-hint">Sin horario de trabajo (descanso / licencia / vacaciones).</div>
							}
							else
							{
								<div class="sched-day-hero-hint">Sin turno grafiado este día.</div>
							}
							@if (!string.IsNullOrWhiteSpace(FormatAssignationNote(SelectedRow.Assignation?.Comment)))
							{
								<div class="sched-jm-note mt-2">
									<span class="sched-jm-note-label">Nota JM</span>
									<span class="sched-jm-note-text">@FormatAssignationNote(SelectedRow.Assignation?.Comment)</span>
								</div>
							}
							<div class="sched-day-hero-actions">
								@if (SelectedTrains.Count > 0 || SelectedDepots.Count > 0)
								{
									<button type="button"
											class="btn btn-outline-success btn-sm mt-3 sched-touch-btn sched-export-day-btn"
											title="Descargar trenes y depósitos de este turno como calendario (.ics)"
											@onclick="ExportDayShiftIcsAsync">
										<span class="sched-export-icon" aria-hidden="true">⬇</span>
										Exportar trenes .ics
									</button>
								}
								@if (SelectedRow.Assignation is not null && SelectedRow.Template is AttTemplateModel)
								{
									<button type="button"
											class="btn btn-primary btn-sm mt-3 sched-touch-btn sched-swap-cta"
											@onclick="OpenSwapDialog">
										Pedir cambio de turno…
									</button>
								}
							</div>
							@if (IsSelectedDayTimelineActive)
							{
								<div class="sched-live-hint mt-2">
									<span class="sched-live-dot" aria-hidden="true"></span>
									Resalte en vivo · @DateTime.Now.ToString("HH:mm")
								</div>
							}
						</div>

						@if (SelectedTrains.Count == 0 && SelectedDepots.Count == 0)
						{
							<div class="sched-section">
								<div class="sched-section-head">
									<h6 class="sched-section-title">Circulaciones del turno</h6>
								</div>
								<p class="text-muted small mb-0">No hay trenes ni depósitos asociados a este turno.</p>
							</div>
						}
						else
						{
							@if (SelectedTrains.Count > 0)
							{
								<div class="sched-section">
									<div class="sched-section-head">
										<h6 class="sched-section-title">Circulaciones del turno</h6>
										<div class="d-flex align-items-center gap-2">
											<span class="sched-section-count">@SelectedTrains.Count</span>
											<button type="button"
													class="btn btn-outline-success btn-sm sched-export-mini"
													title="Exportar trenes y depósitos de este turno a .ics"
													@onclick="ExportDayShiftIcsAsync">
												.ics
											</button>
										</div>
									</div>
									<div class="sched-content-list">
										@foreach (TrainWorkShiftContentModel train in SelectedTrains)
										{
											var slot = GetSlotStatus(train.StartTime, train.EndTime);
											<div class="sched-train-card @SlotCss(slot)"
												 style="@GetTrainColorStyle(train)"
												 title="@SlotTitle(slot, train.StartTime, train.EndTime)">
												<div class="sched-train-rail" aria-hidden="true"></div>
												<div class="sched-train-body">
													<div class="sched-train-main">
														<span class="sched-train-number">@train.TrainId</span>
														@if (slot == SlotStatus.Current)
														{
															<span class="sched-pill sched-pill-live">En curso</span>
														}
														else if (slot == SlotStatus.Past)
														{
															<span class="sched-pill sched-pill-done">Hecho</span>
														}
														@if (train.Discrectional)
														{
															<span class="sched-pill sched-pill-optional">Opcional</span>
														}
													</div>
													<div class="sched-train-time">
														<span class="sched-time-start">@Sapphire2025Models.Utils.autoInterval(train.StartTime, true)</span>
														<span class="sched-time-sep" aria-hidden="true">→</span>
														<span class="sched-time-end">@Sapphire2025Models.Utils.autoInterval(train.EndTime, true)</span>
													</div>
												</div>
											</div>
										}
									</div>
								</div>
							}
							@if (SelectedDepots.Count > 0)
							{
								<div class="sched-section @(SelectedTrains.Count > 0 ? "mt-3" : null)">
									<div class="sched-section-head">
										<h6 class="sched-section-title">Depósitos / disponibilidad</h6>
										<span class="sched-section-count">@SelectedDepots.Count</span>
									</div>
									<div class="sched-content-list">
										@foreach (AttWorkShiftContentModel depot in SelectedDepots)
										{
											var slot = GetSlotStatus(depot.StartTime, depot.EndTime);
											<div class="sched-depot-card @(depot.Foreign ? "is-foreign" : null) @SlotCss(slot)"
												 title="@SlotTitle(slot, depot.StartTime, depot.EndTime)">
												<div class="sched-depot-icon" aria-hidden="true">▣</div>
												<div class="sched-depot-body">
													<div class="sched-depot-time">
														@Sapphire2025Models.Utils.autoInterval(depot.StartTime, true)–@Sapphire2025Models.Utils.autoInterval(depot.EndTime, true)
													</div>
													<div class="sched-depot-meta">
														<span>@Sapphire2025Models.Utils.autoInterval(depot.Duration, false)</span>
														@if (slot == SlotStatus.Current)
														{
															<span class="sched-pill sched-pill-live">En curso</span>
														}
														else if (slot == SlotStatus.Past)
														{
															<span class="sched-pill sched-pill-done">Hecho</span>
														}
														@if (depot.Foreign)
														{
															<span class="sched-pill sched-pill-foreign">Fuera</span>
														}
														else
														{
															<span class="sched-pill sched-pill-depot">Depósito</span>
														}
													</div>
												</div>
											</div>
										}
									</div>
								</div>
							}
						}
					}
				</div>
			</section>

			@* ========== DERECHA: consulta + cambio ========== *@
			<section class="sched-panel sched-panel-right card shadow-sm border-0 @(mvarMobilePanel == MobilePanel.Query ? "sched-panel-active" : null)">
				<div class="card-header bg-white border-bottom sched-panel-header">
					<div class="fw-semibold">Consultas</div>
					<div class="small text-muted">Quién hace un turno</div>
				</div>
				<div class="card-body sched-panel-scroll">
					<div class="mb-3">
						<label class="form-label small fw-semibold mb-1">Fecha</label>
						<InputDate class="form-control form-control-sm sched-touch-input" @bind-Value="mvarQueryDate" />
					</div>
					<div class="mb-3">
						<label class="form-label small fw-semibold mb-1">Turno</label>
						<div class="input-group input-group-sm sched-query-input-group">
							<input type="text"
								   class="form-control sched-touch-input"
								   @bind="mvarQueryShift"
								   @bind:event="oninput"
								   placeholder="ej. 3, 1f, DD…"
								   list="sched-shift-suggestions"
								   autocomplete="off" />
							<button type="button" class="btn btn-primary sched-touch-btn" @onclick="QueryShiftAsync">Buscar</button>
						</div>
						<datalist id="sched-shift-suggestions">
							@foreach (string name in ShiftSuggestions)
							{
								<option value="@name"></option>
							}
						</datalist>
					</div>

					@if (!string.IsNullOrWhiteSpace(mvarQueryError))
					{
						<div class="alert alert-warning py-2 small">@mvarQueryError</div>
					}

					@if (mvarQueryRan)
					{
						<div class="sched-query-result">
							<div class="small text-muted mb-2">
								Resultado para <strong>@mvarQueryShift</strong> el @mvarQueryDate.ToString("dd/MM/yyyy")
							</div>
							@if (QueryResults.Count == 0)
							{
								<div class="text-muted small">Nadie asignado a ese turno ese día (o turno no grafiado).</div>
							}
							else
							{
								<ul class="list-group list-group-flush sched-query-list">
									@foreach (AssignationContentModel hit in QueryResults)
									{
										<li class="list-group-item px-0 sched-query-item">
											<div class="sched-query-item-main">
												<div class="fw-semibold">@GetUserDisplay(hit.AgentId)</div>
												@if (!string.IsNullOrWhiteSpace(FormatAssignationNote(hit.Comment)))
												{
													<div class="small text-muted">@FormatAssignationNote(hit.Comment)</div>
												}
											</div>
											@if (hit.AgentId != ViewedUser?.guid)
											{
												<button type="button"
														class="btn btn-outline-primary btn-sm sched-touch-btn"
														@onclick="() => OpenSwapDialogFor(hit)">
													Pedir cambio
												</button>
											}
											else
											{
												<span class="badge text-bg-light border align-self-center">Tú</span>
											}
										</li>
									}
								</ul>
							}
						</div>
					}

					<hr class="my-3" />
					<div class="small text-muted">
						<strong>Próximamente:</strong> el cambio de turno se enviará al otro maquinista y al JM.
						De momento puedes esbozar la solicitud con el diálogo.
					</div>
				</div>
			</section>
		</div>
	}
</div>

@* —— Diálogo esbozo: petición de cambio de turno —— *@
@if (mvarShowSwapDialog)
{
	<div class="modal fade show d-block sched-swap-overlay" tabindex="-1" style="background-color: rgba(0,0,0,0.45);">
		<div class="modal-dialog modal-dialog-centered modal-dialog-scrollable sched-swap-dialog">
			<div class="modal-content shadow">
				<div class="modal-header">
					<h5 class="modal-title">Pedir cambio de turno</h5>
					<button type="button" class="btn-close" @onclick="CloseSwapDialog"></button>
				</div>
				<div class="modal-body">
					<p class="small text-muted">
						Esbozo de la petición. Aún no se envía al servidor.
					</p>
					<div class="mb-2">
						<label class="form-label small fw-semibold">Tu turno</label>
						<div>
							<span class="sched-shift-badge"
								  style="@GetTemplateStyle(mvarSwapOwnTemplate, mvarSwapOwnTd)">
								@(mvarSwapOwnShift ?? "—")
