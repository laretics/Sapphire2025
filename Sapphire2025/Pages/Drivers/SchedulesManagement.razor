	private int CountExportableRows()
		=> AgentRows.Count(r => r.Assignation is not null && !string.IsNullOrWhiteSpace(r.Assignation.Definitive));

	private string BuildIcsCalendar()
	{
		StringBuilder sb = new StringBuilder();
		string cf = ViewedUser?.CF ?? "?";
		string name = ViewedUser?.Name ?? "Maquinista";
		string calName = EscapeIcsText($"Cuadrante ({cf}) {name}");
		DateTime stamp = DateTime.UtcNow;

		sb.AppendLine("BEGIN:VCALENDAR");
		sb.AppendLine("VERSION:2.0");
		sb.AppendLine("PRODID:-//Sapphire//Cuadrante Maquinistas//ES");
		sb.AppendLine("CALSCALE:GREGORIAN");
		sb.AppendLine("METHOD:PUBLISH");
		sb.AppendLine($"X-WR-CALNAME:{calName}");
		sb.AppendLine("X-WR-TIMEZONE:Europe/Madrid");

		foreach (AgentDayRow row in AgentRows)
		{
			if (row.Assignation is null || string.IsNullOrWhiteSpace(row.Assignation.Definitive))
				continue;

			AppendIcsEvent(sb, row, stamp);
		}

		sb.AppendLine("END:VCALENDAR");
		return sb.ToString();
	}

	private void AppendIcsEvent(StringBuilder sb, AgentDayRow row, DateTime stampUtc)
	{
		string definitive = row.Assignation!.Definitive!.Trim();
		string uid = $"sapphire-sched-{SanitizeFilePart(ViewedUser?.CF)}-{row.Date:yyyyMMdd}-{SanitizeFilePart(definitive)}@sapphire.local";
		string summary;
		string description = BuildEventDescription(row);

		sb.AppendLine("BEGIN:VEVENT");
		sb.AppendLine($"UID:{uid}");
		sb.AppendLine($"DTSTAMP:{stampUtc:yyyyMMdd'T'HHmmss'Z'}");

		if (row.Template is AttTemplateModel att)
		{
			// Turno de trabajo / depósito: evento con hora (hora local Europe/Madrid)
			DateTime start = row.Date.Date.Add(att.StartTime);
			DateTime end = row.Date.Date.Add(att.EndTime);
			if (end <= start)
				end = end.AddDays(1); // turno que cruza medianoche

			summary = EscapeIcsText($"Turno {definitive}");
			sb.AppendLine($"DTSTART;TZID=Europe/Madrid:{start:yyyyMMdd'T'HHmmss}");
			sb.AppendLine($"DTEND;TZID=Europe/Madrid:{end:yyyyMMdd'T'HHmmss}");
		}
		else
		{
			// Descanso, licencia, vacaciones…: todo el día
			summary = EscapeIcsText(BuildRestSummary(definitive));
			sb.AppendLine($"DTSTART;VALUE=DATE:{row.Date:yyyyMMdd}");
			sb.AppendLine($"DTEND;VALUE=DATE:{row.Date.AddDays(1):yyyyMMdd}");
			sb.AppendLine("TRANSP:TRANSPARENT");
		}

		sb.AppendLine($"SUMMARY:{summary}");
		if (!string.IsNullOrWhiteSpace(description))
			sb.AppendLine($"DESCRIPTION:{EscapeIcsText(description)}");
		sb.AppendLine("END:VEVENT");
	}

	private static string BuildRestSummary(string definitive)
	{
		string code = definitive.Trim().ToUpperInvariant();
		return code switch
		{
			"D" => "Descanso (D)",
			"DD" => "Descanso disponible (DD)",
			"V" or "VA" => $"Vacaciones ({code})",
			"E" => "Enfermedad (E)",
			"I" => "Indisposición (I)",
			"LEF" => "LEF",
			_ => definitive
		};
	}

	private string BuildEventDescription(AgentDayRow row)
	{
		StringBuilder desc = new StringBuilder();
		string definitive = row.Assignation?.Definitive?.Trim() ?? "";
		desc.AppendLine($"Turno: {definitive}");
		desc.AppendLine($"Fecha: {row.Date:dd/MM/yyyy}");
		desc.AppendLine($"Agente: ({ViewedUser?.CF}) {ViewedUser?.Name}");

		if (row.Template is AttTemplateModel att)
		{
			desc.AppendLine($"Horario: {Sapphire2025Models.Utils.autoInterval(att.StartTime, true)} – {Sapphire2025Models.Utils.autoInterval(att.EndTime, true)} ({Sapphire2025Models.Utils.autoInterval(att.Duration, false)})");
			if (!string.IsNullOrWhiteSpace(att.comment))
				desc.AppendLine($"Plantilla: {att.comment}");

			if (null != att.Content)
			{
				var trains = att.Content.OfType<TrainWorkShiftContentModel>().OrderBy(t => t.StartTime).ToList();
				if (trains.Count > 0)
				{
					desc.AppendLine("Circulaciones:");
					foreach (var t in trains)
					{
						string opt = t.Discrectional ? " (opcional)" : "";
						desc.AppendLine($"  · {t.TrainId} {Sapphire2025Models.Utils.autoInterval(t.StartTime, true)}-{Sapphire2025Models.Utils.autoInterval(t.EndTime, true)}{opt}");
					}
				}

				var depots = att.Content.OfType<AttWorkShiftContentModel>().OrderBy(d => d.StartTime).ToList();
				if (depots.Count > 0)
				{
					desc.AppendLine("Depósitos:");
					foreach (var d in depots)
					{
						string fu = d.Foreign ? " (fuera)" : "";
						desc.AppendLine($"  · {Sapphire2025Models.Utils.autoInterval(d.StartTime, true)}-{Sapphire2025Models.Utils.autoInterval(d.EndTime, true)}{fu}");
					}
				}
			}
		}

		if (row.Assignation?.TD == true)
			desc.AppendLine("TD: turno en descanso");
		string? note = FormatAssignationNote(row.Assignation?.Comment);
		if (!string.IsNullOrWhiteSpace(note))
			desc.AppendLine($"Nota JM: {note}");
		if (row.Assignation?.SwappingAgent is Guid swap && swap != Guid.Empty)
			desc.AppendLine($"Cambio con: {GetUserName(swap)}");

		desc.Append("Generado por Sapphire");
		return desc.ToString().TrimEnd();
	}

	/// <summary>Escapa texto para propiedades de texto ICS (RFC 5545).</summary>
	private static string EscapeIcsText(string? text)
	{
		if (string.IsNullOrEmpty(text)) return string.Empty;
		return text
			.Replace("\\", "\\\\")
			.Replace(";", "\\;")
			.Replace(",", "\\,")
			.Replace("\r\n", "\\n")
			.Replace("\n", "\\n")
			.Replace("\r", "\\n");
	}

	private static string SanitizeFilePart(string? value)
	{
		if (string.IsNullOrWhiteSpace(value)) return "x";
		char[] invalid = Path.GetInvalidFileNameChars();
		StringBuilder sb = new StringBuilder(value.Length);
		foreach (char c in value.Trim())
		{
			if (invalid.Contains(c) || c == ' ')
				sb.Append('_');
			else
				sb.Append(c);
		}
		return sb.Length == 0 ? "x" : sb.ToString();
	}

	/// <summary>
	/// De la nota del turno solo se muestra lo que hay a partir del marcador "nnn"
	/// (sin distinguir mayúsculas/minúsculas). Si no hay marcador, no se muestra nada.
	/// </summary>
	private static string? FormatAssignationNote(string? raw)
	{
		if (string.IsNullOrWhiteSpace(raw))
			return null;

		const string marker = "nnn";
		int idx = raw.IndexOf(marker, StringComparison.OrdinalIgnoreCase);
		if (idx < 0)
			return null;

		string rest = raw.Substring(idx + marker.Length).Trim();
		return string.IsNullOrWhiteSpace(rest) ? null : rest;
	}

	private string BuildDayShiftIcsCalendar()
	{
		StringBuilder sb = new StringBuilder();
		string cf = ViewedUser?.CF ?? "?";
		string name = ViewedUser?.Name ?? "Maquinista";
		string definitive = SelectedRow?.Assignation?.Definitive?.Trim() ?? "turno";
		DateTime day = SelectedRow?.Date.Date ?? SelectedDate.Date;
		string calName = EscapeIcsText($"Turno {definitive} ({cf}) {day:dd/MM/yyyy} — {name}");
		DateTime stamp = DateTime.UtcNow;

		sb.AppendLine("BEGIN:VCALENDAR");
		sb.AppendLine("VERSION:2.0");
		sb.AppendLine("PRODID:-//Sapphire//Turno del día//ES");
		sb.AppendLine("CALSCALE:GREGORIAN");
		sb.AppendLine("METHOD:PUBLISH");
		sb.AppendLine($"X-WR-CALNAME:{calName}");
		sb.AppendLine("X-WR-TIMEZONE:Europe/Madrid");

		int idx = 0;
		foreach (TrainWorkShiftContentModel train in SelectedTrains)
		{
			idx++;
			string color = GetTrainAccentColor(train);
			string category = GetTrainCategory(train);
			string summary = EscapeIcsText($"Tren {train.TrainId}" + (train.Discrectional ? " (opc.)" : ""));
			string desc = BuildTrainEventDescription(train, definitive, day);
			string uid = $"sapphire-train-{SanitizeFilePart(cf)}-{day:yyyyMMdd}-{SanitizeFilePart(train.TrainId)}-{idx}@sapphire.local";
			AppendTimedIcsEvent(sb, uid, stamp, day, train.StartTime, train.EndTime, summary, desc, color, category);
		}

		idx = 0;
		foreach (AttWorkShiftContentModel depot in SelectedDepots)
		{
			idx++;
			string color = depot.Foreign ? "#fbbf24" : "#818cf8";
			string category = depot.Foreign ? "DepositoFuera" : "Deposito";
			string summary = EscapeIcsText(depot.Foreign ? "Depósito (fuera)" : "Depósito / disponibilidad");
			string desc = BuildDepotEventDescription(depot, definitive, day);
			string uid = $"sapphire-depot-{SanitizeFilePart(cf)}-{day:yyyyMMdd}-{idx}@sapphire.local";
			AppendTimedIcsEvent(sb, uid, stamp, day, depot.StartTime, depot.EndTime, summary, desc, color, category);
		}

		sb.AppendLine("END:VCALENDAR");
		return sb.ToString();
	}

	private void AppendTimedIcsEvent(
		StringBuilder sb,
		string uid,
		DateTime stampUtc,
		DateTime day,
		TimeSpan startTs,
		TimeSpan endTs,
		string summaryEscaped,
		string description,
		string? colorHex,
		string? category)
	{
		DateTime start = day.Date.Add(startTs);
		DateTime end = day.Date.Add(endTs);
		if (end <= start)
			end = end.AddDays(1);

		sb.AppendLine("BEGIN:VEVENT");
		sb.AppendLine($"UID:{uid}");
		sb.AppendLine($"DTSTAMP:{stampUtc:yyyyMMdd'T'HHmmss'Z'}");
		sb.AppendLine($"DTSTART;TZID=Europe/Madrid:{start:yyyyMMdd'T'HHmmss}");
		sb.AppendLine($"DTEND;TZID=Europe/Madrid:{end:yyyyMMdd'T'HHmmss}");
		sb.AppendLine($"SUMMARY:{summaryEscaped}");
		if (!string.IsNullOrWhiteSpace(description))
			sb.AppendLine($"DESCRIPTION:{EscapeIcsText(description)}");
		if (!string.IsNullOrWhiteSpace(category))
			sb.AppendLine($"CATEGORIES:{EscapeIcsText(category)}");

		// Color best-effort (RFC 7986 COLOR + extensiones). Google Calendar al importar .ics
		// normalmente ignora hex libres y solo aplica colorId vía API; Apple/Outlook varían.
		if (!string.IsNullOrWhiteSpace(colorHex))
		{
			string hex = colorHex.Trim();
			if (!hex.StartsWith('#')) hex = "#" + hex;
			sb.AppendLine($"COLOR:{hex}");
			sb.AppendLine($"X-COLOR:{hex}");
			sb.AppendLine($"X-APPLE-CALENDAR-COLOR:{hex}");
			int googleId = MapHexToGoogleColorId(hex);
			sb.AppendLine($"X-GOOGLE-CALENDAR-CONTENT-COLOR:{hex}");
			sb.AppendLine($"X-SAPPHIRE-COLOR:{hex}");
			sb.AppendLine($"X-SAPPHIRE-GOOGLE-COLOR-ID:{googleId}");
		}

		sb.AppendLine("END:VEVENT");
	}

	private string BuildTrainEventDescription(TrainWorkShiftContentModel train, string definitive, DateTime day)
	{
		var asim = Sapphire2025Models.Utils.GetAsimilation(train.TrainId);
		StringBuilder desc = new StringBuilder();
		desc.AppendLine($"Tren: {train.TrainId}");
		desc.AppendLine($"Turno: {definitive}");
		desc.AppendLine($"Fecha: {day:dd/MM/yyyy}");
		desc.AppendLine($"Horario: {Sapphire2025Models.Utils.autoInterval(train.StartTime, true)}–{Sapphire2025Models.Utils.autoInterval(train.EndTime, true)}");
		desc.AppendLine($"Agente: ({ViewedUser?.CF}) {ViewedUser?.Name}");
		desc.AppendLine($"Línea: {asim}");
		desc.AppendLine($"Color: {GetTrainAccentColor(train)}");
		if (train.Discrectional)
			desc.AppendLine("Opcional / discrecional");
		desc.Append("Generado por Sapphire");
		return desc.ToString().TrimEnd();
	}

	private string BuildDepotEventDescription(AttWorkShiftContentModel depot, string definitive, DateTime day)
	{
		StringBuilder desc = new StringBuilder();
		desc.AppendLine(depot.Foreign ? "Depósito fuera de residencia" : "Depósito / disponibilidad");
		desc.AppendLine($"Turno: {definitive}");
		desc.AppendLine($"Fecha: {day:dd/MM/yyyy}");
		desc.AppendLine($"Horario: {Sapphire2025Models.Utils.autoInterval(depot.StartTime, true)}–{Sapphire2025Models.Utils.autoInterval(depot.EndTime, true)} ({Sapphire2025Models.Utils.autoInterval(depot.Duration, false)})");
		desc.AppendLine($"Agente: ({ViewedUser?.CF}) {ViewedUser?.Name}");
		desc.AppendLine($"Color: {(depot.Foreign ? "#fbbf24" : "#818cf8")}");
		desc.Append("Generado por Sapphire");
		return desc.ToString().TrimEnd();
	}

