		mvarTimeSlice = await mvarExpertClient.PlansTimeSlice(rangeStart, DayHorizon);
		List<AssignationContentModel>? all =
			await mvarExpertClient.Assignations(rangeStart, DayHorizon);
		mcolRangeAssignations = all ?? new List<AssignationContentModel>();

		BuildAgentRows(rangeStart);
		BuildShiftSuggestions();
		SelectDayInternal(SelectedDate.Date, reloadIfOutside: false);
