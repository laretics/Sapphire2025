	private async Task ApplyInitialViewedUserAsync()
	{
		// 1) Enlace ?cf= (Expert / Root desde DailyGraph)
		if (CanViewOtherAgents && !string.IsNullOrWhiteSpace(CfFromQuery))
		{
			string q = CfFromQuery.Trim();
			if (ResolveViewedUserFromCf(q))
			{
				mvarCfInput = q;
				mvarAppliedQueryCf = q;
				if (IsAdmin)
					await mvarIntStorage.SetStringValue(DevCfStorageKey, q, false);
				return;
			}
		}

		// 2) Root: último CF simulado en almacenamiento local
		if (IsAdmin)
		{
			string? storedCf = await mvarIntStorage.GetStringValue(DevCfStorageKey, false);
			if (!string.IsNullOrWhiteSpace(storedCf) && ResolveViewedUserFromCf(storedCf.Trim()))
			{
				mvarCfInput = storedCf.Trim();
				return;
			}
		}

		// 3) Propio usuario de sesión
		ViewedUser = SessionUser;
		mvarCfInput = SessionUser?.CF ?? string.Empty;
