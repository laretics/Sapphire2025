@page "/agentsctc"
@inject IJSRuntime mvarJSRuntime
@inject ExpertClient mvarExpertClient
@inject AuthenticationClient mvarAuthClient
<PageTitle>Lista de Agentes</PageTitle>
<ModalDialog @ref="mvarModal" />
<InputFile style="display:none" @ref="mvarCBExcelInputRef" OnChange="onExcelImport" MaxAllowedSize="5242880" accept=".xlsx" />
@if (isImporting)
{
	<LoadingTab ElementText="Importando archivo" />
}
else
{
    <CascadingValue Value="mcolUsers">
        <div class="row mb-4">
            <div class="col-md-6">
                <button Type="button" class="btn btn-secondary" @onclick="() => TriggerFileInputBlazor(mvarCBExcelInputRef)">Importar gráfico</button>
            </div>
            <div class="col-md-6">
                <label for="datePicker" class="form-label">Fecha</label>
                <InputDate id="datePicker"
                           Value="selectedDate"
                           ValueChanged="@(async (DateTime newValue) => await OnDaySelectedChange(newValue))"
                           ValueExpression="() => selectedDate"
                           class="form-control" />
            </div>
        </div>
        <div class="card mb-4 shadow-sm">
            <div class="card-body">
                <div class="row g-3 align-items-center">
                    <!-- Inspector -->
                    <div class="col-md-6">
                        <label class="form-label fw-bold text-primary">CF Inspector</label>
                        <div class="input-group">
                            <input type="text" class="form-control" maxlength="8"
                                   @bind="mvarCFInspector"
                                   @bind:event="oninput"
                                   placeholder="Introduce CF del Inspector" />
                            <span class="input-group-text bg-light">
                                <i class="bi bi-search"></i>
                            </span>
                        </div>
                        @if (InspectorUser != null)
                        {
                            <div class="mt-2 p-2 rounded bg-light border">
                                <div class="fw-semibold text-dark">@InspectorUser.Name</div>
                                <div class="text-muted small">
                                    <i class="bi bi-telephone"></i> @InspectorUser.PhoneNumber
                                    @if (!string.IsNullOrWhiteSpace(InspectorUser.ShortPhoneNumber))
                                    {
                                        <span class="ms-2">Ext: @InspectorUser.ShortPhoneNumber</span>
                                    }
                                </div>
                            </div>
                        }
                        else if (!string.IsNullOrWhiteSpace(mvarCFInspector))
                        {
                            <div class="mt-2 text-danger small">No se ha encontrado ningún usuario con ese CF.</div>
                        }
                    </div>
                    <!-- Jefe de Maquinistas -->
                    <div class="col-md-6">
                        <label class="form-label fw-bold text-success">CF Jefe de Maquinistas</label>
                        <div class="input-group">
                            <input type="text" class="form-control" maxlength="8"
                                   @bind="mvarCFCap"
                                   @bind:event="oninput"
                                   placeholder="Introduce CF del Jefe de Maquinistas" />
                            <span class="input-group-text bg-light">
                                <i class="bi bi-search"></i>
                            </span>
                        </div>
                        @if (CapUser != null)
                        {
                            <div class="mt-2 p-2 rounded bg-light border">
                                <div class="fw-semibold text-dark">@CapUser.Name</div>
                                <div class="text-muted small">
                                    <i class="bi bi-telephone"></i> @CapUser.PhoneNumber
                                    @if (!string.IsNullOrWhiteSpace(CapUser.ShortPhoneNumber))
                                    {
                                        <span class="ms-2">Ext: @CapUser.ShortPhoneNumber</span>
                                    }
                                </div>
                            </div>
                        }
                        else if (!string.IsNullOrWhiteSpace(mvarCFCap))
                        {
                            <div class="mt-2 text-danger small">No se ha encontrado ningún usuario con ese CF.</div>
                        }
                    </div>
                </div>
                <!-- Condiciones del servicio -->
                <div class="row mt-4">
                    <div class="col-12">
                        <label class="form-label fw-bold text-secondary">Condiciones del servicio</label>
                        <textarea class="form-control" rows="4"
                                  @bind="mvarComment"
                                  placeholder="Escribe aquí las condiciones especiales del servicio..."></textarea>
                    </div>
                </div>
            </div>
        </div>
        <Sapphire2025.Layout.Expert.AssignationDayCalendar CTCView="true"
                                                           ColAssignations="mcolAssignations"
                                                           TimeSlice="mvarTimeSlice"
                                                           InspectorId="@(InspectorUser?.guid ?? Guid.Empty)"
                                                           ExpertId="@(CapUser?.guid ?? Guid.Empty)"
                                                           Comments="@mvarComment"
                                                           />
    </CascadingValue>
}
@code {
    private ModalDialog mvarModal { get; set; } = new ModalDialog();
    private InputFile? mvarCBExcelInputRef;
    private bool isImporting = false;
    private DateTime selectedDate = DateTime.Today;
    private Dictionary<Guid, UserModelBase>? mcolUsers;
    private List<AssignationContentModel>? mcolAssignations;
    private string? mvarCFInspector;
    private string? mvarCFCap;
    private string? mvarComment;
    private Sapphire2025Models.Expert.WorkshiftTemplates.PlansYearSlice? mvarTimeSlice;
    private int mvarNumDay = 4;
    private UserModelBase? InspectorUser => FindUserByCF(mvarCFInspector);
    private UserModelBase? CapUser => FindUserByCF(mvarCFCap);

    private UserModelBase? FindUserByCF(string? cf)
    {
        if (string.IsNullOrWhiteSpace(cf) || mcolUsers == null)
            return null;
        return mcolUsers.Values.FirstOrDefault(u => u.CF.Equals(cf.Trim(), StringComparison.OrdinalIgnoreCase));
    }

    protected async override Task OnInitializedAsync()
    {
        mcolUsers = await mvarAuthClient.cachedUserList();
        await UpdateData();
    }
    private async Task OnDaySelectedChange(DateTime newValue)
    {
        selectedDate = newValue;
        await UpdateData();
    }
    private async Task UpdateData()
    {
        isImporting = true;
        StateHasChanged();
        mvarTimeSlice = await mvarExpertClient.PlansTimeSlice(selectedDate); //Rodaja de tiempos
        mcolAssignations = await mvarExpertClient.Assignations(selectedDate); //Asignaciones del día
        isImporting = false;
        StateHasChanged();
    }
    private async Task onExcelImport(InputFileChangeEventArgs e)
    {        
        isImporting = true;
        StateHasChanged();

        Microsoft.AspNetCore.Components.Forms.IBrowserFile archivo = e.File;

        if (null != archivo)
        {
            using Stream corriente = archivo.OpenReadStream(maxAllowedSize: 5242880); // 5 MB
            using MemoryStream ms = new MemoryStream();
            await corriente.CopyToAsync(ms);
            byte[] buffer = ms.ToArray();
            //Ahora pasamos esto a JavaScript
            DateTime fecha = DateTime.Today;
            string salida = await mvarJSRuntime.InvokeAsync<string>("excelInterop.extractWorksheetData", buffer, fecha.Month, fecha.Day, mvarNumDay);
            int zoneOffset = await GetTimezoneOffsetMinutes();
            string? salidaCompilacion = await mvarExpertClient.UploadDailyWorkShift(salida, fecha, mvarNumDay,zoneOffset);
            if (null != salidaCompilacion && salidaCompilacion.Length > 0)
                await mvarModal.show("Error de importación", salidaCompilacion, "Salir");
        }
        isImporting = false;
        StateHasChanged();
    }
    private async Task TriggerFileInputBlazor(InputFile? rhs)
    {
        if (null != rhs)
            await mvarJSRuntime.InvokeVoidAsync("triggerFileInputClick", rhs.Element);
    }
    private async Task<int> GetTimezoneOffsetMinutes()
    {
        return await mvarJSRuntime.InvokeAsync<int>("eval", "new Date().getTimezoneOffset()");
    }
}
