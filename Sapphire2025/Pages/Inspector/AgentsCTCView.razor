@page "/agentsctc"
@inject IJSRuntime mvarJSRuntime
@inject ExpertClient mvarExpertClient
@inject AuthenticationClient mvarAuthClient
@inject IntStorageService mvarLocalStorage
<PageTitle>Lista de Agentes</PageTitle>
<ModalDialog @ref="mvarModal" />

<Sapphire2025.Layout.Expert.ExpertDayContext ExcelImportDayCount="4" 
    ExcelImportFeature=true
    PrintFeature=true>
    <Sapphire2025.Layout.Inspector.AgentsListHeaderCtl/>
    <Sapphire2025.Layout.Inspector.AgentsListTableCTL  />
</Sapphire2025.Layout.Expert.ExpertDayContext>

@code {
    private ModalDialog mvarModal { get; set; } = new ModalDialog();
    protected override async Task OnInitializedAsync()
    {
        await mvarLocalStorage.DeleteInspectorReportValues();
    }    
}
