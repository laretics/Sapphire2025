@page "/agentsprintview"
@page "/agentsprintpreview"
@layout EmptyLayout
@inject IJSRuntime mvarJSRuntime
@inject IntStorageService mvarLocalStorage

<div class="print-area">
	<div class="print-title d-flex align-items-center" style="gap: 1.0rem; max-width: 100%; flex-wrap: nowrap;">
		<div class="print-logo" style="margin-bottom:0; flex: 0 0 auto;">
			<img src="img/sfmImg.png" alt="Logotipo SFM" style="max-width: 90px; height: auto;" />
		</div>
		<h2 class="mb-0 flex-grow-1" style="font-size: 1.3em; font-weight: bold; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
			Tracción - @mvarCurrentDate.ToString("dd/MM/yyyy")
		</h2>
		<h1 class="mb-0 flex-grow-1" style="font-size: 2.0em; font-weight: bold; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
			@GetDiaSemana(mvarCurrentDate)
		</h1>
	</div>
	<div class="card mb-4 shadow-sm print-only">
		<div class="card-body">
			<div class="d-flex w-100 gap-2">
				<!-- Inspector -->
				<div style="flex:1">
					<label class="form-label fw-bold text-primary">Inspector de mañana</label>
					@if (null != InspectorUser)
					{
						<div class="mt-2 p-2 rounded bg-light border">
							<div class="fw-semibold text-dark">@InspectorUser.Name</div>
							<div class="text-muted small">
								<i class="bi bi-telephone"></i> @InspectorUser.PhoneNumber
								@if (!string.IsNullOrWhiteSpace(InspectorUser.ShortPhoneNumber))
								{
									<span class="ms-2">Ext: @InspectorUser.ShortPhoneNumber</span>
								}
							</div>
						</div>
					}
					else
					{
						<div class="mt-2 text-danger small">No se ha asignado.</div>
					}
				</div>
				<!-- Jefe de Maquinistas 1 -->
				<div style="flex:1">
					<label class="form-label fw-bold text-success">J.Maquinistas de mañana</label>
					@if (null != CapUser1)
					{
						<div class="mt-2 p-2 rounded bg-light border">
							<div class="fw-semibold text-dark">@CapUser1.Name</div>
							<div class="text-muted small">
								<i class="bi bi-telephone"></i> @CapUser1.PhoneNumber
								@if (!string.IsNullOrWhiteSpace(CapUser1.ShortPhoneNumber))
								{
									<span class="ms-2">Ext: @CapUser1.ShortPhoneNumber</span>
								}
							</div>
						</div>
					}
					else
					{
						<div class="mt-2 text-danger small">No se ha asignado.</div>
					}
				</div>
				<!-- Jefe de Maquinistas 2 -->
				<div style="flex:1">
					<label class="form-label fw-bold text-success">J.Maquinistas de tarde</label>
					@if (null != CapUser2)
					{
						<div class="mt-2 p-2 rounded bg-light border">
							<div class="fw-semibold text-dark">@CapUser2.Name</div>
							<div class="text-muted small">
								<i class="bi bi-telephone"></i> @CapUser2.PhoneNumber
								@if (!string.IsNullOrWhiteSpace(CapUser2.ShortPhoneNumber))
								{
									<span class="ms-2">Ext: @CapUser2.ShortPhoneNumber</span>
								}
							</div>
						</div>
					}
					else
					{
						<div class="mt-2 text-danger small">No se ha asignado.</div>
					}
				</div>
			</div>
			<!-- Condiciones del servicio -->
			@if (!string.IsNullOrWhiteSpace(mvarComment))
			{
				<div class="print-comments mb-2">
					<label class="form-label fw-bold text-secondary mb-1">Condiciones del servicio</label>
					<div class="comments-box">@mvarComment</div>
				</div>
			}
		</div>
	</div>
	@if(null!=mcolAgents)
	{
		<div class="table-responsive my-3">
			<table class="table table-bordered table-sm align-middle">
				<thead class="table-light">
					<tr>						
						<th>Horario</th>
						<th>CF</th>
						<th>Asignación inicial</th>
						<th>CF</th>
						<th>Asignación definitiva</th>
						<th>Turno</th>
						<th>Teléfono</th>
						<th>Ext</th>
					</tr>
				</thead>
				<tbody>
					@foreach (Sapphire2025Models.Inspector.AgentsListRecordModel register in mcolAgents)
					{
						<Sapphire2025.Layout.Inspector.AgentsListRecordCTL Model="register" />
					}
				</tbody>
			</table>
		</div>
	}
</div>

@code {
	private DateTime mvarCurrentDate { get; set; }
	private Dictionary<Guid, UserModelBase>? Users { get; set; }
	private List<AssignationContentModel>? ColAssignations = null;
	private List<WorkShiftTemplateModel>? SortedTemplates = null;
	private UserModelBase? InspectorUser = null;
	private UserModelBase? CapUser1 = null;
	private UserModelBase? CapUser2 = null;
	private string? mvarComment = null;
	private List<Sapphire2025Models.Inspector.AgentsListRecordModel>? mcolAgents;
	private bool mvarReadyToPrint = false;

	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		if(mvarReadyToPrint)
		{
			mvarReadyToPrint = false; //Evitamos que imprima varias veces.
			await Task.Delay(500); // Espera medio segundo antes de imprimir
			await mvarJSRuntime.InvokeVoidAsync("window.print");
		}		
	}
	protected async override Task OnParametersSetAsync()
	{
		await RetrieveLocalData();
		mvarReadyToPrint = true;
	}

	/// <summary>
	/// Carga los datos desde el almacenamiento interno para imprimir.
	/// </summary>
	private async Task RetrieveLocalData()
	{
		mcolAgents = await mvarLocalStorage.GetInspectorAgentsTable();
		Users = await mvarLocalStorage.GetUsersCache();
		mvarCurrentDate = await mvarLocalStorage.GetInspectorReportDate();
		InspectorUser = await auxRetrieveUserFromLocal("Ins1Cf");
		CapUser1 = await auxRetrieveUserFromLocal("Cap1Cf");
		CapUser2 = await auxRetrieveUserFromLocal("Cap2Cf");
		mvarComment = await mvarLocalStorage.GetInspectoCommentsField();
		ColAssignations = await mvarLocalStorage.GetInspectorReportAssignations();
		SortedTemplates = await mvarLocalStorage.GetInspectorSortedTemplates();
	}

	private async Task<UserModelBase?> auxRetrieveUserFromLocal(string key)
	{
		if(null!=Users)
		{
			Guid auxCF = await mvarLocalStorage.GetGuidValue(key, false);
			if (Users.ContainsKey(auxCF))
			{
				return Users[auxCF];
			}
		}
		return null;
	}

	private static string GetDiaSemana(DateTime fecha)
	{
		return fecha.DayOfWeek switch
		{
			DayOfWeek.Monday => "LUNES",
			DayOfWeek.Tuesday => "MARTES",
			DayOfWeek.Wednesday => "MIÉRCOLES",
			DayOfWeek.Thursday => "JUEVES",
			DayOfWeek.Friday => "VIERNES",
			DayOfWeek.Saturday => "SÁBADO",
			DayOfWeek.Sunday => "DOMINGO",
			_ => ""
		};
	}




}
