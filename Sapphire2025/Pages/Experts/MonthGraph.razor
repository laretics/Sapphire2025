@page "/monthGraph/{AgentsViewId}"
@inject IJSRuntime mvarJSRuntime
@inject ExpertClient mvarExpertClient
@inject AuthenticationClient mvarAuthClient
<PageTitle>Gráfico mensual de Tracción</PageTitle>
<ModalDialog></ModalDialog>
<div style="max-height: 80vh; overflow-y: auto;">
    @if(null==mcolAgents)
    {
        <div class="d-flex justify-content-center align-items-center" style="height: 60vh;">
            <div class="text-center">
                <div class="spinner-border text-primary mb-3" style="width: 4rem; height: 4rem;" role="status">
                    <span class="visually-hidden">Cargando...</span>
                </div>
                <div>
                    <h5 class="mt-2">Cargando tabla de usuarios...</h5>
                    <p class="text-muted">Por favor, espere un momento.</p>
                </div>
            </div>
        </div>
    }
    else
    {
        @if(null==mcolCells)
        {
            <div class="d-flex justify-content-center align-items-center" style="height: 60vh;">
                <div class="text-center">
                    <div class="spinner-border text-warning mb-3" style="width: 4rem; height: 4rem;" role="status">
                        <span class="visually-hidden">Cargando...</span>
                    </div>
                    <div>
                        <h5 class="mt-2">Cargando asignación de turnos...</h5>
                        <p class="text-muted">Por favor, espere un momento.</p>
                    </div>
                </div>
            </div>
        }
        else
        {
            <table class="table table-bordered shadow rounded">
                <thead>
                    <tr>
                        <th class="header-corner"></th>
                        @for (int col = 0; col <= dayCount; col++)
                        {
                            <th class="@festiveClass(col)">
                                @if (1 == col) //Es hoy
                                {
                                    <span class="highlight-today">@dayText(col)</span>
                                }
                                else
                                {
                                    @dayText(col)
                                }
                            </th>
                        }
                    </tr>
                </thead>
                <tbody>

                    @for (int row = 0 ; row<mcolAgents.Count;row++ )
                    {
                        <tr>
                            <th class="header-left bg-gradient-secondary">
                                <div class="d-flex justify-content-between align-items-center w-100">
                                    <span class="cf-text">@mcolAgents[row].CF</span>
                                    <span class="user-name">@mcolAgents[row].Name.</span>
                                </div>
                            </th>
                            @for (int col = 0; col < dayCount; col++)
                            {
                                if(null==mcolCells[col,row])
                                {
                                    <td class="cell-content text-center align-middle"></td>
                                }
                                else
                                {
                                    <td class="cell-content custom-cell text-center align-middle"
                                    style="@mcolCells[col,row]?.cellStyle">
                                        <div class="cell-content-inner">
                                            <span>@mcolCells[col, row]?.text</span>
                                            <div class="cell-bar"
                                            style="@mcolCells[col,row]?.barStyle"></div>
                                        </div>
                                    </td>
                                }
                            }
                        </tr>
                    }
                </tbody>
            </table>
        }
    }
</div>
<InputFile Onchange="onExcelImport" MaxAllowedSize="5242880" accept=".xlsx,.xls" />


@code {
    private int dayCount = 16;
    private ModalDialog mvarModal { get; set; } = new ModalDialog();    
    private DateTime mvarToday = DateTime.Today;
    [Parameter]
    public string? AgentsViewId{ get; set; }
    private Dictionary<string,UserModelBase>? mcolAgents; //Lista de Agentes (en base a asignaciones de hoy)
    private Dictionary<Guid, UserModelBase>? mcolUsers;
    private cellFormatted?[,]? mcolCells;
    private Dictionary<Guid, WorkShiftTemplateCollectionModel> mcolPlans; //Lista de planes de explotación
    protected async override Task OnInitializedAsync()
    {
        mcolPlans = new Dictionary<Guid, WorkShiftTemplateCollectionModel>();
        mcolUsers = await mvarAuthClient.cachedUserList();
        //Cargamos las asignaciones de hoy, lo que nos va a permitir tener la lista de Maquinistros.
        await loadAgents();
        await loadAssignations(); //Carga las asignaciones de los Agentes.
    }
    private async Task loadAgents()
    {
        //Modificación de la rutina precedente. Ahora cargamos la tabla de Agentes directamente



        List<WorkShiftAssignationModel> todayAssign = await mvarExpertClient.AssignationsByDate(DateTime.Today);
        mcolAgents = new Dictionary<string,UserModelBase>();
        List<UserModelBase> auxLista = mcolUsers.Values.ToList();
        foreach(WorkShiftAssignationModel asig in todayAssign)
        {
            foreach (UserModelBase popo in auxLista)
            {
                if(popo.CF.Equals(asig.CF))
                {
                    mcolAgents.Add(asig.CF, popo);
                    auxLista.Remove(popo); //Para no volver a buscarla. Se supone que es una aceleración.
                }
            }
        }
    }

    private async Task loadAssignations()
    {
        if (null == mcolAgents) return; //No debería ser nulo.
        mcolCells = new cellFormatted[dayCount, mcolAgents.Count];
        for (int i=0; i< dayCount;i++)
        {
            DateTime fecha = DateTime.Today.AddDays(i);
            List<WorkShiftAssignationModel> colAssignations = await mvarExpertClient.AssignationsByDate(fecha);
            Guid auxPlanId = await mvarExpertClient.WorkShiftTemplateHeader(fecha);
            if(Guid.Empty!=auxPlanId)
            {
                if(!mcolPlans.ContainsKey(auxPlanId))
                {
                    //Cargamos el plan de explotación desde la base de datos.
                    WorkShiftTemplateCollectionModel? nuevoPlan = await mvarExpertClient.WorkShiftTemplateCollectionItem(auxPlanId);
                    if (null != nuevoPlan)
                        mcolPlans.Add(auxPlanId, nuevoPlan);
                }
                if(mcolPlans.ContainsKey(auxPlanId))
                {
                    WorkShiftTemplateCollectionModel auxPlan = mcolPlans[auxPlanId];
                    for (int jj = 0; jj < mcolAgents.Count; jj++)
                    {
                        UserModelBase agente = mcolAgents[jj];

                        WorkShiftAssignationModel? asignacion = getAssignationByCF(colAssignations, agente.CF);
                        if (null != asignacion)
                        {
                            cellFormatted nueva = new cellFormatted();
                            nueva.text = asignacion.Definitive;
                            nueva.isTd = asignacion.IsTD;
                            if (null != auxPlan.Templates && auxPlan.Templates.ContainsKey(nueva.text))
                                nueva.template = auxPlan.Templates[nueva.text];

                            mcolCells[i, jj] = nueva;
                        }
                    }
                }
            }
        }
    }    
    private WorkShiftAssignationModel? getAssignationByCF(List<WorkShiftAssignationModel>lista, string CF)
    {
        foreach(WorkShiftAssignationModel elemento in lista)
        {
            if (elemento.CF.Equals(CF)) return elemento;
        }
        return null;
    }


    private string dayText(int offset)
    {
        DateTime fecha = mvarToday.AddDays(offset-2);
        return fecha.Day.ToString();
    }
    private string festiveClass(int offset)
    {
        bool salida = false;
        DateTime fecha = mvarToday.AddDays(offset);
        if (fecha.DayOfWeek == DayOfWeek.Sunday || fecha.DayOfWeek == DayOfWeek.Saturday) salida = true;
        //TODO: Tengo que añadir una consulta a la tabla de días festivos aquí.

        if (salida) return "header-top bg-gradient-weekend text-dark text-center";
        else return "header-top bg-gradient-primary text-white text-center";
    }
    private async Task onExcelImport(InputFileChangeEventArgs e)
    {
        Microsoft.AspNetCore.Components.Forms.IBrowserFile archivo = e.File;

        if (null != archivo)
        {
            mcolAgents = null;
            mcolCells = null;
            using Stream corriente = archivo.OpenReadStream(maxAllowedSize: 5242880); // 5 MB
            using MemoryStream ms = new MemoryStream();
            await corriente.CopyToAsync(ms);
            byte[] buffer = ms.ToArray();
            //Ahora pasamos esto a JavaScript
            int[] indices = await mvarJSRuntime.InvokeAsync<int[]>("excelInterop.locateDateColumn", buffer, "JULIO", 7);

            int colMakis = indices[0];
            int colFecha = indices[1];

            if (colFecha < 0) colFecha = 1;
            //string salida = await mvarJSRuntime.InvokeAsync<string>("excelInterop.uploadExcelFile", buffer,colFecha,30,1,80);
            string salida = await mvarJSRuntime.InvokeAsync<string>("excelInterop.takeSnapShot", buffer, colMakis, colFecha, dayCount+2);
            //int columna = FindDate(DateTime.Today,salida);
            Console.WriteLine(salida);
            string? salidaCompilacion = await mvarExpertClient.uploadDailyWorkShift(salida);
            await loadAgents();
            await loadAssignations(); //Carga las asignaciones de los Agentes.
            if (null != salidaCompilacion && salidaCompilacion.Length > 0)
                await mvarModal.show("Error de importación", salidaCompilacion, "Salir");

            StateHasChanged();
        }
    }

    private class cellFormatted
    {
        public WorkShiftTemplateModel? template{ get; set; }

        public string cellStyle
        {
            get 
            {
                string? auxColor = template?.Color ?? "black";
                if (isTd) auxColor = "#00CC00"; //Color del TD
                return string.Format("background: {1}; color: {0};", auxColor, template?.BgColor ?? "transparent");
            }
        }
        public string barStyle
        {
            get => string.Format("background: {0};", template?.StripeColor ?? "transparent");
        }
        public string text{ get; set; }   
        public bool isTd{ get; set; }
    }
}
