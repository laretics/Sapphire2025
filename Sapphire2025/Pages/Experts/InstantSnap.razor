@page "/instantsnap"
@using Sapphire2025Models.Expert.WorkshiftTemplates
@inject ExpertClient mvarExpertClient
@inject AuthenticationClient mvarAuthClient
<PageTitle>Situación Actual</PageTitle>
<h3>Situación actual</h3>

@code {
    private Dictionary<Guid, UserModelBase>? mcolUsers;
    private List<AssignationContentModel>? mcolAssignations;
    private WorkShiftTemplateCollectionModel? mvarPlan;
    private Sapphire2025Models.Expert.WorkshiftTemplates.PlansYearSlice? mvarTimeSlice;
    private DateTime mvarCurrentDate = DateTime.Today;
    private DateTime selectedDate
    {
        get => mvarCurrentDate;
        set
        {
            mvarCurrentDate = value;
            //_ = UpdateData(); //Fire and forget.
        }
    }

    protected async override Task OnInitializedAsync()
    {
        mcolUsers = await mvarAuthClient.cachedUserList();
        mcolAssignations = await mvarExpertClient.Assignations(DateTime.Today);

    }
}
