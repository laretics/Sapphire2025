@page "/dailyGraph"
@using Sapphire2025.Icons
@using Sapphire2025Models.Expert.WorkshiftTemplates
@using Sapphire2025.Layout.Expert
@inject IJSRuntime mvarJSRuntime
@inject ExpertClient mvarExpertClient
@inject AuthenticationClient mvarAuthClient
<PageTitle>@Prefs.T("page.dailygraph")</PageTitle>
<ModalDialog @ref="mvarModal" />

<div class="daily-graph-page">
    <ExpertDayContext ExcelImportDayCount="4" ExcelImportFeature=true RealTimeFollowFeature=true DailySheetPrintFeature=true>
        <div class="daily-graph-tabs">
            <TabControl Classic=true PersistenceKey="dailyGraph.activeTab" RestoreToken="@CurrentDate">
                <TabPage Text="@Prefs.T("daily.circulations")">
                    <Icon>
                        <GenIcon Name="UT" color="#2020A0" />
                    </Icon>
                    <ChildContent>
                        <div class="daily-graph-pane">
                            <CirculationsExpertGrid MinutesAfterTrain="15" MinutesBeforeTrain="10" />
                        </div>
                    </ChildContent>
                </TabPage>
                <TabPage Text="@Prefs.T("daily.depots")">
                    <Icon>
                        <GenIcon Name="Att" color="#2020A0" />
                    </Icon>
                    <ChildContent>
                        <div class="daily-graph-pane">
                            <DepotsExpertGrid MinutesShortAtt="25"
                                                                     MinutesLongAtt="60" />
                        </div>
                    </ChildContent>
                </TabPage>
                <TabPage Text="@Prefs.T("daily.assignations")">
                    <Icon>
                        <GenIcon Name="EventDateTime" color="#2020A0"/>
                    </Icon>
                    <ChildContent>
                        <div class="daily-graph-pane">
                            <AssignationDayCalendar MinutesBeforeWorksheet="25" MinutesAfterWorksheet="10" />
                        </div>
                    </ChildContent>
                </TabPage>
                <TabPage Text="@Prefs.T("daily.vacancies")">
                    <Icon>
                        <GenIcon Name="Att" Color="#2020A0"/>
                    </Icon>
                    <ChildContent>
                        <div class="daily-graph-pane">
                            <IddleDayCalendar MinutesBeforeWorksheet="25" MinutesAfterWorksheet="10" />
                        </div>
                    </ChildContent>
                </TabPage>
            </TabControl>
        </div>
    </ExpertDayContext>
</div>

@code {
    [CascadingParameter]
    public DateTime CurrentDate{ get; set; }
    private ModalDialog mvarModal { get; set; } = new ModalDialog();

}
