@page "/dailyGraph"
@inject IJSRuntime mvarJSRuntime
@inject ExpertClient mvarExpertClient
@inject AuthenticationClient mvarAuthClient
<PageTitle>Gráfico de Tracción</PageTitle>
<ModalDialog @ref="mvarModal" />

@if (isImporting)
{
    <div class="import-overlay">
        <div class="import-spinner">
            <div class="spinner-border text-primary" style="width: 4rem; height: 4rem;" role="status">
                <span class="visually-hidden">Importando...</span>
            </div>
            <div class="mt-3 fs-5">Importando archivo, por favor espere...</div>
        </div>
    </div>
}

<div class="container mt-4" style="@ImportingStyle()">
    <div class="row mb-4">
        <div class="col-md-6">
            <label for="xmlFile" class="form-label">Cargar Gráfico</label>
            <InputFile id="xmlFile" OnChange="OnXmlFileSelected" accept=".xlsx" class="form-control" />
        </div>
        <div class="col-md-6">
            <label for="datePicker" class="form-label">Seleccionar día</label>
            <InputDate id="datePicker" 
                Value = "selectedDate"
                ValueChanged = "@(async (DateTime newValue) => await OnDaySelectedChange(newValue))"
                ValueExpression="() => selectedDate"
                class="form-control" />
            <div class="form-check form-switch mt-3">
                <input class="form-check-input" type="checkbox" id="festiveSwitch" checked="@isFestive" @onchange ="OnFestiveChanged"/>
                <label class="form-check-label" for="festiveSwitch">
                    ¿Es festivo?
                </label>
            </div>
        </div>
    </div>
    @if(null==mcolTemplates)
    {
        <div class="alert alert-warning d-flex align-items-center" role="alert">
            No hay turnos disponibles: la colección está vacía.
        </div>
    }
    else
    {
        <div class="row">
            <div class="col-12">
                <div class="d-flex flex-row flex-wrap gap-4 justify-content-between">
                    @for (int col = 0; col <= mcolTemplates.GetUpperBound(0); col++)
                    {
                        <div class="table-responsive flex-fill" style="min-width: 250px;">
                            <table class="table table-bordered text-center custom-width-table mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Turno</th>
                                        <th>Asignación</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @for (int row = 0; row <= mcolTemplates.GetUpperBound(1); row++)
                                    {
                                        @if (mcolTemplates[col, row] != null)
                                        {
                                            <tr>
                                                <td class="cell-content custom-cell text-center align-middle"
                                                    style="@GetCellStyle(mcolTemplates[col,row])">
                                                    <div class="cell-content-inner">
                                                        <span>@GetCellText(mcolTemplates[col,row])</span>
                                                        <div class="cell-bar"
                                                        style="@GetBarStyle(mcolTemplates[col,row])"/>                                                    
                                                    </div>
                                                </td>
                                                <td>
                                                    <table>
                                                        <tbody>
                                                            @foreach (WorkShiftAssignationModel assignation in AssignationsByTemplate(mcolTemplates[col, row].Name))
                                                            {
                                                                <tr>
                                                                    <td>@GetUserString(assignation.Agent)</td>
                                                                </tr>
                                                            }
                                                        </tbody>
                                                    </table>
                                                </td>
                                            </tr>                  
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
    }

</div>

@code {
    private ModalDialog mvarModal { get; set; } = new ModalDialog();    
    private DateTime selectedDate = DateTime.Today;
    private bool isFestive = false;
    private bool isImporting = false;
    private Dictionary<Guid, UserModelBase>? mcolUsers;
    private WorkShiftTemplateModel[,]? mcolTemplates;
    private List<WorkShiftAssignationModel> mcolAssignations;


    protected async override Task OnInitializedAsync()
    {
        mcolUsers = await mvarAuthClient.cachedUserList();
        await UpdateData();
    }

    /// <summary>
    /// Carga el plan de explotación de la fecha marcada en el calendario.
    /// </summary>
    /// <returns>No devuelve nada.</returns>
    private async Task LoadPlan()
    {
        Guid auxHeaderId = await mvarExpertClient.WorkShiftTemplateHeader(selectedDate);
        WorkShiftTemplateCollectionModel? auxPlan = null;
        mcolTemplates = null;
        if(auxHeaderId!=Guid.Empty)
        {
            auxPlan = await mvarExpertClient.WorkShiftTemplateCollectionItem(auxHeaderId,selectedDate,true);
            int maxX = 0;
            int maxY = 0;
            if(null!=auxPlan && null!=auxPlan.Templates)
            {
                foreach (WorkShiftTemplateModel auxTemplate in auxPlan.Templates.Values)
                {
                    if (auxTemplate.CoorX > maxX) maxX = auxTemplate.CoorX;
                    if (auxTemplate.CoorY > maxY) maxY = auxTemplate.CoorY;                   
                }
                mcolTemplates = new WorkShiftTemplateModel[maxX + 1, maxY + 1];
                foreach(WorkShiftTemplateModel auxTemplate in auxPlan.Templates.Values)
                {
                    if(auxTemplate.CoorX>=0 && auxTemplate.CoorY>=0)
                    {
                        mcolTemplates[auxTemplate.CoorX, auxTemplate.CoorY] = auxTemplate;
                    }                    
                }
            }
        }
    }

    private async Task UpdateData()
    {
        isImporting = true;
        StateHasChanged();
        await LoadPlan();
        mcolAssignations = await mvarExpertClient.AssignationsByDate(selectedDate);
        isImporting = false;
        StateHasChanged();
    }

    private string ImportingStyle()
    {
        if (isImporting) return "pointer-events:none;opacity:0.5;";
        else return string.Empty;
    }

    private async Task OnFestiveChanged (ChangeEventArgs e)
    {
        if(null!=e.Value)
        {
            isFestive = (bool)e.Value;
            await UpdateData();
        }
    }
    private async Task OnDaySelectedChange(DateTime newValue)
    {
        selectedDate = newValue;
        await UpdateData();
    }

    private List<WorkShiftAssignationModel> AssignationsByTemplate(string definitive)
    {
        List<WorkShiftAssignationModel> salida = new List<WorkShiftAssignationModel>();
        salida = mcolAssignations.Where(xx => xx.Definitive == definitive).ToList();
        return salida;
    }
    private string GetUserString(Guid guid)
    {
        if (null!=mcolUsers && mcolUsers.ContainsKey(guid))
        {
            return mcolUsers[guid].Name ?? "???";
        }
        return "???";
    }
    private string GetCellStyle(WorkShiftTemplateModel? rhs)
    {
        string auxColor = "black";
        string auxFondo = "transparent";
        if (null != rhs)
        {
            auxColor = rhs.Color ?? "black";
            auxFondo = rhs.BgColor ?? "transparent";
        }        
        return string.Format("background: {1}; color: {0};", auxColor, auxFondo);
    }
    private string GetCellText(WorkShiftTemplateModel? rhs)
    {
        if (null == rhs) return string.Empty;
        return rhs.Name;
    }
    private string GetBarStyle(WorkShiftTemplateModel? rhs)
    {
        return string.Format("background: {0};", rhs?.StripeColor ?? "transparent");
    }

    private async Task OnXmlFileSelected(InputFileChangeEventArgs e)
    {
        isImporting = true;
        StateHasChanged();
        try
        {
            // Aquí puedes manejar el archivo XML seleccionado
            var file = e.File;
            // Lógica de procesamiento...
            await Task.Delay(3000);

            //TODO: Añadir importación de asignaciones aquí.

        }
        finally
        {
            isImporting = false;
            StateHasChanged();
        }
    }
}
