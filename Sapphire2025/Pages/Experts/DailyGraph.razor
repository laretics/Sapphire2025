@page "/dailyGraph"
@using Sapphire2025Models.Expert.WorkshiftTemplates
@inject IJSRuntime mvarJSRuntime
@inject ExpertClient mvarExpertClient
@inject AuthenticationClient mvarAuthClient
<PageTitle>Gráfico diario de Tracción</PageTitle>
<ModalDialog @ref="mvarModal" />

<Sapphire2025.Layout.Expert.ExpertDayContext ExcelImportDayCount="4" ExcelImportFeature=true RealTimeFollowFeature=true>
    <div>
        <ul class="nav nav-tabs" id="myTab" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link active" id="tab1-tab" data-bs-toggle="tab" data-bs-target="#tab1"
                        type="button" role="tab" aria-controls="tab1" aria-selected="true">
                    Circulaciones
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="tab2-tab" data-bs-toggle="tab" data-bs-target="#tab2"
                        type="button" role="tab" aria-controls="tab2" aria-selected="false">
                    Depósitos
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="tab3-tab" data-bs-toggle="tab" data-bs-target="#tab3"
                        type="button" role="tab" aria-controls="tab3" aria-selected="false">
                    Asignaciones
                </button>
            </li>
        </ul>
        <div class="tab-content mt-3" id="myTabContent">
            <div class="tab-pane fade show active" id="tab1" role="tabpanel" aria-labelledby="tab1-tab">
                <Sapphire2025.Layout.Expert.CirculationsExpertGrid 
                MinutesAfterTrain="15" MinutesBeforeTrain="10"/>
            </div>
            <div class="tab-pane fade" id="tab2" role="tabpanel" aria-labelledby="tab2-tab">
                 <Sapphire2025.Layout.Expert.DepotsExpertGrid
                 MinutesShortAtt="25"
                 MinutesLongAtt="60"/>
            </div>
            <div class="tab-pane fade" id="tab3" role="tabpanel" aria-labelledby="tab3-tab">
                <Sapphire2025.Layout.Expert.AssignationDayCalendar MinutesBeforeWorksheet="25" MinutesAfterWorksheet="10" />
            </div>
        </div>
    </div>
</Sapphire2025.Layout.Expert.ExpertDayContext>

@code {
    private ModalDialog mvarModal { get; set; } = new ModalDialog();

}
