@page "/submenu/{Page}"
@using Sapphire2025.Layout.SubMenus
@inject ExpertClient mvarExpertClient
@if(null!=Page)
{
    @if (Page.Equals("inspector"))
    {
        <div class="container py-4">
            <p class="lead text-secondary text-center mb-4">
                Todo lo necesario para las tareas que un inspector de operaciones requiere de la gestión del personal de movimiento y tracción.
            </p>
            <div class="d-flex flex-row flex-wrap gap-4 justify-content-center">
                <SMDrivers/>
                <div class="card flex-fill shadow-sm border-0 custom-card" style="min-width: 260px; max-width: 340px;">
                    <img src="img/PlatformReport.png" class="card-img-top" alt="Sapphire Log" style="object-fit: cover; height: 180px;">
                    <div class="card-body">
                        <h5 class="card-title fw-bold text-dark mb-2 custom-title">Vías</h5>
                        <p class="card-text text-muted custom-comment">
                            Estado del material
                        </p>
                        <a href="/inspector/platformreport" class="btn btn-outline-primary w-100">Abrir</a>
                    </div>
                </div>
                <SMDriversWorkSheet Agents="@mcolAgentsViews" />
                <SMTaller/>
                <SMTrainQuery/>
                <SMWorkDaySheet />
            </div>
        </div>
    }
    else if(Page.Equals("station"))
    {
        <div class="container py-4">
            <p class="lead text-secondary text-center mb-4">
                Gestión de personal y material móvil
            </p>
            <div class="d-flex flex-row flex-wrap gap-4 justify-content-center">
                <SMTaller/>
                <SMWorkDaySheet/>
                <SMDrivers />
                <SMTrainQuery />
            </div>
        </div>
    }
    else if (Page.Equals("caps"))
    {
        <div class="container py-4">
            <p class="lead text-secondary text-center mb-4">
                Conjunto de herramientas para responsables del colectivo de tracción y supervisión técnica del material móvil.
            </p>
            <div class="d-flex flex-row flex-wrap gap-4 justify-content-center">
                <SMWorkDaySheet />
                <SMDriversWorkSheet Agents="@mcolAgentsViews" />
                <SMTaller/>
                <SMTrainQuery />
            </div>
        </div>
    }
    else if (Page.Equals("mechanic"))
    {
        <div class="container py-4">
            <p class="lead text-secondary text-center mb-4">
                Herramientas para el personal de taller de SFM y de las empresas colaboradoras
            </p>
            <SMTaller/>
            <div class="d-flex flex-row flex-wrap gap-4 justify-content-center">
                <div class="card flex-fill shadow-sm border-0 custom-card" style="min-width: 260px; max-width: 340px;">
                    @* <span class="badge bg-primary position-absolute top-0 end-0 m-2 fs-6 shadow badge-animate">Nuevo</span> *@
                    <img src="img/TourmalineServiceMode.jpg" class="card-img-top" alt="Tourmaline" style="object-fit: cover; height: 180px;">
                    <div class="card-body">
                        <h5 class="card-title fw-bold text-dark mb-2 custom-title">Tourmaline</h5>
                        <p class="card-text text-muted custom-comment">
                            Modo de servicio de Tourmaline.
                        </p>
                        <a href="/tourmalineServiceMode" class="btn btn-outline-primary w-100">Abrir</a>
                    </div>
                </div>
            </div>
            <SMTrainQuery/>
        </div>
    }
    else if (Page.Equals("oficial"))
    {
        <div class="container py-4">
            <p class="lead text-secondary text-center mb-4">
                Herramientas para el personal de taller de SFM
            </p>
            <div class="d-flex flex-row flex-wrap gap-4 justify-content-center">
                <div class="card flex-fill shadow-sm border-0 custom-card" style="min-width: 260px; max-width: 340px;">
                    <span class="badge bg-primary position-absolute top-0 end-0 m-2 fs-6 shadow badge-animate">Nuevo</span>
                    <img src="img/disponib.png" class="card-img-top" alt="TimeSnap" style="object-fit: cover; height: 180px;">
                    <div class="card-body">
                        <h5 class="card-title fw-bold text-dark mb-2 custom-title">Disponibilidad</h5>
                        <p class="card-text text-muted custom-comment">
                            Línea temporal de disponibilidad
                        </p>
                        <a href="/timeSnap" class="btn btn-outline-primary w-100">Abrir</a>
                    </div>
                </div>
                <SMTrainQuery />
                <SMTaller/>
                <div class="d-flex flex-row flex-wrap gap-4 justify-content-center">
                    <div class="card flex-fill shadow-sm border-0 custom-card" style="min-width: 260px; max-width: 340px;">
                        @* <span class="badge bg-primary position-absolute top-0 end-0 m-2 fs-6 shadow badge-animate">Nuevo</span> *@
                        <img src="img/TourmalineServiceMode.jpg" class="card-img-top" alt="Tourmaline" style="object-fit: cover; height: 180px;">
                        <div class="card-body">
                            <h5 class="card-title fw-bold text-dark mb-2 custom-title">Tourmaline</h5>
                            <p class="card-text text-muted custom-comment">
                                Modo de servicio de Tourmaline.
                            </p>
                            <a href="/tourmalineServiceMode" class="btn btn-outline-primary w-100">Abrir</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
    else if (Page.Equals("engineer"))
    {
        <div class="container py-4">
            <p class="lead text-secondary text-center mb-4">
                Acceso a herramientas de minería de datos y evaluación del servicio
            </p>
            <div class="d-flex flex-row flex-wrap gap-4 justify-content-center">
                <div class="card flex-fill shadow-sm border-0 custom-card" style="min-width: 260px; max-width: 340px;">
                    @* <span class="badge bg-primary position-absolute top-0 end-0 m-2 fs-6 shadow badge-animate">Nuevo</span> *@
                    <img src="img/disponib.png" class="card-img-top" alt="TimeSnap" style="object-fit: cover; height: 180px;">
                    <div class="card-body">
                        <h5 class="card-title fw-bold text-dark mb-2 custom-title">Disponibilidad</h5>
                        <p class="card-text text-muted custom-comment">
                            Línea temporal de disponibilidad
                        </p>
                        <a href="/timeSnap/lines" class="btn btn-outline-primary w-100">Abrir</a>
                    </div>
                </div>
                <SMTrainQuery />
                <SMTaller/>                
                <SMWorkDaySheet />
                <div class="card flex-fill shadow-sm border-0 custom-card" style="min-width: 260px; max-width: 340px;">
                    @* <span class="badge bg-primary position-absolute top-0 end-0 m-2 fs-6 shadow badge-animate">Nuevo</span> *@
                    <img src="img/TimeNet.png" class="card-img-top" alt="Time Net BrainTrain" style="object-fit: cover; height: 180px;">
                    <div class="card-body">
                        <h5 class="card-title fw-bold text-dark mb-2 custom-title">Planes de Explotación</h5>
                        <p class="card-text text-muted custom-comment">
                            Mallas horarias de tracción
                        </p>
                        <a href="/admin/timenet" class="btn btn-outline-primary w-100">Abrir</a>
                    </div>
                </div>
                <div class="card flex-fill shadow-sm border-0 custom-card" style="min-width: 260px; max-width: 340px;">
                    <span class="badge bg-primary position-absolute top-0 end-0 m-2 fs-6 shadow badge-animate">Nuevo</span>
                    <img src="img/certificacion.jpg" class="card-img-top" alt="Disponibilidad" style="object-fit: cover; height: 180px;">
                    <div class="card-body">
                        <h5 class="card-title fw-bold text-dark mb-2 custom-title">Contrato SFM Erion</h5>
                        <p class="card-text text-muted custom-comment">
                            Seguimiento según pliego
                        </p>
                        <a href="/timeSnap/avail" class="btn btn-outline-primary w-100">Abrir</a>
                    </div>
                </div>
                <SMDriversWorkSheet Agents="@mcolAgentsViews"/>
            </div>
        </div>
    }
    else if (Page.Equals("anonymous"))
    {
        <div class="container py-4">
            <p class="lead text-secondary text-center mb-4">
                Material Móvil
            </p>
            <div class="d-flex flex-row flex-wrap gap-4 justify-content-center">
                <SMTaller/>
                <SMTrainQuery />
            </div>
        </div>
    }
    else if (Page.Equals("admin"))
    {
        <div class="container py-4">            
            <p class="lead text-secondary text-center mb-4">
                Configuración del sistema Zafiro para administradores
            </p>
            <div class="d-flex flex-row flex-wrap gap-4 justify-content-center">
                <div class="card flex-fill shadow-sm border-0 custom-card" style="min-width: 260px; max-width: 340px;">                    
                    <img src="img/UsersAdmin.png" class="card-img-top" alt="Users Administration" style="object-fit: cover; height: 180px;">
                    <div class="card-body">
                        <h5 class="card-title fw-bold text-dark mb-2 custom-title">Usuarios del Sistema</h5>
                        <p class="card-text text-muted custom-comment">
                            Gestión de usuarios y permisos
                        </p>
                        <a href="/admin/usersmanage" class="btn btn-outline-primary w-100">Abrir</a>
                    </div>
                </div>
                <div class="card flex-fill shadow-sm border-0 custom-card" style="min-width: 260px; max-width: 340px;">
                    <img src="img/SapphireLog.jpg" class="card-img-top" alt="Sapphire Log" style="object-fit: cover; height: 180px;">
                    <div class="card-body">
                        <h5 class="card-title fw-bold text-dark mb-2 custom-title">Eventos</h5>
                        <p class="card-text text-muted custom-comment">
                            Revisión de actividad
                        </p>
                        <a href="/admin/sapphirelog" class="btn btn-outline-primary w-100">Abrir</a>
                    </div>
                </div>
                <div class="card flex-fill shadow-sm border-0 custom-card" style="min-width: 260px; max-width: 340px;">
                    <img src="img/SplitFlap.png" class="card-img-top" alt="Horarios" style="object-fit: cover; height: 180px;">
                    <div class="card-body">
                        <h5 class="card-title fw-bold text-dark mb-2 custom-title">Explotación (Legacy)</h5>
                        <p class="card-text text-muted custom-comment">
                            Horarios, Planes de Explotación.
                        </p>
                        <a href="/admin/manageworkshifts" class="btn btn-outline-primary w-100">Abrir</a>
                    </div>
                </div>
                <div class="card flex-fill shadow-sm border-0 custom-card" style="min-width: 260px; max-width: 340px;">
                    <img src="img/EdicionTimeNet.png" class="card-img-top" alt="Horarios" style="object-fit: cover; height: 180px;">
                    <div class="card-body">
                        <h5 class="card-title fw-bold text-dark mb-2 custom-title">Explotación (TimeNet)</h5>
                        <p class="card-text text-muted custom-comment">
                            Horarios, Planes de Explotación.
                        </p>
                        <a href="/admin/managetimenet" class="btn btn-outline-primary w-100">Abrir</a>
                    </div>
                </div>
                <div class="d-flex flex-row flex-wrap gap-4 justify-content-center">
                    <div class="card flex-fill shadow-sm border-0 custom-card" style="min-width: 260px; max-width: 340px;">
                        @* <span class="badge bg-primary position-absolute top-0 end-0 m-2 fs-6 shadow badge-animate">Nuevo</span> *@
                        <img src="img/TourmalineServiceMode.jpg" class="card-img-top" alt="Tourmaline" style="object-fit: cover; height: 180px;">
                        <div class="card-body">
                            <h5 class="card-title fw-bold text-dark mb-2 custom-title">Tourmaline</h5>
                            <p class="card-text text-muted custom-comment">
                                Modo de servicio de Tourmaline.
                            </p>
                            <a href="/tourmalineServiceMode" class="btn btn-outline-primary w-100">Abrir</a>
                        </div>
                    </div>
                </div>
                <div class="d-flex flex-row flex-wrap gap-4 justify-content-center">
                    <div class="card flex-fill shadow-sm border-0 custom-card" style="min-width: 260px; max-width: 340px;">
                        @* <span class="badge bg-primary position-absolute top-0 end-0 m-2 fs-6 shadow badge-animate">Nuevo</span> *@
                        <img src="img/communication.jpg" class="card-img-top" alt="Comunicación" style="object-fit: cover; height: 180px;">
                        <div class="card-body">
                            <h5 class="card-title fw-bold text-dark mb-2 custom-title">Comunicación</h5>
                            <p class="card-text text-muted custom-comment">
                                Avisos a los usuarios del sistema.
                            </p>
                            <a href="/communication" class="btn btn-outline-primary w-100">Abrir</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
}

@code {
    //Página que contiene un determinado submenú con opciones.
    [Parameter]
    public string? Page { get; set; }
    
    private List<string>? mcolAgentsViews;

    protected async override Task OnInitializedAsync()
    {
        mcolAgentsViews = await mvarExpertClient.AgentsListsCatalog();
    }


}
