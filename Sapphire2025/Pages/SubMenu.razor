@page "/submenu/{Page}"
@using Sapphire2025.Layout.SubMenus
@inject ExpertClient mvarExpertClient
@if(null!=Page)
{
    @if (Page.Equals("inspector"))
    {
        <div class="container py-4">
            <p class="lead text-secondary text-center mb-4">
                @Prefs.T("menu.inspector.lead")
            </p>
            <div class="d-flex flex-row flex-wrap gap-4 justify-content-center">
                <SMDrivers/>
                <div class="card flex-fill shadow-sm border-0 custom-card" style="min-width: 260px; max-width: 340px;">
                    <img src="img/PlatformReport.png" class="card-img-top" alt="Sapphire Log" style="object-fit: cover; height: 180px;">
                    <div class="card-body">
                        <h5 class="card-title fw-bold text-dark mb-2 custom-title">@Prefs.T("card.platforms")</h5>
                        <p class="card-text text-muted custom-comment">
                            @Prefs.T("card.platforms.desc")
                        </p>
                        <a href="/inspector/platformreport" class="btn btn-outline-primary w-100">@Prefs.T("menu.open")</a>
                    </div>
                </div>
                <SMDriversWorkSheet Agents="@mcolAgentsViews" />
                <SMTaller/>
                <SMTrainQuery/>
                <SMWorkDaySheet />
            </div>
        </div>
    }
    else if(Page.Equals("station"))
    {
        <div class="container py-4">
            <p class="lead text-secondary text-center mb-4">
                @Prefs.T("menu.station.lead")
            </p>
            <div class="d-flex flex-row flex-wrap gap-4 justify-content-center">
                <SMTaller/>
                <SMWorkDaySheet/>
                <SMDrivers />
                <SMTrainQuery />
                <SMIncidenceQuery/>
            </div>
        </div>
    }
    else if (Page.Equals("caps"))
    {
        <div class="container py-4">
            <p class="lead text-secondary text-center mb-4">
                @Prefs.T("menu.caps.lead")
            </p>
            <div class="d-flex flex-row flex-wrap gap-4 justify-content-center">
                <SMWorkDaySheet />
                <SMDriversWorkSheet Agents="@mcolAgentsViews" />
                <SMTaller/>
                <SMTrainQuery />
                <SMIncidenceQuery />
            </div>
        </div>
    }
    else if (Page.Equals("mechanic"))
    {
        <div class="container py-4">
            <p class="lead text-secondary text-center mb-4">
                @Prefs.T("menu.mechanic.lead")
            </p>
            <SMTaller/>
            <div class="d-flex flex-row flex-wrap gap-4 justify-content-center">
                <div class="card flex-fill shadow-sm border-0 custom-card" style="min-width: 260px; max-width: 340px;">
                    @* <span class="badge bg-primary position-absolute top-0 end-0 m-2 fs-6 shadow badge-animate">Nuevo</span> *@
                    <img src="img/TourmalineServiceMode.jpg" class="card-img-top" alt="Tourmaline" style="object-fit: cover; height: 180px;">
                    <div class="card-body">
                        <h5 class="card-title fw-bold text-dark mb-2 custom-title">@Prefs.T("card.tourmaline")</h5>
                        <p class="card-text text-muted custom-comment">
                            @Prefs.T("card.tourmaline.desc")
                        </p>
                        <a href="/tourmalineServiceMode" class="btn btn-outline-primary w-100">@Prefs.T("menu.open")</a>
                    </div>
                </div>
            </div>
            <SMTrainQuery/>
            <SMIncidenceQuery />
        </div>
    }
    else if (Page.Equals("oficial"))
    {
        <div class="container py-4">
            <p class="lead text-secondary text-center mb-4">
                @Prefs.T("menu.oficial.lead")
            </p>
            <div class="d-flex flex-row flex-wrap gap-4 justify-content-center">
                <div class="card flex-fill shadow-sm border-0 custom-card" style="min-width: 260px; max-width: 340px;">
                    <span class="badge bg-primary position-absolute top-0 end-0 m-2 fs-6 shadow badge-animate">@Prefs.T("common.badge.new")</span>
                    <img src="img/disponib.png" class="card-img-top" alt="TimeSnap" style="object-fit: cover; height: 180px;">
                    <div class="card-body">
                        <h5 class="card-title fw-bold text-dark mb-2 custom-title">@Prefs.T("card.avail")</h5>
                        <p class="card-text text-muted custom-comment">
                            @Prefs.T("card.avail.desc")
                        </p>
                        <a href="/timeSnap" class="btn btn-outline-primary w-100">@Prefs.T("menu.open")</a>
                    </div>
                </div>
                <SMTrainQuery />
                <SMIncidenceQuery />
                <SMTaller/>
                <div class="d-flex flex-row flex-wrap gap-4 justify-content-center">
                    <div class="card flex-fill shadow-sm border-0 custom-card" style="min-width: 260px; max-width: 340px;">                        
                        <img src="img/TourmalineServiceMode.jpg" class="card-img-top" alt="Tourmaline" style="object-fit: cover; height: 180px;">
                        <div class="card-body">
                            <h5 class="card-title fw-bold text-dark mb-2 custom-title">@Prefs.T("card.tourmaline")</h5>
                            <p class="card-text text-muted custom-comment">
                                @Prefs.T("card.tourmaline.desc")
                            </p>
                            <a href="/tourmalineServiceMode" class="btn btn-outline-primary w-100">@Prefs.T("menu.open")</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
    else if (Page.Equals("engineer"))
    {
        <div class="container py-4">
            <p class="lead text-secondary text-center mb-4">
                @Prefs.T("menu.engineer.lead")
            </p>
            <div class="d-flex flex-row flex-wrap gap-4 justify-content-center">
                <div class="card flex-fill shadow-sm border-0 custom-card" style="min-width: 260px; max-width: 340px;">
                    @* <span class="badge bg-primary position-absolute top-0 end-0 m-2 fs-6 shadow badge-animate">Nuevo</span> *@
                    <img src="img/disponib.png" class="card-img-top" alt="TimeSnap" style="object-fit: cover; height: 180px;">
                    <div class="card-body">
                        <h5 class="card-title fw-bold text-dark mb-2 custom-title">@Prefs.T("card.avail")</h5>
                        <p class="card-text text-muted custom-comment">
                            @Prefs.T("card.avail.desc")
                        </p>
                        <a href="/timeSnap/lines" class="btn btn-outline-primary w-100">@Prefs.T("menu.open")</a>
                    </div>
                </div>
                <SMTrainQuery />
                <SMTaller/> 
                <SMIncidenceQuery />
                <SMWorkDaySheet />
                <div class="card flex-fill shadow-sm border-0 custom-card" style="min-width: 260px; max-width: 340px;">
                    @* <span class="badge bg-primary position-absolute top-0 end-0 m-2 fs-6 shadow badge-animate">Nuevo</span> *@
                    <img src="img/certificacion.jpg" class="card-img-top" alt="Disponibilidad" style="object-fit: cover; height: 180px;">
                    <div class="card-body">
                        <h5 class="card-title fw-bold text-dark mb-2 custom-title">@Prefs.T("card.contract")</h5>
                        <p class="card-text text-muted custom-comment">
                            @Prefs.T("card.contract.desc")
                        </p>
                        <a href="/timeSnap/avail" class="btn btn-outline-primary w-100">@Prefs.T("menu.open")</a>
                    </div>
                </div>
                <SMDriversWorkSheet Agents="@mcolAgentsViews"/>
            </div>
        </div>
    }
    else if (Page.Equals("diamond"))
    {
        <div class="container py-4">
            <p class="lead text-secondary text-center mb-4">
                @Prefs.T("menu.diamond.lead")
            </p>
            <div class="d-flex flex-row flex-wrap gap-4 justify-content-center">
                <div class="card flex-fill shadow-sm border-0 custom-card" style="min-width: 260px; max-width: 340px;">
                    <img src="img/SplitFlap.png" class="card-img-top" alt="Horarios" style="object-fit: cover; height: 180px;">
                    <div class="card-body">
                        <h5 class="card-title fw-bold text-dark mb-2 custom-title">@Prefs.T("card.legacy")</h5>
                        <p class="card-text text-muted custom-comment">
                            @Prefs.T("card.legacy.desc")
                        </p>
                        <a href="/admin/manageworkshifts" class="btn btn-outline-primary w-100">@Prefs.T("menu.open")</a>
                    </div>
                </div>
                <div class="card flex-fill shadow-sm border-0 custom-card" style="min-width: 260px; max-width: 340px;">
                    <img src="img/MajorcaMap.png" class="card-img-top" alt="Almacén" style="object-fit: cover; height: 180px;">
                    <div class="card-body">
                        <h5 class="card-title fw-bold text-dark mb-2 custom-title">@Prefs.T("card.store")</h5>
                        <p class="card-text text-muted custom-comment">
                            @Prefs.T("card.store.desc")
                        </p>
                        <a href="/engineer/topostorage" class="btn btn-outline-primary w-100">@Prefs.T("menu.open")</a>
                    </div>
                </div>
                <div class="card flex-fill shadow-sm border-0 custom-card" style="min-width: 260px; max-width: 340px;">
                    <img src="img/TimeNet.png" class="card-img-top" alt="Planes Diamond" style="object-fit: cover; height: 180px;">
                    <div class="card-body">
                        <h5 class="card-title fw-bold text-dark mb-2 custom-title">@Prefs.T("card.plans")</h5>
                        <p class="card-text text-muted custom-comment">
                            @Prefs.T("card.plans.desc")
                        </p>
                        <a href="/engineer/timenet" class="btn btn-outline-primary w-100">@Prefs.T("menu.open")</a>
                    </div>
                </div>
                <div class="card flex-fill shadow-sm border-0 custom-card" style="min-width: 260px; max-width: 340px;">
                    <img src="img/certificacion.jpg" class="card-img-top" alt="Verificar" style="object-fit: cover; height: 180px;">
                    <div class="card-body">
                        <h5 class="card-title fw-bold text-dark mb-2 custom-title">Verificar documentación</h5>
                        <p class="card-text text-muted custom-comment">
                            Compruebe un sello SEL o un código QR de consigna, libro o hoja de marcha y abra el documento oficial.
                        </p>
                        <a href="/engineer/docverify" class="btn btn-outline-primary w-100">@Prefs.T("menu.open")</a>
                    </div>
                </div>
            </div>
        </div>
    }
    else if (Page.Equals("anonymous"))
    {
        <div class="container py-4">
            <p class="lead text-secondary text-center mb-4">
                @Prefs.T("menu.anonymous.lead")
            </p>
            <div class="d-flex flex-row flex-wrap gap-4 justify-content-center">
                <SMTaller/>
                <div class="card flex-fill shadow-sm border-0 custom-card" style="min-width: 260px; max-width: 340px;">
                    <span class="badge bg-primary position-absolute top-0 end-0 m-2 fs-6 shadow badge-animate">@Prefs.T("common.badge.new")</span>
                    <img src="img/grExcel.png" class="card-img-top" alt="Gráfico" style="object-fit: cover; height: 180px;">
                    <div class="card-body">
                        <h5 class="card-title fw-bold text-dark mb-2 custom-title">@Prefs.T("card.mysheet")</h5>
                        <p class="card-text text-muted custom-comment">
                            @Prefs.T("card.mysheet.desc")
                        </p>
                        <a href="/drivers/schedules" class="btn btn-outline-primary w-100">@Prefs.T("menu.open")</a>
                    </div>
                </div>
                <SMTrainQuery />
                <SMIncidenceQuery />
            </div>
        </div>
    }
    else if (Page.Equals("admin"))
    {
        <div class="container py-4">            
            <p class="lead text-secondary text-center mb-4">
                @Prefs.T("menu.admin.lead")
            </p>
            <div class="d-flex flex-row flex-wrap gap-4 justify-content-center">
                <div class="card flex-fill shadow-sm border-0 custom-card" style="min-width: 260px; max-width: 340px;">                    
                    <img src="img/UsersAdmin.png" class="card-img-top" alt="Users Administration" style="object-fit: cover; height: 180px;">
                    <div class="card-body">
                        <h5 class="card-title fw-bold text-dark mb-2 custom-title">@Prefs.T("card.users")</h5>
                        <p class="card-text text-muted custom-comment">
                            @Prefs.T("card.users.desc")
                        </p>
                        <a href="/admin/usersmanage" class="btn btn-outline-primary w-100">@Prefs.T("menu.open")</a>
                    </div>
                </div>
                <div class="card flex-fill shadow-sm border-0 custom-card" style="min-width: 260px; max-width: 340px;">
                    <img src="img/SapphireLog.jpg" class="card-img-top" alt="Sapphire Log" style="object-fit: cover; height: 180px;">
                    <div class="card-body">
                        <h5 class="card-title fw-bold text-dark mb-2 custom-title">@Prefs.T("card.events")</h5>
                        <p class="card-text text-muted custom-comment">
                            @Prefs.T("card.events.desc")
                        </p>
                        <a href="/admin/sapphirelog" class="btn btn-outline-primary w-100">@Prefs.T("menu.open")</a>
                    </div>
                </div>
                <div class="d-flex flex-row flex-wrap gap-4 justify-content-center">
                    <div class="card flex-fill shadow-sm border-0 custom-card" style="min-width: 260px; max-width: 340px;">
                        @* <span class="badge bg-primary position-absolute top-0 end-0 m-2 fs-6 shadow badge-animate">Nuevo</span> *@
                        <img src="img/TourmalineServiceMode.jpg" class="card-img-top" alt="Tourmaline" style="object-fit: cover; height: 180px;">
                        <div class="card-body">
                            <h5 class="card-title fw-bold text-dark mb-2 custom-title">@Prefs.T("card.tourmaline")</h5>
                            <p class="card-text text-muted custom-comment">
                                @Prefs.T("card.tourmaline.desc")
                            </p>
                            <a href="/tourmalineServiceMode" class="btn btn-outline-primary w-100">@Prefs.T("menu.open")</a>
                        </div>
                    </div>
                </div>
                <div class="d-flex flex-row flex-wrap gap-4 justify-content-center">
                    <div class="card flex-fill shadow-sm border-0 custom-card" style="min-width: 260px; max-width: 340px;">
                        @* <span class="badge bg-primary position-absolute top-0 end-0 m-2 fs-6 shadow badge-animate">Nuevo</span> *@
                        <img src="img/communication.jpg" class="card-img-top" alt="Comunicación" style="object-fit: cover; height: 180px;">
                        <div class="card-body">
                            <h5 class="card-title fw-bold text-dark mb-2 custom-title">@Prefs.T("card.comm")</h5>
                            <p class="card-text text-muted custom-comment">
                                @Prefs.T("card.comm.desc")
                            </p>
                            <a href="/communication" class="btn btn-outline-primary w-100">@Prefs.T("menu.open")</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
}

@code {
    //Página que contiene un determinado submenú con opciones.
    [Parameter]
    public string? Page { get; set; }
    
    private List<string>? mcolAgentsViews;

    protected async override Task OnInitializedAsync()
    {
        mcolAgentsViews = await mvarExpertClient.AgentsListsCatalog();
    }


}
