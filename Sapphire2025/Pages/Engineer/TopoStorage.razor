@page "/engineer/topostorage"
@using System.Globalization
@using System.IO.Compression
@using System.Text
@using System.Text.Encodings.Web
@using Diamond.Topo
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using Sapphire2025.Layout.Generic
@using Sapphire2025.Storage
@using Sapphire2025Models.Diamond
@inject DiamondClient mvarDiamond
@inject IJSRuntime mvarJs
@inject NavigationManager mvarNav
@attribute [Authorize]

<PageTitle>Almacén Diamond · Topologías y planes</PageTitle>

<div class="container-fluid topo-storage-page @(mvarBusy ? "topo-busy" : null)">
	<div class="topo-hero d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3">
		<div>
			<h1>Almacén Diamond</h1>
			<p>Topologías geográficas y planes de explotación (scripts) versionados en Zafiro.</p>
		</div>
	</div>

	@if (!string.IsNullOrEmpty(mvarNotice))
	{
		<div class="alert @(mvarNoticeOk ? "alert-success" : "alert-warning") alert-dismissible fade show" role="alert">
			@mvarNotice
			<button type="button" class="btn-close" @onclick="() => mvarNotice = null"></button>
		</div>
	}

	<TabControl Classic="true" PersistenceKey="diamond-store-tabs">
		<TabPage Text="Topologías" Key="topos">
			<div class="topo-toolbar mb-3 flex-wrap">
				<button type="button" class="btn btn-primary btn-sm" @onclick="ReloadToposAsync" disabled="@mvarBusy">
					<i class="bi bi-arrow-clockwise"></i> Actualizar
				</button>
				<label class="btn btn-success btn-sm mb-0">
					<i class="bi bi-upload"></i> Subir topo
					<InputFile OnChange="OnUploadTopoAsync" accept=".xml,.gz,application/xml,text/xml" style="display:none;" disabled="@mvarBusy" />
				</label>
				<button type="button" class="btn btn-outline-secondary btn-sm" @onclick="DownloadSelectedTopoAsync"
						disabled="@(mvarBusy || mvarSelectedTopo is null)">
					<i class="bi bi-download"></i> Exportar
				</button>
				<button type="button" class="btn btn-outline-warning btn-sm" @onclick="ConfirmDeleteTopoAsync"
						disabled="@(mvarBusy || mvarSelectedTopo is null || mvarSelectedTopo is { IsActive: false } || mvarSelectedTopo is { IsLockedByPlans: true })"
						title="@(mvarSelectedTopo is { IsLockedByPlans: true } ? "Hay planes que usan esta topología" : "Desactivar")">
					<i class="bi bi-trash"></i> Eliminar
				</button>
				<button type="button" class="btn btn-outline-info btn-sm" @onclick="ActivateSelectedTopoAsync"
						disabled="@(mvarBusy || mvarSelectedTopo is null || mvarSelectedTopo is { IsActive: true })">
					<i class="bi bi-check2-circle"></i> Activar
				</button>
				<div class="form-check form-switch ms-2 mb-0">
					<input class="form-check-input" type="checkbox" id="chkInactiveTopo" @bind="mvarShowInactiveTopos" @bind:after="ReloadToposAsync" />
					<label class="form-check-label small" for="chkInactiveTopo">Incluir inactivas</label>
				</div>
			</div>

			<div class="row g-3">
				<div class="col-12 col-lg-4">
					<div class="topo-panel">
						<div class="topo-panel-header">
							<h2>Topologías</h2>
							<span class="badge text-bg-primary topo-badge-soft">@mcolTopos.Count</span>
						</div>
						<div class="topo-list">
							@if (mvarBusy && mcolTopos.Count == 0)
							{
								<div class="topo-empty-state"><div class="spinner-border text-primary mb-2"></div><div>Cargando…</div></div>
							}
							else if (mcolTopos.Count == 0)
							{
								<div class="topo-empty-state">
									<div class="mb-2"><i class="bi bi-geo-alt fs-3"></i></div>
									<div>No hay topologías. Use <strong>Subir topo</strong>.</div>
								</div>
							}
							else
							{
								@foreach (DiamondTopoHeaderModel item in mcolTopos)
								{
									bool selected = mvarSelectedTopo is not null && mvarSelectedTopo.Id == item.Id;
									<div class="topo-item @(selected ? "active" : null)" @onclick="() => SelectTopoAsync(item)" @key="item.Id">
										<div class="d-flex justify-content-between align-items-start gap-2">
											<p class="topo-item-title">@item.Name</p>
											<div class="d-flex gap-1">
												@if (item.IsLockedByPlans)
												{
													<span class="badge text-bg-warning topo-badge-soft" title="Planes activos">@item.ReferencingPlanCount plan(es)</span>
												}
												@if (!item.IsActive)
												{
													<span class="badge text-bg-secondary topo-badge-soft">Inactiva</span>
												}
											</div>
										</div>
										<div class="topo-item-meta">
											<span><i class="bi bi-diagram-3"></i> @item.AxisCount ejes</span>
											<span><i class="bi bi-building"></i> @item.StationCount est.</span>
											<span><i class="bi bi-hdd"></i> @FormatBytes(item.ByteLength)</span>
										</div>
										<div class="topo-item-meta mt-1">
											<code title="@item.Id">@ShortGuid(item.Id)</code>
											<span class="text-muted">@item.CreatedUtc.ToLocalTime().ToString("g")</span>
										</div>
									</div>
								}
							}
						</div>
					</div>
				</div>
				<div class="col-12 col-lg-8">
					<div class="topo-panel">
						<div class="topo-panel-header">
							<h2>Detalle topología</h2>
							@if (mvarSelectedTopo is not null)
							{
								<span class="badge @(mvarSelectedTopo.IsActive ? "text-bg-success" : "text-bg-secondary") topo-badge-soft">
									@(mvarSelectedTopo.IsActive ? "Activa" : "Inactiva")
								</span>
							}
						</div>
						<div class="topo-detail">
							@if (mvarSelectedTopo is null)
							{
								<div class="topo-empty-state">
									<div class="mb-2"><i class="bi bi-map fs-3"></i></div>
									<div>Seleccione una topología del listado.</div>
								</div>
							}
							else
							{
								@if (mvarSelectedTopo.IsLockedByPlans)
								{
									<div class="alert alert-warning py-2 small">
										Esta topología está <strong>bloqueada</strong>: @mvarSelectedTopo.ReferencingPlanCount plan(es) de explotación activos la referencian.
										No se puede desactivar hasta reasignar o desactivar esos planes.
									</div>
								}
								<dl class="topo-kv">
									<dt>Nombre</dt><dd>@mvarSelectedTopo.Name</dd>
									<dt>Id</dt><dd><code>@mvarSelectedTopo.Id</code></dd>
									<dt>Layout Id</dt><dd>@(string.IsNullOrWhiteSpace(mvarSelectedTopo.LayoutId) ? "—" : mvarSelectedTopo.LayoutId)</dd>
									<dt>Autor</dt><dd>@(string.IsNullOrWhiteSpace(mvarSelectedTopo.Author) ? "—" : mvarSelectedTopo.Author)</dd>
									<dt>Fichero</dt><dd>@(string.IsNullOrWhiteSpace(mvarSelectedTopo.SourceFileName) ? "—" : mvarSelectedTopo.SourceFileName)</dd>
									<dt>Formato</dt><dd><span class="badge text-bg-light border">@mvarSelectedTopo.Format</span> · @FormatBytes(mvarSelectedTopo.ByteLength)</dd>
									<dt>Content hash</dt><dd class="topo-hash">@mvarSelectedTopo.ContentHash</dd>
									<dt>Huella estructural</dt><dd class="topo-hash">@mvarSelectedTopo.StructuralHash</dd>
									<dt>Planes</dt><dd>@mvarSelectedTopo.ReferencingPlanCount activos</dd>
									<dt>Alta</dt><dd>@mvarSelectedTopo.CreatedUtc.ToLocalTime().ToString("G")</dd>
								</dl>

								@if (mvarLoadingLayout)
								{
									<div class="text-center text-muted py-4"><div class="spinner-border spinner-border-sm me-2"></div>Cargando geometría…</div>
								}
								else if (!string.IsNullOrEmpty(mvarLayoutError))
								{
									<div class="alert alert-danger py-2">@mvarLayoutError</div>
								}
								else if (mvarLayout is not null)
								{
									<div class="d-flex justify-content-between align-items-center mb-2">
										<strong class="small text-uppercase text-secondary">Mapa de red</strong>
										<span class="small text-muted">@mvarLayout.Axes.Count ejes · @mvarLayout.Stations.Count estaciones</span>
									</div>
									<div class="topo-map-wrap">
										@if (string.IsNullOrEmpty(mvarMapSvg))
										{
											<div class="topo-map-empty">Sin vértices geográficos dibujables.</div>
										}
										else
										{
											@((MarkupString)mvarMapSvg)
										}
									</div>
									@if (mcolLegend.Count > 0)
									{
										<div class="topo-legend">
											@foreach (LegendItem leg in mcolLegend)
											{
												<span class="topo-legend-item">
													<span class="topo-legend-swatch" style="background:@leg.Color"></span>
													@leg.Label
												</span>
											}
										</div>
									}
								}
							}
						</div>
					</div>
				</div>
			</div>
		</TabPage>

		<TabPage Text="Planes de explotación" Key="plans">
			<div class="topo-toolbar mb-3 flex-wrap align-items-center">
				<button type="button" class="btn btn-primary btn-sm" @onclick="ReloadPlansAsync" disabled="@mvarBusy">
					<i class="bi bi-arrow-clockwise"></i> Actualizar
				</button>
				<div class="d-flex align-items-center gap-2">
					<label class="small text-muted mb-0">Topo:</label>
					<select class="form-select form-select-sm" style="min-width:12rem;" @bind="mvarUploadPlanTopoId">
						<option value="@Guid.Empty">— elegir topología —</option>
						@foreach (DiamondTopoHeaderModel t in mcolActiveToposForPlans)
						{
							<option value="@t.Id">@t.Name</option>
						}
					</select>
				</div>
				<label class="btn btn-success btn-sm mb-0 @(mvarUploadPlanTopoId == Guid.Empty ? "disabled" : null)">
					<i class="bi bi-upload"></i> Subir plan (.ddm)
					<InputFile OnChange="OnUploadPlanAsync" accept=".ddm,.txt,text/plain" style="display:none;"
							   disabled="@(mvarBusy || mvarUploadPlanTopoId == Guid.Empty)" />
				</label>
				<button type="button" class="btn btn-outline-secondary btn-sm" @onclick="DownloadSelectedPlanAsync"
						disabled="@(mvarBusy || mvarSelectedPlan is null)">
					<i class="bi bi-download"></i> Exportar
				</button>
				<button type="button" class="btn btn-outline-warning btn-sm" @onclick="ConfirmDeletePlanAsync"
						disabled="@(mvarBusy || mvarSelectedPlan is null || mvarSelectedPlan is { IsActive: false })">
					<i class="bi bi-trash"></i> Eliminar
				</button>
				<button type="button" class="btn btn-outline-info btn-sm" @onclick="ActivateSelectedPlanAsync"
						disabled="@(mvarBusy || mvarSelectedPlan is null || mvarSelectedPlan is { IsActive: true })">
					<i class="bi bi-check2-circle"></i> Activar
				</button>
				<div class="form-check form-switch ms-2 mb-0">
					<input class="form-check-input" type="checkbox" id="chkInactivePlan" @bind="mvarShowInactivePlans" @bind:after="ReloadPlansAsync" />
					<label class="form-check-label small" for="chkInactivePlan">Incluir inactivos</label>
				</div>
			</div>

			<div class="row g-3">
				<div class="col-12 col-lg-4">
					<div class="topo-panel">
						<div class="topo-panel-header">
							<h2>Planes</h2>
							<span class="badge text-bg-primary topo-badge-soft">@mcolPlans.Count</span>
						</div>
						<div class="topo-list">
							@if (mvarBusy && mcolPlans.Count == 0)
							{
								<div class="topo-empty-state"><div class="spinner-border text-primary mb-2"></div><div>Cargando…</div></div>
							}
							else if (mcolPlans.Count == 0)
							{
								<div class="topo-empty-state">
									<div class="mb-2"><i class="bi bi-file-earmark-code fs-3"></i></div>
									<div>No hay planes. Elija una topología y suba un script <code>.ddm</code>.</div>
								</div>
							}
							else
							{
								@foreach (DiamondPlanHeaderModel item in mcolPlans)
								{
									bool selected = mvarSelectedPlan is not null && mvarSelectedPlan.Id == item.Id;
									<div class="topo-item @(selected ? "active" : null)" @onclick="() => SelectPlanAsync(item)" @ondblclick="() => OpenPlanInEditor(item)" @key="item.Id" title="Doble clic para abrir en el planificador">
										<div class="d-flex justify-content-between align-items-start gap-2">
											<p class="topo-item-title">@item.Name</p>
											@if (!item.IsActive)
											{
												<span class="badge text-bg-secondary topo-badge-soft">Inactivo</span>
											}
										</div>
										<div class="topo-item-meta">
											<span><i class="bi bi-geo"></i> @(string.IsNullOrWhiteSpace(item.TopoName) ? ShortGuid(item.TopoId) : item.TopoName)</span>
											<span><i class="bi bi-file-text"></i> @FormatBytes(item.ScriptByteLength)</span>
										</div>
										<div class="topo-item-meta mt-1">
											<code title="@item.Id">@ShortGuid(item.Id)</code>
											<span class="text-muted">@item.UpdatedUtc.ToLocalTime().ToString("g")</span>
										</div>
									</div>
								}
							}
						</div>
					</div>
				</div>
				<div class="col-12 col-lg-8">
					<div class="topo-panel">
						<div class="topo-panel-header">
							<h2>Detalle plan</h2>
							@if (mvarSelectedPlan is not null)
							{
								<span class="badge @(mvarSelectedPlan.IsActive ? "text-bg-success" : "text-bg-secondary") topo-badge-soft">
									@(mvarSelectedPlan.IsActive ? "Activo" : "Inactivo")
								</span>
							}
						</div>
						<div class="topo-detail">
							@if (mvarSelectedPlan is null)
							{
								<div class="topo-empty-state">
									<div class="mb-2"><i class="bi bi-journal-code fs-3"></i></div>
									<div>Seleccione un plan para ver su script y la topología asociada.</div>
								</div>
							}
							else if (mvarLoadingPlan)
							{
								<div class="text-center text-muted py-4"><div class="spinner-border spinner-border-sm me-2"></div>Cargando plan…</div>
							}
							else
							{
								<dl class="topo-kv">
									<dt>Nombre</dt><dd>@mvarSelectedPlan.Name</dd>
									<dt>Id</dt><dd><code>@mvarSelectedPlan.Id</code></dd>
									<dt>Topología</dt>
									<dd>
										<strong>@mvarSelectedPlan.TopoName</strong>
										<span class="text-muted small ms-1">(@ShortGuid(mvarSelectedPlan.TopoId))</span>
									</dd>
									<dt>Include script</dt>
									<dd>@(string.IsNullOrWhiteSpace(mvarSelectedPlan.IncludedTopoPath) ? "—" : mvarSelectedPlan.IncludedTopoPath)</dd>
									<dt>Fichero</dt><dd>@(string.IsNullOrWhiteSpace(mvarSelectedPlan.SourceFileName) ? "—" : mvarSelectedPlan.SourceFileName)</dd>
									<dt>Tamaño</dt><dd>@FormatBytes(mvarSelectedPlan.ScriptByteLength)</dd>
									<dt>Content hash</dt><dd class="topo-hash">@mvarSelectedPlan.ContentHash</dd>
									<dt>Topo content hash</dt><dd class="topo-hash">@mvarSelectedPlan.TopoContentHash</dd>
									<dt>Topo estructural</dt><dd class="topo-hash">@mvarSelectedPlan.TopoStructuralHash</dd>
									<dt>Alta / act.</dt>
									<dd>@mvarSelectedPlan.CreatedUtc.ToLocalTime().ToString("g") · @mvarSelectedPlan.UpdatedUtc.ToLocalTime().ToString("g")</dd>
									@if (!string.IsNullOrWhiteSpace(mvarSelectedPlan.Notes))
									{
										<dt>Notas</dt><dd>@mvarSelectedPlan.Notes</dd>
									}
								</dl>

								<div class="d-flex justify-content-between align-items-center mb-2">
									<strong class="small text-uppercase text-secondary">Script Diamond</strong>
									<button type="button" class="btn btn-sm btn-primary" @onclick="() => OpenPlanInEditor(mvarSelectedPlan)" title="Abrir este plan en el editor de malla">
										<i class="bi bi-diagram-3"></i> Abrir en planificador
									</button>
								</div>
								<pre class="topo-script-view">@((mvarSelectedPlan.SourceScript ?? string.Empty))</pre>
							}
						</div>
					</div>
				</div>
			</div>
		</TabPage>

		<TabPage Text="Turnos de personal" Key="shifts" Enabled="false">
			<div class="topo-empty-state py-5">
				<div class="mb-2"><i class="bi bi-people fs-2 text-muted"></i></div>
				<p class="mb-1 fw-semibold">Turnos de personal</p>
				<p class="text-muted small mb-0">Reservado para el planificador de turnos. Próximamente.</p>
			</div>
		</TabPage>
	</TabControl>
</div>

<ModalDialog @ref="mvarDeleteModal" OnClose="OnDeleteModalClose" />

@code {
	private enum DeleteTargetKind { None, Topo, Plan }

	private readonly List<DiamondTopoHeaderModel> mcolTopos = new List<DiamondTopoHeaderModel>();
	private readonly List<DiamondTopoHeaderModel> mcolActiveToposForPlans = new List<DiamondTopoHeaderModel>();
	private readonly List<DiamondPlanHeaderModel> mcolPlans = new List<DiamondPlanHeaderModel>();
	private readonly List<LegendItem> mcolLegend = new List<LegendItem>();
	private readonly string[] mcolPalette =
	{
		"#38bdf8", "#a78bfa", "#34d399", "#fbbf24", "#f472b6",
		"#22d3ee", "#fb7185", "#4ade80", "#c084fc", "#facc15"
	};

	private DiamondTopoHeaderModel? mvarSelectedTopo;
	private DiamondPlanHeaderModel? mvarSelectedPlan;
	private TopoLayout? mvarLayout;
	private string? mvarMapSvg;
	private string? mvarLayoutError;
	private string? mvarNotice;
	private bool mvarNoticeOk;
	private bool mvarBusy;
	private bool mvarLoadingLayout;
	private bool mvarLoadingPlan;
	private bool mvarShowInactiveTopos;
	private bool mvarShowInactivePlans;
	private Guid mvarUploadPlanTopoId = Guid.Empty;
	private ModalDialog? mvarDeleteModal;
	private DeleteTargetKind mvarDeleteKind = DeleteTargetKind.None;
	private Guid mvarPendingDeleteId = Guid.Empty;

	protected override async Task OnInitializedAsync()
	{
		await ReloadToposAsync();
		await ReloadPlansAsync();
	}

	private async Task ReloadToposAsync()
	{
		mvarBusy = true;
		try
		{
			IReadOnlyList<DiamondTopoHeaderModel> list = await mvarDiamond.ListToposAsync(!mvarShowInactiveTopos);
			mcolTopos.Clear();
			int i = 0;
			while (i < list.Count)
			{
				mcolTopos.Add(list[i]);
				i++;
			}

			// Activas para el selector de planes
			IReadOnlyList<DiamondTopoHeaderModel> active = await mvarDiamond.ListToposAsync(activeOnly: true);
			mcolActiveToposForPlans.Clear();
			i = 0;
			while (i < active.Count)
			{
				mcolActiveToposForPlans.Add(active[i]);
				i++;
			}

			if (mvarSelectedTopo is not null)
			{
				DiamondTopoHeaderModel? still = FindTopo(mvarSelectedTopo.Id);
				if (still is null)
				{
					ClearTopoSelection();
				}
				else
				{
					mvarSelectedTopo = still;
				}
			}
		}
		catch (Exception ex)
		{
			mvarNoticeOk = false;
			mvarNotice = "No se pudo cargar topologías: " + Friendly(ex);
			mcolTopos.Clear();
			ClearTopoSelection();
		}
		finally
		{
			mvarBusy = false;
		}
	}

	private async Task ReloadPlansAsync()
	{
		mvarBusy = true;
		try
		{
			IReadOnlyList<DiamondPlanHeaderModel> list = await mvarDiamond.ListPlansAsync(!mvarShowInactivePlans);
			mcolPlans.Clear();
			int i = 0;
			while (i < list.Count)
			{
				mcolPlans.Add(list[i]);
				i++;
			}

			if (mvarSelectedPlan is not null)
			{
				DiamondPlanHeaderModel? still = null;
				int j = 0;
				while (j < mcolPlans.Count)
				{
					if (mcolPlans[j].Id == mvarSelectedPlan.Id)
					{
						still = mcolPlans[j];
						break;
					}
					j++;
				}

				if (still is null)
				{
					ClearPlanSelection();
				}
				else
				{
					// refrescar cabecera; script se recarga al seleccionar
					mvarSelectedPlan = still;
					await SelectPlanAsync(still);
				}
			}
		}
		catch (Exception ex)
		{
			mvarNoticeOk = false;
			mvarNotice = "No se pudo cargar planes: " + Friendly(ex);
			mcolPlans.Clear();
			ClearPlanSelection();
		}
		finally
		{
			mvarBusy = false;
		}
	}

	private DiamondTopoHeaderModel? FindTopo(Guid id)
	{
		int i = 0;
		while (i < mcolTopos.Count)
		{
			if (mcolTopos[i].Id == id)
			{
				return mcolTopos[i];
			}
			i++;
		}
		return null;
	}

	private async Task SelectTopoAsync(DiamondTopoHeaderModel item)
	{
		if (mvarSelectedTopo is not null && mvarSelectedTopo.Id == item.Id && mvarLayout is not null)
		{
			return;
		}

		mvarSelectedTopo = item;
		mvarLayout = null;
		mvarMapSvg = null;
		mvarLayoutError = null;
		mcolLegend.Clear();
		mvarLoadingLayout = true;
		StateHasChanged();

		try
		{
			byte[]? payload = await mvarDiamond.DownloadTopoContentAsync(item.Id);
			if (payload is null || payload.Length == 0)
			{
				mvarLayoutError = "No se pudo descargar el documento.";
				return;
			}

			byte[] xmlBytes = await MaterializeXmlAsync(payload, item.Format);
			using (MemoryStream stream = new MemoryStream(xmlBytes, writable: false))
			{
				mvarLayout = TopoXmlSerializer.Load(stream);
			}

			mvarMapSvg = BuildMapSvg(mvarLayout, mcolLegend);
		}
		catch (Exception ex)
		{
			mvarLayoutError = "Error al interpretar la topología: " + Friendly(ex);
			mvarLayout = null;
			mvarMapSvg = null;
		}
		finally
		{
			mvarLoadingLayout = false;
		}
	}

	private async Task SelectPlanAsync(DiamondPlanHeaderModel item)
	{
		mvarSelectedPlan = item;
		mvarLoadingPlan = true;
		StateHasChanged();
		try
		{
			DiamondPlanHeaderModel? full = await mvarDiamond.GetPlanAsync(item.Id);
			if (full is not null)
			{
				mvarSelectedPlan = full;
			}
		}
		catch (Exception ex)
		{
			mvarNoticeOk = false;
			mvarNotice = "Error al cargar el plan: " + Friendly(ex);
		}
		finally
		{
			mvarLoadingPlan = false;
		}
	}

	private async Task OnUploadTopoAsync(InputFileChangeEventArgs e)
	{
		IBrowserFile? file = e.File;
		if (file is null) return;

		mvarBusy = true;
		mvarNotice = null;
		try
		{
			const long max = 8L * 1024L * 1024L;
			await using Stream stream = file.OpenReadStream(max);
			using MemoryStream ms = new MemoryStream();
			await stream.CopyToAsync(ms);
			DiamondTopoUploadResult? result = await mvarDiamond.UploadTopoAsync(ms.ToArray(), file.Name);
			if (result is null)
			{
				mvarNoticeOk = false;
				mvarNotice = "Sin respuesta del servidor al subir la topología.";
				return;
			}

			mvarNoticeOk = result.Success;
			mvarNotice = string.IsNullOrWhiteSpace(result.Message)
				? (result.Success ? "Topología almacenada." : "Rechazada.")
				: result.Message;
			if (result.Success)
			{
				await ReloadToposAsync();
				if (result.Header is not null)
				{
					DiamondTopoHeaderModel? match = FindTopo(result.Header.Id);
					if (match is not null)
					{
						await SelectTopoAsync(match);
					}
				}
			}
		}
		catch (Exception ex)
		{
			mvarNoticeOk = false;
			mvarNotice = "Error al subir topo: " + Friendly(ex);
		}
		finally
		{
			mvarBusy = false;
		}
	}

	private async Task OnUploadPlanAsync(InputFileChangeEventArgs e)
	{
		IBrowserFile? file = e.File;
		if (file is null) return;
		if (mvarUploadPlanTopoId == Guid.Empty)
		{
			mvarNoticeOk = false;
			mvarNotice = "Seleccione la topología del almacén a la que se ancla el plan.";
			return;
		}

		mvarBusy = true;
		mvarNotice = null;
		try
		{
			const long max = 4L * 1024L * 1024L;
			await using Stream stream = file.OpenReadStream(max);
			using MemoryStream ms = new MemoryStream();
			await stream.CopyToAsync(ms);
			DiamondPlanSaveResult? result = await mvarDiamond.UploadPlanAsync(
				ms.ToArray(),
				file.Name,
				mvarUploadPlanTopoId);
			if (result is null)
			{
				mvarNoticeOk = false;
				mvarNotice = "Sin respuesta del servidor al subir el plan.";
				return;
			}

			mvarNoticeOk = result.Success;
			mvarNotice = string.IsNullOrWhiteSpace(result.Message)
				? (result.Success ? "Plan almacenado." : "Rechazado.")
				: result.Message;
			if (result.Success)
			{
				await ReloadPlansAsync();
				await ReloadToposAsync(); // contadores de planes
				if (result.Header is not null)
				{
					await SelectPlanAsync(result.Header);
				}
			}
		}
		catch (Exception ex)
		{
			mvarNoticeOk = false;
			mvarNotice = "Error al subir plan: " + Friendly(ex);
		}
		finally
		{
			mvarBusy = false;
		}
	}

	private async Task DownloadSelectedTopoAsync()
	{
		if (mvarSelectedTopo is null) return;
		mvarBusy = true;
		try
		{
			byte[]? payload = await mvarDiamond.DownloadTopoContentAsync(mvarSelectedTopo.Id);
			if (payload is null || payload.Length == 0)
			{
				mvarNoticeOk = false;
				mvarNotice = "No se pudo descargar.";
				return;
			}

			string fileName = string.IsNullOrWhiteSpace(mvarSelectedTopo.SourceFileName)
				? SanitizeFileName(mvarSelectedTopo.Name) + ".xml"
				: mvarSelectedTopo.SourceFileName;
			string mime = string.Equals(mvarSelectedTopo.Format, "xml-gz", StringComparison.OrdinalIgnoreCase)
				? "application/gzip"
				: "application/xml";
			await mvarJs.InvokeVoidAsync("downloadBytesFile", Convert.ToBase64String(payload), fileName, mime);
		}
		catch (Exception ex)
		{
			mvarNoticeOk = false;
			mvarNotice = "Error al exportar: " + Friendly(ex);
		}
		finally
		{
			mvarBusy = false;
		}
	}

	private async Task DownloadSelectedPlanAsync()
	{
		if (mvarSelectedPlan is null) return;
		mvarBusy = true;
		try
		{
			DiamondPlanHeaderModel? full = mvarSelectedPlan;
			if (string.IsNullOrEmpty(full.SourceScript))
			{
				full = await mvarDiamond.GetPlanAsync(mvarSelectedPlan.Id) ?? mvarSelectedPlan;
			}

			string script = full.SourceScript ?? string.Empty;
			string fileName = string.IsNullOrWhiteSpace(full.SourceFileName)
				? SanitizeFileName(full.Name) + ".ddm"
				: full.SourceFileName;
			await mvarJs.InvokeVoidAsync("downloadTextFile", script, fileName, "text/plain;charset=utf-8");
		}
		catch (Exception ex)
		{
			mvarNoticeOk = false;
			mvarNotice = "Error al exportar plan: " + Friendly(ex);
		}
		finally
		{
			mvarBusy = false;
		}
	}

	private async Task ConfirmDeleteTopoAsync()
	{
		if (mvarSelectedTopo is null || mvarDeleteModal is null) return;
		if (mvarSelectedTopo.IsLockedByPlans)
		{
			mvarNoticeOk = false;
			mvarNotice = "No se puede eliminar: hay planes activos que usan esta topología.";
			return;
		}

		mvarDeleteKind = DeleteTargetKind.Topo;
		mvarPendingDeleteId = mvarSelectedTopo.Id;
		await mvarDeleteModal.show(
			"Desactivar topología",
			string.Format("¿Desactivar «{0}»? El documento permanece en BD (baja lógica).", mvarSelectedTopo.Name),
			"Desactivar",
			"Cancelar");
	}

	private async Task ConfirmDeletePlanAsync()
	{
		if (mvarSelectedPlan is null || mvarDeleteModal is null) return;
		mvarDeleteKind = DeleteTargetKind.Plan;
		mvarPendingDeleteId = mvarSelectedPlan.Id;
		await mvarDeleteModal.show(
			"Desactivar plan",
			string.Format("¿Desactivar el plan «{0}»?", mvarSelectedPlan.Name),
			"Desactivar",
			"Cancelar");
	}

	private async Task OnDeleteModalClose(bool confirmed)
	{
		if (!confirmed || Guid.Empty.Equals(mvarPendingDeleteId))
		{
			mvarDeleteKind = DeleteTargetKind.None;
			mvarPendingDeleteId = Guid.Empty;
			return;
		}

		Guid id = mvarPendingDeleteId;
		DeleteTargetKind kind = mvarDeleteKind;
		mvarPendingDeleteId = Guid.Empty;
		mvarDeleteKind = DeleteTargetKind.None;
		mvarBusy = true;
		try
		{
			if (kind == DeleteTargetKind.Topo)
			{
				DiamondTopoUploadResult? result = await mvarDiamond.DeleteTopoAsync(id);
				mvarNoticeOk = result is not null && result.Success;
				mvarNotice = result?.Message ?? "No se pudo desactivar la topología.";
				await ReloadToposAsync();
			}
			else if (kind == DeleteTargetKind.Plan)
			{
				DiamondPlanSaveResult? result = await mvarDiamond.DeletePlanAsync(id);
				mvarNoticeOk = result is not null && result.Success;
				mvarNotice = result?.Message ?? "No se pudo desactivar el plan.";
				await ReloadPlansAsync();
				await ReloadToposAsync();
			}
		}
		catch (Exception ex)
		{
			mvarNoticeOk = false;
			mvarNotice = "Error al desactivar: " + Friendly(ex);
		}
		finally
		{
			mvarBusy = false;
		}
	}

