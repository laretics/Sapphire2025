@page "/engineer/topostorage"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]

<PageTitle>@Prefs.T("page.topostorage")</PageTitle>

<div class="container-fluid topo-storage-page">
	<div class="topo-hero d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3">
		<div>
			<h1>@Prefs.T("topo.title")</h1>
			<p>@Prefs.T("topo.subtitle")</p>
		</div>
	</div>

	<TabControl Classic="true" PersistenceKey="diamond-store-tabs">
		<TabPage Text="@Prefs.T("topo.topologies")" Key="topos">
			<TopoStorageToposTab />
		</TabPage>

		<TabPage Text="Planes de explotación" Key="plans">
			<TopoStoragePlansTab />
		</TabPage>

		<TabPage Text="Limitaciones temporales" Key="templimits">
			<TemporaryLimitsEditor />
		</TabPage>

		<TabPage Text="Festivos" Key="festives">
			<FestiveCalendar />
		</TabPage>

		<TabPage Text="Documentación" Key="docs">
			<TopoStorageDocumentationTab />
		</TabPage>

		<TabPage Text="Verificación" Key="verify">
			<OfficialDocumentVerifyPanel />
		</TabPage>

		<TabPage Text="Publicación" Key="published">
			<TopoStoragePublishedTab />
		</TabPage>

		<TabPage Text="@Prefs.T("topo.places")" Key="places">
			<TopoStoragePlacesTab />
		</TabPage>

		<TabPage Text="Turnos de personal" Key="shifts" Enabled="false">
			<TopoStorageShiftsTab />
		</TabPage>
	</TabControl>
</div>
