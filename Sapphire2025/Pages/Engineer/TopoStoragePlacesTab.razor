@using BlazorMonaco
@using BlazorMonaco.Editor
@using Sapphire2025.Icons
@using Sapphire2025Models.Diamond
@inject DiamondClient mvarDiamond

@if (!string.IsNullOrEmpty(mvarNotice))
{
	<div class="alert @(mvarNoticeOk ? "alert-success" : "alert-danger") alert-dismissible fade show" role="alert">
		@mvarNotice
		<button type="button" class="btn-close" @onclick="() => mvarNotice = null"></button>
	</div>
}

@if (mcolIssues.Count > 0)
{
	<div class="alert alert-danger places-issues" role="alert">
		<div class="fw-bold mb-2">No se puede actualizar el catálogo. Corrija estos @mcolIssues.Count error(es):</div>
		<ol class="places-issues-list mb-0">
			@foreach (PlacesXmlIssue issue in mcolIssues)
			{
				<li>
					@if (issue.Line > 0)
					{
						<button type="button"
								class="btn btn-link btn-sm p-0 align-baseline places-issue-line"
								@onclick="() => GoToIssueAsync(issue)"
								title="Ir a la línea @issue.Line">
							Línea @issue.Line
						</button>
						<span class="places-issue-sep">·</span>
					}
					<span>@issue.Message</span>
				</li>
			}
		</ol>
	</div>
}

<div class="topo-toolbar mb-3 flex-wrap align-items-center">
	<button type="button" class="btn btn-primary btn-sm" @onclick="ReloadAsync" disabled="@mvarBusy">
		<GenIcon Name="Refresh" Size="16" /> @Prefs.T("common.refresh")
	</button>
	<button type="button" class="btn btn-outline-secondary btn-sm" @onclick="ReviewAsync" disabled="@(mvarBusy || !mvarLoaded)">
		<GenIcon Name="CheckBoxChecked" Size="16" /> Revisar formato
	</button>
	<button type="button" class="btn btn-success btn-sm" @onclick="SaveAsync" disabled="@(mvarBusy || !mvarLoaded || mcolIssues.Count > 0)">
		<GenIcon Name="Save" Size="16" /> @Prefs.T("common.save")
	</button>
	@if (!string.IsNullOrEmpty(mvarHash))
	{
		<span class="small text-muted topo-hash" title="@mvarHash">SHA-256 @ShortHash</span>
	}
	@if (mvarUpdatedUtc.HasValue && mvarUpdatedUtc.Value > DateTime.MinValue)
	{
		<span class="small text-muted">@mvarUpdatedUtc.Value.ToLocalTime().ToString("g")</span>
	}
</div>

<div class="topo-panel places-editor-panel">
	<div class="topo-panel-header">
		<h2>places.xml</h2>
		<span class="text-muted small">Lugares y mensajes pregrabados. El tren lo descarga si el hash cambia.</span>
	</div>
	@if (mvarBusy && !mvarLoaded)
	{
		<div class="topo-empty-state">
			<div class="spinner-border text-primary mb-2"></div>
			<div>Cargando catálogo…</div>
		</div>
	}
	else if (!mvarLoaded)
	{
		<div class="topo-empty-state">
			<div class="mb-2"><GenIcon Name="Warning" Size="24" /></div>
			<div>No se pudo abrir el catálogo del servidor. Se conserva el archivo local de cada tren.</div>
		</div>
	}
	else
	{
		<div class="places-monaco-host">
			<StandaloneCodeEditor @ref="mvarEditor"
								  Id="places-xml-editor"
								  ConstructionOptions="EditorOptions"
								  OnDidChangeModelContent="OnEditorChangedAsync"
								  CssClass="places-monaco" />
		</div>
	}
</div>

@code {
	private StandaloneCodeEditor? mvarEditor;
	private bool mvarBusy;
	private bool mvarLoaded;
	private string? mvarNotice;
	private bool mvarNoticeOk;
	private string mvarXml = string.Empty;
	private string mvarHash = string.Empty;
	private DateTime? mvarUpdatedUtc;
	private List<PlacesXmlIssue> mcolIssues = new List<PlacesXmlIssue>();
	private bool mvarReviewed;

	private string ShortHash =>
		mvarHash.Length <= 12 ? mvarHash : mvarHash.Substring(0, 12);

	protected override async Task OnInitializedAsync()
	{
		await ReloadAsync();
	}

	private StandaloneEditorConstructionOptions EditorOptions(StandaloneCodeEditor editor)
	{
		return new StandaloneEditorConstructionOptions
		{
			AutomaticLayout = true,
			Language = "xml",
			Theme = "vs-dark",
			Value = mvarXml,
			Minimap = new EditorMinimapOptions { Enabled = false },
			FontSize = 13,
			LineNumbers = "on",
			WordWrap = "on",
			ScrollBeyondLastLine = false,
			RenderLineHighlight = "all",
			TabSize = 2,
			InsertSpaces = true
		};
	}

	private Task OnEditorChangedAsync(ModelContentChangedEvent _)
	{
		if (mcolIssues.Count > 0 || mvarReviewed)
		{
			mcolIssues = new List<PlacesXmlIssue>();
			mvarReviewed = false;
			if (!mvarNoticeOk)
				mvarNotice = null;
			StateHasChanged();
		}

		return Task.CompletedTask;
	}

	private async Task ReloadAsync()
	{
		mvarBusy = true;
		mvarNotice = null;
		mcolIssues = new List<PlacesXmlIssue>();
		mvarReviewed = false;
		try
		{
			PlacesCatalogContentModel? content = await mvarDiamond.DownloadPlacesCatalogAsync();
			if (content is null || string.IsNullOrWhiteSpace(content.Xml))
			{
				mvarLoaded = false;
				mvarNoticeOk = false;
				mvarNotice = "No hay places.xml en el servidor o no hay conexión.";
				return;
			}

			mvarXml = content.Xml;
			mvarHash = content.ContentHash ?? string.Empty;
			mvarUpdatedUtc = content.UpdatedUtc;
			mvarLoaded = true;
			if (mvarEditor is not null)
				await mvarEditor.SetValue(mvarXml);
		}
		catch (Exception ex)
		{
			mvarLoaded = false;
			mvarNoticeOk = false;
			mvarNotice = "No se pudo cargar places.xml: " + ex.Message;
		}
		finally
		{
			mvarBusy = false;
		}
	}

	private async Task ReviewAsync()
	{
		if (mvarEditor is null)
			return;

		mvarBusy = true;
		mvarNotice = null;
		try
		{
			string xml = await mvarEditor.GetValue();
			ApplyIssues(PlacesXmlValidator.Validate(xml));
			mvarReviewed = true;
			if (mcolIssues.Count == 0)
			{
				mvarNoticeOk = true;
				mvarNotice = "Formato correcto. Puede guardar el catálogo.";
			}
			else
			{
				mvarNoticeOk = false;
				mvarNotice = "Hay errores de formato. El catálogo no se actualizará hasta corregirlos.";
			}
		}
		catch (Exception ex)
		{
			mvarNoticeOk = false;
			mvarNotice = "No se pudo revisar el documento: " + ex.Message;
		}
		finally
		{
			mvarBusy = false;
		}
	}

	private async Task SaveAsync()
	{
		if (mvarEditor is null)
			return;

		mvarBusy = true;
		mvarNotice = null;
		try
		{
			string xml = await mvarEditor.GetValue();
			ApplyIssues(PlacesXmlValidator.Validate(xml));
			mvarReviewed = true;
			if (mcolIssues.Count > 0)
			{
				mvarNoticeOk = false;
				mvarNotice = "No se ha actualizado el catálogo. Corrija los errores de formato.";
				return;
			}

			PlacesCatalogSaveResult? result = await mvarDiamond.SavePlacesCatalogAsync(xml);
			if (result is null)
			{
				mvarNoticeOk = false;
				mvarNotice = "El servidor no respondió al guardar.";
				return;
			}

			if (result.Errors is not null && result.Errors.Count > 0)
			{
				ApplyIssues(result.Errors);
				mvarNoticeOk = false;
				mvarNotice = string.IsNullOrWhiteSpace(result.Message)
					? "El servidor rechazó el documento por errores de formato."
					: result.Message;
				return;
			}

			mvarNoticeOk = result.Success;
			mvarNotice = result.Message;
			if (result.Success)
			{
				mvarXml = xml;
				mvarHash = result.ContentHash ?? string.Empty;
				mvarUpdatedUtc = result.UpdatedUtc;
				mcolIssues = new List<PlacesXmlIssue>();
				mvarReviewed = false;
			}
		}
		catch (Exception ex)
		{
			mvarNoticeOk = false;
			mvarNotice = "No se pudo guardar: " + ex.Message;
		}
		finally
		{
			mvarBusy = false;
		}
	}

	private async Task GoToIssueAsync(PlacesXmlIssue issue)
	{
		if (mvarEditor is null || issue.Line <= 0)
			return;

		try
		{
			int column = issue.Column > 0 ? issue.Column : 1;
			await mvarEditor.SetPosition(new BlazorMonaco.Position
			{
				LineNumber = issue.Line,
				Column = column
			}, "places-goto");
			await mvarEditor.RevealLineInCenter(issue.Line);
			await mvarEditor.Focus();
		}
		catch
		{
		}
	}

	private void ApplyIssues(IReadOnlyList<PlacesXmlIssue> issues)
	{
		mcolIssues = issues is List<PlacesXmlIssue> list
			? list
			: new List<PlacesXmlIssue>(issues);
	}
}
