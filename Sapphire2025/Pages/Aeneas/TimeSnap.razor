@page "/timeSnap/{page}"
@using Sapphire2025Models.Aeneas
@using Sapphire2025.Layout.Aeneas
@inject AeneasClient mvarAeneasClient
@inject IJSRuntime JS


<div class="container-fluid py-3">
    <div class="card shadow mb-4">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">@HeaderContent()</h5>
        </div>
        <div class="card-body">
            <TimeSnapSelector 
                FilterChanged="@RefreshData"
                StartDateChanged="@OnStartDateChanged"
                IntervalChanged="@OnIntervalChanged"
                Interval="@interval" 
                StartDate="@mvarStartDate"
                SelectedSeries="@selectedSeries"
                SeriesOptions="@seriesOptions">
                <!-- Gráfico de disponibilidad -->
                @if (loading)
                {
                    <div class="text-center my-5">
                        <div class="spinner-border text-primary" role="status"></div>
                        <div>@Prefs.T("timesnap.loading")</div>
                    </div>
                }
                else if (trains.Any())
                {
                    @if("lines"==page)
                    {
                        <TimeSnapCTL trains="trains"
                                     startDate="startDate"
                                     interval="intervalSpan"
                                     title="@HeaderContent()"
                                     intervalLabel="@interval" />
                    }
                    else if("avail"==page)
                    {
                        <TimeAvailCTL trains="trains"
                                     startDate="startDate"
                                     interval="intervalSpan"
                                     title="@HeaderContent()"
                                     intervalLabel="@interval" />
                    }
                }
                else
                {
                    <div class="alert alert-info mt-4">@Prefs.T("timesnap.empty")</div>
                }
            </TimeSnapSelector>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public string? page{ get; set; }

    private string interval = "Semanal";
    private List<TrainModel> trains = new();

    private DateTime mvarStartDate = DateTime.Today;
    private DateTime startDate
    {
        get => mvarStartDate;
        set
        {
            if (mvarStartDate != value)
            {
                mvarStartDate = value;
                _ = RefreshData();
            }
        }
    }

    private bool loading = true;

    // Series disponibles
    private string[] seriesOptions = { "7100", "8100", "9100", "1100", "otros" };
    private Dictionary<string, bool> selectedSeries = new();

    protected async override Task OnInitializedAsync()
    {        
        foreach (var serie in seriesOptions)
            selectedSeries[serie] = true;        
        await JS.InvokeVoidAsync("sapphirePrint.preloadLogo", "img/sfmImg.png");
    }

    private string HeaderContent()
    {
        System.Text.StringBuilder salida = new System.Text.StringBuilder();
        if ("lines" == page)
            salida.Append(Prefs.T("timesnap.fleet"));
        else if ("avail" == page)
            salida.Append(Prefs.T("timesnap.preventive"));

        if (trains.Count > 1)
            salida.Append(Prefs.T("timesnap.ntrains", trains.Count));
        else if (trains.Count > 0)
            salida.Append(Prefs.T("timesnap.train", trains.First().name));

        return salida.ToString();
    }

    private async Task RefreshData()
    {
        loading = true;
        trains = new List<TrainModel>();
        List<TrainModel> auxTrenes = (await mvarAeneasClient.trainsList()).OrderBy(xx => xx.name).ToList();
        //Para cada tren, dependiendo de la serie, añadimos un registro
        foreach (TrainModel auxTren in auxTrenes)
        {
            if (isSeries(auxTren))
            {
                await loadChanges(auxTren);
                if (isRelevant(auxTren) && !trains.Any(t => t.id == auxTren.id))
                    trains.Add(auxTren);
            }
        }
        loading = false;
        StateHasChanged();
    }
    private async Task OnStartDateChanged(DateTime? rhs)
    {
        if(null!=rhs)
            mvarStartDate = rhs.Value;
    }
    private async Task OnIntervalChanged(string? rhs)
    {
        if(null!=rhs)
            interval = rhs;
    }
    private async Task OnSeriesChanged(Dictionary<string,bool>? rhs)
    {
        if(null!=rhs)
            selectedSeries = rhs;
    }

    private bool isSeries(TrainModel tren)
    {
        if (tren.name.StartsWith("11"))
        {
            if (selectedSeries["1100"]) return true;
        }
        else if (tren.name.StartsWith("71"))
        {
            if (selectedSeries["7100"]) return true;
        }
        else if (tren.name.StartsWith("81"))
        {
            if (selectedSeries["8100"]) return true;
        }
        else if (tren.name.StartsWith("91"))
        {
            if (selectedSeries["9100"]) return true;
        }
        else if (selectedSeries["otros"]) return true;

        return false;
    }
    private async Task loadChanges(TrainModel tren)
    {
        // 1. Cargar todos los cambios de estado del tren (puedes optimizar esto si tu API lo permite)
        IEnumerable<StatusChangeModel> allChanges = (await mvarAeneasClient.trainChangesList(tren.id, DateTime.MinValue))
            .OrderBy(c => c.timeStamp)
            .ToList();

        // 2. Buscar el último cambio anterior al intervalo
        var lastBefore = allChanges
            .Where(c => c.timeStamp < startDate)
            .LastOrDefault();

        // 3. Tomar los cambios dentro del intervalo
        var inInterval = allChanges
            .Where(c => c.timeStamp >= startDate && c.timeStamp <= startDate.Add(intervalSpan))
            .ToList();

        // 4. Si hay un cambio anterior, lo añadimos al principio
        if (lastBefore != null)
            inInterval.Insert(0, lastBefore);

        tren.StatusChanges = inInterval;
    }



    private bool isRelevant(TrainModel tren)
    {
        if (null == tren.StatusChanges||tren.StatusChanges.Count<1) return false;
        foreach(StatusChangeModel change in tren.StatusChanges)
        {
            if (change.status == Sapphire2025Models.Common.TrainStatus.DepotAvailable ||
            change.status == Sapphire2025Models.Common.TrainStatus.DepotRequested ||
            change.status == Sapphire2025Models.Common.TrainStatus.Maintenance ||
            change.status == Sapphire2025Models.Common.TrainStatus.Repairing ||
            change.status == Sapphire2025Models.Common.TrainStatus.RequestToDiagnose ||
            change.status == Sapphire2025Models.Common.TrainStatus.RequestToRepair)
                return true;
        }
        return false;
    }
    // Cálculo del intervalo en función del filtro
    private TimeSpan intervalSpan => interval switch
    {
        "Semanal" => TimeSpan.FromDays(7),
        "Quincenal" => TimeSpan.FromDays(14),
        "Mensual" => TimeSpan.FromDays(30),
        "Anual" => TimeSpan.FromDays(365),
        _ => TimeSpan.FromDays(7)
    };
}