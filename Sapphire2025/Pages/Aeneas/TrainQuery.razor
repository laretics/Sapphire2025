@page "/trainQuery"
@using Sapphire2025.Layout.Aeneas
@using Sapphire2025Models
@inject AeneasClient mvarAeneasClient
@inject AuthenticationClient mvarAuthClient
@inject IntStorageService mvarInternalStorage

<PageTitle>@Prefs.T("page.trains")</PageTitle>

<div class="container-fluid py-4">
    <div class="card shadow mb-4">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
            <h4 class="mb-0">@Prefs.T("page.trains")</h4>
            <button class="btn btn-outline-light" @onclick="PrintPage">
                <i class="bi bi-printer"></i> @Prefs.T("common.print")
            </button>
        </div>
        <div class="card-body">
            <!-- Filtros de búsqueda -->
            <form class="row g-3 mb-4" @onsubmit="OnSearch">
                <div class="col-md-2">
                    <label class="form-label">@Prefs.T("common.number")</label>
                    <input class="form-control" @bind="filterTrainName" placeholder="@Prefs.T("trainq.number.ph")" />
                </div>
                <div class="col-md-2">
                    <label class="form-label">@Prefs.T("common.status")</label>
                    <select class="form-select" @bind="filterStatus">
                        <option value="">@Prefs.T("common.all")</option>
                        @foreach (var status in Enum.GetValues<Common.TrainStatus>())
                        {
                            <option value="@status">@Common.TrainStatusToString(status)</option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label">@Prefs.T("common.place")</label>
                    <select class="form-select" @bind="filterStationName">
                        <option value="">@Prefs.T("common.all")</option>
                        @foreach (var station in mcolPlatforms.Select(p => p.StationName).Distinct())
                        {
                            <option value="@station">@station</option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label">@Prefs.T("common.user")</label>
                    <select class="form-select" @bind="filterUserId">
                        <option value="">@Prefs.T("common.all")</option>
                        @foreach (var user in Users)
                        {
                            <option value="@user.Key">@user.Value.Name</option>
                        }
                    </select>
                </div>
                <div class="col-md-3 d-flex align-items-end">
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="bi bi-search"></i> @Prefs.T("common.search")
                    </button>
                </div>
            </form>

            <!-- Resultados -->
            @if (loading)
            {
                <div class="text-center my-5">
                    <div class="spinner-border text-primary" role="status"></div>
                    <div>@Prefs.T("common.loading.results")</div>
                </div>
            }
            else if (Trains.Any())
            {
                <CascadingValue Value="Users">
                    <CascadingValue Value="Trains">
                        <CascadingValue Value="mcolPlatforms">
                            <AvailableTrainsTable Width="80" Height="100" Filtered = "false">
                            </AvailableTrainsTable>
                        </CascadingValue>
                    </CascadingValue>
                </CascadingValue>
            }
            else
            {
                <div class="alert alert-warning mt-4">
                    No se encontraron resultados para los filtros seleccionados.
                </div>
            }
        </div>
    </div>
</div>

@code {
    private string? filterTrainName;
    private Common.TrainStatus? filterStatus;
    private Guid? filterUserId;
    private string? filterStationName;
    private bool loading = true;

    private IEnumerable<TrainModel> AllTrains = new List<TrainModel>();
    private IEnumerable<TrainModel> Trains = new List<TrainModel>();
    private Dictionary<Guid, UserModelBase>? Users = new();
    private Sapphire2025Models.Aeneas.PlatformModel[] mcolPlatforms { get; set; } = new PlatformModel[0];

    protected override async Task OnInitializedAsync()
    {
        loading = true;
        AllTrains = (await mvarAeneasClient.trainsList()).ToList();
        Users = await mvarAuthClient.cachedUserList();
        Trains = AllTrains;
        mcolPlatforms = await mvarInternalStorage.GetPlatformList();
        if (mcolPlatforms.Length < 1)
        {
            IEnumerable<PlatformModel>? auxLista = await mvarAeneasClient.platformsList();
            if (null != auxLista)
            {
                mcolPlatforms = new PlatformModel[auxLista.Count()];
                foreach (PlatformModel elemento in auxLista)
                    mcolPlatforms[elemento.Id - 1] = elemento;

                await mvarInternalStorage.SetPlatformList(mcolPlatforms); //Lo guardo en la caché para poder usarlo
            }
        }
        loading = false;
    }

    private async Task OnSearch()
    {
        loading = true;
        await Task.Delay(100); // Simula carga si quieres
        Trains = AllTrains
           .Where(t =>
               (string.IsNullOrWhiteSpace(filterTrainName) || (t.name?.Contains(filterTrainName, StringComparison.OrdinalIgnoreCase) ?? false)) &&
               (!filterStatus.HasValue || t.lastStatus == filterStatus) &&
               (!filterUserId.HasValue || t.lastUserInfo == filterUserId) &&
               (string.IsNullOrWhiteSpace(filterStationName) ||
                   mcolPlatforms.FirstOrDefault(p => p.Id == t.PlatformId)?.StationName == filterStationName)
           )
           .ToList();
        loading = false;
        StateHasChanged();
    }

    private string GetUserName(Guid userId)
    {
        if (Users.TryGetValue(userId, out var user))
        {
            if(null!=user.Name)
                return user.Name;
        }        
        return "-";
    }

    private string GetLastOperation(TrainModel train)
    {
        // Puedes personalizar esto según tu modelo
        return train.lastStatus.ToString();
    }

    private void PrintPage()
    {
        JS.InvokeVoidAsync("window.print");
    }

    [Inject]
    private IJSRuntime JS { get; set; } = default!;
}
