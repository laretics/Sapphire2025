@page "/train/{idtxt}"
@using Sapphire2025.Layout.Aeneas
@using Sapphire2025.Layout.Generic
@using Sapphire2025Models.GMao
@inject AeneasClient mvarAeneasClient
@inject AuthenticationClient mvarAuthClient

@if(null==mvarTrain)
{
	<div class="d-flex justify-content-center align-items-center" style="height: 100vh;">
		<div class="card" style="width: 24rem;">
			<img src="img/ZafiroTheme.jpeg" class="card-img-top" alt="...">
			<div class="card-body">
				<h5 class="card-title">Cargando</h5>
				<div class="spinner-grow"></div>
				<p class="card-text">Cargando datos...</p>
			</div>
		</div>
	</div>
}
else
{
	<CascadingValue Value="@Users">
		<CascadingValue Value="@mvarTrain">
			<CascadingValue Value="@mcolWorkOrders">
				<TrainDossierHeader />
				<TrainCommandBar />

				<TabControl>
					<TabPage Text="General">
						<NoteChatEx Parent="@mvarTrain.id" NoteType="2" MaxLines="@MaxLinesPerChat" />
					</TabPage>
					<TabPage Text="Chat">
						<NoteChat Parent="@mvarTrain.id" NoteType="2" MaxLines="@MaxLinesPerChat" />
					</TabPage>
					<TabPage Text="Historial">
						<div class="table-responsive" style="width:100%; max-height:70vh;">
							<StatusChangesTable StatusChanges="mcolChanges" />
						</div>
					</TabPage>
					<TabPage Text="Actuaciones">
						<div class="table-responsive" style="width:100%; max-height:70vh;">
							<WorkOrdersTable />
						</div>
					</TabPage>
					<TabPage Text="Limpieza">
						<Sapphire2025.Icons.AeneasScheme />
					</TabPage>					
				</TabControl>
			</CascadingValue>
		</CascadingValue>
	</CascadingValue>
}
@code {
	[Parameter]
	public string? idtxt{ get; set; }

	[Parameter]
	public int MaxLinesPerChat { get; set; } = 30;


	public Guid id;

	private Dictionary<Guid, UserModelBase>? Users = new Dictionary<Guid, UserModelBase>();
	private IEnumerable<StatusChangeModel>? mcolChanges = new List<StatusChangeModel>();
	private IEnumerable<WorkOrderModel>? mcolWorkOrders = null;
	private TrainModel? mvarTrain = null;

	protected async override Task OnInitializedAsync()
	{
		if(null!=idtxt)
		{
			Guid.TryParse(idtxt, out id);
			mcolChanges = await mvarAeneasClient.trainChangesList(id, DateTime.MinValue);
			Users = await mvarAuthClient.cachedUserList();

			mvarTrain = await mvarAeneasClient.train(id.ToString());
			if(null!=mvarTrain)
				mcolWorkOrders = await mvarAeneasClient.workOrdersByTrain(mvarTrain.id);
		}
		StateHasChanged();
	}
}
