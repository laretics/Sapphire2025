@page "/trainFlow"
@using Sapphire2025.Layout.Aeneas.Scheme
@using Sapphire2025.Layout.Aeneas
@inject AeneasClient mvarAeneasClient
@inject AuthenticationClient mvarAuthClient
@inject NavigationManager mvarNavigator
@inject IntStorageService mvarInternalStorage
@inject IJSRuntime mvarJSRuntime
@implements IDisposable
@if(null==mcolTrains)
{
	<div class="d-flex justify-content-center align-items-center trainflow-loading">
		<div class="text-center px-3">
			<div class="spinner-border text-primary mb-3 trainflow-spinner" role="status">
				<span class="visually-hidden">Cargando...</span>
			</div>
			<div>
				<h5 class="mt-2">Cargando ciclos de taller...</h5>
				<p class="text-muted mb-0">Por favor, espere un momento.</p>
			</div>
		</div>
	</div>
}
else
{
	<div class="trainflow-page">
		<!-- Barra de herramientas -->
		<div class="toolbar trainflow-toolbar mb-3 p-2 bg-light border rounded shadow-sm">
			<div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
				<!-- Grupo izquierdo: Acciones principales -->
				<div class="btn-toolbar" role="toolbar">
					<div class="btn-group me-2 mb-1" role="group">
						<button type="button" class="btn btn-primary btn-sm" @onclick="RefreshData" title="Actualizar datos">
							<i class="bi bi-arrow-clockwise"></i>
							<span class="btn-label-full"> Actualizar</span>
							<span class="btn-label-short"> Act.</span>
						</button>
						<button type="button" class="btn btn-success btn-sm" title="Exportar datos">
							<i class="bi bi-download"></i>
							<span class="btn-label-full"> Exportar</span>
							<span class="btn-label-short"> Exp.</span>
						</button>
					</div>

					<div class="btn-group me-2 mb-1" role="group">
						<button type="button" class="btn @(Extended ? "btn-warning" : "btn-outline-secondary") btn-sm"
								@onclick="changeExtended"
								title="@(Extended ? "Vista compacta" : "Vista extendida")">
							<i class="bi @(Extended ? "bi-arrows-angle-contract" : "bi-arrows-angle-expand")"></i>
							<span class="btn-label-full"> @(Extended ? "Compactar" : "Expandir")</span>
						</button>
					</div>

					<div class="btn-group me-2 mb-1" role="group">
						<button type="button" class="btn @(AudioNotificationsEnabled ? "btn-info" : "btn-outline-secondary") btn-sm"
								@onclick="ToggleAudioNotifications"
								title="@(AudioNotificationsEnabled ? "Desactivar notificaciones de audio" : "Activar notificaciones de audio")">
							<i class="bi @(AudioNotificationsEnabled ? "bi-volume-up-fill" : "bi-volume-mute-fill")"></i>
							<span class="btn-label-full"> @(AudioNotificationsEnabled ? "Sonido" : "Silencio")</span>
						</button>
					</div>
				</div>

				<!-- Grupo derecho: Info y configuración -->
				<div class="btn-toolbar trainflow-stats" role="toolbar">
					@if (mcolHighlightedTrains.Count > 0)
					{
						<div class="badge bg-warning text-dark me-1 mb-1 d-flex align-items-center px-2 px-sm-3 py-2 trainflow-live-badge">
							<i class="bi bi-lightning-charge-fill me-1 me-sm-2"></i>
							<span>@mcolHighlightedTrains.Count <span class="btn-label-full">cambio(s) reciente(s)</span><span class="btn-label-short">cambios</span></span>
						</div>
					}
					<div class="badge bg-secondary me-1 mb-1 d-flex align-items-center px-2 px-sm-3 py-2">
						<i class="bi bi-train-front me-1 me-sm-2"></i>
						<span><span class="btn-label-full">Disponibles: </span><span class="btn-label-short">Disp. </span>@AvailableTrains</span>
					</div>
					<div class="badge bg-secondary me-1 mb-1 d-flex align-items-center px-2 px-sm-3 py-2">
						<i class="bi bi-train-front me-1 me-sm-2"></i>
						<span><span class="btn-label-full">Taller: </span><span class="btn-label-short">Tall. </span>@NonAvailableTrains</span>
					</div>
					<div class="badge bg-secondary me-1 mb-1 d-flex align-items-center px-2 px-sm-3 py-2">
						<i class="bi bi-train-front me-1 me-sm-2"></i>
						<span><span class="btn-label-full">Total: </span><span class="btn-label-short">Tot. </span>@mcolTrains.Count()</span>
					</div>
					<button type="button" class="btn btn-outline-secondary btn-sm mb-1" title="Configuración">
						<i class="bi bi-gear"></i>
					</button>
				</div>
			</div>
		</div>

		<CascadingValue Value="Extended">
			<CascadingValue Value="mcolTrains">
				<CascadingValue Value="mcolPlatforms">
					<CascadingValue Value="Users">
						<CascadingValue Value="CurrentStatus">
							<CascadingValue Name="HighlightedTrainIds" Value="mcolHighlightedTrains">
								<CascadingValue Name="TrainDataVersion" Value="mvarDataVersion">
									<div class="row align-items-stretch g-2 trainflow-main-row">
										<div class="col-12 col-lg-5 pe-lg-2 trainflow-scheme-col">
											<div class="trainflow-scheme-panel border rounded bg-white p-1 p-md-2">
												<AeneasScheme OnStatusSelected="HandleStatusSelected"
															OnOpenTrain="HandleOpenTrain"
															width="100" height="50"/>
											</div>
										</div>
										<div class="col-12 col-lg-7 ps-lg-2 trainflow-status-col">
											<div class="trainflow-table-panel table-scroll-x border rounded bg-white">
												<StatusTrainsTable Width="100" Height="50" />
											</div>
										</div>
									</div>
									<div class="row align-items-start mt-2 g-2 trainflow-available-row">
										<div class="col">
											<div class="trainflow-table-panel table-scroll-x border rounded bg-white">
												<AvailableTrainsTable Width="95" Height="50" />
											</div>
										</div>
									</div>
								</CascadingValue>
							</CascadingValue>
						</CascadingValue>
					</CascadingValue>
				</CascadingValue>
			</CascadingValue>
		</CascadingValue>
	</div>
}

@code 
{
	private static readonly TimeSpan PollInterval = TimeSpan.FromSeconds(5);
	private static readonly TimeSpan HighlightDuration = TimeSpan.FromSeconds(6);

	private List<TrainModel> mcolTrains { get; set; }
	private Sapphire2025Models.Aeneas.PlatformModel[] mcolPlatforms { get; set; } = new PlatformModel[0];
	private HashSet<Guid> mcolHighlightedTrains { get; set; } = new();
	private int mvarDataVersion;

	[Parameter]
	public Sapphire2025Models.Common.TrainStatus CurrentStatus { get; set; }	
	[Parameter]
	public Dictionary<Guid,UserModelBase>? Users{ get; set; }

	private bool Extended { get; set; } = false;
	private bool AudioNotificationsEnabled { get; set; } = false;
	private Timer? mvarPollTimer;
	private Timer? mvarHighlightTimer;
	private DateTime mvarLastSyncTime = DateTime.MinValue;
	private bool mvarSyncInProgress;

	protected async override Task OnInitializedAsync()
	{
		await LoadPlatforms();
		await TrainCache();
		StartPolling();
	}

	public void Dispose()
	{
		mvarPollTimer?.Dispose();
		mvarHighlightTimer?.Dispose();
	}

	private int AvailableTrains {get =>
		mcolTrains.Where(xx => xx.lastStatus == Sapphire2025Models.Common.TrainStatus.Available ||
		xx.lastStatus == Sapphire2025Models.Common.TrainStatus.DepotRequested ||
		xx.lastStatus == Sapphire2025Models.Common.TrainStatus.RequestToDiagnose ||
		xx.lastStatus == Sapphire2025Models.Common.TrainStatus.RequestToRepair).Count();
	}
	private int NonAvailableTrains { get =>
		mcolTrains.Where(xx => xx.lastStatus == Sapphire2025Models.Common.TrainStatus.Maintenance ||
		xx.lastStatus == Sapphire2025Models.Common.TrainStatus.Repairing).Count();
	}

	private void HandleStatusSelected(Sapphire2025Models.Common.TrainStatus status)
	{
		CurrentStatus = status;
		StateHasChanged();
	}
	private void HandleOpenTrain(Guid id)
	{
		mvarNavigator.NavigateTo(string.Format("/train/{0}", id));
	}
	private void changeExtended()
	{
		Extended = !Extended;
		StateHasChanged();
	}

	private async Task ToggleAudioNotifications()
	{
		AudioNotificationsEnabled = !AudioNotificationsEnabled;
		if (AudioNotificationsEnabled)
			await mvarJSRuntime.InvokeVoidAsync("sapphireSound.play", "sound/Ding.mp3");
		StateHasChanged();
	}
	private async Task RefreshData()
	{
		await mvarInternalStorage.ResetTrainList();
		mcolTrains = (await mvarAeneasClient.trainsList()).ToList();
		await mvarInternalStorage.SetTrainList(mcolTrains);
		mvarLastSyncTime = GetLatestUpdateTime(mcolTrains);
		mvarDataVersion++;
		StateHasChanged();
	}

	private async Task LoadPlatforms()
	{
		mcolPlatforms = await mvarInternalStorage.GetPlatformList();
		if(mcolPlatforms.Length<1)
		{
			IEnumerable<PlatformModel>? auxLista = await mvarAeneasClient.platformsList();
			if(null!=auxLista)
			{
				mcolPlatforms = new PlatformModel[auxLista.Count()];
				foreach (PlatformModel elemento in auxLista)
					mcolPlatforms[elemento.Id-1] = elemento;

				await mvarInternalStorage.SetPlatformList(mcolPlatforms);
			}
		}
	}

	private async Task TrainCache()
	{
		IEnumerable<TrainModel> auxLista = await mvarInternalStorage.GetTrainList();
		Users = await mvarAuthClient.cachedUserList();

		if (!auxLista.Any())
		{
			auxLista = await mvarAeneasClient.trainsList();
			await mvarInternalStorage.SetTrainList(auxLista);
		}

		mcolTrains = auxLista.ToList();
		mvarLastSyncTime = GetLatestUpdateTime(mcolTrains);
		await SyncRecentChangesAsync();
	}

	private void StartPolling()
	{
		mvarPollTimer = new Timer(_ => _ = InvokeAsync(SyncRecentChangesAsync), null, PollInterval, PollInterval);
	}

	private async Task SyncRecentChangesAsync()
	{
		if (mvarSyncInProgress || null == mcolTrains)
			return;

		mvarSyncInProgress = true;
		try
		{
			IEnumerable<StatusChangeModel> actualizaciones = await mvarAeneasClient.recentChangeList(mvarLastSyncTime);
			if (!actualizaciones.Any())
				return;

			List<TrainModel> auxLista = mcolTrains.ToList();
			bool nuevoUsuario = false;
			bool huboCambios = false;

			foreach (StatusChangeModel nuevoCambio in actualizaciones.OrderBy(xx => xx.timeStamp))
			{
				TrainModel? auxTrain = auxLista.FirstOrDefault(xx => xx.id == nuevoCambio.trainId);
				if (null == auxTrain)
					continue;

				auxTrain.lastUpdateTime = nuevoCambio.timeStamp;
				auxTrain.lastStatus = nuevoCambio.status;
				auxTrain.lastUserInfo = nuevoCambio.userId;
				mcolHighlightedTrains.Add(nuevoCambio.trainId);
				huboCambios = true;

				if (Guid.Empty != nuevoCambio.userId && null != Users && !Users.ContainsKey(nuevoCambio.userId))
					nuevoUsuario = true;

				if (nuevoCambio.timeStamp > mvarLastSyncTime)
					mvarLastSyncTime = nuevoCambio.timeStamp;
			}

			if (!huboCambios)
				return;

			if (nuevoUsuario)
				Users = await mvarAuthClient.cachedUserList();

			mcolTrains = auxLista;
			await mvarInternalStorage.SetTrainList(mcolTrains);
			mvarDataVersion++;
			ScheduleHighlightClear();
			if (AudioNotificationsEnabled)
				await mvarJSRuntime.InvokeVoidAsync("sapphireSound.play", "sound/Ding.mp3");
			StateHasChanged();
		}
		finally
		{
			mvarSyncInProgress = false;
		}
	}

	private void ScheduleHighlightClear()
	{
		mvarHighlightTimer?.Dispose();
		mvarHighlightTimer = new Timer(_ => _ = InvokeAsync(ClearHighlightsAsync), null, HighlightDuration, Timeout.InfiniteTimeSpan);
	}

	private Task ClearHighlightsAsync()
	{
		if (mcolHighlightedTrains.Count == 0)
			return Task.CompletedTask;

		mcolHighlightedTrains.Clear();
		mvarDataVersion++;
		StateHasChanged();
		return Task.CompletedTask;
	}

	private static DateTime GetLatestUpdateTime(IEnumerable<TrainModel> trains)
	{
		if (!trains.Any())
			return DateTime.UtcNow;

		return trains.Max(xx => xx.lastUpdateTime);
	}
}
