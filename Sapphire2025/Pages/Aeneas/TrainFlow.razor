@page "/trainFlow"
@inject AeneasClient mvarAeneasClient
@inject AuthenticationClient mvarAuthClient
@inject NavigationManager mvarNavigator
@inject IntStorageService mvarInternalStorage
@if(null==mcolTrains)
{
	<div class="d-flex justify-content-center align-items-center" style="height: 60vh;">
		<div class="text-center">
			<div class="spinner-border text-primary mb-3" style="width: 4rem; height: 4rem;" role="status">
				<span class="visually-hidden">Cargando...</span>
			</div>
			<div>
				<h5 class="mt-2">Cargando ciclos de taller...</h5>
				<p class="text-muted">Por favor, espere un momento.</p>
			</div>
		</div>
	</div>
}
else
{
	<CascadingValue Value="Extended">
		<CascadingValue Value="mcolTrains">
			<CascadingValue Value="Users">
				<CascadingValue Value="Status">
					<div class="row align-items-start" style="height: 50vh; width: 100%">
						<div class="col">
							<Sapphire2025.Layout.Aeneas.TrainFlowCTL
							OnStatusSelected="HandleStatusSelected"
							OnOpenTrain="HandleOpenTrain"
							width="100" height="50" />
						</div>
						<div class="col">
							<Sapphire2025.Layout.Aeneas.StatusTrainsTable Width="100" Height="50" />
						</div>
					</div>
				</CascadingValue>
				<div class="row">
					<Button Class="btn-secondary" @onclick="@changeExtended" >...</Button>
				</div>
				<div class="row align-items-start" style="height: 50vh;">
					<div class="col">
						<Sapphire2025.Layout.Aeneas.AvailableTrainsTable Width="95" Height="50" />
					</div>
				</div>
			</CascadingValue>
		</CascadingValue>
	</CascadingValue>
}

@code 
{
	private IEnumerable<TrainModel> mcolTrains{ get; set; }
	[Parameter]
	public Sapphire2025Models.Common.TrainStatus Status { get; set; }	
	[Parameter]
	public Dictionary<Guid,UserModelBase>? Users{ get; set; }

	private bool Extended { get; set; } = false;

	protected async override Task OnInitializedAsync()
	{
		await TrainCache();

	}

	/// <summary>
	/// Función para actualizar las tablas de trenes en función del elemento seleccionado.
	/// </summary>
	/// <param name="status"></param>
	private void HandleStatusSelected(Sapphire2025Models.Common.TrainStatus status)
	{
		Status = status;
		StateHasChanged();
	}
	private void HandleOpenTrain(Guid id)
	{
		mvarNavigator.NavigateTo(string.Format("/train/{0}", id));
	}
	private void changeExtended()
	{
		Extended = !Extended;
		StateHasChanged();
	}	

	/// <summary>
	/// Para acelerar considerablemente la ejecución del programa vamos a cargar la lista en dos
	/// fases... primero leemos del almacenamiento interno la lista completa, luego pedimos al servidor
	/// las operaciones posteriores a la última fecha y luego guardamos todo en la caché.
	/// </summary>
	private async Task TrainCache()
	{
		IEnumerable<TrainModel> auxLista = await mvarInternalStorage.GetTrainList();
		Users = await mvarAuthClient.cachedUserList();
		if(auxLista.Count()<1)
		{
			//Tenemos la lista vacía. La sesión no tiene la información.
			//Lo primero que hacemos es cargar lista de trenes y usuarios
			//después lo almacenamos en la caché.
			auxLista = await mvarAeneasClient.trainsList();
			await mvarInternalStorage.SetTrainList(mcolTrains);			
		}

		//Ahora se supone que tenemos ya la lista cargada.
		DateTime ultimaFecha = auxLista.Max(xx => xx.lastUpdateTime);
		//Cargamos ahora los datos más recientes.
		IEnumerable<StatusChangeModel> actualizaciones = await mvarAeneasClient.recentChangeList(ultimaFecha);
		if (actualizaciones.Count() > 0)
		{
			bool nuevoUsuario = false; //Flag para detectar usuarios que no estaban en el diccionario
			foreach (StatusChangeModel nuevoCambio in actualizaciones)
			{
				TrainModel? auxTrain = auxLista.FirstOrDefault(xx => xx.id == nuevoCambio.trainId);
				System.Diagnostics.Debug.Assert(null != auxTrain, "El tren no existe en la lista de trenes");
				auxTrain.lastUpdateTime = nuevoCambio.timeStamp;
				auxTrain.lastStatus = nuevoCambio.status;
				auxTrain.lastUserInfo = nuevoCambio.userId;
				if (Guid.Empty != nuevoCambio.userId && null != Users && !(Users.ContainsKey(nuevoCambio.userId)))
					nuevoUsuario = true; //Tengo al menos un usuario que no está en el diccionario
			}
			//Guardaré la nueva lista en la caché.
			await mvarInternalStorage.SetTrainList(auxLista);
		}		
		mcolTrains = auxLista;		
	}
}
